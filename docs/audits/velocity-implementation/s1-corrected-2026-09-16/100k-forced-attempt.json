  "limit_findings": [
    {
      "finding": "module/import counts are bounded only by the loader",
      "detail": "src/project.zig rejects module 257 with E_MODULE_LIMIT and import 4097 with E_IMPORT_LIMIT, but src/native_test_snapshot.zig, scripts/navigate.py and scripts/packages.py enforce only byte/entry budgets. A 257-module project can therefore be snapshotted or materialized and then fail ordinary checking.",
      "sources": [
        "src/project.zig",
        "src/native_test_snapshot.zig",
        "scripts/navigate.py",
        "scripts/packages.py"
      ],
      "action": "reported, not changed: a consistent fix must add the shared module/import budget to the snapshot, inventory and package paths, not only to project.zig."
    },
    {
      "finding": "store byte budgets are larger than the compiler budgets",
      "detail": "scripts/store.py allows 8 MiB per file and 64 MiB total; the loader allows 4 MiB per file and 16 MiB total. The store accepts projects the compiler later rejects with E_PROJECT_BYTES.",
      "sources": [
        "scripts/store.py",
        "src/project.zig"
      ],
      "action": "reported, not changed: lowering the store without measuring existing store users would be a behavior change outside the S1 measurement package."
    },
    {
      "finding": "navigation has its own symbol/reference budgets",
      "detail": "src/navigation.zig caps navigation at 50000 symbols and 250000 references. The measured 100k-line ordinary workload checks in a few seconds but index-project reports host failure NavigationLimit; navigation limits are not part of the loader/snapshot/package budget set.",
      "sources": [
        "src/navigation.zig"
      ],
      "action": "reported; the measured NavigationLimit is preserved in workload metrics and is an unsupported workload for navigation, never a timing sample."
    },
    {
      "finding": "configuration budget is a separate 1 MiB ceiling",
      "detail": "src/project_config.zig caps mylang.json and a relative import policy at 1 MiB independently of the source budget.",
      "sources": [
        "src/project_config.zig"
      ],
      "action": "documented in the shared limits table; no measurement justifies changing it."
    }
  ],
