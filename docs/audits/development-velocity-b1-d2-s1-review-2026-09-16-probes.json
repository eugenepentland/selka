  "controlled_budget_sweep": {
    "source": "const std = @import(\"std\");\nconst language = @import(\"language\");\nconst a = std.heap.smp_allocator;\nconst Files = struct {\n    disk: language.project_files.Files,\n    token: usize,\n    fn read(ctx: ?*anyopaque, allocator: std.mem.Allocator, relative: []const u8, limit: usize) language.project.ReadError![]u8 {\n        const self: *Files = @ptrCast(@alignCast(ctx.?));\n        const bytes = try language.project_files.Files.read(&self.disk, allocator, relative, limit);\n        if (!std.mem.eql(u8, relative, \"m000.my\")) return bytes;\n        defer allocator.free(bytes);\n        const replacement = try std.fmt.allocPrint(allocator, \"    return base(x) + {d}\", .{self.token});\n        defer allocator.free(replacement);\n        return std.mem.replaceOwned(u8, allocator, bytes, \"    return base(x) + 1\", replacement);\n    }\n};\nfn now() std.Io.Timestamp { return std.Io.Timestamp.now(std.testing.io, .awake); }\nfn ms(begin: std.Io.Timestamp, end: std.Io.Timestamp) f64 { return @as(f64,@floatFromInt(begin.durationTo(end).nanoseconds))/1e6; }\ntest \"review controlled semantic budget sweep\" {\n    const root = \"/tmp/mylang-s1-corrected-work/100k-ord-low/sources/ordinary-100k\";\n    for ([_]usize{0,16,32,64,128}) |mib| {\n        var cache = language.semantic_cache.Cache.init(a, mib*1024*1024);\n        defer cache.deinit();\n        var syntax = language.syntax_cache.Cache.init(a, .{});\n        defer syntax.deinit();\n        for (0..6) |iteration| {\n            var files: Files = .{.disk=.{.io=std.testing.io,.root=root},.token=70001+iteration};\n            const start=now();\n            var project=language.project.Project.init(a);\n            defer project.deinit();\n            try project.load(.{.context=&files,.read=Files.read}, \"main\", .{});\n            const loaded=now();\n            var index=try language.interfaces.buildWithCache(&project,&syntax,null);\n            const indexed=now();\n            var compilation=try language.project_compile.Compilation.init(&index);\n            const merged=now();\n            const before=cache.statistics;\n            try compilation.checkWithCache(&cache);\n            const done=now();\n            std.debug.print(\"{{\\\"budget_mib\\\":{d},\\\"iteration\\\":{d},\\\"load_ms\\\":{d:.3},\\\"index_ms\\\":{d:.3},\\\"merge_ms\\\":{d:.3},\\\"check_ms\\\":{d:.3},\\\"total_ms\\\":{d:.3},\\\"checked\\\":{d},\\\"reused\\\":{d},\\\"retained\\\":{d}}}\\n\", .{mib,iteration,ms(start,loaded),ms(loaded,indexed),ms(indexed,merged),ms(merged,done),ms(start,done),cache.statistics.checked-before.checked,cache.statistics.reused-before.reused,cache.statistics.retained_bytes});\n        }\n    }\n}\n",
