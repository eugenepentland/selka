+#!/usr/bin/env python3
+import json
+import sys
+
+if len(sys.argv) != 4:
+    raise SystemExit(2)
+report, diagnostics, snapshot = sys.argv[1:]
+try:
+    with open(report, "r", encoding="utf-8") as handle:
+        value = json.load(handle)
+    if not isinstance(value, dict):
+        raise ValueError("report root is not an object")
+    if value.get("version") != "native-tests-v1":
+        raise ValueError("unexpected report version")
+    tests = value.get("tests")
+    if not isinstance(tests, list) or not tests:
+        raise ValueError("successful report has no tests")
+    counts = {name: value[name] for name in ("passed", "cached", "failed", "skipped", "executed")}
+    if any(type(number) is not int or number < 0 for number in counts.values()):
+        raise ValueError("invalid test counts")
+    statuses = {name: 0 for name in ("passed", "cached", "failed", "skipped")}
+    names = set()
+    for index, test in enumerate(tests):
+        if not isinstance(test, dict):
+            raise ValueError(f"test {index} is not an object")
+        name = test.get("name")
+        status = test.get("status")
+        if not isinstance(name, str) or not name:
+            raise ValueError(f"test {index} has no name")
+        if name in names:
+            raise ValueError(f"duplicate test name: {name}")
+        names.add(name)
+        if status not in statuses:
+            raise ValueError(f"test {name} has invalid status")
+        statuses[status] += 1
+    if any(counts[name] != statuses[name] for name in statuses):
+        raise ValueError("summary counts do not match test statuses")
+    if counts["executed"] != counts["passed"] + counts["failed"]:
+        raise ValueError("executed count is inconsistent")
+    if counts["failed"] != 0:
+        raise ValueError("successful process reported failed tests")
+    if counts["passed"] + counts["cached"] == 0:
+        raise ValueError("successful report has no passing tests")
+except (OSError, json.JSONDecodeError, KeyError, TypeError, ValueError) as error:
+    print(f"gate: invalid native test report: {error}", file=sys.stderr)
+    raise SystemExit(2)
+print(json.dumps({
+    "version": "pcb-workbench-gate-v1",
+    "native_report_version": "native-tests-v1",
+    "snapshot": snapshot,
+    **counts,
+    "report": report,
+    "diagnostics": diagnostics,
+}, separators=(",", ":")))
