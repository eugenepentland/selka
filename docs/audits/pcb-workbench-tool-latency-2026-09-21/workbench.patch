+#!/usr/bin/env python3
+import hashlib
+import json
+import os
+
+exact = {
+    "AR", "CCC_OVERRIDE_OPTIONS", "CC", "CFLAGS", "COMPILER_PATH", "CPP",
+    "CPPFLAGS", "CPATH", "CPLUS_INCLUDE_PATH", "CXX", "CXXFLAGS",
+    "C_INCLUDE_PATH", "GCC_EXEC_PREFIX", "LDFLAGS", "LD", "LIBRARY_PATH",
+    "MACOSX_DEPLOYMENT_TARGET", "MYLANG_HOST_COMPILER", "MYLANG_LLVM_ADAPTER",
+    "MYLANG_SEMANTIC_BUDGET", "MYLANG_QBE_LLVM_EMIT_LTO_OBJECT",
+    "MYLANG_QBE_LLVM_KEEP_IR", "MYLANG_QBE_LLVM_OPT",
+    "MYLANG_QBE_LLVM_RUNTIME_SOURCES", "MYLANG_QBE_LLVM_SIGNATURES",
+    "MYLANG_QBE_LLVM_UNIT", "MYLANG_QBE_LLVM_ZIG", "MYLANG_ZIG",
+    "OBJC_INCLUDE_PATH", "PYTHONHASHSEED", "PYTHONHOME", "PYTHONOPTIMIZE",
