+if [ ! -f "$install_root/IDENTITY" ]; then
+    adapter_identity=$(find "$install_root/lib/mylang-llvm" -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum | sha256sum)
+    identity=$(printf '%s\n%s\n' "$identity" "$adapter_identity" | sha256sum | awk '{ print $1 }')
+fi
+environment_identity=$("$ROOT/tools/build-environment-identity.py")
+build_cache="$CACHE/$environment_identity"
+recipe_version=pcb-native-build-v2-llvm-affinity
+sources=$(mktemp)
+copied=
+trap 'rm -f "$sources"; [ -z "$copied" ] || rm -rf "$copied"' EXIT HUP INT TERM
+(cd "$HERE" && sha256sum ./*.my) >"$sources"
+source_digest=$(sha256sum "$sources" | awk '{ print $1 }')
+snapshot="$ROOT/.workbench/snapshots/$source_digest"
+mkdir -p "$ROOT/.workbench/snapshots" "$ROOT/.workbench/builds" "$CACHE"
+mkdir -p "$build_cache"
+if [ ! -d "$snapshot" ]; then
+    copied=$(mktemp -d "$ROOT/.workbench/snapshots/.build-copy.XXXXXX")
+    cp "$HERE"/*.my "$copied"/
+    (cd "$HERE" && sha256sum -c "$sources" >/dev/null) || { printf '%s\n' 'build-app: sources changed while snapshotting' >&2; exit 1; }
+    (cd "$copied" && sha256sum -c "$sources" >/dev/null) || { printf '%s\n' 'build-app: copied snapshot failed verification' >&2; exit 1; }
+    if ! mv -T "$copied" "$snapshot" 2>/dev/null; then rm -rf "$copied"; fi
+    copied=
+fi
+digest=$(printf '%s\n%s\n%s\n%s\n%s\n%s\n' "$identity" "$source_digest" "$mode" "$JOBS" "$environment_identity" "$recipe_version" | sha256sum | awk '{ print $1 }')
+build="$ROOT/.workbench/builds/$digest"
+mkdir -p "$build"
+exec 9>"$build/.lock"
+flock 9
+if [ ! -x "$build/pcb-workbench" ]; then
+    output="$build/pcb-workbench.tmp.$$"
+    trap 'rm -f "$sources" "$output"; [ -z "$copied" ] || rm -rf "$copied"' EXIT HUP INT TERM
+    report_dir=$(mktemp -d "$build/report.XXXXXX")
+    command_out="$report_dir/stdout.log"
+    command_log="$report_dir/diagnostics.log"
+    set +e
+    if [ "$mode" = release ]; then
+        "$ROOT/tools/run-with-affinity.py" "$JOBS" -- env -u MYLANG_HOST_COMPILER -u MYLANG_LLVM_ADAPTER "$MYLANG" build "$snapshot/main.my" --project -o "$output" --cache-dir "$build_cache" --zig "$ZIG" --backend llvm --llvm-adapter "$adapter" --llvm-opt 3 --lto --mode ReleaseFast --step-accounting --report >"$command_out" 2>"$command_log"
+    else
+        "$ROOT/tools/run-with-affinity.py" "$JOBS" -- env -u MYLANG_HOST_COMPILER -u MYLANG_LLVM_ADAPTER "$MYLANG" build "$snapshot/main.my" --project -o "$output" --cache-dir "$build_cache" --zig "$ZIG" --backend llvm --llvm-adapter "$adapter" --llvm-opt 0 --mode Debug --step-accounting --report >"$command_out" 2>"$command_log"
+    fi
+    status=$?
+    set -e
+    if [ "$status" -ne 0 ]; then
+        tail -n 40 "$command_log" | LC_ALL=C cut -c1-500 >&2 || true
+        printf 'build-app: failed status=%s stdout=%s diagnostics=%s\n' "$status" "$command_out" "$command_log" >&2
+        exit "$status"
+    fi
+    mv "$output" "$build/pcb-workbench"
+    printf 'build-app: built diagnostics=%s stdout=%s\n' "$command_log" "$command_out" >&2
+else
+    printf 'build-app: reused %s\n' "$build/pcb-workbench" >&2
+fi
+printf '%s\n' "$build/pcb-workbench"
