+#!/usr/bin/env python3
+import os
+import sys
+
+if len(sys.argv) < 4 or sys.argv[2] != "--":
+    print("usage: run-with-affinity.py JOBS -- COMMAND [ARG ...]", file=sys.stderr)
+    raise SystemExit(2)
+try:
+    jobs = int(sys.argv[1])
+except ValueError:
+    jobs = 0
+if jobs <= 0:
+    print("run-with-affinity: JOBS must be a positive integer", file=sys.stderr)
+    raise SystemExit(2)
+allowed = sorted(os.sched_getaffinity(0))
+if not allowed:
+    print("run-with-affinity: process has no allowed CPUs", file=sys.stderr)
+    raise SystemExit(2)
+os.sched_setaffinity(0, allowed[: min(jobs, len(allowed))])
+os.execvpe(sys.argv[3], sys.argv[3:], os.environ)
