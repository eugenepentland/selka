+#!/bin/sh
+set -eu
+ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+[ "$#" -eq 1 ] || { printf '%s\n' 'usage: tools/update-toolchain.sh /path/to/complete/mylang-install' >&2; exit 2; }
+source=$1
+for asset in bin/mylang bin/qbe lib/mylang-llvm/qbe_llvm.py lib/mylang-llvm/llvm_emit.py lib/mylang-llvm/amd64_sysv.py lib/mylang-llvm/runtime_signatures.py lib/mylang-runtime; do
+    [ -e "$source/$asset" ] || { printf 'update-toolchain: incomplete install, missing %s\n' "$asset" >&2; exit 1; }
+done
+identity=$(cd "$source" && find bin lib/mylang-llvm lib/mylang-runtime -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum | sha256sum | awk '{ print $1 }')
+destination="$ROOT/.mylang/installs/$identity"
+mkdir -p "$ROOT/.mylang/installs"
+if [ ! -d "$destination" ]; then
+    staging="$destination.tmp.$$"
+    trap 'rm -rf "$staging"' EXIT HUP INT TERM
+    mkdir -p "$staging"
+    cp -a "$source/bin" "$source/lib" "$staging"/
+    copied_identity=$(cd "$staging" && find bin lib/mylang-llvm lib/mylang-runtime -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum | sha256sum | awk '{ print $1 }')
+    [ "$copied_identity" = "$identity" ] || { printf '%s\n' 'update-toolchain: copied install failed identity verification' >&2; exit 1; }
+    printf '%s\n' "$identity" >"$staging/IDENTITY"
+    if ! mv -T "$staging" "$destination" 2>/dev/null; then
+        rm -rf "$staging"
+    fi
+fi
+installed_identity=$(cd "$destination" && find bin lib/mylang-llvm lib/mylang-runtime -type f ! -name IDENTITY -print0 | LC_ALL=C sort -z | xargs -0 sha256sum | sha256sum | awk '{ print $1 }')
+[ "$installed_identity" = "$identity" ] || { printf '%s\n' 'update-toolchain: existing pinned install is corrupt' >&2; exit 1; }
+current_new="$ROOT/.mylang/current.new.$$"
+ln -s "installs/$identity" "$current_new"
+mv -Tf "$current_new" "$ROOT/.mylang/current"
+printf 'pinned mylang install %s\n' "$identity"
