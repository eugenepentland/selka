+    "ZIG_GLOBAL_CACHE_DIR", "ZIG_LIBC", "ZIG_LIB_DIR", "ZIG_LOCAL_CACHE_DIR",
+}
+selected = {
+    key: value for key, value in os.environ.items()
+    if key in exact or key.startswith("LD_")
+}
+payload = json.dumps(selected, sort_keys=True, separators=(",", ":")).encode()
