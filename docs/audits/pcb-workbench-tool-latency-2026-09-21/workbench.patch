+#!/bin/sh
+set -eu
+HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+inventory=${INVENTORY:-"$HERE/test-inventory.txt"}
+suite=${SUITE:-"$HERE/all_test.my"}
+actual=$(mktemp); expected=$(mktemp); expected_modules=$(mktemp); imports=$(mktemp)
+trap 'rm -f "$actual" "$expected" "$expected_modules" "$imports"' EXIT HUP INT TERM
+awk '!/^#/ && NF { print $1, $2 }' "$inventory" | LC_ALL=C sort >"$expected"
+for source in "$HERE"/*.my; do
+    module=$(basename "$source" .my)
+    [ "$module" = all_test ] && continue
+    count=$(awk '/^public def test_/ { count++ } END { print count + 0 }' "$source")
+    printf '%s %s\n' "$module" "$count"
+done | LC_ALL=C sort >"$actual"
+awk '{ print $1 }' "$expected" >"$expected_modules"
+awk '/^import / { print $2 }' "$suite" | LC_ALL=C sort >"$imports"
+cmp -s "$expected_modules" "$imports" || {
+    printf '%s\n' 'test inventory: all_test.my imports differ from test-inventory.txt' >&2
+    diff -u "$expected_modules" "$imports" >&2 || true
+    exit 1
+}
+cmp -s "$expected" "$actual" || {
+    printf '%s\n' 'test inventory: module set or public test count changed; review suite and inventory' >&2
+    diff -u "$expected" "$actual" >&2 || true
+    exit 1
+}
+expected_total=$(awk '{ sum += $2 } END { print sum + 0 }' "$expected")
+actual_total=$(awk '{ sum += $2 } END { print sum + 0 }' "$actual")
+modules=$(wc -l <"$actual" | tr -d ' ')
+[ "$actual_total" -eq "$expected_total" ] || { printf 'test inventory: expected reviewed total %s, found %s\n' "$expected_total" "$actual_total" >&2; exit 1; }
+printf 'test inventory: %s modules, %s public tests\n' "$modules" "$actual_total"
