+#!/bin/sh
+set -eu
+ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT HUP INT TERM
+
+mkdir -p "$tmp/fixture/guest" "$tmp/fixture/tools"
+cp "$ROOT/guest"/*.my "$ROOT/guest"/*.sh "$ROOT/guest/test-inventory.txt" "$tmp/fixture/guest"/
+cp "$ROOT/tools"/*.py "$tmp/fixture/tools/"
+chmod +x "$tmp/fixture/guest"/*.sh
+chmod +x "$tmp/fixture/tools"/*.py
+
+"$ROOT/guest/check-test-inventory.sh" | grep -q '21 modules, 400 public tests'
+
+if "$ROOT/tools/run-with-affinity.py" 0 -- /bin/true >/dev/null 2>&1; then
+    printf '%s\n' 'workflow test: zero affinity jobs was accepted' >&2
+    exit 1
+fi
+if "$ROOT/tools/run-with-affinity.py" nope -- /bin/true >/dev/null 2>&1; then
+    printf '%s\n' 'workflow test: nonnumeric affinity jobs was accepted' >&2
+    exit 1
+fi
+if PCB_BUILD_MODE=nope "$tmp/fixture/guest/pcb.sh" status >/dev/null 2>&1; then
+    printf '%s\n' 'workflow test: unknown PCB_BUILD_MODE was accepted' >&2
+    exit 1
+fi
+
+# A new source module must be rejected until it is deliberately inventoried.
+cp "$ROOT/guest/check-test-inventory.sh" "$tmp/check-test-inventory.sh"
+cp "$ROOT/guest/all_test.my" "$ROOT/guest/test-inventory.txt" "$tmp"/
+cp "$ROOT/guest"/*.my "$tmp"/
+printf 'module surprise\n' >"$tmp/surprise.my"
+if HERE="$tmp" "$tmp/check-test-inventory.sh" >/dev/null 2>&1; then
+    printf '%s\n' 'workflow test: uninventoried module was accepted' >&2
+    exit 1
+fi
+
+# The gate must return the compiler status even when output looks successful.
+mkdir -p "$tmp/fake/bin"
+mkdir -p "$tmp/fake/lib/mylang-llvm"
+printf '# fake adapter\n' >"$tmp/fake/lib/mylang-llvm/qbe_llvm.py"
+printf '%s\n' '#!/bin/sh' 'head -c 2000 /dev/zero | tr '\''\0'\'' x >&2; echo >&2' 'printf '\''{"summary":"looks green"}\n'\''' 'exit 7' >"$tmp/fake/bin/mylang"
+chmod +x "$tmp/fake/bin/mylang"
