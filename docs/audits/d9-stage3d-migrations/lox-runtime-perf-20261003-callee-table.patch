+public def test_run_scalar_callee_runtime_snapshot(out: Stream) -> bool:
+    rt = heap.new_runtime(True, None)
+    captured = output.capture(out)
+    setup = b"class Base { init(x) { this.x = x; } read() { return this.x; } } class Child < Base {} var box = Child(1); var saved = box.read; fun identity(x) { return x; } var native = clock;"
+    if stack_vm.interpret(mut rt, mut captured, setup) != stack_vm.InterpretResult.OK:
+        return False
+    box = callee_test_global(rt, b"box")
+    field = lox_strings.find_string(rt, b"x", lox_strings.fnv1a(b"x"))
+    snapshot = rt
+    allocations = rt.allocations
+    calls = b"box.x = 9; var fresh = Child(3); print saved(); print identity(\"cl\" + \"osure\"); print native(); print fresh.read();"
+    status = stack_vm.interpret(mut rt, mut captured, calls)
+    saved = heap.instance_member(snapshot, value.Value.obj(box), field)
+    live = heap.instance_member(rt, value.Value.obj(box), field)
+    return status == stack_vm.InterpretResult.OK and bytes(captured.stdout) == b"9\nclosure\n0\n3\n" and bytes(captured.stderr) == b"" and saved == heap.InstanceMember.field(value.Value.number(1.0)) and live == heap.InstanceMember.field(value.Value.number(9.0)) and snapshot.allocations == allocations and rt.allocations > allocations and rt.collections == rt.allocations
