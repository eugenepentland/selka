+public def get_entries(entries: list[Entry], count: int, key: value.ObjRef, hash: u32) -> Option[value.Value]:
+    if count == 0:
+        return None
+    # Read probes need neither the first tombstone nor a second slot read.
+    # Tombstones continue the chain; an empty entry is its only terminator.
+    mask = len(entries) - 1
+    index = int(bit_and(hash, u32(mask)))
+    while True:
+        entry = entries[index]
+        if entry.key == value.NO_OBJ:
+            if not is_tombstone(entry):
+                return None
+        elif entry.key == key:
+            return Some(entry.value)
+        index = bit_and(index + 1, mask)
