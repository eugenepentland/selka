+# A live Runtime detaches its heap and stack from a saved value snapshot.
+# The call paths must keep the saved bound receiver and current callee roots.
+def callee_test_global(rt: heap.Runtime, name: bytes) -> value.ObjRef:
+    key = lox_strings.find_string(rt, name, lox_strings.fnv1a(name))
+    match table.get(rt.globals, key, heap.string_hash(rt, key)):
+        case Some(item):
+            match item:
+                case value.Value.obj(ref):
+                    return ref
+                case _:
+                    pass
+        case None:
+            pass
+    return value.NO_OBJ
+
