diff --git a/tools/workbench-store.py b/tools/workbench-store.py
new file mode 100755
index 0000000..95723b3
--- /dev/null
+++ b/tools/workbench-store.py
@@ -0,0 +1,253 @@
+#!/usr/bin/env python3
+"""Shared immutable build inputs and artifacts for PCB workbench checkouts."""
+import argparse
+from contextlib import contextmanager
+import fcntl
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import sys
+import tempfile
+import uuid
+
+ROOT = Path(__file__).resolve().parent.parent
+CONFIG = ROOT / "workbench.json"
+HEX = re.compile(r"[0-9a-f]{64}\Z")
+
+
+def configuration(required=True):
+    if not CONFIG.exists() and not required:
+        return {"version": 1, "project": "project-" + uuid.uuid4().hex}
+    value = json.loads(CONFIG.read_text())
+    if (not isinstance(value, dict) or value.get("version") != 1
+            or not isinstance(value.get("project"), str)
+            or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,127}", value["project"])):
+        raise ValueError("invalid workbench.json project identity")
+    return value
+
+
+def base():
+    override = os.environ.get("PCB_SHARED_CACHE")
+    if override:
+        path = Path(override)
+        if not path.is_absolute():
+            raise ValueError("PCB_SHARED_CACHE must be an absolute path")
+    else:
+        cache = Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache")))
+        if not cache.is_absolute():
+            raise ValueError("XDG_CACHE_HOME must be an absolute path")
+        path = cache / "mylang" / "workbench"
+    path.mkdir(parents=True, exist_ok=True)
+    return path.resolve()
+
+
+def state():
+    path = base() / "projects" / configuration()["project"]
+    path.mkdir(parents=True, exist_ok=True)
+    return path
+
+
+@contextmanager
+def locked(path):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open("a") as handle:
+        fcntl.flock(handle, fcntl.LOCK_EX)
+        yield
+
+
+def atomic_text(path, text):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    descriptor, name = tempfile.mkstemp(prefix=".publish-", dir=path.parent)
+    try:
+        with os.fdopen(descriptor, "w") as handle:
+            handle.write(text)
+        os.replace(name, path)
+    finally:
+        Path(name).unlink(missing_ok=True)
+
+
+def compiler():
+    override = os.environ.get("MYLANG")
+    if override:
+        result = Path(override).resolve(strict=True)
+    else:
+        pin = configuration().get("toolchain", "")
+        if not isinstance(pin, str) or not HEX.fullmatch(pin):
+            raise ValueError("missing toolchain pin; run tools/update-toolchain.sh INSTALL")
+        install = base() / "toolchains" / pin
+        if (install / "IDENTITY").read_text().strip() != pin:
+            raise ValueError("shared toolchain identity does not match the pin")
+        result = install / "bin" / "mylang"
+    if not result.is_file() or not os.access(result, os.X_OK):
+        raise ValueError("compiler missing or not executable: " + str(result))
+    return result
+
+
+def compiler_identity(executable):
+    executable = Path(executable).resolve(strict=True)
+    marker = executable.parent.parent / "IDENTITY"
+    if marker.is_file():
+        identity = marker.read_text().strip()
+        if not HEX.fullmatch(identity):
+            raise ValueError("invalid compiler identity")
+        return identity
+    return hashlib.sha256(executable.read_bytes()).hexdigest()
+
+
+def cache(family, executable):
+    # Native generation cleanup only sees one compiler pin in this namespace.
+    root = Path(os.environ["CACHE"]).resolve() if os.environ.get("CACHE") else state() / "cache"
+    path = root / compiler_identity(executable) / family
+    path.mkdir(parents=True, exist_ok=True)
+    return path
+
+
+def source_files(purpose):
+    guest = ROOT / "guest"
+    files = sorted(guest.glob("*.my"), key=lambda path: path.name)
+    if not files:
+        raise ValueError("guest source files missing")
+    if purpose == "tests":
+        files.append(guest / "test-inventory.txt")
+    if any(path.is_symlink() or not path.is_file() for path in files):
+        raise ValueError("source snapshots require regular files")
+    return files
+
+
+def capture(purpose):
+    files = source_files(purpose)
+    contents = {path.name: path.read_bytes() for path in files}
+    # Match the previous sha256sum manifest, so its already-built binaries seed
+    # the shared store without recompilation.
+    manifest = "".join(
+        hashlib.sha256(contents[path.name]).hexdigest() + "  "
+        + ("./" if path.suffix == ".my" else "") + path.name + "\n"
+        for path in files
+    )
+    if source_files(purpose) != files or any(path.read_bytes() != contents[path.name] for path in files):
+        raise ValueError("sources changed while snapshotting; retry on stable inputs")
+    return hashlib.sha256(manifest.encode()).hexdigest(), contents
+
+
+def snapshot(purpose):
+    digest, contents = capture(purpose)
+    shared = state()
+    destination = shared / "snapshots" / digest
+    with locked(shared / "locks" / ("snapshot-" + digest)):
+        if destination.exists():
+            if any(not (destination / name).is_file() or (destination / name).read_bytes() != data
+                   for name, data in contents.items()):
+                raise ValueError("shared snapshot is corrupt: " + str(destination))
+            if {p.name for p in destination.iterdir()} != set(contents):
+                raise ValueError("shared snapshot contains unexpected files")
+            return destination
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        pending = Path(tempfile.mkdtemp(prefix=".snapshot-", dir=destination.parent))
+        try:
+            for name, data in contents.items():
+                (pending / name).write_bytes(data)
+            pending.rename(destination)
+        finally:
+            if pending.exists():
+                shutil.rmtree(pending)
+    return destination
+
+
+def installation_identity(source):
+    required = ["bin/mylang", "bin/qbe", "lib/mylang-llvm/qbe_llvm.py",
+                "lib/mylang-llvm/llvm_emit.py", "lib/mylang-llvm/amd64_sysv.py",
+                "lib/mylang-llvm/runtime_signatures.py", "lib/mylang-runtime"]
+    for name in required:
+        if not (source / name).exists():
+            raise ValueError("incomplete install, missing " + name)
+    for name in ("bin/mylang", "bin/qbe"):
+        if not os.access(source / name, os.X_OK):
+            raise ValueError("installation tool is not executable: " + name)
+    for name in ("bin", "lib"):
+        directory = source / name
+        if not directory.is_dir() or directory.is_symlink():
+            raise ValueError("installation requires regular directories: " + name)
+        for path in directory.rglob("*"):
+            if path.is_symlink() or not (path.is_file() or path.is_dir()):
+                raise ValueError("installation contains a symlink or special file: " + str(path))
+    files = sorted((p for name in ["bin", "lib/mylang-llvm", "lib/mylang-runtime"]
+                    for p in (source / name).rglob("*") if p.is_file()),
+                   key=lambda p: str(p.relative_to(source)))
+    manifest = "".join(hashlib.sha256(p.read_bytes()).hexdigest() + "  "
+                       + str(p.relative_to(source)) + "\n" for p in files)
+    return hashlib.sha256(manifest.encode()).hexdigest()
+
+
+def install(source):
+    source = Path(source).resolve(strict=True)
+    identity = installation_identity(source)
+    shared = base()
+    destination = shared / "toolchains" / identity
+    with locked(shared / "locks" / ("toolchain-" + identity)):
+        if destination.exists():
+            if (installation_identity(destination) != identity
+                    or (destination / "IDENTITY").read_text().strip() != identity):
+                raise ValueError("shared installation is corrupt")
+        else:
+            destination.parent.mkdir(parents=True, exist_ok=True)
+            pending = Path(tempfile.mkdtemp(prefix=".install-", dir=destination.parent))
+            try:
+                for name in ["bin", "lib"]:
+                    shutil.copytree(source / name, pending / name, symlinks=False)
+                if installation_identity(pending) != identity:
+                    raise ValueError("installation changed while copying")
+                (pending / "IDENTITY").write_text(identity + "\n")
+                pending.rename(destination)
+            finally:
+                if pending.exists():
+                    shutil.rmtree(pending)
+    # The pin is checkout-local and trackable; no shared mutable 'current' pin.
+    with locked(ROOT / ".workbench" / "pin.lock"):
+        config = configuration(required=False)
+        config["toolchain"] = identity
+        atomic_text(CONFIG, json.dumps(config, indent=2) + "\n")
+        compat = ROOT / ".mylang"
+        compat.mkdir(exist_ok=True)
+        link = compat / ("current.new." + uuid.uuid4().hex)
+        try:
+            link.symlink_to(destination)
+            os.replace(link, compat / "current")
+        finally:
+            link.unlink(missing_ok=True)
+    return identity
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    commands = parser.add_subparsers(dest="command", required=True)
+    for name in ["state", "compiler"]:
+        commands.add_parser(name)
+    commands.add_parser("snapshot").add_argument("purpose", choices=["build", "tests"])
+    command = commands.add_parser("cache")
+    command.add_argument("family", choices=["build", "tests"])
+    command.add_argument("compiler")
+    commands.add_parser("install").add_argument("source")
+    args = parser.parse_args()
+    try:
+        if args.command == "state":
+            result = state()
+        elif args.command == "compiler":
+            result = compiler()
+        elif args.command == "snapshot":
+            result = snapshot(args.purpose)
+        elif args.command == "cache":
+            result = cache(args.family, args.compiler)
+        else:
+            result = "pinned mylang install " + install(args.source)
+    except (OSError, ValueError, KeyError) as error:
+        print("workbench-store: " + str(error), file=sys.stderr)
+        return 2
+    print(result)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
