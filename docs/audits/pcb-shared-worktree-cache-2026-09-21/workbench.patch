diff --git a/tests/shared_cache.py b/tests/shared_cache.py
new file mode 100644
index 0000000..73c9229
--- /dev/null
+++ b/tests/shared_cache.py
@@ -0,0 +1,295 @@
+#!/usr/bin/env python3
+"""Cross-worktree regression tests for the PCB shared cache contract."""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import textwrap
+import unittest
+
+
+STAGE = Path(__file__).resolve().parents[1]
+
+
+def run(argv, *, cwd: Path, env: dict[str, str], check: bool = True):
+    result = subprocess.run(argv, cwd=cwd, env=env, text=True, capture_output=True)
+    if check and result.returncode:
+        raise AssertionError(
+            f"command failed ({result.returncode}): {argv}\nstdout:\n{result.stdout}\nstderr:\n{result.stderr}"
+        )
+    return result
+
+
+class SharedCacheTest(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(prefix="pcb shared cache ")
+        self.root = Path(self.temp.name)
+        self.shared = self.root / "shared cache"
+        self.seed = self.root / "seed"
+        self.seed.mkdir()
+        for name in ("guest", "tools", "kit"):
+            source = STAGE / name
+            if source.exists():
+                shutil.copytree(source, self.seed / name)
+        for name in ("README.md", "AGENTS.md"):
+            source = STAGE / name
+            if source.exists():
+                shutil.copy2(source, self.seed / name)
+        config = STAGE / "workbench.json"
+        if config.exists():
+            shutil.copy2(config, self.seed / "workbench.json")
+        else:
+            (self.seed / "workbench.json").write_text(
+                json.dumps({"version": 1, "project": "pcb-workbench"}, indent=2) + "\n"
+            )
+        self.git("init", cwd=self.seed)
+        self.git("config", "user.email", "cache-test@example.invalid", cwd=self.seed)
+        self.git("config", "user.name", "Cache Test", cwd=self.seed)
+        self.git("config", "core.hooksPath", "/dev/null", cwd=self.seed)
+        self.git("add", ".", cwd=self.seed)
+        self.git("commit", "-m", "fixture", cwd=self.seed)
+        self.one = self.root / "checkout one"
+        self.two = self.root / "checkout-two"
+        self.git("worktree", "add", "-b", "one", str(self.one), cwd=self.seed)
+        self.git("worktree", "add", "-b", "two", str(self.two), cwd=self.seed)
+        self.env = os.environ.copy()
+        for name in (
+            "CACHE", "MYLANG", "MYLANG_HOST_COMPILER", "MYLANG_LLVM_ADAPTER",
+            "MYLANG_QBE", "MYLANG_ZIG", "PCB_BUILD_JOBS", "PCB_BUILD_MODE",
+        ):
+            self.env.pop(name, None)
+        for name in list(self.env):
+            if name.startswith("MYLANG_"):
+                self.env.pop(name)
+        self.env["PCB_SHARED_CACHE"] = str(self.shared)
+        self.env["FAKE_BUILD_COUNT"] = str(self.root / "compiler-count")
+        self.install_a = self.fake_install("compiler-a", "A")
+        self.install_b = self.fake_install("compiler-b", "B")
+
+    def tearDown(self):
+        self.temp.cleanup()
+
+    def git(self, *args: str, cwd: Path):
+        return subprocess.run(["git", *args], cwd=cwd, check=True, text=True, capture_output=True)
+
+    def fake_install(self, name: str, generation: str) -> Path:
+        root = self.root / name
+        (root / "bin").mkdir(parents=True)
+        (root / "lib/mylang-llvm").mkdir(parents=True)
+        (root / "lib/mylang-runtime").mkdir(parents=True)
+        compiler = root / "bin/mylang"
+        compiler.write_text(textwrap.dedent(f"""\
+            #!/usr/bin/env python3
+            # generation {generation}
+            import fcntl, json, os, pathlib, sys, time
+            args = sys.argv[1:]
+            if args and args[0] == "test":
+                print(json.dumps({{"version":"native-tests-v1","tests":[{{"name":"fixture::test_ok","status":"passed"}}],"passed":1,"cached":0,"failed":0,"skipped":0,"executed":1}}))
+                raise SystemExit(0)
+            if not args or args[0] != "build":
+                raise SystemExit(2)
+            count_path = pathlib.Path(os.environ["FAKE_BUILD_COUNT"])
+            count_path.parent.mkdir(parents=True, exist_ok=True)
+            with count_path.open("a+") as count:
+                fcntl.flock(count, fcntl.LOCK_EX)
+                count.seek(0)
+                value = int(count.read() or "0") + 1
+                count.seek(0); count.truncate(); count.write(str(value)); count.flush()
+            time.sleep(float(os.environ.get("FAKE_BUILD_DELAY", "0")))
+            if os.environ.get("FAKE_BUILD_FAIL") == "1":
+                partial = pathlib.Path(args[args.index("-o") + 1])
+                partial.write_text("incomplete artifact")
+                partial.chmod(0o755)
+                print("controlled fake build failure", file=sys.stderr)
+                raise SystemExit(9)
+            output = pathlib.Path(args[args.index("-o") + 1])
+            output.write_text("#!/usr/bin/env python3\\nimport json, pathlib, sys\\nargs=sys.argv[1:]\\nif '--journal' in args:\\n pathlib.Path(args[args.index('--journal')+1]).mkdir(parents=True, exist_ok=True)\\nprint(json.dumps({{'generation':'{generation}','args':args}}))\\n")
+            output.chmod(0o755)
+            print(json.dumps({{"version":"qbe-build-v1","generation":"{generation}"}}), file=sys.stderr)
+        """))
+        compiler.chmod(0o755)
+        for executable in ("qbe", "mylang-io"):
+            path = root / "bin" / executable
+            path.write_text("#!/bin/sh\nexit 0\n")
+            path.chmod(0o755)
+        for helper in ("qbe_llvm.py", "llvm_emit.py", "amd64_sysv.py", "runtime_signatures.py"):
+            (root / "lib/mylang-llvm" / helper).write_text(f"# {generation} {helper}\n")
+        (root / "lib/mylang-runtime/runtime.a").write_text(f"runtime {generation}\n")
+        return root
+
+    def install(self, checkout: Path, source: Path) -> str:
+        result = run(["tools/update-toolchain.sh", str(source)], cwd=checkout, env=self.env)
+        self.assertRegex(result.stdout, r"^pinned mylang install [0-9a-f]{64}\n$")
+        return result.stdout.split()[-1]
+
+    def store(self, checkout: Path, *args: str) -> Path:
+        result = run(["tools/workbench-store.py", *args], cwd=checkout, env=self.env)
+        return Path(result.stdout.strip())
+
+    def build(self, checkout: Path, **extra: str):
+        env = self.env | extra
+        return run(["guest/build-app.sh"], cwd=checkout, env=env, check=False)
+
+    def count(self) -> int:
+        path = Path(self.env["FAKE_BUILD_COUNT"])
+        return int(path.read_text()) if path.exists() else 0
+
+    def test_cross_worktree_cache_lifecycle(self):
+        pin_a = self.install(self.one, self.install_a)
+        self.install(self.two, self.install_a)
+        self.assertEqual(
+            json.loads((self.one / "workbench.json").read_text()),
+            {"version": 1, "project": "pcb-workbench", "toolchain": pin_a},
+        )
+        self.assertEqual(self.store(self.one, "state"), self.store(self.two, "state"))
+        self.assertEqual(self.store(self.one, "compiler"), self.store(self.two, "compiler"))
+        self.assertEqual(self.store(self.one, "snapshot", "build"), self.store(self.two, "snapshot", "build"))
+        tests_snapshot = self.store(self.one, "snapshot", "tests")
+        self.assertEqual(tests_snapshot, self.store(self.two, "snapshot", "tests"))
+        self.assertTrue((tests_snapshot / "test-inventory.txt").is_file())
+        self.assertEqual(
+            self.store(self.one, "cache", "build", str(self.store(self.one, "compiler"))),
+            self.store(self.two, "cache", "build", str(self.store(self.two, "compiler"))),
+        )
+        self.assertEqual(
+            self.store(self.one, "cache", "tests", str(self.store(self.one, "compiler"))),
+            self.store(self.two, "cache", "tests", str(self.store(self.two, "compiler"))),
+        )
+
+        first = self.build(self.one, PCB_BUILD_JOBS="1")
+        self.assertEqual(first.returncode, 0, first.stderr)
+        second = self.build(self.two, PCB_BUILD_JOBS="7")
+        self.assertEqual(second.returncode, 0, second.stderr)
+        self.assertEqual(first.stdout.strip(), second.stdout.strip())
+        self.assertEqual(self.count(), 1)
+
+        original = (self.one / "guest/units.my").read_text()
+        (self.one / "guest/units.my").write_text(original + "\n# private edit\n")
+        edited = self.build(self.one)
+        self.assertEqual(edited.returncode, 0, edited.stderr)
+        self.assertNotEqual(edited.stdout.strip(), first.stdout.strip())
+        (self.one / "guest/units.my").write_text(original)
+        reverted = self.build(self.one)
+        self.assertEqual(reverted.stdout.strip(), first.stdout.strip())
+        self.assertEqual(self.count(), 2)
+
+        old_compiler = self.store(self.two, "compiler")
+        old_binary = Path(first.stdout.strip())
+        old_cache = self.store(self.two, "cache", "build", str(old_compiler))
+        sentinel = old_cache / "warm-generation-sentinel"
+        sentinel.write_text("retained old compiler generation")
+        pin_b = self.install(self.one, self.install_b)
+        self.assertNotEqual(pin_a, pin_b)
+        self.assertEqual(self.store(self.two, "compiler"), old_compiler)
+        new_cache = self.store(self.one, "cache", "build", str(self.store(self.one, "compiler")))
+        self.assertNotEqual(old_cache, new_cache)
+        self.assertIn(pin_a, old_cache.parts)
+        self.assertIn(pin_b, new_cache.parts)
+        upgraded = self.build(self.one)
+        self.assertEqual(upgraded.returncode, 0, upgraded.stderr)
+        self.assertNotEqual(upgraded.stdout.strip(), first.stdout.strip())
+        self.assertTrue(old_binary.is_file(), "compiler upgrade removed the old generation")
+        self.assertEqual(self.build(self.two).stdout.strip(), first.stdout.strip())
+        self.assertEqual(sentinel.read_text(), "retained old compiler generation")
+
+    def test_concurrent_cold_build_and_failed_publish(self):
+        self.install(self.one, self.install_a)
+        self.install(self.two, self.install_a)
+        env_one = self.env | {"PCB_BUILD_JOBS": "1", "FAKE_BUILD_DELAY": "0.3"}
+        env_two = self.env | {"PCB_BUILD_JOBS": "8", "FAKE_BUILD_DELAY": "0.3"}
+        one = subprocess.Popen(["guest/build-app.sh"], cwd=self.one, env=env_one, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        two = subprocess.Popen(["guest/build-app.sh"], cwd=self.two, env=env_two, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        out_one, err_one = one.communicate(timeout=15)
+        out_two, err_two = two.communicate(timeout=15)
+        self.assertEqual((one.returncode, two.returncode), (0, 0), err_one + err_two)
+        self.assertEqual(out_one.strip(), out_two.strip())
+        self.assertEqual(self.count(), 1)
+
+        (self.one / "guest/units.my").write_text((self.one / "guest/units.my").read_text() + "\n# failing generation\n")
+        failed = self.build(self.one, FAKE_BUILD_FAIL="1")
+        self.assertEqual(failed.returncode, 9)
+        # Failure controls are intentionally absent from cache identity; retry
+        # must run the compiler again and only then publish the executable.
+        retry = self.build(self.one)
+        self.assertEqual(retry.returncode, 0, retry.stderr)
+        self.assertEqual(self.count(), 3)
+        self.assertTrue(Path(retry.stdout.strip()).is_file())
+
+    def test_reports_and_journals_remain_checkout_local(self):
+        self.install(self.one, self.install_a)
+        self.install(self.two, self.install_a)
+        gate_one = run(["guest/gate.sh", "--focus", "units"], cwd=self.one, env=self.env)
+        gate_two = run(["guest/gate.sh", "--focus", "units"], cwd=self.two, env=self.env)
+        report_one = Path(json.loads(gate_one.stdout)["report"])
+        report_two = Path(json.loads(gate_two.stdout)["report"])
+        self.assertTrue(report_one.is_relative_to(self.one / ".workbench/results"))
+        self.assertTrue(report_two.is_relative_to(self.two / ".workbench/results"))
+        self.assertNotEqual(report_one, report_two)
+        journal_one = self.one / "private journal"
+        journal_two = self.two / "private journal"
+        pcb_one = run(["guest/pcb.sh", "status", "--journal", str(journal_one)], cwd=self.one, env=self.env)
+        run(["guest/pcb.sh", "status", "--journal", str(journal_two)], cwd=self.two, env=self.env)
+        built_line = next(line for line in pcb_one.stderr.splitlines() if line.startswith("build-app: built "))
+        diagnostics = Path(built_line.split("diagnostics=", 1)[1].split(" stdout=", 1)[0])
+        self.assertTrue(diagnostics.is_relative_to(self.one / ".workbench/results"))
+        self.assertFalse(diagnostics.is_relative_to(self.shared))
+        self.assertTrue(journal_one.is_dir())
+        self.assertTrue(journal_two.is_dir())
+        self.assertFalse(any(self.shared.rglob("private journal")))
+
+    def test_failed_install_and_corrupt_snapshot_are_rejected(self):
+        pin = self.install(self.one, self.install_a)
+        config_before = (self.one / "workbench.json").read_bytes()
+        link_before = (self.one / ".mylang/current").resolve()
+        incomplete = self.root / "incomplete-install"
+        (incomplete / "bin").mkdir(parents=True)
+        (incomplete / "bin/mylang").write_text("#!/bin/sh\nexit 0\n")
+        (incomplete / "bin/mylang").chmod(0o755)
+        refused = run(
+            ["tools/update-toolchain.sh", str(incomplete)],
+            cwd=self.one,
+            env=self.env,
+            check=False,
+        )
+        self.assertNotEqual(refused.returncode, 0)
+        self.assertEqual((self.one / "workbench.json").read_bytes(), config_before)
+        self.assertEqual((self.one / ".mylang/current").resolve(), link_before)
+        self.assertEqual(json.loads(config_before)["toolchain"], pin)
+
+        linked = self.root / "linked-install"
+        shutil.copytree(self.install_b, linked)
+        external = self.root / "external-runtime.a"
+        external.write_text("mutable external runtime\n")
+        (linked / "lib/mylang-runtime/runtime.a").unlink()
+        (linked / "lib/mylang-runtime/runtime.a").symlink_to(external)
+        refused_link = run(
+            ["tools/update-toolchain.sh", str(linked)],
+            cwd=self.one,
+            env=self.env,
+            check=False,
+        )
+        self.assertNotEqual(refused_link.returncode, 0)
+        self.assertIn("symlink", refused_link.stderr)
+        self.assertEqual((self.one / "workbench.json").read_bytes(), config_before)
+        self.assertEqual((self.one / ".mylang/current").resolve(), link_before)
+
+        snapshot = self.store(self.one, "snapshot", "build")
+        source = snapshot / "units.my"
+        source.write_text(source.read_text() + "\n# corrupt shared snapshot\n")
+        corrupt = run(
+            ["tools/workbench-store.py", "snapshot", "build"],
+            cwd=self.one,
+            env=self.env,
+            check=False,
+        )
+        self.assertEqual(corrupt.returncode, 2)
+        self.assertIn("shared snapshot is corrupt", corrupt.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
