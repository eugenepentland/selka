function bad_trap_meet_roots result scalar from - unchecked -
inst %9 iconst Constant reads - consumes - state scalar parents -
block b0 preds -
inst %0 list_new Fresh reads - consumes - state owned parents -
inst %1 list_new Fresh reads - consumes - state owned parents -
