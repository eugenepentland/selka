function bad_trap_meet_take_later result scalar from - unchecked -
inst %9 iconst Constant reads - consumes - state scalar parents -
block b0 preds -
inst %0 list_new Fresh reads - consumes - state owned parents -
term branch %9 b1 b2
block b1 preds b0
term jump b3
block b2 preds b0
inst %1 list_get Project reads %0,%9 consumes - state owned parents - slot e#0
term jump b3
block b3 preds b1,b2
inst %2 list_get Project reads %0,%9 consumes - state owned parents - slot e#0
term unreachable
end
