public func cli_argvs() -> str[][]:
    return [
        ["gate.log"],
        ["gate.log"],
        ["--max-lines", "3", "gate.log"],
        ["gate.log", "--max-lines=5"],
        ["--max-lines", "0", "gate.log"],
        ["--max-lines", "-2", "gate.log"],
        ["--max-lines", "100", "gate.log"],
        ["gate.log"],
        ["gate.log"],
        ["logs"],
        ["--max-lines", "4", "logs"],
        ["run/gate"],
        ["logs"],
        ["logs/gate/stdout.log"],
        ["logs/gate/stderr.log"],
        ["logs/gate/stdout.log"],
        ["--max-lines", "2", "logs/gate/stdout.log"],
        ["stdout.log"],
        ["stderr.log"],
        ["logs"],
        [],
        ["-h"],
        ["--help"],
        ["absent.log"],
        ["--max-lines", "x", "gate.log"],
        ["--max-lines"],
        ["--nope", "gate.log"],
        ["gate.log", "other.log"],
        ["--max-lines", "2", "--max-lines", "3", "gate.log"],
    ]


