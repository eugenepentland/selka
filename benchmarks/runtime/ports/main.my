module main

extern def runtime_bench_now(host: Host) -> i64 effects(host)


record Item:
    code: int
    bias: int
    payload: list[int]


union Value:
    integer: int,
    boolean: bool


def read_item(item: Item) -> int:
    return item.code + item.bias + item.payload[0]


def as_integer(value: Value) -> int:
    match value:
        case Value.integer(n):
            return n
        case Value.boolean(_):
            return 0


def parse_number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0


def main(args: list[str], host: Host, out: Stream) -> int:
    if len(args) != 4:
        return 2
    size = parse_number(args[1])
    iterations = parse_number(args[2])
    seed = parse_number(args[3])
    if size < 2 or iterations < 1 or seed < 1 or seed > 1000000:
        return 2
    checksum = 0
    elapsed = 0
    if args[0] == "record_reads":
        records: list[Item] = []
        for j in range(size):
            records.append(Item(code=(seed + j * 17) % 1009, bias=(seed * 3 + j * 7) % 257, payload=[j + seed, j + seed + 1, j + seed + 2, j + seed + 3]))
        index = seed % size
        start = runtime_bench_now(host)
        for step in range(iterations):
            item = records[index]
            result = read_item(item)
            checksum = (checksum + result) % 1000000007
            index = (index + 2 * seed + 1) % size
        elapsed = runtime_bench_now(host) - start
    elif args[0] == "tagged_stack":
        opcodes = [(j + seed) % 4 for j in range(size)]
        stack: list[Value] = [Value.integer(seed), Value.boolean(False)]
        cursor = 0
        start = runtime_bench_now(host)
        for step in range(iterations):
            popped = stack.pop()
            base = as_integer(stack[0])
            opcode = opcodes[cursor]
            delta = 0
            match popped:
                case Value.boolean(b):
                    if opcode == 0:
                        delta = 3 if b else 1
                    elif opcode == 1:
                        delta = 7
                    elif opcode == 2:
                        delta = 11
                    else:
                        delta = 13
                case Value.integer(n):
                    if opcode == 0:
                        delta = n % 5
                    elif opcode == 1:
                        delta = n % 7
                    elif opcode == 2:
                        delta = n % 11
                    else:
                        delta = n % 13
            new_base = (base + delta + opcode + 1) % 1000003
            stack[0] = Value.integer(new_base)
            if opcode == 0 or opcode == 2:
                stack.append(Value.boolean(new_base % 2 == 0))
            else:
                stack.append(Value.integer(new_base % 97))
            cursor = (cursor + 1) % size
        elapsed = runtime_bench_now(host) - start
        checksum = as_integer(stack[0]) * 101
        match stack[1]:
            case Value.boolean(b):
                checksum += 1 if b else 0
            case Value.integer(n):
                checksum += n
    elif args[0] == "mutate_unique" or args[0] == "mutate_shared":
        values = [(seed + j * 13) % 1009 for j in range(size)]
        shared = args[0] == "mutate_shared"
        start = runtime_bench_now(host)
        for batch in range(iterations):
            index = (seed + batch * 17) % size
            if shared:
                snapshot = values
                values[index] = (values[index] + batch + 1) % 1000003
                checksum = (checksum + snapshot[index] + values[index]) % 1000000007
                snapshot = []
            else:
                values[index] = (values[index] + batch + 1) % 1000003
                checksum = (checksum + values[index]) % 1000000007
        elapsed = runtime_bench_now(host) - start
        for value in values:
            checksum = (checksum + value) % 1000000007
    else:
        return 2
    out.print(checksum, elapsed)
    return 0
