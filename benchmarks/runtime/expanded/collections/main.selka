import dicts
import lists
import sets

extern func runtime_bench_now(host: Host) -> i64


enum Value:
    integer(value: int)
    boolean(value: bool)


record Row:
    key: int
    ordinal: int
    value: int


record Instruction:
    op: int
    arg: int


func integer(value: Value) -> int:
    match value:
        case integer(value=n):
            return n
        case boolean(value=_):
            return 0


func boolean(value: Value) -> bool:
    match value:
        case boolean(value=b):
            return b
        case integer(value=_):
            return False


func execute(program: Instruction[], size: int, seed: int) -> int:
    mut stack: Value[] = []
    mut returns: int[] = []
    mut variables = [0, 0]
    mut pc = 0
    while True:
        mut ins = program[pc]
        pc += 1
        if ins.op == 0:
            append(mut stack, Value.integer(value=seed))
        elif ins.op == 1:
            append(mut stack, Value.integer(value=size))
        elif ins.op == 2:
            append(mut stack, Value.integer(value=ins.arg))
        elif ins.op == 3:
            append(mut stack, Value.integer(value=variables[ins.arg]))
        elif ins.op == 4:
            variables[ins.arg] = integer(lists.pop(mut stack))
        elif ins.op >= 5 and ins.op <= 9:
            mut b = integer(lists.pop(mut stack))
            mut a = integer(lists.pop(mut stack))
            if ins.op == 5:
                append(mut stack, Value.integer(value=a + b))
            elif ins.op == 6:
                append(mut stack, Value.integer(value=a * b))
            elif ins.op == 7:
                append(mut stack, Value.integer(value=a % b))
            elif ins.op == 8:
                append(mut stack, Value.boolean(value=a < b))
            else:
                append(mut stack, Value.boolean(value=a == b))
        elif ins.op == 10:
            if not boolean(lists.pop(mut stack)):
                pc = ins.arg
        elif ins.op == 11:
            pc = ins.arg
        elif ins.op == 12:
            append(mut returns, pc)
            pc = ins.arg
        elif ins.op == 13:
            pc = lists.pop(mut returns)
        else:
            return integer(lists.pop(mut stack))
    return 0


func row_key(row: Row) -> int:
    return row.key


func fold(values: int[]) -> int:
    mut total = 0
    for j in range(len(values)):
        total += (j + 1) * values[j]
    return total


func batch_result(kind: int, size: int, batch: int, seed: int, values: int[], keys: str[], lookup: dict[int, int], lookup_str: dict[str, int], mut nested: int[][], program: Instruction[]) -> int:
    mut total = 0
    if kind == 0:
        for value in values:
            total += (value + batch) % 1009
        return total
    elif kind == 1:
        mut appended: int[] = []
        for j in range(size):
            append(mut appended, (seed + batch + j * 13) % 1009)
        return fold(appended)
    elif kind == 2:
        mut input_values: int[] = []
        for j in range(0, size):
            append(mut input_values, (seed + batch + j * 13) % 1009)
        mut filtered: int[] = []
        for value in input_values:
            if value % 3 == 0:
                append(mut filtered, value)
        return fold(filtered)
    elif kind == 3:
        for j in range(size):
            mut key = (seed + j * 17 + batch) % (size * 2)
            total += dicts.get(lookup, key, 17)
        return total
    elif kind == 4:
        for j in range(size):
            mut key = (seed + j * 17 + batch) % (size * 2)
            total += dicts.get(lookup_str, keys[key], 17)
        return total
    elif kind == 5:
        mut mapping: dict[int, int] = {}
        for j in range(size):
            mapping[j] = values[j]
        for j in range(size * 2):
            mut key = (seed + j * 17 + batch) % (size * 2)
            mapping[key] = (dicts.get(mapping, key, 17) + j + batch + 1) % 1000003
        for stored_key, value in dicts.items(mapping):
            total += stored_key + value
        return total
    elif kind == 6:
        mut text_mapping: dict[str, int] = {}
        for j in range(size):
            text_mapping[copy(keys[j])] = values[j]
        for j in range(size * 2):
            mut key = (seed + j * 17 + batch) % (size * 2)
            text_mapping[copy(keys[key])] = (dicts.get(text_mapping, keys[key], 17) + j + batch + 1) % 1000003
        for j in range(size * 2):
            if keys[j] in text_mapping:
                total += j + text_mapping[keys[j]]
        return total
    elif kind == 7:
        mut dedup: set[int] = set()
        mut limit = max(2, size // 4)
        for j in range(size):
            sets.add(mut dedup, (seed + batch + j * 13) % limit)
        for value in dedup:
            total += value
        return total
    elif kind == 8:
        for j in range(size):
            mut gather_result: int[] = []
            for k in range(0, 4):
                const gather_value: int = seed + batch + j + k
                append(mut gather_result, gather_value)
            mut short = own gather_result
            for value in short:
                total += value
            short = []
        return total
    elif kind == 9:
        mut retained: int[][] = []
        for j in range(size):
            mut retained_row: int[] = []
            for k in range(4):
                append(mut retained_row, seed + batch + j + k)
            append(mut retained, own retained_row)
        for inner in retained:
            for value in inner:
                total += value
        return total
    elif kind == 10:
        mut snapshot = copy(nested)
        mut index = (seed + batch * 17) % size
        nested[index][1] = (nested[index][1] + batch + 1) % 1000003
        return snapshot[index][1] + nested[index][1]
    elif kind == 11:
        mut ordered: int[] = []
        for j in range(0, size):
            append(mut ordered, (seed + batch + j * 13) % 1009)
        sort(mut ordered)
        return fold(ordered)
    elif kind == 12:
        mut rows: Row[] = []
        for j in range(size):
            mut value = (seed + batch + j * 13) % 1009
            append(mut rows, Row(key=value % 17, ordinal=j, value=value))
        sort(mut rows, key=row_key)
        for j in range(size):
            total += (j + 1) * (rows[j].value * 17 + rows[j].ordinal)
        return total
    elif kind == 13:
        return execute(program, size, seed + batch)
    return -1


func parse_number(text: str) -> int:
    match parse_int(text):
        case Some(n):
            return n
        case None:
            return 0


func main(args: str[], host: Host, out: Stream) -> int:
    if len(args) != 4:
        return 2
    mut case_id = -1
    mut names = ["list_scan", "list_append", "list_filter", "dict_lookup", "dict_lookup_str", "dict_update", "dict_update_str", "set_dedup", "alloc_short", "alloc_retained", "mutate_nested", "sort_int", "sort_records", "lox_eval"]
    for j in range(len(names)):
        if args[0] == names[j]:
            case_id = j
    if case_id < 0:
        return 2
    mut size = parse_number(args[1])
    mut iterations = parse_number(args[2])
    mut seed = parse_number(args[3])
    if size < 2 or iterations < 1 or seed < 1 or seed > 1000000:
        return 2
    mut values: int[] = []
    for j in range(0, size):
        append(mut values, (seed + j * 13) % 1009)
    mut keys: str[] = []
    if args[0] == "dict_lookup_str" or args[0] == "dict_update_str":
        mut gather_result: str[] = []
        for j in range(0, size * 2):
            const gather_value: str = str(j)
            append(mut gather_result, own gather_value)
        keys = own gather_result
    mut lookup: dict[int, int] = {}
    mut lookup_str: dict[str, int] = {}
    for j in range(size):
        if args[0] == "dict_lookup":
            lookup[j] = values[j]
        if args[0] == "dict_lookup_str":
            lookup_str[copy(keys[j])] = values[j]
    mut nested: int[][] = []
    if args[0] == "mutate_nested":
        mut gather_result_next: int[][] = []
        for j in range(0, size):
            mut gather_result_next_next: int[] = []
            for k in range(0, 4):
                const gather_value_next_next: int = (seed + j * 13 + k) % 1009
                append(mut gather_result_next_next, gather_value_next_next)
            const gather_value_next: int[] = own gather_result_next_next
            append(mut gather_result_next, own gather_value_next)
        nested = own gather_result_next
    mut program = [Instruction(op=0, arg=0), Instruction(op=4, arg=0), Instruction(op=2, arg=0), Instruction(op=4, arg=1), Instruction(op=3, arg=1), Instruction(op=1, arg=0), Instruction(op=8, arg=0), Instruction(op=10, arg=29), Instruction(op=3, arg=1), Instruction(op=2, arg=2), Instruction(op=7, arg=0), Instruction(op=2, arg=0), Instruction(op=9, arg=0), Instruction(op=10, arg=18), Instruction(op=3, arg=0), Instruction(op=12, arg=31), Instruction(op=4, arg=0), Instruction(op=11, arg=24), Instruction(op=3, arg=0), Instruction(op=3, arg=1), Instruction(op=5, arg=0), Instruction(op=2, arg=1000003), Instruction(op=7, arg=0), Instruction(op=4, arg=0), Instruction(op=3, arg=1), Instruction(op=2, arg=1), Instruction(op=5, arg=0), Instruction(op=4, arg=1), Instruction(op=11, arg=4), Instruction(op=3, arg=0), Instruction(op=14, arg=0), Instruction(op=2, arg=3), Instruction(op=6, arg=0), Instruction(op=2, arg=7), Instruction(op=5, arg=0), Instruction(op=2, arg=1000003), Instruction(op=7, arg=0), Instruction(op=13, arg=0)]
    mut checksum = 0
    mut start = runtime_bench_now(host)
    for batch in range(iterations):
        mut part = batch_result(case_id, size, batch, seed, values, keys, lookup, lookup_str, mut nested, program)
        if part < 0:
            return 2
        checksum = (checksum + part) % 1000000007
    mut elapsed = runtime_bench_now(host) - start
    if args[0] == "mutate_nested":
        for inner in nested:
            for value in inner:
                checksum = (checksum + value) % 1000000007
    print(out, checksum, elapsed)
    return 0
