module planner;
import json;
import schema;
import output;
import std_collections;
import std_order;
import std_json;
import std_graph;
export run;
result Outcome {
    ok: i64,
    err: i64
}
fn item(t: &[]i64, node: i64) -> std_order::Item {
    let start = std_json::get(t, node, 1);
    let end = std_json::get(t, node, 2);
    return new std_order::Item {
        value: node,
        first: cast<u64>(start),
        first_len: cast<u64>(end - start),
        second: 0u64,
        second_len: 0u64
    };
}
fn marker(value: i64) -> std_order::Item {
    return new std_order::Item {
        value: value,
        first: 0u64,
        first_len: 0u64,
        second: 0u64,
        second_len: 0u64
    };
}
fn sort(t: &[]i64, a: &mut []std_order::Item, n: i64) -> i64 {
    discard std_order::sort(t, a, 0u64, cast<u64>(n));
    return 0;
}
fn emit(t: &[]i64, a: &[]std_order::Item, n: i64) -> i64 {
    let mut i = 0;
    let mut prev = - 1;
    while i < n {
        let v = read_slice(a, i).value;
        if prev < 0 || !json::equal(t, prev, v) {
            if prev >= 0 {
                discard output::comma();
            }
            discard json::quoted(t, v);
            prev = v;
        }
        i += 1;
    }
    discard output::close();
    return 0;
}
fn lookup(t: &[]i64, ids: &[]std_order::Item, n: i64, p: i64) -> i64 {
    let at = std_order::lower_bound(t, ids, 0u64, cast<u64>(n), item(t, p));
    if at < cast<u64>(n) && json::equal(t, read_slice(ids, at).value, p) {
        return cast<i64>(at);
    }
    return - 1;
}
// Resolve application identifier dependencies into reusable graph edges.
fn graph(t: &[]i64, ids: &[]std_order::Item, needs: &[]i64, n: i64, edges: &mut []std_graph::Edge) -> i64 {
    let mut i = 0;
    let mut at = 0u64;
    while i < n {
        let mut p = read_slice(needs, i) + 1;
        while p < json::next(t, read_slice(needs, i)) {
            write_slice(edges, at, new std_graph::Edge {
                from: cast<u64>(lookup(t, ids, n, p)),
                to: cast<u64>(i)
            });
            at += 1u64;
            p = json::next(t, p);
        }
        i += 1;
    }
    return 0;
}
fn edge_count(t: &[]i64, jobs: i64) -> u64 {
    let mut count = 0u64;
    let mut p = jobs + 1;
    while p < json::next(t, jobs) {
        count += cast<u64>(schema::count(t, schema::field(t, p, "needs")));
        p = json::next(t, p);
    }
    return count;
}
// Complete each validation phase before emitting a result.
fn work(t: &[]i64, a: i64, ids: &mut []std_order::Item, durations: &mut []i64, needs: &mut []i64, done: &mut []i64, finish: &mut []i64, unknown: &mut []std_order::Item, scratch: &mut []std_order::Item, edges: &mut []std_graph::Edge) -> i64 {
    let id = "id";
    let dur = "duration";
    let dep = "needs";
    let n = schema::count(t, a);
    let mut p = a + 1;
    let mut i = 0;
    while i < n {
        let mut v = 0;
        borrow id[0..len(id)] as b {
            v = schema::field(t, p, b);
        }
        write_slice(ids, i, item(t, v));
        p = json::next(t, p);
        i += 1;
    }
    discard sort(t, ids, n);
    let mut repeated = 0;
    i = 1;
    while i < n {
        if json::equal(t, read_slice(ids, i - 1).value, read_slice(ids, i).value) {
            write_slice(unknown, repeated, read_slice(ids, i));
            repeated += 1;
        }
        i += 1;
    }
    if repeated > 0 {
        discard output::dup_id();
        return emit(t, unknown, repeated);
    }
    p = a + 1;
    while p < json::next(t, a) {
        let mut x = 0;
        borrow id[0..len(id)] as b {
            x = schema::field(t, p, b);
        }
        let j = lookup(t, ids, n, x);
        let mut d = 0;
        let mut nd = 0;
        borrow dur[0..len(dur)] as b {
            d = json::integer(t, schema::field(t, p, b));
        }
        borrow dep[0..len(dep)] as b {
            nd = schema::field(t, p, b);
        }
        write_slice(durations, j, d);
        write_slice(needs, j, nd);
        p = json::next(t, p);
    }
    i = 0;
    while i < n {
        let mut x = read_slice(needs, i) + 1;
        let mut count = 0;
        while x < json::next(t, read_slice(needs, i)) {
            write_slice(scratch, count, item(t, x));
            count += 1;
            x = json::next(t, x);
        }
        discard sort(t, scratch, count);
        let mut j = 1;
        while j < count {
            if json::equal(t, read_slice(scratch, j - 1).value, read_slice(scratch, j).value) {
                write_slice(done, i, 1);
            }
            j += 1;
        }
        i += 1;
    }
    i = 0;
    while i < n {
        if read_slice(done, i) == 1 {
            write_slice(unknown, repeated, read_slice(ids, i));
            repeated += 1;
            write_slice(done, i, 0);
        }
        i += 1;
    }
    if repeated > 0 {
        discard output::dup_dep();
        return emit(t, unknown, repeated);
    }
    i = 0;
    while i < n {
        let mut x = read_slice(needs, i) + 1;
        while x < json::next(t, read_slice(needs, i)) {
            if lookup(t, ids, n, x) < 0 {
                write_slice(unknown, repeated, item(t, x));
                repeated += 1;
            }
            x = json::next(t, x);
        }
        i += 1;
    }
    if repeated > 0 {
        discard sort(t, unknown, repeated);
        discard output::unknown();
        return emit(t, unknown, repeated);
    }
    discard graph(t, ids, needs, n, edges);
    discard std_graph::prepare(done, edges);
    let mut removed = 0;
    let mut progress = true;
    while progress {
        progress = false;
        i = 0;
        while i < n {
            if std_graph::ready(done, cast<u64>(i)) {
                discard std_graph::take_ready(done, cast<u64>(i));
                discard std_graph::complete(done, edges, cast<u64>(i));
                removed += 1;
                progress = true;
            }
            i += 1;
        }
    }
    if removed < n {
        i = 0;
        while i < n {
            if read_slice(done, i) != - 1 {
                write_slice(unknown, repeated, read_slice(ids, i));
                repeated += 1;
            }
            i += 1;
        }
        discard output::cycle();
        return emit(t, unknown, repeated);
    }
    discard std_graph::prepare(done, edges);
    discard output::order();
    removed = 0;
    while removed < n {
        let mut chosen = - 1;
        i = 0;
        while i < n && chosen < 0 {
            if std_graph::ready(done, cast<u64>(i)) {
                chosen = i;
            }
            i += 1;
        }
        if removed > 0 {
            discard output::comma();
        }
        discard json::quoted(t, read_slice(ids, chosen).value);
        let mut start = 0;
        let mut d = read_slice(needs, chosen) + 1;
        while d < json::next(t, read_slice(needs, chosen)) {
            let f = read_slice(finish, lookup(t, ids, n, d));
            if f > start {
                start = f;
            }
            d = json::next(t, d);
        }
        write_slice(finish, chosen, start + read_slice(durations, chosen));
        discard std_graph::take_ready(done, cast<u64>(chosen));
        discard std_graph::complete(done, edges, cast<u64>(chosen));
        removed += 1;
    }
    discard output::layers();
    discard std_graph::prepare(done, edges);
    removed = 0;
    let mut rounds = 0;
    while removed < n {
        if rounds > 0 {
            discard output::comma();
        }
        discard output::open();
        let mut count = 0;
        i = 0;
        while i < n {
            if std_graph::ready(done, cast<u64>(i)) {
                write_slice(unknown, count, marker(i));
                count += 1;
            }
            i += 1;
        }
        i = 0;
        while i < count {
            if i > 0 {
                discard output::comma();
            }
            let j = read_slice(unknown, i).value;
            discard json::quoted(t, read_slice(ids, j).value);
            discard std_graph::take_ready(done, cast<u64>(j));
            discard std_graph::complete(done, edges, cast<u64>(j));
            i += 1;
        }
        removed += count;
        rounds += 1;
        discard output::shut();
    }
    discard output::timings();
    let mut makespan = 0;
    i = 0;
    while i < n {
        if i > 0 {
            discard output::comma();
        }
        discard output::id();
        discard json::quoted(t, read_slice(ids, i).value);
        discard output::start();
        let f = read_slice(finish, i);
        discard json::number(f - read_slice(durations, i));
        discard output::finish();
        discard json::number(f);
        discard output::brace();
        if f > makespan {
            makespan = f;
        }
        i += 1;
    }
    discard output::makespan();
    discard json::number(makespan);
    discard output::brace();
    return 0;
}
// Owned buffers keep mutable scratch writes proportional to the changed element.
fn run(heap: allocator, t: &[]i64, p: i64) -> i64 {
    let a = schema::manifest(t, p);
    if a < 0 {
        return output::invalid_manifest();
    }
    match storage(t, heap, a) {
        Outcome.ok(value) => {
            return value;
        },
        Outcome.err(discard) => {
            return 1;
        }
    }
}
fn storage(t: &[]i64, heap: allocator, a: i64) -> Outcome {
    let mut ids = try std_collections::filled::< std_order::Item >(heap, 128u64, marker(0));
    let mut durations = try std_collections::filled::< i64 >(heap, 128u64, 0);
    let mut needs = try std_collections::filled::< i64 >(heap, 128u64, 0);
    let mut done = try std_collections::filled::< i64 >(heap, cast<u64>(schema::count(t, a)), 0);
    let mut finish = try std_collections::filled::< i64 >(heap, 128u64, 0);
    let mut unknown = try std_collections::filled::< std_order::Item >(heap, 16384u64, marker(0));
    let mut scratch = try std_collections::filled::< std_order::Item >(heap, 128u64, marker(0));
    let mut edges = try std_collections::filled::< std_graph::Edge >(heap, edge_count(t, a), new std_graph::Edge {
        from: 0u64,
        to: 0u64
    });
    borrow mut edges[0..len_buffer(edges)] as edges_view {
        borrow mut ids[0..len_buffer(ids)] as ids_view {
            borrow mut durations[0..len_buffer(durations)] as durations_view {
                borrow mut needs[0..len_buffer(needs)] as needs_view {
                    borrow mut done[0..len_buffer(done)] as done_view {
                        borrow mut finish[0..len_buffer(finish)] as finish_view {
                            borrow mut unknown[0..len_buffer(unknown)] as unknown_view {
                                borrow mut scratch[0..len_buffer(scratch)] as scratch_view {
                                    return new Outcome.ok(work(t, a, ids_view, durations_view, needs_view, done_view, finish_view, unknown_view, scratch_view, edges_view));
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
