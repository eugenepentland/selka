module output;
import json;
export invalid_request;
export invalid_manifest;
export results;
export close;
export dup_id;
export dup_dep;
export unknown;
export cycle;
export order;
export layers;
export timings;
export id;
export start;
export finish;
export makespan;
export brace;
export comma;
export open;
export shut;
fn invalid_request() -> i64 {
    return json::text("{\"error\":\"invalid-request\"}");
}
fn invalid_manifest() -> i64 {
    return json::text("{\"error\":\"invalid-manifest\"}");
}
fn results() -> i64 {
    return json::text("{\"results\":[");
}
fn close() -> i64 {
    return json::text("]}");
}
fn dup_id() -> i64 {
    return json::text("{\"error\":\"duplicate-id\",\"ids\":[");
}
fn dup_dep() -> i64 {
    return json::text("{\"error\":\"duplicate-dependency\",\"jobs\":[");
}
fn unknown() -> i64 {
    return json::text("{\"error\":\"unknown-dependency\",\"ids\":[");
}
fn cycle() -> i64 {
    return json::text("{\"error\":\"cycle\",\"blocked\":[");
}
fn order() -> i64 {
    return json::text("{\"order\":[");
}
fn layers() -> i64 {
    return json::text("],\"layers\":[");
}
fn timings() -> i64 {
    return json::text("],\"timings\":[");
}
fn id() -> i64 {
    return json::text("{\"id\":");
}
fn start() -> i64 {
    return json::text(",\"start\":");
}
fn finish() -> i64 {
    return json::text(",\"finish\":");
}
fn makespan() -> i64 {
    return json::text("],\"makespan\":");
}
fn brace() -> i64 {
    return json::text("}");
}
fn comma() -> i64 {
    return json::text(",");
}
fn open() -> i64 {
    return json::text("[");
}
fn shut() -> i64 {
    return json::text("]");
}
