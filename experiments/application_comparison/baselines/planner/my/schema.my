module schema;
import json;
import std_json;
export field;
export count;
export manifest;
export envelope;
fn field(t: &[]i64, p: i64, name: &[]u8) -> i64 {
    return std_json::field(t, p, name);
}
fn count(t: &[]i64, p: i64) -> i64 {
    return std_json::get(t, p, 4);
}
fn envelope(t: &[]i64, p: i64) -> i64 {
    if std_json::get(t, p, 0) != 1 || count(t, p) != 1 {
        return - 1;
    }
    let a = field(t, p, "cases");
    if std_json::get(t, a, 0) != 2 || count(t, a) > 64 {
        return - 1;
    }
    return a;
}
fn manifest(t: &[]i64, p: i64) -> i64 {
    if std_json::get(t, p, 0) != 1 || count(t, p) != 2 {
        return - 1;
    }
    let v = field(t, p, "version");
    let a = field(t, p, "jobs");
    if json::integer(t, v) != 1 || std_json::get(t, a, 0) != 2 || count(t, a) > 128 {
        return - 1;
    }
    let mut i = a + 1;
    while i < json::next(t, a) {
        if std_json::get(t, i, 0) != 1 || count(t, i) != 3 {
            return - 1;
        }
        let x = field(t, i, "id");
        let d = field(t, i, "duration");
        let n = field(t, i, "needs");
        if !json::identifier(t, x) || json::integer(t, d) < 0 || json::integer(t, d) > 1000000 || std_json::get(t, n, 0) != 2 || count(t, n) > 128 {
            return - 1;
        }
        let mut j = n + 1;
        while j < json::next(t, n) {
            if !json::identifier(t, j) {
                return - 1;
            }
            j = json::next(t, j);
        }
        i = json::next(t, i);
    }
    return a;
}
