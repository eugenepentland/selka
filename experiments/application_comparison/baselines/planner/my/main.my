module main;
import json;
import schema;
import planner;
import output;
fn main(heap: allocator) -> i64 {
    if !json::valid() {
        return output::invalid_request();
    }
    let a = schema::envelope(json::ws(0));
    if a < 0 {
        return output::invalid_request();
    }
    discard output::results();
    let mut p = json::ws(a + 1);
    let mut n = 0;
    while json::at(p) != 93 {
        if n > 0 {
            discard output::comma();
        }
        let status = planner::run(heap, p);
        if status != 0 {
            return status;
        }
        n += 1;
        p = json::next(p);
    }
    discard output::close();
    return 0;
}
