module main;
import io;
import std_json;
import std_text;
import std_ascii;
import std_order;
import std_collections;
buffer Words: i64;
result Acquired {
    ok: Words,
    err: i64
}
result Status {
    ok: bool,
    err: i64
}
fn main(heap: allocator) -> i64 {
    match execute(heap) {
        Status.ok(discard) => {
            return 0;
        },
        Status.err(code) => {
            return code;
        }
    }
}
fn execute(heap: allocator) -> Status {
    match std_text::read(heap, 1048576) {
        std_json::Input.err(discard) => {
            discard std_text::emit("{\"error\":\"invalid-request\"}");
        },
        std_json::Input.ok(bytes) => {
            match std_json::parse(heap, bytes, 1048576) {
                std_json::Parsed.err(discard) => {
                    discard std_text::emit("{\"error\":\"invalid-request\"}");
                },
                std_json::Parsed.ok(document) => {
                    let mut work = try acquire_buffer<Acquired>(heap, 17536);
                    discard try resize_buffer<Status>(work, 17536, 0);
                    let empty = new std_order::Item {
                        value: 0,
                        first: 0u64,
                        first_len: 0u64,
                        second: 0u64,
                        second_len: 0u64
                    };
                    match std_collections::filled::< std_order::Item >(heap, 16384u64, empty) {
                        std_collections::Created<std_order::Item>.err(code) => {
                            return new Status.err(code);
                        },
                        std_collections::Created<std_order::Item>.ok(storage) => {
                            let mut sorting = storage;
                            borrow mut sorting[0..len_buffer(sorting)] as items {
                                borrow document[0..len_buffer(document)] as t {
                                    borrow mut work[0..len_buffer(work)] as w {
                                        discard request(t, w, items);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return new Status.ok(true);
}
fn integer(t: &[]i64, n: i64, low: i64, high: i64) -> bool {
    return std_json::get(t, n, 0) == 4 && std_json::get(t, n, 5) >= low && std_json::get(t, n, 5) <= high;
}
fn identifier(t: &[]i64, n: i64) -> bool {
    if std_json::get(t, n, 0) != 3 {
        return false;
    }
    let head = new std_ascii::Class {
        lower: true,
        upper: false,
        digit: false,
        underscore: false,
        hyphen: false
    };
    let tail = new std_ascii::Class {
        lower: true,
        upper: false,
        digit: true,
        underscore: true,
        hyphen: true
    };
    borrow t[std_json::get(t, n, 1)..std_json::get(t, n, 2)] as text {
        return std_ascii::matches::< i64 >(text, head, tail, 1u64, 32u64);
    }
}
fn array(t: &[]i64, n: i64, limit: i64) -> bool {
    return std_json::get(t, n, 0) == 2 && std_json::get(t, n, 4) <= limit;
}
fn object(t: &[]i64, n: i64, size: i64) -> bool {
    return std_json::get(t, n, 0) == 1 && std_json::get(t, n, 4) == size;
}
fn schema(t: &[]i64, b: i64) -> bool {
    if !object(t, b, 7) || !integer(t, std_json::field(t, b, "version"), 1, 1) {
        return false;
    }
    let u = std_json::field(t, b, "unit");
    let um = "um";
    let mm = "mm";
    let mut unit = false;
    borrow um[0..len(um)] as s {
        unit = std_json::textis(t, u, s);
    }
    borrow mm[0..len(mm)] as s {
        unit = unit || std_json::textis(t, u, s);
    }
    if !unit || !integer(t, std_json::field(t, b, "width"), 1, 1000000) || !integer(t, std_json::field(t, b, "height"), 1, 1000000) || !integer(t, std_json::field(t, b, "clearance"), 0, 1000000) {
        return false;
    }
    let cs = std_json::field(t, b, "components");
    let ns = std_json::field(t, b, "nets");
    if !array(t, cs, 128) || !array(t, ns, 128) {
        return false;
    }
    let mut c = cs + 1;
    while c < std_json::get(t, cs, 3) {
        if !object(t, c, 6) || !identifier(t, std_json::field(t, c, "id")) || !integer(t, std_json::field(t, c, "x"), - 1000000, 1000000) || !integer(t, std_json::field(t, c, "y"), - 1000000, 1000000) || !integer(t, std_json::field(t, c, "width"), 1, 1000000) || !integer(t, std_json::field(t, c, "height"), 1, 1000000) {
            return false;
        }
        let ps = std_json::field(t, c, "pins");
        if !array(t, ps, 32) {
            return false;
        }
        let mut p = ps + 1;
        while p < std_json::get(t, ps, 3) {
            if !identifier(t, p) {
                return false;
            }
            let mut q = ps + 1;
            while q < p {
                if std_json::equal(t, p, q) {
                    return false;
                }
                q += 1;
            }
            p += 1;
        }
        c = std_json::get(t, c, 3);
    }
    let mut n = ns + 1;
    while n < std_json::get(t, ns, 3) {
        if !object(t, n, 2) || !identifier(t, std_json::field(t, n, "id")) {
            return false;
        }
        let ms = std_json::field(t, n, "members");
        if !array(t, ms, 128) {
            return false;
        }
        let mut m = ms + 1;
        while m < std_json::get(t, ms, 3) {
            if !object(t, m, 2) || !identifier(t, std_json::field(t, m, "component")) || !identifier(t, std_json::field(t, m, "pin")) {
                return false;
            }
            m = std_json::get(t, m, 3);
        }
        n = std_json::get(t, n, 3);
    }
    return true;
}
fn sort(t: &[]i64, w: &mut []i64, items: &mut []std_order::Item, base: i64, size: i64, mode: i64) -> i64 {
    let mut i = 0;
    while i < size {
        let node = read_slice(w, base + i);
        let mut first = node;
        let mut second = 0;
        if mode == 0 {
            first = std_json::field(t, node, "id");
        }
        if mode == 1 {
            first = std_json::field(t, node, "component");
            second = std_json::field(t, node, "pin");
        }
        let start = std_json::get(t, first, 1);
        let next = std_json::get(t, second, 1);
        write_slice(items, i, new std_order::Item {
            value: node,
            first: cast<u64>(start),
            first_len: cast<u64>(std_json::get(t, first, 2) - start),
            second: cast<u64>(next),
            second_len: cast<u64>(std_json::get(t, second, 2) - next)
        });
        i += 1;
    }
    discard std_order::sort(t, items, 0u64, cast<u64>(size));
    i = 0;
    while i < size {
        write_slice(w, base + i, read_slice(items, i).value);
        i += 1;
    }
    return 0;
}
fn collect(t: &[]i64, w: &mut []i64, base: i64, a: i64) -> i64 {
    let mut n = a + 1;
    let mut i = 0;
    while n < std_json::get(t, a, 3) {
        write_slice(w, base + i, n);
        i += 1;
        n = std_json::get(t, n, 3);
    }
    return i;
}
fn quote(t: &[]i64, n: i64) -> i64 {
    discard io::put(34u8);
    discard rawid(t, n);
    discard io::put(34u8);
    return 0;
}
// Schema-validated ASCII identifiers are safe in both JSON and SVG attributes.
fn rawid(t: &[]i64, n: i64) -> i64 {
    let mut p = std_json::get(t, n, 1);
    let end = std_json::get(t, n, 2);
    while p < end {
        discard io::put(cast<u8>(read_slice(t, p)));
        p += 1;
    }
    return 0;
}
fn member(t: &[]i64, m: i64) -> i64 {
    let a = "{\"component\":";
    borrow a[0..len(a)] as s {
        discard std_text::emit(s);
    }
    discard quote(t, std_json::field(t, m, "component"));
    let b = ",\"pin\":";
    borrow b[0..len(b)] as s {
        discard std_text::emit(s);
    }
    discard quote(t, std_json::field(t, m, "pin"));
    discard io::put(125u8);
    return 0;
}
fn findcomponent(t: &[]i64, w: &[]i64, nc: i64, id: i64) -> i64 {
    let mut lo = 0;
    let mut hi = nc;
    while lo < hi {
        let mid =(lo + hi) / 2;
        let c = std_json::compare(t, std_json::field(t, read_slice(w, mid), "id"), id);
        if c < 0 {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo < nc && std_json::equal(t, std_json::field(t, read_slice(w, lo), "id"), id) {
        return read_slice(w, lo);
    }
    return 0;
}
fn known(t: &[]i64, w: &[]i64, nc: i64, m: i64) -> bool {
    let c = findcomponent(t, w, nc, std_json::field(t, m, "component"));
    if c == 0 {
        return false;
    }
    let pins = std_json::field(t, c, "pins");
    let mut p = pins + 1;
    while p < std_json::get(t, pins, 3) {
        if std_json::equal(t, p, std_json::field(t, m, "pin")) {
            return true;
        }
        p += 1;
    }
    return false;
}
fn haspin(t: &[]i64, w: &[]i64, nr: i64, c: i64, p: i64) -> bool {
    let mut lo = 0;
    let mut hi = nr;
    while lo < hi {
        let mid =(lo + hi) / 2;
        let m = read_slice(w, 256 + mid);
        let mut cmp = std_json::compare(t, std_json::field(t, m, "component"), c);
        if cmp == 0 {
            cmp = std_json::compare(t, std_json::field(t, m, "pin"), p);
        }
        if cmp < 0 {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo >= nr {
        return false;
    }
    let m = read_slice(w, 256 + lo);
    return std_json::equal(t, std_json::field(t, m, "component"), c) && std_json::equal(t, std_json::field(t, m, "pin"), p);
}
fn distance(t: &[]i64, n: i64, key: &[]u8, mul: i64) -> i64 {
    return std_json::get(t, std_json::field(t, n, key), 5) * mul;
}
fn min(a: i64, b: i64) -> i64 {
    if a < b {
        return a;
    }
    return b;
}
fn max(a: i64, b: i64) -> i64 {
    if a > b {
        return a;
    }
    return b;
}
fn finding(t: &[]i64, code: i64, a: i64, b: i64, first: bool) -> i64 {
    if !first {
        discard io::put(44u8);
    }
    let prefix = "{\"code\":\"";
    borrow prefix[0..len(prefix)] as s {
        discard std_text::emit(s);
    }
    if code == 0 {
        let x = "clearance";
        borrow x[0..len(x)] as s {
            discard std_text::emit(s);
        }
    }
    if code == 1 {
        let x = "outside-board";
        borrow x[0..len(x)] as s {
            discard std_text::emit(s);
        }
    }
    if code == 2 {
        let x = "unconnected-pin";
        borrow x[0..len(x)] as s {
            discard std_text::emit(s);
        }
    }
    if code == 3 {
        let x = "underconnected-net";
        borrow x[0..len(x)] as s {
            discard std_text::emit(s);
        }
    }
    let middle = "\",\"subjects\":[";
    borrow middle[0..len(middle)] as s {
        discard std_text::emit(s);
    }
    discard quote(t, a);
    if b != 0 {
        discard io::put(44u8);
        discard quote(t, b);
    }
    let end = "]}";
    borrow end[0..len(end)] as s {
        discard std_text::emit(s);
    }
    return 0;
}
fn board(t: &[]i64, w: &mut []i64, items: &mut []std_order::Item, b: i64) -> i64 {
    if !schema(t, b) {
        let a = "{\"error\":\"invalid-board\"}";
        borrow a[0..len(a)] as s {
            discard std_text::emit(s);
        }
        return 0;
    }
    let nc = collect(t, w, 0, std_json::field(t, b, "components"));
    let nn = collect(t, w, 128, std_json::field(t, b, "nets"));
    discard sort(t, w, items, 0, nc, 0);
    discard sort(t, w, items, 128, nn, 0);
    let mut duplicate = false;
    let mut i = 1;
    while i < nc {
        if nodecmp(t, read_slice(w, i - 1), read_slice(w, i), 0) == 0 {
            duplicate = true;
        }
        i += 1;
    }
    i = 1;
    while i < nn {
        if nodecmp(t, read_slice(w, 128 + i - 1), read_slice(w, 128 + i), 0) == 0 {
            duplicate = true;
        }
        i += 1;
    }
    if duplicate {
        let a = "{\"error\":\"duplicate-id\",\"components\":[";
        borrow a[0..len(a)] as s {
            discard std_text::emit(s);
        }
        let mut ns = 0;
        while ns < 2 {
            let mut base = 0;
            let mut count = nc;
            if ns == 1 {
                base = 128;
                count = nn;
            }
            let mut first = true;
            i = 1;
            while i < count {
                let current = read_slice(w, base + i);
                if nodecmp(t, current, read_slice(w, base + i - 1), 0) == 0 &&(i == 1 || nodecmp(t, current, read_slice(w, base + i - 2), 0) != 0) {
                    if !first {
                        discard io::put(44u8);
                    }
                    discard quote(t, std_json::field(t, current, "id"));
                    first = false;
                }
                i += 1;
            }
            if ns == 0 {
                let separator = "],\"nets\":[";
                borrow separator[0..len(separator)] as s {
                    discard std_text::emit(s);
                }
            }
            ns += 1;
        }
        let z = "]}";
        borrow z[0..len(z)] as s {
            discard std_text::emit(s);
        }
        return 0;
    }
    let mut nr = 0;
    i = 0;
    while i < nn {
        nr += collect(t, w, 256 + nr, std_json::field(t, read_slice(w, 128 + i), "members"));
        i += 1;
    }
    discard sort(t, w, items, 256, nr, 1);
    let mut unknown = false;
    let mut reused = false;
    i = 0;
    while i < nr {
        let m = read_slice(w, 256 + i);
        if !known(t, w, nc, m) {
            unknown = true;
        }
        if i > 0 && nodecmp(t, m, read_slice(w, 255 + i), 1) == 0 {
            reused = true;
        }
        i += 1;
    }
    if unknown || reused {
        if unknown {
            let a = "{\"error\":\"unknown-pin\",\"refs\":[";
            borrow a[0..len(a)] as s {
                discard std_text::emit(s);
            }
        } else {
            let a = "{\"error\":\"reused-pin\",\"refs\":[";
            borrow a[0..len(a)] as s {
                discard std_text::emit(s);
            }
        }
        let mut first = true;
        i = 0;
        while i < nr {
            let m = read_slice(w, 256 + i);
            let distinct = i == 0 || nodecmp(t, m, read_slice(w, 255 + i), 1) != 0;
            let mut report = false;
            if unknown {
                report = !known(t, w, nc, m);
            } else {
                report = i + 1 < nr && nodecmp(t, m, read_slice(w, 257 + i), 1) == 0;
            }
            if distinct && report {
                if !first {
                    discard io::put(44u8);
                }
                discard member(t, m);
                first = false;
            }
            i += 1;
        }
        let z = "]}";
        borrow z[0..len(z)] as s {
            discard std_text::emit(s);
        }
        return 0;
    }
    let mut mul = 1;
    let mm = "mm";
    borrow mm[0..len(mm)] as s {
        if std_json::textis(t, std_json::field(t, b, "unit"), s) {
            mul = 1000;
        }
    }
    let width = distance(t, b, "width", mul);
    let height = distance(t, b, "height", mul);
    let clearance = distance(t, b, "clearance", mul);
    // Cache normalized rectangles once, before the quadratic pair scan.
    i = 0;
    while i < nc {
        let component_node = read_slice(w, i);
        let base = 16768 + i * 6;
        let px = distance(t, component_node, "x", mul);
        let py = distance(t, component_node, "y", mul);
        write_slice(w, base, px);
        write_slice(w, base + 1, py);
        write_slice(w, base + 2, px + distance(t, component_node, "width", mul));
        write_slice(w, base + 3, py + distance(t, component_node, "height", mul));
        write_slice(w, base + 4, std_json::field(t, component_node, "id"));
        i += 1;
    }
    let prefix = "{\"unit\":\"um\",\"findings\":[";
    borrow prefix[0..len(prefix)] as s {
        discard std_text::emit(s);
    }
    let mut first = true;
    i = 0;
    while i < nc {
        let base = 16768 + i * 6;
        let id = read_slice(w, base + 4);
        let x = read_slice(w, base);
        let y = read_slice(w, base + 1);
        let xe = read_slice(w, base + 2);
        let ye = read_slice(w, base + 3);
        let mut j = i + 1;
        while j < nc {
            let other = 16768 + j * 6;
            let dx = read_slice(w, other);
            let dy = read_slice(w, other + 1);
            let dxe = read_slice(w, other + 2);
            let dye = read_slice(w, other + 3);
            let gx = max(0, max(x - dxe, dx - xe));
            let gy = max(0, max(y - dye, dy - ye));
            if gx * gx + gy * gy < clearance * clearance ||(min(xe, dxe) > max(x, dx) && min(ye, dye) > max(y, dy)) {
                discard finding(t, 0, id, read_slice(w, other + 4), first);
                first = false;
            }
            j += 1;
        }
        i += 1;
    }
    i = 0;
    while i < nc {
        let c = read_slice(w, i);
        let x = distance(t, c, "x", mul);
        let y = distance(t, c, "y", mul);
        if x < 0 || y < 0 || x + distance(t, c, "width", mul) > width || y + distance(t, c, "height", mul) > height {
            discard finding(t, 1, std_json::field(t, c, "id"), 0, first);
            first = false;
        }
        i += 1;
    }
    i = 0;
    while i < nc {
        let c = read_slice(w, i);
        let id = std_json::field(t, c, "id");
        let np = collect(t, w, 16640, std_json::field(t, c, "pins"));
        discard sort(t, w, items, 16640, np, 2);
        let mut j = 0;
        while j < np {
            let p = read_slice(w, 16640 + j);
            if !haspin(t, w, nr, id, p) {
                discard finding(t, 2, id, p, first);
                first = false;
            }
            j += 1;
        }
        i += 1;
    }
    i = 0;
    while i < nn {
        let net = read_slice(w, 128 + i);
        if std_json::get(t, std_json::field(t, net, "members"), 4) < 2 {
            discard finding(t, 3, std_json::field(t, net, "id"), 0, first);
            first = false;
        }
        i += 1;
    }
    let middle = "],\"nets\":[";
    borrow middle[0..len(middle)] as s {
        discard std_text::emit(s);
    }
    i = 0;
    while i < nn {
        let net = read_slice(w, 128 + i);
        if i > 0 {
            discard io::put(44u8);
        }
        let a = "{\"id\":";
        borrow a[0..len(a)] as s {
            discard std_text::emit(s);
        }
        discard quote(t, std_json::field(t, net, "id"));
        let m = ",\"members\":[";
        borrow m[0..len(m)] as s {
            discard std_text::emit(s);
        }
        let nm = collect(t, w, 16640, std_json::field(t, net, "members"));
        discard sort(t, w, items, 16640, nm, 1);
        let mut lx = 0;
        let mut hx = 0;
        let mut ly = 0;
        let mut hy = 0;
        let mut j = 0;
        while j < nm {
            let ref = read_slice(w, 16640 + j);
            if j > 0 {
                discard io::put(44u8);
            }
            discard member(t, ref);
            let c = findcomponent(t, w, nc, std_json::field(t, ref, "component"));
            let x = 2 * distance(t, c, "x", mul) + distance(t, c, "width", mul);
            let y = 2 * distance(t, c, "y", mul) + distance(t, c, "height", mul);
            if j == 0 {
                lx = x;
                hx = x;
                ly = y;
                hy = y;
            } else {
                lx = min(lx, x);
                hx = max(hx, x);
                ly = min(ly, y);
                hy = max(hy, y);
            }
            j += 1;
        }
        let z = "],\"span\":";
        borrow z[0..len(z)] as s {
            discard std_text::emit(s);
        }
        discard std_text::number((hx - lx + hy - ly + 1) / 2);
        discard io::put(125u8);
        i += 1;
    }
    let svg = "],\"svg\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 ";
    borrow svg[0..len(svg)] as s {
        discard std_text::emit(s);
    }
    discard std_text::number(width);
    discard io::put(32u8);
    discard std_text::number(height);
    let rect = "\\\"><rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"";
    borrow rect[0..len(rect)] as s {
        discard std_text::emit(s);
    }
    discard std_text::number(width);
    let h = "\\\" height=\\\"";
    borrow h[0..len(h)] as s {
        discard std_text::emit(s);
    }
    discard std_text::number(height);
    let fill = "\\\" fill=\\\"white\\\" stroke=\\\"black\\\"/>";
    borrow fill[0..len(fill)] as s {
        discard std_text::emit(s);
    }
    i = 0;
    while i < nc {
        let c = read_slice(w, i);
        let r = "<rect id=\\\"";
        borrow r[0..len(r)] as s {
            discard std_text::emit(s);
        }
        discard rawid(t, std_json::field(t, c, "id"));
        let x = "\\\" x=\\\"";
        borrow x[0..len(x)] as s {
            discard std_text::emit(s);
        }
        discard std_text::number(distance(t, c, "x", mul));
        let y = "\\\" y=\\\"";
        borrow y[0..len(y)] as s {
            discard std_text::emit(s);
        }
        discard std_text::number(distance(t, c, "y", mul));
        let cw = "\\\" width=\\\"";
        borrow cw[0..len(cw)] as s {
            discard std_text::emit(s);
        }
        discard std_text::number(distance(t, c, "width", mul));
        borrow h[0..len(h)] as s {
            discard std_text::emit(s);
        }
        discard std_text::number(distance(t, c, "height", mul));
        let f = "\\\" fill=\\\"none\\\" stroke=\\\"black\\\"/>";
        borrow f[0..len(f)] as s {
            discard std_text::emit(s);
        }
        i += 1;
    }
    let end = "</svg>\"}";
    borrow end[0..len(end)] as s {
        discard std_text::emit(s);
    }
    return 0;
}
fn request(t: &[]i64, w: &mut []i64, items: &mut []std_order::Item) -> i64 {
    let cases = std_json::field(t, 1, "cases");
    if !object(t, 1, 1) || !array(t, cases, 64) {
        let a = "{\"error\":\"invalid-request\"}";
        borrow a[0..len(a)] as s {
            discard std_text::emit(s);
        }
        return 0;
    }
    let a = "{\"results\":[";
    borrow a[0..len(a)] as s {
        discard std_text::emit(s);
    }
    let mut c = cases + 1;
    let mut first = true;
    while c < std_json::get(t, cases, 3) {
        if !first {
            discard io::put(44u8);
        }
        discard board(t, w, items, c);
        first = false;
        c = std_json::get(t, c, 3);
    }
    let z = "]}";
    borrow z[0..len(z)] as s {
        discard std_text::emit(s);
    }
    return 0;
}
// IEEE binary64 overflow midpoint: 2^1024 - 2^970. Compare the normalized
// decimal significand exactly; truncation to 17 digits misclassifies neighbors.
fn nodecmp(t: &[]i64, a: i64, b: i64, mode: i64) -> i64 {
    if mode == 0 {
        return std_json::compare(t, std_json::field(t, a, "id"), std_json::field(t, b, "id"));
    }
    if mode == 2 {
        return std_json::compare(t, a, b);
    }
    let first = std_json::compare(t, std_json::field(t, a, "component"), std_json::field(t, b, "component"));
    if first != 0 {
        return first;
    }
    return std_json::compare(t, std_json::field(t, a, "pin"), std_json::field(t, b, "pin"));
}
