  "kind": "private n12 diagnostic, not full corpus acceptance",
  "source": "# binary_trees: perfect binary trees of recursive value nodes on the collecting heap.\n# Every short-lived tree becomes garbage after its check; the tracing\n# collector reclaims it. See SUITE.md section 1.\n\n\nrecord Node:\n    left: Option[Node]\n    right: Option[Node]\n\n\ndef make(depth: int) -> Node:\n    if depth == 0:\n        return Node(left=None, right=None)\n    return Node(left=Some(make(depth - 1)), right=Some(make(depth - 1)))\n\n\ndef check(node: Node) -> int:\n    left = node.left\n    right = node.right\n    if left is None or right is None:\n        return 1\n    return 1 + check(left) + check(right)\n\n\ndef main(out: Stream) -> int:\n    max_depth = 12\n    min_depth = 4\n\n    stretch = max_depth + 1\n    out.print(f\"stretch tree of depth {stretch}\\t check: {check(make(stretch))}\")\n\n    long_lived = make(max_depth)\n\n    depth = min_depth\n    while depth <= max_depth:\n        iterations = shift_left(1, max_depth - depth + min_depth)\n        total = 0\n        for _ in range(iterations):\n            total = total + check(make(depth))\n        out.print(f\"{iterations}\\t trees of depth {depth}\\t check: {total}\")\n        depth = depth + 2\n\n    out.print(f\"long lived tree of depth {max_depth}\\t check: {check(long_lived)}\")\n    return 0\n",
  "expected": "stretch tree of depth 13\t check: 16383\n4096\t trees of depth 4\t check: 126976\n1024\t trees of depth 6\t check: 130048\n256\t trees of depth 8\t check: 130816\n64\t trees of depth 10\t check: 131008\n16\t trees of depth 12\t check: 131056\nlong lived tree of depth 12\t check: 8191\n",
  "before_commit": "19cb079b0254f0631fd39044078dd74fa9546388",
  "after_patch": "diff --git a/src/qbe_rc_aggregate_test.zig b/src/qbe_rc_aggregate_test.zig\nindex a3416d51..bc61c151 100644\n--- a/src/qbe_rc_aggregate_test.zig\n+++ b/src/qbe_rc_aggregate_test.zig\n@@ -180,3 +180,16 @@ test \"RC scalar arithmetic in an owning frame emits only the managed input drop\"\n     const text = try findFunction(manifest.value, \"total\");\n     try t.expectEqual(@as(usize, 1), std.mem.count(u8, text, \"call $myl_qbe_rc_slot_drop\"));\n }\n+\n+// spec-case: RC-FRAME-1\n+test \"RC empty slot releases branch around native cleanup\" {\n+    const saved = runtime.get();\n+    defer runtime.set(saved);\n+    runtime.set(.rc);\n+    var manifest = try pairText();\n+    defer manifest.deinit();\n+    const text = try findFunction(manifest.value, \"pair\");\n+    const release = try location(text, \"call $myl_qbe_rc_slot_drop\");\n+    try t.expect(std.mem.indexOf(u8, text[0..release], \"@rcslotdrop\") != null);\n+    try t.expect(std.mem.indexOf(u8, text[release..], \"@rcslotdone\") != null);\n+}\ndiff --git a/src/qbe_rc_frame.zig b/src/qbe_rc_frame.zig\nindex 77485a68..576d58dc 100644\n--- a/src/qbe_rc_frame.zig\n+++ b/src/qbe_rc_frame.zig\n@@ -120,8 +120,13 @@ pub fn entry(comptime E: type, self: *E, index: usize, ty: typed.Type, address:\n }\n /// Clear/drop one dynamic typed entry using the runtime's unique/count ordering.\n pub fn drop(comptime E: type, self: *E, index: usize) Error!void {\n+    const live = self.temp();\n+    const label = self.temp();\n+    const flag = try guard(E, self, index);\n+    try self.print(\" %v{d} =w loaduw %v{d}\\n jnz %v{d}, @rcslotdrop{d}, @rcslotdone{d}\\n@rcslotdrop{d}\\n\", .{ live, flag, live, label, label, label });\n     const pointer = self.temp();\n     try self.print(\" %v{d} =l add %rcentries, {d}\\n call $myl_qbe_rc_slot_drop(l %ctx, l %v{d})\\n\", .{ pointer, index * entry_bytes, pointer });\n+    try self.print(\"@rcslotdone{d}\\n\", .{label});\n }\n fn localCount(comptime E: type, self: *E) usize {\n     return self.function.scope.locals.len;\n",
