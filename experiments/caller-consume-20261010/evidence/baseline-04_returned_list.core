fn probe(i64) -> i64
b0:
  %1 = call list[i64] make_values(param0)
  %2 = call i64 sum_values(%1)
  release %1
  ret %2

fn make_values(i64) -> list[i64]
b0:
  %2 = list_new list[i64] 0:i64
  jump b1
b1: ; preds b0 b3
  %6 = phi i64 0:i64, %16
  %12 = phi list[i64] %2, %13
  %8 = cmp.lt bool %6, 8:i64
  branch %8, b2, b4
b2: ; preds b1
  %11 = add.exact i64 param0, %6
  %13 = list_push list[i64] %12, %11
  jump b3
b3: ; preds b2
  %16 = add.proven i64 %6, 1:i64
  jump b1
b4: ; preds b1
  ret %12
