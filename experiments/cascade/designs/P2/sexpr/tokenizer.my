module sexpr.tokenizer

# S-expression tokenizer: the lexer feeding sexpr.parser, ported from
# eda/src/sexpr/tokenizer.zig and then generalised so that every lexical
# convention is a parameter instead of a constant.
#
# Default behaviour is the port's, unchanged: `(`/`)`, `;` line comments,
# quoted strings with `\` escapes (unterminated strings are rejected), atoms,
# the operator atoms `+ - * / % > < = !` including the two-character
# `>= <= == !=` forms, plain ints and floats, `mm`/`mil` dimension literals,
# SI-scaled literals for k/M/G/m/u/n/p (with `m` only when a unit letter
# follows, so bare `3m`, `mm` and `mil` keep their meanings), an optional
# trailing unit letter V/A/F/H/R, `%`-terminated literals, and the exact
# span/line/col bookkeeping. `tokenize(src)` is `tokenize_with(src,
# default_dialect())`, so every existing caller is unaffected.
#
# A caller can now vary, without touching this file:
#   * `Syntax` - the line- and block-comment introducers, the bracket
#     characters (and therefore the token set), the string quote, the string
#     escape character, the minus / decimal-point / percent characters and the
#     newline byte used for line counting.
#   * `CharClasses` - the whitespace, digit, atom-start, atom-continue,
#     operator and operator-tail predicates, so atom characters are data.
#   * `NumberPolicy` - the SI scale table, the accepted unit letters and the
#     dimension-suffix table (`mm`, `mil`) with the factor each normalises by.
# The parser reads the same `Dialect`, so classification and scaling cannot
# drift apart.
#
# Deliberately omitted / adapted:
#  - `Token.text` for a `string` is the raw source between the quotes, escapes
#    intact, exactly the slice Zig's tokenizer returns (the parser does not
#    unescape it either).
#  - Zig's `si_scales` / `si_unit_letters` / `percent_sign` tables are now the
#    `NumberPolicy` defaults; applying a multiplier is still the parser's job.
#  - Zig's `error_span` also records a column; the frozen LexError carries only
#    message/offset/line, so the column is derived by the parser from the offset.
#  - Source bytes are decoded to `str` (the frozen Token.text type); a slice
#    that is not valid UTF-8 becomes "" rather than being preserved raw.

import sexpr.ast as ast


public enum Kind:
    lparen,
    rparen,
    atom,
    string,
    int_val,
    float_val,
    unit_val,
    si_val,
    eof


public record Token:
    kind: Kind
    text: str
    span: ast.Span


public record LexError:
    message: str
    offset: int
    line: int


# ── Dialect: everything a reader may vary without editing the lexer ───

# Character-level conventions. Every field is a one-character string except the
# two comment introducers, which may be one or more characters; the empty
# string switches a convention off (no line comments, no block comments, and
# for `escape` no escape handling at all). `newline` is the byte that advances
# the reported line; `open_bracket`/`close_bracket` name the grouping tokens,
# which stay `Kind.lparen`/`Kind.rparen` whatever their spelling.
public record Syntax:
    line_comment: str = ";"
    block_comment_open: str = ""
    block_comment_close: str = ""
    open_bracket: str = "("
    close_bracket: str = ")"
    string_quote: str = "\""
    escape: str = "\\"
    minus: str = "-"
    decimal_point: str = "."
    percent: str = "%"
    newline: str = "\n"


# The predicates that decide what a byte is. Each takes a byte code (0..255),
# or -1 for "past the end of the source", which every default answers False to.
# They are callbacks so that a dialect can change the atom alphabet, the
# whitespace set and the operator set without the lexer knowing.
public record CharClasses:
    is_space: def(int) -> bool effects(managed_allocation)
    is_digit: def(int) -> bool effects(managed_allocation)
    is_atom_start: def(int) -> bool effects(managed_allocation)
    is_atom_continue: def(int) -> bool effects(managed_allocation)
    is_operator: def(int) -> bool effects(managed_allocation)
    is_operator_tail: def(int) -> bool effects(managed_allocation)


# One SI scale letter. `requires_unit` marks a scale that applies only when a
# unit letter follows (`m` in `10mA`), so bare `3m` stays an atom.
public record ScaleRule:
    letter: str
    factor: float
    requires_unit: bool = False


# One dimension suffix and the factor that normalises it to millimetres:
# `mm` is 1.0, `mil` is 0.0254. A caller may add inches, centimetres or any
# other unit; the parser multiplies by `to_mm` when it builds a measure node.
public record DimensionRule:
    suffix: str
    to_mm: float = 1.0


# The number tables: SI scale letters, the unit letters accepted after a scale
# or alone (`V A F H R`), and the dimension suffixes. Search order is list
# order, so an earlier rule wins when two could match.
public record NumberPolicy:
    scales: list[ScaleRule]
    unit_letters: list[str]
    dimensions: list[DimensionRule]


# The complete lexical configuration: character conventions, character classes
# and numeric tables. `default_dialect()` reproduces the ported reader exactly.
public record Dialect:
    syntax: Syntax
    chars: CharClasses
    numbers: NumberPolicy


public def byte_is_space(byte: int) -> bool effects():
    return byte == 32 or byte == 10 or byte == 13 or byte == 9


public def byte_is_digit(byte: int) -> bool effects():
    return byte >= 48 and byte <= 57


# Atom start, as in Zig: letters, `_`, `~`, `*`.
public def byte_is_atom_start(byte: int) -> bool effects():
    return (byte >= 97 and byte <= 122) or (byte >= 65 and byte <= 90) or byte == 95 or byte == 126 or byte == 42


# Atom continuation. `+`, `,` and `$` are mid-token only so vendor KiCad
# exports tokenize as one atom (`PMA3-24323LN+.stp`, `74AHCT1G125GF,132.stp`,
# `P$1`), while a leading one is still an operator.
public def byte_is_atom_continue(byte: int) -> bool effects():
    return byte_is_atom_start(byte) or byte_is_digit(byte) or byte == 45 or byte == 47 or byte == 46 or byte == 42 or byte == 35 or byte == 64 or byte == 58 or byte == 43 or byte == 44 or byte == 36


# Standalone operator characters. `*` is absent because it is an atom start.
public def byte_is_operator(byte: int) -> bool effects():
    return byte == 43 or byte == 45 or byte == 47 or byte == 37 or byte == 62 or byte == 60 or byte == 61 or byte == 33


# The second byte of a two-character operator (`>=`, `<=`, `==`, `!=`).
public def byte_is_operator_tail(byte: int) -> bool effects():
    return byte == 61


public def default_char_classes() -> CharClasses:
    return CharClasses(is_space=byte_is_space, is_digit=byte_is_digit, is_atom_start=byte_is_atom_start, is_atom_continue=byte_is_atom_continue, is_operator=byte_is_operator, is_operator_tail=byte_is_operator_tail)


# The tables Zig compiles in: k/M/G/u/n/p are bare scales, `m` requires a unit
# letter, V/A/F/H/R are unit letters, and the dimension suffixes are mm and mil.
public def default_number_policy() -> NumberPolicy:
    return NumberPolicy(
        scales=[
            ScaleRule(letter="k", factor=1e3),
            ScaleRule(letter="M", factor=1e6),
            ScaleRule(letter="G", factor=1e9),
            ScaleRule(letter="m", factor=1e-3, requires_unit=True),
            ScaleRule(letter="u", factor=1e-6),
            ScaleRule(letter="n", factor=1e-9),
            ScaleRule(letter="p", factor=1e-12),
        ],
        unit_letters=["V", "A", "F", "H", "R"],
        dimensions=[DimensionRule(suffix="mm", to_mm=1.0), DimensionRule(suffix="mil", to_mm=0.0254)],
    )


public def default_dialect() -> Dialect:
    return Dialect(syntax=Syntax(), chars=default_char_classes(), numbers=default_number_policy())


# ── Byte-level helpers shared with the parser ────────────────────────

# The byte code of a one-character convention string, or -1 for "" (off).
public def char_byte(text: str) -> int:
    if len(text) == 0:
        return -1
    return text.encode()[0]


# Whether `text` occurs in `src` at `offset`. An empty pattern never matches,
# which is how an empty `Syntax` field disables its convention.
public def matches_text(src: bytes, offset: int, text: str) -> bool:
    return matches_bytes(src, offset, text.encode())


# `matches_text` over an already-encoded pattern, so the scan loop does not
# re-encode a comment introducer per token.
public def matches_bytes(src: bytes, offset: int, pattern: bytes) -> bool:
    size = len(pattern)
    if size == 0:
        return False
    if offset < 0 or offset + size > len(src):
        return False
    index = 0
    while index < size:
        if src[offset + index] != pattern[index]:
            return False
        index = index + 1
    return True


# The scale factor for a suffix letter, or 1.0 when the letter is a unit letter
# or `%`. The parser applies this to a suffixed literal's numeric prefix.
public def scale_factor(numbers: NumberPolicy, letter: str) -> float:
    match find_scale(numbers, letter):
        case Some(rule):
            return rule.factor
        case None:
            return 1.0


def find_scale(numbers: NumberPolicy, letter: str) -> Option[ScaleRule]:
    for rule in numbers.scales:
        if rule.letter == letter:
            return Some(rule)
    return None


def has_unit_letter(numbers: NumberPolicy, letter: str) -> bool:
    for accepted in numbers.unit_letters:
        if accepted == letter:
            return True
    return False


# ── The cursor ───────────────────────────────────────────────────────

# Mirror of Zig's `Tokenizer` struct: the source, the `pos`/`line`/`col`
# cursor, the dialect's character classes, and the byte codes/patterns derived
# from its syntax so the scan loop does not re-encode a string per token. A
# class, so the scan helpers below mutate one shared cursor the way
# `*Tokenizer` methods do. The numeric tables stay out of the class and are
# threaded through the number path, because a class that reaches a `list` would
# make the caller's dialect look writable.
class Lexer:
    src: bytes
    pos: int
    line: int
    col: int
    chars: CharClasses
    scan: Scan


# The precomputed byte codes of a `Syntax`. Fields are -1 when the convention
# is switched off; `line_comment` and the block delimiters are byte patterns
# (empty means disabled).
record Scan:
    open: int
    close: int
    quote: int
    escape: int
    minus: int
    point: int
    percent: int
    newline: int
    line_comment: bytes
    block_open: bytes
    block_close: bytes


def scan_of(syntax: Syntax) -> Scan:
    return Scan(
        open=char_byte(syntax.open_bracket),
        close=char_byte(syntax.close_bracket),
        quote=char_byte(syntax.string_quote),
        escape=char_byte(syntax.escape),
        minus=char_byte(syntax.minus),
        point=char_byte(syntax.decimal_point),
        percent=char_byte(syntax.percent),
        newline=char_byte(syntax.newline),
        line_comment=syntax.line_comment.encode(),
        block_open=syntax.block_comment_open.encode(),
        block_close=syntax.block_comment_close.encode(),
    )


# A missing peek is reported as -1: bytes index to 0..255, so no real byte can
# collide with it, and every predicate below treats it as "not this character".
def peek(lx: Lexer) -> int:
    if lx.pos >= len(lx.src):
        return -1
    return lx.src[lx.pos]


def peek_at(lx: Lexer, offset: int) -> int:
    index = lx.pos + offset
    if index < 0 or index >= len(lx.src):
        return -1
    return lx.src[index]


# The one-character text at an offset from the cursor, or "" past the end.
# Used to test a byte against the dialect's scale and unit-letter tables, which
# are spelled as text.
def char_at(lx: Lexer, offset: int) -> str:
    index = lx.pos + offset
    if index < 0 or index >= len(lx.src):
        return ""
    return lexeme(lx.src, index, index + 1)


# Zig `Tokenizer.advance`: consuming a newline resets the column and bumps the
# line; any other byte advances the column. Past the end it is a no-op. The
# newline byte is the dialect's.
def advance(lx: Lexer):
    if lx.pos < len(lx.src):
        if lx.src[lx.pos] == lx.scan.newline:
            lx.line = lx.line + 1
            lx.col = 1
        else:
            lx.col = lx.col + 1
        lx.pos = lx.pos + 1


def space_byte(lx: Lexer, byte: int) -> bool:
    predicate = lx.chars.is_space
    return predicate(byte)


def digit_byte(lx: Lexer, byte: int) -> bool:
    predicate = lx.chars.is_digit
    return predicate(byte)


def atom_start_byte(lx: Lexer, byte: int) -> bool:
    predicate = lx.chars.is_atom_start
    return predicate(byte)


def atom_continue_byte(lx: Lexer, byte: int) -> bool:
    predicate = lx.chars.is_atom_continue
    return predicate(byte)


def operator_byte(lx: Lexer, byte: int) -> bool:
    predicate = lx.chars.is_operator
    return predicate(byte)


def operator_tail_byte(lx: Lexer, byte: int) -> bool:
    predicate = lx.chars.is_operator_tail
    return predicate(byte)


def lexeme(src: bytes, start: int, end: int) -> str:
    match src[start:end].decode():
        case Ok(text):
            return text
        case Err(_):
            return ""


# Length (1 or 2) of an SI value suffix starting at the cursor, or 0 for none.
#   scale letter alone:           `4.7k`, `10M`, `1n`
#   scale letter + unit letter:   `100nF`, `10mA`, `100mV`
#   unit letter alone:            `3.3V`, `0.5A`
#   unit-requiring scale:         `10mA` (but not bare `3m`)
def si_suffix_len(lx: Lexer, numbers: NumberPolicy) -> int:
    c0 = char_at(lx, 0)
    match find_scale(numbers, c0):
        case Some(rule):
            c1 = char_at(lx, 1)
            if rule.requires_unit:
                if has_unit_letter(numbers, c1) and not atom_continue_byte(lx, peek_at(lx, 2)):
                    return 2
                return 0
            if not atom_continue_byte(lx, peek_at(lx, 1)):
                return 1
            if has_unit_letter(numbers, c1) and not atom_continue_byte(lx, peek_at(lx, 2)):
                return 2
            return 0
        case None:
            if has_unit_letter(numbers, c0) and not atom_continue_byte(lx, peek_at(lx, 1)):
                return 1
            return 0


# The byte length of a dimension suffix at the cursor, or 0 for none. The
# suffix must end the token: `1.0mm` is a measure, `1.0mmx` falls back to an
# atom, exactly as the ported table did. Suffixes are tried in list order.
def dimension_suffix_len(lx: Lexer, numbers: NumberPolicy) -> int:
    for rule in numbers.dimensions:
        pattern = rule.suffix.encode()
        size = len(pattern)
        if matches_bytes(lx.src, lx.pos, pattern) and not atom_continue_byte(lx, peek_at(lx, size)):
            return size
    return 0


# Quoted string. The escape byte swallows the next byte unless it is switched
# off; running off the end of the source reports UnterminatedString at the
# opening quote, the most actionable location.
def read_string(lx: Lexer, line: int, col: int, offset: int) -> Result[Token, LexError]:
    advance(lx)  # skip opening quote
    start = lx.pos
    closed = False
    while lx.pos < len(lx.src) and not closed:
        ch = lx.src[lx.pos]
        if ch == lx.scan.escape:
            advance(lx)  # skip escape byte
            advance(lx)  # skip escaped char
        elif ch == lx.scan.quote:
            closed = True
        else:
            advance(lx)
    if not closed:
        return Err(LexError(message="unterminated string", offset=offset, line=line))
    text = lexeme(lx.src, start, lx.pos)
    advance(lx)  # skip closing quote
    return Ok(Token(kind=Kind.string, text=text, span=ast.Span(line=line, col=col, offset=offset)))


def read_atom(lx: Lexer, line: int, col: int, offset: int) -> Token:
    start = lx.pos
    # The atom-start predicate accepted this byte, so consume it even when a
    # dialect's continuation class does not include it; the scan then stops at
    # the first byte that is not an atom character.
    advance(lx)
    while atom_continue_byte(lx, peek(lx)):
        advance(lx)
    return Token(kind=Kind.atom, text=lexeme(lx.src, start, lx.pos), span=ast.Span(line=line, col=col, offset=offset))


# An operator atom, allowing the dialect's two-character forms (`>= <= == !=`).
def read_operator(lx: Lexer, line: int, col: int, offset: int) -> Token:
    start = lx.pos
    advance(lx)
    if operator_tail_byte(lx, peek(lx)):
        advance(lx)
    return Token(kind=Kind.atom, text=lexeme(lx.src, start, lx.pos), span=ast.Span(line=line, col=col, offset=offset))


# Number path: optional leading sign, digits, an optional fractional part, then
# one of the dimension suffixes (`mm`/`mil` by default), an SI suffix, the
# percent sign, or — when more atom characters follow — a fallback to an atom
# (`204928-0301.stp`, `12.5abc`, `100kHz`, `5V3`).
def read_number(lx: Lexer, numbers: NumberPolicy, line: int, col: int, offset: int) -> Token:
    start = lx.pos
    if peek(lx) == lx.scan.minus:
        advance(lx)
    while digit_byte(lx, peek(lx)):
        advance(lx)
    is_float = False
    if peek(lx) == lx.scan.point and digit_byte(lx, peek_at(lx, 1)):
        is_float = True
        advance(lx)  # skip .
        while digit_byte(lx, peek(lx)):
            advance(lx)
    num_end = lx.pos
    # Dimension suffixes: the token text stops before the suffix.
    size = dimension_suffix_len(lx, numbers)
    if size > 0:
        step = 0
        while step < size:
            advance(lx)
            step = step + 1
        return Token(kind=Kind.unit_val, text=lexeme(lx.src, start, num_end), span=ast.Span(line=line, col=col, offset=offset))
    # SI scale (or a bare unit letter); the text keeps the suffix verbatim so
    # the parser can apply the scale.
    suffix = si_suffix_len(lx, numbers)
    if suffix > 0:
        step = 0
        while step < suffix:
            advance(lx)
            step = step + 1
        return Token(kind=Kind.si_val, text=lexeme(lx.src, start, lx.pos), span=ast.Span(line=line, col=col, offset=offset))
    # Percent literal: only when the sign ends the token, so a standalone `%`
    # still lexes as an operator atom.
    if peek(lx) == lx.scan.percent and not atom_continue_byte(lx, peek_at(lx, 1)):
        advance(lx)
        return Token(kind=Kind.si_val, text=lexeme(lx.src, start, lx.pos), span=ast.Span(line=line, col=col, offset=offset))
    if atom_continue_byte(lx, peek(lx)):
        while atom_continue_byte(lx, peek(lx)):
            advance(lx)
        return Token(kind=Kind.atom, text=lexeme(lx.src, start, lx.pos), span=ast.Span(line=line, col=col, offset=offset))
    text = lexeme(lx.src, start, lx.pos)
    if is_float:
        return Token(kind=Kind.float_val, text=text, span=ast.Span(line=line, col=col, offset=offset))
    return Token(kind=Kind.int_val, text=text, span=ast.Span(line=line, col=col, offset=offset))


# Skip whitespace and comments. A line comment runs to the newline byte; a
# block comment runs to its closing delimiter and is rejected when the source
# ends first. Both are off when their introducer is the empty string.
def skip_trivia(lx: Lexer) -> Option[LexError]:
    skipping = True
    while skipping:
        byte = peek(lx)
        if space_byte(lx, byte):
            advance(lx)
        elif matches_bytes(lx.src, lx.pos, lx.scan.block_open):
            open_line = lx.line
            open_offset = lx.pos
            step = 0
            size = len(lx.scan.block_open)
            while step < size:
                advance(lx)
                step = step + 1
            closed = False
            while lx.pos < len(lx.src) and not closed:
                if matches_bytes(lx.src, lx.pos, lx.scan.block_close):
                    step = 0
                    size = len(lx.scan.block_close)
                    while step < size:
                        advance(lx)
                        step = step + 1
                    closed = True
                else:
                    advance(lx)
            if not closed:
                return Some(LexError(message="unterminated block comment", offset=open_offset, line=open_line))
        elif matches_bytes(lx.src, lx.pos, lx.scan.line_comment):
            while peek(lx) != -1 and peek(lx) != lx.scan.newline:
                advance(lx)
        else:
            skipping = False
    return None


# Lex the whole source into a token list ending in `eof`, or stop at the first
# LexError. `offset`/`line` in the error point at the offending byte (for an
# unterminated string or block comment, at its opening delimiter).
public def tokenize_with(src: bytes, dialect: Dialect) -> Result[list[Token], LexError]:
    lx = Lexer(src=src, pos=0, line=1, col=1, chars=dialect.chars, scan=scan_of(dialect.syntax))
    numbers = dialect.numbers
    tokens: list[Token] = []
    while True:
        match skip_trivia(lx):
            case Some(problem):
                return Err(problem)
            case None:
                pass
        line = lx.line
        col = lx.col
        offset = lx.pos
        byte = peek(lx)
        if byte == -1:
            tokens.append(Token(kind=Kind.eof, text="", span=ast.Span(line=line, col=col, offset=offset)))
            return Ok(tokens)
        if byte == lx.scan.open:
            advance(lx)
            tokens.append(Token(kind=Kind.lparen, text=lexeme(lx.src, offset, lx.pos), span=ast.Span(line=line, col=col, offset=offset)))
        elif byte == lx.scan.close:
            advance(lx)
            tokens.append(Token(kind=Kind.rparen, text=lexeme(lx.src, offset, lx.pos), span=ast.Span(line=line, col=col, offset=offset)))
        elif byte == lx.scan.quote:
            match read_string(lx, line, col, offset):
                case Ok(token):
                    tokens.append(token)
                case Err(problem):
                    return Err(problem)
        elif digit_byte(lx, byte) or (byte == lx.scan.minus and digit_byte(lx, peek_at(lx, 1))):
            tokens.append(read_number(lx, numbers, line, col, offset))
        elif atom_start_byte(lx, byte):
            tokens.append(read_atom(lx, line, col, offset))
        elif operator_byte(lx, byte):
            tokens.append(read_operator(lx, line, col, offset))
        else:
            return Err(LexError(message="unexpected character", offset=offset, line=line))


# Lex with the ported dialect: the default every existing caller gets.
public def tokenize(src: bytes) -> Result[list[Token], LexError]:
    return tokenize_with(src, default_dialect())
