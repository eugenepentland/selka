func mark(mut log: int[], value: int) -> int:
    log.append(value)
    return value


func generic_sum[T: integer](start: T, stop: T, stride: T) -> int:
    mut total = 0
    for item in range(start, stop, stride):
        if item == T(3):
            continue
        if item == T(7):
            break
        total += int(item)
    return total


func main() -> int:
    mut log: int[] = []
    mut total = 0
    for item in range(mark(mut log, 1), mark(mut log, 9), mark(mut log, 2)):
        if item == 3:
            continue
        if item == 7:
            break
        mut visible = item
        total += visible
        visible = 100
    if log != [1, 9, 2] or total != 6:
        return 1
    if generic_sum[int](1, 9, 2) != 6 or generic_sum[int](9, 0, -2) != 9:
        return 2
    mut upper: u8 = 0u8
    for item in range(200u8, 255u8, 50u8):
        upper = item
    if upper != 250u8:
        return 3
    mut nested = 0
    for row in range(2):
        for column in range(3):
            if column == 1:
                continue
            nested += row + column
    if nested != 6:
        return 4
    return 0
