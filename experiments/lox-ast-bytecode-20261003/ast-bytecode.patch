+# Every constant operand byte, including 255, must advance IP before the
+# checked pool read; consecutive prints then keep the following opcode aligned.
+public def test_run_constant_operand_last_byte(out: Stream) -> bool:
+    source = b""
+    expected = b""
+    i = 0
+    while i < 256:
+        text = str(i).encode()
+        source = source + b"print " + text + b";"
+        expected = expected + text + b"\n"
+        i = i + 1
+    observed = driver.run_source(source, driver.Engine.VM, True, out, None)
+    return observed.status == 0 and observed.stdout == expected and observed.stderr == b"" and observed.collections == observed.allocations
+
+
+# A false branch must decode a big-endian jump spanning byte 255 without
+# evaluating the skipped body; backward loop offsets cross the same boundary.
+public def test_run_bytecode_big_endian_jumps(out: Stream) -> bool:
+    padding = b""
+    i = 0
+    while i < 140:
+        padding = padding + b"nil;"
+        i += 1
+    source = b"if (false) {" + padding + b"print 99;} var n=0; while (n<2) {" + padding + b"n=n+1;} print n;"
+    observed = driver.run_source(source, driver.Engine.VM, True, out, None)
+    return observed.status == 0 and observed.stdout == b"2\n" and observed.stderr == b"" and observed.collections == observed.allocations
+
+
+# Rejected argument lists still finish byte emission and Lox error recovery;
+# a narrowed code buffer must not replace the compiler error with a cast trap.
+public def test_run_bytecode_argument_overflow(out: Stream) -> bool:
+    arguments = b"nil"
+    i = 1
+    while i < 256:
+        arguments = arguments + b",nil"
+        i += 1
+    sources = [b"fun f(){} f(" + arguments + b");", b"class C { m(){} } C().m(" + arguments + b");", b"class A { m(){} } class B < A { m(){ super.m(" + arguments + b"); } } B().m();"]
+    for source in sources:
+        observed = driver.run_source(source, driver.Engine.VM, True, out, None)
+        if observed.status != 65 or observed.stdout != b"" or observed.stderr != b"[line 1] Error at 'nil': Can't have more than 255 arguments.\n" or observed.collections != observed.allocations:
+            return False
+    return True
