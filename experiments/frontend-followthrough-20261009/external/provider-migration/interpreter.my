    mut __wb_486 = it.rt
    heap.push(mut __wb_486, value.Value.obj(value=heap.allocate(mut __wb_486, object.Obj.klass(value=klass))))
    it.rt = __wb_486
    mut methods = klass.methods
    mut klass_ref = as_obj(heap.peek(it.rt, 0))
    if superclass != value.NO_OBJ:
        table.add_all(heap.class_obj(it.rt, superclass).methods, mut methods)
        mut __wb_methods = it.rt
        heap.set_class_methods(mut __wb_methods, klass_ref, methods)
        it.rt = __wb_methods
        mut __wb_490 = it.rt
        mut env = new_env(mut __wb_490, __wb_490.current_env, 1)
        it.rt = __wb_490
        mut __wb_491 = it.rt
        heap.set_env_slot(mut __wb_491, env, 0, value.Value.obj(value=superclass))
        it.rt = __wb_491
        mut __wb_492 = it.rt
        switch_env(mut __wb_492, env)
        it.rt = __wb_492
    for method in node.methods:
        mut decl = it.program.functions[method]
        mut __wb_495 = it.rt
        mut function = heap.allocate(mut __wb_495, object.Obj.tree_function(value=object.TreeFunctionObj(decl=method, name=decl.name_ref, closure=__wb_495.current_env, is_initializer=decl.name_ref == __wb_495.init_string)))
        it.rt = __wb_495
        _ = table.set(mut methods, decl.name_ref, heap.string_hash(it.rt, decl.name_ref), value.Value.obj(value=function))
        mut __wb_methods = it.rt
        heap.set_class_methods(mut __wb_methods, klass_ref, methods)
        it.rt = __wb_methods
    if superclass != value.NO_OBJ:
        mut __wb_498 = it.rt
        restore_env(mut __wb_498)
        it.rt = __wb_498
    define(mut it, node.name_ref, node.slot)
    mut __wb_500 = it.rt
    _ = heap.pop(mut __wb_500)
    it.rt = __wb_500
    if superclass != value.NO_OBJ:
        mut __wb_502 = it.rt
        _ = heap.pop(mut __wb_502)
        it.rt = __wb_502
    return Ok(())


func execute_block(mut it: Interpreter, id: int, slot_count: int) -> Result[Flow, RuntimeError]:
    mut __wb_507 = it.rt
    switch_env(mut __wb_507, new_env(mut __wb_507, __wb_507.current_env, slot_count))
    it.rt = __wb_507
    mut outcome = run_block(mut it, id)
    mut __wb_509 = it.rt
    restore_env(mut __wb_509)
    it.rt = __wb_509
    return outcome


func execute(mut it: Interpreter, id: int) -> Result[Flow, RuntimeError]:
    match it.program.stmts[id]:
        case ast.Stmt.block(value=node):
            return execute_block(mut it, id, node.slot_count)
        case ast.Stmt.class_decl(value=_):
            try class_declaration(mut it, id)
        case ast.Stmt.expression(value=expr):
            try evaluate(mut it, expr)
            mut __wb_521 = it.rt
            _ = heap.pop(mut __wb_521)
            it.rt = __wb_521
        case ast.Stmt.function(value=index):
            mut decl = it.program.functions[index]
            mut __wb_524 = it.rt
            mut function = heap.allocate(mut __wb_524, object.Obj.tree_function(value=object.TreeFunctionObj(decl=index, name=decl.name_ref, closure=__wb_524.current_env, is_initializer=False)))
            it.rt = __wb_524
            mut __wb_525 = it.rt
            heap.push(mut __wb_525, value.Value.obj(value=function))
            it.rt = __wb_525
