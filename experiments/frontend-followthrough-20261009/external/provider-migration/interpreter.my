            mut __wb_556 = it.rt
            _ = heap.pop(mut __wb_556)
            it.rt = __wb_556
        case ast.Stmt.while_stmt(value=node):
            while True:
                try evaluate(mut it, node.condition)
                mut __wb_560 = it.rt
                mut __condition_560 = value.is_falsey(heap.pop(mut __wb_560))
                it.rt = __wb_560
                if __condition_560:
                    return Ok(Flow.NORMAL)
                mut flow = try execute(mut it, node.body)
                if flow == Flow.RETURN:
