            try evaluate(mut it, node.condition)
            mut __wb_530 = it.rt
            mut __condition_530 = not value.is_falsey(heap.pop(mut __wb_530))
            it.rt = __wb_530
            if __condition_530:
                return execute(mut it, node.then_branch)
            match node.else_branch:
                case Some(branch):
                    return execute(mut it, branch)
                case None:
                    pass
        case ast.Stmt.print(value=expr):
            try evaluate(mut it, expr)
            mut __wb_539 = it.out
            output.print_value(it.rt, mut __wb_539, heap.peek(it.rt, 0))
            it.out = __wb_539
            mut __wb_540 = it.rt
            _ = heap.pop(mut __wb_540)
            it.rt = __wb_540
        case ast.Stmt.return_stmt(value=node):
            match node.result:
                case Some(result):
                    try evaluate(mut it, result)
                case None:
                    mut __wb_546 = it.rt
                    heap.push(mut __wb_546, value.Value.nil)
                    it.rt = __wb_546
            mut __wb_547 = it.rt
            it.returned = heap.pop(mut __wb_547)
            it.rt = __wb_547
            return Ok(Flow.RETURN)
        case ast.Stmt.var_decl(value=node):
            match node.initializer:
                case Some(initializer):
