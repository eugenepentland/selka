
# Lox values: the tagged union both engines compute with, plus the rules for
# truthiness, equality and number formatting (SPEC §4.1 and §5).


# An index into the Runtime's object table (SPEC §7.1).
public type ObjRef = int


# The "no object" reference: an absent function name, the end of the open
# upvalue list, an empty table key, the global env's missing enclosing env.
public const NO_OBJ: int = -1


public enum Value:
    nil
    boolean(value: bool)
    number(value: float)
    obj(value: ObjRef)


# True exactly for nil and false.
public func is_falsey(value: Value) -> bool:
    match value:
        case Value.nil:
            return True
        case Value.boolean(value=flag):
            return not flag
        case _:
            return False


# Lox equality: tags must agree, numbers compare with IEEE `==` and objects
# by identity, which interning turns into string equality.
public func values_equal(a: Value, b: Value) -> bool:
    match a:
        case Value.nil:
            match b:
                case Value.nil:
                    return True
                case _:
                    return False
        case Value.boolean(value=left):
            match b:
                case Value.boolean(value=right):
                    return left == right
                case _:
                    return False
        case Value.number(value=left):
            match b:
                case Value.number(value=right):
                    return left == right
                case _:
                    return False
        case Value.obj(value=left):
            match b:
                case Value.obj(value=right):
                    return left == right
                case _:
                    return False


# The shortest round-trip digits of `x` in positional notation: `str` already
# renders floats that way, so only its trailing `.0` needs dropping.
public func format_number(x: float) -> bytes:
    mut text = str(x).encode()
    if text.endswith(b".0"):
        return text[0:len(text) - 2]
    return text
