
# SPEC §11.2 tests 16-20 and 22. Keys are object refs whose hashes the
# table caches, so these tests pick refs and hashes without a heap.
import table
import value


func hash_of(key: int) -> u32:
    return u32(key * 2654435761 % 4294967296)


func put(mut target: table.Table, key: int, number: float) -> bool:
    return table.set(mut target, key, hash_of(key), value.Value.number(value=number))


func lookup(source: table.Table, key: int) -> value.Value?:
    return table.get(source, key, hash_of(key))


func holds(source: table.Table, key: int, number: float) -> bool:
    match lookup(source, key):
        case Some(found):
            return found == value.Value.number(value=number)
        case None:
            return False


public func test_table_set_get() -> bool:
    mut t = table.new_table()
    _ = put(mut t, 1, 1.0)
    return holds(t, 1, 1.0) and (lookup(t, 2) is None)


public func test_table_set_reports_new_key() -> bool:
    mut t = table.new_table()
    mut first = put(mut t, 1, 1.0)
    mut second = put(mut t, 1, 2.0)
    return first and not second and holds(t, 1, 2.0)


public func test_table_grows_at_load_factor() -> bool:
    mut t = table.new_table()
    mut empty = table.capacity(t)
    _ = put(mut t, 1, 1.0)
    mut after_first = table.capacity(t)
    mut key = 2
    while key <= 6:
        _ = put(mut t, key, 1.0)
        key += 1
    mut after_sixth = table.capacity(t)
    _ = put(mut t, 7, 1.0)
    return empty == 0 and after_first == 8 and after_sixth == 8 and table.capacity(t) == 16


public func test_table_delete_leaves_tombstone() -> bool:
    mut t = table.new_table()
    _ = put(mut t, 1, 1.0)
    _ = put(mut t, 2, 2.0)
    _ = put(mut t, 3, 3.0)
    mut deleted = table.delete(mut t, 2, hash_of(2))
    return deleted and holds(t, 1, 1.0) and holds(t, 3, 3.0) and (lookup(t, 2) is None) and t.count == 3


public func test_table_tombstone_reuse() -> bool:
    mut t = table.new_table()
    _ = put(mut t, 1, 1.0)
    _ = put(mut t, 2, 2.0)
    _ = put(mut t, 3, 3.0)
    _ = table.delete(mut t, 2, hash_of(2))
    mut is_new = put(mut t, 2, 4.0)
    return is_new and t.count == 3 and holds(t, 2, 4.0)


public func test_table_add_all() -> bool:
    mut source = table.new_table()
    mut key = 1
    while key <= 10:
        _ = put(mut source, key, float(key))
        key += 1
    mut target = table.new_table()
    table.add_all(source, mut target)
    mut found = 0
    key = 1
    while key <= 10:
        if holds(target, key, float(key)):
            found += 1
        key += 1
    return found == 10
