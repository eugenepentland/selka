
# clox's open-addressing hash table, with each entry caching its key's hash
# so the table never reads the heap (SPEC §6.1).
import value


# An empty entry is (NO_OBJ, nil); a tombstone is (NO_OBJ, true).
public record Entry:
    key: value.ObjRef
    hash: u32
    value: value.Value


public record Table:
    entries: Entry[]
    count: int


public func new_table() -> Table:
    return Table(entries=[], count=0)


public func capacity(t: Table) -> int:
    return len(t.entries)


func empty_entry() -> Entry:
    return Entry(key=value.NO_OBJ, hash=0u32, value=value.Value.nil)


func is_tombstone(entry: Entry) -> bool:
    match entry.value:
        case value.Value.nil:
            return False
        case _:
            return True


# The slot holding `key`, else the first tombstone passed, else the empty
# slot that ended the probe.
func find_entry(entries: Entry[], key: value.ObjRef, hash: u32) -> int:
    mut mask = len(entries) - 1
    mut index = int(bit_and(hash, u32(mask)))
    mut tombstone = -1
    while True:
        mut entry = entries[index]
        if entry.key == value.NO_OBJ:
            if not is_tombstone(entry):
                if tombstone != -1:
                    return tombstone
                return index
            if tombstone == -1:
                tombstone = index
        elif entry.key == key:
            return index
        index = bit_and(index + 1, mask)


public func get(t: Table, key: value.ObjRef, hash: u32) -> value.Value?:
    if t.count == 0:
        return None
    mut entry = t.entries[find_entry(t.entries, key, hash)]
    if entry.key == value.NO_OBJ:
        return None
    return Some(entry.value)


func adjust_capacity(mut t: Table, new_capacity: int):
    mut entries: Entry[] = []
    mut i = 0
    while i < new_capacity:
        entries.append(empty_entry())
        i += 1
    t.count = 0
    for entry in t.entries:
        if entry.key != value.NO_OBJ:
            entries[find_entry(entries, entry.key, entry.hash)] = entry
            t.count = t.count + 1
    t.entries = entries


# Inserts or overwrites; answers whether the key was new. Reusing a
# tombstone does not grow `count`, which already includes it.
public func set(mut t: Table, key: value.ObjRef, hash: u32, stored: value.Value) -> bool:
    if float(t.count + 1) > float(len(t.entries)) * 0.75:
        if len(t.entries) < 8:
            adjust_capacity(mut t, 8)
        else:
            adjust_capacity(mut t, len(t.entries) * 2)
    mut index = find_entry(t.entries, key, hash)
    mut entry = t.entries[index]
    mut is_new = entry.key == value.NO_OBJ
    if is_new and not is_tombstone(entry):
        t.count = t.count + 1
    t.entries[index] = Entry(key=key, hash=hash, value=stored)
    return is_new


# Replaces the key's entry with a tombstone; answers whether it was present.
public func delete(mut t: Table, key: value.ObjRef, hash: u32) -> bool:
    if t.count == 0:
        return False
    mut index = find_entry(t.entries, key, hash)
    if t.entries[index].key == value.NO_OBJ:
        return False
    t.entries[index] = Entry(key=value.NO_OBJ, hash=0u32, value=value.Value.boolean(value=True))
    return True


# Copies every live entry of `source` into `target`.
public func add_all(source: Table, mut target: Table):
    for entry in source.entries:
        if entry.key != value.NO_OBJ:
            _ = set(mut target, entry.key, entry.hash, entry.value)
