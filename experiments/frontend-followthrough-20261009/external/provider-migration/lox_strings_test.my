
# SPEC §11.2 tests 12-15 and 21.
import heap
import lox_strings
import value


public func test_fnv1a_empty() -> bool:
    return lox_strings.fnv1a(b"") == 2166136261u32


public func test_fnv1a_a() -> bool:
    return lox_strings.fnv1a(b"a") == 3826002220u32


public func test_fnv1a_foobar() -> bool:
    return lox_strings.fnv1a(b"foobar") == 3214735720u32


public func test_intern_same_bytes_same_ref() -> bool:
    mut rt = heap.new_runtime(False, None)
    mut first = lox_strings.copy_string(mut rt, b"abc")
    mut second = lox_strings.copy_string(mut rt, b"abc")
    return first == second and rt.allocations == 1


public func test_table_find_string() -> bool:
    mut rt = heap.new_runtime(False, None)
    mut hello = lox_strings.copy_string(mut rt, b"hello")
    mut found = lox_strings.find_string(rt, b"hello", lox_strings.fnv1a(b"hello"))
    mut missing = lox_strings.find_string(rt, b"help", lox_strings.fnv1a(b"help"))
    return found == hello and missing == value.NO_OBJ
