
# SPEC §11.2 tests 1-11.
import scanner


func scan_all(source: bytes) -> scanner.Token[]:
    mut lexer = scanner.new_scanner(source)
    mut tokens: scanner.Token[] = []
    while True:
        mut token = scanner.scan_token(mut lexer)
        tokens.append(token)
        if token.kind == scanner.TokenKind.EOF:
            return tokens


func kinds(source: bytes) -> scanner.TokenKind[]:
    return [for token in scan_all(source) yield token.kind]


func lexemes(source: bytes) -> bytes[]:
    return [for token in scan_all(source) yield scanner.lexeme(source, token).copy()]


public func test_scan_empty_source() -> bool:
    mut tokens = scan_all(b"")
    return len(tokens) == 1 and tokens[0].kind == scanner.TokenKind.EOF and tokens[0].line == 1


public func test_scan_single_char_tokens() -> bool:
    mut expected = [
        scanner.TokenKind.LEFT_PAREN,
        scanner.TokenKind.RIGHT_PAREN,
        scanner.TokenKind.LEFT_BRACE,
        scanner.TokenKind.RIGHT_BRACE,
        scanner.TokenKind.SEMICOLON,
        scanner.TokenKind.COMMA,
        scanner.TokenKind.PLUS,
        scanner.TokenKind.MINUS,
        scanner.TokenKind.STAR,
        scanner.TokenKind.SLASH,
        scanner.TokenKind.DOT,
        scanner.TokenKind.BANG,
        scanner.TokenKind.EOF
    ]
    return kinds(b"(){};,+-*/.!") == expected


public func test_scan_two_char_tokens() -> bool:
    mut expected = [
        scanner.TokenKind.BANG_EQUAL,
        scanner.TokenKind.EQUAL_EQUAL,
        scanner.TokenKind.LESS_EQUAL,
        scanner.TokenKind.GREATER_EQUAL,
        scanner.TokenKind.LESS,
        scanner.TokenKind.GREATER,
        scanner.TokenKind.EQUAL,
        scanner.TokenKind.BANG,
        scanner.TokenKind.EOF
    ]
    return kinds(b"!= == <= >= < > = !") == expected


public func test_scan_keywords() -> bool:
    mut expected = [
        scanner.TokenKind.AND,
        scanner.TokenKind.CLASS,
        scanner.TokenKind.ELSE,
        scanner.TokenKind.FALSE,
        scanner.TokenKind.FOR,
        scanner.TokenKind.FUN,
        scanner.TokenKind.IF,
        scanner.TokenKind.NIL,
        scanner.TokenKind.OR,
        scanner.TokenKind.PRINT,
        scanner.TokenKind.RETURN,
        scanner.TokenKind.SUPER,
        scanner.TokenKind.THIS,
        scanner.TokenKind.TRUE,
        scanner.TokenKind.VAR,
        scanner.TokenKind.WHILE,
        scanner.TokenKind.EOF
    ]
    return kinds(b"and class else false for fun if nil or print return super this true var while") == expected


public func test_scan_identifiers() -> bool:
    mut source = b"andy _x x1 classy"
    mut identifier = scanner.TokenKind.IDENTIFIER
    mut expected_kinds = [identifier, identifier, identifier, identifier, scanner.TokenKind.EOF]
    mut expected_lexemes: bytes[] = [b"andy", b"_x", b"x1", b"classy", b""]
    return kinds(source) == expected_kinds and lexemes(source) == expected_lexemes


public func test_scan_numbers() -> bool:
    mut source = b"123 45.67 8."
    mut number = scanner.TokenKind.NUMBER
    mut expected_kinds = [number, number, number, scanner.TokenKind.DOT, scanner.TokenKind.EOF]
    mut expected_lexemes: bytes[] = [b"123", b"45.67", b"8", b".", b""]
    return kinds(source) == expected_kinds and lexemes(source) == expected_lexemes


public func test_scan_string() -> bool:
    mut source = b"\"hi there\""
    mut tokens = scan_all(source)
    return tokens[0].kind == scanner.TokenKind.STRING and scanner.lexeme(source, tokens[0]) == b"\"hi there\"" and tokens[1].kind == scanner.TokenKind.EOF


public func test_scan_multiline_string_line() -> bool:
    mut tokens = scan_all(b"\"a\nb\" x")
    return tokens[0].kind == scanner.TokenKind.STRING and tokens[0].line == 2 and tokens[1].kind == scanner.TokenKind.IDENTIFIER and tokens[1].line == 2


public func test_scan_unterminated_string() -> bool:
    mut tokens = scan_all(b"\"abc")
    return len(tokens) == 2 and tokens[0].kind == scanner.TokenKind.ERROR and tokens[0].message == b"Unterminated string." and tokens[1].kind == scanner.TokenKind.EOF


public func test_scan_unexpected_character() -> bool:
    mut tokens = scan_all(b"@")
    return tokens[0].kind == scanner.TokenKind.ERROR and tokens[0].message == b"Unexpected character."


public func test_scan_comments_and_lines() -> bool:
    mut source = b"// c\nx // d\n\ny"
    mut tokens = scan_all(source)
    return len(tokens) == 3 and scanner.lexeme(source, tokens[0]) == b"x" and tokens[0].line == 2 and scanner.lexeme(source, tokens[1]) == b"y" and tokens[1].line == 4 and tokens[2].kind == scanner.TokenKind.EOF and tokens[2].line == 4
