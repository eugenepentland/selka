export function l $reduce1(l %x,l %values,l %out) {
@start
 %a0 =l add %values,0
 %p0 =l loadl %a0
 %cond =w cnel %x,0
 jnz %cond,@yes,@no
@yes
 storew 17,%out
 jmp @join
@no
 storew 23,%out
 jmp @join
@join
 %truth =l phi @yes 1,@no 0
 %s0 =l add %truth,%p0
 ret %s0
}

