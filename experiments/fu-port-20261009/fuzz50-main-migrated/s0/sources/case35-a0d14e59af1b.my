def helper0(a: int, b: int) -> int:
    if (40 % a) == (a % 1000000007):
        return ((b + a) + (65536 % 3))
    return ((a % 7) // (0 - 4))


def helper1(a: int, b: int) -> int:
    return ((b * b) + (a // (0 - 6)))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(j - (j * seed)) for j in range(n)]
    second = [(j * 34 + 3) % 4000 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 4
        total = 0
        for j in range(n):
            x = values[n - 1 - j]
            y = second[j]
            v = ((y % 16) + phase)
            if flags[j]:
                v = phase
            else:
                v = v + (0 - 8)
            v = helper0(v, (phase % (0 - 8)))
            if (3037000500 * x) == (j * j):
                continue
            total += v
        acc = acc + total
    out.print(acc, len(values))
    return acc % 7

