def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(2)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("a")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(2))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(3))
    for i2 in range(0):
        il1.append(seed)
        sa4 = sl2
        sa4.append("bc")
        acc = acc + len(sa4)
        if len(rl3) > 3:
            sl2.append("bc")
            sa5 = sl2
    if len(il1) > 3:
        rl3.append(make_ints(seed))
        for i1 in range(2):
            ia6 = il1
            ia6.append(0)
            ia7 = il1
        il1.append(seed)
    il1.append(1)
    sa8 = sl2
    sa9 = sa8
    for i2 in range(3):
        sa10 = sa9
        for i1 in range(2):
            if len(rl3) > 0:
                inner11 = rl3[0]
                inner11.append(5)
                acc = acc + len(inner11) + len(rl3[0])
            sg12 = grow_str(sa10, 1)
            sa8.append("bc")
        sa8.append("xyz")
        ra13 = rl3
        for i1 in range(2):
            sa8.append("a")
            il1.append(i2)
            acc = acc + len(sl2)
            rg14 = grow_row(ra13, i1)
            sg15 = grow_str(sa10, i1)
        sa16 = sl2
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sa8) > 0:
        out.print(sa8[len(sa8) - 1])
    acc = acc + len(sa8)
    if len(sa9) > 0:
        out.print(sa9[len(sa9) - 1])
    acc = acc + len(sa9)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
