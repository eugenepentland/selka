def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(2)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("a")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(n))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("xyz")
    rl3: list[list[int]] = []
    rl3.append(make_ints(seed))
    if len(il1) > 0:
        sa4 = sl2
        il1.append(seed)
        return acc + len(il1)
    for i2 in range(0):
        if len(rl3) > 0:
            inner5 = rl3[0]
            inner5.append(5)
            acc = acc + len(inner5) + len(rl3[0])
        ra6 = rl3
    acc = acc + len(rl3)
    sa7 = sl2
    rl3.append(make_ints(3))
    sl2.append("bc")
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sa7) > 0:
        out.print(sa7[len(sa7) - 1])
    acc = acc + len(sa7)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
