def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(5)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("a")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(n))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(6)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(3))
    for i2 in range(1):
        sa4 = sl2
        for i1 in range(0):
            rl3.append(make_ints(2))
            acc = acc + len(rl3)
            ra5 = rl3
            acc = acc + len(sa4)
            acc = acc + len(il1)
            acc = acc + len(ra5)
        acc = acc + len(il1)
        rl3.append(make_ints(2))
        sg6 = grow_str(sl2, i2)
    ra7 = rl3
    for i2 in range(0):
        if len(ra7) > 3:
            rg8 = grow_row(rl3, seed)
            sa9 = sl2
            ra10 = rg8
            if len(ra10) > 0:
                inner11 = ra10[0]
                inner11.append(5)
                acc = acc + len(inner11) + len(ra10[0])
            return acc + len(ra7)
        rl3.append(make_ints(2))
        il1.append(i2)
        for i1 in range(0):
            rl3.append(make_ints(i2))
            ra12 = ra7
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(ra7)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
