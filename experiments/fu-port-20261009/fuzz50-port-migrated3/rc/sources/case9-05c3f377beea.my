def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(9)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("a")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(2))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("a")
    rl3: list[list[int]] = []
    rl3.append(make_ints(3))
    ia4 = il1
    sg5 = grow_str(sl2, 1)
    for i2 in range(0):
        il1.append(seed)
        if len(il1) > 0:
            acc = acc + len(ia4)
            il1.append(seed)
        sl2.append("xyz")
        ia6 = ia4
        ia7 = ia6
    il1.append(4)
    if len(sl2) > 0:
        for i1 in range(3):
            ia4.append(i1)
            sl2.append("xyz")
            ra8 = rl3
            acc = acc + len(ra8)
            sa9 = sl2
            acc = acc + len(ra8)
        ig10 = grow_int(ia4, 1)
        sa11 = sg5
        sa11.append("a")
        ia12 = il1
        sl2.append("bc")
        return acc + len(sl2)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(ia4)
    if len(sg5) > 0:
        out.print(sg5[len(sg5) - 1])
    acc = acc + len(sg5)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
