def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(1)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("xyz")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(2))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("a")
    rl3: list[list[int]] = []
    rl3.append(make_ints(seed))
    for i2 in range(1):
        rl3.append(make_ints(seed))
        ia4 = il1
        rl3.append(make_ints(i2))
        for i1 in range(1):
            ia5 = ia4
            acc = acc + len(il1)
            acc = acc + len(ia5)
        ra6 = rl3
        for i1 in range(1):
            ra6.append(make_ints(3))
            acc = acc + len(ra6)
            ig7 = grow_int(ia4, i1)
    il1.append(seed)
    ra8 = rl3
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(ra8)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
