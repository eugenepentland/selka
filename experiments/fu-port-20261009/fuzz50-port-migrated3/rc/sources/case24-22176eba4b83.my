def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(2)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("xyz")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(2))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(6)
    sl2: list[str] = []
    sl2.append("a")
    rl3: list[list[int]] = []
    rl3.append(make_ints(seed))
    ia4 = il1
    for i2 in range(1):
        if len(sl2) > 2:
            ia5 = il1
            ra6 = rl3
            acc = acc + len(rl3)
            acc = acc + len(rl3)
            acc = acc + len(sl2)
            return acc + len(sl2)
        ra7 = rl3
        for i1 in range(0):
            ra8 = ra7
            ra7.append(make_ints(3))
            ig9 = grow_int(il1, i2)
            ra10 = rl3
            acc = acc + len(ia4)
            ra8.append(make_ints(i2))
        for i1 in range(1):
            acc = acc + len(ra7)
            sl2.append("bc")
        for i1 in range(3):
            acc = acc + len(sl2)
            acc = acc + len(rl3)
            rg11 = grow_row(rl3, i2)
            ia12 = il1
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(ia4)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
