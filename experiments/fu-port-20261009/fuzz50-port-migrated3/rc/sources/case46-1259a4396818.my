def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(2))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(2)
    sl2: list[str] = []
    sl2.append("a")
    rl3: list[list[int]] = []
    rl3.append(make_ints(3))
    sa4 = sl2
    acc = acc + len(il1)
    if len(sl2) > 2:
        if len(il1) > 0:
            sa4.append("xyz")
            acc = acc + len(sl2)
            ia5 = il1
            if len(rl3) > 0:
                inner6 = rl3[0]
                inner6.append(5)
                acc = acc + len(inner6) + len(rl3[0])
            ig7 = grow_int(il1, seed)
            acc = acc + len(ig7)
            return acc + len(il1)
        ra8 = rl3
        if len(rl3) > 1:
            ra8.append(make_ints(2))
            ra9 = rl3
            if len(ra8) > 0:
                inner10 = ra8[0]
                inner10.append(5)
                acc = acc + len(inner10) + len(ra8[0])
            sa11 = sl2
            ia12 = il1
            acc = acc + len(sa11)
            return acc + len(rl3)
        sl2.append("xyz")
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sa4) > 0:
        out.print(sa4[len(sa4) - 1])
    acc = acc + len(sa4)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
