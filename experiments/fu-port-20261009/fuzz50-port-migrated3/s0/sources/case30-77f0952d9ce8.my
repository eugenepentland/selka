def helper0(a: int, b: int) -> int:
    if (b % (0 - 6)) != (a + 4):
        return b
    return ((a + b) * 28)


def helper1(a: int, b: int) -> int:
    if (b * b) == (a + b):
        return ((a // 17) % 7)
    return (a * (b + 41))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [((1009 // 7)) % 7 for j in range(n)]
    second = [(j * 2 + 3) % 7 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 13
        total = 0
        for j in range(n):
            x = values[j]
            y = second[j]
            v = (((35 + phase) * (35 * x)) // 2)
            total += v
        acc = acc + total
    out.print(acc, len(values))
    return acc % 7

