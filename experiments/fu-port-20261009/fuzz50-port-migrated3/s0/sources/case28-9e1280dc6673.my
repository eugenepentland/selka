def probe(xs: list[int], key: int) -> int:
    low = 0
    high = len(xs)
    while low < high:
        middle = (low + high) // 2
        if xs[middle] < key:
            low = middle + 1
        else:
            high = middle
    if low < len(xs) and xs[low] == key:
        return low + 1
    return 0


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((seed * j) // (0 - 1))) % 7 for j in range(n)]
    second = [(j * 43 + 3) % 7 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 18
        total = 0
        for j in range(len(values)):
            x = values[j]
            y = second[j]
            v = (((x // 7) + (x * 7)) + ((y * j) + (seed // 1)))
            if flags[j]:
                v = ((v - x) * (v - v))
            else:
                v = v + 21
            if (45 - 40) > (seed - j):
                continue
            total += v
        acc = acc + total
    acc = acc + probe(second, (17 + acc))
    out.print(acc, len(values))
    return acc % 7

