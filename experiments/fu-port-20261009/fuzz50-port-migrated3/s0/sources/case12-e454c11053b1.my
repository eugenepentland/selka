def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [((14 - (46 % 7))) % 17 for j in range(n)]
    second = [(j * 18 + 3) % 1009 for j in range(n)]
    flags = [(j * j) < j or j < 14 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 1
        total = 0
        for j in range(n + 2):
            x = values[j]
            y = second[j % n]
            v = (((j * seed) % 1000000007) - 13)
            if (25 + y) >= j or y < 18:
                continue
            if (x // 1009) < (seed % 1):
                break
            total += v
        acc = (acc + total) % 1000000007
    out.print(acc, len(values))
    return acc % 7

