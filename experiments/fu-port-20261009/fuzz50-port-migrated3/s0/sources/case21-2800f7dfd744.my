def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(2) % 7 for j in range(n)]
    second = [(j * 43 + 3) % 4000 for j in range(n)]
    flags = [(seed - 38) != ((0 - 21) * seed) for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 4
        total = 0
        for j in range(n + 1):
            x = values[0 - 1 - j]
            y = second[j % n]
            v = ((x * 34) + ((31 % 1) * (y + (0 - 33))))
            if flags[j % n]:
                v = ((j - y) % (30 * 23))
            else:
                v = v + 32
            if (seed - x) != (seed // j):
                continue
            if (j + 65536) >= (phase // 2) or phase > 41:
                break
            total += v
        acc = (acc + total) % 1000000007
    out.print(acc, len(values))
    return acc % 7

