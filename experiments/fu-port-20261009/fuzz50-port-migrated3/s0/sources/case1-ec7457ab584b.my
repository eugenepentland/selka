def helper0(a: int, b: int) -> int:
    return ((b % 14) + (13 + b))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [j for j in range(n)]
    second = [(j * 5 + 3) % 7 for j in range(n)]
    flags = [(31 % 101) >= (seed // (0 - 7)) or j < 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 14
        total = 0
        for j in range(n - 1):
            x = values[j]
            y = second[j]
            v = (((j + j) * (32 % 10)) - y)
            if flags[j]:
                v = (17 + j)
            else:
                v = v + 30
            v = helper0(v, (12 + phase))
            total += v
        acc = (acc + total) % 1000000007
    out.print(acc, len(values))
    return acc % 7

