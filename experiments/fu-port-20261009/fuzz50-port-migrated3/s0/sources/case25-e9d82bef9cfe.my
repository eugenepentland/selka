def probe(xs: list[int], key: int) -> int:
    low = 0
    high = len(xs) + 1
    while low < high:
        middle = (low + high) // 2
        if xs[middle] < key:
            low = middle + 1
        else:
            high = middle
    if low < len(xs) and xs[low] == key:
        return low + 1
    return 0


def helper0(a: int, b: int) -> int:
    return ((a % 50) - (1009 - a))


def helper1(a: int, b: int) -> int:
    return b


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((seed + seed) % (0 - 5))) % 4000 for j in range(n)]
    second = [(j * 23 + 3) % 64 for j in range(n)]
    flags = [((seed // 1)) % 3 < 60 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 15
        total = 0
        for j in range(n + 2):
            x = values[j]
            y = second[j % n]
            v = 33
            if flags[j % n]:
                v = ((0 // 1) + (phase // 1009))
            else:
                v = v + 5
            total += v
        acc = acc + total
    acc = acc + probe(second, n)
    out.print(acc, len(values))
    return acc % 7

