def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def fold(values: list[int]) -> int:
    total = 0
    for value in values:
        total = (total * 31 + value) % 1000003
    return total


record Bucket:
    count: int
    items: list[int]


def bucket_total(b: Bucket) -> int:
    t = b.count
    for x in b.items:
        t = (t * 7 + x) % 1000003
    return t


def grow(b: Bucket, v: int) -> Bucket:
    items = b.items
    items.append(v)
    return Bucket(b.count + 1, items)


record Pair:
    a: int
    b: int


union Item:
    empty,
    num: int,
    pair: Pair,
    bag: Bucket


def weigh(item: Item) -> int:
    match item:
        case Item.num(v):
            return v
        case Item.pair(p):
            return p.a * 3 + p.b
        case Item.bag(g):
            return len(g.items) + g.count
        case _:
            return 1


def sum_items(items: list[Item]) -> int:
    t = 0
    for i in range(len(items)):
        t = (t * 5 + weigh(items[i])) % 1000003
    return t


def bump(xs: mut list[int], k: int):
    xs.append(k)
    xs[0] = (xs[0] + k) % 1009


def fill(xs: mut list[int], k: int):
    for j in range(k % 4):
        xs.append(j * 3 + k)


def swap_ends(xs: mut list[int]):
    last = len(xs) - 1
    first = xs[0]
    xs[0] = xs[last]
    xs[last] = first


def twice(xs: mut list[int], k: int):
    bump(mut xs, k)
    bump(mut xs, k + 1)


def touch(b: mut Bucket, v: int):
    b.items[0] = v
    b.count = b.count + 1
    b.items.append(v)


def touch_items(b: mut Bucket, v: int):
    bump(mut b.items, v)
    b.count = b.count + 2


def rebuild(b: mut Bucket, v: int):
    b = Bucket(v % 5, [v, v + 1])


def both(xs: list[int], ys: list[int]) -> int:
    return len(xs) * 100 + len(ys) + xs[0] + ys[0]


def step0(x: int) -> Result[int, str]:
    if x % 3 == 0:
        return Err("bad")
    return Ok((x * 4 + 3) % 1009)


def step1(x: int) -> Result[int, str]:
    if x % 11 == 0:
        return Err("bad")
    return Ok((x * 9 + 7) % 1009)


def step2(x: int) -> Result[int, str]:
    if x % 11 == 0:
        return Err("bad")
    return Ok((x * 4 + 3) % 1009)


def step3(x: int) -> Result[int, str]:
    if x % 7 == 2:
        return Err("bad")
    return Ok((x * 4 + 1) % 1009)


def chain0(x: int) -> Result[int, str]:
    v0 = step2(x)?
    v1 = step3(v0 + 1)?
    if v1 > 680:
        return Ok(v1)
    v2 = step0(v1 + 1)?
    if v2 > 558:
        return Ok(v2)
    v3 = step3(v2 + 1)?
    return Ok(v0 + v1 + v2 + v3)


def sum_checked(xs: list[int]) -> Result[int, str]:
    t = 0
    for x in xs:
        t = (t + step1(x)?) % 1000003
    return Ok(t)


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 1 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    acc = 0
    xs = [(j * 10 + seed) % 1009 for j in range(n)]
    ys = [(j * 5 + 1) % 997 for j in range(n)]
    b = Bucket(n, xs)
    c = Bucket(1, [seed])
    items: list[Item] = []
    items.append(Item.num(seed))
    for r in range(rounds):
        acc = (acc + r) % 1000003
        if acc % 3 == 0:
            match chain0(acc):
                case Ok(v):
                    acc = v
                case Err(e):
                    acc = len(e)
        c.items.append((10) % 1009)
        b.items[((seed) % 1009) % len(b.items)] = (((n * seed) // 1000000007)) % 1009
    acc = (acc + both(xs, ys)) % 1000003
    twice(mut xs, (4611686018427387904) % 1009)
    touch_items(mut b, (n) % 1009)
    bump(mut xs, (((seed * 23) // 1009)) % 1009)
    ys[((((43 + seed) - (43 - acc))) % 1009) % (len(ys) + 1)] = ((0 - 39)) % 1009
    bump(mut c.items, ((acc * acc)) % 1009)
    out.print(acc, fold(xs), fold(ys), b.count, fold(b.items), c.count, fold(c.items), sum_items(items), len(items))
    return acc % 7

