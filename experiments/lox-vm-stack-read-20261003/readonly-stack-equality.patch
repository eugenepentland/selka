+# A saved Runtime and stack list stay snapshots while the live VM repeatedly
+# replaces compared operands with bools and allocates after the comparison.
+public def test_run_readonly_stack_equality_preserves_snapshots(out: Stream) -> bool:
+    rt = heap.new_runtime(True, None)
+    captured = output.capture(out)
+    setup = b"class Box {} var a = Box(); var b = a; var text = \"same\";"
+    if stack_vm.interpret(mut rt, mut captured, setup) != stack_vm.InterpretResult.OK:
+        return False
+    rt.stack[0] = value.Value.number(41.0)
+    rt.stack[1] = value.Value.number(42.0)
+    snapshot = rt
+    saved_stack = rt.stack
+    before = rt.allocations
+    source = b"for (var i = 0; i < 8; i = i + 1) { print a == b; print text == \"sa\" + \"me\"; var fresh = Box(); }"
+    status = stack_vm.interpret(mut rt, mut captured, source)
+    expected = b"true\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\n"
+    return status == stack_vm.InterpretResult.OK and bytes(captured.stdout) == expected and bytes(captured.stderr) == b"" and rt.stack_top == 0 and saved_stack[0] == value.Value.number(41.0) and saved_stack[1] == value.Value.number(42.0) and snapshot.stack[0] == value.Value.number(41.0) and snapshot.stack[1] == value.Value.number(42.0) and snapshot.allocations == before and rt.allocations > before and rt.collections == rt.allocations
