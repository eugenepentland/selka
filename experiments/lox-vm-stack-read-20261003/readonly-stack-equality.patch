+# OP_EQUAL keeps IEEE equality, tag distinctions, interning and object identity
+# while calls on both operands evaluate in order and may collect before compare.
+public def test_run_readonly_stack_equality_tags_and_order(out: Stream) -> bool:
+    source = b"print nil == nil; print nil == false; print false == false; print true == false; print true == 1; print 0 == -0; var nan = 0 / 0; print nan == nan; print nan != nan; print \"a\" + \"b\" == \"ab\"; class Box {} var a = Box(); var b = Box(); print a == a; print a == b; fun operand(x) { print x; return \"ke\" + \"pt\"; } print operand(1) == operand(2);"
+    expected = b"true\nfalse\ntrue\nfalse\nfalse\ntrue\nfalse\ntrue\ntrue\ntrue\nfalse\n1\n2\ntrue\n"
+    vm_run = driver.run_source(source, driver.Engine.VM, True, out, None)
+    tree = driver.run_source(source, driver.Engine.TREE, True, out, None)
+    return vm_run.status == 0 and tree.status == 0 and vm_run.stdout == expected and tree.stdout == expected and vm_run.stderr == b"" and tree.stderr == b"" and vm_run.collections == vm_run.allocations and tree.collections == tree.allocations
+
