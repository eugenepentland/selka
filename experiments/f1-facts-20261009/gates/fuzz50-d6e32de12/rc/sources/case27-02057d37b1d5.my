def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(2))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("a")
    rl3: list[list[int]] = []
    rl3.append(make_ints(3))
    if len(sl2) > 1:
        if len(rl3) > 1:
            if len(rl3) > 0:
                inner4 = rl3[0]
                inner4.append(5)
                acc = acc + len(inner4) + len(rl3[0])
            ia5 = il1
            il1.append(2)
            rl3.append(make_ints(3))
            sa6 = sl2
        sg7 = grow_str(sl2, 1)
        ig8 = grow_int(il1, seed)
        sa9 = sl2
        if len(rl3) > 0:
            acc = acc + len(sg7)
            acc = acc + len(sa9)
            acc = acc + len(sa9)
            acc = acc + len(il1)
            acc = acc + len(sl2)
        return acc + len(sl2)
    il1.append(seed)
    for i2 in range(2):
        for i1 in range(0):
            acc = acc + len(rl3)
            if len(rl3) > 0:
                inner10 = rl3[0]
                inner10.append(5)
                acc = acc + len(inner10) + len(rl3[0])
            rl3.append(make_ints(seed))
            acc = acc + len(sl2)
            acc = acc + len(il1)
        for i1 in range(0):
            acc = acc + len(sl2)
            sa11 = sl2
            sl2.append("bc")
            ig12 = grow_int(il1, 1)
        sl2.append("bc")
        ra13 = rl3
    for i2 in range(2):
        sa14 = sl2
        acc = acc + len(sa14)
        ia15 = il1
    ig16 = grow_int(il1, seed)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(ig16)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
