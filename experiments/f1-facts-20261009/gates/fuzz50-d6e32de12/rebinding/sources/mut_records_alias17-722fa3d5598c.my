def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def fold(values: list[int]) -> int:
    total = 0
    for value in values:
        total = (total * 31 + value) % 1000003
    return total


record Bucket:
    count: int
    items: list[int]


def bucket_total(b: Bucket) -> int:
    t = b.count
    for x in b.items:
        t = (t * 7 + x) % 1000003
    return t


def grow(b: Bucket, v: int) -> Bucket:
    items = b.items
    items.append(v)
    return Bucket(b.count + 1, items)


def bump(xs: mut list[int], k: int):
    xs.append(k)
    xs[0] = (xs[0] + k) % 1009


def fill(xs: mut list[int], k: int):
    for j in range(k % 4):
        xs.append(j * 3 + k)


def swap_ends(xs: mut list[int]):
    last = len(xs) - 1
    first = xs[0]
    xs[0] = xs[last]
    xs[last] = first


def twice(xs: mut list[int], k: int):
    bump(mut xs, k)
    bump(mut xs, k + 1)


def assign_only(xs: mut list[int], source: list[int]):
    xs = source


def replace_path(xs: mut list[int], source: list[int], choose: bool, k: int):
    xs.append(k % 1009)
    if choose:
        xs = source
    xs.append((k + 1) % 1009)


def replace_loop(xs: mut list[int], k: int):
    for phase in range(k % 4):
        xs.append(phase)
        xs = [(k + phase) % 1009]
        xs.append(phase)


def replace_forward(xs: mut list[int], source: list[int], choose: bool, k: int):
    replace_path(mut xs, source, choose, k)


def touch(b: mut Bucket, v: int):
    b.items[0] = v
    b.count = b.count + 1
    b.items.append(v)


def touch_items(b: mut Bucket, v: int):
    bump(mut b.items, v)
    b.count = b.count + 2


def rebuild(b: mut Bucket, v: int):
    b = Bucket(v % 5, [v, v + 1])


def both(xs: list[int], ys: list[int]) -> int:
    return len(xs) * 100 + len(ys) + xs[0] + ys[0]


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 1 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    acc = 0
    xs = [(j * 11 + seed) % 1009 for j in range(n)]
    ys = [(j * 24 + 1) % 997 for j in range(n)]
    wave_a_saved = xs
    wave_a_source = ys
    assign_only(mut xs, wave_a_source)
    xs.append((seed + 17) % 1009)
    acc = (acc + fold(wave_a_saved) * 3 + fold(wave_a_source) * 5 + fold(xs) * 7) % 1000003
    b = Bucket(n, xs)
    c = Bucket(1, [seed])
    acc = (acc + both(xs, ys)) % 1000003
    b.items = c.items
    replace_forward(mut c.items, ys, ((((seed * seed) // 1)) % 1009) % 2 == 0, ((29 + (seed % 17))) % 1009)
    acc = (acc + len(xs) * 3 + ys[0]) % 1000003
    b.items = c.items
    xs[((((seed + 17) % (0 - 8))) % 1009) % len(xs)] = ((0 - 7)) % 1009
    c = b
    replace_forward(mut b.items, xs, ((((seed + acc) % 2)) % 1009) % 2 == 0, (((acc * acc) + (acc // 2))) % 1009)
    c.items.append((seed) % 1009)
    replace_forward(mut b.items, xs, ((((seed // 2) // n)) % 1009) % 2 == 0, (acc) % 1009)
    out.print(acc, fold(xs), fold(ys), b.count, fold(b.items), c.count, fold(c.items))
    return acc % 7

