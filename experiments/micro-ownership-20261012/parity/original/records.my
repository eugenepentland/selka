# records: construct a 3-field value record per iteration and pass it by value.
record Vec:
    x: int
    y: int
    z: int


func norm1(v: Vec) -> int:
    return v.x + v.y + v.z


func main(out: Stream) -> int:
    mut total = 0
    for i in range(20000000):
        mut v = Vec(x=i, y=i + 1, z=i + 2)
        total = (total + norm1(v)) % 1000003
    out.print(total)
    return 0
