module app;
import std_json_view as j;
import std_json_builder as out;
import std_bytes as b;
import std_result as r;
export run;
fn failure() -> r::Error {
    return new r::Error { category: new r::Category.malformed, code: 1 };
}
fn object(doc: &[]i64, node: j::Node, count: i64) -> r::Result<bool,r::Error> {
    if try j::kind(doc,node) != new j::Kind.object || try j::count(doc,node) != count {
        return new r::Result<bool,r::Error>.err(failure());
    }
    return new r::Result<bool,r::Error>.ok(true);
}
fn array(doc: &[]i64, node: j::Node, limit: i64) -> r::Result<i64,r::Error> {
    if try j::kind(doc,node) != new j::Kind.array { return new r::Result<i64,r::Error>.err(failure()); }
    return j::count_between(doc,node,0,limit);
}
fn run(heap: allocator, doc: &[]i64, request: j::Node) -> b::Built {
    discard try object(doc,request,3);
    let limit = try j::integer_between(doc,try j::required(doc,request,"limit"),0,1000000);
    let initial = try j::integer_between(doc,try j::required(doc,request,"used"),0,limit);
    let requests = try j::required(doc,request,"requests");
    let count = try array(doc,requests,128);
    let mut i = 0;
    while i < count {
        discard try j::integer_between(doc,try j::at(doc,requests,i),0,1000000);
        i += 1;
    }
    let mut used = initial;
    let mut accepted = try out::array(heap,1024);
    i = 0;
    while i < count {
        let amount = try j::integer(doc,try j::at(doc,requests,i));
        let allow = used + amount < limit;
        if allow { used += amount; }
        accepted = try out::array_bool(accepted,allow);
        i += 1;
    }
    let mut result = try out::array_field(heap,try out::object(heap,2048),"accepted",accepted);
    result = try out::integer_field(heap,result,"used",used);
    return out::finish(try out::integer_field(heap,result,"remaining",limit-used));
}
