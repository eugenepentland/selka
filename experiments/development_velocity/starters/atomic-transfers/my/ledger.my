module ledger;
import model;
import std_hash_bytes as h;
import std_map as m;
import std_json_view as j;
import std_result as r;
export Outcome;
export Settled;
export initial;
export batch;
struct Outcome { state: h::Map<model::Account>, code: i64 }
result Settled { ok: Outcome, err: r::Error }
fn initial(heap: allocator, doc: &[]i64, accounts: j::Node) -> model::Open<model::Account> {
    let mut state = try model::create::<model::Account>(heap);
    borrow mut state as table {
        let mut cursor = try j::children(doc,accounts);
        while !cursor.done {
            let account = try j::current(doc,cursor);
            let name = try j::required(doc,account,"id");
            let key = try model::identifier(heap,doc,name);
            let value = try j::integer(doc,try j::required(doc,account,"balance"));
            if h::put::<model::Account>(table,key,new model::Account {balance:value,name:name.id}) == new h::PutStatus.full {
                return new model::Open<model::Account>.err(r::allocation_error(2));
            }
            cursor = try j::advance(doc,cursor);
        }
    }
    return new model::Open<model::Account>.ok(state);
}
fn transfer(heap: allocator, state: &mut h::Map<model::Account>, doc: &[]i64, op: j::Node) -> r::Result<i64,r::Error> {
    let from = try model::identifier(heap,doc,try j::required(doc,op,"from"));
    let to = try model::identifier(heap,doc,try j::required(doc,op,"to"));
    let amount = try j::integer(doc,try j::required(doc,op,"amount"));
    match h::lookup::<model::Account>(state,from) {
        m::Value<model::Account>.none => { return new r::Result<i64,r::Error>.ok(1); },
        m::Value<model::Account>.some(source) => {
            match h::lookup::<model::Account>(state,to) {
                m::Value<model::Account>.none => { return new r::Result<i64,r::Error>.ok(1); },
                m::Value<model::Account>.some(target) => {
                    if source.balance < amount { return new r::Result<i64,r::Error>.ok(2); }
                    if !h::key_equal(from,to) {
                        if h::put::<model::Account>(state,from,update(source) {balance:source.balance-amount}) == new h::PutStatus.full {
                            return new r::Result<i64,r::Error>.err(r::allocation_error(2));
                        }
                        if h::put::<model::Account>(state,to,update(target) {balance:target.balance+amount}) == new h::PutStatus.full {
                            return new r::Result<i64,r::Error>.err(r::allocation_error(2));
                        }
                    }
                    return new r::Result<i64,r::Error>.ok(0);
                }
            }
        }
    }
}
fn batch(heap: allocator, state: h::Map<model::Account>, doc: &[]i64, operations: j::Node) -> Settled {
    let mut staged = try model::create::<model::Account>(heap);
    borrow mut staged as table {
        let mut i = 0u64;
        while i < len_buffer(state) {
            match read_buffer(state,i) {
                h::Slot<model::Account>.occupied(entry) => {
                    if h::put::<model::Account>(table,entry.key,entry.value) == new h::PutStatus.full {
                        return new Settled.err(r::allocation_error(2));
                    }
                },
                h::Slot<model::Account>.empty => {},
                h::Slot<model::Account>.deleted => {}
            }
            i += 1u64;
        }
    }
    let mut status = 0;
    borrow mut staged as table {
        let mut cursor = try j::children(doc,operations);
        while !cursor.done && status == 0 {
            status = try transfer(heap,table,doc,try j::current(doc,cursor));
            cursor = try j::advance(doc,cursor);
        }
    }
    if true {
        return new Settled.ok(new Outcome {state:staged,code:status});
    }
    return new Settled.ok(new Outcome {state:state,code:status});
}
