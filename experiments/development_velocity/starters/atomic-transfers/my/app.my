module app;
import model;
import ledger;
import std_hash_bytes as h;
import std_json_view as j;
import std_json;
import std_json_builder as out;
import std_bytes as b;
import std_collections as c;
import std_result as r;
export run;
result Rows { ok: c::Vector<model::Account>, err: r::Error }
fn rows(heap: allocator) -> Rows {
    match c::filled::<model::Account>(heap,32u64,new model::Account {balance:0,name:0}) {
        c::Created<model::Account>.ok(value) => { return new Rows.ok(value); },
        c::Created<model::Account>.err(code) => { return new Rows.err(r::allocation_error(code)); }
    }
}
fn before(doc: &[]i64, a: model::Account, z: model::Account) -> bool effects() { return std_json::compare(doc,a.name,z.name) < 0; }
fn run(heap: allocator, doc: &[]i64, request: j::Node) -> b::Built {
    discard try model::validate(heap,doc,request);
    let mut state = try ledger::initial(heap,doc,try j::required(doc,request,"accounts"));
    let batches = try j::required(doc,request,"batches");
    let mut cursor = try j::children(doc,batches);
    let mut results = try out::array(heap,2048);
    while !cursor.done {
        let settled = try ledger::batch(heap,state,doc,try j::current(doc,cursor));
        let code = read_field(settled,code);
        state = take_field(settled,state);
        if code == 0 { results = try out::array_string(heap,results,"committed"); }
        if code == 1 { results = try out::array_string(heap,results,"unknown-account"); }
        if code == 2 { results = try out::array_string(heap,results,"insufficient"); }
        cursor = try j::advance(doc,cursor);
    }
    let mut ordered = try rows(heap);
    let mut count = 0u64;
    borrow mut ordered[..] as values {
        let mut i = 0u64;
        while i < len_buffer(state) {
            match read_buffer(state,i) {
                h::Slot<model::Account>.occupied(entry) => { write_slice(values,count,entry.value); count += 1u64; },
                h::Slot<model::Account>.empty => {},
                h::Slot<model::Account>.deleted => {}
            }
            i += 1u64;
        }
        borrow mut values[0..count] as active { discard c::sort_by::<model::Account,i64>(active,doc,before); }
    }
    let mut balances = try out::array(heap,8192);
    let mut i = 0u64;
    while i < count {
        let account = read_buffer(ordered,i);
        let name = try j::text(heap,doc,new j::Node {id:account.name},32u64);
        let mut row = try out::object(heap,128);
        borrow name[..] as bytes { row = try out::string_field(heap,row,"id",bytes); }
        row = try out::integer_field(heap,row,"balance",account.balance);
        balances = try out::array_object(balances,row);
        i += 1u64;
    }
    let result = try out::array_field(heap,try out::object(heap,16384),"results",results);
    return out::finish(try out::array_field(heap,result,"balances",balances));
}
