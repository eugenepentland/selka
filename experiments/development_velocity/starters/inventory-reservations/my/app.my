module app;
import model;
import ledger;
import std_hash_bytes as h;
import std_json_view as j;
import std_json;
import std_json_builder as out;
import std_bytes as b;
import std_collections as c;
import std_result as r;
export run;
result Rows { ok: c::Vector<model::Stock>, err: r::Error }
fn rows(heap: allocator) -> Rows {
    match c::filled::<model::Stock>(heap,32u64,new model::Stock {quantity:0,name:0}) {
        c::Created<model::Stock>.ok(value) => { return new Rows.ok(value); },
        c::Created<model::Stock>.err(code) => { return new Rows.err(r::allocation_error(code)); }
    }
}
fn before(doc: &[]i64, a: model::Stock, z: model::Stock) -> bool effects() { return std_json::compare(doc,a.name,z.name) < 0; }
fn run(heap: allocator, doc: &[]i64, request: j::Node) -> b::Built {
    discard try model::validate(heap,doc,request);
    let mut state = try ledger::initial(heap,doc,try j::required(doc,request,"stock"));
    let mut reservations = try model::create::<model::Reservation>(heap);
    let operations = try j::required(doc,request,"operations");
    let mut cursor = try j::children(doc,operations);
    let mut results = try out::array(heap,4096);
    borrow mut state as available, mut reservations as active {
        while !cursor.done {
            discard try ledger::apply(available,active,doc,try j::current(doc,cursor));
            results = try out::array_string(heap,results,"unsupported-operation");
            cursor = try j::advance(doc,cursor);
        }
    }
    let mut ordered = try rows(heap);
    let mut count = 0u64;
    borrow mut ordered[..] as values {
        let mut i = 0u64;
        while i < len_buffer(state) {
            match read_buffer(state,i) {
                h::Slot<model::Stock>.occupied(entry) => { write_slice(values,count,entry.value); count += 1u64; },
                h::Slot<model::Stock>.empty => {},
                h::Slot<model::Stock>.deleted => {}
            }
            i += 1u64;
        }
        borrow mut values[0..count] as active { discard c::sort_by::<model::Stock,i64>(active,doc,before); }
    }
    let mut balances = try out::array(heap,8192);
    let mut i = 0u64;
    while i < count {
        let account = read_buffer(ordered,i);
        let name = try j::text(heap,doc,new j::Node {id:account.name},32u64);
        let mut row = try out::object(heap,128);
        borrow name[..] as bytes { row = try out::string_field(heap,row,"id",bytes); }
        row = try out::integer_field(heap,row,"quantity",account.quantity);
        balances = try out::array_object(balances,row);
        i += 1u64;
    }
    let result = try out::array_field(heap,try out::object(heap,16384),"results",results);
    let report = try out::array_field(heap,result,"available",balances);
    return out::finish(try out::array_field(heap,report,"active",try out::array(heap,2)));
}
