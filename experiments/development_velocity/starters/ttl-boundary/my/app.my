module app;
import std_json_view as j;
import std_json_builder as out;
import std_bytes as b;
import std_result as r;
import std_ascii as ascii;
import std_hash_bytes as h;
import std_map as m;
import std_collections as c;
import std_json;
export run;
struct Entry { value: i64, expires_at: i64, name: i64 }
result Store { ok: h::Map<Entry>, err: r::Error }
result Names { ok: c::Vector<i64>, err: r::Error }
fn failure() -> r::Error {
    return new r::Error { category: new r::Category.malformed, code: 1 };
}
fn object(doc: &[]i64, node: j::Node, count: i64) -> r::Result<bool,r::Error> {
    if try j::kind(doc,node) != new j::Kind.object || try j::count(doc,node) != count {
        return new r::Result<bool,r::Error>.err(failure());
    }
    return new r::Result<bool,r::Error>.ok(true);
}
fn array(doc: &[]i64, node: j::Node, limit: i64) -> r::Result<i64,r::Error> {
    if try j::kind(doc,node) != new j::Kind.array { return new r::Result<i64,r::Error>.err(failure()); }
    return j::count_between(doc,node,0,limit);
}

fn identifier(heap: allocator, doc: &[]i64, node: j::Node) -> r::Result<h::Key,r::Error> {
    let text = try j::text(heap,doc,node,32u64);
    let head = new ascii::Class {lower:true,upper:false,digit:false,underscore:false,hyphen:false};
    let tail = new ascii::Class {lower:true,upper:false,digit:true,underscore:true,hyphen:true};
    borrow text[..] as bytes {
        if !ascii::matches::<u8>(bytes,head,tail,1u64,32u64) { return new r::Result<h::Key,r::Error>.err(failure()); }
        match h::from_bytes(bytes) {
            h::KeyResult.ok(key) => { return new r::Result<h::Key,r::Error>.ok(key); },
            h::KeyResult.err(code) => { return new r::Result<h::Key,r::Error>.err(r::allocation_error(code)); }
        }
    }
}
fn store(heap: allocator) -> Store {
    match h::create::<Entry>(heap,256u64) {
        h::Created<Entry>.ok(value) => { return new Store.ok(value); },
        h::Created<Entry>.err(code) => { return new Store.err(r::allocation_error(code)); }
    }
}
fn names(heap: allocator) -> Names {
    match c::filled::<i64>(heap,128u64,0) {
        c::Created<i64>.ok(value) => { return new Names.ok(value); },
        c::Created<i64>.err(code) => { return new Names.err(r::allocation_error(code)); }
    }
}
fn before(doc: &[]i64, a: i64, z: i64) -> bool effects() { return std_json::compare(doc,a,z) < 0; }
fn sweep(state: &mut h::Map<Entry>, now: i64) -> i64 {
    let mut i = 0u64;
    while i < len_buffer(state) {
        match read_buffer(state,i) {
            h::Slot<Entry>.occupied(entry) => {
                if entry.value.expires_at < now { discard h::remove::<Entry>(state,entry.key); }
            },
            h::Slot<Entry>.empty => {},
            h::Slot<Entry>.deleted => {}
        }
        i += 1u64;
    }
    return 0;
}
fn run(heap: allocator, doc: &[]i64, request: j::Node) -> b::Built {
    discard try object(doc,request,1);
    let ops = try j::required(doc,request,"operations");
    let count = try array(doc,ops,128);
    let mut last = 0;
    let mut i = 0;
    while i < count {
        let op = try j::at(doc,ops,i);
        let kind = try j::required(doc,op,"op");
        let put = try j::textis(doc,kind,"put");
        if put { discard try object(doc,op,5); }
        else {
            if !(try j::textis(doc,kind,"get")) { return new b::Built.err(failure()); }
            discard try object(doc,op,3);
        }
        let at = try j::integer_between(doc,try j::required(doc,op,"at"),last,1000000);
        last = at;
        discard try identifier(heap,doc,try j::required(doc,op,"key"));
        if put {
            discard try j::integer_between(doc,try j::required(doc,op,"value"),-1000000,1000000);
            discard try j::integer_between(doc,try j::required(doc,op,"ttl"),0,1000000);
        }
        i += 1;
    }
    let mut state = try store(heap);
    let mut results = try out::array(heap,2048);
    borrow mut state as table {
        i = 0;
        while i < count {
            let op = try j::at(doc,ops,i);
            let at = try j::integer(doc,try j::required(doc,op,"at"));
            discard sweep(table,at);
            let key_node = try j::required(doc,op,"key");
            let key = try identifier(heap,doc,key_node);
            if try j::textis(doc,try j::required(doc,op,"op"),"put") {
                let value = try j::integer(doc,try j::required(doc,op,"value"));
                let ttl = try j::integer(doc,try j::required(doc,op,"ttl"));
                if h::put::<Entry>(table,key,new Entry {value:value,expires_at:at+ttl,name:key_node.id}) == new h::PutStatus.full {
                    return new b::Built.err(r::allocation_error(2));
                }
                results = try out::array_null(results);
                discard sweep(table,at);
            } else {
                match h::lookup::<Entry>(table,key) {
                    m::Value<Entry>.none => { results = try out::array_null(results); },
                    m::Value<Entry>.some(entry) => { results = try out::array_integer(heap,results,entry.value); }
                }
            }
            i += 1;
        }
    }
    let mut ids = try names(heap);
    let mut live_count = 0u64;
    borrow mut ids[..] as list {
        let mut n = 0u64;
        while n < len_buffer(state) {
            match read_buffer(state,n) {
                h::Slot<Entry>.occupied(entry) => { write_slice(list,live_count,entry.value.name); live_count += 1u64; },
                h::Slot<Entry>.empty => {},
                h::Slot<Entry>.deleted => {}
            }
            n += 1u64;
        }
        borrow mut list[0..live_count] as active { discard c::sort_by::<i64,i64>(active,doc,before); }
    }
    let mut live = try out::array(heap,8192);
    let mut n = 0u64;
    while n < live_count {
        let name = try j::text(heap,doc,new j::Node {id:read_buffer(ids,n)},32u64);
        borrow name[..] as bytes { live = try out::array_string(heap,live,bytes); }
        n += 1u64;
    }
    let result = try out::array_field(heap,try out::object(heap,16384),"results",results);
    return out::finish(try out::array_field(heap,result,"live",live));
}
