module app;
import std_json_view as j;
import std_json_builder as out;
import std_bytes as b;
import std_result as r;
import std_encoding as encoding;
export run;
fn failure() -> r::Error {
    return new r::Error { category: new r::Category.malformed, code: 1 };
}
fn object(doc: &[]i64, node: j::Node, count: i64) -> r::Result<bool,r::Error> {
    if try j::kind(doc,node) != new j::Kind.object || try j::count(doc,node) != count {
        return new r::Result<bool,r::Error>.err(failure());
    }
    return new r::Result<bool,r::Error>.ok(true);
}
fn array(doc: &[]i64, node: j::Node, limit: i64) -> r::Result<i64,r::Error> {
    if try j::kind(doc,node) != new j::Kind.array { return new r::Result<i64,r::Error>.err(failure()); }
    return j::count_between(doc,node,0,limit);
}
fn run(heap: allocator, doc: &[]i64, request: j::Node) -> b::Built {
    discard try object(doc,request,2);
    let hex = try j::required(doc,request,"hex");
    let text = try j::text(heap,doc,hex,1024u64);
    let size = len_buffer(text);
    if size % 2u64 != 0u64 { return new b::Built.err(failure()); }
    let mut p = 0u64;
    while p < size {
        let digit = read_buffer(text,p);
        if !(digit >= 48u8 && digit <= 57u8) && !(digit >= 97u8 && digit <= 102u8) {
            return new b::Built.err(failure());
        }
        p += 1u64;
    }
    let offsets = try j::required(doc,request,"offsets");
    let count = try array(doc,offsets,128);
    let mut i = 0;
    let mut outside = false;
    while i < count {
        let offset = try j::integer_between(doc,try j::at(doc,offsets,i),0,512);
        if u64(offset) + 2u64 > size / 2u64 { outside = true; }
        i += 1;
    }
    if outside {
        return out::finish(try out::string_field(heap,try out::object(heap,64),"error","out-of-bounds"));
    }
    let mut values = try out::array(heap,1024);
    borrow text[..] as hex_bytes {
        let decoded = try encoding::hex_decode(heap,hex_bytes,512);
        borrow decoded[..] as bytes {
            i = 0;
            while i < count {
                let offset = u64(try j::integer(doc,try j::at(doc,offsets,i)));
                let value = try encoding::read_uint(bytes,offset,2u64,false);
                values = try out::array_integer(heap,values,i64(value));
                i += 1;
            }
        }
    }
    return out::finish(try out::array_field(heap,try out::object(heap,2048),"values",values));
}
