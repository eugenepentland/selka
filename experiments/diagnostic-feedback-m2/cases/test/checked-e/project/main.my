module main


def to_int(raw: str) -> Result[int, str]:
    match int(raw):
        case Some(value):
            return Ok(value)
        case None:
            return Err("not a number")


def main(args: list[str], out: Stream) -> int:
    value = to_int(args[0])
    out.print(-3 + value)
    return 0
