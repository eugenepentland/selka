module main


def decode(raw: str) -> Result[int, str]:
    match int(raw):
        case Some(value):
            return Ok(value)
        case None:
            return Err("not a number")


def main(args: list[str], out: Stream) -> int:
    match decode(args[0] if args[0].lstrip("-").isdigit() else "0"):
        case Ok(value):
            out.print(10 + value)
        case Err(_):
            out.print(11)
    return 0
