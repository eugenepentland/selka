module main


def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0


def biggest(values: list[int]) -> int:
    return values[0]


def biggest_of(values: list[int]) -> int:
    return biggest(values)
def main(args: list[str], out: Stream) -> int:
    first = number(args[0])
    second = number(args[1])
    third = number(args[2])
    out.print(biggest_of([first, second, third]))
    return 0
