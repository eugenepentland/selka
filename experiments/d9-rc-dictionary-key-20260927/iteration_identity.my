module iteration_identity


# spec-case: COW-ITERATION-IDENTITY-1
public def test_nonstructural_dictionary_writes_remain_visible() -> bool:
    values = {1: 10, 2: 20}
    total = 0
    for key in values:
        values[key] = values[key] + 1
        total += values[key]
    return total == 32 and values == {1: 11, 2: 21}


# spec-case: COW-ITERATION-IDENTITY-1
public def test_list_iteration_observes_later_element_writes() -> bool:
    values = [1, 2]
    total = 0
    for value in values:
        total += value
        values[1] = 9
    return total == 10 and values == [1, 9]


# spec-case: COW-ITERATION-IDENTITY-1
public def test_rebinding_source_preserves_original_iteration_storage() -> bool:
    values = [1, 2]
    total = 0
    for value in values:
        values = [7]
        total += value
    mapping = {1: 10, 2: 20}
    for key in mapping:
        mapping = {7: 70}
        total += key
    return total == 6 and values == [7] and mapping == {7: 70}


# spec-case: COW-ITERATION-IDENTITY-1
public def test_named_snapshot_remains_independent_of_iteration_writes() -> bool:
    values = [1, 2]
    snapshot = values
    total = 0
    for value in values:
        values[1] = 9
        total += value
    return total == 3 and values == [1, 9] and snapshot == [1, 2]


# spec-case: COW-ITERATION-IDENTITY-1
public def test_fresh_managed_sources_survive_without_an_owner_local() -> bool:
    total = 0
    for value in [2, 3]:
        total += value
    for key in {4: 5, 6: 7}:
        total += key
    for value in {8, 9}:
        total += value
    for byte in b"AZ":
        total += byte
    for letter in "xy":
        total += len(letter)
    return total == 189


# spec-case: COW-ITERATION-IDENTITY-1
public def test_arena_iteration_and_nested_sources_keep_balanced_holds() -> bool:
    total = 0
    with arena():
        rows = [[1, 2], [3, 4]]
        for row in rows:
            for value in row:
                total += value
        mapping = {1: "a", 2: "bc"}
        for value in mapping.values():
            total += len(value)
    return total == 13


# spec-case: COW-ITERATION-IDENTITY-1
public def test_fixed_array_iteration_keeps_its_value_copy() -> bool:
    values: [2]int = [1, 2]
    total = 0
    for value in values:
        total += value
        values[1] = 9
    return total == 3 and values[1] == 9


def main() -> int:
    assert test_nonstructural_dictionary_writes_remain_visible()
    assert test_list_iteration_observes_later_element_writes()
    assert test_rebinding_source_preserves_original_iteration_storage()
    assert test_named_snapshot_remains_independent_of_iteration_writes()
    assert test_fresh_managed_sources_survive_without_an_owner_local()
    assert test_arena_iteration_and_nested_sources_keep_balanced_holds()
    assert test_fixed_array_iteration_keeps_its_value_copy()
    return 0
