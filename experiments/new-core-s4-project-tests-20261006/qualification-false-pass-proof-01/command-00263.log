226: def explain(results, verbose):
227:     """Unsupported tests grouped by the construct that blocks them, then the blocking features of each file."""
228:     by_reason = collections.Counter()
229:     files = collections.defaultdict(set)
230:     for r in results:
231:         for reason, n in r["reasons"].items():
232:             by_reason[reason] += n
233:             files[reason].add(r["file"])
234:     lines = ["", "blocking features of the unsupported tests (tests / files):"]
235:     for reason, n in by_reason.most_common():
236:         lines.append("  %4d / %2d  %s" % (n, len(files[reason]), reason))
237:     lines += ["", "blocking features per file (file: tests unsupported of tests; the features, most common first):"]
238:     for r in results:
239:         if not r["reasons"]:
240:             continue
241:         total = sum(r["reasons"].values())
242:         lines.append("  %-30s %3d of %3d: %s" % (r["file"], total, r["tests"], ", ".join("%s x%d" % kv for kv in r["reasons"].most_common())))
243:         if verbose:
244:             for name, reason in sorted(r["unsupported"].items()):
245:                 lines.append("      %s: %s" % (name, reason))
246:     return "\n".join(lines)
