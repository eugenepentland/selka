@@ -73,6 +73,46 @@ fn emitHand(arena: std.mem.Allocator, module: *const ir.Module) emit_llvm.Error!
     return emit_llvm.emitModule(arena, module, .{ .locator = .{ .context = &context, .locate = noLocation }, .source_path = "hand.my", .main = .{} });
