+module propagation_case_8
+
+
+union AppError:
+    Detail: str,
+    Missing: i64
+
+
+result Inner:
+    ok: i64,
+    err: str
+
+
+result Outer:
+    ok: bool,
+    err: AppError
+
+
+def inner(flag: bool) -> Inner:
+    if flag:
+        return Err("bad")
+    return Ok(5)
+
+
+def outer(flag: bool) -> Outer:
+    return Ok(inner(flag)? > 3)
+
+
+def handle(value: Outer) -> i64:
+    match value:
+        case Outer.ok(flag):
+            if flag:
+                return 1
+            return 0
+        case Outer.err(error):
+            match error:
+                case AppError.Detail(text):
+                    if text == "bad":
+                        return 7
+                    return 8
+                case AppError.Missing(code):
+                    return 100 + code
+
+
+public def program() -> i64:
+    return handle(outer(False)) + handle(outer(True))
