func sum_values(values: int[]) -> int:
    mut total = 0
    for value in values:
        total += value
    return total


func make_values(n: int) -> int[]:
    mut values: int[] = []
    for i in range(8):
        values.append(n + i)
    return values


func probe(n: int) -> int:
    const values = make_values(n)
    return sum_values(values)

func main(args: str[], out: Stream) -> int:
    const n = len(args)
    out.print(probe(n))
    return 0

