func sum_from(values: int[], index: int) -> int:
    if index == len(values):
        return 0
    return values[index] + sum_from(values, index + 1)


func probe(n: int) -> int:
    const values = [n, n + 1, n + 2, n + 3]
    return sum_from(values, 0)


func main(args: str[], out: Stream) -> int:
    const n = len(args)
    out.print(probe(n))
    return 0
