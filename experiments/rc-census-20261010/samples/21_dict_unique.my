func probe(n: int) -> int:
    mut values: dict[int, int] = {}
    for i in range(n):
        values[i] = i + 1
    for i in range(n):
        values[i] = values[i] + n
    mut total = 0
    for i in range(n):
        total += values[i]
    return total


func main(args: str[], out: Stream) -> int:
    const n = len(args)
    out.print(probe(n))
    return 0
