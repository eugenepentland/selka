func probe(n: int) -> int:
    mut buffer = byte_buffer([])
    for i in range(3 * n):
        _ = buffer.append_byte((17 * i + n) % 256)
    const snapshot = bytes(buffer)
    _ = buffer.append_byte(255)
    mut total = 10000 * len(snapshot)
    for octet in snapshot:
        total += octet
    for i in range(len(buffer)):
        total += buffer[i]
    return total


func main(args: str[], out: Stream) -> int:
    const n = len(args)
    out.print(probe(n))
    return 0
