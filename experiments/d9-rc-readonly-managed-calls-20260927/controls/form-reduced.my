record Span:
    file: int
    source: bytes
    start: int
    end: int


def empty() -> Span:
    return Span(
        file=0,
        source=b"",
        start=0,
        end=0
    )


def matches(a: Span, b: bytes) -> bool:
    if a.end - a.start != len(b):
        return False
    i = 0
    while i < a.end - a.start:
        if a.source[a.start + i] != b[i]:
            return False
        i += 1
    return True


enum Kind:
    list,
    atom,
    string


record Node:
    kind: Kind
    span: Span
    next: int


def at(nodes: list[Node], index: int) -> Node:
    if index < 0 or index >= len(nodes):
        return Node(
            kind=Kind.atom,
            span=empty(),
            next=len(nodes)
        )
    return nodes[index]


def form(nodes: list[Node], index: int, name: bytes) -> bool:
    item = at(nodes, index)
    if item.kind != Kind.list or item.next == index + 1:
        return False
    return matches(at(nodes, index + 1).span, name)



def main() -> int:
    return 0
