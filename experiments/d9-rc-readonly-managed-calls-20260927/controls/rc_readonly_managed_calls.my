record Item:
    text: bytes
    number: int

record Big:
    text: bytes
    padding: [600]int
    number: int

def pick(items: list[Item], index: int) -> Item:
    return items[index]

def choose(index: int, first: list[Item], second: list[Item]) -> Item:
    if index == 0:
        return first[0]
    return first[index]

def scalar(items: list[Item], other: list[Item], times: int) -> int:
    saved = pick(items, 0)
    i = 0
    total = 0
    while i < times:
        current = choose(i % 2, other, items)
        total += current.number + saved.number + int(saved.text[0])
        i += 1
    return total

def big_pick(items: list[Big], index: int) -> Big:
    return items[index]

def big_scalar(items: list[Big], times: int) -> int:
    saved = big_pick(items, 0)
    total = 0
    i = 0
    while i < times:
        current = big_pick(items, i % 2)
        total += saved.number + current.number + saved.padding[599] + int(saved.text[0])
        i += 1
    return total

# spec-case: RC-READONLY-MANAGED-CALLS-1
public def test_saved_small_results_survive_calls_and_loop_reuse() -> bool:
    items = [Item(b"a", 3), Item(b"b", 7)]
    other = [Item(b"c", 11), Item(b"d", 13)]
    saved = items
    return scalar(items, other, 4) == 448 and saved[0].number == 3

# spec-case: RC-READONLY-MANAGED-CALLS-1
public def test_borrowed_results_stay_inside_caller_arena() -> bool:
    with arena():
        items = [Item(b"a", 3), Item(b"b", 7)]
        other = [Item(b"c", 11), Item(b"d", 13)]
        return scalar(items, other, 4) == 448

