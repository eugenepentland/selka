record Acc:
    total: int
    count: int

func f0(k: int) -> int:
    mut items: int[] = []
    for j in range(k % 17 + 3):
        items.append(j * 1 + k)
    mut acc = Acc(total=0, count=0)
    for v in items:
        if v % 3 == 0:
            acc = Acc(total=acc.total + v, count=acc.count + 1)
        else:
            acc = Acc(total=acc.total - 1, count=acc.count)
    return acc.total + acc.count + k % 1000

func f1(k: int) -> int:
    mut items: int[] = []
    for j in range(k % 17 + 3):
        items.append(j * 2 + k)
    mut acc = Acc(total=0, count=0)
    for v in items:
        if v % 3 == 0:
            acc = Acc(total=acc.total + v, count=acc.count + 1)
        else:
            acc = Acc(total=acc.total - 1, count=acc.count)
    return acc.total + acc.count + f0(k - 1) % 1000

