m being considered for inlining and cloning.  */\n#ifdef __clang__\n# define __attribute_optimization_barrier__ __attribute__ ((optnone))\n#else\n# define __attribute_optimization_barrier__ __attribute__ ((noinline, noclone))\n#endif\n\n#endif\n", 2137, 0) = 2137
