3594294 pread64(3</home/epentland/zig-toolchains/0.17.0-dev.1683+5ceec001b/lib/libc/include/x86-linux-any/asm/bitsperlong.h>, "/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */\n#ifndef __ASM_X86_BITSPERLONG_H\n#define __ASM_X86_BITSPERLONG_H\n\n#if defined(__x86_64__) && !defined(__ILP32__)\n# define __BITS_PER_LONG 64\n#else\n# define __BITS_PER_LONG 32\n#endif\n\n#include <asm-generic/bitsperlong.h>\n\n#endif /* __ASM_X86_BITSPERLONG_H */", 319, 0) = 319
