module app
import workload


extern def runtime_bench_now(host: Host) -> i64 effects(host)

def main(args: list[str], host: Host, out: Stream) -> int:
    if len(args) != 3:
        return 2
    size = workload.parse_number(args[0])
    iterations = workload.parse_number(args[1])
    seed = workload.parse_number(args[2])
    if size < 2 or iterations < 1 or seed < 1 or seed > 1000000:
        return 2
    program = [workload.Instruction(op=0, arg=0), workload.Instruction(op=4, arg=0), workload.Instruction(op=2, arg=0), workload.Instruction(op=4, arg=1), workload.Instruction(op=3, arg=1), workload.Instruction(op=1, arg=0), workload.Instruction(op=8, arg=0), workload.Instruction(op=10, arg=29), workload.Instruction(op=3, arg=1), workload.Instruction(op=2, arg=2), workload.Instruction(op=7, arg=0), workload.Instruction(op=2, arg=0), workload.Instruction(op=9, arg=0), workload.Instruction(op=10, arg=18), workload.Instruction(op=3, arg=0), workload.Instruction(op=12, arg=31), workload.Instruction(op=4, arg=0), workload.Instruction(op=11, arg=24), workload.Instruction(op=3, arg=0), workload.Instruction(op=3, arg=1), workload.Instruction(op=5, arg=0), workload.Instruction(op=2, arg=1000003), workload.Instruction(op=7, arg=0), workload.Instruction(op=4, arg=0), workload.Instruction(op=3, arg=1), workload.Instruction(op=2, arg=1), workload.Instruction(op=5, arg=0), workload.Instruction(op=4, arg=1), workload.Instruction(op=11, arg=4), workload.Instruction(op=3, arg=0), workload.Instruction(op=14, arg=0), workload.Instruction(op=2, arg=3), workload.Instruction(op=6, arg=0), workload.Instruction(op=2, arg=7), workload.Instruction(op=5, arg=0), workload.Instruction(op=2, arg=1000003), workload.Instruction(op=7, arg=0), workload.Instruction(op=13, arg=0)]
    checksum = 0
    start = runtime_bench_now(host)
    for batch in range(iterations):
        part = workload.batch_result(size, batch, seed, program)
        if part < 0:
            return 2
        checksum = (checksum + part) % 1000000007
    elapsed = runtime_bench_now(host) - start
    out.print(checksum, elapsed)
    return 0
