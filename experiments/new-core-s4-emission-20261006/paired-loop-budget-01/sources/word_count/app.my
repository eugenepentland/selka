module app
import workload


extern def runtime_bench_now(host: Host) -> i64 effects(host)

def main(args: list[str], host: Host, out: Stream) -> int:
    if len(args) != 3:
        return 2
    kind = "word_count"
    size = workload.number(args[0])
    iterations = workload.number(args[1])
    seed = workload.number(args[2])
    if size < 2 or iterations < 1 or seed < 1 or seed > 1000000:
        return 2
    data = workload.inputs(kind, size, seed)
    checksum = 0
    start = runtime_bench_now(host)
    checksum = workload.kernel(kind, data, iterations, seed)
    elapsed = runtime_bench_now(host) - start
    out.print(checksum, elapsed)
    return 0
