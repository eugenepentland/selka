module workload


public record Inputs:
    raw: bytes
    texts: list[str]
    other: list[str]
    numbers: list[int]
    fragments: list[str]


public def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0


public def row_name(j: int) -> str:
    return ("café,\"item\"" if j % 2 == 0 else "naïve,item") + str(j)


public def score(text: str) -> int:
    raw = text.encode()
    result = len(raw)
    for value in raw:
        result += value
    return result


public def csv_rows(text: str) -> list[list[str]]:
    rows: list[list[str]] = []
    fields: list[str] = []
    field = ""
    quoted = False
    pending_quote = False
    for ch in text:
        if quoted:
            if ch == "\"":
                if pending_quote:
                    field += "\""
                    pending_quote = False
                else:
                    pending_quote = True
            elif pending_quote:
                quoted = False
                pending_quote = False
                if ch == ",":
                    fields.append(field)
                    field = ""
                elif ch == "\n":
                    fields.append(field)
                    rows.append(fields)
                    fields = []
                    field = ""
            else:
                field += ch
        elif ch == "\"":
            quoted = True
        elif ch == ",":
            fields.append(field)
            field = ""
        elif ch == "\n":
            fields.append(field)
            rows.append(fields)
            fields = []
            field = ""
        else:
            field += ch
    return rows


public def csv_job(text: str) -> int:
    groups: dict[str, int] = {"east": 0, "west": 0, "north": 0}
    accepted = 0
    rejected = 0
    names = 0
    for row in csv_rows(text):
        match int(row[3]):
            case Some(amount):
                if row[4] == "1":
                    groups[row[2]] += amount
                    accepted += 1
                    names += score(row[1])
            case None:
                rejected += 1
    return groups["east"] + groups["west"] * 2 + groups["north"] * 3 + accepted * 17 + rejected * 101 + names


public def inputs(kind: str, size: int, seed: int) -> Inputs:
    raw = b""
    texts: list[str] = []
    other: list[str] = []
    numbers: list[int] = []
    fragments: list[str] = []
    regions = ["east", "west", "north"]
    csv_chunks: list[str] = []
    for j in range(size):
        amount = "oops" if j % 11 == 0 else str((seed + j * 19) % 100003)
        quoted = "\"" + row_name(j).replace("\"", "\"\"") + "\""
        csv_chunks.append(str(seed + j) + "," + quoted + "," + regions[(seed + j) % 3] + "," + amount + "," + ("1" if (seed + j) % 3 != 0 else "0") + "\n")
    texts = ["".join(csv_chunks)]
    return Inputs(raw=raw, texts=texts, other=other, numbers=numbers, fragments=fragments)


public def kernel(kind: str, data: Inputs, iterations: int, seed: int) -> int:
    checksum = 0
    for step in range(iterations):
        cursor = seed + step
        value = csv_job(data.texts[0])
        checksum = (checksum + value) % 1000000007
    return checksum

