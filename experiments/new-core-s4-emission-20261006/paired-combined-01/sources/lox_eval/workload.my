module workload


public union Value:
    integer: int,
    boolean: bool


public record Instruction:
    op: int
    arg: int


public def integer(value: Value) -> int:
    match value:
        case Value.integer(n):
            return n
        case Value.boolean(_):
            return 0


public def boolean(value: Value) -> bool:
    match value:
        case Value.boolean(b):
            return b
        case Value.integer(_):
            return False


public def execute(program: list[Instruction], size: int, seed: int) -> int:
    stack: list[Value] = []
    returns: list[int] = []
    variables = [0, 0]
    pc = 0
    while True:
        ins = program[pc]
        pc += 1
        if ins.op == 0:
            stack.append(Value.integer(seed))
        elif ins.op == 1:
            stack.append(Value.integer(size))
        elif ins.op == 2:
            stack.append(Value.integer(ins.arg))
        elif ins.op == 3:
            stack.append(Value.integer(variables[ins.arg]))
        elif ins.op == 4:
            variables[ins.arg] = integer(stack.pop())
        elif ins.op >= 5 and ins.op <= 9:
            b = integer(stack.pop())
            a = integer(stack.pop())
            if ins.op == 5:
                stack.append(Value.integer(a + b))
            elif ins.op == 6:
                stack.append(Value.integer(a * b))
            elif ins.op == 7:
                stack.append(Value.integer(a % b))
            elif ins.op == 8:
                stack.append(Value.boolean(a < b))
            else:
                stack.append(Value.boolean(a == b))
        elif ins.op == 10:
            if not boolean(stack.pop()):
                pc = ins.arg
        elif ins.op == 11:
            pc = ins.arg
        elif ins.op == 12:
            returns.append(pc)
            pc = ins.arg
        elif ins.op == 13:
            pc = returns.pop()
        else:
            return integer(stack.pop())
    return 0


public def parse_number(text: str) -> int:
    match int(text):
        case Some(n):
            return n
        case None:
            return 0


public def batch_result(size: int, batch: int, seed: int, program: list[Instruction]) -> int:
    return execute(program, size, seed + batch)

