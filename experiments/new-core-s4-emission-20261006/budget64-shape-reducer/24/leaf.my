module leaf
public def compute(x: int) -> int:
    total = 0
    for i in range(2):
        if x == 0:
            total += 1
        if x == 1:
            total += 2
        if x == 2:
            total += 3
        if x == 3:
            total += 4
        if x == 4:
            total += 5
        if x == 5:
            total += 6
        if x == 6:
            total += 7
        if x == 7:
            total += 8
        if x == 8:
            total += 9
        if x == 9:
            total += 10
        if x == 10:
            total += 11
        if x == 11:
            total += 12
        if x == 12:
            total += 13
        if x == 13:
            total += 14
        if x == 14:
            total += 15
        if x == 15:
            total += 16
        if x == 16:
            total += 17
        if x == 17:
            total += 18
        if x == 18:
            total += 19
        if x == 19:
            total += 20
        if x == 20:
            total += 21
        if x == 21:
            total += 22
        if x == 22:
            total += 23
        if x == 23:
            total += 24
    return total
