Final source:

```python
module main


def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0


def largest[T: integer](values: list[T]) -> T:
    best = values[0]
    index = 1
    while index < len(values):
        if values[index] > best:
            best = values[index]
        index = index + 1
    return best


def largest_of[T: integer](values: list[T]) -> T:
    return largest(values)
def main(args: list[str], out: Stream) -> int:
    ...
```

