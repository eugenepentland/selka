```python
module main


def to_int(raw: str) -> Result[int, str]:
    match int(raw):
        case Some(value):
            return Ok(value)
        case None:
            return Err("not a number")


def main(args: list[str], out: Stream) -> int:
    if len(args) == 0:
        out.print(-1)
        return 0
    match to_int(args[0]):
        case Ok(value):
            out.print(-3 + value)
        case Err(problem):
            out.print(-1)
    return 0
```

