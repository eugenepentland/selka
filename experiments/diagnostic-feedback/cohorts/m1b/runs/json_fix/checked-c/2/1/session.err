Simplest correct program:

```
module main


def decode(raw: str) -> Result[int, str]:
    match int(raw):
        case Some(value):
            return Ok(value)
        case None:
            return Err("not a number")


def main(args: list[str], out: Stream) -> int:
    match decode(args[0]):
        case Ok(value):
            out.print(value + value + 10)
        case Err(problem):
            out.print(0)
    return 0
```

