module main


def decode(raw: str) -> Result[int, str]:
    match int(raw):
        case Some(value):
            return Ok(value)
        case None:
            return Err("not a number")


def main(args: list[str], out: Stream) -> int:
    match decode(args[0]):
        case Ok(number):
            out.print(number + number + 10)
        case Err(_):
            out.print(0)
    return 0
