Let me write the fix:

```python
module main


def read_number(raw: str) -> Result[int, str]:
    match int(raw):
        case Some(value):
            return Ok(value)
        case None:
            return Err("not a number")


def main(args: list[str], out: Stream) -> int:
    value = read_number(args[0])
    match value:
        case Ok(number):
            out.print(0 + number)
        case Err(message):
            out.print(-99)
    return 0
```

