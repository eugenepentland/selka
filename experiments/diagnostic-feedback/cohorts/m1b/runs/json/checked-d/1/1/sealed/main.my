module main


def as_count(raw: str) -> Result[int, str]:
    match int(raw):
        case Some(value):
            return Ok(value)
        case None:
            return Err("not a number")


def main(args: list[str], out: Stream) -> int:
    if len(args) == 0:
        out.print(7)
    else:
        match as_count(args[0]):
            case Ok(value):
                out.print(7 + value)
            case Err(_):
                out.print(7)
    return 0
