    got = p.stdout
    status = 'PASS' if got == c['stdout'] and p.returncode == 0 else 'FAIL'
    if status == 'FAIL': ok = False
    print(status, c['args'], repr(got), 'expected', repr(c['stdout']), 'exit', p.returncode)
print('ALL PASS' if ok else 'FAILURES')
PY
```

