```python
module main


def parse_count(raw: str) -> Result[int, str]:
    match int(raw):
        case Some(value):
            return Ok(value)
        case None:
            return Err("not a number")


def main(args: list[str], out: Stream) -> int:
    match parse_count(args[0]):
        case Ok(value):
            out.print(1 + value)
        case Err(_):
            out.print(-1)
    return 0
```

