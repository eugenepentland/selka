module main


def decode(raw: str) -> Result[int, str]:
    match int(raw):
        case Some(value):
            return Ok(value)
        case None:
            return Err("not a number")


def main(args: list[str], out: Stream) -> int:
    base = decode(args[0])
    match base:
        case Ok(found):
            out.print(found + found + 10)
        case Err(_):
            out.print(0)
    return 0
