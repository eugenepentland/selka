module main


def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0


def top(values: list[int]) -> int:
    return values[0]


def top_of(values: list[int]) -> int:
    return top(values)
def main(args: list[str], out: Stream) -> int:
    first = number(args[0])
    second = number(args[1])
    third = number(args[2])
    out.print(top_of([first, second, third]))
    return 0
