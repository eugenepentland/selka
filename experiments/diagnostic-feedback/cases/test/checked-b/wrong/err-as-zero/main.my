module main


def read_number(raw: str) -> Result[int, str]:
    match int(raw):
        case Some(value):
            return Ok(value)
        case None:
            return Err("not a number")


def main(args: list[str], out: Stream) -> int:
    match read_number(args[0] if args[0].lstrip("-").isdigit() else "0"):
        case Ok(value):
            out.print(0 + value)
        case Err(_):
            out.print(1)
    return 0
