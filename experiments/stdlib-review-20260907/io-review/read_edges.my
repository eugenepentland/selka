module read_edges;import std_io as io;import std_fs as fs;
fn start(file:io::File)->i64{
 let mut bytes=new [4]u8[9u8,9u8,9u8,9u8];let mut state=io::reader(file);
 borrow mut bytes[0..0] as zero{match io::read_exact(state,zero){io::Reading.err(discard)=>{return -1;},io::Reading.ok(value)=>{let progress=read_field(value,progress);if progress.length!=0u64 || progress.eof{return -2;}state=take_field(value,reader);}}}
 borrow mut bytes[0..4] as destination{match io::read_exact(state,destination){io::Reading.ok(discard)=>{return -3;},io::Reading.err(failure)=>{if read_field(failure,progress)!=3u64 || read_field(failure,cause).kind!=new io::Kind.unexpected_eof{return -4;}state=take_field(failure,reader);}}}
 if bytes[0]!=97u8 || bytes[1]!=98u8 || bytes[2]!=99u8 || bytes[3]!=9u8{return -5;}
 borrow mut bytes[0..0] as zero{match io::read_exact(state,zero){io::Reading.err(discard)=>{return -6;},io::Reading.ok(value)=>{let progress=read_field(value,progress);if progress.length!=0u64 || !progress.eof{return -7;}state=take_field(value,reader);}}}
 borrow mut bytes[3..4] as destination{match io::read_exact(state,destination){io::Reading.ok(discard)=>{return -8;},io::Reading.err(failure)=>{if read_field(failure,progress)!=0u64 || read_field(failure,cause).kind!=new io::Kind.unexpected_eof{return -9;}}}}
 if bytes[3]!=9u8{return -10;}return 42;
}
fn main(heap:allocator,cap:filesystem_cap)->i64{match fs::open(heap,cap,"data",new fs::Mode.read){fs::Open.err(discard)=>{return -11;},fs::Open.ok(file)=>{return start(file);}}}
