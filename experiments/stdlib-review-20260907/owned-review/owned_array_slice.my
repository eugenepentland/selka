buffer B:u8;result Open{ok:B,err:i64}buffer Vec<T:storable>:T;result Created<T:storable>{ok:Vec<T>,err:i64}result Taken<T:storable>{ok:T,err:i64}result Status{ok:bool,err:i64}fn work(heap:allocator)->Status{let child=try acquire_buffer<Open>(heap,1);let items=new [1]B[child];borrow items[0..1] as view{discard read_slice(view,0);}return new Status.ok(true);}fn main()->i64{return 0;}