buffer B:u8;result Open{ok:B,err:i64}buffer Vec<T:storable>:T;result Created<T:storable>{ok:Vec<T>,err:i64}result Taken<T:storable>{ok:T,err:i64}result Status{ok:bool,err:i64}fn put<T:storable>(outer:&mut Vec<T>,value:T)->Status{return append_buffer<Status>(outer,value);}fn work(heap:allocator)->Status{let mut outer=try acquire_buffer<Created<B>>(heap,1);borrow mut outer as dest{arena heap as inner{let child=try acquire_buffer<Open>(inner,1);return put::<B>(dest,child);}}}fn main()->i64{return 0;}