buffer B:u8;result Open{ok:B,err:i64}buffer Vec<T:storable>:T;result Created<T:storable>{ok:Vec<T>,err:i64}result Taken<T:storable>{ok:T,err:i64}result Status{ok:bool,err:i64}fn work(heap:allocator)->Status{let mut outer=try acquire_buffer<Created<B>>(heap,2);let child=try acquire_buffer<Open>(heap,1);discard try append_buffer<Status>(outer,child);return append_buffer<Status>(outer,child);}fn main()->i64{return 0;}