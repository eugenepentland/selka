func scan(text: str) -> int:
    mut hits = 0
    for i in range(len(text) - 3):
        if text[i:i + 2] == "//":
            hits += 1
        if text[i:i + 4].startswith("ab"):
            hits += 2
        hits += len(text[i:i + 3])
    return hits


func main(out: Stream) -> int:
    mut parts: str[] = []
    for i in range(200000):
        parts.append("ab// x" + str(i % 10))
    mut text = "".join(parts)
    mut total = 0
    for _ in range(3):
        total += scan(text)
    out.print(total)
    return 0
