import json

func score(value: json.Json) -> int:
    match value:
        case json.Json.array(value=items):
            mut total = 0
            for item in items:
                match item:
                    case json.Json.text(value=text):
                        total += len(text)
                    case _:
                        assert False
            return total
        case _:
            assert False
            return 0

func run(document: json.Json) -> int:
    mut total = 0
    for i in range(32):
        match json.at(document, 0):
            case Some(selected):
                total += score(selected)
            case None:
                assert False
    return total

