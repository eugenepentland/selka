+
+# Keep both the record and projected entries alive while writes replace,
+# delete, reuse a tombstone, and grow a chain that wraps through slot zero.
+public def test_table_entries_read_preserves_snapshot() -> bool:
+    t = table.new_table()
+    empty = table.get_entries(t.entries, t.count, 100, 7u32).is_none()
+    _ = table.set(mut t, 100, 7u32, value.Value.number(1.0))
+    _ = table.set(mut t, 200, 7u32, value.Value.nil)
+    _ = table.set(mut t, 300, 7u32, value.Value.boolean(False))
+    _ = table.set(mut t, 400, 7u32, value.Value.number(4.0))
+    _ = table.delete(mut t, 100, 7u32)
+    snapshot = t
+    entries = t.entries
+    count = t.count
+    _ = table.set(mut t, 400, 7u32, value.Value.number(9.0))
+    _ = table.delete(mut t, 200, 7u32)
+    _ = table.set(mut t, 500, 7u32, value.Value.boolean(True))
+    _ = table.set(mut t, 600, 7u32, value.Value.number(6.0))
+    _ = table.set(mut t, 700, 7u32, value.Value.number(7.0))
+    _ = table.set(mut t, 800, 7u32, value.Value.number(8.0))
+    _ = table.set(mut t, 900, 7u32, value.Value.number(9.0))
+    record_unchanged = table.get(snapshot, 200, 7u32) == Some(value.Value.nil) and table.get(snapshot, 400, 7u32) == Some(value.Value.number(4.0))
+    entries_unchanged = table.get_entries(entries, count, 200, 7u32) == Some(value.Value.nil) and table.get_entries(entries, count, 400, 7u32) == Some(value.Value.number(4.0))
+    missing_unchanged = table.get_entries(entries, count, 100, 7u32).is_none() and table.get_entries(entries, count, 500, 7u32).is_none() and table.get_entries(entries, count, value.NO_OBJ, 7u32).is_none()
+    live_changed = table.get_entries(t.entries, t.count, 200, 7u32).is_none() and table.get_entries(t.entries, t.count, 400, 7u32) == Some(value.Value.number(9.0)) and table.get_entries(t.entries, t.count, 500, 7u32) == Some(value.Value.boolean(True))
+    return empty and record_unchanged and entries_unchanged and missing_unchanged and live_changed and table.capacity(snapshot) == 8 and table.capacity(t) == 16
