# String hashing and interning (SPEC §6.2 and §6.3). The spec calls this
# module `strings`; that name belongs to mylang's standard library, which a
# project module cannot shadow.
import heap
import object
import table
import value

# 32-bit FNV-1a over the bytes.
public func fnv1a(chars: bytes) -> u32:
    mut hash = 2166136261u32
    for byte in chars:
        hash = wrapping_mul(bit_xor(hash, u32(byte)), 16777619u32)
    return hash


# The interned string with exactly these bytes, or NO_OBJ. Probes like
# `find_entry`, comparing length, hash and then bytes of each live key.
public func find_string(rt: heap.Runtime, chars: bytes, hash: u32) -> value.ObjRef:
    if rt.strings.count == 0:
        return value.NO_OBJ
    mut mask = len(rt.strings.entries) - 1
    mut index = int(bit_and(hash, u32(mask)))
    while True:
        mut entry = rt.strings.entries[index]
        if entry.key == value.NO_OBJ:
            match entry.value:
                case value.Value.nil:
                    return value.NO_OBJ
                case _:
                    pass
        elif entry.hash == hash:
            if heap.string_matches(rt, entry.key, chars):
                return entry.key
        index = bit_and(index + 1, mask)


func intern(mut rt: heap.Runtime, chars: bytes, hash: u32) -> value.ObjRef:
    mut ref = heap.allocate(mut rt, object.Obj.string(value=object.StringObj(chars=chars.copy(), hash=hash)))
    _ = table.set(mut rt.strings, ref, hash, value.Value.nil)
    return ref


# The interned string for these bytes, allocating a String that owns a copy
# only when none exists yet.
public func copy_string(mut rt: heap.Runtime, chars: bytes) -> value.ObjRef:
    mut hash = fnv1a(chars)
    mut existing = find_string(rt, chars, hash)
    if existing != value.NO_OBJ:
        return existing
    return intern(mut rt, chars.copy(), hash)


# The interned string for `a ++ b`. The joined buffer becomes the new
# String's bytes, or is dropped when that string already exists. Both
# operands must still be rooted by the caller.
public func concat(mut rt: heap.Runtime, a: value.ObjRef, b: value.ObjRef) -> value.ObjRef:
    mut chars = concat_chars(rt, a, b)
    mut hash = fnv1a(chars)
    mut existing = find_string(rt, chars, hash)
    if existing != value.NO_OBJ:
        return existing
    return intern(mut rt, chars, hash)


# Both immutable string payloads remain borrowed until the joined owner exists.
func concat_chars(rt: heap.Runtime, a: value.ObjRef, b: value.ObjRef) -> bytes:
    match rt.objects[a]:
        case object.Obj.string(value=left):
            match rt.objects[b]:
                case object.Obj.string(value=right):
                    return left.chars + right.chars
                case _:
                    assert False, "object is not a string"
                    return b""
        case _:
            assert False, "object is not a string"
            return b""
