func data_12() -> bytes:
    mut parts: bytes[] = [b";; M2 clearance hole with a plated, ground-bonded pad on both outer layers.\n;; A board feature, not a purchased part \xe2\x80\x94 the screw, washer and standoff are\n;; assembly hardware and belong on a mechanical BOM. Use a bare NPTH footprint\n", b";; instead when the hole must NOT carry copper to the chassis.\n(component \"mounting-hole-m2\"\n  (description \"M2 plated mounting hole, 2.2 mm drill, 3.8 mm pad on both outer layers, bonded to GND\")\n  (pinout mounting-hole-m2)\n  (footprint mounting-hole-m2)\n", b"  (refdes \"H\")\n  (ignore-requirements))\n"]
    return b"".join(parts)


