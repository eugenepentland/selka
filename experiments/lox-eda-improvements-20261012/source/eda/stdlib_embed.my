

# Hand-maintained byte data table corresponding to zig/stdlib/embed.zig.
# D5: literals contain at most 256 bytes and preserve each source file exactly.
public record Entry:
    path: str
    bytes: bytes


func data_0() -> bytes:
    mut parts: bytes[] = [b"(component-family \"cap-0201\"\n  (description \"0201 (0603 metric) MLCC capacitor, generic\")\n  (symbol generic-cap)\n  (footprint c-0201)\n  (parameter \"value\" capacitance))\n"]
    return b"".join(parts)


