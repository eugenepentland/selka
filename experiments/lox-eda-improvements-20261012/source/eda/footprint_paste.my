
import byte_builder
import sexpr_ast as ast
import math
import support_float_fmt as ff

public record Aperture:
    x: float
    y: float
    w: float
    h: float


public const err_invalid_paste: str = "InvalidPaste"


public func parse(pad: ast.Node) -> Result[Aperture[]?, str]:
    match pad.tag:
        case ast.Tag.list(value=items):
            for item in items:
                if not ast.is_form(item, b"paste"):
                    continue
                match item.tag:
                    case ast.Tag.list(value=forms):
                        if len(forms) > 257:
                            return Err(err_invalid_paste)
                        mut windows: Aperture[] = []
                        for child_index_0 in range(len(forms)):
                            if child_index_0 < 1:
                                continue
                            if not ast.is_form(forms[child_index_0], b"rect"):
                                return Err(err_invalid_paste)
                            match forms[child_index_0].tag:
                                case ast.Tag.list(value=v):
                                    if len(v) != 5:
                                        return Err(err_invalid_paste)
                                    mut x = ast.as_number(v[1])
                                    mut y = ast.as_number(v[2])
                                    mut w_ = ast.as_number(v[3])
                                    mut h = ast.as_number(v[4])
                                    if x is None or y is None or w_ is None or h is None:
                                        return Err(err_invalid_paste)
                                    mut rect = Aperture(x=x, y=y, w=w_, h=h)
                                    for n in [rect.x, rect.y, rect.w, rect.h]:
                                        if not math.is_finite(n) or abs(n) > 1000.0:
                                            return Err(err_invalid_paste)
                                    if rect.w <= 0.0 or rect.h <= 0.0:
                                        return Err(err_invalid_paste)
                                    windows.append(rect)
                                case _:
                                    return Err(err_invalid_paste)
                        return Ok(Some(windows))
                    case _:
                        return Err(err_invalid_paste)
            return Ok(None)
        case _:
            return Ok(None)


public func write(mut w: byte_builder.Builder, windows: Aperture[]):
    byte_builder.append(mut w, b" (paste")
    for v in windows:
        byte_builder.append_text(mut w, " (rect " + ff.fmt_float_prec(v.x, 6) + " " + ff.fmt_float_prec(v.y, 6) + " " + ff.fmt_float_prec(v.w, 6) + " " + ff.fmt_float_prec(v.h, 6) + ")")
    _ = byte_builder.append_byte(mut w, 41)


public func valid(windows: Aperture[], width: float, height: float) -> bool:
    if len(windows) > 256:
        return False
    mut i = 0
    for v in windows:
        for n in [v.x, v.y, v.w, v.h]:
            if not math.is_finite(n) or abs(n) > 1000.0:
                return False
        if v.w <= 0.0 or v.h <= 0.0:
            return False
        if abs(v.x) + v.w / 2.0 > width / 2.0 + 1e-8 or abs(v.y) + v.h / 2.0 > height / 2.0 + 1e-8:
            return False
        for q in windows[0:i]:
            if abs(v.x - q.x) < (v.w + q.w) / 2.0 - 1e-8 and abs(v.y - q.y) < (v.h + q.h) / 2.0 - 1e-8:
                return False
        i += 1
    return True
