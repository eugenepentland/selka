record Holder:
    items: list[str]
def crash(items: mut list[str], index: int):
    items.append("new")
    assert items[index] == "start"
def change(holder: mut Holder, index: int):
    work = holder.items
    crash(mut work, index)
    holder.items = work
def main(out: Stream) -> int:
    text = "start" + str(0)
    with arena():
        holder = Holder([text])
        saved = holder
        out.print(saved.items[0])
        change(mut holder, 100)
        out.print(saved.items[0])
    return 0
