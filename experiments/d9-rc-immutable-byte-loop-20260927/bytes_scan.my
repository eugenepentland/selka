# bytes_scan: index an 8 MiB immutable bytes value and count one octet value, sixteen times.


def main(out: Stream) -> int:
    empty: list[int] = []
    buffer = byte_buffer(empty)
    piece = b"mylang micro benchmark kernel payload 0123456789 abcdefghijklmno"
    for i in range(131072):
        _ = buffer.append_range(piece, 0, 64)
    data = bytes(buffer)
    size = len(data)
    count = 0
    for pass_index in range(16):
        count += pass_index
        for i in range(size):
            if data[i] == 109:
                count += 1
    out.print(count)
    return 0
