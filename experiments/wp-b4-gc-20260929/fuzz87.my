record P:
    xs: list[int]
    k: int

record Q:
    a: int
    b: int

union U:
    empty,
    one: list[int],
    two: P

record R:
    items: list[int]
    rows: list[list[int]]
    name: str
    n: int
    inner: P

def make(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i * 3 + 1)
    return out

def total(xs: list[int]) -> int:
    t = 0
    for x in xs:
        t = t + x
    return t

def total2(xss: list[list[int]]) -> int:
    t = 0
    for xs in xss:
        t = t * 3 + total(xs) + len(xs)
    return t

def rsum(r: R) -> int:
    return total(r.items) * 7 + total2(r.rows) * 5 + len(r.name) * 3 + r.n + total(r.inner.xs) * 11 + r.inner.k

def psum(ps: list[P]) -> int:
    t = 0
    for p in ps:
        t = t * 3 + total(p.xs) + p.k
    return t

def qsum(qs: list[Q]) -> int:
    t = 0
    for q in qs:
        t = t * 3 + q.a * 2 + q.b
    return t

def usum(u: U) -> int:
    match u:
        case U.one(xs):
            return total(xs) + 1
        case U.two(p):
            return total(p.xs) * 2 + p.k
        case _:
            return 5

def keycount(text: str, k: int) -> int:
    counts: dict[str, int] = {}
    i = 0
    while i + k <= len(text):
        key = text[i:i + k]
        counts[key] = counts.get(key, 0) + 1
        i = i + 1
    t = 0
    for seen, v in counts.items():
        t = t * 7 + v + len(seen)
    return t

def dsum(d: dict[str, list[int]]) -> int:
    t = 0
    for k, v in d.items():
        t = t * 5 + len(k) + total(v)
    return t

def push_list(xs: mut list[int], v: int):
    xs.append(v)

def bump_rows(rows: mut list[list[int]], v: int) -> int:
    if len(rows) > 0:
        rows[0].append(v)
    rows.append([v])
    return len(rows)

def touch(r: mut R, v: int) -> int:
    r.n = r.n + v
    return 0

def grow(r: mut R, v: int) -> int:
    r.items.append(v)
    return 1

def swap_items(r: mut R, v: int) -> int:
    r.items = [v, v]
    return 0

def deep(r: mut R, v: int) -> int:
    push_list(mut r.inner.xs, v)
    if len(r.rows) > 0:
        r.rows[0].append(v)
    return 0

def replace_rows(r: mut R, v: int) -> int:
    _ = bump_rows(mut r.rows, v)
    return 0


def f0(p0: mut list[list[int]], p1: list[P]) -> int:
    acc = 0
    p0.append([1])
    acc = acc + 1
    c0 = 0
    while c0 < 1:
        c0 = c0 + 1
        v1 = "xyz"
        v2 = U.two(P([3, 4], 2))
        if acc % 2 == 0:
            break
    _ = bump_rows(mut p0, len(p0))
    if len(p0) > 2:
        if len(p0) > 0:
            p0[0].append(9)
    if len(p0) > 0:
        p0[0] = (p0[0] if len(p0) > 0 else [5])
    if len(p0) > 0:
        p0[0].append(4)
    if len(p0) > 1:
        p0.append([8, 0])
        acc = acc + 1
    else:
        if len(p0) > 0:
            p0[0] = make(1)
    for x3 in p0:
        acc = acc + total(x3)
        c4 = 0
        while c4 < 2:
            c4 = c4 + 1
            v5 = "ab" + "cd"
            v6 = v5
            if acc % 2 == 0:
                break
        if len(x3) > 0:
            v7 = p0
            if len(v7) > 0:
                v7[0].append(1)
            acc = acc + 1
    acc = acc + 1
    return acc * 7 + total2(p0) + psum(p1)

def f1(p0: list[int], p1: R, p2: mut dict[str, list[int]]) -> int:
    acc = 0
    p2["w"] = [1]
    p2["a"] = p1.items
    v0 = p0
    if len(v0) > 0:
        v0[0] = p1.n
    acc = acc * 3 + rsum(p1)
    c1 = 0
    while c1 < 2:
        c1 = c1 + 1
        v2 = U.two(P([3, 4], 2))
        if acc % 2 == 0:
            break
    for x3 in v0:
        acc = acc + x3
        c4 = 0
        while c4 < 3:
            c4 = c4 + 1
            v5 = U.two(P([3, 4], 2))
            v6 = p1.rows
            v7 = p1.name
    p2["a"] = p2.get("a", [8])
    acc = acc * 3 + rsum(p1)
    if len(v0) > 1:
        _ = v0.pop()
    with arena():
        tmp8 = p1.items
        acc = acc + total(tmp8)
        acc = acc + total(v0)
    return acc * 7 + total(p0) + rsum(p1) + dsum(p2) + total(v0)

def f2(p0: str, p1: U, p2: str) -> int:
    acc = 0
    v0 = p2
    with arena():
        tmp1 = [5, 1]
        acc = acc + total(tmp1)
        acc = acc + usum(p1)
    with arena():
        tmp2 = [3, 8]
        acc = acc + total(tmp2)
        acc = acc + keycount(p2, 2)
    v3 = [4, 4]
    if 4 > 3:
        v4 = [P([6], 1), P(make(3), 2)]
        v5 = v0
        v6 = {"a": [1], "b": [2, 2]}
    else:
        v7 = p1
    with arena():
        tmp8 = v3
        acc = acc + total(tmp8)
        acc = acc + keycount(p0, 2)
    return acc * 7 + keycount(p0, 2) + usum(p1) + keycount(p2, 2) + keycount(v0, 2) + total(v3)

def f3(p0: mut R, p1: str) -> int:
    acc = 0
    p0.n = p0.n + 1
    v0 = p0
    v1 = U.one(make(3))
    v0.n = v0.n + len(p1)
    v2 = [Q(8, 1), Q(2, 8)]
    return acc * 7 + rsum(p0) + keycount(p1, 2) + rsum(v0) + usum(v1) + qsum(v2)

def main(out: Stream) -> int:
    m0 = make(3)
    m1 = [[1, 2], [3]]
    m2 = R(make(2), [[1], [2, 3]], "nm", 1, P([4], 1))
    m3 = {"a": [1], "b": [2, 2]}
    m4 = "hello" + "lo"
    m5 = [P([1, 2], 3), P([4], 5)]
    m6 = [Q(1, 2), Q(3, 4), Q(5, 6)]
    m7 = U.one([1, 2])
    m8 = make(3)
    m9 = [[1, 2], [3]]
    m10 = R(make(2), [[1], [2, 3]], "nm", 1, P([4], 1))
    m11 = {"a": [1], "b": [2, 2]}
    m12 = "hello" + "lo"
    m13 = [P([1, 2], 3), P([4], 5)]
    m14 = [Q(1, 2), Q(3, 4), Q(5, 6)]
    m15 = U.one([1, 2])
    acc = 0
    v16 = m10
    out.print(acc, total(m0), total2(m1), rsum(m2), dsum(m3), keycount(m4, 2), psum(m5), qsum(m6), usum(m7), total(m8), total2(m9), rsum(m10), dsum(m11), keycount(m12, 2), psum(m13), qsum(m14), usum(m15), rsum(v16))
    v17 = m7
    out.print(acc, total(m0), total2(m1), rsum(m2), dsum(m3), keycount(m4, 2), psum(m5), qsum(m6), usum(m7), total(m8), total2(m9), rsum(m10), dsum(m11), keycount(m12, 2), psum(m13), qsum(m14), usum(m15), rsum(v16), usum(v17))
    m3["k" + str(len(m0))] = [len(m0)]
    out.print(acc, total(m0), total2(m1), rsum(m2), dsum(m3), keycount(m4, 2), psum(m5), qsum(m6), usum(m7), total(m8), total2(m9), rsum(m10), dsum(m11), keycount(m12, 2), psum(m13), qsum(m14), usum(m15), rsum(v16), usum(v17))
    acc = acc + f0(mut m1, [P([5], 1), P(make(1), 2)])
    out.print(acc, total(m0), total2(m1), rsum(m2), dsum(m3), keycount(m4, 2), psum(m5), qsum(m6), usum(m7), total(m8), total2(m9), rsum(m10), dsum(m11), keycount(m12, 2), psum(m13), qsum(m14), usum(m15), rsum(v16), usum(v17))
    acc = acc + f0(mut m1, m5)
    out.print(acc, total(m0), total2(m1), rsum(m2), dsum(m3), keycount(m4, 2), psum(m5), qsum(m6), usum(m7), total(m8), total2(m9), rsum(m10), dsum(m11), keycount(m12, 2), psum(m13), qsum(m14), usum(m15), rsum(v16), usum(v17))
    v18 = m0
    out.print(acc, total(m0), total2(m1), rsum(m2), dsum(m3), keycount(m4, 2), psum(m5), qsum(m6), usum(m7), total(m8), total2(m9), rsum(m10), dsum(m11), keycount(m12, 2), psum(m13), qsum(m14), usum(m15), rsum(v16), usum(v17), total(v18))
    m14 = m14
    out.print(acc, total(m0), total2(m1), rsum(m2), dsum(m3), keycount(m4, 2), psum(m5), qsum(m6), usum(m7), total(m8), total2(m9), rsum(m10), dsum(m11), keycount(m12, 2), psum(m13), qsum(m14), usum(m15), rsum(v16), usum(v17), total(v18))
    v19 = m14
    out.print(acc, total(m0), total2(m1), rsum(m2), dsum(m3), keycount(m4, 2), psum(m5), qsum(m6), usum(m7), total(m8), total2(m9), rsum(m10), dsum(m11), keycount(m12, 2), psum(m13), qsum(m14), usum(m15), rsum(v16), usum(v17), total(v18), qsum(v19))
    return 0

