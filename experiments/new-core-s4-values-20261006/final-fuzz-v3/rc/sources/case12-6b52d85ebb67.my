def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(n))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("xyz")
    rl3: list[list[int]] = []
    rl3.append(make_ints(3))
    acc = acc + len(il1)
    ia4 = il1
    il1.append(0)
    for i2 in range(1):
        for i1 in range(0):
            acc = acc + len(rl3)
            ia5 = il1
            acc = acc + len(ia5)
            sl2.append("bc")
            acc = acc + len(sl2)
        ia6 = il1
        for i1 in range(3):
            ig7 = grow_int(ia6, i1)
            ia8 = il1
        ia4.append(seed)
        for i1 in range(0):
            acc = acc + len(ia4)
            ig9 = grow_int(ia4, 1)
            il1.append(i1)
        sa10 = sl2
    sa11 = sl2
    if len(rl3) > 0:
        inner12 = rl3[0]
        inner12.append(5)
        acc = acc + len(inner12) + len(rl3[0])
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(ia4)
    if len(sa11) > 0:
        out.print(sa11[len(sa11) - 1])
    acc = acc + len(sa11)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
