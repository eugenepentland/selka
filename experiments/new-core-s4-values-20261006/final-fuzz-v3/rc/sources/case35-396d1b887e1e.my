def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(0)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("xyz")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(seed))
    if len(sl2) > 1:
        if len(rl3) > 0:
            ia4 = il1
            ia5 = il1
            rl3.append(make_ints(3))
            ia5.append(1)
            sg6 = grow_str(sl2, seed)
            acc = acc + len(sl2)
            return acc + len(rl3)
        if len(il1) > 3:
            ia7 = il1
            ia7.append(seed)
            acc = acc + len(ia7)
            return acc + len(il1)
    for i2 in range(3):
        ra8 = rl3
        acc = acc + len(sl2)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
