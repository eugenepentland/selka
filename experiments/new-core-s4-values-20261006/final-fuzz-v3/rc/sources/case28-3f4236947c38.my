def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(1)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("a")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("xyz")
    rl3: list[list[int]] = []
    rl3.append(make_ints(seed))
    il1.append(0)
    if len(sl2) > 3:
        ra4 = rl3
        sl2.append("xyz")
    for i2 in range(0):
        for i1 in range(0):
            ra5 = rl3
            acc = acc + len(il1)
            sl2.append("bc")
            acc = acc + len(rl3)
            sg6 = grow_str(sl2, 1)
        ia7 = il1
    for i2 in range(1):
        if len(rl3) > 0:
            inner8 = rl3[0]
            inner8.append(5)
            acc = acc + len(inner8) + len(rl3[0])
        ia9 = il1
        for i1 in range(2):
            il1.append(i2)
            ia10 = ia9
            sg11 = grow_str(sl2, i1)
        acc = acc + len(ia9)
        if len(sl2) > 2:
            acc = acc + len(rl3)
            acc = acc + len(sl2)
            return acc + len(sl2)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
