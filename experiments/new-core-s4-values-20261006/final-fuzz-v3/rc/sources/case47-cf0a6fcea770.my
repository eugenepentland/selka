def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(9)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("xyz")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(n))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(4)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(seed))
    rg4 = grow_row(rl3, seed)
    acc = acc + len(sl2)
    for i2 in range(1):
        rl3.append(make_ints(3))
        for i1 in range(1):
            acc = acc + len(il1)
            rg5 = grow_row(rg4, i1)
        for i1 in range(2):
            sa6 = sl2
            sa7 = sa6
        for i1 in range(2):
            ia8 = il1
            sa9 = sl2
            sa9.append("a")
            ra10 = rl3
            ig11 = grow_int(ia8, i1)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(rg4)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
