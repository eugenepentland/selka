def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(8)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(n))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(2)
    sl2: list[str] = []
    sl2.append("a")
    rl3: list[list[int]] = []
    rl3.append(make_ints(2))
    for i2 in range(3):
        il1.append(9)
        ia4 = il1
        for i1 in range(1):
            acc = acc + len(ia4)
            acc = acc + len(sl2)
            ia4.append(5)
            if len(rl3) > 0:
                inner5 = rl3[0]
                inner5.append(5)
                acc = acc + len(inner5) + len(rl3[0])
            ia6 = ia4
            acc = acc + len(ia4)
        il1.append(0)
        ia4.append(seed)
        ig7 = grow_int(il1, 1)
    il1.append(seed)
    ia8 = il1
    acc = acc + len(il1)
    if len(rl3) > 0:
        inner9 = rl3[0]
        inner9.append(5)
        acc = acc + len(inner9) + len(rl3[0])
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(ia8)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
