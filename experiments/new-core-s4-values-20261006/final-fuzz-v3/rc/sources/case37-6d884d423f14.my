def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(0)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("xyz")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(8)
    sl2: list[str] = []
    sl2.append("a")
    rl3: list[list[int]] = []
    rl3.append(make_ints(3))
    if len(sl2) > 3:
        if len(rl3) > 0:
            inner4 = rl3[0]
            inner4.append(5)
            acc = acc + len(inner4) + len(rl3[0])
        if len(rl3) > 1:
            rl3.append(make_ints(2))
            acc = acc + len(sl2)
            acc = acc + len(sl2)
            acc = acc + len(sl2)
            acc = acc + len(il1)
        acc = acc + len(rl3)
        rl3.append(make_ints(3))
    rl3.append(make_ints(3))
    sa5 = sl2
    for i2 in range(3):
        if len(il1) > 3:
            sa6 = sa5
            acc = acc + len(sa6)
            il1.append(9)
            sa6.append("bc")
            rl3.append(make_ints(seed))
        sg7 = grow_str(sl2, i2)
        sa8 = sa5
        sa8.append("xyz")
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sa5) > 0:
        out.print(sa5[len(sa5) - 1])
    acc = acc + len(sa5)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
