def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(5)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(2))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(6)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(2))
    ia4 = il1
    ia4.append(9)
    sa5 = sl2
    for i2 in range(2):
        ia6 = il1
        ig7 = grow_int(il1, i2)
        if len(rl3) > 0:
            inner8 = rl3[0]
            inner8.append(5)
            acc = acc + len(inner8) + len(rl3[0])
        sl2.append("xyz")
        ia4.append(seed)
    ia4.append(seed)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(ia4)
    if len(sa5) > 0:
        out.print(sa5[len(sa5) - 1])
    acc = acc + len(sa5)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
