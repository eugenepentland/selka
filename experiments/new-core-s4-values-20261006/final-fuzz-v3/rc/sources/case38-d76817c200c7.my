def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("xyz")
    rl3: list[list[int]] = []
    rl3.append(make_ints(3))
    if len(rl3) > 3:
        rg4 = grow_row(rl3, 1)
        for i1 in range(1):
            sl2.append("a")
            sg5 = grow_str(sl2, 1)
            acc = acc + len(il1)
            rg6 = grow_row(rg4, 1)
        for i1 in range(3):
            acc = acc + len(sl2)
            acc = acc + len(sl2)
            if len(rl3) > 0:
                inner7 = rl3[0]
                inner7.append(5)
                acc = acc + len(inner7) + len(rl3[0])
        rl3.append(make_ints(2))
        acc = acc + len(il1)
        sl2.append("a")
    rl3.append(make_ints(seed))
    if len(il1) > 3:
        il1.append(8)
        for i1 in range(3):
            rl3.append(make_ints(2))
            sl2.append("bc")
            if len(rl3) > 0:
                inner8 = rl3[0]
                inner8.append(5)
                acc = acc + len(inner8) + len(rl3[0])
            acc = acc + len(rl3)
            acc = acc + len(rl3)
        ia9 = il1
        ia10 = ia9
        ia11 = ia10
        if len(rl3) > 3:
            acc = acc + len(ia11)
            ia9.append(2)
            acc = acc + len(sl2)
            acc = acc + len(ia9)
            ra12 = rl3
    acc = acc + len(il1)
    il1.append(seed)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
