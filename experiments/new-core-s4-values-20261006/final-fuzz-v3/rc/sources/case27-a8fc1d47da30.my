def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(n))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(1)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(3))
    rl3.append(make_ints(3))
    for i2 in range(1):
        il1.append(i2)
        for i1 in range(2):
            ra4 = rl3
            ra4.append(make_ints(i2))
            sa5 = sl2
            acc = acc + len(sa5)
            acc = acc + len(sa5)
            il1.append(5)
        acc = acc + len(il1)
        rl3.append(make_ints(i2))
        sg6 = grow_str(sl2, seed)
    if len(rl3) > 0:
        inner7 = rl3[0]
        inner7.append(5)
        acc = acc + len(inner7) + len(rl3[0])
    sa8 = sl2
    sa8.append("bc")
    for i2 in range(2):
        for i1 in range(0):
            il1.append(i1)
            acc = acc + len(il1)
            acc = acc + len(sa8)
            sa8.append("bc")
            if len(rl3) > 0:
                inner9 = rl3[0]
                inner9.append(5)
                acc = acc + len(inner9) + len(rl3[0])
        sl2.append("bc")
        ia10 = il1
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sa8) > 0:
        out.print(sa8[len(sa8) - 1])
    acc = acc + len(sa8)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
