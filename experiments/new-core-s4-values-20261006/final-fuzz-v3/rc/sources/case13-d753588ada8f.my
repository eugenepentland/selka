def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(0)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("a")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(2))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(0)
    sl2: list[str] = []
    sl2.append("xyz")
    rl3: list[list[int]] = []
    rl3.append(make_ints(seed))
    if len(sl2) > 2:
        for i1 in range(1):
            acc = acc + len(sl2)
            rl3.append(make_ints(i1))
            ra4 = rl3
            acc = acc + len(rl3)
            rg5 = grow_row(ra4, 1)
            ra6 = rg5
        if len(rl3) > 0:
            inner7 = rl3[0]
            inner7.append(5)
            acc = acc + len(inner7) + len(rl3[0])
        for i1 in range(2):
            ia8 = il1
            sa9 = sl2
            il1.append(i1)
            ia10 = il1
            ia11 = il1
        acc = acc + len(rl3)
        rl3.append(make_ints(seed))
        for i1 in range(3):
            if len(rl3) > 0:
                inner12 = rl3[0]
                inner12.append(5)
                acc = acc + len(inner12) + len(rl3[0])
            sl2.append("a")
            acc = acc + len(sl2)
    acc = acc + len(il1)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
