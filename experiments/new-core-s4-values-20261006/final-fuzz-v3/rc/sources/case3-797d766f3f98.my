def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(8)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(seed))
    ig4 = grow_int(il1, 1)
    sl2.append("xyz")
    for i2 in range(3):
        sa5 = sl2
        acc = acc + len(sl2)
        for i1 in range(3):
            ia6 = ig4
            acc = acc + len(rl3)
            ig4.append(i1)
            sa7 = sl2
        sg8 = grow_str(sa5, 1)
        sa5.append("xyz")
    for i2 in range(0):
        sg9 = grow_str(sl2, 1)
        ia10 = il1
        sa11 = sl2
        for i1 in range(1):
            acc = acc + len(sa11)
            ig4.append(i1)
            il1.append(i2)
            acc = acc + len(sa11)
            acc = acc + len(il1)
            sa12 = sa11
    sa13 = sl2
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(ig4)
    if len(sa13) > 0:
        out.print(sa13[len(sa13) - 1])
    acc = acc + len(sa13)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
