def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("xyz")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(n))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("xyz")
    rl3: list[list[int]] = []
    rl3.append(make_ints(seed))
    ia4 = il1
    if len(rl3) > 1:
        acc = acc + len(il1)
        for i1 in range(1):
            acc = acc + len(ia4)
            sa5 = sl2
    for i2 in range(1):
        sa6 = sl2
        acc = acc + len(sa6)
        if len(sl2) > 3:
            ia7 = ia4
            il1.append(seed)
            ia4.append(i2)
        rl3.append(make_ints(i2))
        ia8 = il1
        ia9 = ia4
    ia4.append(0)
    if len(rl3) > 0:
        inner10 = rl3[0]
        inner10.append(5)
        acc = acc + len(inner10) + len(rl3[0])
    ia11 = il1
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(ia4)
    acc = acc + len(ia11)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
