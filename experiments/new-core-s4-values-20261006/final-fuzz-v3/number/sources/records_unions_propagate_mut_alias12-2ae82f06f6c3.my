def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback

def main(args: list[str], out: Stream) -> int:
    seed = number(args[2], 7)
    texts = ["9223372036854775807", "9223372036854775808", "-9223372036854775808", "-9223372036854775809", "18446744073709551615", "18446744073709551616", "+", "-", "", "1__2", "_1", "1_", "é12", " \t-001_023\r\n", "000000000000000000000000000000000000000000001", "-2", "83x", " \t323\r\n", " \t-7028\r\n", " \t-81010\r_\n", "+168801", "-3734387", "-82007843", " \t+860919825\r\n", " \t+7636532603\r\n", "0442804522_8", "730197101502", "+384615059022_9", " \t+68120850553555\r\n", "311768761494695", "4716491461577537", "+90017632623377086", "668217338652099290", "-2208574889318558732"]
    texts.append("" + str(seed % 1234567) + " ")
    acc = 0
    for text in texts:
        match int(text):
            case Some(value):
                acc = (acc + value % 1000003) % 1000003
                shown = str(value)
                if number(shown, 999) != value:
                    return 6
                out.print(shown)
            case None:
                acc = (acc + len(text) * 31) % 1000003
    float_texts = ["0", "-0.0", "+0", "nan", "-NaN", "+INFINITY", "-inf", "0.125", "2.675", "9.995", "1.7976931348623157e308", "1.7976931348623159e308", "2.2250738585072014e-308", "4.9406564584124654e-324", "2.4703282292062327e-324", "1e-999", "1e+999", "  -1_2.5e+1\t", "1e+", "_1.0", "1__2", "1.2_", "١.0", "1\u0000.0", "+4945.910e-319", "-449709776.3228335566e-171", "-50051225.95156069249e273", "+1.e210", "5.36123e-136", "9767665909.64e298", "7181987025209.54685e275", "-19.96358335929742966610e-111", "0."]
    for text in float_texts:
        framed = ("prefix" + text + "suffix").encode()
        match float(text):
            case Some(value):
                out.print(str(value), f"{value:.0f}", f"{value:.2f}", f"{value:.4e}", f"{value:.17g}")
                match framed.parse_float_range(6, len(framed) - 6):
                    case Some(ranged):
                        if str(ranged) != str(value):
                            return 6
                    case None:
                        return 6
                buffer = byte_buffer([])
                if not buffer.append_float(value):
                    return 6
                if bytes(buffer) != str(value).encode():
                    return 6
            case None:
                if framed.parse_float_range(6, len(framed) - 6) != None:
                    return 6
                out.print("invalid", len(text))
    out.print(acc, str(18446744073709551615u64), f"{seed:#020x}", f"{seed:+020d}")
    return acc % 7
