def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback

def main(args: list[str], out: Stream) -> int:
    seed = number(args[2], 7)
    texts = ["9223372036854775807", "9223372036854775808", "-9223372036854775808", "-9223372036854775809", "18446744073709551615", "18446744073709551616", "+", "-", "", "1__2", "_1", "1_", "é12", " \t-001_023\r\n", "000000000000000000000000000000000000000000001", "+4", "49", "+389", " \t-3204\r_\n", "36456", " \t-381482\r\n", "+9057601", " \t03559688\r\n", "407700638", "-8692495119", "5931787166_3", "-172792474960", " \t-0975732598575\r\n", " \t25767297693761\r\n", "061817962791077", "4927871735598351🙂", " \t+42098364527391429\r_\n", "-425441186645072966_", "+7393183445716318720"]
    texts.append("+" + str(seed % 1234567) + " ")
    acc = 0
    for text in texts:
        match int(text):
            case Some(value):
                acc = (acc + value % 1000003) % 1000003
                shown = str(value)
                if number(shown, 999) != value:
                    return 6
                out.print(shown)
            case None:
                acc = (acc + len(text) * 31) % 1000003
    float_texts = ["0", "-0.0", "+0", "nan", "-NaN", "+INFINITY", "-inf", "0.125", "2.675", "9.995", "1.7976931348623157e308", "1.7976931348623159e308", "2.2250738585072014e-308", "4.9406564584124654e-324", "2.4703282292062327e-324", "1e-999", "1e+999", "  -1_2.5e+1\t", "1e+", "_1.0", "1__2", "1.2_", "١.0", "1\u0000.0", "060544615333.35e230", "-.9566042170704524201813e164", "+714543894395.4e-69", "+3188399268031430.9532e219", "+078.2920e129", "+.171e10", "+6476252330160.9649865e-36", "4678592982.39538e7", "0."]
    for text in float_texts:
        framed = ("prefix" + text + "suffix").encode()
        match float(text):
            case Some(value):
                out.print(str(value), f"{value:.0f}", f"{value:.2f}", f"{value:.4e}", f"{value:.17g}")
                match framed.parse_float_range(6, len(framed) - 6):
                    case Some(ranged):
                        if str(ranged) != str(value):
                            return 6
                    case None:
                        return 6
                buffer = byte_buffer([])
                if not buffer.append_float(value):
                    return 6
                if bytes(buffer) != str(value).encode():
                    return 6
            case None:
                if framed.parse_float_range(6, len(framed) - 6) != None:
                    return 6
                out.print("invalid", len(text))
    out.print(acc, str(18446744073709551615u64), f"{seed:#020x}", f"{seed:+020d}")
    return acc % 7
