def scale(c: mut list[list[float]], n: int):
    for i in range(n):
        for j in range(n):
            c[i][j] = c[i][j] * 2.0


def main(out: Stream) -> int:
    rows3 = [[1.0, 2.0], [3.0, 4.0]]
    keep3 = rows3[1]
    scale(mut rows3, 2)
    scale(mut rows3, 2)
    out.print(rows3[1][1], keep3[1])
    return 0
