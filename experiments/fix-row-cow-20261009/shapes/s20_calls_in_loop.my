# expect: 5 9
# expect: 5 9
# expect: 3 7
def row(xs: list[list[int]], i: int) -> list[int] effects():
    return xs[i]


def pick(f: def(list[list[int]], int) -> list[int] effects(), xs: list[list[int]], i: int) -> list[int]:
    return f(xs, i)


def main(out: Stream) -> int:
    b = [[1, 2], [3, 4], [5, 6]]
    k = [0]
    for i in range(3):
        b[i][0] = 9
        if i == 0:
            k = row(b, 2)
    out.print(k[0], b[2][0])
    c = [[1, 2], [3, 4], [5, 6]]
    kc = [0]
    for i in range(3):
        c[i][0] = 9
        if i == 0:
            kc = pick(row, c, 2)
    out.print(kc[0], c[2][0])
    d = [[1, 2], [3, 4]]
    kd = pick(row, d, 1)
    for i in range(2):
        d[i][0] = 7
    out.print(kd[0], d[1][0])
    return 0
