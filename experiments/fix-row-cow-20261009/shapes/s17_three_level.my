# expect: 5 7
# expect: 5 7
def main(out: Stream) -> int:
    x = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]]
    k = x[1][0]
    for i in range(2):
        for j in range(2):
            x[i][j][0] = 7
    out.print(k[0], x[1][0][0])
    y = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]]
    ky = y[1]
    for i in range(2):
        for j in range(2):
            y[i][j][0] = 7
    out.print(ky[0][0], y[1][0][0])
    return 0
