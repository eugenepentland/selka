# expect: 3 9 9 9
# expect: 4 1
def main(out: Stream) -> int:
    b = [[1, 2], [3, 4], [5, 6]]
    k = [0]
    for i in range(3):
        if i == 0:
            k = b[1]
        b[i][0] = 9
    out.print(k[0], b[0][0], b[1][0], b[2][0])
    c = [[1, 2], [3, 4]]
    acc = 0
    for i in range(2):
        r = c[i]
        c[i][0] = 0
        acc = acc + r[0] - c[i][0]
    out.print(acc, c[0][0] + 1)
    return 0
