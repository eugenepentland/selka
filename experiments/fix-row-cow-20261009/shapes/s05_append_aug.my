# expect: 2 3
# expect: 3 13
def main(out: Stream) -> int:
    b = [[1, 2], [3, 4]]
    k = b[1]
    for i in range(2):
        b[i].append(9)
    out.print(len(k), len(b[1]))
    c = [[1, 2], [3, 4]]
    kc = c[1]
    for i in range(2):
        c[i][0] += 10
    out.print(kc[0], c[1][0])
    return 0
