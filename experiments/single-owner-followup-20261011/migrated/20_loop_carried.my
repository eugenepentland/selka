func append_batch(mut values: int[], base: int, width: int):
    for offset in range(width):
        values.append(base + offset)


func score(values: int[]) -> int:
    mut total = len(values)
    for value in values:
        total += value
    return total


func probe(n: int) -> int:
    const width = n % 3 + 1
    mut values: int[] = []
    for i in range(n):
        append_batch(mut values, n + i, width)
    return score(values)


func main(args: str[], out: Stream) -> int:
    const n = len(args)
    out.print(probe(n))
    return 0
