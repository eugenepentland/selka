module row

extern def runtime_bench_now(host: Host) -> i64 effects(host)


# Row `buffer_write` of the S4 contract: each batch appends the decimal digits of SIZE
# values, a comma after each and a newline after every sixteenth, to a fresh
# `byte_buffer` with its own `append_int` and `append_byte`, then folds the finished
# buffer's octets and releases it.
def batch_result(size: int, batch: int, seed: int) -> int:
    buffer = byte_buffer([])
    for j in range(size):
        v = (seed + batch + 13 * j) % 100003
        _ = buffer.append_int(v)
        _ = buffer.append_byte(44)
        if j % 16 == 15:
            _ = buffer.append_byte(10)
    h = 0
    for c in buffer:
        h = (h * 131 + c) % 1000000007
    return (len(buffer) + h) % 1000000007


def parse_number(text: str) -> int:
    match int(text):
        case Some(n):
            return n
        case None:
            return 0


def main(args: list[str], host: Host, out: Stream) -> int:
    if len(args) != 3:
        return 2
    size = parse_number(args[0])
    iterations = parse_number(args[1])
    seed = parse_number(args[2])
    if size < 2 or iterations < 1 or seed < 1 or seed > 1000000:
        return 2
    checksum = 0
    start = runtime_bench_now(host)
    for batch in range(iterations):
        part = batch_result(size, batch, seed)
        if part < 0:
            return 2
        checksum = (checksum + part) % 1000000007
    elapsed = runtime_bench_now(host) - start
    out.print(checksum, elapsed)
    return 0
