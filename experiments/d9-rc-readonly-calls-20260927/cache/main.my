record Item:
    text: bytes
    number: int
def leaf(items: list[Item], index: int) -> int:
    fresh = [items[index].number]
    return fresh[0] + 1
def middle(items: list[Item], index: int) -> int:
    return leaf(items, index)
def selected(items: list[Item]) -> int:
    return middle(items, 0)
def main() -> int:
    return selected([Item(b"a", 3)])
