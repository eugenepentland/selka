def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(n))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(8)
    sl2: list[str] = []
    sl2.append("xyz")
    rl3: list[list[int]] = []
    rl3.append(make_ints(3))
    rg4 = grow_row(rl3, seed)
    sa5 = sl2
    for i2 in range(1):
        rg4.append(make_ints(2))
        ra6 = rl3
    ra7 = rl3
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(rg4)
    if len(sa5) > 0:
        out.print(sa5[len(sa5) - 1])
    acc = acc + len(sa5)
    acc = acc + len(ra7)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
