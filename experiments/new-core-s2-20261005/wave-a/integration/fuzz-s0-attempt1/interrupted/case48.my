def probe(xs: list[int], key: int) -> int:
    low = 0
    high = len(xs)
    while low < high:
        middle = (low + high) // 2
        if xs[middle] < key:
            low = middle + 1
        else:
            high = middle
    if low < len(xs) and xs[low] == key:
        return low + 1
    return 0


def helper0(a: int, b: int) -> int:
    if ((0 - 31) * 17) < (12 % 16):
        return ((a - b) % ((0 - 28) % a))
    return 26


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((30 % 4611686018427387904) % 1)) % 17 for j in range(n)]
    second = [(j * 48 + 3) % 1009 for j in range(n)]
    flags = [j == (j % 101) and seed > 3037000500 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 18
        total = 0
        for j in range(n):
            x = values[n - 1 - j]
            y = second[j]
            v = ((0 - 15) // 16)
            if flags[j]:
                v = ((v + seed) + (7 + 39))
            else:
                v = v + 1000003
            if j >= (phase * 9223372036854775807) and j == 7:
                continue
            total += v
        acc = (acc + total) % 1000000007
    k = seed % 1000 + 2
    steps = 0
    while k != 1 and steps < 200:
        if k % 2 == 0:
            k = k // 2
        else:
            k = 3 * k + 1
        steps += 1
    acc = acc + steps
    acc = acc + probe(values, (16 + 17))
    out.print(acc, len(values))
    return acc % 7

