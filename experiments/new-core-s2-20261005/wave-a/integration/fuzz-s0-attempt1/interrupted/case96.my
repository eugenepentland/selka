def helper0(a: int, b: int) -> int:
    if a >= (b - b):
        return ((1000003 // a) + (b % 2))
    return a


def helper1(a: int, b: int) -> int:
    if a >= (32 % 17):
        return a
    return ((17 % 1009) % 1009)


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((seed % (0 - 1)) - (j % 1000000007))) % 1009 for j in range(n)]
    second = [(j * 12 + 3) % 64 for j in range(n)]
    flags = [((17 // 1000000007)) % 3 < 31 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 6
        total = 0
        for j in range(n):
            x = values[j]
            y = second[j]
            v = (((2 + 26) // 16) // 3)
            total += v
        acc = (acc + total) % 1000000007
    k = seed % 1000 + 2
    steps = 0
    while k != 1 and steps < 200:
        if k % 2 == 0:
            k = k // 2
        else:
            k = 3 * k + 1
        steps += 1
    acc = acc + steps
    out.print(acc, len(values))
    return acc % 7

