def probe(xs: list[int], key: int) -> int:
    low = 0
    high = len(xs)
    while low <= high:
        middle = (low + high) // 2
        if xs[middle] < key:
            low = middle + 1
        else:
            high = middle - 1
    if low < len(xs) and xs[low] == key:
        return low + 1
    return 0


def helper0(a: int, b: int) -> int:
    return ((b - a) - (b // 1000000007))


def helper1(a: int, b: int) -> int:
    return (b % a)


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(j // (seed * j)) for j in range(n)]
    second = [(j * 37 + 3) % 1009 for j in range(n)]
    flags = [(7 - seed) == (seed + 1000003) or j == 24 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 12
        total = 0
        for j in range(n - 1):
            x = values[j]
            y = second[j]
            v = (((4 % 1000000007) - (j % 16)) % 4611686018427387904)
            if flags[j]:
                v = ((v // (0 - 7)) % (35 * j))
            else:
                v = v + 101
            v = helper0(v, (j * y))
            if j <= (x * x):
                continue
            total += v
        acc = (acc + total) % 1000000007
    acc = acc + probe(values, ((0 - 15) * 39))
    out.print(acc, len(values))
    return acc % 7

