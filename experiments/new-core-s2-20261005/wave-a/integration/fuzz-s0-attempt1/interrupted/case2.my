def probe(xs: list[int], key: int) -> int:
    low = 0
    high = len(xs)
    while low <= high:
        middle = (low + high) // 2
        if xs[middle] < key:
            low = middle + 1
        else:
            high = middle - 1
    if low < len(xs) and xs[low] == key:
        return low + 1
    return 0


def helper0(a: int, b: int) -> int:
    if (a + a) >= (41 % 3) and b < 30:
        return ((a % 1009) % (b // a))
    return 19


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((j * j) % j)) % 1009 for j in range(n)]
    second = [(j * 27 + 3) % 1009 for j in range(n)]
    flags = [seed <= seed for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 10
        total = 0
        for j in range(n):
            x = values[j + 1]
            y = second[j]
            v = 4
            if flags[j]:
                v = ((x % 17) % 2)
            else:
                v = v + 22
            v = helper0(v, (phase + x))
            total += v
        acc = (acc + total) % 1000000007
    acc = acc + probe(second, (65536 * n))
    out.print(acc, len(values))
    return acc % 7

