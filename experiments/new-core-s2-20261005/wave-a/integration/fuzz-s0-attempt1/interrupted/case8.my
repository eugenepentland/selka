def helper0(a: int, b: int) -> int:
    if (b % 16) < a:
        return ((31 % a) + b)
    return ((a * b) * (a // 17))


def helper1(a: int, b: int) -> int:
    return ((31 - a) - (4611686018427387904 * 48))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((35 + seed) * (26 % 16))) % 1009 for j in range(n)]
    second = [(j * 12 + 3) % 1009 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 14
        total = 0
        for j in range(n):
            x = values[j]
            y = second[j]
            v = (0 + ((seed % 101) + y))
            v = helper0(v, (29 * phase))
            total += v
        acc = acc + total
    out.print(acc, len(values))
    return acc % 7

