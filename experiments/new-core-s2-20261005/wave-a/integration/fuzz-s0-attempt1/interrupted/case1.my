def probe(xs: list[int], key: int) -> int:
    i = key % 41 - 2
    if i >= 0:
        if i < len(xs):
            return xs[i]
    return 0


def helper0(a: int, b: int) -> int:
    return ((a + a) - (10 - (0 - 31)))


def helper1(a: int, b: int) -> int:
    if (3037000500 % (0 - 1)) >= (b % 48):
        return b
    return (a + (3037000500 // (0 - 9)))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [((seed * (seed % 17))) % 17 for j in range(n)]
    second = [(j * 19 + 3) % 4000 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 6
        total = 0
        for j in range(n):
            x = values[j]
            y = second[j]
            v = (phase * 19)
            total += v
        acc = acc + total
    k = seed % 1000 + 2
    steps = 0
    while k != 1 and steps < 200:
        if k % 2 == 0:
            k = k // 2
        else:
            k = 3 * k + 1
        steps += 1
    acc = acc + steps
    acc = acc + probe(second, (acc // 1009))
    out.print(acc, len(values))
    return acc % 7

