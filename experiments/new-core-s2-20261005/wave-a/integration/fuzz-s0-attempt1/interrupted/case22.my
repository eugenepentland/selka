def probe(xs: list[int], key: int) -> int:
    total = 0
    i = key % 4
    while i < len(xs):
        total += xs[i]
        i += 3
    return total


def helper0(a: int, b: int) -> int:
    return 49


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((seed + j) * 32)) % 7 for j in range(n)]
    second = [(j * 38 + 3) % 4000 for j in range(n)]
    flags = [(0 - 12) != (seed + j) for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 3
        total = 0
        for j in range(n - 1):
            x = values[n - 1 - j]
            y = second[j]
            v = (((x * 16) + (j - seed)) // 47)
            if flags[j]:
                v = phase
            else:
                v = v + 3037000500
            total += v
        acc = (acc + total) % 1000000007
    acc = acc + probe(second, (n + seed))
    out.print(acc, len(values))
    return acc % 7

