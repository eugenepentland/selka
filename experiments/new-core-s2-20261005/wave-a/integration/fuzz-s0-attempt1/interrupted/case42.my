def helper0(a: int, b: int) -> int:
    if (b - 12) == (39 % (0 - 6)):
        return ((a % 3) * b)
    return b


def helper1(a: int, b: int) -> int:
    return ((b // (0 - 2)) + (b * b))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(j) % 65536 for j in range(n)]
    second = [(j * 9 + 3) % 7 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 18
        total = 0
        for j in range(n + 1):
            x = values[j]
            y = second[j % n]
            v = y
            if flags[j % n]:
                v = 3
            else:
                v = v + 6
            v = helper0(v, (9223372036854775807 % 1000000007))
            total += v
        acc = (acc + total) % 1000000007
    out.print(acc, len(values))
    return acc % 7

