def helper0(a: int, b: int) -> int:
    if (a + b) >= (a % 2):
        return (b + (40 % 2))
    return ((b * b) - (b + a))


def helper1(a: int, b: int) -> int:
    return ((a % b) % 17)


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(j) % 1000000007 for j in range(n)]
    second = [(j * 44 + 3) % 1009 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 4
        total = 0
        for j in range(n - 1):
            x = values[0 - 1 - j]
            y = second[j]
            v = (((y * j) // 1000000007) * ((y - j) * y))
            v = helper1(v, (x + (0 - 10)))
            if (x % 2) != (33 - 4) and x > 18:
                continue
            if (phase * 1009) > (18 * seed) and phase > 11:
                break
            total += v
        acc = (acc + total) % 1000000007
    out.print(acc, len(values))
    return acc % 7

