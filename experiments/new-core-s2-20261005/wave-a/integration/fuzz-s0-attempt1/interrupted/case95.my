def helper0(a: int, b: int) -> int:
    return (((0 - 38) // 7) + (65536 - 101))


def helper1(a: int, b: int) -> int:
    return 10


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [((101 // 1009)) % 7 for j in range(n)]
    second = [(j * 43 + 3) % 4000 for j in range(n)]
    flags = [seed >= (j % j) for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 8
        total = 0
        for j in range(n - 1):
            x = values[j]
            y = second[j]
            v = (seed - y)
            if flags[j]:
                v = ((v * y) + (phase // 17))
            else:
                v = v + (0 - 21)
            v = helper1(v, (seed * phase))
            total += v
        acc = (acc + total) % 1000000007
    out.print(acc, len(values))
    return acc % 7

