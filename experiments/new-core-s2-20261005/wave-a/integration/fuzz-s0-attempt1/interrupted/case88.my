def probe(xs: list[int], key: int) -> int:
    i = key % 43 - 2
    if i >= 0:
        if i <= len(xs):
            return xs[i]
    return 0


def helper0(a: int, b: int) -> int:
    return (3037000500 + (b + 39))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((j // 16) - (45 - j))) % 65536 for j in range(n)]
    second = [(j * 26 + 3) % 64 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 9
        total = 0
        for j in range(len(values)):
            x = values[0 - 1 - j]
            y = second[j]
            v = seed
            v = helper0(v, (x * phase))
            total += v
        acc = (acc + total) % 1000000007
    acc = acc + probe(second, (101 // seed))
    out.print(acc, len(values))
    return acc % 7

