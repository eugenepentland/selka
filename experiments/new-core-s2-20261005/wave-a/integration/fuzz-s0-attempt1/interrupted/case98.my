def probe(xs: list[int], key: int) -> int:
    i = key % 25 - 0
    if i >= 0:
        if i <= len(xs):
            return xs[i]
    return 0


def helper0(a: int, b: int) -> int:
    return (b * (a // 16))


def helper1(a: int, b: int) -> int:
    if (11 * a) > (a + b):
        return 7
    return ((a // 4) + (a - b))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((j % 1) * (j // 16))) % 17 for j in range(n)]
    second = [(j * 32 + 3) % 7 for j in range(n)]
    flags = [(43 * j) == (46 - j) for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 2
        total = 0
        for j in range(n):
            x = values[j]
            y = second[j]
            v = seed
            v = helper0(v, (seed - 50))
            if (phase * j) != (y // 17) or y < 11:
                break
            total += v
        acc = (acc + total) % 1000000007
    k = seed % 1000 + 2
    steps = 0
    while k != 1 and steps < 200:
        if k % 2 == 0:
            k = k // 2
        else:
            k = 3 * k + 1
        steps += 1
    acc = acc + steps
    acc = acc + probe(second, (seed - acc))
    out.print(acc, len(values))
    return acc % 7

