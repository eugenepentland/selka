def probe(xs: list[int], key: int) -> int:
    total = 0
    i = key % 4
    while i <= len(xs):
        total += xs[i]
        i += 2
    return total


def helper0(a: int, b: int) -> int:
    if 65536 == (8 % (0 - 2)):
        return ((1000003 - 38) % 2)
    return 43


def helper1(a: int, b: int) -> int:
    return ((19 * a) * (a % 3))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [((seed // (j % j))) % 17 for j in range(n)]
    second = [(j * 15 + 3) % 4000 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 12
        total = 0
        for j in range(len(values)):
            x = values[j]
            y = second[j]
            v = (((phase + x) % 3) % 1)
            if flags[j]:
                v = (x * (x * x))
            else:
                v = v + 27
            total += v
        acc = (acc + total) % 1000000007
    acc = acc + probe(second, (n % 7))
    out.print(acc, len(values))
    return acc % 7

