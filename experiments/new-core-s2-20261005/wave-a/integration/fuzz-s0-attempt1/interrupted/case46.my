def helper0(a: int, b: int) -> int:
    if (a // (0 - 4)) != b and a < 4611686018427387904:
        return (27 // (0 - 5))
    return ((9223372036854775807 * b) + (b % 1000000007))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [((j % (seed * j))) % 17 for j in range(n)]
    second = [(j * 26 + 3) % 1009 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 2
        total = 0
        for j in range(len(values)):
            x = values[n - 1 - j]
            y = second[j]
            v = ((((0 - 29) % x) % (0 - 8)) // 1009)
            if flags[j]:
                v = ((phase * seed) + 10)
            else:
                v = v + 9223372036854775807
            v = helper0(v, (j % 7))
            if (y // 17) != (seed % 1000000007):
                break
            total += v
        acc = acc + total
    k = seed % 1000 + 2
    steps = 0
    while k != 1 and steps < 200:
        if k % 2 == 0:
            k = k // 2
        else:
            k = 3 * k + 1
        steps += 1
    acc = acc + steps
    out.print(acc, len(values))
    return acc % 7

