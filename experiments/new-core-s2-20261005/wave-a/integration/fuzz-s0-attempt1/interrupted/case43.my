def helper0(a: int, b: int) -> int:
    if (b * a) > (b * b):
        return ((a % 16) % (3037000500 * b))
    return (a - a)


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [j for j in range(n)]
    second = [(j * 41 + 3) % 64 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 7
        total = 0
        for j in range(len(values)):
            x = values[j]
            y = second[j]
            v = y
            v = helper0(v, (j // phase))
            total += v
        acc = (acc + total) % 1000000007
    out.print(acc, len(values))
    return acc % 7

