def helper0(a: int, b: int) -> int:
    return 7


def helper1(a: int, b: int) -> int:
    if (a % 17) != (b // a):
        return a
    return 1000003


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((3037000500 + j) * (2 * j))) % 1009 for j in range(n)]
    second = [(j * 7 + 3) % 64 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 11
        total = 0
        for j in range(n + 2):
            x = values[j]
            y = second[j % n]
            v = (x * x)
            total += v
        acc = (acc + total) % 1000000007
    out.print(acc, len(values))
    return acc % 7

