def probe(xs: list[int], key: int) -> int:
    i = key % 59 - 3
    if i >= 0:
        if i <= len(xs):
            return xs[i]
    return 0


def helper0(a: int, b: int) -> int:
    return (b + (b + 7))


def helper1(a: int, b: int) -> int:
    if (b * a) == b:
        return ((a * b) % (17 // 1))
    return ((a * a) - (65536 % b))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [((j * 1)) % 1009 for j in range(n)]
    second = [(j * 11 + 3) % 64 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 3
        total = 0
        for j in range(n + 2):
            x = values[j]
            y = second[j % n]
            v = 27
            total += v
        acc = acc + total
    acc = acc + probe(second, (n - acc))
    out.print(acc, len(values))
    return acc % 7

