def helper0(a: int, b: int) -> int:
    return (a + (a // 3))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [39 for j in range(n)]
    second = [(j * 32 + 3) % 64 for j in range(n)]
    flags = [(17 % seed) != (seed + j) or j > 8 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 8
        total = 0
        for j in range(len(values)):
            x = values[j + 1]
            y = second[j]
            v = (((37 + 10) * (x + phase)) % ((5 * x) // 2))
            if flags[j]:
                v = x
            else:
                v = v + 37
            v = helper0(v, (y - 29))
            total += v
        acc = acc + total
    out.print(acc, len(values))
    return acc % 7

