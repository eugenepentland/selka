def probe(xs: list[int], key: int) -> int:
    low = 0
    high = len(xs)
    while low < high:
        middle = (low + high) // 2
        if xs[middle] < key:
            low = middle + 1
        else:
            high = middle
    if low < len(xs) and xs[low] == key:
        return low + 1
    return 0


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((j + seed) * (23 * j))) % 17 for j in range(n)]
    second = [(j * 24 + 3) % 4000 for j in range(n)]
    flags = [(((0 - 34) // 16)) % 3 < 58 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 19
        total = 0
        for j in range(len(values)):
            x = values[j]
            y = second[j]
            v = (((35 // 16) % 1009) // 2)
            total += v
        acc = (acc + total) % 1000000007
    acc = acc + probe(second, (n % 65536))
    out.print(acc, len(values))
    return acc % 7

