def probe(xs: list[int], key: int) -> int:
    i = key % 71 - 3
    if i >= 0:
        if i <= len(xs):
            return xs[i]
    return 0


def helper0(a: int, b: int) -> int:
    if (a + 9223372036854775807) < a:
        return a
    return a


def helper1(a: int, b: int) -> int:
    if (b + 8) >= (a % 7) and a > 27:
        return ((b % 19) + (3 - a))
    return ((8 // 27) + 37)


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((11 + 4611686018427387904) // 3)) % 1009 for j in range(n)]
    second = [(j * 40 + 3) % 64 for j in range(n)]
    flags = [((j % 1000000007)) % 101 < 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 20
        total = 0
        for j in range(n + 1):
            x = values[j]
            y = second[j % n]
            v = ((x % 1) * ((y + x) + (x // 101)))
            total += v
        acc = (acc + total) % 1000000007
    acc = acc + probe(second, (seed - seed))
    out.print(acc, len(values))
    return acc % 7

