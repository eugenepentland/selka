def helper0(a: int, b: int) -> int:
    if b >= (b % 2):
        return ((a % (0 - 2)) * a)
    return b


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(seed) % 1009 for j in range(n)]
    second = [(j * 28 + 3) % 4000 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 1
        total = 0
        for j in range(n):
            x = values[j + 1]
            y = second[j]
            v = 13
            if flags[j]:
                v = j
            else:
                v = v + 101
            v = helper0(v, 1009)
            total += v
        acc = acc + total
    out.print(acc, len(values))
    return acc % 7

