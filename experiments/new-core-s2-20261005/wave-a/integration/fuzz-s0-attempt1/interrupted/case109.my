def probe(xs: list[int], key: int) -> int:
    i = key % 74 - 3
    if i >= 0:
        if i < len(xs):
            return xs[i]
    return 0


def helper0(a: int, b: int) -> int:
    return ((a + b) % (1009 * b))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(17) % 4000 for j in range(n)]
    second = [(j * 28 + 3) % 1009 for j in range(n)]
    flags = [((seed * seed)) % 101 < 24 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 9
        total = 0
        for j in range(n):
            x = values[j]
            y = second[j]
            v = (24 // 17)
            if flags[j]:
                v = ((v + 13) // 1009)
            else:
                v = v + 24
            total += v
        acc = acc + total
    acc = acc + probe(second, 1009)
    out.print(acc, len(values))
    return acc % 7

