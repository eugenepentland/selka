# RC-DICTIONARY-LOOP-1
def fresh(times: int) -> dict[str, int]:
    keys = ["al" + "pha", "beta"]
    counts: dict[str, int] = {}
    for i in range(times):
        key = keys[i % 2]
        counts[key] = counts.get(key, 0) + 1
    assert len(keys) == 2
    return counts

def test_fresh_root_and_zero_iterations() -> bool:
    counts = fresh(80)
    assert counts["alpha"] == 40
    assert counts["beta"] == 40
    assert len(fresh(0)) == 0
    return True

def test_inherited_arena_keeps_original_region_and_growth() -> bool:
    with arena():
        assert fresh(50)["alpha"] == 25
        assert len(fresh(0)) == 0
    return fresh(6)["beta"] == 3

def shared_empty(times: int) -> int:
    keys = ["key"]
    counts: dict[str, int] = {}
    saved = counts
    for i in range(times):
        key = keys[0]
        counts[key] = counts.get(key, 0) + 1
    assert len(saved) == 0
    return counts.get("key", 0)

def test_shared_empty_root_refuses_even_zero_iterations() -> bool:
    return shared_empty(0) == 0 and shared_empty(4) == 4

def during(times: int) -> int:
    keys = ["key"]
    counts: dict[str, int] = {}
    saved: dict[str, int] = {}
    for i in range(times):
        saved = counts
        key = keys[0]
        counts[key] = counts.get(key, 0) + 1
    return saved.get("key", 0)

def test_publication_during_loop_refuses() -> bool:
    return during(3) == 2

def change(counts: mut dict[str, int]) -> int:
    counts["key"] = 10
    return 7

def calls(times: int) -> int:
    keys = ["key"]
    counts: dict[str, int] = {}
    for i in range(times):
        key = keys[0]
        counts[key] = change(mut counts)
    return counts["key"]

def test_callback_and_reference_keep_fallback() -> bool:
    return calls(2) == 7

def rebound(times: int) -> int:
    keys = ["key"]
    counts: dict[str, int] = {}
    for i in range(times):
        counts = {"key": 20}
        key = keys[0]
        counts[key] = counts.get(key, 0) + 1
    return counts["key"]

def test_rebound_root_keeps_fallback() -> bool:
    return rebound(2) == 21

def enclosing() -> bool:
    keys = ["key"]
    counts: dict[str, int] = {}
    saved: dict[str, int] = {}
    for outer in range(3):
        for i in range(2):
            key = keys[0]
            counts[key] = counts.get(key, 0) + 1
        saved = counts
    counts["key"] = 9
    return saved["key"] == 6

def test_enclosing_loop_publication_cannot_feed_fresh_entry() -> bool:
    return enclosing()
