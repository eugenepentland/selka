+# Scalar result carriers preserve floating edge cases across each numeric opcode.
+public def test_run_numeric_carrier_ieee(out: Stream) -> bool:
+    source = b"print 8 > 3; print 3 < 8; print 8 - 3; print 8 * 3; print 8 / 3; print -0 / 2; print 1 / -0; var n = 0 / 0; print n > 0; print n < 0; print n - 0; print n * 0; print n / 0; var h = 100000000000000000000; h = h * h; h = h * h; h = h * h; h = h * h; print h; print h - h; print h * 0; print 1 / h; print -1 / h;"
+    expected = b"true\ntrue\n5\n24\n2.6666666666666665\n-0\n-inf\nfalse\nfalse\nnan\nnan\nnan\ninf\nnan\nnan\n0\n-0\n"
+    vm_run = driver.run_source(source, driver.Engine.VM, True, out, None)
+    tree = driver.run_source(source, driver.Engine.TREE, True, out, None)
+    return vm_run.status == 0 and vm_run.stdout == expected and vm_run.stderr == b"" and tree.status == 0 and tree.stdout == expected and tree.stderr == b""
+
+
+# Both operands evaluate before either numeric tag error; the published VM IP
+# still names the failing leaf and all callers under Lox collection stress.
+public def test_run_numeric_carrier_error_order(out: Stream) -> bool:
+    for op in [b">", b"<", b"-", b"*", b"/"]:
+        for reversed in [False, True]:
+            left = b"2" if reversed else b"\"bad\""
+            right = b"\"bad\"" if reversed else b"2"
+            source = b"fun left() { print \"L\"; return " + left + b"; }\nfun right() { print \"R\"; return " + right + b"; }\nfun leaf() { return left() " + op + b" right(); }\nfun outer() { return leaf(); }\nouter();"
+            vm_run = driver.run_source(source, driver.Engine.VM, True, out, None)
+            tree = driver.run_source(source, driver.Engine.TREE, True, out, None)
+            expected_vm = b"Operands must be numbers.\n[line 3] in leaf()\n[line 4] in outer()\n[line 5] in script\n"
+            if vm_run.status != 70 or vm_run.stdout != b"L\nR\n" or vm_run.stderr != expected_vm or tree.status != 70 or tree.stdout != b"L\nR\n" or tree.stderr != b"Operands must be numbers.\n[line 3]\n":
+                return False
+    return True
+
