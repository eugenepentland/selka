+# A retained Runtime/stack snapshot remains unchanged while checked arithmetic
+# writes and error cleanup run on the active Runtime during every-allocation GC.
+public def test_run_numeric_carrier_runtime_snapshot(out: Stream) -> bool:
+    rt = heap.new_runtime(True, None)
+    saved = rt
+    stack = rt.stack
+    o = output.capture(out)
+    source = b"fun f(a, b) { print a > b; print a < b; print a - b; print a * b; print a / b; } f(6, 2); class C {} print C() * C();"
+    status = stack_vm.interpret(mut rt, mut o, source)
+    return status == stack_vm.InterpretResult.RUNTIME_ERROR and bytes(o.stdout) == b"true\nfalse\n4\n12\n3\n" and bytes(o.stderr) == b"Operands must be numbers.\n[line 1] in script\n" and rt.stack_top == 0 and rt.frame_count == 0 and saved.stack_top == 0 and saved.frame_count == 0 and saved.allocations == 0 and stack[0] == value.Value.nil and saved.stack[1] == value.Value.nil and rt.collections == rt.allocations
