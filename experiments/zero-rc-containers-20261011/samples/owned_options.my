func size(value: str?) -> int:
    match value:
        case Some(text):
            return len(text)
        case None:
            return 0
func main(out: Stream) -> int:
    mut values: str?[] = [Some("value-" + str(1)), None]
    const saved = values.copy()
    values.clear()
    out.print(size(saved[0]), size(saved[1]))
    return 0
