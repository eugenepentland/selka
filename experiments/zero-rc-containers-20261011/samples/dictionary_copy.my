func main(out: Stream) -> int:
    mut values: dict[str, str[]] = {}
    for i in range(40):
        values["key-" + str(i)] = ["value-" + str(i)]
    mut saved = values.copy()
    values["key-1"] = ["changed"]
    out.print(values["key-1"][0], saved["key-1"][0], len(saved))
    values.clear()
    out.print(saved["key-2"][0])
    return 0
