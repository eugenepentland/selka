func main(out: Stream) -> int:
    mut source = " λ-7 ".encode()
    const trimmed = source.strip()
    const saved = trimmed.hex()
    const tail = trimmed[1:]
    const decoded = trimmed.decode()
    const parsed = bytes.fromhex(saved)
    source = b"changed"
    out.print(saved, tail.hex(), trimmed.find(b"-"))
    match decoded:
        case Ok(text):
            out.print(text)
        case Err(error):
            out.print(error)
    match parsed:
        case Ok(data):
            out.print(data.hex())
        case Err(error):
            out.print(error)
    match b"\xff".decode():
        case Ok(text):
            out.print(text)
        case Err(error):
            out.print(len(error) > 0)
    return 0
