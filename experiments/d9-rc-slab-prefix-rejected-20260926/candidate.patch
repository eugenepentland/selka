diff --git a/tests/native_rc_collections_test.c b/tests/native_rc_collections_test.c
index 69a1712d..7bc12ece 100644
--- a/tests/native_rc_collections_test.c
+++ b/tests/native_rc_collections_test.c
@@ -122,6 +122,46 @@ static void native_allocation_cache(void) {
         finish(&heap);
     }
 }
+/* spec-case: RC-SLAB-RESET-1. Retired slots can contain arbitrary stale counts,
+ * flags and types. Reuse resets all live prefix words and the full class body,
+ * including padding beyond the smaller new type and the zero-sized class. */
+static void slab_prefix_reset(void) {
+    static const size_t bodies[]={0,16,32,224,8160};
+    static const myl_native_type byte={.size=1,.alignment=1,.kind=MYL_NATIVE_PLAIN};
+    myl_native_type old_types[5], new_types[5];
+    myl_native_heap heap;
+    init(&heap);
+    for (size_t i=0;i<5;i++) {
+        old_types[i]=(myl_native_type){.size=bodies[i],.alignment=1,.kind=MYL_NATIVE_PLAIN};
+        new_types[i]=(myl_native_type){.size=bodies[i]?bodies[i]-15:0,.alignment=1,.kind=MYL_NATIVE_PLAIN};
+        void *anchor=myl_native_heap_alloc(&heap,&old_types[i],1);
+        void *old=myl_native_heap_alloc(&heap,&old_types[i],1);
+        assert(anchor && old);
+        myl_rc_owner_release(&heap,old);
+        myl_rc_object *header=(myl_rc_object *)old-1;
+        /* The anchor retains the slab. Only its first word is a live free-list
+         * link; preserve that link while poisoning every other retired byte. */
+        memset((unsigned char *)header+sizeof(void *),0xa5,
+            MYL_RC_PREFIX_BYTES+bodies[i]-sizeof(void *));
+        void *fresh=myl_native_heap_alloc(&heap,&new_types[i],1);
+        assert(fresh==old && owners(fresh)==1 && header->holds==0);
+        assert(header->common.mark==((uintptr_t)1<<MYL_NATIVE_OBJECT_COUNT_SHIFT));
+        assert(header->common.element==&new_types[i]);
+        for (size_t at=0;at<bodies[i];at++) assert(((unsigned char *)fresh)[at]==0);
+        myl_rc_owner_release(&heap,fresh);
+        memset((unsigned char *)header+sizeof(void *),0xa5,
+            MYL_RC_PREFIX_BYTES+bodies[i]-sizeof(void *));
+        size_t count=bodies[i]?bodies[i]-1:0;
+        fresh=myl_native_heap_alloc(&heap,&byte,count);
+        assert(fresh==old && owners(fresh)==1 && header->holds==0);
+        assert(header->common.mark==((uintptr_t)count<<MYL_NATIVE_OBJECT_COUNT_SHIFT));
+        assert(header->common.element==&byte);
+        for (size_t at=0;at<bodies[i];at++) assert(((unsigned char *)fresh)[at]==0);
+        myl_rc_owner_release(&heap,fresh);
+        myl_rc_owner_release(&heap,anchor);
+    }
+    finish(&heap);
+}
 /* spec-case: RC-STORAGE-1. Cold metadata refusal is atomic; a full cached slab
  * refuses before publication, and trimming cannot leave a cached slab pointer. */
