import memo


func compute(key: memo.Key) -> int effects():
    match key:
        case memo.Key.Number(value=value):
            return value * value
        case memo.Key.Text(value=value):
            return len(value)
        case memo.Key.Data(value=value):
            return len(value)


func main(args: str[], out: Stream) -> int:
    mut limit = 2
    if len(args) > 0:
        limit = 0
    match memo.create(limit, compute):
        case Ok(initial):
            mut cache = initial
            mut sum = 0
            mut hits = 0
            for index in range(100):
                const result = memo.call(mut cache, memo.Key.Number(value=6))
                sum += result.value
                if result.reused:
                    hits += 1
            out.print(sum, hits, memo.count(cache))
            if sum != 3600:
                return 1
            if limit == 0 and hits != 0:
                return 2
            if limit == 2 and hits != 99:
                return 3
            return 0
        case Err(_):
            return 4
