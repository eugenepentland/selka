extern func runtime_bench_now(host: Host) -> i64 effects(host)


# Row `union_find` (CONTRACT.md): union by linking roots, path halving that mutates `parent`.
# Arguments `size iterations seed`; output `checksum elapsed`. `parent` is one fresh list per batch
# and `find` takes it as `mut`, so every call site writes `find(mut parent, x)`.
func find(mut parent: int[], x: int) -> int:
    mut current = x
    while parent[current] != current:
        parent[current] = parent[parent[current]]
        current = parent[current]
    return current


func batch_result(size: int, batch: int, seed: int) -> int:
    mut parent = list(range(size))
    for j in range(size):
        mut a = (seed + batch + 13 * j) % size
        mut b = (seed + 7 * batch + 17 * j + 1) % size
        mut ra = find(mut parent, a)
        mut rb = find(mut parent, b)
        if ra != rb:
            parent[ra] = rb
    mut components = 0
    for j in range(size):
        if find(mut parent, j) == j:
            components += 1
    mut rootsum = 0
    for j in range(size):
        rootsum += find(mut parent, j)
    return (components * 1000003 + rootsum) % 1000000007


func parse_number(text: str) -> int:
    match parse_int(text):
        case Some(n):
            return n
        case None:
            return 0


func main(args: str[], host: Host, out: Stream) -> int:
    if len(args) != 3:
        return 2
    mut size = parse_number(args[0])
    mut iterations = parse_number(args[1])
    mut seed = parse_number(args[2])
    if size < 2 or iterations < 1 or seed < 1 or seed > 1000000:
        return 2
    mut checksum = 0
    mut start = runtime_bench_now(host)
    for batch in range(iterations):
        mut part = batch_result(size, batch, seed)
        if part < 0:
            return 2
        checksum = (checksum + part) % 1000000007
    mut elapsed = runtime_bench_now(host) - start
    out.print(checksum, elapsed)
    return 0
