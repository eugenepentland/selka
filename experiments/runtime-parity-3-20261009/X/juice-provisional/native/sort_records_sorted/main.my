# sort_records_sorted: sort_records through the Python spelling of a key sort,
# the prelude's sorted(records, key=lambda r: r.key), instead of the sort
# module's sort_by_key. Same data, same stable order, same output.
#
# The prelude keyed sorted is a bottom-up merge that appends into one reused
# scratch list, where sort.sort_by_key is a recursive merge that copies both
# halves with slices and builds a fresh output list at every level.
record Rec:
    key: int
    id: int


func xorshift(input: u64) -> u64:
    mut x = input
    x = bit_xor(x, shift_left(x, 13u64))
    x = bit_xor(x, shift_right(x, 7u64))
    return bit_xor(x, shift_left(x, 17u64))


func mix(c: int, v: int) -> int:
    return (c * 31 + v) % 1000000007


func main(out: Stream) -> int:
    mut n = 1000000
    mut state = 88172645463325252u64
    mut records: Rec[] = []
    for i in range(n):
        state = xorshift(state)
        records.append(Rec(key=int(shift_right(state, 33u64)) % 100000, id=i))
    mut ordered = sorted(records, key=lambda r: r.key)
    out.print(ordered[0].key, ordered[n - 1].key)
    mut c = 0
    for r in ordered:
        c = mix(c, r.id)
    out.print(c)
    return 0
