# Tests for sexpr.printer, ported from the inline `test "..."` blocks in
# eda/src/sexpr/printer.zig. Every expectation the Zig file makes is reproduced
# here with the same input, except:
#
#   * "round-trip every project .sexp file" walks `projects/designs` on the
#     filesystem (500..10_000 files); the guest runtime has no filesystem.
#   * "fuzz: parse-print-parse round-trips accepted input" drives
#     `std.testing.Smith`; the guest runtime has no fuzzer. The Zig case it
#     stands for — an accepted parse must print to text that re-parses into a
#     structurally identical AST — is covered here by text idempotence (see
#     test_round_trip_parse_print_parse).
#
# Zig's round-trip test compares nodes recursively via `expectNodesEqual`. The
# guest language has no structural equality over a union, so the round trip is
# checked on the printed text instead: render -> parse -> render must be a
# fixed point, which holds exactly when the two ASTs are structurally equal
# (the printer is a pure function of the tree).
#
# The layout expectations — including "print keeps a literal's unit", which the
# AST's `decimal` literal field now makes reproducible — were checked byte-for-byte
# against the real printer.zig over the four in-repo fixtures and a random
# corpus, so the multi-line strings below are the Zig printer's own output, not
# an eyeballed guess.
import sexpr.ast as ast
import sexpr.parser as parser
import sexpr.printer as printer

import sexpr.view as view

# A node built by hand carries a view of its own spelling, exactly as a parsed
# node carries a view of the document it came from. These helpers produce that
# view for a literal in a test body, so a hand-built tree looks the way it did
# before text became a source range.
func view_of_text(text: str) -> view.View:
    mut data = text.encode()
    return view.View(source=data, start=0, end=len(data))


func text_in(found: view.View) -> str:
    match view.text_of(found):
        case Ok(text):
            return text
        case Err(_):
            return "<none>"


# ── helpers ───────────────────────────────────────────────────────────
func parse_ok(src: bytes) -> ast.Node[]:
    match parser.parse(src):
        case Ok(nodes):
            return nodes
        case Err(_):
            mut empty: ast.Node[] = []
            return empty


func render_src(src: bytes) -> str:
    return printer.render(parse_ok(src))


func render_bytes_src(src: bytes) -> bytes:
    return printer.render_bytes(parse_ok(src))


func has_newline(text: str) -> bool:
    return text.find("\n") >= 0


func repeated(text: str, count: int) -> str:
    mut out = ""
    mut index = 0
    while index < count:
        out = out + text
        index = index + 1
    return out


# ── Zig test: "print simple list" ─────────────────────────────────────
public func test_print_simple_list() -> bool:
    return render_src(b"(hello 42 \"world\")") == "(hello 42 \"world\")"


# ── Zig test: "print short nested lists inline" ───────────────────────
public func test_print_short_nested_lists_inline() -> bool:
    # Zig asserts `indexOf(output, "\n") == null`.
    return has_newline(render_src(b"(pad 1 smd rect (pos -1.25 1.75) (size 0.7 0.3))")) == False


public func test_print_short_nested_lists_inline_exact() -> bool:
    return render_src(b"(pad 1 smd rect (pos -1.25 1.75) (size 0.7 0.3))") == "(pad 1 smd rect (pos -1.25 1.75) (size 0.7 0.3))"


# ── Zig test: "print long nested lists multiline" ─────────────────────
public func test_print_long_nested_lists_multiline() -> bool:
    # Zig asserts `indexOf(output, "\n") != null`.
    return has_newline(render_src(b"(footprint \"QFN9-3.3x4.5\" (pad 1 smd rect (pos -1.25 1.75) (size 0.7 0.3)) (pad 2 smd rect (pos -1.25 0.75) (size 0.7 0.3)))"))


public func test_print_long_nested_lists_multiline_exact() -> bool:
    # The first child stays on the "(" line; every later child gets its own
    # line indented by two spaces. The nested pad lists are short and stay
    # inline (the depth cutoff is measured from each list, not from the root).
    return render_src(b"(footprint \"QFN9-3.3x4.5\" (pad 1 smd rect (pos -1.25 1.75) (size 0.7 0.3)) (pad 2 smd rect (pos -1.25 0.75) (size 0.7 0.3)))") == "(footprint\n  \"QFN9-3.3x4.5\"\n  (pad 1 smd rect (pos -1.25 1.75) (size 0.7 0.3))\n  (pad 2 smd rect (pos -1.25 0.75) (size 0.7 0.3)))"


# ── Zig test: "print keeps a literal's unit" ──────────────────────────
public func test_literal_source_spelling_is_kept() -> bool:
    # Zig parses `100nF 10% 4.7k 2.5`, keeps each suffixed literal's spelling on
    # the node and prints the input unchanged. The ported AST carries the same
    # spelling on the decimal case's `literal` field, so
    # this reproduces the Zig expectation exactly.
    return render_src(b"(cap-0402 100nF 10% 4.7k 2.5)") == "(cap-0402 100nF 10% 4.7k 2.5)"


# ── Zig test: "round-trip parse-print-parse" ──────────────────────────
public func test_round_trip_parse_print_parse() -> bool:
    mut printed = render_src(b"(net \"VIN\" (pin \"U1\" 6) (pin \"C1\" 1))")
    return printed == "(net \"VIN\" (pin \"U1\" 6) (pin \"C1\" 1))" and render_src(printed.encode()) == printed and len(parse_ok(printed.encode())) == 1


# ── fixtures/units.sexp (inlined; guest tests have no filesystem) ─────
public func test_fixture_dimensions_bare_units() -> bool:
    # `3.5`-style values are not involved: the bare measures normalise to mm
    # and the printer appends "mm" to each.
    return render_src(b"(dimensions (width 2.5mm) (height 10mil) (clearance 0.5mm))") == "(dimensions (width 2.5mm) (height 0.254mm) (clearance 0.5mm))"


public func test_fixture_vendor_becomes_multiline() -> bool:
    return render_src(b"(vendor (model PMA3-24323LN+.stp) (pad P$1) (mpn \"74AHCT1G125GF,132.stp\"))") == "(vendor\n  (model PMA3-24323LN+.stp)\n  (pad P$1)\n  (mpn \"74AHCT1G125GF,132.stp\"))"


public func test_fixture_oddities_stay_one_line() -> bool:
    # `100kHz`, `12.5abc`, `204928-0301.stp` and `3m` all fall back to atoms,
    # so the form round-trips verbatim.
    return render_src(b"(oddities (freq 100kHz) (bad 12.5abc) (part 204928-0301.stp) (bare 3m))") == "(oddities (freq 100kHz) (bad 12.5abc) (part 204928-0301.stp) (bare 3m))"


public func test_fixture_nested_depth_cutoff() -> bool:
    # The outer list cannot measure its child: the atom `d` sits at depth 4, so
    # `estimateWidth` gives up and forces the multi-line layout, while the
    # child list is re-measured from depth 0 and fits on one line.
    return render_src(b"(nested (a (b (c (d)))))") == "(nested\n  (a (b (c (d)))))"


public func test_fixture_note_string_is_verbatim() -> bool:
    return render_src(b"(note \"escaped \\\"quote\\\" and \\\\ backslash\")") == "(note \"escaped \\\"quote\\\" and \\\\ backslash\")"


public func test_fixture_electrical_literals_keep_the_form_on_one_line() -> bool:
    # Zig keeps `220k`/`100nF`/`3.3V`/`10mA`/`5%` (71 columns of estimate) and
    # prints one line. The decimal case's `literal` restores the same spelling and
    # therefore the same width, so this is the Zig layout byte for byte; without
    # it the decoded values measure 75 columns and break the form.
    mut src = b"(electrical (res 220k) (cap 100nF) (rail 3.3V) (current 10mA) (tol 5%))"
    return render_src(src) == "(electrical (res 220k) (cap 100nF) (rail 3.3V) (current 10mA) (tol 5%))"


# ── the 72-column rule and the depth cutoff ───────────────────────────
public func test_width_boundary_is_72_columns() -> bool:
    # `(a <N x's>)` estimates 4 + N columns; 72 fits, 73 does not.
    mut at_limit: bytes = b"(a " + repeated("x", 68).encode() + b")"
    mut over_limit: bytes = b"(a " + repeated("x", 69).encode() + b")"
    return has_newline(render_src(at_limit)) == False and has_newline(render_src(over_limit))


public func test_depth_cutoff_breaks_at_five_levels() -> bool:
    # Depth 3 nesting (`(d)` inside `(c)` inside `(b)`) is measurable; one
    # level deeper makes the estimate unknown and the list multi-line.
    return render_src(b"(a (b (c (d))))") == "(a (b (c (d))))" and render_src(b"(a (b (c (d (e)))))") == "(a\n  (b (c (d (e)))))"


public func test_indentation_accumulates_through_nesting() -> bool:
    return render_src(b"(a (b (c (d (e (f))))))") == "(a\n  (b\n    (c (d (e (f))))))"


# ── top-level joining and the hand-built tree ─────────────────────────
public func test_top_level_forms_join_with_one_newline() -> bool:
    mut nodes: ast.Node[] = [ast.Node.atom(text=view_of_text("a"), span=ast.zero_span()), ast.Node.integer(value=2, span=ast.zero_span()), ast.Node.form(items=[ast.Node.atom(text=view_of_text("b"), span=ast.zero_span())], span=ast.zero_span())]
    return printer.render(nodes) == "a\n2\n(b)"


public func test_top_level_output_has_no_trailing_newline() -> bool:
    mut nodes: ast.Node[] = [ast.Node.atom(text=view_of_text("a"), span=ast.zero_span()), ast.Node.atom(text=view_of_text("b"), span=ast.zero_span())]
    return printer.render(nodes).endswith("\n") == False


public func test_render_empty_document() -> bool:
    mut nodes: ast.Node[] = []
    return printer.render(nodes) == ""


public func test_render_node_is_one_node_at_indent_zero() -> bool:
    return printer.render_node(ast.Node.form(items=[], span=ast.zero_span())) == "()" and printer.render_node(ast.Node.atom(text=view_of_text("GND"), span=ast.zero_span())) == "GND"


public func test_render_hand_built_tree() -> bool:
    mut tree = ast.Node.form(items=[ast.Node.atom(text=view_of_text("footprint"), span=ast.zero_span()), ast.Node.string(text=view_of_text("QFN9-3.3x4.5"), span=ast.zero_span()), ast.Node.form(items=[ast.Node.atom(text=view_of_text("pad"), span=ast.zero_span()), ast.Node.integer(value=1, span=ast.zero_span()), ast.Node.atom(text=view_of_text("smd"), span=ast.zero_span())], span=ast.zero_span()), ast.Node.form(items=[ast.Node.atom(text=view_of_text("pos"), span=ast.zero_span()), ast.Node.decimal(value=-1.25, span=ast.zero_span()), ast.Node.measure(value=0.7, span=ast.zero_span())], span=ast.zero_span()), ast.Node.form(items=[], span=ast.zero_span())], span=ast.zero_span())
    return printer.render_node(tree) == "(footprint \"QFN9-3.3x4.5\" (pad 1 smd) (pos -1.25 0.7mm) ())"


# The byte renderer shares layout and spelling with the established text API.
# These samples cover every node kind, multiline indentation, source-preserved
# numeric literals, normalized measures and verbatim string escapes.
public func test_render_bytes_matches_text_for_representative_goldens() -> bool:
    mut samples: bytes[] = [b"(hello 42 \"world\")", b"(footprint \"QFN9-3.3x4.5\" (pad 1 smd rect (pos -1.25 1.75) (size 0.7 0.3)) (pad 2 smd rect (pos -1.25 0.75) (size 0.7 0.3)))", b"(dimensions (width 2.5mm) (height 10mil) (clearance 0.5mm))", b"(cap-0402 100nF 10% 4.7k 2.5)", b"(note \"escaped \\\"quote\\\" and \\\\ backslash\")", b"(nested (a (b (c (d (e))))))"]
    for sample in samples:
        if render_bytes_src(sample) != render_src(sample).encode():
            return False
    return True


public func test_render_node_bytes_matches_numeric_and_string_nodes() -> bool:
    mut nodes: ast.Node[] = [ast.Node.integer(value=-42, span=ast.zero_span()), ast.Node.decimal(value=100.0, span=ast.zero_span()), ast.Node.measure(value=0.254, span=ast.zero_span()), ast.Node.string(text=view_of_text("hé \\\"quoted\\\""), span=ast.zero_span())]
    for node in nodes:
        if printer.render_node_bytes(node) != printer.render_node(node).encode():
            return False
    return True


public func test_render_bytes_unicode_width_counts_scalars_not_utf8_bytes() -> bool:
    # Quotes contribute two columns, so 66 non-ASCII scalars land exactly at
    # 72. Their 132 UTF-8 bytes must not force a multiline layout.
    mut at_limit = b"(a \"" + repeated("é", 66).encode() + b"\")"
    mut over_limit = b"(a \"" + repeated("é", 67).encode() + b"\")"
    return (render_bytes_src(at_limit).find(b"\n") == -1 and render_bytes_src(over_limit).find(b"\n") >= 0 and render_bytes_src(at_limit) == render_src(at_limit).encode())


public func test_render_bytes_document_boundaries() -> bool:
    mut nodes: ast.Node[] = [ast.Node.atom(text=view_of_text("é"), span=ast.zero_span()), ast.Node.integer(value=2, span=ast.zero_span())]
    mut empty: ast.Node[] = []
    return printer.render_bytes(nodes) == b"\xc3\xa9\n2" and printer.render_bytes(empty) == b""


# ── per-node rendering ────────────────────────────────────────────────
public func test_integer_rendering() -> bool:
    return printer.render_node(ast.Node.integer(value=-42, span=ast.zero_span())) == "-42" and printer.render_node(ast.Node.integer(value=0, span=ast.zero_span())) == "0"


public func test_decimal_rendering_keeps_the_float_int_distinction() -> bool:
    return (printer.render_node(ast.Node.decimal(value=3.3, span=ast.zero_span())) == "3.3" and printer.render_node(ast.Node.decimal(value=100.0, span=ast.zero_span())) == "100.0" and printer.render_node(ast.Node.decimal(value=0.0, span=ast.zero_span())) == "0.0" and printer.render_node(ast.Node.decimal(value=0.0000001, span=ast.zero_span())) == "0.0000001")


public func test_measure_rendering_appends_mm() -> bool:
    return (printer.render_node(ast.Node.measure(value=0.7, span=ast.zero_span())) == "0.7mm" and printer.render_node(ast.Node.measure(value=3.0, span=ast.zero_span())) == "3.0mm" and printer.render_node(ast.Node.measure(value=0.254, span=ast.zero_span())) == "0.254mm")


public func test_string_rendering_is_verbatim() -> bool:
    # The content is the raw slice between the quotes; a `\"` in it must not be
    # re-escaped to `\\\"`.
    return printer.render_node(ast.Node.string(text=view_of_text("a\\\"b"), span=ast.zero_span())) == "\"a\\\"b\"" and printer.render_node(ast.Node.string(text=view_of_text("VIN"), span=ast.zero_span())) == "\"VIN\""
