module tests.tokenizer_test

# Guest tests for sexpr.tokenizer, mirroring the tricky cases in
# eda/src/sexpr/tokenizer.zig's `test` blocks: SI scales, mm vs mil, atoms that
# merely start with digits, `m`/`mm`/`mil` boundaries, comments, unterminated
# strings, unexpected characters, and line/col spans.

import sexpr.tokenizer as tk


def text_at(tokens: list[tk.Token], index: int) -> str:
    return tokens[index].text


def kind_at(tokens: list[tk.Token], index: int) -> tk.Kind:
    return tokens[index].kind


def token_count(src: bytes) -> int:
    match tk.tokenize(src):
        case Ok(tokens):
            return len(tokens)
        case Err(_):
            return -1


def raw_next(lx: mut tk.Lexer) -> tk.RawToken:
    match tk.next_raw(mut lx):
        case Ok(token):
            return token
        case Err(_):
            span = tk.SpanToken(start=0, end=0, span=tk.span_at(b"", 0))
            return tk.RawToken(kind=tk.Kind.eof, source=span, text_start=0, text_end=0)


public def test_parens_atoms_string() -> bool:
    match tk.tokenize(b"(footprint \"QFN9\" pad-1)"):
        case Ok(tokens):
            return len(tokens) == 6 and kind_at(tokens, 0) == tk.Kind.lparen and text_at(tokens, 1) == "footprint" and kind_at(tokens, 2) == tk.Kind.string and text_at(tokens, 2) == "QFN9" and text_at(tokens, 3) == "pad-1" and kind_at(tokens, 4) == tk.Kind.rparen and kind_at(tokens, 5) == tk.Kind.eof
        case Err(_):
            return False


# A raw slice between the quotes: escapes are left intact, as in Zig.
public def test_string_keeps_escapes() -> bool:
    match tk.tokenize(b"\"a\\\"b\""):
        case Ok(tokens):
            return text_at(tokens, 0) == "a\\\"b" and kind_at(tokens, 0) == tk.Kind.string
        case Err(_):
            return False


# SI scales: the token text keeps the verbatim suffix for the parser.
public def test_si_scales() -> bool:
    match tk.tokenize(b"220k 100nF 3.3V 10mA 10%"):
        case Ok(tokens):
            return kind_at(tokens, 0) == tk.Kind.si_val and text_at(tokens, 0) == "220k" and kind_at(tokens, 1) == tk.Kind.si_val and text_at(tokens, 1) == "100nF" and kind_at(tokens, 2) == tk.Kind.si_val and text_at(tokens, 2) == "3.3V" and kind_at(tokens, 3) == tk.Kind.si_val and text_at(tokens, 3) == "10mA" and kind_at(tokens, 4) == tk.Kind.si_val and text_at(tokens, 4) == "10%"
        case Err(_):
            return False


# Bare `m` is not a scale; k/M/G/u/n/p are.
public def test_si_bare_scales() -> bool:
    match tk.tokenize(b"4.7M 1G 10u 100n 22p 10R 1uH 0.5A"):
        case Ok(tokens):
            return kind_at(tokens, 0) == tk.Kind.si_val and text_at(tokens, 0) == "4.7M" and text_at(tokens, 1) == "1G" and text_at(tokens, 2) == "10u" and text_at(tokens, 3) == "100n" and text_at(tokens, 4) == "22p" and text_at(tokens, 5) == "10R" and text_at(tokens, 6) == "1uH" and text_at(tokens, 7) == "0.5A"
        case Err(_):
            return False


# mm and mil lex as unit_val with the suffix stripped from the text.
public def test_mm_and_mil() -> bool:
    match tk.tokenize(b"1.0mm 10mil"):
        case Ok(tokens):
            return kind_at(tokens, 0) == tk.Kind.unit_val and text_at(tokens, 0) == "1.0" and kind_at(tokens, 1) == tk.Kind.unit_val and text_at(tokens, 1) == "10"
        case Err(_):
            return False


# Bare `3m` is an atom; `mm` and `mil` alone are atoms; a longer identifier that
# merely starts with a scaled number falls back to an atom.
public def test_bare_m_and_atom_fallbacks() -> bool:
    match tk.tokenize(b"3m mm mil 100kHz 5V3 204928-0301.stp 12.5abc"):
        case Ok(tokens):
            return kind_at(tokens, 0) == tk.Kind.atom and text_at(tokens, 0) == "3m" and text_at(tokens, 1) == "mm" and text_at(tokens, 2) == "mil" and kind_at(tokens, 3) == tk.Kind.atom and text_at(tokens, 3) == "100kHz" and text_at(tokens, 4) == "5V3" and kind_at(tokens, 5) == tk.Kind.atom and text_at(tokens, 5) == "204928-0301.stp" and kind_at(tokens, 6) == tk.Kind.atom and text_at(tokens, 6) == "12.5abc"
        case Err(_):
            return False


# Plain ints/floats, including a negative int, keep their own kinds.
public def test_plain_numbers() -> bool:
    match tk.tokenize(b"42 3.3 -5"):
        case Ok(tokens):
            return kind_at(tokens, 0) == tk.Kind.int_val and text_at(tokens, 0) == "42" and kind_at(tokens, 1) == tk.Kind.float_val and text_at(tokens, 1) == "3.3" and kind_at(tokens, 2) == tk.Kind.int_val and text_at(tokens, 2) == "-5"
        case Err(_):
            return False


# A standalone `%` is an operator atom; `%`-closed literals are si_val.
public def test_percent_literal_vs_operator() -> bool:
    match tk.tokenize(b"(tolerance 10% 0.1%) (% a b)"):
        case Ok(tokens):
            return kind_at(tokens, 2) == tk.Kind.si_val and text_at(tokens, 2) == "10%" and text_at(tokens, 3) == "0.1%" and kind_at(tokens, 6) == tk.Kind.atom and text_at(tokens, 6) == "%" and text_at(tokens, 7) == "a"
        case Err(_):
            return False


public def test_operators() -> bool:
    match tk.tokenize(b"(+ a (* b c)) >= <= == !="):
        case Ok(tokens):
            return kind_at(tokens, 1) == tk.Kind.atom and text_at(tokens, 1) == "+" and text_at(tokens, 4) == "*" and text_at(tokens, 9) == ">=" and text_at(tokens, 10) == "<=" and text_at(tokens, 11) == "==" and text_at(tokens, 12) == "!="
        case Err(_):
            return False


public def test_comments() -> bool:
    match tk.tokenize(b"; comment\n(hello) ; trailing"):
        case Ok(tokens):
            return kind_at(tokens, 0) == tk.Kind.lparen and text_at(tokens, 1) == "hello" and kind_at(tokens, 2) == tk.Kind.rparen and kind_at(tokens, 3) == tk.Kind.eof
        case Err(_):
            return False


public def test_unterminated_string() -> bool:
    match tk.tokenize(b"(a \"oops"):
        case Ok(_):
            return False
        case Err(problem):
            return problem.message == "unterminated string" and problem.line == 1 and problem.offset == 3


public def test_unexpected_character() -> bool:
    match tk.tokenize(b"ab ?"):
        case Ok(_):
            return False
        case Err(problem):
            return problem.message == "unexpected character" and problem.line == 1 and problem.offset == 3


# `b` sits on line 2 at col 3; spans use 1-based lines/cols and byte offsets.
public def test_span_line_and_col() -> bool:
    match tk.tokenize(b"(a\n  b)"):
        case Ok(tokens):
            return tokens[0].span.line == 1u32 and tokens[0].span.col == 1u32 and tokens[1].span.line == 1u32 and tokens[1].span.col == 2u32 and tokens[2].span.line == 2u32 and tokens[2].span.col == 3u32 and tokens[2].span.offset == 5u32 and text_at(tokens, 2) == "b"
        case Err(_):
            return False


# The empty source still yields exactly one eof token spanning the end.
public def test_empty_source() -> bool:
    match tk.tokenize(b""):
        case Ok(tokens):
            return len(tokens) == 1 and kind_at(tokens, 0) == tk.Kind.eof and text_at(tokens, 0) == ""
        case Err(_):
            return False


public def test_token_count_helper() -> bool:
    return token_count(b"(a b)") == 5 and token_count(b"(a \"unterminated") == -1


public def test_streaming_ranges_and_lazy_materialization() -> bool:
    src = b"(10mil \"x\")"
    lx = tk.lexer(src)
    opening = raw_next(mut lx)
    measure = raw_next(mut lx)
    string = raw_next(mut lx)
    return opening.kind == tk.Kind.lparen and opening.source.start == 0 and opening.source.end == 1 and measure.kind == tk.Kind.unit_val and measure.source.start == 1 and measure.source.end == 6 and measure.text_start == 1 and measure.text_end == 3 and tk.materialize(src, measure).text == "10" and string.source.start == 7 and string.source.end == 10 and tk.materialize(src, string).text == "x"


# Offsets are bytes while line/column advance once per source byte, preserving
# the tokenizer's established Unicode diagnostic convention.
public def test_streaming_unicode_byte_range() -> bool:
    src = "é".encode() + b" atom"
    lx = tk.lexer(src)
    match tk.next_raw(mut lx):
        case Ok(_):
            return False
        case Err(problem):
            return problem.offset == 0 and problem.line == 1 and tk.span_at(src, 2).col == 3u32


def unterminated_at(src: bytes, offset: int) -> bool:
    match tk.tokenize(src):
        case Ok(_):
            return False
        case Err(problem):
            return problem.message == "unterminated string" and problem.offset == offset and problem.line == 1


# The streaming cursor must be left just past each token, at the line/column
# the following token's span reports — the scanner's state crosses the Lexer
# object only at token boundaries, so this pins where those boundaries are.
public def test_streaming_cursor_after_each_token() -> bool:
    src = b"(10mil\n  b)"
    lx = tk.lexer(src)
    opening = raw_next(mut lx)
    after_opening = lx.cursor[0] == 1 and lx.cursor[1] == 1 and lx.cursor[2] == 2
    measure = raw_next(mut lx)
    after_measure = lx.cursor[0] == 6 and lx.cursor[1] == 1 and lx.cursor[2] == 7
    letter = raw_next(mut lx)
    after_letter = lx.cursor[0] == 10 and lx.cursor[1] == 2 and lx.cursor[2] == 4
    closing = raw_next(mut lx)
    after_closing = lx.cursor[0] == 11 and lx.cursor[1] == 2 and lx.cursor[2] == 5
    last = raw_next(mut lx)
    return opening.source.start == 0 and opening.source.end == 1 and after_opening and measure.kind == tk.Kind.unit_val and measure.source.start == 1 and measure.source.end == 6 and after_measure and letter.source.span.line == 2u32 and letter.source.span.col == 3u32 and letter.source.span.offset == 9u32 and after_letter and closing.kind == tk.Kind.rparen and closing.source.span.offset == 10u32 and after_closing and last.kind == tk.Kind.eof and last.source.span.offset == 11u32 and lx.cursor[0] == 11 and lx.cursor[1] == 2 and lx.cursor[2] == 5


# A `\` at the end of the source swallows the end and leaves the string open;
# the error still points at the opening quote, and the past-the-end advance is
# a no-op exactly as before.
public def test_unterminated_at_end_after_escape() -> bool:
    return unterminated_at(b"\"\\", 0) and unterminated_at(b"\"ab\\", 0) and unterminated_at(b"\"a\\\"", 0) and unterminated_at(b"\"", 0)


# A comment that reaches the end of input without a newline ends at the cursor
# the eof token reports.
public def test_comment_terminated_by_end_of_input() -> bool:
    match tk.tokenize(b"(a) ; trailing"):
        case Ok(tokens):
            return len(tokens) == 4 and kind_at(tokens, 3) == tk.Kind.eof and tokens[3].span.offset == 14u32 and tokens[3].span.line == 1u32 and tokens[3].span.col == 15u32
        case Err(_):
            return False


# `\r` is ordinary whitespace and only `\n` starts a line, so CRLF and bare LF
# both advance the line once; four newlines put `d` on line 5.
public def test_crlf_and_lf_line_col() -> bool:
    match tk.tokenize(b"a\r\nb\nc\r\n\r\nd"):
        case Ok(tokens):
            return len(tokens) == 5 and tokens[0].span.line == 1u32 and tokens[0].span.col == 1u32 and tokens[1].span.line == 2u32 and tokens[1].span.col == 1u32 and tokens[1].span.offset == 3u32 and tokens[2].span.line == 3u32 and tokens[2].span.col == 1u32 and tokens[2].span.offset == 5u32 and tokens[3].span.line == 5u32 and tokens[3].span.col == 1u32 and tokens[3].span.offset == 10u32 and tokens[4].span.line == 5u32 and tokens[4].span.col == 2u32 and tokens[4].span.offset == 11u32
        case Err(_):
            return False


# Two whole comment lines are skipped before `value`, which sits on line 3.
public def test_token_after_multiline_comment() -> bool:
    match tk.tokenize(b"; one\n; two\nvalue"):
        case Ok(tokens):
            return len(tokens) == 2 and text_at(tokens, 0) == "value" and tokens[0].span.line == 3u32 and tokens[0].span.col == 1u32 and tokens[0].span.offset == 12u32 and kind_at(tokens, 1) == tk.Kind.eof and tokens[1].span.line == 3u32 and tokens[1].span.col == 6u32 and tokens[1].span.offset == 17u32
        case Err(_):
            return False


# A literal newline *inside* a string still moves the cursor to line 2, so the
# token after the closing quote is located on that line.
public def test_multiline_string_line_col() -> bool:
    match tk.tokenize(b"\"a\nb\" c"):
        case Ok(tokens):
            return len(tokens) == 3 and kind_at(tokens, 0) == tk.Kind.string and text_at(tokens, 0) == "a\nb" and tokens[0].span.line == 1u32 and tokens[0].span.col == 1u32 and tokens[0].span.offset == 0u32 and text_at(tokens, 1) == "c" and tokens[1].span.line == 2u32 and tokens[1].span.col == 4u32 and tokens[1].span.offset == 6u32 and tokens[2].span.offset == 7u32
        case Err(_):
            return False


# The string body keeps both escapes verbatim: `a\"b\\c` between the quotes.
public def test_escaped_quote_and_backslash_in_string() -> bool:
    src = b"\"a\\\"b\\\\c\""
    match tk.tokenize(src):
        case Ok(tokens):
            return len(tokens) == 2 and kind_at(tokens, 0) == tk.Kind.string and text_at(tokens, 0) == "a\\\"b\\\\c" and tokens[0].span.offset == 0u32 and tokens[0].span.col == 1u32 and tokens[1].span.offset == 9u32
        case Err(_):
            return False


# One token per classification: mm/mil strip the suffix, an SI scale or unit
# letter keeps it, `%` ends a literal only when nothing atom-like follows, and
# a longer identifier falls back to an atom.
public def test_suffix_classification() -> bool:
    match tk.tokenize(b"1mm 1mil 1mA 1M 1k 1V 10% 10mils 3m"):
        case Ok(tokens):
            return kind_at(tokens, 0) == tk.Kind.unit_val and text_at(tokens, 0) == "1" and kind_at(tokens, 1) == tk.Kind.unit_val and text_at(tokens, 1) == "1" and kind_at(tokens, 2) == tk.Kind.si_val and text_at(tokens, 2) == "1mA" and kind_at(tokens, 3) == tk.Kind.si_val and text_at(tokens, 3) == "1M" and kind_at(tokens, 4) == tk.Kind.si_val and text_at(tokens, 4) == "1k" and kind_at(tokens, 5) == tk.Kind.si_val and text_at(tokens, 5) == "1V" and kind_at(tokens, 6) == tk.Kind.si_val and text_at(tokens, 6) == "10%" and kind_at(tokens, 7) == tk.Kind.atom and text_at(tokens, 7) == "10mils" and kind_at(tokens, 8) == tk.Kind.atom and text_at(tokens, 8) == "3m"
        case Err(_):
            return False


# ── Run-scanned string bodies and comments ─────────────────────────────────
# The body and comment scans advance a whole run at a time and update the column
# once per run. These cases pin the boundaries a run scan can get wrong: a run
# that reaches the last byte of input, an escape that immediately precedes the
# closing quote, a long ordinary run, and the line/column a token after a
# multi-line body reports.


# The body holds a literal newline and an escape and the closing quote is the
# very last byte of input, so the run scan must stop exactly there and leave
# the cursor past it.
public def test_string_closes_on_last_input_byte() -> bool:
    src = b"\"a\nb\\\"c\""
    match tk.tokenize(src):
        case Ok(tokens):
            return len(tokens) == 2 and kind_at(tokens, 0) == tk.Kind.string and text_at(tokens, 0) == "a\nb\\\"c" and tokens[0].span.line == 1u32 and tokens[0].span.col == 1u32 and tokens[0].span.offset == 0u32 and tokens[1].kind == tk.Kind.eof and tokens[1].span.offset == 8u32 and tokens[1].span.line == 2u32 and tokens[1].span.col == 6u32
        case Err(_):
            return False


# `\"` and `\\` sit immediately before the closing quote: the run scan must let
# the escaped quote pass and stop on the final unescaped one.
public def test_escapes_immediately_before_closing_quote() -> bool:
    src = b"\"x\\\"\\\\\""
    match tk.tokenize(src):
        case Ok(tokens):
            return len(tokens) == 2 and kind_at(tokens, 0) == tk.Kind.string and text_at(tokens, 0) == "x\\\"\\\\" and tokens[0].span.offset == 0u32 and tokens[0].span.col == 1u32 and tokens[1].kind == tk.Kind.eof and tokens[1].span.offset == 7u32 and tokens[1].span.col == 8u32
        case Err(_):
            return False


# Fifty ordinary bytes, repeated four times, ahead of the closing quote: one
# 200-byte run, one column update, then the cursor just past the quote.
def ordinary_200() -> bytes:
    pad = b"0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMN"
    return pad + pad + pad + pad


public def test_two_hundred_byte_run_before_quote() -> bool:
    src = b"\"" + ordinary_200() + b"\""
    lx = tk.lexer(src)
    token = raw_next(mut lx)
    return token.kind == tk.Kind.string and token.source.start == 0 and token.source.end == 202 and token.text_start == 1 and token.text_end == 201 and len(tk.materialize(src, token).text) == 200 and lx.cursor[0] == 202 and lx.cursor[1] == 1 and lx.cursor[2] == 203


# Every punctuation byte `is_atom_continue` accepts, in one atom, so a scan
# that stopped at any one of them would split the token.
public def test_atom_with_every_continue_byte() -> bool:
    src = b"aA0-_/.*#@:+,$~"
    match tk.tokenize(src):
        case Ok(tokens):
            return len(tokens) == 2 and kind_at(tokens, 0) == tk.Kind.atom and text_at(tokens, 0) == "aA0-_/.*#@:+,$~" and tokens[0].span.offset == 0u32 and tokens[0].span.col == 1u32 and tokens[1].kind == tk.Kind.eof and tokens[1].span.offset == 15u32 and tokens[1].span.col == 16u32
        case Err(_):
            return False


# An atom ends exactly where `(` begins: the atom's exclusive end is the
# paren's offset, and the paren reports the next column.
public def test_atom_stops_at_lparen() -> bool:
    src = b"abc(def)"
    lx = tk.lexer(src)
    word = raw_next(mut lx)
    after_word = lx.cursor[0] == 3 and lx.cursor[1] == 1 and lx.cursor[2] == 4
    opening = raw_next(mut lx)
    return word.kind == tk.Kind.atom and word.source.start == 0 and word.source.end == 3 and word.text_start == 0 and word.text_end == 3 and after_word and opening.kind == tk.Kind.lparen and opening.source.span.offset == 3u32 and opening.source.span.col == 4u32


# A comment that reaches the end of input without a newline ends the file: the
# eof token sits past the last comment byte on the line the comment started on.
public def test_comment_to_end_of_input_after_line() -> bool:
    match tk.tokenize(b"(a\n; tail"):
        case Ok(tokens):
            return len(tokens) == 3 and kind_at(tokens, 0) == tk.Kind.lparen and text_at(tokens, 1) == "a" and kind_at(tokens, 2) == tk.Kind.eof and tokens[2].span.offset == 9u32 and tokens[2].span.line == 2u32 and tokens[2].span.col == 7u32
        case Err(_):
            return False


# Two strings separated by a comment: the comment consumes its own line, and
# the second string's span starts on the next line at column 1.
public def test_two_strings_separated_by_comment() -> bool:
    src = b"\"one\" ; note\n\"two\""
    match tk.tokenize(src):
        case Ok(tokens):
            return len(tokens) == 3 and text_at(tokens, 0) == "one" and tokens[0].span.line == 1u32 and tokens[0].span.col == 1u32 and text_at(tokens, 1) == "two" and tokens[1].span.line == 2u32 and tokens[1].span.col == 1u32 and tokens[1].span.offset == 13u32 and tokens[2].kind == tk.Kind.eof and tokens[2].span.offset == 18u32 and tokens[2].span.col == 6u32
        case Err(_):
            return False


# Two strings on one line, back to back: the second starts one blank after the
# first ends.
public def test_two_strings_on_one_line() -> bool:
    match tk.tokenize(b"\"a\" \"b\""):
        case Ok(tokens):
            return len(tokens) == 3 and text_at(tokens, 0) == "a" and tokens[0].span.col == 1u32 and text_at(tokens, 1) == "b" and tokens[1].span.col == 5u32 and tokens[1].span.offset == 4u32 and tokens[2].span.offset == 7u32
        case Err(_):
            return False


# The token after a body with two literal newlines and one escaped newline must
# still report the line and column the per-byte advance produced: the escaped
# newline moves to line 4 exactly like a literal one.
public def test_token_after_escaped_newline_string() -> bool:
    src = b"\"a\nb\nc\\\nd\" tail"
    match tk.tokenize(src):
        case Ok(tokens):
            return len(tokens) == 3 and kind_at(tokens, 0) == tk.Kind.string and text_at(tokens, 0) == "a\nb\nc\\\nd" and tokens[0].span.line == 1u32 and tokens[0].span.col == 1u32 and text_at(tokens, 1) == "tail" and tokens[1].span.line == 4u32 and tokens[1].span.col == 4u32 and tokens[1].span.offset == 11u32 and tokens[2].span.offset == 15u32 and tokens[2].span.line == 4u32 and tokens[2].span.col == 8u32
        case Err(_):
            return False


# A run of blanks and carriage returns leaves the column just past the run,
# with the tab and the `\r` counted as one column each.
public def test_blank_run_column() -> bool:
    match tk.tokenize(b"  \t \r a"):
        case Ok(tokens):
            return len(tokens) == 2 and text_at(tokens, 0) == "a" and tokens[0].span.col == 7u32 and tokens[0].span.offset == 6u32 and tokens[1].span.offset == 7u32 and tokens[1].span.col == 8u32
        case Err(_):
            return False


# A body that ends in an ordinary run leaves the cursor at the end of input,
# where the per-byte loop left it: `line` counted and `col` past the last byte.
public def test_unterminated_cursor_after_ordinary_run() -> bool:
    src = b"\"ab\ncd"
    lx = tk.lexer(src)
    match tk.next_raw(mut lx):
        case Ok(_):
            return False
        case Err(problem):
            return problem.message == "unterminated string" and problem.offset == 0 and problem.line == 1 and lx.cursor[0] == 6 and lx.cursor[1] == 2 and lx.cursor[2] == 3
