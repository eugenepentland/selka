
# sexpr-port CLI: parse an S-expression file and summarise it.
#
#   mylang run experiments/sexpr-port/main.my -- <file.sexp> [--render]
#
# The default output is one statistics line with the same field names as
# experiments/sexpr-port/reference_parse.py, which `compare.py` diffs against
# an independent reader. `--render` prints the canonical single-line form
# instead. Exit status: 0 ok, 1 parse error, 2 usage or I/O error.

import sexpr.ast as ast
import sexpr.parser as parser
import sexpr.printer as printer


record Tally:
    forms: int
    nodes: int
    atoms: int
    strings: int
    ints: int
    floats: int
    measures: int
    depth: int
    values: float


func tally(counts: Tally, node: ast.Node, depth: int) -> Tally:
    mut updated = counts
    updated.nodes = updated.nodes + 1
    if depth > updated.depth:
        updated.depth = depth
    match node:
        case ast.Node.atom(text=_, span=_):
            updated.atoms = updated.atoms + 1
        case ast.Node.string(text=_, span=_):
            updated.strings = updated.strings + 1
        case ast.Node.integer(value=value, span=_):
            updated.ints = updated.ints + 1
            updated.values = updated.values + float(value)
        case ast.Node.decimal(value=value, span=_, literal=_):
            updated.floats = updated.floats + 1
            updated.values = updated.values + value
        case ast.Node.measure(value=value, span=_):
            updated.measures = updated.measures + 1
            updated.values = updated.values + value
        case ast.Node.form(items=entries, span=_):
            updated.forms = updated.forms + 1
            for child in entries:
                updated = tally(updated, child, depth + 1)

    return updated

func summarise(nodes: ast.Node[]) -> str:
    mut counts = Tally(forms=0, nodes=0, atoms=0, strings=0, ints=0, floats=0, measures=0, depth=0, values=0.0)
    for node in nodes:
        counts = tally(counts, node, 0)
    return f"forms={counts.forms} nodes={counts.nodes} atoms={counts.atoms} strings={counts.strings} ints={counts.ints} floats={counts.floats} measures={counts.measures} max_depth={counts.depth} value_sum={counts.values}"


func render_to(out: Stream, nodes: ast.Node[]) -> bool:
    # `render_bytes` already produced one canonical byte snapshot, so writing it
    # with a terminating newline avoids decoding those bytes to scalars and
    # re-encoding them for `print`. The written bytes are identical, including
    # the single trailing '\n' that `print` adds.
    mut written = out.write(printer.render_bytes(nodes))
    return written >= 0 and out.write(b"\n") == 1


func main(args: str[], fs: Filesystem, out: Stream, err: Stream) -> int:
    if len(args) == 0:
        err.print("usage: main <file.sexp> [--render]")
        return 2
    mut path = args[0]
    mut render_only = len(args) > 1 and args[1] == "--render"
    mut source = b""
    match read_file(fs, path):
        case Ok(data):
            source = data
        case Err(problem):
            err.print("read failed:", problem)
            return 2
    match parser.parse(source):
        case Ok(nodes):
            if render_only:
                if not render_to(out, nodes):
                    return 2
            else:
                out.print(summarise(nodes))
            return 0
        case Err(problem):
            err.print(f"parse error: {problem.message} at {problem.line}:{problem.col}")
            return 1
