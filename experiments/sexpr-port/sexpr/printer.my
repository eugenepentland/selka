# Pretty-printer for the S-expression AST: renders a tree back to canonical
# source text, the inverse of sexpr.parser, ported from
# eda/src/sexpr/printer.zig (426 lines).
#
# Ported faithfully:
#   * top-level nodes are separated by exactly one '\n', with no trailing
#     newline (Zig's `print`; this replaced the old one-space join).
#   * an empty list prints "()".
#   * `short_list_max_width` (72): a list whose direct children are all
#     measurable and whose estimated width is <= 72 prints on one line.
#   * otherwise the list prints "(" + first child, then one child per line,
#     each preceded by '\n' and `indent + 2` spaces, then ")". Indentation
#     accumulates through nesting exactly as Zig's `writeIndent` does.
#   * `estimateWidth`'s measure, including its `depth > 3` cutoff: a child
#     nested four levels below the point being measured makes the estimate
#     unknowable, which forces the multi-line layout even when the text fits.
#     The depth is counted from each `isShortList` call, so a deeply nested
#     child of a multi-line list is re-measured from depth 0 and may still be
#     short (see tests/fixtures `(nested (a (b (c (d)))))`).
#   * the number rendering (Zig's `printFloat`): the shortest round-trip
#     decimal, with ".0" appended to a whole value whose spelling has no
#     '.', 'e' or 'n'. mylang's `str(float)` already does this, and the guard
#     is kept so the port does not depend on that staying true.
#   * a string node is bracketed verbatim. The tokenizer kept the raw source
#     slice between the quotes (escapes intact) and the parser did not
#     unescape it, so printing it verbatim round-trips; re-escaping would
#     double `\"` to `\\\"` and break the parse -> print -> parse fixed point.
#   * a measure node prints its normalised millimetre value followed by "mm",
#     exactly like Zig's `.unit_val` branch (so `10mil` prints `0.254mm`).
#
# AST details relative to printer.zig (see CONTRACT.md):
#   * decimal nodes retain an optional source literal, so suffixes such as
#     `100nF`, `4.7k` and `10%` preserve both their spelling and measured width.
#     Literal-less decimals use the formatted value exactly as Zig does.
#   * spans are retained for diagnostics but printing does not consult them.
#   * printer.zig imports `../infra/fs.zig` only to feed a file-writing helper
#     that is not part of `print`; the guest library has no filesystem, so
#     that helper and the import are omitted entirely.
#   * Zig appends into an allocating writer, so its output bytes are produced
#     once. This port builds the same bytes in a byte builder and decodes them
#     once for the `str` entry points, rather than joining a list of one
#     decoded string per leaf and then re-encoding the join.
#
# Two Zig tests are not reproducible as guest tests: the corpus walk over
# `projects/designs` (no filesystem or directory walk in the guest runtime)
# and the `std.testing.Smith` fuzz harness (no fuzzer). tests/printer_test.my
# transcribes every other expectation with the same inputs.
import sexpr.ast as ast
import sexpr.view as view
import byte_builder

# ── Constants (mirrored from printer.zig) ─────────────────────────────
# Zig formats an integer into a 24-byte buffer and falls back to this width
# when that fails. Every i64 spelling fits, so the fallback is unreachable.
const fallback_int_width: int = 12


# The same guard for a float formatted into a 64-byte buffer, and for a unit
# value. Both are unreachable here because `str` cannot fail.
const fallback_float_width: int = 12


const fallback_unit_val_width: int = 14


# A list at or below this estimated width prints on one line.
const short_list_max_width: int = 72


# ── Width measurement (Zig's estimateWidth / isShortList) ─────────────
# The length of `text`, or `fallback` when there is no text at all. This is
# the mylang analogue of Zig's `bufPrint(...) catch fallback_*_width`: `str`
# never fails, so only an empty spelling reaches the guard.
func measured_width(text: str, fallback: int) -> int:
    if len(text) == 0:
        return fallback
    return len(text)


# Zig's estimateWidth for `.int`: the length of the `{d}` spelling.
func int_width(value: int) -> int:
    return measured_width(str(value), fallback_int_width)


# Zig's estimateWidth for `.float`. Zig prefers `node.literal.len` when the
# node carries a source spelling and otherwise formats `{d}` and takes its
# length; the literal is absent from this AST, so the literal-less branch is
# the reachable one. `str` appends ".0" to a whole value, and Zig's raw `{d}`
# does not, so that suffix is stripped back off before measuring.
func decimal_width(value: float) -> int:
    mut text = str(value)
    if text.endswith(".0"):
        return measured_width(text[0:len(text) - 2], fallback_float_width)
    return measured_width(text, fallback_float_width)


# Zig's estimateWidth for a suffixed literal: the length of the source
# spelling, which is what the printer writes back.
func literal_width(literal: view.View) -> int:
    return measured_width(text_of(literal), fallback_float_width)


# Zig's estimateWidth for `.unit_val`: the `{d}` length plus 2 for "mm".
func measure_width(value: float) -> int:
    mut text = str(value)
    if text.endswith(".0"):
        return measured_width(text[0:len(text) - 2], fallback_unit_val_width) + 2
    return measured_width(text, fallback_unit_val_width) + 2


# The scalar string a view spells. A view whose bytes are not UTF-8 cannot come
# from the parser (source is decoded UTF-8 at the boundary), so the empty
# spelling is the only reachable fallback and it keeps measurement total.
func text_of(found: view.View) -> str:
    match view.text_of(found):
        case Ok(text):
            return text
        case Err(_):
            return ""


# The number of Unicode scalars the covered range spells, counted where the
# octets already are. The range is validated and measured in one pass, so
# measuring an atom no longer decodes it into a fresh string first. A view whose
# bytes are not UTF-8 cannot come from the parser (source is decoded UTF-8 at the
# boundary), so the empty count is the only reachable fallback and it keeps
# measurement total, exactly as the empty spelling did.
func scalar_len(found: view.View) -> int:
    match found.source.scalar_count_range(found.start, found.end):
        case Ok(count):
            return count
        case Err(_):
            return 0


# A measured width, or None when Zig's estimate gives up: past four levels of
# nesting (`depth > 3`) the measure is unknown, and one unknown child makes its
# whole parent unknown. Mirrors `estimateWidth(node, depth)`; the `depth` of a
# direct child of the list being measured is 0.
func estimate_width(node: ast.Node, depth: int) -> int?:
    if depth > 3:
        return None
    match node:
        case ast.Node.form(items=entries, span=_):
            mut total = 2
            mut index = 0
            while index < len(entries):
                if index > 0:
                    total = total + 1
                match estimate_width(entries[index], depth + 1):
                    case Some(width):
                        total = total + width
                    case None:
                        return None
                index = index + 1
            return Some(total)
        case ast.Node.atom(text=text, span=_):
            return Some(scalar_len(text))
        case ast.Node.string(text=content, span=_):
            return Some(scalar_len(content) + 2)
        case ast.Node.integer(value=value, span=_):
            return Some(int_width(value))
        case ast.Node.decimal(value=value, span=_, literal=literal):
            match literal:
                case Some(text):
                    return Some(literal_width(text))
                case None:
                    return Some(decimal_width(value))
        case ast.Node.measure(value=value, span=_):
            return Some(measure_width(value))


# Whether every child can be measured and the running total stays at or below
# `short_list_max_width`. The total is checked after each child, as in Zig, so
# a long list stops measuring early.
func is_short_list(entries: ast.Node[]) -> bool:
    mut total = 2
    mut index = 0
    while index < len(entries):
        if index > 0:
            total = total + 1
        match estimate_width(entries[index], 0):
            case Some(width):
                total = total + width
            case None:
                return False
        if total > short_list_max_width:
            return False
        index = index + 1
    return True


# ── Rendering (Zig's printNode) ───────────────────────────────────────
# The text of a number: Zig's printFloat, i.e. the shortest round-trip
# decimal plus ".0" when the spelling has no '.', 'e' or 'n' (so a whole
# value keeps its float/int distinction and nan/inf gain no ".0").
func render_float(value: float) -> str:
    mut text = str(value)
    if text.find(".") == -1 and text.find("e") == -1 and text.find("n") == -1:
        return text + ".0"
    return text


# Append the canonical bytes of `node` at the given indentation. Mirrors
# `printNode(writer, node, indent)`: `indent` is where this node's children
# would be indented if it lays out over several lines. One traversal serves
# both entry points, so the layout cannot drift between them.
func push_node(mut out: byte_builder.Builder, node: ast.Node, indent: int):

    match node:
        case ast.Node.form(items=entries, span=_):
            if len(entries) == 0:
                byte_builder.append(mut out, b"()")
                return
            byte_builder.append(mut out, b"(")
            if is_short_list(entries):
                # Short enough (and shallow enough) for one line. The estimate
                # already measured every child, at exactly the indices the
                # recursion below will occupy.
                mut index = 0
                while index < len(entries):
                    if index > 0:
                        byte_builder.append(mut out, b" ")
                    push_node(mut out, entries[index], indent + 2)
                    index += 1
            else:
                # Too wide or too deep: the first child stays on the "(" line
                # and every later child starts an indented line of its own.
                push_node(mut out, entries[0], indent + 2)
                mut index = 1
                while index < len(entries):
                    byte_builder.append(mut out, b"\n")
                    _ = byte_builder.append_spaces(mut out, indent + 2)
                    push_node(mut out, entries[index], indent + 2)
                    index += 1
            byte_builder.append(mut out, b")")
            return
        case ast.Node.atom(text=text, span=_):
            append_view(mut out, text)
            return
        case ast.Node.string(text=content, span=_):
            byte_builder.append(mut out, b"\"")
            append_view(mut out, content)
            byte_builder.append(mut out, b"\"")
            return
        case ast.Node.integer(value=value, span=_):
            byte_builder.append_int(mut out, value)
            return
        case ast.Node.decimal(value=value, span=_, literal=literal):
            # A suffixed literal prints as it was written; re-deriving the text
            # from the f64 would rewrite `100nF` as `0.0000001`.
            match literal:
                case Some(text):
                    append_view(mut out, text)
                case None:
                    append_float(mut out, value)
            return
        case ast.Node.measure(value=value, span=_):
            append_float(mut out, value)
            byte_builder.append(mut out, b"mm")
            return


# Append the bytes a view covers. The source range goes in as it stands, so an
# atom's spelling is never widened to Unicode scalars and encoded back, and the
# copy is a bulk range append rather than a per-octet loop.
func append_view(mut out: byte_builder.Builder, found: view.View):

    _ = byte_builder.append_range(mut out, found.source, found.start, found.end)


# Append a float the way Zig's printFloat writes it: the shortest round-trip
# decimal, with ".0" appended to a whole value whose spelling has none. The
# finishing '.'/'e'/'n' test is what keeps a whole value's float spelling
# distinct from an integer reading, so it is applied after formatting.
func append_float(mut out: byte_builder.Builder, value: float):

    mut data = render_float(value).encode()
    _ = byte_builder.append_range(mut out, data, 0, len(data))


# Canonical bytes for a single node, laid out at indent 0.
public func render_node_bytes(node: ast.Node) -> bytes:
    mut out = byte_builder.create()
    push_node(mut out, node, 0)
    return byte_builder.finish(out)


# Canonical text for a single node, laid out at indent 0.
public func render_node(node: ast.Node) -> str:
    return decode(render_node_bytes(node))


# Canonical bytes for a whole document: top-level nodes separated by exactly
# one '\n', no trailing newline. An empty node list renders to b"".
public func render_bytes(nodes: ast.Node[]) -> bytes:
    mut out = byte_builder.create()
    mut index = 0
    while index < len(nodes):
        if index > 0:
            byte_builder.append(mut out, b"\n")
        push_node(mut out, nodes[index], 0)
        index += 1
    return byte_builder.finish(out)


# Canonical text for a whole document. The bytes are produced once and decoded
# once, instead of being assembled as one scalar string per leaf and joined.
public func render(nodes: ast.Node[]) -> str:
    return decode(render_bytes(nodes))


# The text of a canonical byte snapshot. The bytes were produced from valid
# UTF-8 source, so a refusal is unreachable and the empty spelling keeps the
# entry point total.
func decode(data: bytes) -> str:
    match data.decode():
        case Ok(text):
            return text
        case Err(_):
            return ""
