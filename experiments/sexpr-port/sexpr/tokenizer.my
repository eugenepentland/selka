module sexpr.tokenizer

# S-expression tokenizer: the lexer feeding sexpr.parser, ported from
# eda/src/sexpr/tokenizer.zig. Classifies atoms, strings, and numeric
# literals — including SI-scaled electrical values (`220k`, `100nF`, `3.3V`,
# `10mA`) and dimension units (`mm`/`mil`). Every token carries a source Span.
#
# Ported faithfully: `(`/`)`, `;` line comments, quoted strings with `\`
# escapes (UnterminatedString), atoms, the operator atoms `+ - * / % > < = !`
# including the two-character `>= <= == !=` forms, plain ints and floats,
# `mm`/`mil` dimension literals, SI-scaled literals for k/M/G/u/n/p (with `m`
# only when a unit letter follows, so bare `3m`, `mm` and `mil` keep their
# dimension/atom meanings), an optional single trailing unit letter V/A/F/H/R,
# and `%`-terminated literals. Also ported: the exact span/line/col bookkeeping
# and the two error kinds as LexError(message, offset, line).
#
# Deliberately omitted / adapted:
#  - `Token.text` for a `string` is the raw source between the quotes, escapes
#    intact, exactly the slice Zig's tokenizer returns (the parser does not
#    unescape it either).
#  - Zig's `si_scales` / `si_unit_letters` / `percent_sign` data tables are not
#    reproduced as data; the letters are tested directly by the `is_*` helpers.
#    Applying a multiplier is the parser's job and stays there.
#  - Zig's `error_span` also records a column; the frozen LexError carries only
#    message/offset/line, so the column is dropped.
#  - Source bytes are decoded to `str` (the frozen Token.text type); a slice
#    that is not valid UTF-8 becomes "" rather than being preserved raw.
#  - The byte loops do not touch the Lexer's cursor fields. Zig's methods read
#    and write `self.pos`/`self.line`/`self.col` because they are inlined into
#    one optimizer unit; here the Lexer is a value record with a three-element
#    mutable cursor list, so `next_raw` and the readers hold the positions in
#    locals and store the cursor back only at token boundaries.
#  - The string body and the comment tail are scanned as runs: an inner loop
#    looks for the one byte class that ends the run, and the column moves once
#    for the whole run instead of once per byte. Blanks stay per byte, because a
#    single blank between two tokens is the common case and a run loop around it
#    measured slower than the column increment it removes.
#
#    This is deliberately *not* the bulk `find` the audit note suggested. The
#    guest surface has no find-from-offset: `bytes.find` always scans its
#    receiver from index 0, and `src[pos:]` is an allocating, copying slice, so
#    "search the remaining slice" costs O(remaining) per token (quadratic over a
#    7.4 MB source) before the search itself. The search is no bargain either:
#    `myl_native_bytes_find` calls `memcmp` once per candidate position
#    (~30 instructions per byte, measured) against ~12-16 for the loop it would
#    replace, and it is worse for a three-byte class than for one. A native
#    find-from-offset or memchr-style find-any-of is the prerequisite for a real
#    bulk scan; the tests below pin everything a run scan must keep exact.

import sexpr.ast as ast


public enum Kind:
    lparen,
    rparen,
    atom,
    string,
    int_val,
    float_val,
    unit_val,
    si_val,
    eof


public record Token:
    kind: Kind
    text: str
    span: ast.Span


# Source bytes occupied by a token. `start` is inclusive and `end` exclusive;
# unlike Token.text this also includes string quotes and dimension suffixes.
public record SpanToken:
    start: int
    end: int
    span: ast.Span


# A streaming token whose spelling remains in the source. `text_start` and
# `text_end` select the spelling exposed by Token.text (inside string quotes,
# and before a consumed mm/mil suffix). This lets parsers inspect kind/span
# without allocating a string for punctuation or tokens they reject.
public record RawToken:
    kind: Kind
    source: SpanToken
    text_start: int
    text_end: int


public record LexError:
    message: str
    offset: int
    line: int


# Mirror of Zig's `Tokenizer` struct: the source plus the `pos`/`line`/`col`
# cursor used for span reporting. `mut Lexer` carries the cursor from token to
# token. The positions are read and written at token boundaries; while scanning,
# `next_raw` and the readers keep them in local variables.
public record Lexer:
    src: bytes
    cursor: list[int]


public def lexer(src: bytes) -> Lexer:
    return Lexer(src=src, cursor=[0, 1, 1])


# Reusable source-location lookup for diagnostics produced outside the normal
# forward scan (for example conversion errors). Offsets count source bytes.
public def span_at(src: bytes, offset: int) -> ast.Span:
    line = 1
    col = 1
    index = 0
    stop = offset
    if stop > len(src):
        stop = len(src)
    while index < stop:
        if src[index] == 10:
            line = line + 1
            col = 1
        else:
            col = col + 1
        index = index + 1
    return ast.Span(line=u32(line), col=u32(col), offset=u32(offset))


# A missing peek is reported as -1: bytes index to 0..255, so no real byte can
# collide with it, and every predicate below treats it as "not this character".
# `length` is passed in so a caller's local copy is reused instead of reloading
# the object header. Equivalent to Zig's `Tokenizer.peek`/`peekAt`.
def peek(src: bytes, length: int, index: int) -> int:
    if index >= length:
        return -1
    return src[index]


# Store the scan cursor back into the Lexer. Called once per token, never per
# byte: inside a token the cursor is local.
def store_cursor(lx: mut Lexer, pos: int, line: int, col: int):
    lx.cursor[0] = pos
    lx.cursor[1] = line
    lx.cursor[2] = col


def is_space(byte: int) -> bool:
    return byte == 32 or byte == 10 or byte == 13 or byte == 9


def is_digit(byte: int) -> bool:
    return byte >= 48 and byte <= 57


# Atom start, as in Zig: letters, `_`, `~`, `*`.
def is_atom_start(byte: int) -> bool:
    return (byte >= 97 and byte <= 122) or (byte >= 65 and byte <= 90) or byte == 95 or byte == 126 or byte == 42


# Atom continuation. `+`, `,` and `$` are mid-token only so vendor KiCad
# exports tokenize as one atom (`PMA3-24323LN+.stp`, `74AHCT1G125GF,132.stp`,
# `P$1`), while a leading one is still an operator.
def is_atom_continue(byte: int) -> bool:
    return is_atom_start(byte) or is_digit(byte) or byte == 45 or byte == 47 or byte == 46 or byte == 42 or byte == 35 or byte == 64 or byte == 58 or byte == 43 or byte == 44 or byte == 36


# Standalone operator characters. `*` is absent because it is an atom start.
def is_operator_char(byte: int) -> bool:
    return byte == 43 or byte == 45 or byte == 47 or byte == 37 or byte == 62 or byte == 60 or byte == 61 or byte == 33


# `si_scales` rows with `bare = true`: k M G u n p.
def is_scale_letter(byte: int) -> bool:
    return byte == ord("k") or byte == ord("M") or byte == ord("G") or byte == ord("u") or byte == ord("n") or byte == ord("p")


# `si_scales` rows with `bare = false`: today just `m`, a scale only when a
# unit letter follows (`10mA`) so bare `3m`/`mm`/`mil` keep their meanings.
def is_unit_required_scale(byte: int) -> bool:
    return byte == ord("m")


# `si_unit_letters` = "VAFHR": accepted after a scale or alone, no scale.
def is_unit_letter(byte: int) -> bool:
    return byte == ord("V") or byte == ord("A") or byte == ord("F") or byte == ord("H") or byte == ord("R")


def lexeme(src: bytes, start: int, end: int) -> str:
    match src[start:end].decode():
        case Ok(text):
            return text
        case Err(_):
            return ""


def raw(kind: Kind, start: int, end: int, text_start: int, text_end: int, line: int, col: int) -> RawToken:
    span = ast.Span(line=u32(line), col=u32(col), offset=u32(start))
    return RawToken(kind=kind, source=SpanToken(start=start, end=end, span=span), text_start=text_start, text_end=text_end)


public def materialize(src: bytes, token: RawToken) -> Token:
    return Token(kind=token.kind, text=lexeme(src, token.text_start, token.text_end), span=token.source.span)


# Length (1 or 2) of an SI value suffix starting at the cursor, or 0 for none.
#   scale letter alone:           `4.7k`, `10M`, `1n`
#   scale letter + unit letter:   `100nF`, `10mA`, `100mV`
#   unit letter alone:            `3.3V`, `0.5A`
def si_suffix_len(src: bytes, length: int, pos: int) -> int:
    c0 = peek(src, length, pos)
    if is_scale_letter(c0):
        c1 = peek(src, length, pos + 1)
        if not is_atom_continue(c1):
            return 1
        if is_unit_letter(c1) and not is_atom_continue(peek(src, length, pos + 2)):
            return 2
        return 0
    if is_unit_required_scale(c0):
        if is_unit_letter(peek(src, length, pos + 1)) and not is_atom_continue(peek(src, length, pos + 2)):
            return 2
        return 0
    if is_unit_letter(c0) and not is_atom_continue(peek(src, length, pos + 1)):
        return 1
    return 0


# Quoted string. A `\` swallows the next byte; running off the end of the source
# reports UnterminatedString at the opening quote, the most actionable location.
# A literal newline inside the string still advances line/col, exactly as Zig's
# `advance` does while scanning the body.
#
# The body is consumed in runs up to the next `"` or literal newline — the only
# two bytes whose cursor effect the scan has to see, because *every* other byte
# of the body moves the cursor exactly one column, escape or not: `\` counts one
# column and the byte it swallows counts the next, so a run of ordinary bytes and
# a run of escapes have the same column effect, and an escaped newline resets the
# column exactly like a literal one. What escapes change is only whether a quote
# *closes* the string, and `\` swallows exactly one byte, so a quote closes it
# unless an odd number of backslashes sits directly before it. The run scan
# therefore tests two bytes per byte instead of three and does the escape
# bookkeeping once per quote instead of once per body byte; the column still
# advances once per run, with the delimiter doing its own cursor update.
def read_string(lx: mut Lexer, offset: int) -> Result[RawToken, LexError]:
    src = lx.src
    length = len(src)
    pos = lx.cursor[0]
    line = lx.cursor[1]
    col = lx.cursor[2]
    start_line = line
    start_col = col
    pos = pos + 1  # skip opening "
    col = col + 1
    start = pos
    closed = False
    while pos < length:
        # One native search for the next `"` or literal newline, instead of a
        # guest comparison per body byte: the body is most of a document.
        found = src.find_any(b"\"\n", pos)
        if found == -1:
            col = col + (length - pos)
            pos = length
            break
        col = col + (found - pos)
        pos = found
        byte = src[pos]
        if byte == 10:
            # A newline in the body moves line and column exactly as the
            # scalar scan did: the run's columns, then the reset.
            line = line + 1
            col = 1
            pos = pos + 1
            continue
        # A quote closes the string unless the backslash run directly before it
        # is odd. Only backslashes are walked, and they are rare, so the common
        # case is one comparison.
        escaped = False
        back = pos - 1
        while back >= start and src[back] == 92:
            escaped = not escaped
            back = back - 1
        if escaped:
            pos = pos + 1
            col = col + 1
            continue
        closed = True
        break
    if not closed:
        store_cursor(mut lx, pos, line, col)
        return Err(LexError(message="unterminated string", offset=offset, line=start_line))
    text_end = pos
    pos = pos + 1  # skip closing "
    col = col + 1
    store_cursor(mut lx, pos, line, col)
    return Ok(raw(Kind.string, offset, pos, start, text_end, start_line, start_col))


def read_atom(lx: mut Lexer, offset: int) -> RawToken:
    src = lx.src
    length = len(src)
    pos = lx.cursor[0]
    line = lx.cursor[1]
    col = lx.cursor[2]
    start_line = line
    start_col = col
    start = pos
    while pos < length and is_atom_continue(src[pos]):
        pos = pos + 1
        col = col + 1
    store_cursor(mut lx, pos, line, col)
    return raw(Kind.atom, offset, pos, start, pos, start_line, start_col)


# An operator atom, allowing the two-character `>= <= == !=` forms.
def read_operator(lx: mut Lexer, offset: int) -> RawToken:
    src = lx.src
    length = len(src)
    pos = lx.cursor[0]
    line = lx.cursor[1]
    col = lx.cursor[2]
    start_line = line
    start_col = col
    start = pos
    pos = pos + 1
    col = col + 1
    if peek(src, length, pos) == 61:
        pos = pos + 1
        col = col + 1
    store_cursor(mut lx, pos, line, col)
    return raw(Kind.atom, offset, pos, start, pos, start_line, start_col)


# Number path: optional leading minus, digits, an optional fractional part, then
# one of `mm`/`mil`, an SI suffix, `%`, or — when more atom characters follow —
# a fallback to an atom (`204928-0301.stp`, `12.5abc`, `100kHz`, `5V3`).
# None of those bytes can be a newline, so only the column moves.
def read_number(lx: mut Lexer, offset: int) -> RawToken:
    src = lx.src
    length = len(src)
    pos = lx.cursor[0]
    line = lx.cursor[1]
    col = lx.cursor[2]
    start_line = line
    start_col = col
    start = pos
    if peek(src, length, pos) == 45:
        pos = pos + 1
        col = col + 1
    while pos < length and is_digit(src[pos]):
        pos = pos + 1
        col = col + 1
    is_float = False
    if peek(src, length, pos) == 46 and is_digit(peek(src, length, pos + 1)):
        is_float = True
        pos = pos + 1  # skip .
        col = col + 1
        while pos < length and is_digit(src[pos]):
            pos = pos + 1
            col = col + 1
    num_end = pos
    # Dimension units: the token text stops before the suffix.
    if peek(src, length, pos) == 109:
        if peek(src, length, pos + 1) == 109 and not is_atom_continue(peek(src, length, pos + 2)):
            pos = pos + 2
            col = col + 2
            store_cursor(mut lx, pos, line, col)
            return raw(Kind.unit_val, offset, pos, start, num_end, start_line, start_col)
        if peek(src, length, pos + 1) == 105 and peek(src, length, pos + 2) == 108 and not is_atom_continue(peek(src, length, pos + 3)):
            pos = pos + 3
            col = col + 3
            store_cursor(mut lx, pos, line, col)
            return raw(Kind.unit_val, offset, pos, start, num_end, start_line, start_col)
    # SI scale (or a bare unit letter); the text keeps the suffix verbatim so
    # the parser can apply the scale.
    suffix = si_suffix_len(src, length, pos)
    if suffix > 0:
        pos = pos + suffix
        col = col + suffix
        store_cursor(mut lx, pos, line, col)
        return raw(Kind.si_val, offset, pos, start, pos, start_line, start_col)
    # Percent literal: only when the sign ends the token, so a standalone `%`
    # still lexes as an operator atom.
    if peek(src, length, pos) == 37 and not is_atom_continue(peek(src, length, pos + 1)):
        pos = pos + 1
        col = col + 1
        store_cursor(mut lx, pos, line, col)
        return raw(Kind.si_val, offset, pos, start, pos, start_line, start_col)
    if is_atom_continue(peek(src, length, pos)):
        while pos < length and is_atom_continue(src[pos]):
            pos = pos + 1
            col = col + 1
        store_cursor(mut lx, pos, line, col)
        return raw(Kind.atom, offset, pos, start, pos, start_line, start_col)
    store_cursor(mut lx, pos, line, col)
    if is_float:
        return raw(Kind.float_val, offset, pos, start, pos, start_line, start_col)
    return raw(Kind.int_val, offset, pos, start, pos, start_line, start_col)


# Lex the whole source into a token list ending in `eof`, or stop at the first
# LexError. `offset`/`line` in the error point at the offending byte (for an
# unterminated string, at its opening quote).
#
# The skip loop is the only place the scanner itself consumes a newline, so it
# is the only place line/col need updating here; the readers do their own.
public def next_raw(lx: mut Lexer) -> Result[RawToken, LexError]:
    src = lx.src
    length = len(src)
    pos = lx.cursor[0]
    line = lx.cursor[1]
    col = lx.cursor[2]
    # Skip whitespace and `;` comments to end of line. A comment is consumed as
    # a run up to the next line break, so the column moves once for the whole
    # comment. Blanks stay per byte: a single blank between two tokens is the
    # common case, and a run loop around it costs more than the column
    # increment it removes (measured on the mixed-input probe).
    skipping = True
    while skipping:
        byte = peek(src, length, pos)
        if is_space(byte):
            if byte == 10:
                line = line + 1
                col = 1
            else:
                col = col + 1
            pos = pos + 1
        elif byte == 59:
            # A comment runs to the next line break: one native search for it
            # rather than a guest comparison per comment byte.
            run = pos
            stop = src.find_any(b"\n", pos)
            if stop == -1:
                stop = length
            pos = stop
            col = col + (pos - run)
        else:
            skipping = False
    offset = pos
    byte = peek(src, length, pos)
    if byte == -1:
        store_cursor(mut lx, pos, line, col)
        return Ok(raw(Kind.eof, offset, offset, offset, offset, line, col))
    if byte == 40:
        store_cursor(mut lx, pos + 1, line, col + 1)
        return Ok(raw(Kind.lparen, offset, pos + 1, offset, pos + 1, line, col))
    if byte == 41:
        store_cursor(mut lx, pos + 1, line, col + 1)
        return Ok(raw(Kind.rparen, offset, pos + 1, offset, pos + 1, line, col))
    # Hand the cursor over at the token boundary; each reader re-reads it once.
    store_cursor(mut lx, pos, line, col)
    if byte == 34:
        return read_string(mut lx, offset)
    if is_digit(byte) or (byte == 45 and is_digit(peek(src, length, pos + 1))):
        return Ok(read_number(mut lx, offset))
    if is_atom_start(byte):
        return Ok(read_atom(mut lx, offset))
    if is_operator_char(byte):
        return Ok(read_operator(mut lx, offset))
    return Err(LexError(message="unexpected character", offset=offset, line=line))


# Compatibility API: collect the streaming tokens and materialize their text.
public def tokenize(src: bytes) -> Result[list[Token], LexError]:
    lx = lexer(src)
    tokens: list[Token] = []
    while True:
        match next_raw(mut lx):
            case Ok(found):
                token = materialize(src, found)
                tokens.append(token)
                if token.kind == Kind.eof:
                    return Ok(tokens)
            case Err(problem):
                return Err(problem)
