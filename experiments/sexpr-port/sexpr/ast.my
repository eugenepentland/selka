module sexpr.ast

# AST for the S-expression reader, ported from eda/src/sexpr/ast.zig.
# Shared by sexpr.tokenizer, sexpr.parser and sexpr.printer.
#
# Every case carries the source span of its first token, and `decimal` carries
# the source spelling of a suffixed literal (`220k`, `100nF`, `3.3V`, `10%`).
# That mirrors Zig's `Node { tag, span, literal }` exactly: the port used to
# need a separate `Spelled` record because a case held one payload, and now
# uses the language's multi-field cases directly.
#
# Text is a `view.View`, not an owned `str`: the node keeps the byte range its
# spelling occupies in the document it was parsed from, exactly the way Zig
# keeps a `[]const u8` slice of the source. Building a node therefore allocates
# nothing and widens nothing, a comparison against a fixed word decodes only
# that word's length, and a consumer that only re-emits the text copies the
# range. Call `view.bytes_of`/`view.text_of` where a real `bytes` or `str` value
# is genuinely required.

import sexpr.view as view


# Source position of a node's first token. The three fields are `u32`, not
# `int`: a document is bounded by the source range the parser accepts, so 32
# bits hold every offset, line and column the port can produce, and the
# narrower record keeps `Span` (and therefore `Node`) smaller. `int(...)`
# widens a field where a diagnostic wants an `int`, and the parser rejects a
# source longer than `u32` can address before any span is built, so the
# narrowing conversions below are checked and cannot trap on valid input.
public record Span:
    line: u32
    col: u32
    offset: u32


# The largest document the port parses: one byte past this cannot be addressed
# by `Span.offset`.
public def max_source_bytes() -> int:
    return 4294967295


public def zero_span() -> Span:
    return Span(line=1, col=1, offset=0)


# One parsed S-expression. A form reaches itself only through a list payload,
# so the union closes in finite space and needs no class indirection.
#   form    - a parenthesised form, in source order
#   atom    - a bare symbol, as the source range it occupies
#   string  - a quoted string (raw content, escapes intact, quotes excluded)
#   integer - a plain integer literal
#   decimal - a float literal, with the source spelling when one was written
#   measure - a `mm`/`mil` dimension, normalised to millimetres
public union Node:
    form(items: list[Node], span: Span),
    atom(text: view.View, span: Span),
    string(text: view.View, span: Span),
    integer(value: int, span: Span),
    decimal(value: float, span: Span, literal: Option[view.View] = None),
    measure(value: float, span: Span)


public def is_form(node: Node, name: str) -> bool:
    match node:
        case Node.form(entries, _):
            if len(entries) == 0:
                return False
            return is_atom_named(entries[0], name)
        case _:
            return False


def is_atom_named(node: Node, name: str) -> bool:
    match node:
        case Node.atom(text, _):
            return view.matches(text, name)
        case _:
            return False


public def as_items(node: Node) -> Option[list[Node]]:
    match node:
        case Node.form(entries, _):
            return Some(entries)
        case _:
            return None


public def as_atom(node: Node) -> Option[view.View]:
    match node:
        case Node.atom(text, _):
            return Some(text)
        case _:
            return None


public def as_string(node: Node) -> Option[view.View]:
    match node:
        case Node.string(text, _):
            return Some(text)
        case _:
            return None


# The source range of a string or atom node; None for forms and numbers.
public def as_text(node: Node) -> Option[view.View]:
    match node:
        case Node.string(text, _):
            return Some(text)
        case Node.atom(text, _):
            return Some(text)
        case _:
            return None


# The numeric value of an integer, decimal or measure node.
public def as_number(node: Node) -> Option[float]:
    match node:
        case Node.integer(value, _):
            return Some(float(value))
        case Node.decimal(value, _, _):
            return Some(value)
        case Node.measure(value, _):
            return Some(value)
        case _:
            return None


# The source spelling of a suffixed literal, else a string's or atom's range.
# None for a plain number, a measure or a form. This is the single reader of
# `literal`, so the precedence cannot drift between callers.
public def value_text(node: Node) -> Option[view.View]:
    match node:
        case Node.decimal(_, _, literal):
            match literal:
                case Some(text):
                    return Some(text)
                case None:
                    return None
        case Node.string(text, _):
            return Some(text)
        case Node.atom(text, _):
            return Some(text)
        case _:
            return None


# The source span of a node's first token.
public def span_of(node: Node) -> Span:
    match node:
        case Node.form(_, span):
            return span
        case Node.atom(_, span):
            return span
        case Node.string(_, span):
            return span
        case Node.integer(_, span):
            return span
        case Node.decimal(_, span, _):
            return span
        case Node.measure(_, span):
            return span


# The children of a form, or an empty list for every other node.
public def children(node: Node) -> list[Node]:
    match node:
        case Node.form(entries, _):
            return entries
        case _:
            empty: list[Node] = []
            return empty
