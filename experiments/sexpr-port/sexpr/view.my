
# A byte range of an immutable source buffer, without a copy.
#
# `bytes` values are immutable and traced, so a view that keeps a share of one
# costs three words to copy and never keeps the buffer alive past its last
# reader. Every function that produces a scalar string from a view decodes only
# when a caller actually needs Unicode scalars; parsing, comparing and
# re-emitting source text can all work from the byte range alone. That is what
# lets the reader keep an atom's spelling in the input instead of widening it to
# one four-byte scalar per code point.
#
# `end` is exclusive, matching every other range in the runtime. A view is only
# ever built from offsets the tokenizer already validated against the buffer, so
# `slice` clamps rather than traps; `text` still reports a range that is not
# valid UTF-8 instead of substituting replacement characters.


public record View:
    source: bytes
    start: int
    end: int


# A view of an empty suffix of `source`; the start of a scan.
public func at(source: bytes, start: int) -> View:
    return View(source=source, start=start, end=start)


# The number of bytes the view covers.
public func view_len(found: View) -> int:
    return found.end - found.start


# The covered bytes. This is a copy of the range, not a share of it; use it only
# where a real `bytes` value is required.
public func bytes_of(found: View) -> bytes:
    if found.end <= found.start:
        return b""
    return found.source[found.start:found.end]


# The text of the covered range, or a reason when those bytes are not UTF-8.
# A parser that only retains spellings never calls this.
public func text_of(found: View) -> Result[str, str]:
    return found.source[found.start:found.end].decode()


# Whether the range repeats the ASCII text `spelling`. Used for operators, unit
# suffixes and every other fixed word the reader compares against, so those
# comparisons need no decoded string at all.
public func matches(found: View, spelling: str) -> bool:
    match text_of(found):
        case Ok(decoded):
            return decoded == spelling
        case Err(_):
            return False


# Whether two views cover the same bytes of the same buffer. Two views of equal
# content in different buffers are not equal, exactly as two equal `bytes`
# values are not identical.
public func equal(first: View, second: View) -> bool:
    if view_len(first) != view_len(second):
        return False
    return bytes_of(first) == bytes_of(second)


# The leading byte of the range, or -1 for an empty view, so a caller can
# classify a suffix without decoding it.
public func first_byte(found: View) -> int:
    if found.start >= found.end:
        return -1
    return found.source[found.start]


# The view of the first `count` bytes, clamped to what the range holds.
public func take(found: View, count: int) -> View:
    if count <= 0:
        return View(source=found.source, start=found.start, end=found.start)
    mut stop = found.start + count
    if stop > found.end:
        stop = found.end
    return View(source=found.source, start=found.start, end=stop)


# The view that starts `count` bytes in, clamped to the end of the range.
public func skip(found: View, count: int) -> View:
    if count <= 0:
        return found
    mut start = found.start + count
    if start > found.end:
        start = found.end
    return View(source=found.source, start=start, end=found.end)


# The view from the end of `first` to the end of `second`, which must be a range
# of the same buffer that starts after `first` ends. This joins two adjacent
# tokens — a keyword and the value that follows it — into one range without
# copying either. A reversed or mismatched pair yields an empty view, so a
# caller that gets the order wrong reads nothing instead of reading nonsense.
public func through(first: View, second: View) -> View:
    if first.source != second.source or second.end < first.end:
        return View(source=first.source, start=first.end, end=first.end)
    return View(source=first.source, start=first.end, end=second.end)
