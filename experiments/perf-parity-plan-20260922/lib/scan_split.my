# scan_split: str.split(separator) over LIB.md's 4 MB text. Each piece is a
# fresh str until shared string slices land (plan section 5.4).


def shared_text() -> str:
    block = "".join([f"item{i},{(i * 7919) % 100003},{'xxxxxx'[:i % 7]}\n" for i in range(2000)])
    return "".join([block for _ in range(110)])


def main(out: Stream) -> int:
    text = shared_text()
    lines = 0
    width = 0
    fields = 0
    runs = 0
    run_width = 0
    for _ in range(3):
        for line in text.split("\n"):
            lines += 1
            width += len(line)
        fields += len(text.split(","))
        for run in text.split("x\nitem"):
            runs += 1
            run_width += len(run)
    out.print(f"{lines} {width} {fields} {runs} {run_width}")
    return 0
