# slice_walk: consume a text by slicing off its first line until nothing is
# left, the way a hand-written tokenizer or line reader walks its input. Each
# `rest[end + 1:]` is most of the remaining text, so a copying slice makes the
# walk quadratic in the text's length and a shared one keeps it linear (plan
# section 5.4). The text is LIB.md's block repeated 8 times (293,288 octets).


def shared_text() -> str:
    block = "".join([f"item{i},{(i * 7919) % 100003},{'xxxxxx'[:i % 7]}\n" for i in range(2000)])
    return "".join([block for _ in range(8)])


def main(out: Stream) -> int:
    text = shared_text()
    lines = 0
    width = 0
    for _ in range(3):
        rest = text
        while len(rest) > 0:
            end = rest.find("\n")
            width += len(rest[:end])
            rest = rest[end + 1:]
            lines += 1
    out.print(f"{lines} {width}")
    return 0
