def big(values: list[int], index: int) -> int:
    v0 = index + 1
    v1 = v0 + 1
    v2 = v1 + 1
    v3 = v2 + 1
    v4 = v3 + 1
    v5 = v4 + 1
    v6 = v5 + 1
    v7 = v6 + 1
    v8 = v7 + 1
    v9 = v8 + 1
    v10 = v9 + 1
    v11 = v10 + 1
    v12 = v11 + 1
    v13 = v12 + 1
    return values[v13]


def walk(values: list[int]) -> int:
    total = 0
    i = 0
    while i < 4:
        total = total + big(values, i)
        i = i + 1
    return total


def main() -> int:
    return walk([1, 2, 3])
