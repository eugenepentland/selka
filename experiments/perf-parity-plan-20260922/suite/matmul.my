# matmul: n x n float matrices as list[list[float]] (the Python shape), C = A * B
# by the i-k-j loop; prints the trace and the sum of C, each scaled by 1000.


def lcg(seed: int) -> int:
    return (seed * 3877 + 29573) % 139968


def random_matrix(n: int, seed: int) -> tuple[list[list[float]], int]:
    rows: list[list[float]] = []
    for i in range(n):
        row: list[float] = []
        for j in range(n):
            seed = lcg(seed)
            row.append(float(seed) / 139968.0)
        rows.append(row)
    return rows, seed


def main(out: Stream) -> int:
    n = 500
    a, seed = random_matrix(n, 42)
    b, seed = random_matrix(n, seed)
    c = [[0.0 for j in range(n)] for i in range(n)]
    for i in range(n):
        for k in range(n):
            aik = a[i][k]
            for j in range(n):
                c[i][j] = c[i][j] + aik * b[k][j]
    trace = 0.0
    for i in range(n):
        trace = trace + c[i][i]
    total = 0.0
    for i in range(n):
        for j in range(n):
            total = total + c[i][j]
    out.print(int(trace * 1000.0))
    out.print(int(total * 1000.0))
    return 0
