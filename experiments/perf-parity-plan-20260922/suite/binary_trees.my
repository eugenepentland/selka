# binary_trees: perfect binary trees of `class` nodes on the collecting heap.
# Every short-lived tree becomes garbage after its check; the tracing
# collector reclaims it. See SUITE.md section 1.


class Node:
    left: Option[Node]
    right: Option[Node]


def make(depth: int) -> Node:
    if depth == 0:
        return Node(left=None, right=None)
    return Node(left=Some(make(depth - 1)), right=Some(make(depth - 1)))


def check(node: Node) -> int:
    left = node.left
    right = node.right
    if left is None or right is None:
        return 1
    return 1 + check(left) + check(right)


def main(out: Stream) -> int:
    max_depth = 16
    min_depth = 4

    stretch = max_depth + 1
    out.print(f"stretch tree of depth {stretch}\t check: {check(make(stretch))}")

    long_lived = make(max_depth)

    depth = min_depth
    while depth <= max_depth:
        iterations = shift_left(1, max_depth - depth + min_depth)
        total = 0
        for _ in range(iterations):
            total = total + check(make(depth))
        out.print(f"{iterations}\t trees of depth {depth}\t check: {total}")
        depth = depth + 2

    out.print(f"long lived tree of depth {max_depth}\t check: {check(long_lived)}")
    return 0
