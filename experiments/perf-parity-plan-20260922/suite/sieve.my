# sieve: Eratosthenes over a list[bool] of n + 1 flags; prints the prime count.
# A list[bool] stores one byte per flag.


def main(out: Stream) -> int:
    n = 20000000
    flags = [True for _ in range(n + 1)]
    flags[0] = False
    flags[1] = False
    i = 2
    while i * i <= n:
        if flags[i]:
            j = i * i
            while j <= n:
                flags[j] = False
                j = j + i
        i = i + 1
    count = 0
    for flag in flags:
        if flag:
            count += 1
    out.print(count)
    return 0
