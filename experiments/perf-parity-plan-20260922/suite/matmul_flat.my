# matmul_flat: matmul over one list[float] per matrix, indexed i * n + j,
# C = A * B by the i-k-j loop; prints the trace and the sum of C, each scaled
# by 1000.


def lcg(seed: int) -> int:
    return (seed * 3877 + 29573) % 139968


def random_matrix(n: int, seed: int) -> tuple[list[float], int]:
    values: list[float] = []
    for _ in range(n * n):
        seed = lcg(seed)
        values.append(float(seed) / 139968.0)
    return values, seed


def main(out: Stream) -> int:
    n = 500
    a, seed = random_matrix(n, 42)
    b, seed = random_matrix(n, seed)
    c = [0.0 for _ in range(n * n)]
    for i in range(n):
        for k in range(n):
            aik = a[i * n + k]
            for j in range(n):
                c[i * n + j] = c[i * n + j] + aik * b[k * n + j]
    trace = 0.0
    for i in range(n):
        trace = trace + c[i * n + i]
    total = 0.0
    for i in range(n):
        for j in range(n):
            total = total + c[i * n + j]
    out.print(int(trace * 1000.0))
    out.print(int(total * 1000.0))
    return 0
