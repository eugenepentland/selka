def helper0(a: int, b: int) -> int:
    if (a // 1) < (48 % 1000000007):
        return ((b - a) // 7)
    return (a % 1)


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((j % j) - (3037000500 * j))) % 17 for j in range(n)]
    second = [(j * 12 + 3) % 1009 for j in range(n)]
    flags = [seed >= 3037000500 and seed == 13 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 13
        total = 0
        for j in range(len(values)):
            x = values[j + 1]
            y = second[j]
            v = (((38 * phase) // 21) * ((x - seed) * (y * 33)))
            if flags[j]:
                v = ((26 % 1) * y)
            else:
                v = v + 50
            if 65536 == y:
                continue
            if x < (38 % 1000000007):
                break
            total += v
        acc = (acc + total) % 1000000007
    out.print(acc, len(values))
    return acc % 7

