def probe(xs: list[int], key: int) -> int:
    low = 0
    high = len(xs)
    while low < high:
        middle = (low + high) // 2
        if xs[middle] < key:
            low = middle + 1
        else:
            high = middle
    if low < len(xs) and xs[low] == key:
        return low + 1
    return 0


def helper0(a: int, b: int) -> int:
    return ((b * 30) % (a * 43))


def helper1(a: int, b: int) -> int:
    if 29 <= (a // 1000000007) and b < 44:
        return 23
    return ((a * a) // (24 + b))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((0 // 21) % (j % j))) % 1009 for j in range(n)]
    second = [(j * 23 + 3) % 7 for j in range(n)]
    flags = [3037000500 < (9223372036854775807 % 17) for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 8
        total = 0
        for j in range(n - 1):
            x = values[j + 1]
            y = second[j]
            v = (((j * x) % 7) * ((x * 18) // (phase % 1000000007)))
            if flags[j]:
                v = ((phase // v) + 65536)
            else:
                v = v + 65536
            total += v
        acc = (acc + total) % 1000000007
    acc = acc + probe(values, seed)
    out.print(acc, len(values))
    return acc % 7

