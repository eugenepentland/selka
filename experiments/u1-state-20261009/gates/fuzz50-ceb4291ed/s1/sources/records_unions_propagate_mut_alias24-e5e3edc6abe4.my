def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def fold(values: list[int]) -> int:
    total = 0
    for value in values:
        total = (total * 31 + value) % 1000003
    return total


record Bucket:
    count: int
    items: list[int]


def bucket_total(b: Bucket) -> int:
    t = b.count
    for x in b.items:
        t = (t * 7 + x) % 1000003
    return t


def grow(b: Bucket, v: int) -> Bucket:
    items = b.items
    items.append(v)
    return Bucket(b.count + 1, items)


record Pair:
    a: int
    b: int


union Item:
    empty,
    num: int,
    pair: Pair,
    bag: Bucket


def weigh(item: Item) -> int:
    match item:
        case Item.num(v):
            return v
        case Item.pair(p):
            return p.a * 3 + p.b
        case Item.bag(g):
            return len(g.items) + g.count
        case _:
            return 1


def sum_items(items: list[Item]) -> int:
    t = 0
    for i in range(len(items)):
        t = (t * 5 + weigh(items[i])) % 1000003
    return t


def bump(xs: mut list[int], k: int):
    xs.append(k)
    xs[0] = (xs[0] + k) % 1009


def fill(xs: mut list[int], k: int):
    for j in range(k % 4):
        xs.append(j * 3 + k)


def swap_ends(xs: mut list[int]):
    last = len(xs) - 1
    first = xs[0]
    xs[0] = xs[last]
    xs[last] = first


def twice(xs: mut list[int], k: int):
    bump(mut xs, k)
    bump(mut xs, k + 1)


def touch(b: mut Bucket, v: int):
    b.items[0] = v
    b.count = b.count + 1
    b.items.append(v)


def touch_items(b: mut Bucket, v: int):
    bump(mut b.items, v)
    b.count = b.count + 2


def rebuild(b: mut Bucket, v: int):
    b = Bucket(v % 5, [v, v + 1])


def both(xs: list[int], ys: list[int]) -> int:
    return len(xs) * 100 + len(ys) + xs[0] + ys[0]


def step0(x: int) -> Result[int, str]:
    if x % 3 == 2:
        return Err("bad")
    return Ok((x * 3 + 1) % 1009)


def step1(x: int) -> Result[int, str]:
    if x % 7 == 2:
        return Err("bad")
    return Ok((x * 3 + 6) % 1009)


def chain0(x: int) -> Result[int, str]:
    v0 = step1(x)?
    v1 = step0(v0 + 1)?
    if v1 > 362:
        return Ok(v1)
    return Ok(v0 + v1)


def sum_checked(xs: list[int]) -> Result[int, str]:
    t = 0
    for x in xs:
        t = (t + step0(x)?) % 1000003
    return Ok(t)


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 1 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    acc = 0
    xs = [(j * 1 + seed) % 1009 for j in range(n)]
    ys = [(j * 4 + 1) % 997 for j in range(n)]
    b = Bucket(n, xs)
    c = Bucket(1, [seed])
    items: list[Item] = []
    items.append(Item.num(seed))
    touch(mut b, (((n + acc) + (acc * n))) % 1009)
    snap = b
    b.items.append((((seed * 12) * (acc % 16))) % 1009)
    acc = (acc + len(snap.items) * 5 + len(b.items)) % 1000003
    acc = (acc + bucket_total(b)) % 1000003
    acc = (acc + c.items[(((n % 17)) % 1009) % len(c.items)]) % 1000003
    touch_items(mut c, (((acc % n) * (n * 4611686018427387904))) % 1009)
    for r in range(rounds):
        acc = (acc + r) % 1000003
        c.count = c.count + (((24 % 1000000007) - (3037000500 * acc))) % 1009
        acc = (acc + both(xs, ys)) % 1000003
        touch(mut b, (((9223372036854775807 * seed) - (36 + acc))) % 1009)
    items.append(Item.pair(Pair((((acc % n) + (n - n))) % 1009, (((48 % (0 - 27)) // (44 + seed))) % 1009)))
    fill(mut ys, (((46 - acc) + n)) % 1009)
    snap_items = items
    items.append(Item.num(((acc + (acc % acc))) % 1009))
    acc = (acc + len(snap_items) * 7 + len(items)) % 1000003
    if acc % 2 == 0:
        match chain0(acc):
            case Ok(v):
                acc = v
            case Err(e):
                acc = len(e)
    out.print(acc, fold(xs), fold(ys), b.count, fold(b.items), c.count, fold(c.items), sum_items(items), len(items))
    return acc % 7

