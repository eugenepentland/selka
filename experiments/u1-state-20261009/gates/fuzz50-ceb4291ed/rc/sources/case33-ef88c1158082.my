def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("xyz")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(2))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(5)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(3))
    if len(rl3) > 0:
        inner4 = rl3[0]
        inner4.append(5)
        acc = acc + len(inner4) + len(rl3[0])
    sg5 = grow_str(sl2, 1)
    sg5.append("xyz")
    acc = acc + len(rl3)
    for i2 in range(2):
        ra6 = rl3
        ia7 = il1
        il1.append(seed)
        if len(rl3) > 1:
            acc = acc + len(ia7)
            acc = acc + len(sl2)
            ia8 = ia7
        ia9 = ia7
    rl3.append(make_ints(2))
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sg5) > 0:
        out.print(sg5[len(sg5) - 1])
    acc = acc + len(sg5)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
