def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(2)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("a")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(2))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(2)
    sl2: list[str] = []
    sl2.append("xyz")
    rl3: list[list[int]] = []
    rl3.append(make_ints(2))
    il1.append(seed)
    for i2 in range(0):
        sl2.append("xyz")
        for i1 in range(2):
            sl2.append("xyz")
            acc = acc + len(rl3)
            acc = acc + len(sl2)
            ig4 = grow_int(il1, i1)
        if len(rl3) > 0:
            inner5 = rl3[0]
            inner5.append(5)
            acc = acc + len(inner5) + len(rl3[0])
        for i1 in range(2):
            rg6 = grow_row(rl3, seed)
            acc = acc + len(il1)
            ra7 = rl3
        il1.append(i2)
        ra8 = rl3
    sl2.append("xyz")
    ra9 = rl3
    if len(ra9) > 0:
        ra10 = rl3
        ra11 = ra9
        acc = acc + len(il1)
        acc = acc + len(rl3)
        acc = acc + len(ra10)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(ra9)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
