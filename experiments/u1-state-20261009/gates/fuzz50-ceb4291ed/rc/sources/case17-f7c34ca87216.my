def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(8)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("xyz")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(4)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(seed))
    for i2 in range(3):
        il1.append(i2)
        ia4 = il1
        rl3.append(make_ints(seed))
        ia5 = il1
        ia6 = ia4
        for i1 in range(3):
            acc = acc + len(rl3)
            acc = acc + len(ia6)
    sg7 = grow_str(sl2, 1)
    sa8 = sl2
    ra9 = rl3
    sa8.append("bc")
    ra10 = rl3
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sg7) > 0:
        out.print(sg7[len(sg7) - 1])
    acc = acc + len(sg7)
    if len(sa8) > 0:
        out.print(sa8[len(sa8) - 1])
    acc = acc + len(sa8)
    acc = acc + len(ra9)
    acc = acc + len(ra10)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
