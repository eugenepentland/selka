def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(2)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("a")
    rl3: list[list[int]] = []
    rl3.append(make_ints(2))
    acc = acc + len(il1)
    il1.append(seed)
    sa4 = sl2
    sa5 = sa4
    sl2.append("bc")
    if len(sa4) > 2:
        for i1 in range(2):
            if len(rl3) > 0:
                inner6 = rl3[0]
                inner6.append(5)
                acc = acc + len(inner6) + len(rl3[0])
            acc = acc + len(sa5)
            sa7 = sa4
            acc = acc + len(sa5)
        for i1 in range(2):
            ia8 = il1
            rl3.append(make_ints(i1))
            sg9 = grow_str(sa5, i1)
        sa10 = sa4
        sg11 = grow_str(sa5, seed)
        return acc + len(sa4)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sa4) > 0:
        out.print(sa4[len(sa4) - 1])
    acc = acc + len(sa4)
    if len(sa5) > 0:
        out.print(sa5[len(sa5) - 1])
    acc = acc + len(sa5)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
