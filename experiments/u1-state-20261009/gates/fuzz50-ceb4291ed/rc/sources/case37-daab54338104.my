def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("xyz")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(2))
    sl2.append("xyz")
    for i2 in range(2):
        if len(il1) > 3:
            ra4 = rl3
            ra5 = ra4
            ra5.append(make_ints(i2))
            if len(ra5) > 0:
                inner6 = ra5[0]
                inner6.append(5)
                acc = acc + len(inner6) + len(ra5[0])
            acc = acc + len(ra5)
        sa7 = sl2
        il1.append(seed)
    for i2 in range(2):
        ra8 = rl3
        ra9 = ra8
        il1.append(i2)
        if len(ra8) > 0:
            inner10 = ra8[0]
            inner10.append(5)
            acc = acc + len(inner10) + len(ra8[0])
        sl2.append("bc")
    sg11 = grow_str(sl2, seed)
    ia12 = il1
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sg11) > 0:
        out.print(sg11[len(sg11) - 1])
    acc = acc + len(sg11)
    acc = acc + len(ia12)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
