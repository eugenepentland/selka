record Graph:
    successors: int[][]
    seen: int[]
    generation: int

func visit(mut graph: Graph, group: int) -> int:
    graph.generation += 1
    const generation = graph.generation
    mut pending = [group]
    graph.seen[group] = generation
    mut next = 0
    while next < len(pending):
        const current = pending[next]
        next += 1
        for offset in range(len(graph.successors[current])):
            const target = graph.successors[current][offset]
            if graph.seen[target] != generation:
                graph.seen[target] = generation
                pending.append(target)
    return len(pending)

func main(args: str[], out: Stream) -> int:
    mut graph = Graph(successors=[[1], []], seen=[0, 0], generation=0)
    out.print(visit(mut graph, len(args) % 2))
    out.print(graph.seen[0], graph.seen[1])
    return 0
