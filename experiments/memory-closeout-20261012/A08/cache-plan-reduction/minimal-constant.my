record Marks:
    seen: int[]

func visit(mut marks: Marks, n: int) -> int:
    marks.seen[0] = 1
    mut next = 0
    while next < n:
        marks.seen[next % len(marks.seen)] = 1
        next += 1
    return marks.seen[0]

func main(args: str[], out: Stream) -> int:
    mut marks = Marks(seen=[0, 0])
    out.print(visit(mut marks, len(args) + 2))
    out.print(marks.seen[0], marks.seen[1])
    return 0
