+    for ([_]bool{ false, true }) |old_mode| {
+        try storage.storeValue(key, Legacy, .{ .artifact = @splat(1), .text_digest = @splat(2), .dependencies = .{ .number = false, .math = false, .counting = false, .zero_rc = old_mode } });
