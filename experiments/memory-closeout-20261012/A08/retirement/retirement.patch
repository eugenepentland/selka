+//! Missing, legacy and foreign guest provenance never enters a checked native link.
+const std = @import("std");
+const abi = @import("guest_abi.zig");
+const codec = @import("mylang").persist_codec;
+const emission = @import("emission_cache.zig");
+const units = @import("emit_units.zig");
+const native = @import("native_receipt.zig");
+const objects = @import("unit_cache.zig");
+const stage = @import("stage_store.zig");
+const driver = @import("driver.zig");
+const plain = "define i32 @f() { ret i32 7 }\n";
+const checked = emission.marker ++ plain;
+const artifact: emission.Artifact = .{ .abi = abi.current, .text = checked, .number = false, .math = false, .counting = false };
+
+// spec-case: NEW-CORE-STAGE-CACHE-9
+test "A08 retired ABI refuses checksum-valid old artifact shapes and foreign provenance" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var directory = std.testing.tmpDir(.{});
+    defer directory.cleanup();
+    var storage = try stage.Store.init(std.testing.allocator, std.testing.io, try directory.dir.realPathFileAlloc(std.testing.io, ".", a));
+    defer storage.deinit();
+    const key = storage.key("A08-owned-admission", &.{});
+    const handle: emission.NativeArtifact = .{ .abi = abi.current, .store = &storage, .key = key };
+    const Legacy = struct { text: []const u8, number: bool, math: bool, counting: bool, zero_rc: bool };
+    for ([_]bool{ false, true }) |old_mode| {
+        try storage.storeValue(key, Legacy, .{ .text = plain, .number = false, .math = false, .counting = false, .zero_rc = old_mode });
+        try std.testing.expect((try emission.loadArtifact(&storage, a, key)) == null);
+        try std.testing.expectError(error.CacheMiss, native.materialize(a, handle));
+    }
+    var encoded = codec.Writer.init(a);
+    try encoded.write(emission.Artifact, artifact);
+    for ([_]u32{ 0, 1, @backingInt(abi.current) + 1 }) |foreign| {
+        std.mem.writeInt(u32, encoded.bytes.items[0..4], foreign, .little);
+        try std.testing.expect(try storage.save(key, encoded.bytes.items));
+        try std.testing.expect((try emission.loadArtifact(&storage, a, key)) == null);
+    }
+    var forged = artifact;
+    for ([_][]const u8{ plain, "; mylang-zero-rc-v2\n" ++ plain, "; foreign-abi\n" ++ plain }) |text| {
+        forged.text = text;
+        try storage.storeValue(key, emission.Artifact, forged);
+        try std.testing.expectError(error.CacheMiss, native.materialize(a, handle));
+    }
+    try storage.storeValue(key, emission.Artifact, artifact);
+    try std.testing.expectEqualStrings(checked, (try native.materialize(a, handle)).text);
+}
