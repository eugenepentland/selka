func clone_during(mut target: dict[int, int], source: dict[int, dict[int, int]]) -> dict[int, dict[int, int]]:
    target[1] = target[1]
    return source.copy()


# spec-case: MUT-EXPRESSION-STACK-1
# spec-case: COW-MUT-ARGUMENT-1
public func test_dictionary_element_argument_keeps_pinned_copy_independent() -> bool:
    mut original = {0: {1: 7}}
    const source = original.copy()
    mut copied = clone_during(mut original[0], source)
    mut live = list(copied[0].values())
    copied[0][1] = 13
    # The explicit source copy and returned copy own independent children.
    # Materializing values takes another independent snapshot before mutation.
    return list(live) == [7] and copied[0][1] == 13 and original[0][1] == 7


func main(out: Stream) -> int:
    out.print(test_dictionary_element_argument_keeps_pinned_copy_independent())
    return 0
