record Label:
    pair: tuple[int, str]


func split_first(text: str, sep: str) -> tuple[str, str]:
    mut at = text.find(sep)
    if at < 0:
        return text.copy(), ""
    return text[0:at], text[at + 1:len(text)]


func labelled(pair: tuple[int, str]) -> Label:
    return Label(pair=pair.copy())


func find(pairs: tuple[int, str][], wanted: int) -> tuple[int, str]?:
    for number, letter in pairs:
        if number == wanted:
            return Some((number, letter.copy()))
    return None


func letter_of(found: tuple[int, str]?) -> str:
    if found is None:
        return ""
    const number, letter = found.copy()
    return letter


func pair_sum(pair: tuple[int, int]) -> int:
    const left, right = pair
    return left + right


func managed_pair() -> tuple[int, int[]]:
    mut seen: int[] = []
    seen.append(7)
    return 3, seen


func first_or[T](pair: tuple[T, int], fallback: T) -> T:
    const value, count = pair.copy()
    if count > 0:
        return value
    return fallback.copy()


func swap_pair[T](pair: tuple[T, T]) -> tuple[T, T]:
    const left, right = pair.copy()
    return right, left


# A returned tuple destructures by name, `_` skips one, and the swap idiom
# rewrites both names from one tuple value.
# spec-case: TUPLE-3
public func test_a_returned_tuple_destructures_and_the_swap_idiom_works() -> bool:
    const head, rest = split_first("key=value", "=")
    if head != "key" or rest != "value":
        return False
    mut a = 1
    mut b = 2
    a, b = b, a
    if a != 2 or b != 1:
        return False
    const first, _ = split_first("a=b", "=")
    return first == "a"


# A tuple is an ordinary value: it lives in a list, in a record field, and each
# element keeps its own type.
# spec-case: TUPLE-2
public func test_a_tuple_nests_in_a_list_and_in_a_record_field() -> bool:
    mut pairs: tuple[int, str][] = [(1, "a"), (2, "b")]
    mut total = 0
    for number, letter in pairs:
        total = total + number
        if letter == "":
            return False
    if total != 3:
        return False
    mut wrapped = labelled((4, "d"))
    const number, letter = wrapped.pair.copy()
    return number == 4 and letter == "d"


# spec-case: TUPLE-2
public func test_an_option_and_a_result_payload_can_be_a_tuple() -> bool:
    mut pairs: tuple[int, str][] = [(1, "a"), (2, "b")]
    if letter_of(find(pairs, 2)) != "b":
        return False
    if letter_of(find(pairs, 9)) != "":
        return False
    mut ok: Result[tuple[int, str], str] = Ok((5, "e"))
    match ok:
        case Ok(pair):
            const number, letter = pair.copy()
            return number == 5 and letter == "e"
        case Err(message):
            return False


# spec-case: TUPLE-6
public func test_tuple_equality_and_rendering_follow_the_aggregate_rule() -> bool:
    mut left: tuple[int, str] = (1, "a")
    mut right = (1, "a")
    if left != right:
        return False
    if left == (1, "b") or left == (2, "a"):
        return False
    if f"{left}" != "(1, 'a')":
        return False
    mut nested = (1, (2, "b"))
    if f"{nested}" != "(1, (2, 'b'))":
        return False
    mut pairs: tuple[int, str][] = [left, (2, "b")]
    return f"{pairs}" == "[(1, 'a'), (2, 'b')]"


# A template may take, destructure and return `tuple[T, int]`; the element that
# is a type parameter stays that parameter, so one definition serves int and str.
# spec-case: TUPLE-8
public func test_a_generic_function_over_a_tuple_keeps_its_element_type() -> bool:
    if first_or((7, 1), 0) != 7:
        return False
    if first_or(("a", 0), "b") != "b":
        return False
    const first, second = swap_pair((1, 2))
    if first != 2 or second != 1:
        return False
    mut pairs: tuple[int, int][] = [(1, 2), (3, 4)]
    mut total = 0
    for left, right in pairs:
        total = total + left + right
    return total == 10


func main() -> int:
    if not test_a_returned_tuple_destructures_and_the_swap_idiom_works():
        return 1
    if not test_a_tuple_nests_in_a_list_and_in_a_record_field():
        return 2
    if not test_an_option_and_a_result_payload_can_be_a_tuple():
        return 3
    if not test_tuple_equality_and_rendering_follow_the_aggregate_rule():
        return 4
    if not test_a_generic_function_over_a_tuple_keeps_its_element_type():
        return 5
    return 0
