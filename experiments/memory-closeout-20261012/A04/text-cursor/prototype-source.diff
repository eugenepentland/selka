diff --git a/src/core/runtime/core_values.c b/src/core/runtime/core_values.c
index 5c57c0c0d..8f2dedd50 100644
--- a/src/core/runtime/core_values.c
+++ b/src/core/runtime/core_values.c
@@ -10,7 +10,10 @@ myl_block *myl_core_octets_repeat_unsigned(const myl_block *source, uint64_t cou
     /* The trailing terminator is part of the signed allocation capacity. */
     if (source->len && count > (uint64_t)(INT64_MAX - 1) / (uint64_t)source->len) out_of_memory();
     size_t n = (size_t)((uint64_t)source->len * count);
-    myl_block *result = block_new(kind_of(source), (int64_t)n + 1, 1);
+    uint32_t kind = kind_of(source);
