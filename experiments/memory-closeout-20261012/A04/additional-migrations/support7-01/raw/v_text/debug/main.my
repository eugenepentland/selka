record Labelled:
    name: str
    next: Labelled?


func label(count: int, items: int[]) -> str:
    return f"total {count} of {len(items)} items"


func chain(count: int) -> Labelled:
    mut head = Labelled(name="end", next=None)
    for index in range(count):
        head = Labelled(name="n" + str(index), next=Some(head))
    return head


func length(item: Labelled) -> int:
    mut total = 1
    mut current = item.next.copy()
    while current is not None:
        if len(current.name) > 0:
            total = total + 1
        current = current.next.copy()
    return total


func words(n: int) -> str[]:
    mut out: str[] = []
    for i in range(n):
        out.append("w" + str(i * i))
    return out


func main(out: Stream) -> int:
    out.print(label(7, [1, 2, 3]), f"{1 + 1}", f"{True} {()}", f"a-x{'b'}")
    out.print(str(-9223372036854775807), str(18446744073709551615u64), str(i8(-5)), str(u8(200)), str(False))
    out.print("hé" + "llo", len("hé" + "llo"), "" + "", "a" + "" == "a")
    out.print(", ".join(words(4)), "-".join(words(1)), "-".join(words(0)) == "", "".join(words(3)))
    mut total = 0
    for count in range(30):
        total = total + length(chain(count))
    mut labelled = chain(5)
    out.print(total, labelled.name, length(labelled))
    return 0
