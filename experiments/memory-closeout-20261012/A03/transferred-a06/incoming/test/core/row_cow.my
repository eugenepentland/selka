# NEW-CORE-ROW-COW: one program of every shape in experiments/fix-row-cow-20261009/shapes
# (tools/fixture.py), run by src/core/row_cow_test.zig at debug, release and
# --verify-facts under the leak check against row_cow.expected.
# r_b.my
func scale_rb(mut c: float[][], n: int):
    for i in range(n):
        for j in range(n):
            c[i][j] = c[i][j] * 2.0


func shape_rb(out: Stream) -> int:
    mut rows3 = [[1.0, 2.0], [3.0, 4.0]]
    mut keep3 = rows3[1].copy()
    scale_rb(mut rows3, 2)
    out.print(rows3[1][1], keep3[1])
    return 0


# r_c.my
func shape_rc(out: Stream) -> int:
    mut rows3 = [[1.0, 2.0], [3.0, 4.0]]
    mut keep3 = rows3[1].copy()
    for i in range(2):
        for j in range(2):
            rows3[i][j] = rows3[i][j] * 2.0
    out.print(rows3[1][1], keep3[1])
    return 0


# r_d.my
func scale_rd(mut c: float[][], n: int):
    for i in range(n):
        for j in range(n):
            c[i][j] = c[i][j] * 2.0


func shape_rd(out: Stream) -> int:
    mut rows3 = [[1.0, 2.0], [3.0, 4.0]]
    mut keep3 = rows3[1].copy()
    scale_rd(mut rows3, 2)
    scale_rd(mut rows3, 2)
    out.print(rows3[1][1], keep3[1])
    return 0


# r_f.my
func shape_rf(out: Stream) -> int:
    mut a = [[1, 2], [3, 4]]
    mut ka = a[1].copy()
    a[1][0] = a[1][0] * 2
    out.print("readwrite-const", a[1][0], ka[0])
    mut b = [[1, 2], [3, 4]]
    mut kb = b[1].copy()
    for i in range(2):
        b[i][0] = 7
    out.print("loop-write", b[1][0], kb[0])
    mut c = [[1, 2], [3, 4]]
    mut kc = c[1].copy()
    for i in range(2):
        c[i][0] = c[i][0] * 2
    out.print("loop-readwrite", c[1][0], kc[0])
    mut d = [[1, 2], [3, 4]]
    mut kd = d[1].copy()
    mut i = 1
    d[i][0] = d[i][0] + 10
    out.print("var-readwrite", d[1][0], kd[0])
    return 0


# s01_int_loop.my
func shape_s01(out: Stream) -> int:
    mut b = [[1, 2], [3, 4]]
    mut kb = b[1].copy()
    mut ka = b[0].copy()
    for i in range(2):
        b[i][0] = 7
    out.print(b[1][0], kb[0], b[0][0], ka[0])
    return 0


# s02_alias_inside_loop.my
func shape_s02(out: Stream) -> int:
    mut b = [[1, 2], [3, 4], [5, 6]]
    mut k = [0]
    for i in range(3):
        if i == 0:
            k = b[1].copy()
        b[i][0] = 9
    out.print(k[0], b[0][0], b[1][0], b[2][0])
    mut c = [[1, 2], [3, 4]]
    mut acc = 0
    for i in range(2):
        mut r = c[i].copy()
        c[i][0] = 0
        acc = acc + r[0] - c[i][0]
    out.print(acc, c[0][0] + 1)
    return 0


# s03_callee_alias.my
func row_s03(xs: int[][], i: int) -> int[]:
    return xs[i].copy()


func grab_s03(mut xs: int[][], i: int) -> int[]:
    xs[0][1] = xs[0][1] + 0
    return xs[i].copy()


func shape_s03(out: Stream) -> int:
    mut b = [[1, 2], [3, 4]]
    mut k = row_s03(b, 1)
    for i in range(2):
        b[i][0] = 7
    out.print(k[0], b[1][0])
    mut c = [[1, 2], [3, 4]]
    mut kc = grab_s03(mut c, 1)
    for i in range(2):
        c[i][0] = 7
    out.print(kc[0], c[1][0])
    return 0


# s04_record_items.my
record Bag_s04:
    n: int
    items: int[]


func shape_s04(out: Stream) -> int:
    mut xs = [Bag_s04(n=1, items=[1, 2]), Bag_s04(n=2, items=[3, 4])]
    mut kept = xs[1].copy()
    mut ki = xs[1].items.copy()
    for i in range(2):
        xs[i].items[0] = 7
    out.print(kept.items[0], xs[1].items[0], ki[0])
    mut ys = [Bag_s04(n=1, items=[1, 2]), Bag_s04(n=2, items=[3, 4])]
    mut ky = ys[1].items.copy()
    for i in range(2):
        ys[i].items.append(5)
    out.print(len(ky), len(ys[1].items) - 1)
    mut zs = [Bag_s04(n=1, items=[1]), Bag_s04(n=2, items=[3])]
    mut kz = zs[0].copy()
    for i in range(2):
        zs[i].n = 5
    out.print(kz.n, zs[0].n)
    return 0


# s05_append_aug.my
func shape_s05(out: Stream) -> int:
