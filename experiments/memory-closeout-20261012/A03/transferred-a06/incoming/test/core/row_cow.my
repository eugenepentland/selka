    mut rows = h.rows
    for i in range(2):
        rows[i][0] = 7
    out.print(kh[0], rows[1][0])
    return 0


# s08_comprehension.my
func shape_s08(out: Stream) -> int:
    mut b = [for i in range(3) yield [for j in range(2) yield i * 2 + j + 1]]
    mut k = b[1].copy()
    mut z = b[2].copy()
    for i in range(3):
        b[i][0] = 7
    out.print(k[0], b[1][0], z[0] - 5)
    return 0


# s09_append_filled.my
func shape_s09(out: Stream) -> int:
    mut b: int[][] = []
    for i in range(3):
        mut row: int[] = []
        for j in range(2):
            row.append(i * 2 + j + 1)
        b.append(row)
    mut k = b[1].copy()
    mut first = b[0].copy()
    for i in range(3):
        for j in range(2):
            b[i][j] = 7
    out.print(k[0], b[1][0], first[0])
    return 0


# s10_mut_param.my
func bump_s10(mut c: int[][], n: int):
    for i in range(n):
        c[i][0] = c[i][0] * 2


func bump_big_s10(mut c: int[][], n: int, out: Stream) effects(output, mutation):
    for i in range(n):
        mut j = 0
        while j < len(c[i]):
            c[i][j] = c[i][j] * 2
            j += 1
        if i > 100:
            out.print("never")


func shape_s10(out: Stream) -> int:
    mut b = [[1, 2], [3, 4]]
    mut k = b[1].copy()
    bump_s10(mut b, 2)
    bump_s10(mut b, 2)
    mut k2 = b[1].copy()
    bump_s10(mut b, 2)
    out.print(k[0], b[1][0] - 10, k2[0] - 9)
    mut c = [[1, 2], [3, 4]]
    mut kc = c[1].copy()
    bump_big_s10(mut c, 2, out)
    bump_big_s10(mut c, 2, out)
    out.print(kc[0], c[1][0] + 2)
    return 0


# s11_control.my
func early_s11(mut b: int[][], stop: int) -> int:
    for i in range(len(b)):
        if i == stop:
            return i
        b[i][0] = 7
    return -1


func shape_s11(out: Stream) -> int:
    mut b = [[1, 2], [3, 4], [5, 6]]
    mut k = b[1].copy()
    mut i = 0
    while i < 3:
        b[i][0] = 7
        i += 1
    out.print(k[0], b[1][0])
    mut c = [[1, 2], [3, 4], [5, 6]]
    mut kc = c[1].copy()
    for i2 in range(3):
        for j in range(2):
            if j == 1:
                continue
            c[i2][j] = 7
    out.print(kc[0], c[1][0])
    mut d = [[1, 2], [3, 4], [5, 6]]
    mut kd = d[1]
    for i3 in range(3):
        d[i3][0] = 7
        if i3 == 1:
            break
    out.print(kd[0], d[1][0])
    mut e = [[1, 2], [3, 4], [5, 6]]
    mut ke = e[1]
    mut stopped = early_s11(mut e, 2)
    out.print(ke[0], e[2][0] - 5 + stopped - 2)
    mut g = [[1, 2], [3, 4], [5, 6]]
    mut kg = g[1]
    mut n = 0
    for i4 in range(3):
        if i4 == 0:
            continue
        g[i4][0] = 7
        n += 1
    out.print(kg[0], g[1][0])
    return 0


# s12_other_iteration.my
func shape_s12(out: Stream) -> int:
    mut b = [[1, 2], [3, 4], [5, 6]]
    mut k = [0]
    for i in range(3):
        if i == 1:
            k = b[2]
        b[i][0] = 9
    out.print(k[0], b[2][0])
    mut c = [[1, 2], [3, 4], [5, 6]]
    mut kc = [0]
    mut i = 0
    while i < 3:
        c[i][0] = 9
        if i == 0:
            kc = c[2]
        i += 1
    out.print(kc[0], c[2][0])
    return 0


