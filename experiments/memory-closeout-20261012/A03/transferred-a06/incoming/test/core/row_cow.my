# s07_record_rows.my
record Grid_s07:
    w: int
    rows: int[][]


func shape_s07(out: Stream) -> int:
    mut g = Grid_s07(w=2, rows=[[1, 2], [3, 4]])
    mut k = g.rows[1]
    for i in range(2):
        g.rows[i][0] = 7
    out.print(k[0], g.rows[1][0])
