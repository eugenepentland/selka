diff --git a/src/core/a08_provider_cache_test.zig b/src/core/a08_provider_cache_test.zig
new file mode 100644
index 000000000..54cf2df87
--- /dev/null
+++ b/src/core/a08_provider_cache_test.zig
@@ -0,0 +1,141 @@
+//! Provider pin identities stay exact across durable lowering and catalog edits.
+const std = @import("std");
+const language = @import("mylang");
+const ir = @import("ir.zig");
+const build = @import("build.zig");
+const lowering = @import("lowering_cache.zig");
+const stage = @import("stage_store.zig");
+const provider = @import("aggregate_provider.zig");
+const ownership = @import("single_owner.zig");
+const support = @import("test_support.zig");
+const passes = @import("passes.zig");
+
+const source =
+    \\import filesystem
+    \\record Providers:
+    \\    fs: Filesystem
+    \\    label: str
+    \\func inspect(value: Providers) -> int:
+    \\    with value.fs.read_only() as frozen:
+    \\        if frozen.exists("absent"):
+    \\            return 1
+    \\        return 42
+    \\func main(out: Stream) -> int:
+    \\    const value = Providers(fs=filesystem.memory(), label="owner-" + str(1))
+    \\    out.print(inspect(value))
+    \\    return 0
+;
+
+const Entry = struct {
+    bytes: []const u8,
+    fn read(context: ?*anyopaque, a: std.mem.Allocator, path: []const u8, _: usize) language.project.ReadError![]u8 {
+        const self: *Entry = @ptrCast(@alignCast(context.?));
+        if (!std.mem.eql(u8, path, "main.my")) return error.NotFound;
+        return a.dupe(u8, self.bytes);
+    }
+};
+
+const Evidence = struct { lowered: usize, reused: usize, physical: ir.Type };
+
+fn pinType(module: *const ir.Module) !ir.Type {
+    var found: ?ir.Type = null;
+    for (module.functions.items) |function| {
+        if (!try provider.marker(module, &function)) continue;
+        const actual = provider.markerType(function.name).?;
+        try std.testing.expectEqual(actual, function.signature.params[0]);
+        if (found) |previous| try std.testing.expectEqual(previous, actual);
+        found = actual;
+    }
+    return found orelse error.TestUnexpectedResult;
+}
+
+fn compare(parent: std.mem.Allocator, store: *stage.Store, text: []const u8, execute: bool) !Evidence {
+    var arena = std.heap.ArenaAllocator.init(parent);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var entry: Entry = .{ .bytes = text };
+    var project: language.embedded_project.Program = undefined;
+    try project.init(a, .{ .context = &entry, .read = Entry.read });
+    const program = project.compilation.program.?;
+    var failure: ownership.Failure = .{};
+    try ownership.checkMode(a, program, &failure, true);
+    const input: build.Input = .{ .program = program, .source = project.compilation.src, .single_owner = true, .zero_rc = true };
+    var refusal: build.Refusal = .{};
+    var cache = lowering.Cache.init(store);
+    var cached = try build.buildExecutableCached(a, input, &refusal, &cache);
+    const fresh = try build.buildExecutable(a, input, &refusal);
+    try std.testing.expectEqualDeep(fresh.compounds.items, cached.compounds.items);
+    try std.testing.expectEqual(fresh.functions.items.len, cached.functions.items.len);
+    for (fresh.functions.items, cached.functions.items) |expected, actual| {
+        try std.testing.expectEqualStrings(expected.name, actual.name);
+        try std.testing.expectEqualDeep(expected.signature, actual.signature);
+    }
+    try std.testing.expectEqualStrings(try @import("print.zig").module(a, &fresh), try @import("print.zig").module(a, &cached));
+    const physical = try pinType(&cached);
+    try std.testing.expectEqual(try pinType(&fresh), physical);
+    if (execute) {
+        const result = try passes.debug(a, &cached);
+        try ownership.verifyLowered(&cached, &failure);
+        try support.verified(a, &cached, result.plans);
+        const out = program.functions[@backingInt(program.main)].scope.locals[0].ty.capabilityIndex().?;
+        const run = try support.runOwned(a, &cached, .{ .own = false, .analysis = support.analysis(&result), .main = .{ .parameters = &.{"out"}, .capabilities = &.{out} } });
+        try std.testing.expectEqual(@as(u8, 0), run.status);
+        try std.testing.expectEqualStrings("42\n", run.stdout);
+        try std.testing.expectEqualStrings("", run.stderr);
+        try std.testing.expect(@import("zero_rc.zig").emittedClean(run.llvm));
+        try std.testing.expect(std.mem.indexOf(u8, run.llvm, provider.prefix) == null);
+    }
+    return .{ .lowered = cache.lowered, .reused = cache.reused, .physical = physical };
+}
+
+// spec-case: NEW-CORE-ZERO-RC-ABI-1
+// spec-case: NEW-CORE-STAGE-CACHE-3
+// spec-case: NEW-CORE-ZERO-RC-PROVIDER-FIELDS-1
+test "zero RC A08 aggregate provider pins survive cache replay and earlier type discovery edits" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var temporary = std.testing.tmpDir(.{});
+    defer temporary.cleanup();
+    var store = try stage.Store.init(std.testing.allocator, std.testing.io, try temporary.dir.realPathFileAlloc(std.testing.io, ".", a));
+    defer store.deinit();
+    const declarations = try std.mem.replaceOwned(u8, a, source, "record Providers:", "record Earlier:\n    values: bytes[]\nrecord Providers:");
+    const edited = try std.mem.replaceOwned(u8, a, declarations, "    const value = Providers", "    const earlier = Earlier(values=[b\"a\", b\"b\"])\n    assert len(earlier.values) == 2\n    const value = Providers");
+    var types: [2]ir.Type = undefined;
+    for ([_][]const u8{ source, edited }, 0..) |text, index| {
+        const cold = try compare(std.testing.allocator, &store, text, false);
+        const warm = try compare(std.testing.allocator, &store, text, true);
+        try std.testing.expect(cold.lowered > 0);
+        try std.testing.expectEqual(@as(usize, 0), warm.lowered);
+        try std.testing.expect(warm.reused > 0);
+        try std.testing.expectEqual(cold.physical, warm.physical);
+        types[index] = cold.physical;
+    }
+    try std.testing.expect(types[0] != types[1]);
+}
+
+// spec-case: NEW-CORE-ZERO-RC-ABI-1
+test "zero RC A08 aggregate provider pins refuse stale physical type and ownership signatures" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var module: ir.Module = .{ .zero_rc = true, .single_owner = true };
+    const first = try module.intern(a, .{ .record = &.{ .capability, .str } });
+    const second = try module.intern(a, .{ .record = &.{ .capability, .i64 } });
+    var function: ir.Function = .{ .name = try std.fmt.allocPrint(a, "{s}{d}", .{ provider.prefix, @backingInt(first) }), .signature = .{ .params = &.{first}, .ret = .void, .linkage = .runtime_c } };
+    try std.testing.expect(try provider.marker(&module, &function));
+    const valid = function.signature;
+    const invalid = [_]ir.Signature{
+        .{ .params = &.{second}, .ret = .void, .linkage = .runtime_c },
+        .{ .params = &.{first}, .ret = .void, .linkage = .runtime_c, .owned = 1 },
+        .{ .params = &.{first}, .ret = .void, .linkage = .runtime_c, .consumes = 1 },
+        .{ .params = &.{first}, .ret = .void, .linkage = .runtime_c, .views = 1 },
+    };
+    for (invalid) |signature| {
+        function.signature = signature;
+        try std.testing.expectError(error.UnsupportedInstruction, provider.marker(&module, &function));
+    }
+    function.signature = valid;
+    module.zero_rc = false;
+    try std.testing.expectError(error.UnsupportedInstruction, provider.marker(&module, &function));
+}
diff --git a/src/core/aggregate_provider.zig b/src/core/aggregate_provider.zig
new file mode 100644
index 000000000..3993d3149
--- /dev/null
+++ b/src/core/aggregate_provider.zig
@@ -0,0 +1,133 @@
+//! Provider lifetimes follow an enclosing owned record, with no field-sensitive loans.
+const std = @import("std");
+const typed = @import("mylang").typed;
+const ir = @import("ir.zig");
+const none = std.math.maxInt(usize);
+
+/// Compiler-only borrowed marker; its physical type is part of the exact identity.
+pub const prefix = "myl_core_provider_pin_";
+
+/// Streams and Host are scalar tokens; other capabilities own native provider state.
+pub fn leaf(ty: typed.Type) bool {
+    return ty.capabilityIndex() != null and !ty.isStream() and ty != .host_cap;
+}
+
+const Edge = struct { parent: usize, next: usize };
+const Graph = struct {
+    allocator: std.mem.Allocator,
+    heads: []usize,
+    marked: []bool,
+    edges: std.ArrayList(Edge) = .empty,
+
+    fn add(self: *Graph, parent: usize, child: typed.Type) !void {
+        if (leaf(child)) {
+            self.marked[parent] = true;
+        } else if (child.isAggregate()) {
+            const index = child.recordIndex();
+            try self.edges.append(self.allocator, .{ .parent = parent, .next = self.heads[index] });
+            self.heads[index] = self.edges.items.len - 1;
+        }
+    }
+
+    fn record(self: *Graph, parent: usize, value: typed.Record) !void {
+        for (value.fields) |field| try self.add(parent, field.ty);
+        if (value.shape.buffer) |element| try self.add(parent, element);
+        if (value.collection.key) |key| try self.add(parent, key);
+        if (value.shape.array) |array| try self.add(parent, array.element);
+        if (value.shape.variants) |variants| for (variants.cases) |variant| {
+            if (variant.payload) |payload| try self.add(parent, payload);
+        };
+        if (value.shape.domain) |wire| try self.add(parent, wire);
+    }
+};
+
+/// Find provider-containing source types once, in O(types + storage edges).
+/// Cycles cannot cache an incomplete false result: seeds propagate over reverse edges.
+pub fn classify(a: std.mem.Allocator, program: typed.Program) std.mem.Allocator.Error![]bool {
+    const marked = try a.alloc(bool, program.records.len);
+    errdefer a.free(marked);
+    @memset(marked, false);
+    const heads = try a.alloc(usize, marked.len);
+    defer a.free(heads);
+    @memset(heads, none);
+    var graph: Graph = .{ .allocator = a, .heads = heads, .marked = marked };
+    defer graph.edges.deinit(a);
+    for (program.records, 0..) |record, parent| try graph.record(parent, record);
+    var queue: std.ArrayList(usize) = .empty;
+    defer queue.deinit(a);
+    for (marked, 0..) |present, index| if (present) try queue.append(a, index);
+    var cursor: usize = 0;
+    while (cursor < queue.items.len) : (cursor += 1) {
+        var edge = heads[queue.items[cursor]];
+        while (edge != none) {
+            const item = graph.edges.items[edge];
+            if (!marked[item.parent]) {
+                marked[item.parent] = true;
+                try queue.append(a, item.parent);
+            }
+            edge = item.next;
+        }
+    }
+    return marked;
+}
+
+/// Query the completed source-type facts without traversing another type graph.
+pub fn contains(facts: []const bool, ty: typed.Type) bool {
+    return leaf(ty) or (ty.isAggregate() and facts[ty.recordIndex()]);
+}
+
+/// Scoped field providers must be projections of a named local, not temporaries.
+pub fn root(program: typed.Program, source: typed.NodeId) ?typed.LocalId {
+    var cursor = source;
+    while (true) switch (program.nodes[@backingInt(cursor)].data) {
+        .local => |slot| return slot,
+        .field => |field| cursor = field.base,
+        else => return null,
+    };
+}
+
+/// Admit provider ownership only through ordinary record fields in this closeout.
+pub fn plainRecord(record: typed.Record) bool {
+    if (record.managed or record.collection.box or record.isCollection()) return false;
+    if (record.shape.array != null or record.shape.variants != null or record.shape.resource != null) return false;
+    if (record.shape.domain != null or record.contract.callback != null) return false;
+    for (record.fields) |field| if (field.boxed) return false;
+    return true;
+}
+
+/// Parse only a canonical generated physical-type identity, never an open prefix.
+pub fn markerType(symbol: []const u8) ?ir.Type {
+    if (!std.mem.startsWith(u8, symbol, prefix)) return null;
+    const number = symbol[prefix.len..];
+    if (number.len == 0 or number[0] == '0') return null;
+    for (number) |byte| if (byte < '0' or byte > '9') return null;
+    const id = std.fmt.parseInt(u32, number, 10) catch return null;
+    const ty: ir.Type = @fromBackingInt(id);
+    return if (ty.isCompound()) ty else null;
+}
+
+/// Validate the complete borrowed compiler marker before omitting its machine code.
+pub fn marker(module: *const ir.Module, function: *const ir.Function) error{UnsupportedInstruction}!bool {
+    if (!std.mem.startsWith(u8, function.name, prefix)) return false;
+    if (!module.zero_rc) return error.UnsupportedInstruction;
+    const ty = markerType(function.name) orelse return error.UnsupportedInstruction;
+    if (@backingInt(ty) - ir.Type.first_compound >= module.compounds.items.len) return error.UnsupportedInstruction;
+    const signature = function.signature;
+    if (module.kind(ty) != .record or signature.linkage != .runtime_c or signature.ret != .void) return error.UnsupportedInstruction;
+    if (signature.params.len != 1 or signature.params[0] != ty) return error.UnsupportedInstruction;
+    if (signature.owned != 0 or signature.consumes != 0 or signature.views != 0) return error.UnsupportedInstruction;
+    return true;
+}
+
+/// Core observes this borrow until lexical cleanup; emitted code needs no operation.
+pub fn call(module: *const ir.Module, inst: ir.Inst) error{UnsupportedInstruction}!bool {
+    if (inst.op != .call) return false;
+    return marker(module, &module.functions.items[inst.a.index()]);
+}
+
+/// Pin the current SSA owner without copying, retaining or inspecting its children.
+pub fn keepalive(comptime Context: type, builder: Context, value: ir.Ref, span: u32) error{ OutOfMemory, Unsupported }!void {
+    const ty = builder.typeOfRef(value);
+    const symbol = if (ty == .capability) "myl_core_provider_keepalive" else try std.fmt.allocPrint(builder.allocator(), "{s}{d}", .{ prefix, @backingInt(ty) });
+    _ = try builder.effectCall(symbol, &.{ty}, .void, &.{value}, span);
+}
