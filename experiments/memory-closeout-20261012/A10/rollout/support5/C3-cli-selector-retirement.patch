+    try std.testing.expectEqualStrings("--experimental-single-owner", retiredOwnershipFlag(&.{"--experimental-single-owner=true"}).?);
+    try std.testing.expect(retiredOwnershipFlag(&.{ "--", "--experimental-zero-rc" }) == null);
+}
