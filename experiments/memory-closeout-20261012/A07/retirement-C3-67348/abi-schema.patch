+//! The only executable guest ABI. Persisted records require this provenance.
+
+/// Explicit nonzero wire tag; legacy boolean and unknown receipts cannot decode.
+pub const Abi = enum(u32) { checked_owned_v1 = 0x4f574e31 };
+
+/// All in-memory construction and linked units use this fixed ABI.
+pub const current: Abi = .checked_owned_v1;
+
+/// Native text and artifact identities must carry this exact versioned marker.
+pub const identity = "mylang-checked-owned-v1";
