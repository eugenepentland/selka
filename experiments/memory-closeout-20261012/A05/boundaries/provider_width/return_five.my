# spec-case: CAPABILITY-FIELD-METHOD-1
import filesystem
import environment
import network
import time
import random

record Ports:
    fs: Filesystem
    env: Environment
    net: Network
    clock: Clock
    entropy: Entropy

func make_ports() -> Ports:
    return Ports(fs=filesystem.memory(), env=environment.fixed({"LANG":"C"}), net=network.denied(), clock=time.simulated_clock(time.from_unix_nanoseconds(42)), entropy=random.seeded_entropy(7))

func main() -> int:
    const ports = make_ports()
    assert not ports.fs.exists("missing")
    return 0
