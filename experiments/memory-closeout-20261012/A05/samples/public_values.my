# spec-case: STANDARD-MEMO-1
# spec-case: STANDARD-DURABLE-1
# spec-case: STANDARD-TIME-RANDOM-1
import cache_record
import durable
import memo
import persistent_memo
import random
import time

func number(key: memo.Key) -> int effects():
    match key:
        case memo.Key.Number(value=value):
            return value
        case memo.Key.Text(value=value):
            return len(value)
        case memo.Key.Data(value=value):
            return len(value)

func main() -> int:
    const entry = memo.Entry[int](compute=number, key=memo.Key.Number(value=42), value=42)
    mut cache = memo.Cache[int](compute=number, entries=[entry], max_entries=1, next=0)
    const expected = memo.Lookup[int](value=42, reused=True)
    assert memo.call(mut cache, memo.Key.Number(value=42)) == expected
    mut copied_cache = cache.copy()
    memo.clear(mut copied_cache)
    assert memo.count(cache) == 1 and memo.count(copied_cache) == 0
    mut generator = random.Random(state=[0u64])
    mut copied_generator = generator.copy()
    assert random.next_word(mut generator) == random.next_word(mut copied_generator)
    const span = time.Duration(nanoseconds=7)
    const instant = time.Instant(unix_nanoseconds=11)
    assert span.nanoseconds == 7 and instant.unix_nanoseconds == 11
    assert len(cache_record.message(cache_record.Error.Corrupt)) != 0
    const options = persistent_memo.Options(max_entries=0, max_bytes=1)
    const found = persistent_memo.Lookup(value=b"value", reused=False)
    assert options.max_entries == 0 and not found.reused and found.value == b"value"
    const step = durable.Step(output=b"ab", state=b"cd")
    const request = durable.Request(input=b"ab", chunks=[b"a", b"b"], initial_state=b"", output_path="result", max_bytes=8)
    mut report = durable.Report(fresh=2, reused=0, output_digest="dynamic-" + str(7), state=step.state.copy())
    const saved = report.copy()
    report.state = b"replaced"
    assert saved.state == b"cd" and saved.output_digest == "dynamic-7"
    assert len(request.chunks) == 2 and report.fresh == 2
    return 0
