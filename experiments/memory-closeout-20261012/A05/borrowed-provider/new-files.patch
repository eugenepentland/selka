+    function.insts.items[index] = .{ .op = .record_set, .ty = function.inst(f.value).ty, .a = alias, .b = f.first, .data = 0 };
+    try std.testing.expectError(error.UnsupportedInstruction, borrowed.validate(a, &f.module, function));
+}
