module text_0027

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def score(text: str) -> int:
    value = len(text)
    for octet in text.encode():
        value += octet ^ 7
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "\né|Ω\r 🙂é\nééΩΩΩ\rΩ\r\n|Bé\r\n\naa|ΩBΩ\r\t|é|é\réΩ"
    changed = original
    for j in range(seed % 7):
        if j % 3 == 0:
            alias = changed
            changed += alias
        else:
            changed += "é🙂a"
    rebuilt = ""
    for ch in changed:
        rebuilt += ch
    fused = "\0é€🙂" + changed
    fused_rebuilt = ""
    selected = ""
    matches = 0
    for ch in fused:
        if ch == "🙂":
            matches += 1
            fused_rebuilt += ch
            selected += ch
        elif ch != "€":
            fused_rebuilt += ch
            selected += "."
        else:
            fused_rebuilt += ch
            selected += ch
    saved = fused_rebuilt
    fused_rebuilt += "é"
    sliced = changed[36:33]
    parts = changed.split("|")
    value = score(original) + score(changed) + score(rebuilt) + score(sliced) + score("::".join(parts))
    value += score(fused_rebuilt) + score(selected) + score(saved) + matches
    value += changed.find("Ω") + len(parts)
    value += changed.count("Ω", 36, 33) + changed.rfind("Ω", 36, 33)
    value += score(changed.upper()) + score(changed.lower()) + score(changed.strip())
    value += score(changed.strip("éΩ🙂aB")) + score(changed.lstrip("éΩ🙂aB")) + score(changed.rstrip("éΩ🙂aB"))
    value += score(changed.replace("é", "🙂x")) + score(repr(changed)) + score(repr(changed.encode()))
    value += score(changed[::-1]) + score(changed[36:33:3])
    value += score("|".join(changed.splitlines()))
    value += score(chr(ord("🙂"))) + score(changed.zfill(40))
    value += score(f"{changed:*>20.7}")
    if changed.isdigit() or changed.isalpha() or changed.isspace():
        value += 17
    if changed.startswith("Ω", 36, 33) or changed.endswith("Ω", 36, 33):
        value += 31
    if changed.find("Ω") >= 0:
        value += changed.index("Ω") + changed.rindex("Ω")
    raw = changed.encode()
    value += raw.count(b"a", 36, 33) + raw.rfind(b"a", 36, 33)
    value += raw.find_any(b"|aB", 36) + len(raw.strip()) + len(raw.view(36, 33))
    match raw.decode():
        case Ok(text):
            value += score(text)
        case Err(text):
            value -= score(text)
    match raw.scalar_count():
        case Ok(count):
            value += count
        case Err(text):
            value -= score(text)
    match raw.scalar_count_range(36, 33):
        case Ok(count):
            value += count
        case Err(text):
            value += score(text)
    match b"a\xffz".scalar_count():
        case Ok(count):
            value -= count
        case Err(text):
            value += score(text)
    reversed_parts = parts
    reversed_parts.extend(parts)
    reversed_parts.reverse()
    value += score("/".join(reversed_parts))
    out.print(value)
    return 0
