module split_0038

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long08éabcdefghijklmnop\rlong07éabcdefghijklmnop\nb  b\rcollision002553\rnaïve\nΩ long04éabcdefghijklmnop\x0blong07éabcdefghijklmnop  😀\x0clong03éabcdefghijklmnop  long00éabcdefghijklmnop\nlong05éabcdefghijklmnop\x0bx y\x0clong01éabcdefghijklmnop\x0bcollision002553\x0blong03éabcdefghijklmnop long00éabcdefghijklmnop\rlong04éabcdefghijklmnop\nlong02éabcdefghijklmnop long03éabcdefghijklmnop\x0blong09éabcdefghijklmnop\nlong05éabcdefghijklmnop\x0cΩ  long08éabcdefghijklmnop\ttail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
