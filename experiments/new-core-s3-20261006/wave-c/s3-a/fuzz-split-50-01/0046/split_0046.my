module split_0046

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "b\tcafé long06éabcdefghijklmnop\x0bcollision005a0e\nΩ collision002553\x0bnaïve  Ω\tlong06éabcdefghijklmnop\nlong04éabcdefghijklmnop\x0ccafé\rlong01éabcdefghijklmnop\x0blong00éabcdefghijklmnop\x0blong08éabcdefghijklmnop\x0clong06éabcdefghijklmnop\rlong00éabcdefghijklmnop\rlong02éabcdefghijklmnop  long03éabcdefghijklmnop\tlong10éabcdefghijklmnop\tlong05éabcdefghijklmnop\x0bb collision005a0e\ra\tΩ\x0cx y\x0blong01éabcdefghijklmnop\nnaïve naïve  long10éabcdefghijklmnop long01éabcdefghijklmnop\x0clong04éabcdefghijklmnop long03éabcdefghijklmnop\x0clong02éabcdefghijklmnop collision002553  long04éabcdefghijklmnop\x0blong03éabcdefghijklmnop\ta  café\x0cb naïve\x0btail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
