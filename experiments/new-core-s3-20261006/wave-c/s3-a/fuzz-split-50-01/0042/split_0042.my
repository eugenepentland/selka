module split_0042

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "x y\rΩ\x0cΩ\tcafé\x0blong05éabcdefghijklmnop\rb  b\x0c😀 x y\na\rlong04éabcdefghijklmnop\x0clong03éabcdefghijklmnop  naïve\rb  café\x0bb 😀  long01éabcdefghijklmnop  naïve\x0bcollision005a0e  a\tlong02éabcdefghijklmnop b\x0clong01éabcdefghijklmnop long04éabcdefghijklmnop\tcafé\x0bΩ\tlong03éabcdefghijklmnop\x0cΩ\x0ccollision005a0e\tcollision005a0e\x0clong00éabcdefghijklmnop\rlong00éabcdefghijklmnop\rx y  café\x0cb\x0ca\rcollision002553\nnaïve\x0clong01éabcdefghijklmnop Ω\x0clong04éabcdefghijklmnop\x0ca\x0c "
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
