module split_0021

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long08éabcdefghijklmnop\rlong08éabcdefghijklmnop\x0clong07éabcdefghijklmnop\x0bΩ\tb\x0bb\nx y\x0blong09éabcdefghijklmnop  long02éabcdefghijklmnop\x0blong01éabcdefghijklmnop\x0bΩ\tx y\tcollision005a0e\x0bb  x y\x0blong08éabcdefghijklmnop\nlong04éabcdefghijklmnop\x0blong01éabcdefghijklmnop\tcollision002553\t😀 long03éabcdefghijklmnop long06éabcdefghijklmnop\rlong07éabcdefghijklmnop\x0b😀\nlong09éabcdefghijklmnop\rlong02éabcdefghijklmnop  Ω\tlong04éabcdefghijklmnop a\rcollision002553 long04éabcdefghijklmnop a\x0blong09éabcdefghijklmnop\tb\t😀\x0blong02éabcdefghijklmnop\né"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
