module split_0013

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long09éabcdefghijklmnop\rlong09éabcdefghijklmnop\tnaïve\nlong05éabcdefghijklmnop\nΩ\rlong07éabcdefghijklmnop\x0clong01éabcdefghijklmnop\x0ccafé  café\tlong07éabcdefghijklmnop\tcollision005a0e\x0clong07éabcdefghijklmnop long01éabcdefghijklmnop long00éabcdefghijklmnop\ra\nΩ long10éabcdefghijklmnop long07éabcdefghijklmnop long11éabcdefghijklmnop  x y x y\x0blong08éabcdefghijklmnop\tcollision005a0e café long09éabcdefghijklmnop\tlong03éabcdefghijklmnop\t😀 collision005a0e\tnaïve\nx y\x0cnaïve\rlong06éabcdefghijklmnop  x y\x0bcollision002553  long10éabcdefghijklmnop\tb  long03éabcdefghijklmnop long11éabcdefghijklmnop long10éabcdefghijklmnop\x0clong10éabcdefghijklmnop\x0bcafé collision005a0e\nlong01éabcdefghijklmnop  long02éabcdefghijklmnop\nlong03éabcdefghijklmnop\ra\tΩ\rlong11éabcdefghijklmnop\tcollision005a0e\ncollision002553 café\n "
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
