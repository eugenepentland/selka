module split_0014

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "collision005a0e\x0blong03éabcdefghijklmnop long02éabcdefghijklmnop\x0c😀  long05éabcdefghijklmnop collision005a0e long01éabcdefghijklmnop long06éabcdefghijklmnop\x0ba Ω\x0bb\x0blong07éabcdefghijklmnop\x0clong08éabcdefghijklmnop\tcollision002553  long07éabcdefghijklmnop long05éabcdefghijklmnop  long08éabcdefghijklmnop  Ω\rcollision005a0e\tlong04éabcdefghijklmnop\rlong05éabcdefghijklmnop  b\nlong03éabcdefghijklmnop\x0clong01éabcdefghijklmnop\rx y\n😀\x0blong03éabcdefghijklmnop\x0ccollision005a0e\rlong05éabcdefghijklmnop\rlong08éabcdefghijklmnop\t😀\rlong04éabcdefghijklmnop\ttail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
