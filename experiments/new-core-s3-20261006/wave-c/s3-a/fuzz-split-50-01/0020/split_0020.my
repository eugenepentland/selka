module split_0020

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long03éabcdefghijklmnop\tnaïve\x0blong01éabcdefghijklmnop\nb\x0b😀 a\x0ccollision002553\x0blong03éabcdefghijklmnop  long00éabcdefghijklmnop long01éabcdefghijklmnop\x0ca\rcollision005a0e\rnaïve\nlong02éabcdefghijklmnop\x0ccollision005a0e\tlong00éabcdefghijklmnop  long00éabcdefghijklmnop\nlong03éabcdefghijklmnop collision005a0e  long02éabcdefghijklmnop\tnaïve\x0cb\x0ba long00éabcdefghijklmnop long01éabcdefghijklmnop  collision002553\t😀 😀  Ω  Ω\nlong02éabcdefghijklmnop\x0bcollision005a0e collision002553\x0b😀\t "
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
