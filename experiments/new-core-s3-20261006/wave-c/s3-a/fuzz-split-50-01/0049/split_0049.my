module split_0049

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long04éabcdefghijklmnop long01éabcdefghijklmnop\x0clong03éabcdefghijklmnop\x0clong10éabcdefghijklmnop\rlong02éabcdefghijklmnop\tlong02éabcdefghijklmnop\nlong05éabcdefghijklmnop\x0c😀\nb  café\nlong00éabcdefghijklmnop\rlong09éabcdefghijklmnop long06éabcdefghijklmnop  a\tΩ\rΩ\rlong02éabcdefghijklmnop\x0clong09éabcdefghijklmnop\tnaïve\x0bnaïve\rlong02éabcdefghijklmnop\x0bnaïve  naïve\nlong02éabcdefghijklmnop\nlong09éabcdefghijklmnop long00éabcdefghijklmnop\rlong00éabcdefghijklmnop\tlong01éabcdefghijklmnop\rcollision002553 collision002553\x0blong08éabcdefghijklmnop\tcollision005a0e\tx y collision002553\x0blong01éabcdefghijklmnop\nnaïve  x y\x0blong04éabcdefghijklmnop\x0bcollision002553  long10éabcdefghijklmnop\rcollision002553\x0clong08éabcdefghijklmnop\nlong08éabcdefghijklmnop\rlong07éabcdefghijklmnop long04éabcdefghijklmnop\x0ccafé\nx y\nlong09éabcdefghijklmnop\x0blong00éabcdefghijklmnop\nlong10éabcdefghijklmnop\tx y  long07éabcdefghijklmnop long05éabcdefghijklmnop  é"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
