module split_0006

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "naïve\r😀  x y\x0bcollision005a0e long10éabcdefghijklmnop\x0blong09éabcdefghijklmnop long04éabcdefghijklmnop\x0c😀 long03éabcdefghijklmnop long05éabcdefghijklmnop long02éabcdefghijklmnop long06éabcdefghijklmnop\x0bcafé\x0clong04éabcdefghijklmnop\tlong01éabcdefghijklmnop  long06éabcdefghijklmnop\tlong08éabcdefghijklmnop  café\rlong06éabcdefghijklmnop\x0blong07éabcdefghijklmnop\x0blong05éabcdefghijklmnop\x0clong02éabcdefghijklmnop long00éabcdefghijklmnop  long04éabcdefghijklmnop x y\rcafé\x0blong08éabcdefghijklmnop\x0blong10éabcdefghijklmnop long03éabcdefghijklmnop  long00éabcdefghijklmnop\x0blong06éabcdefghijklmnop\rnaïve\rΩ\ra\ra\rΩ\x0blong05éabcdefghijklmnop\ré"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
