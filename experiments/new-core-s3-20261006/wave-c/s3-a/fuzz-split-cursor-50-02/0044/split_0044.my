module split_0044

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long11éabcdefghijklmnop\tcollision005a0e\rlong00éabcdefghijklmnop  café\tlong03éabcdefghijklmnop  naïve\rlong02éabcdefghijklmnop\nlong06éabcdefghijklmnop\rlong11éabcdefghijklmnop\tcollision005a0e\x0bcollision005a0e\x0bx y\rΩ\nlong09éabcdefghijklmnop\nlong02éabcdefghijklmnop\tcafé\tlong01éabcdefghijklmnop 😀\x0cnaïve\x0cnaïve\x0blong00éabcdefghijklmnop  long12éabcdefghijklmnop  collision005a0e  naïve\x0clong01éabcdefghijklmnop\x0ccollision002553\rlong01éabcdefghijklmnop  long07éabcdefghijklmnop  long04éabcdefghijklmnop\x0b😀\tlong11éabcdefghijklmnop\tcafé\tlong05éabcdefghijklmnop\tx y\nlong02éabcdefghijklmnop  naïve\x0blong10éabcdefghijklmnop\x0blong10éabcdefghijklmnop\x0blong11éabcdefghijklmnop\nlong10éabcdefghijklmnop\r😀 café\t😀\x0clong10éabcdefghijklmnop\nlong05éabcdefghijklmnop\x0clong03éabcdefghijklmnop\x0clong04éabcdefghijklmnop\x0blong06éabcdefghijklmnop long10éabcdefghijklmnop\ncollision005a0e\rlong06éabcdefghijklmnop\x0ctail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
