module split_0029

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long00éabcdefghijklmnop\rlong02éabcdefghijklmnop\tnaïve\rlong02éabcdefghijklmnop\rlong06éabcdefghijklmnop\tcollision002553\tlong05éabcdefghijklmnop\x0ccollision002553\rlong02éabcdefghijklmnop\nlong03éabcdefghijklmnop\rlong06éabcdefghijklmnop\ncafé\x0blong03éabcdefghijklmnop\nlong03éabcdefghijklmnop café long05éabcdefghijklmnop café\x0clong06éabcdefghijklmnop\rlong02éabcdefghijklmnop\rcollision005a0e\ncollision005a0e  collision005a0e\tb  long00éabcdefghijklmnop\x0blong05éabcdefghijklmnop\x0clong05éabcdefghijklmnop 😀\rΩ  collision005a0e\x0clong00éabcdefghijklmnop\x0ccafé\rx y\x0cé"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
