module split_0047

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long02éabcdefghijklmnop\nlong00éabcdefghijklmnop\nlong05éabcdefghijklmnop long08éabcdefghijklmnop\nnaïve  long00éabcdefghijklmnop\nlong10éabcdefghijklmnop\x0cb\x0ba\x0clong08éabcdefghijklmnop\x0clong06éabcdefghijklmnop\nlong09éabcdefghijklmnop\x0blong04éabcdefghijklmnop  long11éabcdefghijklmnop\x0clong04éabcdefghijklmnop  long07éabcdefghijklmnop\na long10éabcdefghijklmnop collision005a0e\rlong10éabcdefghijklmnop  long04éabcdefghijklmnop\n😀\rlong06éabcdefghijklmnop\rlong00éabcdefghijklmnop\x0blong09éabcdefghijklmnop\r😀\nx y  long03éabcdefghijklmnop\rlong06éabcdefghijklmnop long05éabcdefghijklmnop\tlong11éabcdefghijklmnop\tlong05éabcdefghijklmnop\nx y\x0clong00éabcdefghijklmnop\né"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
