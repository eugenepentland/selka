module split_0025

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long02éabcdefghijklmnop collision005a0e\x0blong01éabcdefghijklmnop long00éabcdefghijklmnop\tcollision005a0e\x0cnaïve\x0blong03éabcdefghijklmnop\nlong00éabcdefghijklmnop\rcollision005a0e b\rlong03éabcdefghijklmnop b\tcollision002553\tlong00éabcdefghijklmnop\x0bnaïve\tlong01éabcdefghijklmnop café\tlong01éabcdefghijklmnop\r😀\x0cb b collision005a0e\x0cΩ\nx y\tΩ\rlong00éabcdefghijklmnop  collision005a0e\x0blong01éabcdefghijklmnop\tcollision002553  😀\tlong02éabcdefghijklmnop\na\x0blong01éabcdefghijklmnop\rx y\nx y  a  long00éabcdefghijklmnop\x0blong03éabcdefghijklmnop  tail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
