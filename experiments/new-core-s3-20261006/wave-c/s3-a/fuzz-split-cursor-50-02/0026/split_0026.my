module split_0026

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long09éabcdefghijklmnop  long00éabcdefghijklmnop\tb\tcafé\nΩ  long04éabcdefghijklmnop\rlong03éabcdefghijklmnop\x0clong04éabcdefghijklmnop\x0blong10éabcdefghijklmnop\rlong01éabcdefghijklmnop\x0bcafé\ncafé long02éabcdefghijklmnop\tlong11éabcdefghijklmnop\rcollision005a0e\x0bx y x y  long11éabcdefghijklmnop  long07éabcdefghijklmnop\tlong10éabcdefghijklmnop\x0clong00éabcdefghijklmnop\rlong07éabcdefghijklmnop\nlong06éabcdefghijklmnop Ω\nnaïve\tcafé long10éabcdefghijklmnop\x0bcafé\x0bΩ long09éabcdefghijklmnop\r😀\tlong01éabcdefghijklmnop\rcollision005a0e\x0blong02éabcdefghijklmnop long11éabcdefghijklmnop\x0blong01éabcdefghijklmnop\tlong00éabcdefghijklmnop tail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
