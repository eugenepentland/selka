module split_0007

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "naïve\x0c😀\na\rb\x0blong04éabcdefghijklmnop collision005a0e\nlong08éabcdefghijklmnop\x0clong08éabcdefghijklmnop\rlong07éabcdefghijklmnop\x0bcollision002553\x0clong09éabcdefghijklmnop long07éabcdefghijklmnop\tlong03éabcdefghijklmnop  long12éabcdefghijklmnop\x0ccafé  😀\x0clong04éabcdefghijklmnop\na\x0bcollision005a0e\rx y\rlong11éabcdefghijklmnop\x0clong11éabcdefghijklmnop  café\x0blong02éabcdefghijklmnop\tlong04éabcdefghijklmnop\tlong11éabcdefghijklmnop\x0blong04éabcdefghijklmnop\x0blong06éabcdefghijklmnop\tcollision002553\nlong06éabcdefghijklmnop collision005a0e\x0clong08éabcdefghijklmnop\rlong00éabcdefghijklmnop  café\rcollision005a0e\ra\x0b😀\nlong07éabcdefghijklmnop\tlong07éabcdefghijklmnop\tcollision002553\x0btail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
