module text_0005

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "collision002553\t😀\x0clong03éabcdefghijklmnop\nb\rlong08éabcdefghijklmnop\ra\tlong00éabcdefghijklmnop  long08éabcdefghijklmnop\tΩ  collision002553\tlong08éabcdefghijklmnop  collision005a0e\x0clong10éabcdefghijklmnop long11éabcdefghijklmnop\ta  long02éabcdefghijklmnop\rlong06éabcdefghijklmnop\tcollision002553\x0clong11éabcdefghijklmnop\x0bcafé  😀\x0bcafé\x0clong08éabcdefghijklmnop\x0clong01éabcdefghijklmnop  😀 long07éabcdefghijklmnop\x0ba\tlong00éabcdefghijklmnop\x0ccafé  long04éabcdefghijklmnop collision005a0e  long10éabcdefghijklmnop\x0blong01éabcdefghijklmnop\nΩ\ncollision002553\x0clong09éabcdefghijklmnop  long09éabcdefghijklmnop Ω\tcollision005a0e\x0c"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
