module text_0124

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "naïve\x0bnaïve\x0bcollision005a0e\x0blong02éabcdefghijklmnop\nlong01éabcdefghijklmnop\x0b😀\rΩ\x0cb b  naïve\ncollision005a0e\rcafé\rcollision005a0e\rΩ\tlong00éabcdefghijklmnop\rx y\x0ccafé a  collision005a0e\ra\ncollision005a0e\tcafé\x0blong01éabcdefghijklmnop café\x0cb\na\x0clong00éabcdefghijklmnop\x0bx y  b\tcafé 😀\x0bcollision005a0e\x0ccollision005a0e\x0cb  "
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
