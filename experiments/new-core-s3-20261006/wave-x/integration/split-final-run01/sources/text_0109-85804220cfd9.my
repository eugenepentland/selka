module text_0109

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long05éabcdefghijklmnop collision002553  collision005a0e\tlong03éabcdefghijklmnop\tlong05éabcdefghijklmnop café\x0cb\x0bnaïve\rlong06éabcdefghijklmnop\nΩ\ncollision005a0e  café\rcafé\tcafé  long00éabcdefghijklmnop 😀  long02éabcdefghijklmnop\x0cx y\x0blong01éabcdefghijklmnop\rcollision005a0e  x y\tcollision005a0e\x0clong04éabcdefghijklmnop\tcollision002553\rΩ\x0b "
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
