module text_0083

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "naïve\x0ba\x0blong01éabcdefghijklmnop  Ω  Ω\x0cnaïve\rcollision002553\x0c😀\x0ca\x0clong01éabcdefghijklmnop\x0clong00éabcdefghijklmnop\tcafé\tcollision005a0e café\tlong00éabcdefghijklmnop\r😀\tlong01éabcdefghijklmnop café\tcollision005a0e\rlong00éabcdefghijklmnop\nΩ\x0blong01éabcdefghijklmnop\tx y\x0b😀\ncollision002553\x0c😀\x0clong01éabcdefghijklmnop\x0bb  collision005a0e\rΩ\rlong01éabcdefghijklmnop\ta\x0c😀 café\x0ccollision005a0e\ncafé\x0c😀\tb\x0ba\x0blong01éabcdefghijklmnop\tb\x0cb\n😀  collision005a0e\x0cΩ  long01éabcdefghijklmnop\té"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
