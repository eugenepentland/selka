module text_0047

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "collision002553\tb\nnaïve\x0cb\n😀 café  x y\tcafé  long03éabcdefghijklmnop\ncafé\ncollision002553 a a\x0blong00éabcdefghijklmnop x y long00éabcdefghijklmnop\ra\nlong06éabcdefghijklmnop  long01éabcdefghijklmnop  collision005a0e  😀\tb\x0ccollision002553\x0c😀\rlong03éabcdefghijklmnop  café\nlong01éabcdefghijklmnop\rcollision005a0e\rlong04éabcdefghijklmnop\x0blong05éabcdefghijklmnop\nlong03éabcdefghijklmnop naïve  long05éabcdefghijklmnop\rcafé\n😀\x0blong01éabcdefghijklmnop\ta\x0blong05éabcdefghijklmnop\rlong01éabcdefghijklmnop\tlong06éabcdefghijklmnop\rlong02éabcdefghijklmnop\ncollision002553\rcafé\x0bx y\x0bb\rcafé  tail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
