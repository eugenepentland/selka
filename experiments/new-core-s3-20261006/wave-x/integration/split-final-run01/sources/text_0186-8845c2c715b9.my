module text_0186

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "b\x0clong02éabcdefghijklmnop\rb  b\t😀  collision005a0e\rlong02éabcdefghijklmnop  a naïve\tcollision002553 naïve  naïve\nb long01éabcdefghijklmnop  naïve\nlong03éabcdefghijklmnop\nlong01éabcdefghijklmnop  collision005a0e\na\rx y  😀\nlong01éabcdefghijklmnop\nlong03éabcdefghijklmnop\x0blong02éabcdefghijklmnop\tcollision002553  long03éabcdefghijklmnop\nnaïve  long03éabcdefghijklmnop\x0blong02éabcdefghijklmnop\rlong02éabcdefghijklmnop\x0clong01éabcdefghijklmnop\rtail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
