module text_0155

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long06éabcdefghijklmnop\x0ccollision005a0e\x0bb\nlong07éabcdefghijklmnop  long00éabcdefghijklmnop\x0ccollision005a0e\rb\rnaïve\ta\nlong04éabcdefghijklmnop\x0cΩ\x0ccollision005a0e\x0c😀\x0bΩ\tnaïve\rlong04éabcdefghijklmnop  long08éabcdefghijklmnop\x0bnaïve\ncafé  long02éabcdefghijklmnop\tcafé\nx y\x0clong06éabcdefghijklmnop long07éabcdefghijklmnop\x0cΩ\tcollision002553\x0ccafé\nlong03éabcdefghijklmnop\nlong03éabcdefghijklmnop\x0clong06éabcdefghijklmnop\x0blong06éabcdefghijklmnop Ω\na\rlong03éabcdefghijklmnop\rcollision005a0e\ta\x0clong08éabcdefghijklmnop collision005a0e long06éabcdefghijklmnop\nlong07éabcdefghijklmnop\x0clong00éabcdefghijklmnop\nb\rcollision005a0e  Ω  naïve  x y\tcollision005a0e\ntail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
