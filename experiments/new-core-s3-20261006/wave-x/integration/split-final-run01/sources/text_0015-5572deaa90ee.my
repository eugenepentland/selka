module text_0015

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "😀\x0bΩ\x0blong08éabcdefghijklmnop\rlong04éabcdefghijklmnop\ncafé\x0blong11éabcdefghijklmnop\tlong12éabcdefghijklmnop\x0blong01éabcdefghijklmnop\tcollision002553\tlong10éabcdefghijklmnop\nlong10éabcdefghijklmnop  long04éabcdefghijklmnop\nlong08éabcdefghijklmnop Ω Ω\nnaïve\nlong10éabcdefghijklmnop\x0clong05éabcdefghijklmnop\tcafé\rlong05éabcdefghijklmnop\tx y\x0clong02éabcdefghijklmnop\tlong01éabcdefghijklmnop\rcafé  long02éabcdefghijklmnop\tlong13éabcdefghijklmnop\rlong06éabcdefghijklmnop  collision002553\x0bx y\nΩ\x0cnaïve b\x0b😀\tb café\rlong12éabcdefghijklmnop  collision002553\nlong13éabcdefghijklmnop collision002553 x y\nx y\x0b😀\tcollision002553\rlong13éabcdefghijklmnop a\tlong01éabcdefghijklmnop\n😀\rb\nlong03éabcdefghijklmnop\x0ca  long03éabcdefghijklmnop é"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
