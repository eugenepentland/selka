module text_0029

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long00éabcdefghijklmnop\nlong01éabcdefghijklmnop\x0clong02éabcdefghijklmnop\x0clong04éabcdefghijklmnop  long00éabcdefghijklmnop  😀\ncafé  collision005a0e\x0bnaïve\ta b café collision002553 a\x0blong00éabcdefghijklmnop\x0c😀\x0bcollision005a0e  collision002553\nΩ  long02éabcdefghijklmnop\x0cx y  Ω\rlong02éabcdefghijklmnop\x0ca\x0blong03éabcdefghijklmnop  Ω\n😀\rlong02éabcdefghijklmnop\ta collision005a0e\tlong04éabcdefghijklmnop\x0clong00éabcdefghijklmnop\x0blong03éabcdefghijklmnop  long00éabcdefghijklmnop\rnaïve\nlong05éabcdefghijklmnop\nlong03éabcdefghijklmnop\tlong02éabcdefghijklmnop\x0cx y long05éabcdefghijklmnop\x0ca\x0clong00éabcdefghijklmnop\r"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
