module text_0067

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "😀\x0blong04éabcdefghijklmnop\x0bnaïve\tcafé\x0cx y\rlong02éabcdefghijklmnop\nlong02éabcdefghijklmnop long03éabcdefghijklmnop\nlong04éabcdefghijklmnop  😀\x0clong00éabcdefghijklmnop\rlong06éabcdefghijklmnop  x y\nx y\x0clong06éabcdefghijklmnop\t😀 b collision005a0e\nΩ\tcollision002553\x0bx y\ra\nΩ\nlong03éabcdefghijklmnop\x0bnaïve\x0bcafé café long05éabcdefghijklmnop  long07éabcdefghijklmnop  collision005a0e\x0cnaïve\x0cb\x0blong07éabcdefghijklmnop\x0bb a\x0blong05éabcdefghijklmnop long04éabcdefghijklmnop\x0clong06éabcdefghijklmnop  long07éabcdefghijklmnop\x0bb  long02éabcdefghijklmnop\x0cx y\x0ccollision002553  long05éabcdefghijklmnop\tx y\tnaïve\tlong08éabcdefghijklmnop  😀\x0blong02éabcdefghijklmnop Ω\rx y\ré"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
