module text_0181

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "café\n😀\ncollision005a0e\tx y\x0cΩ long00éabcdefghijklmnop\x0ca\tlong02éabcdefghijklmnop\rx y long02éabcdefghijklmnop naïve\n😀\x0bb\rcollision002553\nlong03éabcdefghijklmnop café\x0blong01éabcdefghijklmnop  😀\x0blong04éabcdefghijklmnop  long03éabcdefghijklmnop\x0clong02éabcdefghijklmnop\tlong05éabcdefghijklmnop\ntail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
