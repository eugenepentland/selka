module text_0104

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long11éabcdefghijklmnop\rlong11éabcdefghijklmnop\x0bΩ\x0c😀\x0cx y\tnaïve\rlong03éabcdefghijklmnop  long07éabcdefghijklmnop  long04éabcdefghijklmnop\rnaïve\tx y\nlong02éabcdefghijklmnop\x0clong03éabcdefghijklmnop  long05éabcdefghijklmnop\tb  a  long12éabcdefghijklmnop\ncafé\x0blong05éabcdefghijklmnop\x0bcollision002553  long02éabcdefghijklmnop\rlong02éabcdefghijklmnop\rlong09éabcdefghijklmnop\rΩ\x0blong00éabcdefghijklmnop\x0bΩ\rlong13éabcdefghijklmnop\tΩ  😀\tb\x0blong05éabcdefghijklmnop naïve\x0blong13éabcdefghijklmnop\tlong10éabcdefghijklmnop\x0clong12éabcdefghijklmnop\nlong01éabcdefghijklmnop long09éabcdefghijklmnop  long06éabcdefghijklmnop  long12éabcdefghijklmnop\tlong08éabcdefghijklmnop\x0clong11éabcdefghijklmnop\x0c😀\x0blong09éabcdefghijklmnop\x0cnaïve\x0cx y\nlong07éabcdefghijklmnop\nlong13éabcdefghijklmnop long05éabcdefghijklmnop\tlong09éabcdefghijklmnop\x0blong13éabcdefghijklmnop\x0ctail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
