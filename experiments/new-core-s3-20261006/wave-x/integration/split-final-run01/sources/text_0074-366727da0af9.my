module text_0074

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "😀\x0b😀\rlong02éabcdefghijklmnop a x y café\x0ccollision005a0e  😀\x0bΩ\x0clong01éabcdefghijklmnop\x0ccollision005a0e Ω\x0bb\ncafé café x y  collision002553\na\x0ba  Ω\rcollision005a0e  collision005a0e\x0clong00éabcdefghijklmnop\x0cx y\ncollision005a0e\rcollision002553  Ω\x0blong02éabcdefghijklmnop  naïve  a\x0ca\ra\nlong00éabcdefghijklmnop\na\x0bcollision005a0e\rb  long02éabcdefghijklmnop\nlong00éabcdefghijklmnop\ncollision005a0e\x0cnaïve\x0ba\ncafé\rΩ\r😀\x0ctail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
