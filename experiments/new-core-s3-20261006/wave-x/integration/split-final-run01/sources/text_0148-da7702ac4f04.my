module text_0148

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long05éabcdefghijklmnop\rx y\x0cΩ 😀\x0cx y  long06éabcdefghijklmnop\x0blong01éabcdefghijklmnop\nlong06éabcdefghijklmnop\nlong05éabcdefghijklmnop\x0clong05éabcdefghijklmnop\ta\rlong01éabcdefghijklmnop\rlong02éabcdefghijklmnop  😀\x0blong01éabcdefghijklmnop\tcollision002553\tlong03éabcdefghijklmnop\x0bcollision002553  café  x y\x0bcafé long08éabcdefghijklmnop\nlong10éabcdefghijklmnop  long02éabcdefghijklmnop  long09éabcdefghijklmnop\x0clong08éabcdefghijklmnop\rlong10éabcdefghijklmnop\nnaïve\x0clong08éabcdefghijklmnop\ncollision002553  long01éabcdefghijklmnop\x0blong05éabcdefghijklmnop\x0bcafé\x0bcollision005a0e  collision002553\tlong08éabcdefghijklmnop\x0bcafé long09éabcdefghijklmnop\tb café\nlong04éabcdefghijklmnop b\x0blong00éabcdefghijklmnop collision005a0e\nlong02éabcdefghijklmnop\tlong05éabcdefghijklmnop\tlong01éabcdefghijklmnop\nlong07éabcdefghijklmnop\x0bé"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
