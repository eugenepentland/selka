module text_0040

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "a\n😀\tΩ\tlong02éabcdefghijklmnop\tlong03éabcdefghijklmnop\ta collision005a0e\x0ccafé 😀\rlong04éabcdefghijklmnop\x0ccafé\ncafé\rΩ\n😀\rcafé  😀\x0bx y long03éabcdefghijklmnop\x0b😀\na\tcollision002553\rlong03éabcdefghijklmnop\x0ba\x0cb long00éabcdefghijklmnop\tb  long03éabcdefghijklmnop  naïve\tlong04éabcdefghijklmnop\rcollision005a0e\x0clong03éabcdefghijklmnop\tlong03éabcdefghijklmnop  collision005a0e\nΩ\x0clong02éabcdefghijklmnop\né"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
