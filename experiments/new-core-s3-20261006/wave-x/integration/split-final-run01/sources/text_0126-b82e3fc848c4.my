module text_0126

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long13éabcdefghijklmnop long03éabcdefghijklmnop  long12éabcdefghijklmnop long05éabcdefghijklmnop\tlong06éabcdefghijklmnop long07éabcdefghijklmnop  Ω  long06éabcdefghijklmnop\rnaïve\x0clong12éabcdefghijklmnop\x0ccollision002553  😀\x0blong02éabcdefghijklmnop naïve  café\x0bcollision005a0e  x y\t😀\tlong08éabcdefghijklmnop\x0clong08éabcdefghijklmnop\tcollision002553 long12éabcdefghijklmnop\rcollision005a0e  café\t😀 collision002553\tlong05éabcdefghijklmnop\nlong05éabcdefghijklmnop\nlong00éabcdefghijklmnop\rlong07éabcdefghijklmnop\t😀  😀\nlong01éabcdefghijklmnop\tlong08éabcdefghijklmnop\rlong11éabcdefghijklmnop\x0cΩ long04éabcdefghijklmnop\tlong06éabcdefghijklmnop b\nlong08éabcdefghijklmnop\t "
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
