module text_0137

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "naïve Ω naïve\rlong11éabcdefghijklmnop\rb\nlong07éabcdefghijklmnop\x0blong09éabcdefghijklmnop\x0clong01éabcdefghijklmnop\tcollision002553 long07éabcdefghijklmnop\ta  long03éabcdefghijklmnop\rlong02éabcdefghijklmnop\tΩ\rlong05éabcdefghijklmnop  x y\tcollision005a0e  long10éabcdefghijklmnop\ta  long03éabcdefghijklmnop\x0b😀\x0blong10éabcdefghijklmnop  long04éabcdefghijklmnop\nlong02éabcdefghijklmnop\x0bΩ collision002553\nlong10éabcdefghijklmnop\ncafé\t😀  long04éabcdefghijklmnop\x0clong02éabcdefghijklmnop\nlong09éabcdefghijklmnop\x0clong10éabcdefghijklmnop\nlong08éabcdefghijklmnop\nlong05éabcdefghijklmnop\x0blong11éabcdefghijklmnop\x0bΩ long10éabcdefghijklmnop\x0blong00éabcdefghijklmnop\tcafé\nlong01éabcdefghijklmnop long07éabcdefghijklmnop\x0bb\x0c "
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
