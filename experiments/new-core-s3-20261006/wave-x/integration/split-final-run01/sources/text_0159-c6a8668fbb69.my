module text_0159

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "collision005a0e\nlong00éabcdefghijklmnop Ω\n😀 collision002553  collision002553 b\rlong03éabcdefghijklmnop  a\n😀\nb  a\t😀\x0clong03éabcdefghijklmnop  collision005a0e\x0bcollision005a0e\ra\na  collision005a0e\x0bcafé collision002553 collision002553\x0ccollision005a0e\x0clong01éabcdefghijklmnop\nlong03éabcdefghijklmnop\x0bcollision002553\na  😀\tΩ\tcafé\tcafé  naïve  😀\x0ba\x0bnaïve 😀\t😀\x0ccafé\ra\x0bcafé\rlong02éabcdefghijklmnop\x0bcollision002553\tb\x0bx y\rnaïve  x y Ω\nlong00éabcdefghijklmnop\x0cx y\ta\n😀\x0blong03éabcdefghijklmnop\nlong02éabcdefghijklmnop\t😀\x0b"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
