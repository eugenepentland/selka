module text_0033

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "a  a\x0c😀\nlong00éabcdefghijklmnop\x0ccafé\x0blong03éabcdefghijklmnop\tlong05éabcdefghijklmnop\r😀\x0cΩ\x0ca\x0clong04éabcdefghijklmnop\x0bΩ  long04éabcdefghijklmnop\x0blong01éabcdefghijklmnop\x0cx y\rlong00éabcdefghijklmnop b\x0b😀\rb\tlong01éabcdefghijklmnop\x0bcollision002553\x0cb\x0cx y  b\x0blong03éabcdefghijklmnop\tnaïve\nlong04éabcdefghijklmnop\tcollision005a0e\rcafé  long05éabcdefghijklmnop  x y\rlong05éabcdefghijklmnop\rcollision005a0e b\tlong04éabcdefghijklmnop  b\x0bb\nlong04éabcdefghijklmnop\nb  long02éabcdefghijklmnop long02éabcdefghijklmnop\x0clong02éabcdefghijklmnop\rlong00éabcdefghijklmnop\x0cnaïve  b\x0clong00éabcdefghijklmnop x y\x0blong03éabcdefghijklmnop\nlong05éabcdefghijklmnop\rlong05éabcdefghijklmnop long01éabcdefghijklmnop  a\r"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
