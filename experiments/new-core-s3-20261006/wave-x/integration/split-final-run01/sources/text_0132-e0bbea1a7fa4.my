module text_0132

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long05éabcdefghijklmnop\tcollision002553 Ω  Ω\ta\x0bb\nΩ\x0ccollision005a0e a\ra Ω\rlong06éabcdefghijklmnop  long01éabcdefghijklmnop  long03éabcdefghijklmnop\x0bΩ\x0bcollision005a0e\x0blong07éabcdefghijklmnop\rlong00éabcdefghijklmnop\rΩ\tcafé\nlong07éabcdefghijklmnop\rcafé\nlong06éabcdefghijklmnop\x0clong09éabcdefghijklmnop  long06éabcdefghijklmnop\tlong02éabcdefghijklmnop\x0cnaïve long07éabcdefghijklmnop long03éabcdefghijklmnop\x0blong07éabcdefghijklmnop\nlong04éabcdefghijklmnop\tlong08éabcdefghijklmnop\tlong03éabcdefghijklmnop\tnaïve  long04éabcdefghijklmnop\x0blong03éabcdefghijklmnop\rx y  long06éabcdefghijklmnop\rlong03éabcdefghijklmnop\rlong10éabcdefghijklmnop\tb b\rtail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
