module text_0008

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "café\x0clong01éabcdefghijklmnop collision002553\tcollision002553\t😀 😀\x0blong09éabcdefghijklmnop\r😀\rlong03éabcdefghijklmnop  collision005a0e\x0ccollision005a0e long03éabcdefghijklmnop  😀\tcollision005a0e\x0clong01éabcdefghijklmnop\x0bΩ long01éabcdefghijklmnop\x0blong06éabcdefghijklmnop\x0cnaïve\rlong01éabcdefghijklmnop\tlong07éabcdefghijklmnop\rx y a naïve x y\x0blong04éabcdefghijklmnop\x0c😀 long07éabcdefghijklmnop\nlong08éabcdefghijklmnop\tlong10éabcdefghijklmnop  long02éabcdefghijklmnop long09éabcdefghijklmnop\nx y\x0ba\rnaïve\x0blong09éabcdefghijklmnop\n"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
