module text_0078

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "a long01éabcdefghijklmnop\nlong02éabcdefghijklmnop\x0clong01éabcdefghijklmnop\tcafé\tcollision002553\x0clong00éabcdefghijklmnop\nnaïve\x0ccafé\x0clong03éabcdefghijklmnop\x0cΩ\ncafé\nlong00éabcdefghijklmnop\x0blong02éabcdefghijklmnop\nlong00éabcdefghijklmnop Ω\nx y naïve\rb  a\x0clong04éabcdefghijklmnop  x y\x0blong02éabcdefghijklmnop x y\nlong00éabcdefghijklmnop\nb\n😀\x0cnaïve  long02éabcdefghijklmnop\x0cb\ncafé\nlong04éabcdefghijklmnop\nlong02éabcdefghijklmnop\ta\n😀\nlong04éabcdefghijklmnop\x0ccollision005a0e\x0cΩ\x0bcollision005a0e\tlong04éabcdefghijklmnop long04éabcdefghijklmnop\rlong04éabcdefghijklmnop  😀 Ω  😀  collision005a0e\tnaïve\tlong02éabcdefghijklmnop\x0c "
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
