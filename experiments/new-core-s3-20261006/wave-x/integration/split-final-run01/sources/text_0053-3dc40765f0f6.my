module text_0053

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long09éabcdefghijklmnop collision002553\nlong00éabcdefghijklmnop\rnaïve\tlong00éabcdefghijklmnop\tlong00éabcdefghijklmnop\x0bcollision005a0e  café\x0ca  long03éabcdefghijklmnop\x0clong10éabcdefghijklmnop\rlong03éabcdefghijklmnop\x0clong05éabcdefghijklmnop long00éabcdefghijklmnop\rlong03éabcdefghijklmnop\nnaïve  long02éabcdefghijklmnop\n😀 x y\x0blong01éabcdefghijklmnop\rlong02éabcdefghijklmnop long06éabcdefghijklmnop  long05éabcdefghijklmnop\rlong08éabcdefghijklmnop  long11éabcdefghijklmnop  a\x0clong03éabcdefghijklmnop\rcafé\ncollision005a0e\x0bb\x0ccollision002553  long07éabcdefghijklmnop\rlong04éabcdefghijklmnop b\rlong09éabcdefghijklmnop\x0clong01éabcdefghijklmnop\nlong04éabcdefghijklmnop\rΩ b\tΩ\x0blong07éabcdefghijklmnop\x0clong00éabcdefghijklmnop\x0cx y  long01éabcdefghijklmnop\rlong02éabcdefghijklmnop   "
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
