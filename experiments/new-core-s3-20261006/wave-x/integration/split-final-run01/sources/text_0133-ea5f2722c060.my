module text_0133

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "😀\tcollision002553\x0cnaïve\x0blong03éabcdefghijklmnop\tb 😀 long05éabcdefghijklmnop\x0ccafé\x0clong01éabcdefghijklmnop  Ω\rlong05éabcdefghijklmnop\r😀\rlong06éabcdefghijklmnop\x0blong06éabcdefghijklmnop\x0clong05éabcdefghijklmnop\tΩ\nlong03éabcdefghijklmnop  collision005a0e  long06éabcdefghijklmnop café\tlong00éabcdefghijklmnop\tcollision002553  collision002553 long02éabcdefghijklmnop collision005a0e  Ω\tlong05éabcdefghijklmnop\rlong02éabcdefghijklmnop\x0clong05éabcdefghijklmnop  😀\rlong06éabcdefghijklmnop  collision005a0e\tnaïve\tlong04éabcdefghijklmnop "
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
