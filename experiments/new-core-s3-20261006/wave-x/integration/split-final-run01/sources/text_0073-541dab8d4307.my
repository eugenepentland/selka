module text_0073

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "😀\x0clong01éabcdefghijklmnop  long01éabcdefghijklmnop long00éabcdefghijklmnop\x0ccollision002553\t😀\tlong02éabcdefghijklmnop\x0clong05éabcdefghijklmnop\x0clong05éabcdefghijklmnop\rlong01éabcdefghijklmnop\rlong05éabcdefghijklmnop long04éabcdefghijklmnop\x0blong01éabcdefghijklmnop  long04éabcdefghijklmnop long02éabcdefghijklmnop\x0clong01éabcdefghijklmnop\x0clong05éabcdefghijklmnop  long01éabcdefghijklmnop\rlong00éabcdefghijklmnop\nlong00éabcdefghijklmnop\x0blong04éabcdefghijklmnop\rlong01éabcdefghijklmnop\tlong02éabcdefghijklmnop\na  collision002553  café\x0blong01éabcdefghijklmnop\nlong03éabcdefghijklmnop\ncollision005a0e b\nlong05éabcdefghijklmnop naïve long03éabcdefghijklmnop\x0bΩ\rlong01éabcdefghijklmnop\rlong05éabcdefghijklmnop\na\rΩ\n😀\t😀\ncafé\x0cnaïve\nlong03éabcdefghijklmnop  Ω  😀  collision005a0e\x0bcafé\n "
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
