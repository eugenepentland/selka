module text_0016

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long03éabcdefghijklmnop\rlong00éabcdefghijklmnop\x0ca\x0ccollision002553\nlong04éabcdefghijklmnop  😀  collision005a0e\x0c😀\x0cx y\nlong04éabcdefghijklmnop\r😀 long02éabcdefghijklmnop  😀 collision002553 long03éabcdefghijklmnop\tnaïve\tcafé\x0ccollision005a0e  collision002553  collision005a0e  long02éabcdefghijklmnop\x0clong02éabcdefghijklmnop\x0cb\nlong03éabcdefghijklmnop\x0ba long02éabcdefghijklmnop  😀\rnaïve\rlong01éabcdefghijklmnop collision005a0e  naïve\x0clong01éabcdefghijklmnop\x0ccafé\rlong04éabcdefghijklmnop  long00éabcdefghijklmnop\x0bcollision002553\rlong01éabcdefghijklmnop\x0clong02éabcdefghijklmnop\x0ba b\nx y\x0clong04éabcdefghijklmnop\tcafé\x0clong00éabcdefghijklmnop\rnaïve  tail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
