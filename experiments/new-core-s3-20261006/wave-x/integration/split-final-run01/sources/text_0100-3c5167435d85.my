module text_0100

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "x y  long01éabcdefghijklmnop long01éabcdefghijklmnop\rlong04éabcdefghijklmnop\tnaïve\x0ba\rnaïve\x0ccollision002553\tnaïve\x0ca\x0ccafé  naïve\nlong00éabcdefghijklmnop  long04éabcdefghijklmnop\x0cb\x0b😀\na\x0cnaïve\rb\na Ω\nnaïve x y\x0cb\x0bnaïve\ncollision002553\x0blong03éabcdefghijklmnop\rlong02éabcdefghijklmnop\x0clong02éabcdefghijklmnop  b\tlong01éabcdefghijklmnop long03éabcdefghijklmnop  "
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
