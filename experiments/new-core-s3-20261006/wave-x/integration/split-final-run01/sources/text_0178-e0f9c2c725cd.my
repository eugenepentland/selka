module text_0178

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long02éabcdefghijklmnop\x0ccollision005a0e\x0b😀\rlong01éabcdefghijklmnop long01éabcdefghijklmnop  long03éabcdefghijklmnop\nx y\x0ccollision002553 café\x0bcafé x y\x0bx y\rcollision002553\x0b😀\x0blong00éabcdefghijklmnop\x0blong03éabcdefghijklmnop collision005a0e\x0blong01éabcdefghijklmnop\tΩ\x0cb\x0bcafé  b b 😀\nnaïve\nlong01éabcdefghijklmnop  a collision005a0e\rΩ\ra\nlong02éabcdefghijklmnop\x0ca\x0cnaïve\x0ba\x0clong02éabcdefghijklmnop\ra\x0blong03éabcdefghijklmnop x y\x0blong04éabcdefghijklmnop long00éabcdefghijklmnop long04éabcdefghijklmnop long02éabcdefghijklmnop\rlong02éabcdefghijklmnop\x0b "
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
