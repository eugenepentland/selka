module text_0077

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "café long04éabcdefghijklmnop\rlong01éabcdefghijklmnop long02éabcdefghijklmnop\tcollision005a0e\x0cnaïve\x0blong09éabcdefghijklmnop\nlong05éabcdefghijklmnop long11éabcdefghijklmnop\x0blong07éabcdefghijklmnop\nlong08éabcdefghijklmnop\tlong11éabcdefghijklmnop\x0cΩ\rlong07éabcdefghijklmnop\x0bnaïve\x0blong02éabcdefghijklmnop\nlong01éabcdefghijklmnop\x0ccollision005a0e\x0clong00éabcdefghijklmnop café\rnaïve\rnaïve\nx y\x0bcafé\tlong00éabcdefghijklmnop\x0bcollision005a0e\nlong03éabcdefghijklmnop\rlong02éabcdefghijklmnop long09éabcdefghijklmnop\x0clong06éabcdefghijklmnop\t😀  long01éabcdefghijklmnop\tΩ\tlong11éabcdefghijklmnop\rlong02éabcdefghijklmnop\rlong04éabcdefghijklmnop\tlong10éabcdefghijklmnop long07éabcdefghijklmnop\tlong09éabcdefghijklmnop\ncollision002553\né"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
