module text_0176

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "naïve\rcollision005a0e\tlong06éabcdefghijklmnop café\x0ccafé\x0clong06éabcdefghijklmnop\rlong01éabcdefghijklmnop\rlong01éabcdefghijklmnop\x0cb\tlong00éabcdefghijklmnop\tnaïve\rlong00éabcdefghijklmnop\x0blong06éabcdefghijklmnop  naïve\x0ccollision002553\x0bcollision002553\x0cb\x0ccollision002553\x0blong04éabcdefghijklmnop  naïve\rlong03éabcdefghijklmnop\x0bb  a long03éabcdefghijklmnop long02éabcdefghijklmnop\tlong01éabcdefghijklmnop  naïve\x0ccollision005a0e\x0bΩ\nlong02éabcdefghijklmnop é"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
