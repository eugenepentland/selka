module text_0191

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long03éabcdefghijklmnop b long03éabcdefghijklmnop\x0ccollision002553\x0clong03éabcdefghijklmnop\x0clong00éabcdefghijklmnop\x0clong00éabcdefghijklmnop\x0blong02éabcdefghijklmnop\tcafé\tlong00éabcdefghijklmnop\x0cx y\rlong07éabcdefghijklmnop collision005a0e\x0bΩ\tcollision002553\tcafé\rlong01éabcdefghijklmnop  a\x0bcollision005a0e\x0bb\x0blong01éabcdefghijklmnop\x0c😀 collision005a0e\nlong05éabcdefghijklmnop\x0b😀\x0b😀\x0blong05éabcdefghijklmnop  long06éabcdefghijklmnop café\ta  long01éabcdefghijklmnop  collision005a0e\x0clong06éabcdefghijklmnop tail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
