module text_0114

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "collision002553\ncollision002553\x0cnaïve\tb\x0clong01éabcdefghijklmnop\x0ca\x0blong00éabcdefghijklmnop  collision002553\tΩ\tlong00éabcdefghijklmnop\tcollision002553\ncafé\rlong03éabcdefghijklmnop  naïve\x0bnaïve\x0clong03éabcdefghijklmnop\nlong02éabcdefghijklmnop naïve\x0blong01éabcdefghijklmnop 😀\x0blong04éabcdefghijklmnop\x0bb\r😀\tlong01éabcdefghijklmnop\rΩ\ncafé\x0blong04éabcdefghijklmnop\r😀\t😀  long00éabcdefghijklmnop\ra\x0bx y long02éabcdefghijklmnop\rΩ b\x0b😀\r"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
