module text_0098

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "café\tnaïve long06éabcdefghijklmnop\tlong06éabcdefghijklmnop\x0cx y\rlong01éabcdefghijklmnop\x0clong04éabcdefghijklmnop\x0bcollision002553\t😀 long00éabcdefghijklmnop\rb\x0ccafé\x0cx y\rlong05éabcdefghijklmnop\nΩ café\nb long05éabcdefghijklmnop\nnaïve\rΩ\nx y\x0clong04éabcdefghijklmnop\tnaïve\rcafé\r😀  long02éabcdefghijklmnop long00éabcdefghijklmnop\nlong00éabcdefghijklmnop\nlong05éabcdefghijklmnop\rlong01éabcdefghijklmnop\x0bnaïve\x0clong05éabcdefghijklmnop  naïve\ncollision005a0e\x0ccafé  tail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
