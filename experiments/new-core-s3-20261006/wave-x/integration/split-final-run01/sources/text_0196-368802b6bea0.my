module text_0196

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long03éabcdefghijklmnop\tcafé\rnaïve  collision002553\x0blong01éabcdefghijklmnop 😀\tlong07éabcdefghijklmnop\x0blong06éabcdefghijklmnop\x0bΩ  café\x0ca\tcafé\rΩ\x0cb\rcollision005a0e  long03éabcdefghijklmnop\nΩ collision002553  long00éabcdefghijklmnop\tx y long05éabcdefghijklmnop\nlong02éabcdefghijklmnop\x0clong05éabcdefghijklmnop  Ω\x0blong00éabcdefghijklmnop\tcollision002553\x0cΩ\x0cx y x y  long04éabcdefghijklmnop  long06éabcdefghijklmnop\rlong04éabcdefghijklmnop  long04éabcdefghijklmnop\nlong07éabcdefghijklmnop collision002553  a  x y\tcollision005a0e\rlong04éabcdefghijklmnop\rcafé  Ω\rlong05éabcdefghijklmnop\nnaïve\x0clong03éabcdefghijklmnop\x0ba  Ω\nb\rlong02éabcdefghijklmnop\x0ca  long06éabcdefghijklmnop x y  a\x0c "
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
