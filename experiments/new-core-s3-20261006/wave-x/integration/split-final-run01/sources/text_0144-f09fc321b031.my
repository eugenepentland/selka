module text_0144

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "x y\ta\nb  long01éabcdefghijklmnop\na\rcollision005a0e\x0cnaïve\tlong00éabcdefghijklmnop\rcafé\rnaïve naïve\rx y collision002553\tcollision002553\x0bcollision002553\tΩ long01éabcdefghijklmnop\na\x0cΩ\nnaïve\x0ccafé\rlong01éabcdefghijklmnop  😀  collision005a0e\x0bb\rb  café  collision002553\nnaïve\x0cx y\rlong01éabcdefghijklmnop\x0bnaïve\rcafé\na\x0c😀\ra\x0ccollision005a0e long00éabcdefghijklmnop collision005a0e\x0clong01éabcdefghijklmnop  tail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
