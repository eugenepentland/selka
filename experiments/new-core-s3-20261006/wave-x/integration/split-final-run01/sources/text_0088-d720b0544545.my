module text_0088

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long06éabcdefghijklmnop  Ω Ω\tlong05éabcdefghijklmnop collision002553\x0blong04éabcdefghijklmnop long05éabcdefghijklmnop\nlong04éabcdefghijklmnop long08éabcdefghijklmnop\nΩ\rnaïve\x0cnaïve\tcollision005a0e  long05éabcdefghijklmnop\tcafé\nx y\ta long02éabcdefghijklmnop\rcollision005a0e\x0clong00éabcdefghijklmnop\x0clong04éabcdefghijklmnop  long03éabcdefghijklmnop\rlong06éabcdefghijklmnop\nnaïve\tx y\rlong01éabcdefghijklmnop\x0blong02éabcdefghijklmnop\x0bcollision002553 long00éabcdefghijklmnop\tΩ\x0blong05éabcdefghijklmnop\rΩ\tx y\tlong00éabcdefghijklmnop\x0cx y  long08éabcdefghijklmnop\tcafé\rlong01éabcdefghijklmnop  long06éabcdefghijklmnop\x0blong01éabcdefghijklmnop naïve\x0clong03éabcdefghijklmnop\tlong02éabcdefghijklmnop\na\tlong02éabcdefghijklmnop\x0bcollision005a0e\x0blong00éabcdefghijklmnop\t "
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
