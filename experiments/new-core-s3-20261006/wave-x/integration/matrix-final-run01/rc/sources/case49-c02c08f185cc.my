def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(2))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(2)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(2))
    for i2 in range(0):
        ra4 = rl3
        rl3.append(make_ints(seed))
        for i1 in range(2):
            sa5 = sl2
            if len(rl3) > 0:
                inner6 = rl3[0]
                inner6.append(5)
                acc = acc + len(inner6) + len(rl3[0])
    if len(sl2) > 2:
        if len(rl3) > 0:
            inner7 = rl3[0]
            inner7.append(5)
            acc = acc + len(inner7) + len(rl3[0])
        ra8 = rl3
    if len(il1) > 2:
        sl2.append("xyz")
        il1.append(1)
        sg9 = grow_str(sl2, seed)
        for i1 in range(3):
            il1.append(i1)
            ra10 = rl3
            acc = acc + len(rl3)
            ra11 = ra10
        il1.append(7)
    for i2 in range(0):
        if len(rl3) > 0:
            inner12 = rl3[0]
            inner12.append(5)
            acc = acc + len(inner12) + len(rl3[0])
        for i1 in range(0):
            acc = acc + len(rl3)
            il1.append(i1)
        sl2.append("bc")
        rg13 = grow_row(rl3, i2)
    sl2.append("xyz")
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
