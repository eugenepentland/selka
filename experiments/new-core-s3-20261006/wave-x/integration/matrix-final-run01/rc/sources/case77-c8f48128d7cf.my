def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("xyz")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(5)
    sl2: list[str] = []
    sl2.append("xyz")
    rl3: list[list[int]] = []
    rl3.append(make_ints(seed))
    ig4 = grow_int(il1, 1)
    ra5 = rl3
    if len(sl2) > 0:
        acc = acc + len(sl2)
        ra5.append(make_ints(2))
        ig4.append(0)
        acc = acc + len(sl2)
        ia6 = il1
    ia7 = il1
    if len(sl2) > 2:
        sg8 = grow_str(sl2, seed)
        sl2.append("a")
        for i1 in range(3):
            acc = acc + len(ig4)
            acc = acc + len(ra5)
            ra5.append(make_ints(seed))
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(ig4)
    acc = acc + len(ra5)
    acc = acc + len(ia7)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
