def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(7)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("a")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(2))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(3)
    sl2: list[str] = []
    sl2.append("a")
    rl3: list[list[int]] = []
    rl3.append(make_ints(3))
    if len(rl3) > 1:
        acc = acc + len(il1)
        ra4 = rl3
        sl2.append("xyz")
        if len(il1) > 1:
            rg5 = grow_row(rl3, seed)
            acc = acc + len(sl2)
            ig6 = grow_int(il1, seed)
            acc = acc + len(il1)
        for i1 in range(3):
            acc = acc + len(sl2)
            ra7 = ra4
            ra8 = rl3
            acc = acc + len(rl3)
            acc = acc + len(il1)
            acc = acc + len(ra7)
        for i1 in range(0):
            il1.append(seed)
            rl3.append(make_ints(seed))
            rg9 = grow_row(rl3, seed)
            acc = acc + len(ra4)
        return acc + len(rl3)
    ia10 = il1
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(ia10)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
