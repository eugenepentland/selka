def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(1)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(n))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(8)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(seed))
    for i2 in range(2):
        sg4 = grow_str(sl2, seed)
        il1.append(seed)
        sa5 = sl2
        for i1 in range(0):
            sa6 = sa5
            sl2.append("xyz")
            acc = acc + len(sg4)
            sg4.append("bc")
            ig7 = grow_int(il1, i1)
            acc = acc + len(sl2)
        for i1 in range(0):
            sa8 = sl2
            sa9 = sa5
            acc = acc + len(sl2)
        sg10 = grow_str(sl2, i2)
    if len(rl3) > 2:
        sl2.append("xyz")
        sa11 = sl2
        il1.append(8)
        ia12 = il1
    if len(rl3) > 3:
        sa13 = sl2
        il1.append(seed)
        sa13.append("xyz")
        sa14 = sl2
        sa15 = sl2
        return acc + len(rl3)
    rl3.append(make_ints(3))
    il1.append(1)
    for i2 in range(1):
        for i1 in range(3):
            ia16 = il1
            acc = acc + len(il1)
            ig17 = grow_int(il1, i2)
            sl2.append("xyz")
        rl3.append(make_ints(seed))
        rg18 = grow_row(rl3, 1)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
