def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(3)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(seed))
    if len(sl2) > 2:
        for i1 in range(2):
            if len(rl3) > 0:
                inner4 = rl3[0]
                inner4.append(5)
                acc = acc + len(inner4) + len(rl3[0])
            sl2.append("bc")
            il1.append(i1)
            sa5 = sl2
            ia6 = il1
            sg7 = grow_str(sl2, 1)
        rl3.append(make_ints(seed))
    ia8 = il1
    ia9 = ia8
    for i2 in range(0):
        ia10 = il1
        rl3.append(make_ints(i2))
        for i1 in range(2):
            ia9.append(5)
            acc = acc + len(ia8)
            if len(rl3) > 0:
                inner11 = rl3[0]
                inner11.append(5)
                acc = acc + len(inner11) + len(rl3[0])
            sl2.append("bc")
    ia12 = il1
    ia12.append(9)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(ia8)
    acc = acc + len(ia9)
    acc = acc + len(ia12)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
