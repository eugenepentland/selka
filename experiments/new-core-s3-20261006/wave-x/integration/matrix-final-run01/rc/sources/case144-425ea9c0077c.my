def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(3)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(n))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(1)
    sl2: list[str] = []
    sl2.append("a")
    rl3: list[list[int]] = []
    rl3.append(make_ints(seed))
    ia4 = il1
    for i2 in range(3):
        ia5 = il1
        rl3.append(make_ints(seed))
        if len(sl2) > 2:
            ia5.append(seed)
            acc = acc + len(ia5)
        ra6 = rl3
        sl2.append("xyz")
        for i1 in range(3):
            if len(rl3) > 0:
                inner7 = rl3[0]
                inner7.append(5)
                acc = acc + len(inner7) + len(rl3[0])
            il1.append(2)
            rg8 = grow_row(rl3, i1)
            acc = acc + len(il1)
            sg9 = grow_str(sl2, i2)
    sa10 = sl2
    ig11 = grow_int(il1, seed)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(ia4)
    if len(sa10) > 0:
        out.print(sa10[len(sa10) - 1])
    acc = acc + len(sa10)
    acc = acc + len(ig11)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
