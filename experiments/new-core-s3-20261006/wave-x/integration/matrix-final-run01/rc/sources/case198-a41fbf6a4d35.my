def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(2)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("xyz")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(2))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(9)
    sl2: list[str] = []
    sl2.append("xyz")
    rl3: list[list[int]] = []
    rl3.append(make_ints(2))
    for i2 in range(2):
        if len(sl2) > 3:
            rl3.append(make_ints(seed))
            rl3.append(make_ints(2))
            ig4 = grow_int(il1, i2)
            acc = acc + len(rl3)
            return acc + len(sl2)
        sl2.append("bc")
        ia5 = il1
    sl2.append("a")
    il1.append(1)
    sl2.append("xyz")
    il1.append(seed)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
