def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("a")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(2)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(2))
    for i2 in range(2):
        acc = acc + len(sl2)
        ra4 = rl3
        for i1 in range(1):
            il1.append(i1)
            sl2.append("xyz")
            if len(ra4) > 0:
                inner5 = ra4[0]
                inner5.append(5)
                acc = acc + len(inner5) + len(ra4[0])
            rl3.append(make_ints(seed))
        ra6 = rl3
        sa7 = sl2
    for i2 in range(1):
        il1.append(seed)
        acc = acc + len(il1)
    sa8 = sl2
    sa8.append("xyz")
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sa8) > 0:
        out.print(sa8[len(sa8) - 1])
    acc = acc + len(sa8)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
