def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(0)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("xyz")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(3)
    sl2: list[str] = []
    sl2.append("a")
    rl3: list[list[int]] = []
    rl3.append(make_ints(3))
    sg4 = grow_str(sl2, 1)
    ig5 = grow_int(il1, 1)
    sa6 = sg4
    sl2.append("a")
    acc = acc + len(ig5)
    for i2 in range(0):
        ig7 = grow_int(il1, seed)
        for i1 in range(2):
            ra8 = rl3
            ra8.append(make_ints(i1))
        sg4.append("a")
        sa9 = sg4
        sa10 = sa6
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sg4) > 0:
        out.print(sg4[len(sg4) - 1])
    acc = acc + len(sg4)
    acc = acc + len(ig5)
    if len(sa6) > 0:
        out.print(sa6[len(sa6) - 1])
    acc = acc + len(sa6)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
