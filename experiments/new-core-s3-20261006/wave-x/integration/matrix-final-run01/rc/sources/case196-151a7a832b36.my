def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(n))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("xyz")
    rl3: list[list[int]] = []
    rl3.append(make_ints(3))
    sa4 = sl2
    if len(sl2) > 1:
        ra5 = rl3
        for i1 in range(3):
            acc = acc + len(ra5)
            sl2.append("bc")
            il1.append(seed)
            acc = acc + len(il1)
        if len(il1) > 1:
            sg6 = grow_str(sa4, 1)
            ia7 = il1
            acc = acc + len(il1)
            ia8 = il1
        return acc + len(sl2)
    for i2 in range(2):
        sa4.append("xyz")
        if len(sa4) > 1:
            rl3.append(make_ints(i2))
            ia9 = il1
            ra10 = rl3
            acc = acc + len(ia9)
            il1.append(seed)
        for i1 in range(1):
            acc = acc + len(sl2)
            acc = acc + len(il1)
            acc = acc + len(sl2)
            sg11 = grow_str(sa4, seed)
            sa4.append("xyz")
        sa12 = sa4
    for i2 in range(3):
        for i1 in range(2):
            sa13 = sl2
            acc = acc + len(sa13)
            sl2.append("xyz")
        sl2.append("a")
        ra14 = rl3
        il1.append(i2)
        if len(rl3) > 0:
            inner15 = rl3[0]
            inner15.append(5)
            acc = acc + len(inner15) + len(rl3[0])
        if len(ra14) > 0:
            inner16 = ra14[0]
            inner16.append(5)
            acc = acc + len(inner16) + len(ra14[0])
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sa4) > 0:
        out.print(sa4[len(sa4) - 1])
    acc = acc + len(sa4)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
