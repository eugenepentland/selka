def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(7)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(n))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(5)
    sl2: list[str] = []
    sl2.append("xyz")
    rl3: list[list[int]] = []
    rl3.append(make_ints(2))
    rl3.append(make_ints(3))
    acc = acc + len(rl3)
    ia4 = il1
    for i2 in range(3):
        for i1 in range(2):
            sl2.append("bc")
            acc = acc + len(rl3)
            acc = acc + len(ia4)
        sl2.append("bc")
        ia4.append(i2)
        il1.append(i2)
        ia5 = il1
    if len(rl3) > 0:
        inner6 = rl3[0]
        inner6.append(5)
        acc = acc + len(inner6) + len(rl3[0])
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(ia4)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
