def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(0)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("a")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(0)
    sl2: list[str] = []
    sl2.append("a")
    rl3: list[list[int]] = []
    rl3.append(make_ints(2))
    for i2 in range(0):
        il1.append(i2)
        for i1 in range(0):
            ia4 = il1
            rl3.append(make_ints(2))
            acc = acc + len(ia4)
            ra5 = rl3
    il1.append(7)
    ig6 = grow_int(il1, seed)
    for i2 in range(2):
        if len(rl3) > 0:
            inner7 = rl3[0]
            inner7.append(5)
            acc = acc + len(inner7) + len(rl3[0])
        for i1 in range(0):
            sa8 = sl2
            rl3.append(make_ints(3))
            ig6.append(8)
            ia9 = ig6
        for i1 in range(3):
            acc = acc + len(il1)
            ig6.append(3)
            ia10 = il1
        rl3.append(make_ints(3))
        acc = acc + len(ig6)
    if len(il1) > 3:
        rg11 = grow_row(rl3, seed)
        for i1 in range(3):
            acc = acc + len(il1)
            ia12 = ig6
            acc = acc + len(il1)
            acc = acc + len(rg11)
            il1.append(3)
            sl2.append("xyz")
        if len(rl3) > 0:
            inner13 = rl3[0]
            inner13.append(5)
            acc = acc + len(inner13) + len(rl3[0])
        acc = acc + len(rg11)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(ig6)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
