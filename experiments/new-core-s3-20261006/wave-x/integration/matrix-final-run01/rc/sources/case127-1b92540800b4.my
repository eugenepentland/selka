def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("a")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(6)
    sl2: list[str] = []
    sl2.append("xyz")
    rl3: list[list[int]] = []
    rl3.append(make_ints(3))
    if len(sl2) > 1:
        if len(sl2) > 0:
            sl2.append("xyz")
            il1.append(2)
            sa4 = sl2
            rg5 = grow_row(rl3, 1)
        sa6 = sl2
        sa7 = sa6
        sl2.append("bc")
        for i1 in range(1):
            acc = acc + len(sl2)
            sl2.append("a")
        sg8 = grow_str(sa7, seed)
    for i2 in range(1):
        ra9 = rl3
        for i1 in range(2):
            acc = acc + len(rl3)
            if len(rl3) > 0:
                inner10 = rl3[0]
                inner10.append(5)
                acc = acc + len(inner10) + len(rl3[0])
            sl2.append("bc")
            ra9.append(make_ints(i1))
        ig11 = grow_int(il1, seed)
        for i1 in range(0):
            il1.append(i1)
            acc = acc + len(ig11)
        ig11.append(i2)
        if len(ra9) > 3:
            sl2.append("bc")
            acc = acc + len(ig11)
            ig11.append(i2)
    ia12 = il1
    ia13 = il1
    il1.append(9)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(ia12)
    acc = acc + len(ia13)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
