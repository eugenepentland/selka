def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("xyz")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(2))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(5)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(3))
    if len(il1) > 0:
        sa4 = sl2
        ia5 = il1
        ra6 = rl3
        sa4.append("a")
    sa7 = sl2
    for i2 in range(0):
        ra8 = rl3
        for i1 in range(0):
            sg9 = grow_str(sl2, i2)
            il1.append(i1)
            acc = acc + len(ra8)
        rl3.append(make_ints(3))
        for i1 in range(1):
            sl2.append("a")
            acc = acc + len(sa7)
            ra8.append(make_ints(i1))
        acc = acc + len(rl3)
    sl2.append("xyz")
    if len(sl2) > 1:
        rl3.append(make_ints(2))
        ra10 = rl3
        acc = acc + len(rl3)
        il1.append(seed)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sa7) > 0:
        out.print(sa7[len(sa7) - 1])
    acc = acc + len(sa7)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
