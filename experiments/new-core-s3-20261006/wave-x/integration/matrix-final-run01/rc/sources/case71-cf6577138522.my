def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(1)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("a")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(5)
    sl2: list[str] = []
    sl2.append("xyz")
    rl3: list[list[int]] = []
    rl3.append(make_ints(3))
    for i2 in range(2):
        for i1 in range(2):
            acc = acc + len(rl3)
            acc = acc + len(rl3)
        sl2.append("xyz")
        sa4 = sl2
        if len(il1) > 0:
            sl2.append("xyz")
            acc = acc + len(sa4)
            rg5 = grow_row(rl3, seed)
            acc = acc + len(sa4)
            if len(rg5) > 0:
                inner6 = rg5[0]
                inner6.append(5)
                acc = acc + len(inner6) + len(rg5[0])
            acc = acc + len(sa4)
    sa7 = sl2
    rl3.append(make_ints(3))
    sa8 = sl2
    ra9 = rl3
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sa7) > 0:
        out.print(sa7[len(sa7) - 1])
    acc = acc + len(sa7)
    if len(sa8) > 0:
        out.print(sa8[len(sa8) - 1])
    acc = acc + len(sa8)
    acc = acc + len(ra9)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
