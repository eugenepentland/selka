def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(5)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("a")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(3)
    sl2: list[str] = []
    sl2.append("xyz")
    rl3: list[list[int]] = []
    rl3.append(make_ints(2))
    sl2.append("xyz")
    for i2 in range(0):
        acc = acc + len(rl3)
        if len(sl2) > 0:
            acc = acc + len(sl2)
            sl2.append("a")
            ia4 = il1
            acc = acc + len(il1)
            sa5 = sl2
            ia6 = ia4
        sa7 = sl2
        sl2.append("xyz")
        rl3.append(make_ints(2))
        if len(sl2) > 1:
            ra8 = rl3
            ra9 = ra8
    sa10 = sl2
    sa11 = sa10
    sl2.append("a")
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sa10) > 0:
        out.print(sa10[len(sa10) - 1])
    acc = acc + len(sa10)
    if len(sa11) > 0:
        out.print(sa11[len(sa11) - 1])
    acc = acc + len(sa11)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
