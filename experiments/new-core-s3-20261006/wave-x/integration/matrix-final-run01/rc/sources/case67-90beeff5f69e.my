def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(3))
    rg4 = grow_row(rl3, seed)
    for i2 in range(0):
        acc = acc + len(rg4)
        ig5 = grow_int(il1, i2)
    sa6 = sl2
    rl3.append(make_ints(3))
    for i2 in range(1):
        for i1 in range(1):
            sa7 = sa6
            ia8 = il1
        ra9 = rl3
        sa10 = sl2
        if len(sa6) > 3:
            acc = acc + len(sa6)
            rl3.append(make_ints(2))
        for i1 in range(2):
            ra11 = rl3
            acc = acc + len(ra11)
            if len(rg4) > 0:
                inner12 = rg4[0]
                inner12.append(5)
                acc = acc + len(inner12) + len(rg4[0])
            ia13 = il1
            acc = acc + len(sl2)
        for i1 in range(2):
            sg14 = grow_str(sl2, i2)
            il1.append(seed)
            if len(rg4) > 0:
                inner15 = rg4[0]
                inner15.append(5)
                acc = acc + len(inner15) + len(rg4[0])
            acc = acc + len(sg14)
            ia16 = il1
            rg4.append(make_ints(3))
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(rg4)
    if len(sa6) > 0:
        out.print(sa6[len(sa6) - 1])
    acc = acc + len(sa6)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
