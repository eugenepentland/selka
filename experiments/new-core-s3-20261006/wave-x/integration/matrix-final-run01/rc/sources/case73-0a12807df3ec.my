def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("xyz")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(n))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("a")
    rl3: list[list[int]] = []
    rl3.append(make_ints(2))
    if len(sl2) > 3:
        for i1 in range(3):
            acc = acc + len(il1)
            rl3.append(make_ints(3))
            sg4 = grow_str(sl2, seed)
        sa5 = sl2
        ig6 = grow_int(il1, 1)
        sg7 = grow_str(sa5, 1)
        sa5.append("xyz")
        for i1 in range(0):
            ig6.append(2)
            acc = acc + len(il1)
            acc = acc + len(il1)
            sa8 = sg7
            sa9 = sa8
        return acc + len(sl2)
    sa10 = sl2
    rl3.append(make_ints(3))
    rg11 = grow_row(rl3, seed)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sa10) > 0:
        out.print(sa10[len(sa10) - 1])
    acc = acc + len(sa10)
    acc = acc + len(rg11)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
