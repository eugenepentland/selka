def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("xyz")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(2))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(0)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(seed))
    if len(il1) > 3:
        for i1 in range(2):
            acc = acc + len(il1)
            ia4 = il1
            il1.append(seed)
        for i1 in range(0):
            acc = acc + len(rl3)
            acc = acc + len(sl2)
            if len(rl3) > 0:
                inner5 = rl3[0]
                inner5.append(5)
                acc = acc + len(inner5) + len(rl3[0])
            ia6 = il1
            if len(rl3) > 0:
                inner7 = rl3[0]
                inner7.append(5)
                acc = acc + len(inner7) + len(rl3[0])
            ra8 = rl3
        sg9 = grow_str(sl2, 1)
    if len(rl3) > 0:
        inner10 = rl3[0]
        inner10.append(5)
        acc = acc + len(inner10) + len(rl3[0])
    for i2 in range(1):
        rg11 = grow_row(rl3, 1)
        sl2.append("xyz")
        sl2.append("a")
    sg12 = grow_str(sl2, seed)
    sl2.append("xyz")
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sg12) > 0:
        out.print(sg12[len(sg12) - 1])
    acc = acc + len(sg12)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
