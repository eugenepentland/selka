def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(2)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(n))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("xyz")
    rl3: list[list[int]] = []
    rl3.append(make_ints(seed))
    if len(il1) > 3:
        sl2.append("bc")
        if len(sl2) > 0:
            ig4 = grow_int(il1, seed)
            ia5 = il1
            rl3.append(make_ints(3))
            ia6 = ig4
        for i1 in range(2):
            il1.append(i1)
            rg7 = grow_row(rl3, 1)
            rg7.append(make_ints(i1))
            ra8 = rg7
            rg9 = grow_row(rg7, i1)
        rl3.append(make_ints(seed))
        rl3.append(make_ints(3))
        sa10 = sl2
    rl3.append(make_ints(seed))
    il1.append(seed)
    il1.append(4)
    acc = acc + len(il1)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
