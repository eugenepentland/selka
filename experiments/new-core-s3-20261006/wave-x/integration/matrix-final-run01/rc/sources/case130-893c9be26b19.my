def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(6)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("a")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(2))
    ia4 = il1
    rl3.append(make_ints(seed))
    acc = acc + len(rl3)
    for i2 in range(1):
        ia5 = il1
        ia6 = il1
        sa7 = sl2
        ia4.append(i2)
    il1.append(seed)
    ig8 = grow_int(il1, 1)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(ia4)
    acc = acc + len(ig8)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
