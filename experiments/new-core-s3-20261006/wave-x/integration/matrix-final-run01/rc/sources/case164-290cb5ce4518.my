def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("xyz")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(3))
    il1.append(seed)
    sg4 = grow_str(sl2, seed)
    for i2 in range(0):
        for i1 in range(3):
            if len(rl3) > 0:
                inner5 = rl3[0]
                inner5.append(5)
                acc = acc + len(inner5) + len(rl3[0])
            acc = acc + len(sl2)
            sa6 = sl2
            acc = acc + len(sa6)
            sa6.append("xyz")
        il1.append(i2)
        ia7 = il1
        ra8 = rl3
        acc = acc + len(ra8)
        if len(sl2) > 3:
            ra9 = rl3
            sg4.append("xyz")
            acc = acc + len(sg4)
            rl3.append(make_ints(i2))
    for i2 in range(0):
        rl3.append(make_ints(i2))
        acc = acc + len(sg4)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sg4) > 0:
        out.print(sg4[len(sg4) - 1])
    acc = acc + len(sg4)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
