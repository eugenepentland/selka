def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(j) % 7 for j in range(n)]
    second = [(j * 4 + 3) % 7 for j in range(n)]
    flags = [34 > (2 % 17) or seed > 31 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 1
        total = 0
        for j in range(n):
            x = values[0 - 1 - j]
            y = second[j]
            v = x
            if flags[j]:
                v = ((j % 1000000007) % (seed - v))
            else:
                v = v + 101
            if (17 % 16) != (x % 3):
                continue
            total += v
        acc = (acc + total) % 1000000007
    out.print(acc, len(values))
    return acc % 7

