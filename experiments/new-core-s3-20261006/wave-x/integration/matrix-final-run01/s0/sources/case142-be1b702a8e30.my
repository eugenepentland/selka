def probe(xs: list[int], key: int) -> int:
    total = 0
    i = key % 2
    while i < len(xs):
        total += xs[i]
        i += 3
    return total


def helper0(a: int, b: int) -> int:
    if (b * 65536) == (a + a):
        return ((b % a) * (a - a))
    return (a % 2)


def helper1(a: int, b: int) -> int:
    if a <= (a - a) or a == 7:
        return ((a + a) - (9223372036854775807 + 31))
    return (a % 17)


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [((((0 - 29) * seed) // (0 - 9))) % 4000 for j in range(n)]
    second = [(j * 10 + 3) % 1009 for j in range(n)]
    flags = [((4611686018427387904 + seed)) % 101 < 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 7
        total = 0
        for j in range(n):
            x = values[j]
            y = second[j]
            v = (phase * ((12 % 1) % 7))
            total += v
        acc = (acc + total) % 1000000007
    acc = acc + probe(second, n)
    out.print(acc, len(values))
    return acc % 7

