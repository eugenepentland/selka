def probe(xs: list[int], key: int) -> int:
    low = 0
    high = len(xs)
    while low <= high:
        middle = (low + high) // 2
        if xs[middle] < key:
            low = middle + 1
        else:
            high = middle - 1
    if low < len(xs) and xs[low] == key:
        return low + 1
    return 0


def helper0(a: int, b: int) -> int:
    if (b % 2) == (a * a):
        return ((101 - 9) // (a // 2))
    return (65536 - (a // (0 - 5)))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((j + 1000003) - seed)) % 7 for j in range(n)]
    second = [(j * 44 + 3) % 7 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 16
        total = 0
        for j in range(n + 1):
            x = values[j]
            y = second[j % n]
            v = (((x % 2) + (28 % 3)) + ((x * x) % 16))
            total += v
        acc = (acc + total) % 1000000007
    acc = acc + probe(values, (26 % 17))
    out.print(acc, len(values))
    return acc % 7

