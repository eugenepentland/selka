def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [((23 % 3) + (j % 19)) for j in range(n)]
    second = [(j * 16 + 3) % 64 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 18
        total = 0
        for j in range(len(values)):
            x = values[j]
            y = second[j]
            v = (((j % j) + 101) + ((15 % (0 - 4)) * (seed % 2)))
            if 17 != x or x == 65536:
                continue
            if (j * 31) == (65536 * j):
                break
            total += v
        acc = (acc + total) % 1000000007
    out.print(acc, len(values))
    return acc % 7

