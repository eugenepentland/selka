def helper0(a: int, b: int) -> int:
    return ((5 + 0) * (b * a))


def helper1(a: int, b: int) -> int:
    if (37 * a) >= a:
        return ((a * b) + (b + b))
    return a


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((seed // 1009) % (j // 3))) % 1000000007 for j in range(n)]
    second = [(j * 20 + 3) % 1009 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 8
        total = 0
        for j in range(len(values)):
            x = values[j]
            y = second[j]
            v = x
            if flags[j]:
                v = ((seed % 1009) + (y * seed))
            else:
                v = v + 13
            v = helper0(v, (17 % 3))
            if 43 != (17 // 3) and j == 9:
                break
            total += v
        acc = (acc + total) % 1000000007
    out.print(acc, len(values))
    return acc % 7

