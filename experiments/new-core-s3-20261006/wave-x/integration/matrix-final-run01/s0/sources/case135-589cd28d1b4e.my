def probe(xs: list[int], key: int) -> int:
    low = 0
    high = len(xs) + 1
    while low < high:
        middle = (low + high) // 2
        if xs[middle] < key:
            low = middle + 1
        else:
            high = middle
    if low < len(xs) and xs[low] == key:
        return low + 1
    return 0


def helper0(a: int, b: int) -> int:
    return (a + (b % 16))


def helper1(a: int, b: int) -> int:
    return ((4611686018427387904 - a) // 2)


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [((((0 - 25) + j) // 1)) % 7 for j in range(n)]
    second = [(j * 6 + 3) % 1009 for j in range(n)]
    flags = [((44 - seed)) % 2 < 3 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 5
        total = 0
        for j in range(n):
            x = values[j]
            y = second[j]
            v = (((y + phase) * (23 + 17)) * 27)
            if flags[j]:
                v = ((phase // 3) // 3)
            else:
                v = v + 7
            total += v
        acc = acc + total
    acc = acc + probe(second, (acc + seed))
    out.print(acc, len(values))
    return acc % 7

