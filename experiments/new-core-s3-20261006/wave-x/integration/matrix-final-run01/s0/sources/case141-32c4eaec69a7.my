def probe(xs: list[int], key: int) -> int:
    low = 0
    high = len(xs) + 1
    while low < high:
        middle = (low + high) // 2
        if xs[middle] < key:
            low = middle + 1
        else:
            high = middle
    if low < len(xs) and xs[low] == key:
        return low + 1
    return 0


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((j // j) * (9223372036854775807 + 9))) % 7 for j in range(n)]
    second = [(j * 33 + 3) % 4000 for j in range(n)]
    flags = [(seed + seed) <= (j * 15) and j < 8 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 11
        total = 0
        for j in range(n):
            x = values[n - 1 - j]
            y = second[j]
            v = (((seed - 50) - (phase % 1000000007)) - ((phase + x) % y))
            if (20 % 17) > 9:
                continue
            total += v
        acc = (acc + total) % 1000000007
    acc = acc + probe(second, (0 - 14))
    out.print(acc, len(values))
    return acc % 7

