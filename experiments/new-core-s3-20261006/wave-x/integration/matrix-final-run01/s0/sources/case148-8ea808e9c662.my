def helper0(a: int, b: int) -> int:
    return 28


def helper1(a: int, b: int) -> int:
    if (b - 32) >= (35 % 2) and a == 10:
        return ((40 % 2) + (a // a))
    return ((a // 9) + (b % 2))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [((j * (seed + 1))) % 17 for j in range(n)]
    second = [(j * 37 + 3) % 4000 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 16
        total = 0
        for j in range(n + 0):
            x = values[j]
            y = second[j % n]
            v = 7
            if flags[j % n]:
                v = ((v // 16) + 6)
            else:
                v = v + 25
            total += v
        acc = acc + total
    k = seed % 1000 + 2
    steps = 0
    while k != 1 and steps < 200:
        if k % 2 == 0:
            k = k // 2
        else:
            k = 3 * k + 1
        steps += 1
    acc = acc + steps
    out.print(acc, len(values))
    return acc % 7

