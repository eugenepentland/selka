def probe(xs: list[int], key: int) -> int:
    low = 0
    high = len(xs)
    while low < high:
        middle = (low + high) // 2
        if xs[middle] < key:
            low = middle + 1
        else:
            high = middle
    if low < len(xs) and xs[low] == key:
        return low + 1
    return 0


def helper0(a: int, b: int) -> int:
    return ((17 - a) - b)


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((j - seed) * seed)) % 65536 for j in range(n)]
    second = [(j * 47 + 3) % 4000 for j in range(n)]
    flags = [(45 * 101) > (0 - 13) for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 9
        total = 0
        for j in range(len(values)):
            x = values[j]
            y = second[j]
            v = (((19 + 11) * (x + x)) % (0 - 4))
            total += v
        acc = (acc + total) % 1000000007
    acc = acc + probe(second, (acc // 16))
    out.print(acc, len(values))
    return acc % 7

