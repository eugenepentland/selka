def helper0(a: int, b: int) -> int:
    if (a - b) == (a + 34):
        return (a + (a // b))
    return ((a - a) // (18 - 37))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((seed - 10) * (j + 4611686018427387904))) % 1009 for j in range(n)]
    second = [(j * 3 + 3) % 7 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 17
        total = 0
        for j in range(len(values)):
            x = values[j]
            y = second[j]
            v = (((x * 20) + (y + phase)) % 1009)
            if flags[j]:
                v = (x % 1)
            else:
                v = v + 15
            total += v
        acc = acc + total
    k = seed % 1000 + 2
    steps = 0
    while k != 1 and steps < 200:
        if k % 2 == 0:
            k = k // 2
        else:
            k = 3 * k + 1
        steps += 1
    acc = acc + steps
    out.print(acc, len(values))
    return acc % 7

