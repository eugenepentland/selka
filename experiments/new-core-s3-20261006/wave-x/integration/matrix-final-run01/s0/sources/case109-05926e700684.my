def probe(xs: list[int], key: int) -> int:
    low = 0
    high = len(xs)
    while low < high:
        middle = (low + high) // 2
        if xs[middle] < key:
            low = middle + 1
        else:
            high = middle
    if low < len(xs) and xs[low] == key:
        return low + 1
    return 0


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(j) % 1000000007 for j in range(n)]
    second = [(j * 2 + 3) % 4000 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 1
        total = 0
        for j in range(len(values)):
            x = values[j + 1]
            y = second[j]
            v = (((27 * phase) + ((0 - 32) * 3037000500)) * ((j - seed) * (38 // phase)))
            if flags[j]:
                v = ((x % 3) % (y + (0 - 35)))
            else:
                v = v + 26
            if (4 + x) == (101 * phase) and seed == 1009:
                break
            total += v
        acc = acc + total
    acc = acc + probe(values, (1000003 % 1))
    out.print(acc, len(values))
    return acc % 7

