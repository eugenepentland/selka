def probe(xs: list[int], key: int) -> int:
    low = 0
    high = len(xs) + 1
    while low < high:
        middle = (low + high) // 2
        if xs[middle] < key:
            low = middle + 1
        else:
            high = middle
    if low < len(xs) and xs[low] == key:
        return low + 1
    return 0


def helper0(a: int, b: int) -> int:
    if b == (a * b):
        return ((b - b) - (25 * b))
    return ((b // 1009) - (b * b))


def helper1(a: int, b: int) -> int:
    if b == ((0 - 12) + b):
        return b
    return ((a % (0 - 4)) % 3)


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((35 * 44) * ((0 - 8) + j))) % 7 for j in range(n)]
    second = [(j * 12 + 3) % 64 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 9
        total = 0
        for j in range(n + 2):
            x = values[j + 1]
            y = second[j % n]
            v = (((seed - phase) + phase) * ((x - y) // 3))
            if flags[j % n]:
                v = ((x + x) - (v % 16))
            else:
                v = v + 28
            v = helper0(v, x)
            if (y * j) != (y - seed):
                break
            total += v
        acc = (acc + total) % 1000000007
    k = seed % 1000 + 2
    steps = 0
    while k != 1 and steps < 200:
        if k % 2 == 0:
            k = k // 2
        else:
            k = 3 * k + 1
        steps += 1
    acc = acc + steps
    acc = acc + probe(values, (seed % 1))
    out.print(acc, len(values))
    return acc % 7

