def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((j + seed) + ((0 - 2) + 65536))) % 65536 for j in range(n)]
    second = [(j * 17 + 3) % 4000 for j in range(n)]
    flags = [36 <= (seed + 23) for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 13
        total = 0
        for j in range(n - 1):
            x = values[j]
            y = second[j]
            v = (((39 * 2) * 3037000500) * (23 % 3))
            total += v
        acc = acc + total
    out.print(acc, len(values))
    return acc % 7

