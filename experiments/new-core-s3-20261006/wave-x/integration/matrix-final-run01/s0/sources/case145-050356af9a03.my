def probe(xs: list[int], key: int) -> int:
    i = key % 71 - 2
    if i >= 0:
        if i < len(xs):
            return xs[i]
    return 0


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [((16 + seed)) % 1009 for j in range(n)]
    second = [(j * 46 + 3) % 4000 for j in range(n)]
    flags = [((j // seed)) % 2 < 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 2
        total = 0
        for j in range(n + 2):
            x = values[j]
            y = second[j % n]
            v = 2
            if flags[j % n]:
                v = (x * x)
            else:
                v = v + 9
            total += v
        acc = (acc + total) % 1000000007
    k = seed % 1000 + 2
    steps = 0
    while k != 1 and steps < 200:
        if k % 2 == 0:
            k = k // 2
        else:
            k = 3 * k + 1
        steps += 1
    acc = acc + steps
    acc = acc + probe(second, (n % 1009))
    out.print(acc, len(values))
    return acc % 7

