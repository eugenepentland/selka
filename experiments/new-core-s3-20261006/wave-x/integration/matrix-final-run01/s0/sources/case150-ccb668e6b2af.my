def probe(xs: list[int], key: int) -> int:
    low = 0
    high = len(xs)
    while low < high:
        middle = (low + high) // 2
        if xs[middle] < key:
            low = middle + 1
        else:
            high = middle
    if low < len(xs) and xs[low] == key:
        return low + 1
    return 0


def helper0(a: int, b: int) -> int:
    if b >= (b - 42):
        return (a - (a + a))
    return ((50 // 7) % 7)


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((seed - j) % 3)) % 4000 for j in range(n)]
    second = [(j * 49 + 3) % 4000 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 20
        total = 0
        for j in range(len(values)):
            x = values[j]
            y = second[j]
            v = (((x + phase) + (x + y)) // 7)
            if flags[j]:
                v = (22 + (22 % 1009))
            else:
                v = v + 0
            total += v
        acc = acc + total
    acc = acc + probe(values, (4611686018427387904 * seed))
    out.print(acc, len(values))
    return acc % 7

