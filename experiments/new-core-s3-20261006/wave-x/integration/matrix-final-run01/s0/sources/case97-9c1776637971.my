def probe(xs: list[int], key: int) -> int:
    i = key % 71 - 3
    if i >= 0:
        if i < len(xs):
            return xs[i]
    return 0


def helper0(a: int, b: int) -> int:
    return ((48 // 17) % 7)


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((seed * j) + (j * seed))) % 4000 for j in range(n)]
    second = [(j * 41 + 3) % 4000 for j in range(n)]
    flags = [((seed * seed)) % 2 < 57 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 8
        total = 0
        for j in range(n):
            x = values[j]
            y = second[j]
            v = y
            if flags[j]:
                v = ((13 + x) // 16)
            else:
                v = v + 16
            total += v
        acc = (acc + total) % 1000000007
    acc = acc + probe(second, n)
    out.print(acc, len(values))
    return acc % 7

