def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((seed * j) * seed)) % 65536 for j in range(n)]
    second = [(j * 25 + 3) % 4000 for j in range(n)]
    flags = [(65536 % 1009) < (0 - 23) and j > 1000003 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 17
        total = 0
        for j in range(n):
            x = values[n - 1 - j]
            y = second[j]
            v = (((31 + phase) + (101 - x)) + ((x * 13) + y))
            if flags[j]:
                v = ((v % 2) % (seed + j))
            else:
                v = v + 7
            if (65536 * seed) >= (phase % y):
                break
            total += v
        acc = acc + total
    out.print(acc, len(values))
    return acc % 7

