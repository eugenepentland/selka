def probe(xs: list[int], key: int) -> int:
    low = 0
    high = len(xs)
    while low < high:
        middle = (low + high) // 2
        if xs[middle] < key:
            low = middle + 1
        else:
            high = middle
    if low < len(xs) and xs[low] == key:
        return low + 1
    return 0


def helper0(a: int, b: int) -> int:
    if (b % 7) >= (a + b):
        return ((38 * a) % 1009)
    return ((a + b) * ((0 - 20) * a))


def helper1(a: int, b: int) -> int:
    if (b % 1000000007) < (a * 43):
        return 3
    return a


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [((25 % (j % 7))) % 65536 for j in range(n)]
    second = [(j * 23 + 3) % 7 for j in range(n)]
    flags = [(seed - 4611686018427387904) == (seed * seed) or seed == 17 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 20
        total = 0
        for j in range(len(values)):
            x = values[j]
            y = second[j]
            v = (((seed + x) % 17) // 17)
            v = helper0(v, ((0 - 34) + 1000003))
            total += v
        acc = (acc + total) % 1000000007
    acc = acc + probe(values, (n % (0 - 6)))
    out.print(acc, len(values))
    return acc % 7

