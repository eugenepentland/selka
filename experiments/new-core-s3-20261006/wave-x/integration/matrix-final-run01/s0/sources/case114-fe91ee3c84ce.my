def probe(xs: list[int], key: int) -> int:
    i = key % 67 - 1
    if i >= 0:
        if i < len(xs):
            return xs[i]
    return 0


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((j - seed) % (seed + 8))) % 17 for j in range(n)]
    second = [(j * 28 + 3) % 4000 for j in range(n)]
    flags = [((seed + seed)) % 3 < 17 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 10
        total = 0
        for j in range(n):
            x = values[j]
            y = second[j]
            v = (((phase % 1009) * phase) // 16)
            if flags[j]:
                v = ((v // 3) * (phase + 10))
            else:
                v = v + 8
            total += v
        acc = acc + total
    acc = acc + probe(values, n)
    out.print(acc, len(values))
    return acc % 7

