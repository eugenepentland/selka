def helper0(a: int, b: int) -> int:
    return ((b + 0) * (a - 32))


def helper1(a: int, b: int) -> int:
    if 65536 != (b - b) and a == (0 - 32):
        return ((a * a) + (a % 1))
    return ((b // 2) + (18 * 7))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(41) % 1000000007 for j in range(n)]
    second = [(j * 41 + 3) % 4000 for j in range(n)]
    flags = [(seed % 2) < (j - j) and seed < 1 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 10
        total = 0
        for j in range(n + 2):
            x = values[j]
            y = second[j % n]
            v = (y // 2)
            v = helper0(v, (y % 7))
            if phase == (j // (0 - 3)):
                continue
            total += v
        acc = acc + total
    out.print(acc, len(values))
    return acc % 7

