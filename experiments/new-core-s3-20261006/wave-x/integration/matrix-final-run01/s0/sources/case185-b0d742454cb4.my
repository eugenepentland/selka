def helper0(a: int, b: int) -> int:
    return a


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(j) % 1000000007 for j in range(n)]
    second = [(j * 13 + 3) % 1009 for j in range(n)]
    flags = [j != (9 + seed) for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 18
        total = 0
        for j in range(len(values)):
            x = values[0 - 1 - j]
            y = second[j]
            v = (((37 % (0 - 3)) % (0 - 5)) % ((49 // j) // ((0 - 28) + j)))
            v = helper0(v, ((0 - 36) + 43))
            if (seed % phase) < (j * x):
                break
            total += v
        acc = (acc + total) % 1000000007
    out.print(acc, len(values))
    return acc % 7

