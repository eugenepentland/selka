def helper0(a: int, b: int) -> int:
    if 32 > (a * 42) or b < 3037000500:
        return (b - (b - b))
    return b


def helper1(a: int, b: int) -> int:
    if (a * 1) == (b + a):
        return ((a * b) // 1)
    return (a * (a + a))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((0 % 16) + (seed + seed))) % 17 for j in range(n)]
    second = [(j * 36 + 3) % 7 for j in range(n)]
    flags = [((seed - 35)) % 3 < 35 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 5
        total = 0
        for j in range(n):
            x = values[j]
            y = second[j]
            v = 26
            total += v
        acc = (acc + total) % 1000000007
    out.print(acc, len(values))
    return acc % 7

