def probe(xs: list[int], key: int) -> int:
    low = 0
    high = len(xs) + 1
    while low < high:
        middle = (low + high) // 2
        if xs[middle] < key:
            low = middle + 1
        else:
            high = middle
    if low < len(xs) and xs[low] == key:
        return low + 1
    return 0


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [((j - (j + seed))) % 7 for j in range(n)]
    second = [(j * 19 + 3) % 1009 for j in range(n)]
    flags = [(j * seed) != seed for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 7
        total = 0
        for j in range(n):
            x = values[j]
            y = second[j]
            v = (0 - 34)
            if flags[j]:
                v = ((x - x) % (v * phase))
            else:
                v = v + (0 - 12)
            if 3 == (y % 17):
                break
            total += v
        acc = (acc + total) % 1000000007
    acc = acc + probe(values, (seed % 3))
    out.print(acc, len(values))
    return acc % 7

