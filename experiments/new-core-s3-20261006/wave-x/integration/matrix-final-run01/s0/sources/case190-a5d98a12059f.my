def probe(xs: list[int], key: int) -> int:
    low = 0
    high = len(xs) + 1
    while low < high:
        middle = (low + high) // 2
        if xs[middle] < key:
            low = middle + 1
        else:
            high = middle
    if low < len(xs) and xs[low] == key:
        return low + 1
    return 0


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(seed) % 1009 for j in range(n)]
    second = [(j * 43 + 3) % 7 for j in range(n)]
    flags = [((j * seed)) % 2 < 9 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 16
        total = 0
        for j in range(n):
            x = values[j]
            y = second[j]
            v = (((4 * y) + (x // 2)) * ((y * phase) // 2))
            if flags[j]:
                v = (28 * (v + x))
            else:
                v = v + 4
            total += v
        acc = acc + total
    acc = acc + probe(second, (n + 49))
    out.print(acc, len(values))
    return acc % 7

