def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((seed - j) + (seed * j))) % 4000 for j in range(n)]
    second = [(j * 27 + 3) % 7 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 9
        total = 0
        for j in range(n + 0):
            x = values[j]
            y = second[j % n]
            v = ((x + (phase + y)) * ((x % 16) + phase))
            if flags[j % n]:
                v = ((v % 7) * (14 * v))
            else:
                v = v + 26
            total += v
        acc = acc + total
    out.print(acc, len(values))
    return acc % 7

