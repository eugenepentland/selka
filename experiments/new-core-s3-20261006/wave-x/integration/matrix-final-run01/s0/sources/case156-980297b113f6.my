def probe(xs: list[int], key: int) -> int:
    i = key % 56 - 3
    if i >= 0:
        if i <= len(xs):
            return xs[i]
    return 0


def helper0(a: int, b: int) -> int:
    return ((a + b) * b)


def helper1(a: int, b: int) -> int:
    if 13 > (a - b) and b < 43:
        return (b // (b // 7))
    return (6 + a)


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [((seed - (4611686018427387904 * j))) % 1009 for j in range(n)]
    second = [(j * 42 + 3) % 1009 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 9
        total = 0
        for j in range(len(values)):
            x = values[j]
            y = second[j]
            v = (((y // 101) + (27 * x)) % 1)
            if flags[j]:
                v = ((x % 3) // 1009)
            else:
                v = v + 25
            total += v
        acc = (acc + total) % 1000000007
    acc = acc + probe(values, (11 % 7))
    out.print(acc, len(values))
    return acc % 7

