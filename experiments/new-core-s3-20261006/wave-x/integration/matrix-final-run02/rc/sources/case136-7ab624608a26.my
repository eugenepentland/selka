def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(2)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("a")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(2))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(2))
    for i2 in range(1):
        il1.append(seed)
        sa4 = sl2
        ra5 = rl3
        rg6 = grow_row(ra5, i2)
    sa7 = sl2
    acc = acc + len(sl2)
    if len(sa7) > 0:
        sa7.append("a")
        sg8 = grow_str(sl2, seed)
        for i1 in range(3):
            sa9 = sl2
            acc = acc + len(il1)
        sa10 = sl2
        rg11 = grow_row(rl3, 1)
        acc = acc + len(sl2)
        return acc + len(sa7)
    sa7.append("a")
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sa7) > 0:
        out.print(sa7[len(sa7) - 1])
    acc = acc + len(sa7)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
