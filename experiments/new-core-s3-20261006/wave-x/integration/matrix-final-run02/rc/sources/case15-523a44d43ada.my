def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(9)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("a")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(n))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("a")
    rl3: list[list[int]] = []
    rl3.append(make_ints(2))
    rl3.append(make_ints(2))
    for i2 in range(3):
        acc = acc + len(rl3)
        sl2.append("a")
        ra4 = rl3
        ra4.append(make_ints(2))
        ra5 = rl3
        sa6 = sl2
    for i2 in range(3):
        il1.append(seed)
        rl3.append(make_ints(seed))
        ia7 = il1
        for i1 in range(3):
            sl2.append("bc")
            acc = acc + len(ia7)
            sa8 = sl2
    sa9 = sl2
    if len(il1) > 1:
        sl2.append("bc")
        rg10 = grow_row(rl3, seed)
        rg10.append(make_ints(2))
        for i1 in range(1):
            acc = acc + len(rl3)
            sa9.append("bc")
            sa9.append("a")
            sg11 = grow_str(sa9, seed)
        ra12 = rg10
        ra13 = rg10
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sa9) > 0:
        out.print(sa9[len(sa9) - 1])
    acc = acc + len(sa9)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
