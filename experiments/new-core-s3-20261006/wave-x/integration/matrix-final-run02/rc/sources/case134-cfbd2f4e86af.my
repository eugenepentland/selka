def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(1)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("xyz")
    rl3: list[list[int]] = []
    rl3.append(make_ints(seed))
    sl2.append("xyz")
    if len(rl3) > 3:
        for i1 in range(2):
            il1.append(6)
            sl2.append("bc")
            rl3.append(make_ints(3))
        for i1 in range(2):
            acc = acc + len(sl2)
            il1.append(seed)
            acc = acc + len(sl2)
            sa4 = sl2
        rg5 = grow_row(rl3, 1)
        ra6 = rg5
        rl3.append(make_ints(seed))
        il1.append(seed)
        return acc + len(rl3)
    sg7 = grow_str(sl2, seed)
    acc = acc + len(sg7)
    ia8 = il1
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sg7) > 0:
        out.print(sg7[len(sg7) - 1])
    acc = acc + len(sg7)
    acc = acc + len(ia8)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
