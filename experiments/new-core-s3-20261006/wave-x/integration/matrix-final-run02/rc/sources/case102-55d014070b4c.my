def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("a")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(2))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(1)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(3))
    sl2.append("a")
    sg4 = grow_str(sl2, 1)
    if len(rl3) > 0:
        inner5 = rl3[0]
        inner5.append(5)
        acc = acc + len(inner5) + len(rl3[0])
    sa6 = sl2
    sg7 = grow_str(sa6, seed)
    if len(sg4) > 0:
        sg8 = grow_str(sl2, 1)
        sa9 = sa6
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sg4) > 0:
        out.print(sg4[len(sg4) - 1])
    acc = acc + len(sg4)
    if len(sa6) > 0:
        out.print(sa6[len(sa6) - 1])
    acc = acc + len(sa6)
    if len(sg7) > 0:
        out.print(sg7[len(sg7) - 1])
    acc = acc + len(sg7)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
