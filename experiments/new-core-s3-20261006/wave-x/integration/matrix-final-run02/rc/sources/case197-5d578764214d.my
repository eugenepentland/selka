def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(n))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(6)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(3))
    for i2 in range(2):
        ra4 = rl3
        sl2.append("a")
        rg5 = grow_row(rl3, seed)
        ia6 = il1
        if len(ra4) > 0:
            inner7 = ra4[0]
            inner7.append(5)
            acc = acc + len(inner7) + len(ra4[0])
        ig8 = grow_int(il1, seed)
    for i2 in range(3):
        il1.append(9)
        sa9 = sl2
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
