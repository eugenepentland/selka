def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(n))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("xyz")
    rl3: list[list[int]] = []
    rl3.append(make_ints(3))
    sa4 = sl2
    il1.append(seed)
    for i2 in range(0):
        il1.append(5)
        if len(il1) > 3:
            ra5 = rl3
            sa6 = sa4
            sa4.append("a")
            ia7 = il1
            ig8 = grow_int(ia7, 1)
            return acc + len(il1)
        ig9 = grow_int(il1, seed)
        rl3.append(make_ints(i2))
        sa4.append("xyz")
    sa10 = sa4
    for i2 in range(0):
        if len(rl3) > 0:
            inner11 = rl3[0]
            inner11.append(5)
            acc = acc + len(inner11) + len(rl3[0])
        for i1 in range(1):
            acc = acc + len(sl2)
            ra12 = rl3
        for i1 in range(1):
            acc = acc + len(sl2)
            sl2.append("a")
            acc = acc + len(sl2)
            acc = acc + len(sa10)
            acc = acc + len(sa4)
    sa13 = sa10
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sa4) > 0:
        out.print(sa4[len(sa4) - 1])
    acc = acc + len(sa4)
    if len(sa10) > 0:
        out.print(sa10[len(sa10) - 1])
    acc = acc + len(sa10)
    if len(sa13) > 0:
        out.print(sa13[len(sa13) - 1])
    acc = acc + len(sa13)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
