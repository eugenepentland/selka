def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(3))
    ra4 = rl3
    for i2 in range(3):
        if len(rl3) > 0:
            inner5 = rl3[0]
            inner5.append(5)
            acc = acc + len(inner5) + len(rl3[0])
        rg6 = grow_row(ra4, 1)
        ia7 = il1
        ra4.append(make_ints(3))
        if len(il1) > 3:
            sg8 = grow_str(sl2, seed)
            ia9 = il1
            acc = acc + len(rl3)
            acc = acc + len(sg8)
    sl2.append("bc")
    acc = acc + len(ra4)
    for i2 in range(2):
        sl2.append("a")
        if len(il1) > 0:
            ra10 = ra4
            acc = acc + len(il1)
            acc = acc + len(rl3)
            rg11 = grow_row(ra4, 1)
            return acc + len(il1)
        ra12 = ra4
        rg13 = grow_row(ra12, seed)
    ra14 = ra4
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(ra4)
    acc = acc + len(ra14)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
