def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(2)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(2))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(1)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(2))
    il1.append(6)
    ra4 = rl3
    sg5 = grow_str(sl2, 1)
    for i2 in range(1):
        if len(il1) > 3:
            sg6 = grow_str(sg5, 1)
            il1.append(7)
            sg5.append("bc")
            rl3.append(make_ints(3))
            sg6.append("a")
        rl3.append(make_ints(3))
        ra4.append(make_ints(i2))
        for i1 in range(3):
            sa7 = sg5
            sg5.append("a")
        for i1 in range(1):
            ra4.append(make_ints(seed))
            acc = acc + len(il1)
            sa8 = sg5
            ra4.append(make_ints(seed))
            sa9 = sa8
            ra4.append(make_ints(i2))
        ra4.append(make_ints(i2))
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(ra4)
    if len(sg5) > 0:
        out.print(sg5[len(sg5) - 1])
    acc = acc + len(sg5)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
