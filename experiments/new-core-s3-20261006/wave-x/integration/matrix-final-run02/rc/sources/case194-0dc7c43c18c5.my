def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("xyz")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(n))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("a")
    rl3: list[list[int]] = []
    rl3.append(make_ints(seed))
    if len(il1) > 1:
        for i1 in range(1):
            rl3.append(make_ints(seed))
            ig4 = grow_int(il1, i1)
            ig4.append(i1)
            ia5 = il1
            acc = acc + len(ig4)
        for i1 in range(2):
            il1.append(2)
            ra6 = rl3
            acc = acc + len(il1)
            ra7 = rl3
            ig8 = grow_int(il1, 1)
            ra9 = ra6
        sa10 = sl2
    ra11 = rl3
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(ra11)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
