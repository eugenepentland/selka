def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(8)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(2))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("a")
    rl3: list[list[int]] = []
    rl3.append(make_ints(2))
    sg4 = grow_str(sl2, seed)
    sg4.append("a")
    if len(sl2) > 3:
        sl2.append("bc")
        ra5 = rl3
        if len(ra5) > 0:
            inner6 = ra5[0]
            inner6.append(5)
            acc = acc + len(inner6) + len(ra5[0])
        ia7 = il1
        sl2.append("a")
        for i1 in range(2):
            rl3.append(make_ints(3))
            acc = acc + len(rl3)
            ra5.append(make_ints(seed))
            ra8 = ra5
            ia7.append(seed)
            sl2.append("a")
    if len(rl3) > 0:
        if len(rl3) > 0:
            inner9 = rl3[0]
            inner9.append(5)
            acc = acc + len(inner9) + len(rl3[0])
        il1.append(1)
        sl2.append("bc")
        rl3.append(make_ints(seed))
        sa10 = sg4
        sa11 = sa10
    acc = acc + len(il1)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sg4) > 0:
        out.print(sg4[len(sg4) - 1])
    acc = acc + len(sg4)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
