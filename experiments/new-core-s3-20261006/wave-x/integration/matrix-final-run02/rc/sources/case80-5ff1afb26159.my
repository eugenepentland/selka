def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("xyz")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(2))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("xyz")
    rl3: list[list[int]] = []
    rl3.append(make_ints(2))
    acc = acc + len(sl2)
    for i2 in range(2):
        rl3.append(make_ints(seed))
        ia4 = il1
        ia5 = ia4
        for i1 in range(0):
            acc = acc + len(ia4)
            acc = acc + len(rl3)
            acc = acc + len(ia4)
            ia6 = il1
    for i2 in range(2):
        rl3.append(make_ints(3))
        if len(il1) > 1:
            rg7 = grow_row(rl3, 1)
            sg8 = grow_str(sl2, 1)
            if len(rl3) > 0:
                inner9 = rl3[0]
                inner9.append(5)
                acc = acc + len(inner9) + len(rl3[0])
            rg7.append(make_ints(seed))
            acc = acc + len(rg7)
            sg10 = grow_str(sl2, 1)
        il1.append(i2)
        il1.append(i2)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
