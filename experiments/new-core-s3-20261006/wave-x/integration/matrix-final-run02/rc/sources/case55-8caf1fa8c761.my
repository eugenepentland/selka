def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(3)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("a")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("a")
    rl3: list[list[int]] = []
    rl3.append(make_ints(2))
    sa4 = sl2
    rl3.append(make_ints(2))
    sa5 = sl2
    sa6 = sa4
    for i2 in range(0):
        sa6.append("bc")
        ia7 = il1
        acc = acc + len(rl3)
        if len(sa5) > 1:
            sa8 = sa4
            acc = acc + len(il1)
            acc = acc + len(sl2)
            acc = acc + len(rl3)
            sa9 = sa8
            il1.append(0)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sa4) > 0:
        out.print(sa4[len(sa4) - 1])
    acc = acc + len(sa4)
    if len(sa5) > 0:
        out.print(sa5[len(sa5) - 1])
    acc = acc + len(sa5)
    if len(sa6) > 0:
        out.print(sa6[len(sa6) - 1])
    acc = acc + len(sa6)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
