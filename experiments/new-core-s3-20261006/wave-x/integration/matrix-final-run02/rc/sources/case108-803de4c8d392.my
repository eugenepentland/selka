def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(5)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("a")
    rl3: list[list[int]] = []
    rl3.append(make_ints(2))
    rl3.append(make_ints(3))
    for i2 in range(3):
        il1.append(5)
        sa4 = sl2
        sl2.append("a")
        for i1 in range(0):
            acc = acc + len(il1)
            ia5 = il1
            rg6 = grow_row(rl3, i2)
            rg7 = grow_row(rg6, 1)
            rg6.append(make_ints(i2))
            rg6.append(make_ints(seed))
        if len(sa4) > 2:
            rg8 = grow_row(rl3, seed)
            rg8.append(make_ints(i2))
            return acc + len(sa4)
        sa9 = sl2
    rg10 = grow_row(rl3, 1)
    rl3.append(make_ints(3))
    rl3.append(make_ints(3))
    ra11 = rg10
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(rg10)
    acc = acc + len(ra11)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
