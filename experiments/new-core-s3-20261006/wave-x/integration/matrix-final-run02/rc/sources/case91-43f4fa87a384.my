def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(5)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("a")
    rl3: list[list[int]] = []
    rl3.append(make_ints(seed))
    for i2 in range(3):
        rl3.append(make_ints(i2))
        sa4 = sl2
        if len(il1) > 2:
            acc = acc + len(sl2)
            acc = acc + len(sa4)
            ia5 = il1
            return acc + len(il1)
        for i1 in range(1):
            ia6 = il1
            acc = acc + len(il1)
        for i1 in range(0):
            sa7 = sl2
            sa4.append("bc")
            acc = acc + len(sl2)
            sa7.append("a")
            sa7.append("a")
            acc = acc + len(il1)
        if len(rl3) > 3:
            sa8 = sa4
            rl3.append(make_ints(i2))
            acc = acc + len(sl2)
            rl3.append(make_ints(2))
            return acc + len(rl3)
    sl2.append("bc")
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
