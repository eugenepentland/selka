def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("a")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(9)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(3))
    if len(rl3) > 1:
        if len(rl3) > 0:
            sa4 = sl2
            ra5 = rl3
            sa4.append("a")
            return acc + len(rl3)
        sl2.append("bc")
        ia6 = il1
    for i2 in range(2):
        acc = acc + len(il1)
        sl2.append("bc")
    for i2 in range(2):
        rg7 = grow_row(rl3, seed)
        acc = acc + len(sl2)
    sa8 = sl2
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sa8) > 0:
        out.print(sa8[len(sa8) - 1])
    acc = acc + len(sa8)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
