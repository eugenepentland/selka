def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("xyz")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(2))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(9)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(3))
    for i2 in range(1):
        for i1 in range(2):
            rl3.append(make_ints(3))
            acc = acc + len(rl3)
            sg4 = grow_str(sl2, 1)
        rg5 = grow_row(rl3, 1)
        acc = acc + len(rg5)
        ra6 = rg5
        if len(ra6) > 0:
            inner7 = ra6[0]
            inner7.append(5)
            acc = acc + len(inner7) + len(ra6[0])
    rl3.append(make_ints(seed))
    sg8 = grow_str(sl2, seed)
    sa9 = sg8
    sa10 = sa9
    sl2.append("a")
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sg8) > 0:
        out.print(sg8[len(sg8) - 1])
    acc = acc + len(sg8)
    if len(sa9) > 0:
        out.print(sa9[len(sa9) - 1])
    acc = acc + len(sa9)
    if len(sa10) > 0:
        out.print(sa10[len(sa10) - 1])
    acc = acc + len(sa10)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
