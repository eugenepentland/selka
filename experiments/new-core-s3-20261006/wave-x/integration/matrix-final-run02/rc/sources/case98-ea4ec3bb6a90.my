def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("xyz")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(n))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(3)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(seed))
    ia4 = il1
    sa5 = sl2
    sg6 = grow_str(sa5, 1)
    rl3.append(make_ints(seed))
    if len(sg6) > 1:
        for i1 in range(2):
            sg6.append("bc")
            ia7 = il1
            rl3.append(make_ints(2))
            ra8 = rl3
        ia4.append(seed)
        il1.append(seed)
        ia9 = il1
        sa10 = sa5
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(ia4)
    if len(sa5) > 0:
        out.print(sa5[len(sa5) - 1])
    acc = acc + len(sa5)
    if len(sg6) > 0:
        out.print(sg6[len(sg6) - 1])
    acc = acc + len(sg6)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
