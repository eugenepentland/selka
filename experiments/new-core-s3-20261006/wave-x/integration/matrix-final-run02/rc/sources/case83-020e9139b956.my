def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("a")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(2))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(7)
    sl2: list[str] = []
    sl2.append("bc")
    rl3: list[list[int]] = []
    rl3.append(make_ints(seed))
    for i2 in range(3):
        if len(sl2) > 3:
            sa4 = sl2
            ig5 = grow_int(il1, seed)
            sa6 = sa4
            ra7 = rl3
            return acc + len(sl2)
        acc = acc + len(sl2)
        sl2.append("bc")
        for i1 in range(2):
            rl3.append(make_ints(3))
            ra8 = rl3
            ia9 = il1
    for i2 in range(0):
        acc = acc + len(sl2)
        sl2.append("xyz")
    rl3.append(make_ints(seed))
    rl3.append(make_ints(3))
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
