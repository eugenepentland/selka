def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("a")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(n))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(0)
    sl2: list[str] = []
    sl2.append("a")
    rl3: list[list[int]] = []
    rl3.append(make_ints(3))
    if len(rl3) > 0:
        inner4 = rl3[0]
        inner4.append(5)
        acc = acc + len(inner4) + len(rl3[0])
    il1.append(seed)
    for i2 in range(0):
        ig5 = grow_int(il1, i2)
        il1.append(6)
        for i1 in range(3):
            if len(rl3) > 0:
                inner6 = rl3[0]
                inner6.append(5)
                acc = acc + len(inner6) + len(rl3[0])
            acc = acc + len(ig5)
            ra7 = rl3
            if len(ra7) > 0:
                inner8 = ra7[0]
                inner8.append(5)
                acc = acc + len(inner8) + len(ra7[0])
            acc = acc + len(rl3)
        acc = acc + len(ig5)
    ig9 = grow_int(il1, 1)
    rl3.append(make_ints(seed))
    for i2 in range(1):
        for i1 in range(1):
            ia10 = ig9
            acc = acc + len(ia10)
            ia11 = ia10
            ia12 = il1
        rl3.append(make_ints(i2))
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(ig9)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
