def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(9)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("a")
    rl3: list[list[int]] = []
    rl3.append(make_ints(2))
    rl3.append(make_ints(2))
    sg4 = grow_str(sl2, 1)
    sl2.append("bc")
    if len(sg4) > 3:
        for i1 in range(2):
            ra5 = rl3
            acc = acc + len(il1)
            sg4.append("a")
            sg4.append("a")
            if len(rl3) > 0:
                inner6 = rl3[0]
                inner6.append(5)
                acc = acc + len(inner6) + len(rl3[0])
            acc = acc + len(il1)
        ra7 = rl3
        sg8 = grow_str(sg4, seed)
    sg9 = grow_str(sl2, seed)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    if len(sg4) > 0:
        out.print(sg4[len(sg4) - 1])
    acc = acc + len(sg4)
    if len(sg9) > 0:
        out.print(sg9[len(sg9) - 1])
    acc = acc + len(sg9)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
