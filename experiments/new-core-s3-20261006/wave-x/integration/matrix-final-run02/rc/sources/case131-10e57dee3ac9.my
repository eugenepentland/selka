def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(3)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("a")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(3)
    sl2: list[str] = []
    sl2.append("xyz")
    rl3: list[list[int]] = []
    rl3.append(make_ints(seed))
    il1.append(seed)
    acc = acc + len(sl2)
    if len(il1) > 0:
        for i1 in range(2):
            rl3.append(make_ints(i1))
            rg4 = grow_row(rl3, 1)
            sl2.append("xyz")
            acc = acc + len(sl2)
            il1.append(0)
            ia5 = il1
        sl2.append("bc")
        ia6 = il1
        if len(rl3) > 0:
            inner7 = rl3[0]
            inner7.append(5)
            acc = acc + len(inner7) + len(rl3[0])
        return acc + len(il1)
    for i2 in range(0):
        for i1 in range(2):
            rg8 = grow_row(rl3, i1)
            rg9 = grow_row(rl3, seed)
            rg8.append(make_ints(i1))
        sl2.append("a")
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
