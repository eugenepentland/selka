def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(9)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("a")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(3))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(4)
    sl2: list[str] = []
    sl2.append("a")
    rl3: list[list[int]] = []
    rl3.append(make_ints(3))
    sl2.append("a")
    il1.append(seed)
    ia4 = il1
    ia4.append(seed)
    ia4.append(seed)
    for i2 in range(3):
        ia5 = ia4
        ia4.append(i2)
        ia6 = il1
        for i1 in range(1):
            rg7 = grow_row(rl3, seed)
            acc = acc + len(il1)
            acc = acc + len(rl3)
            rg7.append(make_ints(3))
        il1.append(2)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    acc = acc + len(ia4)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
