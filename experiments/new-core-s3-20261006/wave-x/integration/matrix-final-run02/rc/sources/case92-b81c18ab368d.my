def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(7)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("bc")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(n))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(seed)
    sl2: list[str] = []
    sl2.append("a")
    rl3: list[list[int]] = []
    rl3.append(make_ints(2))
    for i2 in range(0):
        sa4 = sl2
        for i1 in range(3):
            acc = acc + len(il1)
            sa5 = sa4
            acc = acc + len(il1)
            rl3.append(make_ints(3))
        for i1 in range(3):
            acc = acc + len(rl3)
            acc = acc + len(il1)
            acc = acc + len(sl2)
            ia6 = il1
        rl3.append(make_ints(i2))
    if len(sl2) > 1:
        sl2.append("xyz")
        sa7 = sl2
        if len(rl3) > 2:
            sa8 = sl2
            sl2.append("xyz")
            sa8.append("xyz")
            acc = acc + len(sl2)
        if len(sa7) > 0:
            sl2.append("xyz")
            acc = acc + len(sl2)
            sa9 = sl2
            acc = acc + len(sa9)
            acc = acc + len(sa7)
        acc = acc + len(sa7)
        sl2.append("bc")
    il1.append(seed)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
