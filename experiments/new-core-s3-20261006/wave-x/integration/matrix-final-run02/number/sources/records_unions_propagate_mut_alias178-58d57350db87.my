def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback

def main(args: list[str], out: Stream) -> int:
    seed = number(args[2], 7)
    texts = ["9223372036854775807", "9223372036854775808", "-9223372036854775808", "-9223372036854775809", "18446744073709551615", "18446744073709551616", "+", "-", "", "1__2", "_1", "1_", "é12", " \t-001_023\r\n", "000000000000000000000000000000000000000000001", "+_2", " \t59\r_\n", " \t+238\r_\n", " \t7315\r\n", " \t-47543\r\n", "82981_4", "1409705", "-23418698🙂", "716141397🙂", "-4927201338", "-28255594854", "-70915037894_9", "-6728935036136", "-72018926687074x", " \t-904701733610994\r_\n", "+9314944965618444", "-38111528093696300", " \t546818142915899754\r\n_", " \t-6961190046953929707\r_\n"]
    texts.append("+" + str(seed % 1234567) + "_1")
    acc = 0
    for text in texts:
        match int(text):
            case Some(value):
                acc = (acc + value % 1000003) % 1000003
                shown = str(value)
                if number(shown, 999) != value:
                    return 6
                out.print(shown)
            case None:
                acc = (acc + len(text) * 31) % 1000003
    float_texts = ["0", "-0.0", "+0", "nan", "-NaN", "+INFINITY", "-inf", "0.125", "2.675", "9.995", "1.7976931348623157e308", "1.7976931348623159e308", "2.2250738585072014e-308", "4.9406564584124654e-324", "2.4703282292062327e-324", "1e-999", "1e+999", "  -1_2.5e+1\t", "1e+", "_1.0", "1__2", "1.2_", "١.0", "1\u0000.0", "42.18e250", "-.9428921101e-75", "5005317371380.68e4", ".09190180411e-88", "-83.8326e75", "27136175.29551313290e-163", "-203.9e119", "-014102.062545961104e307", "0."]
    for text in float_texts:
        framed = ("prefix" + text + "suffix").encode()
        match float(text):
            case Some(value):
                out.print(str(value), f"{value:.0f}", f"{value:.2f}", f"{value:.4e}", f"{value:.17g}")
                match framed.parse_float_range(6, len(framed) - 6):
                    case Some(ranged):
                        if str(ranged) != str(value):
                            return 6
                    case None:
                        return 6
                buffer = byte_buffer([])
                if not buffer.append_float(value):
                    return 6
                if bytes(buffer) != str(value).encode():
                    return 6
            case None:
                if framed.parse_float_range(6, len(framed) - 6) != None:
                    return 6
                out.print("invalid", len(text))
    out.print(acc, str(18446744073709551615u64), f"{seed:#020x}", f"{seed:+020d}")
    return acc % 7
