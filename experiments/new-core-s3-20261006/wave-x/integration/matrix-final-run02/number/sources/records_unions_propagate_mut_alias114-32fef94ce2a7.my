def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback

def main(args: list[str], out: Stream) -> int:
    seed = number(args[2], 7)
    texts = ["9223372036854775807", "9223372036854775808", "-9223372036854775808", "-9223372036854775809", "18446744073709551615", "18446744073709551616", "+", "-", "", "1__2", "_1", "1_", "é12", " \t-001_023\r\n", "000000000000000000000000000000000000000000001", " \t1\r\n", "49_", "+148_", "+5710", " \t07880\r_\n", "60693_0_", "+9077866", "+97716743", " \t-213290891\r\n", " \t-7797670460\r_\n", "2281836488_0", " \t+390035230229\r_\n", "-2643501850618", "74331336902014", "+245542010171072", "-4788579397236356", "-69836077420973340", " \t-113738858837203179\r_\n", "9884023509090793452"]
    texts.append("-" + str(seed % 1234567) + "x")
    acc = 0
    for text in texts:
        match int(text):
            case Some(value):
                acc = (acc + value % 1000003) % 1000003
                shown = str(value)
                if number(shown, 999) != value:
                    return 6
                out.print(shown)
            case None:
                acc = (acc + len(text) * 31) % 1000003
    float_texts = ["0", "-0.0", "+0", "nan", "-NaN", "+INFINITY", "-inf", "0.125", "2.675", "9.995", "1.7976931348623157e308", "1.7976931348623159e308", "2.2250738585072014e-308", "4.9406564584124654e-324", "2.4703282292062327e-324", "1e-999", "1e+999", "  -1_2.5e+1\t", "1e+", "_1.0", "1__2", "1.2_", "١.0", "1\u0000.0", "-3932822071181333.634e-48", "-569434032.07358075e106", "+80748.9908007909576e-186", "+87.1e122", "-578362445132449566.62215e-246", "5.64982168e-245", "+6.9987565076e-36", "-4.3e117", "0."]
    for text in float_texts:
        framed = ("prefix" + text + "suffix").encode()
        match float(text):
            case Some(value):
                out.print(str(value), f"{value:.0f}", f"{value:.2f}", f"{value:.4e}", f"{value:.17g}")
                match framed.parse_float_range(6, len(framed) - 6):
                    case Some(ranged):
                        if str(ranged) != str(value):
                            return 6
                    case None:
                        return 6
                buffer = byte_buffer([])
                if not buffer.append_float(value):
                    return 6
                if bytes(buffer) != str(value).encode():
                    return 6
            case None:
                if framed.parse_float_range(6, len(framed) - 6) != None:
                    return 6
                out.print("invalid", len(text))
    out.print(acc, str(18446744073709551615u64), f"{seed:#020x}", f"{seed:+020d}")
    return acc % 7
