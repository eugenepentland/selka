def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def fold(values: list[int]) -> int:
    total = 0
    for value in values:
        total = (total * 31 + value) % 1000003
    return total


record Bucket:
    count: int
    items: list[int]


def bucket_total(b: Bucket) -> int:
    t = b.count
    for x in b.items:
        t = (t * 7 + x) % 1000003
    return t


def grow(b: Bucket, v: int) -> Bucket:
    items = b.items
    items.append(v)
    return Bucket(b.count + 1, items)


record Pair:
    a: int
    b: int


union Item:
    empty,
    num: int,
    pair: Pair,
    bag: Bucket


def weigh(item: Item) -> int:
    match item:
        case Item.num(v):
            return v
        case Item.pair(p):
            return p.a * 3 + p.b
        case Item.bag(g):
            return len(g.items) + g.count
        case _:
            return 1


def sum_items(items: list[Item]) -> int:
    t = 0
    for i in range(len(items)):
        t = (t * 5 + weigh(items[i])) % 1000003
    return t


def bump(xs: mut list[int], k: int):
    xs.append(k)
    xs[0] = (xs[0] + k) % 1009


def fill(xs: mut list[int], k: int):
    for j in range(k % 4):
        xs.append(j * 3 + k)


def swap_ends(xs: mut list[int]):
    last = len(xs) - 1
    first = xs[0]
    xs[0] = xs[last]
    xs[last] = first


def twice(xs: mut list[int], k: int):
    bump(mut xs, k)
    bump(mut xs, k + 1)


def touch(b: mut Bucket, v: int):
    b.items[0] = v
    b.count = b.count + 1
    b.items.append(v)


def touch_items(b: mut Bucket, v: int):
    bump(mut b.items, v)
    b.count = b.count + 2


def rebuild(b: mut Bucket, v: int):
    b = Bucket(v % 5, [v, v + 1])


def both(xs: list[int], ys: list[int]) -> int:
    return len(xs) * 100 + len(ys) + xs[0] + ys[0]


def step0(x: int) -> Result[int, str]:
    if x % 5 == 2:
        return Err("bad")
    return Ok((x * 4 + 7) % 1009)


def step1(x: int) -> Result[int, str]:
    if x % 7 == 1:
        return Err("bad")
    return Ok((x * 9 + 7) % 1009)


def step2(x: int) -> Result[int, str]:
    if x % 5 == 2:
        return Err("bad")
    return Ok((x * 8 + 1) % 1009)


def step3(x: int) -> Result[int, str]:
    if x % 11 == 2:
        return Err("bad")
    return Ok((x * 9 + 2) % 1009)


def chain0(x: int) -> Result[int, str]:
    v0 = step3(x)?
    v1 = step2(v0 + 1)?
    if v1 > 776:
        return Ok(v1)
    return Ok(v0 + v1)


def chain1(x: int) -> Result[int, str]:
    v0 = step1(x)?
    v1 = step1(v0 + 1)?
    if v1 > 898:
        return Ok(v1)
    v2 = step0(v1 + 1)?
    v3 = step1(v2 + 1)?
    if v3 > 572:
        return Ok(v3)
    return Ok(v0 + v1 + v2 + v3)


def sum_checked(xs: list[int]) -> Result[int, str]:
    t = 0
    for x in xs:
        t = (t + step3(x)?) % 1000003
    return Ok(t)


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 1 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    acc = 0
    xs = [(j * 28 + seed) % 1009 for j in range(n)]
    ys = [(j * 30 + 1) % 997 for j in range(n)]
    b = Bucket(n, xs)
    c = Bucket(1, [seed])
    items: list[Item] = []
    items.append(Item.num(seed))
    fill(mut xs, (((n + 38) // 3)) % 1009)
    snap_items = items
    items.append(Item.num((((3037000500 + (0 - 8)) * (9 // 43))) % 1009))
    acc = (acc + len(snap_items) * 7 + len(items)) % 1000003
    snap = b
    b.items.append((((acc * seed) - (acc % 2))) % 1009)
    acc = (acc + len(snap.items) * 5 + len(b.items)) % 1000003
    touch(mut b, (((acc + seed) // 42)) % 1009)
    swap_ends(mut xs)
    ys[((4611686018427387904) % 1009) % len(ys)] = (((n % n) % 17)) % 1009
    for r in range(rounds):
        acc = (acc + r) % 1000003
        b = c
        ys = xs
    items.append(Item.bag(Bucket((acc) % 1009, [(((n + seed) * n)) % 1009, (seed) % 1009])))
    xs.append((((seed - acc) % 7)) % 1009)
    snap = b
    b.items.append((((seed - acc) * (acc % 4611686018427387904))) % 1009)
    acc = (acc + len(snap.items) * 5 + len(b.items)) % 1000003
    out.print(acc, fold(xs), fold(ys), b.count, fold(b.items), c.count, fold(c.items), sum_items(items), len(items))
    return acc % 7

