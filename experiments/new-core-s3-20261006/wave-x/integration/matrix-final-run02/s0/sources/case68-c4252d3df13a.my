def probe(xs: list[int], key: int) -> int:
    low = 0
    high = len(xs) + 1
    while low < high:
        middle = (low + high) // 2
        if xs[middle] < key:
            low = middle + 1
        else:
            high = middle
    if low < len(xs) and xs[low] == key:
        return low + 1
    return 0


def helper0(a: int, b: int) -> int:
    if ((0 - 1) % (0 - 1)) == (b + 25):
        return (b * (a - a))
    return ((b * b) + (9223372036854775807 * a))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((seed + 7) % (0 - 8))) % 1000000007 for j in range(n)]
    second = [(j * 43 + 3) % 7 for j in range(n)]
    flags = [(seed % 16) > (seed + j) for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 18
        total = 0
        for j in range(n - 1):
            x = values[j]
            y = second[j]
            v = seed
            v = helper0(v, (seed * 4))
            if (j % 1000000007) <= (j % (0 - 2)):
                continue
            total += v
        acc = (acc + total) % 1000000007
    k = seed % 1000 + 2
    steps = 0
    while k != 1 and steps < 200:
        if k % 2 == 0:
            k = k // 2
        else:
            k = 3 * k + 1
        steps += 1
    acc = acc + steps
    acc = acc + probe(values, (seed % 1000000007))
    out.print(acc, len(values))
    return acc % 7

