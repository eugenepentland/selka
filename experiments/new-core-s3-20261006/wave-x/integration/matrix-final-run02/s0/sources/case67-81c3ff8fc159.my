def probe(xs: list[int], key: int) -> int:
    i = key % 56 - 2
    if i >= 0:
        if i < len(xs):
            return xs[i]
    return 0


def helper0(a: int, b: int) -> int:
    if (7 + b) >= (b + b):
        return ((47 + b) * b)
    return ((a % 3) // 1)


def helper1(a: int, b: int) -> int:
    if b >= 14:
        return ((48 // b) - 24)
    return 9223372036854775807


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [((seed - (j % 7))) % 1009 for j in range(n)]
    second = [(j * 15 + 3) % 7 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 7
        total = 0
        for j in range(n):
            x = values[j]
            y = second[j]
            v = (((x % 17) - (x % y)) * (x % (13 % (0 - 3))))
            if flags[j]:
                v = 1000003
            else:
                v = v + 4611686018427387904
            v = helper1(v, (seed % 2))
            if (20 % (0 - 7)) <= ((0 - 25) * x) and j < 17:
                continue
            if seed >= (x // y):
                break
            total += v
        acc = (acc + total) % 1000000007
    acc = acc + probe(values, (seed * 1009))
    out.print(acc, len(values))
    return acc % 7

