def probe(xs: list[int], key: int) -> int:
    total = 0
    i = key % 4
    while i <= len(xs):
        total += xs[i]
        i += 1
    return total


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [((7 + (40 * seed))) % 1009 for j in range(n)]
    second = [(j * 14 + 3) % 1009 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 19
        total = 0
        for j in range(n):
            x = values[j]
            y = second[j]
            v = x
            if flags[j]:
                v = ((x * phase) % 16)
            else:
                v = v + 7
            total += v
        acc = (acc + total) % 1000000007
    acc = acc + probe(second, (acc + n))
    out.print(acc, len(values))
    return acc % 7

