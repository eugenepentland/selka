def helper0(a: int, b: int) -> int:
    if (b - 41) <= (a % 1009):
        return ((b // 7) * a)
    return 1


def helper1(a: int, b: int) -> int:
    return 17


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [((j % 2) + 17) for j in range(n)]
    second = [(j * 18 + 3) % 7 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 10
        total = 0
        for j in range(n - 1):
            x = values[j]
            y = second[j]
            v = ((seed - (y - y)) // 1000000007)
            total += v
        acc = acc + total
    out.print(acc, len(values))
    return acc % 7

