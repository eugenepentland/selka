def probe(xs: list[int], key: int) -> int:
    low = 0
    high = len(xs)
    while low <= high:
        middle = (low + high) // 2
        if xs[middle] < key:
            low = middle + 1
        else:
            high = middle - 1
    if low < len(xs) and xs[low] == key:
        return low + 1
    return 0


def helper0(a: int, b: int) -> int:
    if (b * a) < b:
        return ((0 * 48) % 1000000007)
    return ((a % a) - (a % 1))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [((6 % 17)) % 7 for j in range(n)]
    second = [(j * 4 + 3) % 7 for j in range(n)]
    flags = [(seed - seed) > (seed * 101) for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 4
        total = 0
        for j in range(n):
            x = values[n - 1 - j]
            y = second[j]
            v = (((x * 15) // 1009) * ((phase // 7) % 1000000007))
            if flags[j]:
                v = ((9223372036854775807 % 2) * (phase + v))
            else:
                v = v + 35
            v = helper0(v, (y % 1000000007))
            if (y % j) <= (x * j):
                continue
            total += v
        acc = (acc + total) % 1000000007
    acc = acc + probe(values, (n % 21))
    out.print(acc, len(values))
    return acc % 7

