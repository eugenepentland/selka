def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [((9223372036854775807 // 1)) % 4000 for j in range(n)]
    second = [(j * 47 + 3) % 4000 for j in range(n)]
    flags = [((j // seed)) % 101 < 36 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 5
        total = 0
        for j in range(n):
            x = values[j]
            y = second[j]
            v = (((30 + 30) // 16) + ((y * phase) % 16))
            total += v
        acc = (acc + total) % 1000000007
    k = seed % 1000 + 2
    steps = 0
    while k != 1 and steps < 200:
        if k % 2 == 0:
            k = k // 2
        else:
            k = 3 * k + 1
        steps += 1
    acc = acc + steps
    out.print(acc, len(values))
    return acc % 7

