def probe(xs: list[int], key: int) -> int:
    low = 0
    high = len(xs)
    while low < high:
        middle = (low + high) // 2
        if xs[middle] < key:
            low = middle + 1
        else:
            high = middle
    if low < len(xs) and xs[low] == key:
        return low + 1
    return 0


def helper0(a: int, b: int) -> int:
    if (b + 40) >= (b % 16):
        return ((1009 + 25) + (a + b))
    return ((a + 13) + (a + 3037000500))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((48 // 65536) % 16)) % 1000000007 for j in range(n)]
    second = [(j * 49 + 3) % 7 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 17
        total = 0
        for j in range(n):
            x = values[0 - 1 - j]
            y = second[j]
            v = ((x // 1009) % 3)
            if flags[j]:
                v = ((phase * phase) - (13 % 2))
            else:
                v = v + 13
            v = helper0(v, (y % (0 - 9)))
            total += v
        acc = acc + total
    acc = acc + probe(second, (43 + acc))
    out.print(acc, len(values))
    return acc % 7

