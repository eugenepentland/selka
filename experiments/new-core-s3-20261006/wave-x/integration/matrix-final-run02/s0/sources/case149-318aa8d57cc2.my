def probe(xs: list[int], key: int) -> int:
    total = 0
    i = key % 4
    while i <= len(xs):
        total += xs[i]
        i += 1
    return total


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [((seed % 1000000007) + (j // 17)) for j in range(n)]
    second = [(j * 42 + 3) % 7 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 2
        total = 0
        for j in range(len(values)):
            x = values[j + 1]
            y = second[j]
            v = 43
            if x < 65536 and phase > 42:
                continue
            total += v
        acc = (acc + total) % 1000000007
    k = seed % 1000 + 2
    steps = 0
    while k != 1 and steps < 200:
        if k % 2 == 0:
            k = k // 2
        else:
            k = 3 * k + 1
        steps += 1
    acc = acc + steps
    acc = acc + probe(second, acc)
    out.print(acc, len(values))
    return acc % 7

