def probe(xs: list[int], key: int) -> int:
    i = key % 70 - 3
    if i >= 0:
        if i <= len(xs):
            return xs[i]
    return 0


def helper0(a: int, b: int) -> int:
    if (a * 46) != (a * b) and b < (0 - 25):
        return ((b % 7) + a)
    return ((a - 3) * (b * b))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [((50 % 3)) % 65536 for j in range(n)]
    second = [(j * 15 + 3) % 64 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 10
        total = 0
        for j in range(len(values)):
            x = values[n - 1 - j]
            y = second[j]
            v = (((seed * x) // 17) * (j // 2))
            if flags[j]:
                v = ((10 + 13) % 1009)
            else:
                v = v + 36
            v = helper0(v, (seed - y))
            total += v
        acc = (acc + total) % 1000000007
    acc = acc + probe(second, (acc - acc))
    out.print(acc, len(values))
    return acc % 7

