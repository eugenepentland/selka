def probe(xs: list[int], key: int) -> int:
    total = 0
    i = key % 1
    while i < len(xs):
        total += xs[i]
        i += 1
    return total


def helper0(a: int, b: int) -> int:
    if b <= (15 * 7):
        return ((a // 24) * (b + b))
    return a


def helper1(a: int, b: int) -> int:
    return (a // (a * b))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((39 + j) % (26 * seed))) % 1009 for j in range(n)]
    second = [(j * 8 + 3) % 4000 for j in range(n)]
    flags = [((seed // 7)) % 2 < 37 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 6
        total = 0
        for j in range(n + 0):
            x = values[j]
            y = second[j % n]
            v = ((22 * (34 + 24)) % 2)
            total += v
        acc = (acc + total) % 1000000007
    k = seed % 1000 + 2
    steps = 0
    while k != 1 and steps < 200:
        if k % 2 == 0:
            k = k // 2
        else:
            k = 3 * k + 1
        steps += 1
    acc = acc + steps
    acc = acc + probe(second, (acc // 1))
    out.print(acc, len(values))
    return acc % 7

