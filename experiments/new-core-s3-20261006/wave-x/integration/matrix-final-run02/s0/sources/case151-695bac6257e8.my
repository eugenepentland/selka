def helper0(a: int, b: int) -> int:
    if (a // 1000000007) > (b - 5):
        return ((6 % a) - 4611686018427387904)
    return ((a + a) * a)


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((seed * seed) * 43)) % 1000000007 for j in range(n)]
    second = [(j * 34 + 3) % 4000 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 20
        total = 0
        for j in range(len(values)):
            x = values[0 - 1 - j]
            y = second[j]
            v = y
            if flags[j]:
                v = ((seed + v) - 5)
            else:
                v = v + 11
            v = helper0(v, (12 + phase))
            if (44 - 101) <= (seed * seed):
                break
            total += v
        acc = acc + total
    out.print(acc, len(values))
    return acc % 7

