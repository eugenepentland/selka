def probe(xs: list[int], key: int) -> int:
    low = 0
    high = len(xs)
    while low <= high:
        middle = (low + high) // 2
        if xs[middle] < key:
            low = middle + 1
        else:
            high = middle - 1
    if low < len(xs) and xs[low] == key:
        return low + 1
    return 0


def helper0(a: int, b: int) -> int:
    return b


def helper1(a: int, b: int) -> int:
    if ((0 - 12) // 1) == a:
        return ((3037000500 // b) % 2)
    return ((b - (0 - 34)) - (b // 17))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((25 + j) + (seed // 1009))) % 65536 for j in range(n)]
    second = [(j * 23 + 3) % 1009 for j in range(n)]
    flags = [(seed - (0 - 27)) < (seed % 2) for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 13
        total = 0
        for j in range(n):
            x = values[0 - 1 - j]
            y = second[j]
            v = 101
            v = helper0(v, (phase % 2))
            if ((0 - 13) + x) > (seed % y) and y > 10:
                break
            total += v
        acc = (acc + total) % 1000000007
    k = seed % 1000 + 2
    steps = 0
    while k != 1 and steps < 200:
        if k % 2 == 0:
            k = k // 2
        else:
            k = 3 * k + 1
        steps += 1
    acc = acc + steps
    acc = acc + probe(values, (seed - seed))
    out.print(acc, len(values))
    return acc % 7

