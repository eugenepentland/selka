def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [((13 + (seed // 1000000007))) % 7 for j in range(n)]
    second = [(j * 47 + 3) % 64 for j in range(n)]
    flags = [(32) % 3 < 49 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 14
        total = 0
        for j in range(n + 0):
            x = values[j]
            y = second[j % n]
            v = ((8 * (phase % 101)) * ((y + 1) % 101))
            if flags[j % n]:
                v = (8 % 3)
            else:
                v = v + 28
            total += v
        acc = acc + total
    out.print(acc, len(values))
    return acc % 7

