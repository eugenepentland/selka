def probe(xs: list[int], key: int) -> int:
    i = key % 21 - 3
    if i >= 0:
        if i < len(xs):
            return xs[i]
    return 0


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((j * seed) + (j * j))) % 17 for j in range(n)]
    second = [(j * 17 + 3) % 4000 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 16
        total = 0
        for j in range(n):
            x = values[j + 1]
            y = second[j]
            v = (((x % 17) * (phase * x)) + (y % 16))
            if (32 * 65536) == 11:
                break
            total += v
        acc = (acc + total) % 1000000007
    acc = acc + probe(second, ((0 - 30) // (0 - 3)))
    out.print(acc, len(values))
    return acc % 7

