def helper0(a: int, b: int) -> int:
    return ((44 % 1009) // 27)


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [((seed * seed) // 1009) for j in range(n)]
    second = [(j * 16 + 3) % 7 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 17
        total = 0
        for j in range(n):
            x = values[j]
            y = second[j]
            v = seed
            v = helper0(v, (j + x))
            if (x + j) > (y * j) and phase > 20:
                break
            total += v
        acc = acc + total
    out.print(acc, len(values))
    return acc % 7

