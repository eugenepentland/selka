def helper0(a: int, b: int) -> int:
    if (b + a) != (a * b):
        return ((31 * a) % 1009)
    return ((b % a) * (a + a))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((seed + j) * (seed + 41))) % 7 for j in range(n)]
    second = [(j * 21 + 3) % 4000 for j in range(n)]
    flags = [((j + j)) % 101 < 42 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 6
        total = 0
        for j in range(n):
            x = values[j]
            y = second[j]
            v = (((x + phase) % 3) % 16)
            if flags[j]:
                v = ((phase + v) + (v + x))
            else:
                v = v + 27
            total += v
        acc = (acc + total) % 1000000007
    out.print(acc, len(values))
    return acc % 7

