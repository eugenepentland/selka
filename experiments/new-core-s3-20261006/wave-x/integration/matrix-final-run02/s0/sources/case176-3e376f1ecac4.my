def helper0(a: int, b: int) -> int:
    return (a // ((0 - 16) - 17))


def helper1(a: int, b: int) -> int:
    return a


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [((j % 1009) * (seed % seed)) for j in range(n)]
    second = [(j * 48 + 3) % 4000 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 5
        total = 0
        for j in range(n):
            x = values[n - 1 - j]
            y = second[j]
            v = (((j + (0 - 38)) % 1) * (y * (j * seed)))
            if flags[j]:
                v = (y + (v // 7))
            else:
                v = v + 42
            v = helper1(v, (17 // 7))
            if (phase % seed) < y:
                continue
            total += v
        acc = (acc + total) % 1000000007
    out.print(acc, len(values))
    return acc % 7

