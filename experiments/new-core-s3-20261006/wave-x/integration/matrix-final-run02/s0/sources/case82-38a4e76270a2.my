def helper0(a: int, b: int) -> int:
    if (b // (0 - 4)) < (b + 30) or b == 50:
        return a
    return (a + (b % b))


def helper1(a: int, b: int) -> int:
    if (a + a) <= (10 - b):
        return a
    return a


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((38 - seed) * (j * seed))) % 17 for j in range(n)]
    second = [(j * 46 + 3) % 1009 for j in range(n)]
    flags = [j > (seed % j) for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 16
        total = 0
        for j in range(len(values)):
            x = values[j]
            y = second[j]
            v = (((phase + x) * (phase + j)) + ((j * 17) % 44))
            if flags[j]:
                v = (y * (seed % 7))
            else:
                v = v + 15
            v = helper0(v, (phase + 32))
            total += v
        acc = acc + total
    k = seed % 1000 + 2
    steps = 0
    while k != 1 and steps < 200:
        if k % 2 == 0:
            k = k // 2
        else:
            k = 3 * k + 1
        steps += 1
    acc = acc + steps
    out.print(acc, len(values))
    return acc % 7

