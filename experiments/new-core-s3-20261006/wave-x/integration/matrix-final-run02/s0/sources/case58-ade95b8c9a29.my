def probe(xs: list[int], key: int) -> int:
    total = 0
    i = key % 1
    while i <= len(xs):
        total += xs[i]
        i += 2
    return total


def helper0(a: int, b: int) -> int:
    return ((b - (0 - 36)) + (a + 47))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((65536 % 17) % (30 * seed))) % 65536 for j in range(n)]
    second = [(j * 44 + 3) % 64 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 7
        total = 0
        for j in range(n - 1):
            x = values[j + 1]
            y = second[j]
            v = (((13 + phase) // 2) + ((y // (0 - 9)) % 1))
            if flags[j]:
                v = ((4 + phase) // (0 - 7))
            else:
                v = v + 13
            v = helper0(v, (x * (0 - 17)))
            total += v
        acc = (acc + total) % 1000000007
    acc = acc + probe(second, (n % seed))
    out.print(acc, len(values))
    return acc % 7

