def helper0(a: int, b: int) -> int:
    return ((1000003 + 14) % (b * b))


def helper1(a: int, b: int) -> int:
    if (31 + a) > (a + 21) or a < 2:
        return ((a - a) + 12)
    return ((a + b) - (3037000500 - b))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [13 for j in range(n)]
    second = [(j * 39 + 3) % 7 for j in range(n)]
    flags = [(j // 1000000007) == (j // 2) for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 14
        total = 0
        for j in range(n + 1):
            x = values[j]
            y = second[j % n]
            v = ((phase - (j % 16)) * x)
            if flags[j % n]:
                v = ((phase * x) // (0 - 7))
            else:
                v = v + 13
            total += v
        acc = (acc + total) % 1000000007
    out.print(acc, len(values))
    return acc % 7

