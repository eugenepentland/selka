def helper0(a: int, b: int) -> int:
    return (45 + (b + a))


def helper1(a: int, b: int) -> int:
    return ((b % 1) + (12 % 1000000007))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [((j % seed) // 1) for j in range(n)]
    second = [(j * 47 + 3) % 1009 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 20
        total = 0
        for j in range(n):
            x = values[n - 1 - j]
            y = second[j]
            v = (((0 - 11) % 10) * ((x * 9) + (7 % 1009)))
            if flags[j]:
                v = ((4611686018427387904 * v) - (x - y))
            else:
                v = v + 11
            v = helper0(v, j)
            if (y * seed) > seed:
                continue
            total += v
        acc = acc + total
    out.print(acc, len(values))
    return acc % 7

