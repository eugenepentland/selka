def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((0 - 36) // 2)) % 1009 for j in range(n)]
    second = [(j * 48 + 3) % 7 for j in range(n)]
    flags = [((j + seed)) % 2 < 24 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 3
        total = 0
        for j in range(n):
            x = values[j]
            y = second[j]
            v = y
            if flags[j]:
                v = ((x + v) % 7)
            else:
                v = v + 25
            total += v
        acc = (acc + total) % 1000000007
    out.print(acc, len(values))
    return acc % 7

