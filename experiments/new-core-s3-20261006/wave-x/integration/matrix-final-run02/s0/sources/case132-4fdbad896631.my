def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((j + 19) + (seed * seed))) % 7 for j in range(n)]
    second = [(j * 21 + 3) % 7 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 15
        total = 0
        for j in range(n - 1):
            x = values[j]
            y = second[j]
            v = (((phase * 5) + (phase // 1009)) % 7)
            if flags[j]:
                v = (phase + (phase * phase))
            else:
                v = v + 13
            total += v
        acc = (acc + total) % 1000000007
    out.print(acc, len(values))
    return acc % 7

