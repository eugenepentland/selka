def probe(xs: list[int], key: int) -> int:
    low = 0
    high = len(xs) + 1
    while low < high:
        middle = (low + high) // 2
        if xs[middle] < key:
            low = middle + 1
        else:
            high = middle
    if low < len(xs) and xs[low] == key:
        return low + 1
    return 0


def helper0(a: int, b: int) -> int:
    if (a + b) == (a + b):
        return ((1009 % 17) + (b % 7))
    return ((18 % (0 - 1)) - (b - 17))


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [((seed // 17)) % 65536 for j in range(n)]
    second = [(j * 19 + 3) % 1009 for j in range(n)]
    flags = [j % 3 != 0 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 2
        total = 0
        for j in range(n + 2):
            x = values[0 - 1 - j]
            y = second[j % n]
            v = (seed // 17)
            if flags[j % n]:
                v = ((y - seed) * (j * 4611686018427387904))
            else:
                v = v + 28
            v = helper0(v, (j + x))
            if y != (seed + seed) and x > 4611686018427387904:
                continue
            if (seed % 17) == (4611686018427387904 * j) and seed == 2:
                break
            total += v
        acc = acc + total
    k = seed % 1000 + 2
    steps = 0
    while k != 1 and steps < 200:
        if k % 2 == 0:
            k = k // 2
        else:
            k = 3 * k + 1
        steps += 1
    acc = acc + steps
    acc = acc + probe(second, (n // 3))
    out.print(acc, len(values))
    return acc % 7

