def helper0(a: int, b: int) -> int:
    return ((17 + b) + a)


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(((seed % seed) * (seed * 40))) % 7 for j in range(n)]
    second = [(j * 29 + 3) % 7 for j in range(n)]
    flags = [1009 <= (seed % 1009) or seed == 10 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 3
        total = 0
        for j in range(n + 0):
            x = values[j]
            y = second[j % n]
            v = (((j % 33) * (j - phase)) % ((5 * seed) + (y % 14)))
            if (phase * 30) < (23 - 49):
                break
            total += v
        acc = (acc + total) % 1000000007
    out.print(acc, len(values))
    return acc % 7

