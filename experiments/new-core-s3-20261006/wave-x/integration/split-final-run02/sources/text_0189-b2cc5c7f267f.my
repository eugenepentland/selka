module text_0189

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "😀  😀  collision005a0e\x0cnaïve\tcollision005a0e Ω\tlong02éabcdefghijklmnop\x0clong07éabcdefghijklmnop\x0blong07éabcdefghijklmnop\x0ccollision002553\x0cnaïve  long02éabcdefghijklmnop\rlong01éabcdefghijklmnop  long02éabcdefghijklmnop  b\t😀\nb  long02éabcdefghijklmnop\tlong00éabcdefghijklmnop\x0cΩ\x0clong02éabcdefghijklmnop  collision005a0e\ncollision005a0e long05éabcdefghijklmnop\nlong07éabcdefghijklmnop\x0clong06éabcdefghijklmnop\tlong04éabcdefghijklmnop\tnaïve  collision005a0e\nlong05éabcdefghijklmnop\tlong07éabcdefghijklmnop\x0blong01éabcdefghijklmnop\x0ca café\tx y\x0cΩ\rx y\tnaïve  é"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
