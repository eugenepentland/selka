module text_0032

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long03éabcdefghijklmnop  Ω long08éabcdefghijklmnop\rlong11éabcdefghijklmnop  long00éabcdefghijklmnop\x0blong10éabcdefghijklmnop\tcollision002553\rcollision005a0e\rlong00éabcdefghijklmnop\rcollision005a0e\nlong08éabcdefghijklmnop\nlong09éabcdefghijklmnop\n😀\rcafé\rlong06éabcdefghijklmnop\x0ccafé long11éabcdefghijklmnop\tlong04éabcdefghijklmnop\nlong09éabcdefghijklmnop\n😀\x0c😀\nlong04éabcdefghijklmnop  long08éabcdefghijklmnop\rlong02éabcdefghijklmnop  a\x0ba\n😀\tlong09éabcdefghijklmnop  long10éabcdefghijklmnop\x0clong06éabcdefghijklmnop long08éabcdefghijklmnop\tlong08éabcdefghijklmnop\tlong00éabcdefghijklmnop\x0blong10éabcdefghijklmnop\ta long11éabcdefghijklmnop  long02éabcdefghijklmnop\x0b😀 long11éabcdefghijklmnop\x0bcollision002553\ncafé\nlong10éabcdefghijklmnop\tlong10éabcdefghijklmnop\x0c"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
