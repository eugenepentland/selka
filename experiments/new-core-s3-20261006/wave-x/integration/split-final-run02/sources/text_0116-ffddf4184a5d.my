module text_0116

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long02éabcdefghijklmnop\tlong07éabcdefghijklmnop\rlong03éabcdefghijklmnop\x0clong09éabcdefghijklmnop\nlong08éabcdefghijklmnop\rlong12éabcdefghijklmnop\tlong06éabcdefghijklmnop\rlong08éabcdefghijklmnop\rcollision005a0e\x0clong12éabcdefghijklmnop\x0bnaïve\rnaïve  x y  a\tlong12éabcdefghijklmnop long03éabcdefghijklmnop\x0clong07éabcdefghijklmnop  long02éabcdefghijklmnop\rlong01éabcdefghijklmnop\rlong02éabcdefghijklmnop\nlong08éabcdefghijklmnop\x0clong06éabcdefghijklmnop collision005a0e\tb\tx y\nΩ  long12éabcdefghijklmnop naïve café  collision005a0e\x0blong12éabcdefghijklmnop\x0cb  long01éabcdefghijklmnop\tlong05éabcdefghijklmnop\x0clong01éabcdefghijklmnop\nlong04éabcdefghijklmnop\rlong02éabcdefghijklmnop  long05éabcdefghijklmnop\nlong09éabcdefghijklmnop\rcollision002553\rb  long12éabcdefghijklmnop\r😀\rlong08éabcdefghijklmnop\x0blong07éabcdefghijklmnop  long10éabcdefghijklmnop\nlong00éabcdefghijklmnop\x0bcollision005a0e\rtail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
