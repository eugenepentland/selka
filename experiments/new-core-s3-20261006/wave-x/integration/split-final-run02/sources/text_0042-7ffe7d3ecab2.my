module text_0042

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "😀\nnaïve\x0clong02éabcdefghijklmnop\tx y\x0bb\n😀\rlong02éabcdefghijklmnop long00éabcdefghijklmnop 😀  long00éabcdefghijklmnop  naïve\tcafé\x0blong02éabcdefghijklmnop\x0bcollision002553  long01éabcdefghijklmnop x y\x0bΩ  long01éabcdefghijklmnop\x0bcollision005a0e b  naïve  x y\tcollision002553\n😀\x0bcollision002553 😀\x0cb\nx y\nb  long00éabcdefghijklmnop\nΩ\x0bcollision002553  long02éabcdefghijklmnop\ncollision005a0e\rlong02éabcdefghijklmnop\x0bx y  naïve\x0bnaïve long02éabcdefghijklmnop  x y  collision005a0e\na\tcollision002553\rcollision005a0e\nΩ Ω b\rcollision002553\rlong01éabcdefghijklmnop long00éabcdefghijklmnop\tb  Ω\x0blong02éabcdefghijklmnop\t "
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
