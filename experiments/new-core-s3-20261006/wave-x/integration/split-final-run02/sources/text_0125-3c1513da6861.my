module text_0125

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "x y a long07éabcdefghijklmnop\x0bcafé\x0cb\nlong07éabcdefghijklmnop\tcafé\x0bb  long02éabcdefghijklmnop\x0ccollision005a0e long04éabcdefghijklmnop\rlong08éabcdefghijklmnop\x0cnaïve\ra\nlong06éabcdefghijklmnop  long07éabcdefghijklmnop\rnaïve\rlong06éabcdefghijklmnop\rlong06éabcdefghijklmnop\x0blong01éabcdefghijklmnop long02éabcdefghijklmnop collision002553\rnaïve\rcollision005a0e\nnaïve\tcollision005a0e\x0c😀 long08éabcdefghijklmnop  long03éabcdefghijklmnop\x0blong04éabcdefghijklmnop\nlong02éabcdefghijklmnop\nnaïve\x0bx y  long07éabcdefghijklmnop\tx y\rlong02éabcdefghijklmnop\x0ca\tlong03éabcdefghijklmnop  long09éabcdefghijklmnop\x0blong06éabcdefghijklmnop\rb  long07éabcdefghijklmnop\x0blong02éabcdefghijklmnop\x0bΩ\x0cb\x0ccollision005a0e\rlong05éabcdefghijklmnop\x0bcollision002553\tnaïve\rcollision002553\n"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
