module text_0175

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "Ω collision002553\tlong09éabcdefghijklmnop\x0blong08éabcdefghijklmnop  a\x0blong05éabcdefghijklmnop\tlong02éabcdefghijklmnop\tlong09éabcdefghijklmnop\x0blong00éabcdefghijklmnop 😀\nlong05éabcdefghijklmnop\tlong06éabcdefghijklmnop\tlong10éabcdefghijklmnop\x0bcollision005a0e\nb\ra\nlong09éabcdefghijklmnop  collision002553\x0clong00éabcdefghijklmnop\x0blong10éabcdefghijklmnop b\nlong02éabcdefghijklmnop  collision005a0e\nlong05éabcdefghijklmnop\rlong00éabcdefghijklmnop\x0blong08éabcdefghijklmnop collision005a0e\x0clong05éabcdefghijklmnop\nlong00éabcdefghijklmnop long03éabcdefghijklmnop\tcafé\nlong05éabcdefghijklmnop\x0clong01éabcdefghijklmnop 😀\r😀\tcollision005a0e\x0clong05éabcdefghijklmnop\x0c😀\rlong03éabcdefghijklmnop\tΩ long03éabcdefghijklmnop\tlong02éabcdefghijklmnop\ta  collision005a0e  long03éabcdefghijklmnop  Ω\nlong08éabcdefghijklmnop\ncollision005a0e\rlong01éabcdefghijklmnop  long03éabcdefghijklmnop\ttail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
