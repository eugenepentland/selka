module text_0097

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long05éabcdefghijklmnop\x0clong08éabcdefghijklmnop collision005a0e\x0ca\rlong07éabcdefghijklmnop\tx y\r😀  x y\x0blong03éabcdefghijklmnop 😀\x0blong01éabcdefghijklmnop collision002553\nlong04éabcdefghijklmnop\x0ba\nlong06éabcdefghijklmnop long02éabcdefghijklmnop  naïve  naïve\rlong07éabcdefghijklmnop\tlong00éabcdefghijklmnop\x0blong05éabcdefghijklmnop long02éabcdefghijklmnop\x0clong01éabcdefghijklmnop 😀\x0ba\x0blong01éabcdefghijklmnop\x0bcollision005a0e collision002553\x0cx y\x0blong08éabcdefghijklmnop\rlong04éabcdefghijklmnop\nx y\ta\nlong04éabcdefghijklmnop\tlong06éabcdefghijklmnop\rΩ\nb  long01éabcdefghijklmnop\na\ta naïve long08éabcdefghijklmnop\x0clong04éabcdefghijklmnop\tlong07éabcdefghijklmnop\nlong00éabcdefghijklmnop\x0bcafé\tcollision002553 collision002553\nlong03éabcdefghijklmnop\tlong00éabcdefghijklmnop long08éabcdefghijklmnop\nnaïve\ra  "
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
