module text_0172

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "naïve  long04éabcdefghijklmnop\rx y\x0b😀  long05éabcdefghijklmnop\rcollision002553\tb\x0clong04éabcdefghijklmnop x y  collision002553\rlong05éabcdefghijklmnop\x0ccafé long03éabcdefghijklmnop\tb  a\x0blong05éabcdefghijklmnop long04éabcdefghijklmnop\t😀\rlong00éabcdefghijklmnop\x0ccafé long01éabcdefghijklmnop\tcafé  x y\nlong01éabcdefghijklmnop\x0blong04éabcdefghijklmnop\x0blong04éabcdefghijklmnop\x0cΩ  Ω\nlong05éabcdefghijklmnop\rlong03éabcdefghijklmnop\tcafé\x0bnaïve\nlong05éabcdefghijklmnop x y\x0clong02éabcdefghijklmnop\x0clong04éabcdefghijklmnop\x0b😀\x0bnaïve\tlong03éabcdefghijklmnop  Ω  a  café\x0cé"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
