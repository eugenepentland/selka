module text_0111

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long04éabcdefghijklmnop\ta\x0ccollision005a0e  long06éabcdefghijklmnop\rlong03éabcdefghijklmnop\x0c😀\nb\rcollision002553\x0bΩ\x0clong04éabcdefghijklmnop\rlong04éabcdefghijklmnop\x0blong03éabcdefghijklmnop\x0cnaïve  long09éabcdefghijklmnop  café\ncollision005a0e\rcafé\rlong01éabcdefghijklmnop\x0clong05éabcdefghijklmnop 😀\nb\x0bcafé  b\tcollision002553\rlong08éabcdefghijklmnop  collision005a0e\na\ra\x0blong01éabcdefghijklmnop "
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
