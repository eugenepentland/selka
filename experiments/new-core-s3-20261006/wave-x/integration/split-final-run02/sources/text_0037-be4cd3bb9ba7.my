module text_0037

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long02éabcdefghijklmnop\x0clong03éabcdefghijklmnop long12éabcdefghijklmnop\nx y  long09éabcdefghijklmnop long08éabcdefghijklmnop long12éabcdefghijklmnop  long11éabcdefghijklmnop\rΩ\tlong05éabcdefghijklmnop\x0b😀\tx y\rlong03éabcdefghijklmnop\tlong11éabcdefghijklmnop\x0c😀 long11éabcdefghijklmnop\ta\x0b😀  long01éabcdefghijklmnop\x0blong02éabcdefghijklmnop\rcafé\x0bb\rΩ\tlong02éabcdefghijklmnop  long11éabcdefghijklmnop\tnaïve\x0bb  naïve\nlong09éabcdefghijklmnop  collision002553  long02éabcdefghijklmnop  long04éabcdefghijklmnop\x0blong03éabcdefghijklmnop\ncafé\nlong07éabcdefghijklmnop long11éabcdefghijklmnop\rlong12éabcdefghijklmnop\rnaïve\tlong10éabcdefghijklmnop\x0blong08éabcdefghijklmnop  collision002553\x0clong01éabcdefghijklmnop\tlong10éabcdefghijklmnop long00éabcdefghijklmnop  naïve\ta\tΩ é"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
