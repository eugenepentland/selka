module text_0188

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long02éabcdefghijklmnop\rnaïve  b\x0b😀\x0b😀\ncollision002553\tb\rb\x0bcafé\x0bx y  x y\nlong00éabcdefghijklmnop\x0clong02éabcdefghijklmnop\rcafé  Ω  long00éabcdefghijklmnop\x0bΩ\x0bnaïve\ncafé\tlong00éabcdefghijklmnop\x0cΩ  long00éabcdefghijklmnop a\nx y\x0cΩ\x0bx y\x0c😀  😀\tx y  long00éabcdefghijklmnop long02éabcdefghijklmnop collision002553\rlong00éabcdefghijklmnop\n😀\x0blong02éabcdefghijklmnop long02éabcdefghijklmnop\x0bΩ\ra  Ω\t😀 collision005a0e\x0ba\tlong00éabcdefghijklmnop long01éabcdefghijklmnop\x0cx y\x0ba   "
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
