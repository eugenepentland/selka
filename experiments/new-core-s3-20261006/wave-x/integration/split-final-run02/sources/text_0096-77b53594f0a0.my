module text_0096

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long05éabcdefghijklmnop  collision002553  long00éabcdefghijklmnop\x0bx y\ncafé\x0blong06éabcdefghijklmnop long02éabcdefghijklmnop\tlong01éabcdefghijklmnop\x0cb\ncollision002553\x0blong01éabcdefghijklmnop\x0ca\tx y  long04éabcdefghijklmnop\x0bcollision002553 collision002553\tlong06éabcdefghijklmnop\tb\x0c😀\x0bb long02éabcdefghijklmnop  long00éabcdefghijklmnop\x0ccafé\nlong04éabcdefghijklmnop long04éabcdefghijklmnop\x0ccollision002553\nx y b\rcollision005a0e\rb\x0cx y  naïve   "
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
