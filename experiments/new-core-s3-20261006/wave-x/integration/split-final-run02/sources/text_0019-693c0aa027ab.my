module text_0019

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "😀\x0bnaïve\tlong03éabcdefghijklmnop\rnaïve\tΩ\tlong01éabcdefghijklmnop\x0ccollision005a0e\tlong03éabcdefghijklmnop\t😀\rx y\x0c😀\rnaïve  collision002553\x0ccafé  long03éabcdefghijklmnop\ra\x0blong00éabcdefghijklmnop\tlong02éabcdefghijklmnop\rlong02éabcdefghijklmnop\nlong01éabcdefghijklmnop\rnaïve\tlong00éabcdefghijklmnop\x0ca\tcollision002553\nlong00éabcdefghijklmnop collision002553\x0bΩ long00éabcdefghijklmnop collision005a0e\rcollision002553\tlong02éabcdefghijklmnop\x0b😀\tlong05éabcdefghijklmnop  long04éabcdefghijklmnop\x0blong02éabcdefghijklmnop\tcollision005a0e\ncollision005a0e\tb\nlong01éabcdefghijklmnop\x0cnaïve\x0blong00éabcdefghijklmnop  café\tlong04éabcdefghijklmnop\x0bcafé\tcollision002553\x0bcollision005a0e\x0bnaïve\x0bcollision002553\ncafé\x0clong02éabcdefghijklmnop\nlong01éabcdefghijklmnop\x0blong01éabcdefghijklmnop\x0bcollision005a0e\r"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
