module text_0081

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "naïve  long02éabcdefghijklmnop long01éabcdefghijklmnop\x0cΩ\x0blong00éabcdefghijklmnop\nnaïve\x0blong01éabcdefghijklmnop\x0ccafé\x0blong03éabcdefghijklmnop\tnaïve\x0clong04éabcdefghijklmnop\rΩ\rlong03éabcdefghijklmnop collision005a0e\x0bcollision005a0e\x0clong01éabcdefghijklmnop\nlong04éabcdefghijklmnop\tlong04éabcdefghijklmnop\x0ccafé long01éabcdefghijklmnop\x0blong03éabcdefghijklmnop\nΩ collision005a0e  collision005a0e long00éabcdefghijklmnop\x0blong01éabcdefghijklmnop  café\x0ccollision005a0e long04éabcdefghijklmnop\nnaïve long03éabcdefghijklmnop\x0blong03éabcdefghijklmnop x y  long01éabcdefghijklmnop tail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
