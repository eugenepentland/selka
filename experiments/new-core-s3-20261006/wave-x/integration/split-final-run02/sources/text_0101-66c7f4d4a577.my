module text_0101

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long02éabcdefghijklmnop\rcollision005a0e collision005a0e\x0bΩ  long02éabcdefghijklmnop\nlong01éabcdefghijklmnop\nlong03éabcdefghijklmnop\x0clong01éabcdefghijklmnop\x0cx y  long03éabcdefghijklmnop  a\nΩ\tcollision005a0e\rlong01éabcdefghijklmnop\nb\x0blong03éabcdefghijklmnop  x y  long00éabcdefghijklmnop b\x0ca\x0bcollision005a0e\rcollision002553\tlong00éabcdefghijklmnop\rcafé long03éabcdefghijklmnop a\ncollision002553  a  long02éabcdefghijklmnop\x0ccafé\tcollision002553\x0clong02éabcdefghijklmnop long01éabcdefghijklmnop long00éabcdefghijklmnop  long00éabcdefghijklmnop  b\rnaïve\x0ba\x0c😀\tlong02éabcdefghijklmnop\x0b😀\ra\tcollision002553\x0ccafé\rlong00éabcdefghijklmnop  "
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
