module text_0023

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "collision005a0e long01éabcdefghijklmnop\nlong04éabcdefghijklmnop naïve long06éabcdefghijklmnop  naïve\rcollision002553\nlong11éabcdefghijklmnop\nlong04éabcdefghijklmnop\na\nlong02éabcdefghijklmnop\nlong11éabcdefghijklmnop\x0cΩ\rlong00éabcdefghijklmnop\tcollision002553\na long08éabcdefghijklmnop\nlong10éabcdefghijklmnop\nlong06éabcdefghijklmnop\t😀\tx y\rcollision002553\nlong03éabcdefghijklmnop\x0bcollision002553\x0bb\x0bnaïve\x0b😀\tlong06éabcdefghijklmnop\nΩ long10éabcdefghijklmnop\x0blong07éabcdefghijklmnop  naïve\x0bé"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
