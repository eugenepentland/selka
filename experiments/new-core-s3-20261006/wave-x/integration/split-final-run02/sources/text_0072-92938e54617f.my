module text_0072

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "collision002553\tlong07éabcdefghijklmnop café\x0clong07éabcdefghijklmnop b\rnaïve\tx y\x0blong07éabcdefghijklmnop\nb\x0clong00éabcdefghijklmnop long13éabcdefghijklmnop long08éabcdefghijklmnop\nx y long03éabcdefghijklmnop\rx y\x0blong03éabcdefghijklmnop\x0clong02éabcdefghijklmnop\x0cΩ  long11éabcdefghijklmnop\rlong10éabcdefghijklmnop  long09éabcdefghijklmnop\x0clong06éabcdefghijklmnop\nlong01éabcdefghijklmnop\x0bx y\ncollision005a0e\rlong09éabcdefghijklmnop long03éabcdefghijklmnop\x0blong05éabcdefghijklmnop\x0clong09éabcdefghijklmnop long13éabcdefghijklmnop\rcafé\rlong06éabcdefghijklmnop\nnaïve\x0clong02éabcdefghijklmnop\nlong04éabcdefghijklmnop\x0clong10éabcdefghijklmnop\x0blong01éabcdefghijklmnop  long11éabcdefghijklmnop\tlong01éabcdefghijklmnop a  long04éabcdefghijklmnop\tcollision002553\rcollision005a0e\tlong07éabcdefghijklmnop\n😀\rlong12éabcdefghijklmnop long10éabcdefghijklmnop é"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
