module text_0151

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long08éabcdefghijklmnop  x y\tnaïve\x0blong10éabcdefghijklmnop long02éabcdefghijklmnop  collision005a0e\x0blong12éabcdefghijklmnop\x0bx y\n😀 long11éabcdefghijklmnop\r😀\x0blong04éabcdefghijklmnop b\tcafé  long01éabcdefghijklmnop\x0blong00éabcdefghijklmnop  b  long04éabcdefghijklmnop  long05éabcdefghijklmnop\x0b😀 😀 long12éabcdefghijklmnop b b\nlong04éabcdefghijklmnop  long06éabcdefghijklmnop\x0clong02éabcdefghijklmnop  long12éabcdefghijklmnop\x0ccafé\tlong05éabcdefghijklmnop\tlong01éabcdefghijklmnop  😀\tlong08éabcdefghijklmnop\rlong06éabcdefghijklmnop\nlong03éabcdefghijklmnop\x0blong02éabcdefghijklmnop\nlong09éabcdefghijklmnop\rlong11éabcdefghijklmnop 😀\x0blong07éabcdefghijklmnop\nlong09éabcdefghijklmnop long00éabcdefghijklmnop\x0clong11éabcdefghijklmnop\rcafé\tlong03éabcdefghijklmnop\r😀 long04éabcdefghijklmnop long08éabcdefghijklmnop long05éabcdefghijklmnop\ta\rlong03éabcdefghijklmnop\x0bΩ  é"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
