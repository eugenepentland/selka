module text_0066

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "a\x0clong06éabcdefghijklmnop  long04éabcdefghijklmnop\tnaïve\na\ta\x0blong05éabcdefghijklmnop\tcollision002553\rlong03éabcdefghijklmnop\rcollision005a0e\rcafé\ncollision005a0e\r😀\tnaïve  long06éabcdefghijklmnop\x0clong01éabcdefghijklmnop  long04éabcdefghijklmnop long06éabcdefghijklmnop\x0cx y  b\x0cx y  naïve collision002553\x0blong05éabcdefghijklmnop\t😀\x0b😀 long02éabcdefghijklmnop  café  long00éabcdefghijklmnop collision002553\na  x y\x0ba\x0ccafé\rcollision002553\tcollision002553\x0bb long00éabcdefghijklmnop  Ω long02éabcdefghijklmnop\tlong03éabcdefghijklmnop\nlong01éabcdefghijklmnop\x0blong02éabcdefghijklmnop\x0cé"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
