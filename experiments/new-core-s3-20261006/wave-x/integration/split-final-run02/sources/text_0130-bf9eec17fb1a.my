module text_0130

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long05éabcdefghijklmnop\tlong03éabcdefghijklmnop\nΩ\tΩ\t😀 café\nb\nnaïve\tlong04éabcdefghijklmnop\x0cb\r😀\x0ca\nlong01éabcdefghijklmnop  b\x0clong01éabcdefghijklmnop\tcafé\rlong03éabcdefghijklmnop\ra\tlong08éabcdefghijklmnop long10éabcdefghijklmnop\nlong07éabcdefghijklmnop\ncollision005a0e  long06éabcdefghijklmnop a\tlong08éabcdefghijklmnop\nlong03éabcdefghijklmnop\x0bb\x0blong06éabcdefghijklmnop\nlong04éabcdefghijklmnop\x0clong00éabcdefghijklmnop\x0blong08éabcdefghijklmnop\nb\x0blong07éabcdefghijklmnop\rlong02éabcdefghijklmnop\x0clong00éabcdefghijklmnop  x y\x0ccollision002553\tlong09éabcdefghijklmnop\x0bcafé\x0btail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
