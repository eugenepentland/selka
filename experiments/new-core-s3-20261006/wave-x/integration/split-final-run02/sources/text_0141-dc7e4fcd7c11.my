module text_0141

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "collision002553\nΩ\tcollision002553  a\x0blong09éabcdefghijklmnop long02éabcdefghijklmnop\x0clong04éabcdefghijklmnop naïve  x y\rb 😀\x0bcollision002553\nb\nlong07éabcdefghijklmnop\tlong05éabcdefghijklmnop\x0blong09éabcdefghijklmnop\x0blong04éabcdefghijklmnop\x0ccollision005a0e\rΩ Ω\rcollision005a0e  long10éabcdefghijklmnop\x0clong10éabcdefghijklmnop\tcollision002553\nlong09éabcdefghijklmnop\n😀  collision005a0e long03éabcdefghijklmnop\x0clong10éabcdefghijklmnop\x0blong01éabcdefghijklmnop\nlong05éabcdefghijklmnop\rx y long07éabcdefghijklmnop x y\nlong01éabcdefghijklmnop\x0ccafé  long05éabcdefghijklmnop\rlong01éabcdefghijklmnop\na\tlong03éabcdefghijklmnop\x0bcollision005a0e\x0c😀\x0clong02éabcdefghijklmnop\ttail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
