module text_0035

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "naïve\nlong00éabcdefghijklmnop\tcollision002553\ta\ncafé\nlong02éabcdefghijklmnop\na\x0blong02éabcdefghijklmnop\x0bb long00éabcdefghijklmnop\rlong00éabcdefghijklmnop\x0blong00éabcdefghijklmnop\x0blong00éabcdefghijklmnop\x0bcollision002553\x0clong00éabcdefghijklmnop  long00éabcdefghijklmnop\x0bnaïve\ncollision002553\nlong05éabcdefghijklmnop  collision002553\nlong05éabcdefghijklmnop\rnaïve  b long00éabcdefghijklmnop\tlong03éabcdefghijklmnop  long02éabcdefghijklmnop\tlong05éabcdefghijklmnop\x0clong00éabcdefghijklmnop long02éabcdefghijklmnop\na\x0cnaïve b\rΩ\x0blong04éabcdefghijklmnop 😀\tcollision005a0e\rcollision005a0e\x0clong05éabcdefghijklmnop\rcollision002553\rlong01éabcdefghijklmnop  naïve\nb\x0blong04éabcdefghijklmnop\x0bx y\tlong04éabcdefghijklmnop\nnaïve x y\x0blong05éabcdefghijklmnop  long02éabcdefghijklmnop  long04éabcdefghijklmnop\x0clong04éabcdefghijklmnop  collision002553\ra  tail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
