module text_0150

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "😀\x0cΩ\ta\rx y\x0clong00éabcdefghijklmnop\r😀\x0b😀\ncollision005a0e\nnaïve\rlong01éabcdefghijklmnop\x0cx y\rlong03éabcdefghijklmnop\t😀\tx y café  café\nlong01éabcdefghijklmnop\tb  long03éabcdefghijklmnop\rΩ\x0bnaïve café\tcafé\rnaïve\ra\x0cΩ\nb\rx y  naïve\x0bcafé\x0blong03éabcdefghijklmnop\x0blong01éabcdefghijklmnop\nlong03éabcdefghijklmnop\x0bcollision002553 naïve\x0bcollision005a0e\x0c"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
