module text_0002

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long06éabcdefghijklmnop long02éabcdefghijklmnop\rlong05éabcdefghijklmnop\x0blong00éabcdefghijklmnop  Ω  x y\nx y\x0clong03éabcdefghijklmnop\x0ca\ta\x0clong08éabcdefghijklmnop\rlong08éabcdefghijklmnop  long01éabcdefghijklmnop\rcollision002553\tcollision002553\x0clong06éabcdefghijklmnop\tcafé\rlong04éabcdefghijklmnop\x0cb\rcafé\nx y\tlong04éabcdefghijklmnop\nlong05éabcdefghijklmnop\rlong07éabcdefghijklmnop\nlong00éabcdefghijklmnop b\nlong06éabcdefghijklmnop  x y\x0clong07éabcdefghijklmnop  long01éabcdefghijklmnop\x0clong06éabcdefghijklmnop\x0blong02éabcdefghijklmnop long01éabcdefghijklmnop  😀\x0clong08éabcdefghijklmnop long06éabcdefghijklmnop\x0b😀\x0cΩ\rnaïve 😀  b\x0cnaïve\x0bnaïve\x0blong02éabcdefghijklmnop\rlong04éabcdefghijklmnop\x0cb\nlong02éabcdefghijklmnop\x0cb café\x0blong06éabcdefghijklmnop  "
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
