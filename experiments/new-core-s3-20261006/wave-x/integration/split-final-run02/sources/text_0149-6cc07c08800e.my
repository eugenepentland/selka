module text_0149

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "collision005a0e\nb café café\rb\tlong06éabcdefghijklmnop\n😀\x0clong09éabcdefghijklmnop\nlong02éabcdefghijklmnop\x0clong00éabcdefghijklmnop\ta\x0ca\x0bx y\rlong07éabcdefghijklmnop  x y 😀\tlong08éabcdefghijklmnop b\rcollision002553\nlong03éabcdefghijklmnop\nlong00éabcdefghijklmnop long00éabcdefghijklmnop\nlong00éabcdefghijklmnop\tlong05éabcdefghijklmnop\nlong03éabcdefghijklmnop\tlong08éabcdefghijklmnop café\tlong01éabcdefghijklmnop\tx y\ta\nlong07éabcdefghijklmnop\nlong10éabcdefghijklmnop\n😀\nlong06éabcdefghijklmnop\x0cΩ\x0clong02éabcdefghijklmnop  x y\x0c😀\rlong05éabcdefghijklmnop\nb\x0bnaïve\ncollision005a0e\nlong00éabcdefghijklmnop\rlong08éabcdefghijklmnop\x0clong10éabcdefghijklmnop\rlong01éabcdefghijklmnop\ntail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
