module text_0068

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "Ω\rcafé\x0blong01éabcdefghijklmnop\x0ccollision005a0e\tlong03éabcdefghijklmnop\x0bΩ  long03éabcdefghijklmnop\x0ccafé\nlong01éabcdefghijklmnop  x y\rb\tlong00éabcdefghijklmnop\tcollision005a0e\ncafé\tb\nlong02éabcdefghijklmnop\x0b😀  long02éabcdefghijklmnop\x0blong03éabcdefghijklmnop  long00éabcdefghijklmnop  long02éabcdefghijklmnop\rlong03éabcdefghijklmnop\rΩ\x0bcollision002553\ncollision002553\x0cx y\x0b😀\nlong00éabcdefghijklmnop a café\rcollision005a0e b\x0c😀\x0blong00éabcdefghijklmnop\x0blong03éabcdefghijklmnop\n😀\x0blong02éabcdefghijklmnop\x0blong02éabcdefghijklmnop  café  b\x0cΩ\ncollision002553  😀\nΩ x y\x0bΩ\x0c😀\x0bb  😀\x0b😀\tcafé  "
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
