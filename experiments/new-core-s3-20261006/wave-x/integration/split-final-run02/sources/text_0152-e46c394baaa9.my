module text_0152

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "collision002553\nlong01éabcdefghijklmnop b  a\x0blong00éabcdefghijklmnop\x0cnaïve\x0clong01éabcdefghijklmnop café\rnaïve\tcollision005a0e\rx y long03éabcdefghijklmnop\r😀\rΩ\x0c😀\ta\tlong01éabcdefghijklmnop\tlong01éabcdefghijklmnop\ra\x0ccollision005a0e\r😀\tnaïve\tlong03éabcdefghijklmnop Ω  b\nlong01éabcdefghijklmnop\x0cb\x0clong01éabcdefghijklmnop\tlong00éabcdefghijklmnop\nlong01éabcdefghijklmnop\rcafé collision002553\rcollision002553\x0cb\rlong02éabcdefghijklmnop\x0blong01éabcdefghijklmnop\nΩ tail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
