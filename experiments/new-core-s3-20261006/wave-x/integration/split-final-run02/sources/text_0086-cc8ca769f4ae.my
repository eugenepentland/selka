module text_0086

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long05éabcdefghijklmnop collision002553  long07éabcdefghijklmnop\ncollision002553\x0blong05éabcdefghijklmnop\rcollision005a0e\tcollision005a0e  b  a\nlong03éabcdefghijklmnop\x0bΩ long02éabcdefghijklmnop\x0ba\ra b\n😀\rΩ naïve\x0blong02éabcdefghijklmnop  collision005a0e\x0blong05éabcdefghijklmnop\x0blong01éabcdefghijklmnop\x0blong06éabcdefghijklmnop  long00éabcdefghijklmnop  Ω\rlong05éabcdefghijklmnop  long01éabcdefghijklmnop\nb\nlong01éabcdefghijklmnop\tlong03éabcdefghijklmnop\x0blong00éabcdefghijklmnop\x0ba  a\n😀\rlong07éabcdefghijklmnop\x0blong07éabcdefghijklmnop  café\x0blong05éabcdefghijklmnop\tcollision005a0e\rlong04éabcdefghijklmnop\x0blong04éabcdefghijklmnop\x0ba  collision002553\ncollision002553 long06éabcdefghijklmnop\rcollision002553\tlong00éabcdefghijklmnop  naïve\nnaïve long02éabcdefghijklmnop\tx y  café\nx y\x0c"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
