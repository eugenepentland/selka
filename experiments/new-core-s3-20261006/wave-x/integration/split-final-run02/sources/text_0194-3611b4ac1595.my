module text_0194

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "b\rcollision005a0e\rcafé café\x0bcafé\x0bcafé\rlong04éabcdefghijklmnop\nlong08éabcdefghijklmnop\nlong00éabcdefghijklmnop\ncollision005a0e\x0c😀\x0c😀\tcollision005a0e\nlong09éabcdefghijklmnop long01éabcdefghijklmnop\x0blong09éabcdefghijklmnop\x0ccollision005a0e  long04éabcdefghijklmnop\x0clong01éabcdefghijklmnop long07éabcdefghijklmnop\x0blong00éabcdefghijklmnop\rlong05éabcdefghijklmnop\rb\x0bcollision002553  long02éabcdefghijklmnop\x0clong05éabcdefghijklmnop\x0cé"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
