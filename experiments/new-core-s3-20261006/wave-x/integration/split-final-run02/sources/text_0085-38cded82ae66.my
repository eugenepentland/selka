module text_0085

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "naïve x y\tcollision002553\rlong01éabcdefghijklmnop\x0cnaïve long01éabcdefghijklmnop x y  collision005a0e\x0bcollision005a0e\tcollision005a0e  b  collision002553\x0blong02éabcdefghijklmnop\tlong01éabcdefghijklmnop\rlong01éabcdefghijklmnop long01éabcdefghijklmnop\x0blong02éabcdefghijklmnop  😀\tΩ long05éabcdefghijklmnop\tlong02éabcdefghijklmnop\rlong05éabcdefghijklmnop b a long05éabcdefghijklmnop long00éabcdefghijklmnop\nlong03éabcdefghijklmnop\rΩ\x0clong03éabcdefghijklmnop  b\x0blong02éabcdefghijklmnop\x0cb\rΩ\ra  long05éabcdefghijklmnop\tlong02éabcdefghijklmnop b\tcollision005a0e  collision002553\rlong01éabcdefghijklmnop long04éabcdefghijklmnop\tlong02éabcdefghijklmnop\tcollision002553  long00éabcdefghijklmnop\tnaïve  collision002553\rlong04éabcdefghijklmnop\r😀\x0ca\rb\x0btail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
