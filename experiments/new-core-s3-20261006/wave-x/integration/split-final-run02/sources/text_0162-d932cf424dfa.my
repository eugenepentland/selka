module text_0162

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "Ω\x0cnaïve\x0blong01éabcdefghijklmnop\x0bb\x0c😀\tΩ\nΩ\rx y b x y\nnaïve\x0clong01éabcdefghijklmnop\x0clong02éabcdefghijklmnop\x0bΩ\tnaïve long01éabcdefghijklmnop\ta\x0cx y\x0cx y\x0bx y\rx y\rlong00éabcdefghijklmnop collision002553  a\x0cnaïve\n😀\x0ccollision005a0e\x0ca\ncollision005a0e\r"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
