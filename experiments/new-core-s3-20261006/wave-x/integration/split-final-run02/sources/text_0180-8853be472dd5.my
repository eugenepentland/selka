module text_0180

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "😀\rlong02éabcdefghijklmnop\rcafé\tlong00éabcdefghijklmnop long01éabcdefghijklmnop  collision002553\x0clong01éabcdefghijklmnop\tlong01éabcdefghijklmnop  😀  collision002553\ncollision005a0e\ncollision005a0e  long02éabcdefghijklmnop\x0ca\tlong03éabcdefghijklmnop\rlong01éabcdefghijklmnop\ncafé\tΩ\x0blong00éabcdefghijklmnop\nlong01éabcdefghijklmnop\x0cx y\rnaïve  long03éabcdefghijklmnop\x0ba  x y\rΩ\rcafé\x0bx y\rtail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
