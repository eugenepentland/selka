module text_0192

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long04éabcdefghijklmnop\ncollision002553  b  long02éabcdefghijklmnop\x0b😀\rcollision002553\rb\ncafé\tnaïve  x y\x0clong06éabcdefghijklmnop\nb\x0clong04éabcdefghijklmnop\x0cb\tx y\x0cΩ\x0clong05éabcdefghijklmnop\rcollision005a0e long02éabcdefghijklmnop  b  long00éabcdefghijklmnop\rΩ long02éabcdefghijklmnop\tb\x0bcollision002553 long06éabcdefghijklmnop\x0clong06éabcdefghijklmnop café\x0blong01éabcdefghijklmnop\x0bΩ  long00éabcdefghijklmnop long05éabcdefghijklmnop\x0bx y\tx y\x0clong05éabcdefghijklmnop\x0clong04éabcdefghijklmnop\nlong06éabcdefghijklmnop long05éabcdefghijklmnop  long04éabcdefghijklmnop a\tx y\rΩ\x0ccafé\nb\x0ca\t😀\tlong03éabcdefghijklmnop\x0clong01éabcdefghijklmnop\tcollision005a0e\ncollision002553  naïve\x0b "
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
