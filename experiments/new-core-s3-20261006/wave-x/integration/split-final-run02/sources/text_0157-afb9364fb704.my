module text_0157

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long00éabcdefghijklmnop\x0bcollision002553\nlong11éabcdefghijklmnop\x0cΩ\nb\x0bcollision005a0e long04éabcdefghijklmnop\tcollision005a0e\x0cx y\x0bΩ\ncafé\nlong01éabcdefghijklmnop\x0clong11éabcdefghijklmnop 😀  long06éabcdefghijklmnop\x0blong11éabcdefghijklmnop 😀  naïve\x0ccollision005a0e\nlong05éabcdefghijklmnop\rlong08éabcdefghijklmnop\x0clong03éabcdefghijklmnop\x0blong01éabcdefghijklmnop\nlong09éabcdefghijklmnop  long09éabcdefghijklmnop long01éabcdefghijklmnop\x0ca\t"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
