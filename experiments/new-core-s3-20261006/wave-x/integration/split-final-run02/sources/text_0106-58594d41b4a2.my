module text_0106

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "x y\tb a\x0blong00éabcdefghijklmnop collision005a0e\x0blong03éabcdefghijklmnop\x0c😀\nnaïve\nnaïve\r😀\x0bcafé  long00éabcdefghijklmnop\x0cnaïve\tcollision002553\x0bcollision002553\r😀\x0blong02éabcdefghijklmnop\tx y\rlong02éabcdefghijklmnop\x0bcollision005a0e Ω long01éabcdefghijklmnop\tcollision002553\tcollision002553 collision002553\ncollision005a0e\rΩ\tb\x0clong02éabcdefghijklmnop\nx y  café\t😀\nlong03éabcdefghijklmnop\rnaïve b\rcollision002553\x0ccafé\x0cx y\x0btail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
