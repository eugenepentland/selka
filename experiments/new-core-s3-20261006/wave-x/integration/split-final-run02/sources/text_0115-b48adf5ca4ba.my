module text_0115

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long00éabcdefghijklmnop\rlong05éabcdefghijklmnop  collision005a0e\nnaïve  x y\t😀\rlong03éabcdefghijklmnop  collision002553\x0clong04éabcdefghijklmnop\rb\rlong04éabcdefghijklmnop\nΩ  long05éabcdefghijklmnop\x0ba\rlong04éabcdefghijklmnop\x0bnaïve\rlong07éabcdefghijklmnop\tlong00éabcdefghijklmnop\nlong04éabcdefghijklmnop  long07éabcdefghijklmnop\r😀 long03éabcdefghijklmnop naïve\x0clong03éabcdefghijklmnop  long01éabcdefghijklmnop  Ω long07éabcdefghijklmnop collision005a0e\x0blong03éabcdefghijklmnop\tlong04éabcdefghijklmnop  long04éabcdefghijklmnop\nlong00éabcdefghijklmnop collision002553 long02éabcdefghijklmnop\rlong00éabcdefghijklmnop\x0clong00éabcdefghijklmnop\x0bcollision005a0e\tlong03éabcdefghijklmnop x y\x0clong03éabcdefghijklmnop long05éabcdefghijklmnop\r😀\x0bΩ\x0blong05éabcdefghijklmnop\x0btail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
