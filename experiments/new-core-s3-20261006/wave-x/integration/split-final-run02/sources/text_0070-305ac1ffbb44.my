module text_0070

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long10éabcdefghijklmnop\ncafé  long10éabcdefghijklmnop\tx y\tb 😀\tb\tlong06éabcdefghijklmnop  😀 😀\x0bx y\x0clong00éabcdefghijklmnop\x0cΩ\nlong10éabcdefghijklmnop\tlong05éabcdefghijklmnop\tlong06éabcdefghijklmnop\tnaïve\x0blong01éabcdefghijklmnop collision002553\nlong04éabcdefghijklmnop  long05éabcdefghijklmnop\tx y\na\r😀\nlong01éabcdefghijklmnop\rlong06éabcdefghijklmnop\x0cΩ\ta\ncafé\x0clong02éabcdefghijklmnop  long06éabcdefghijklmnop\nΩ long00éabcdefghijklmnop\rlong01éabcdefghijklmnop\rlong01éabcdefghijklmnop\tlong07éabcdefghijklmnop\rnaïve\ncafé\ncollision005a0e\ttail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
