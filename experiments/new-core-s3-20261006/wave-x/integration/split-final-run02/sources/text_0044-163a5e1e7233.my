module text_0044

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "café\x0blong00éabcdefghijklmnop\x0cx y  long05éabcdefghijklmnop\tlong02éabcdefghijklmnop\tlong06éabcdefghijklmnop\x0clong02éabcdefghijklmnop\x0blong03éabcdefghijklmnop\x0clong05éabcdefghijklmnop\x0blong01éabcdefghijklmnop\tnaïve long01éabcdefghijklmnop\x0cnaïve\nΩ long05éabcdefghijklmnop\x0clong01éabcdefghijklmnop  x y\x0ccafé\x0clong03éabcdefghijklmnop  long03éabcdefghijklmnop\ra b\x0c😀 collision005a0e\rlong03éabcdefghijklmnop\x0cx y\nlong05éabcdefghijklmnop  naïve  b  long04éabcdefghijklmnop\x0clong05éabcdefghijklmnop long01éabcdefghijklmnop\nlong05éabcdefghijklmnop\tx y collision005a0e\x0clong00éabcdefghijklmnop long03éabcdefghijklmnop\x0blong03éabcdefghijklmnop é"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
