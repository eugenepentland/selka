module text_0034

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "naïve long03éabcdefghijklmnop  café\x0clong02éabcdefghijklmnop\n😀\tb x y\nlong02éabcdefghijklmnop\tcollision005a0e café  b\x0bb b\rcollision005a0e\tlong02éabcdefghijklmnop  long03éabcdefghijklmnop café naïve\x0clong01éabcdefghijklmnop\rcollision005a0e\tΩ\rlong03éabcdefghijklmnop\tlong00éabcdefghijklmnop\rcafé\ncollision005a0e\x0blong02éabcdefghijklmnop\x0bΩ\x0clong00éabcdefghijklmnop\tlong02éabcdefghijklmnop\rnaïve\x0clong00éabcdefghijklmnop\tcollision002553\x0cx y  x y  naïve 😀\ncafé\x0bnaïve  "
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
