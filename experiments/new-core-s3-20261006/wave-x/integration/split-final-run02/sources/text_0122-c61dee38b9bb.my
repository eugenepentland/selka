module text_0122

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long06éabcdefghijklmnop\x0blong05éabcdefghijklmnop  x y\tb\x0blong01éabcdefghijklmnop\x0clong03éabcdefghijklmnop\tx y\x0blong01éabcdefghijklmnop\rx y b\tΩ\tΩ\x0bnaïve\x0blong02éabcdefghijklmnop\nlong00éabcdefghijklmnop naïve\tlong02éabcdefghijklmnop\x0cΩ\x0clong03éabcdefghijklmnop\nlong00éabcdefghijklmnop long01éabcdefghijklmnop  a\tlong07éabcdefghijklmnop\x0blong07éabcdefghijklmnop\tlong01éabcdefghijklmnop\x0bnaïve\rx y\nnaïve\x0ccollision002553\x0bcollision005a0e\rlong02éabcdefghijklmnop  long03éabcdefghijklmnop\x0bcollision002553\x0blong07éabcdefghijklmnop\ncafé\tcollision005a0e\x0btail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
