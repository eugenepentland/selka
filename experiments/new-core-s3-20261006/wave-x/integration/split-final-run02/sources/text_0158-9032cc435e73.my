module text_0158

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "collision005a0e\nlong01éabcdefghijklmnop  long06éabcdefghijklmnop\tx y\tlong08éabcdefghijklmnop  long06éabcdefghijklmnop\rlong04éabcdefghijklmnop\nlong04éabcdefghijklmnop\tcollision005a0e\x0clong01éabcdefghijklmnop\tlong05éabcdefghijklmnop\tlong09éabcdefghijklmnop\ta\rcollision005a0e  long08éabcdefghijklmnop  a\rnaïve  Ω\x0ba\tnaïve\x0clong06éabcdefghijklmnop\tlong00éabcdefghijklmnop 😀\x0bΩ\x0ca  long00éabcdefghijklmnop  collision002553\tlong06éabcdefghijklmnop\x0clong03éabcdefghijklmnop\rcafé\ncollision002553\nx y\x0clong03éabcdefghijklmnop long09éabcdefghijklmnop  long05éabcdefghijklmnop\nlong09éabcdefghijklmnop\tlong07éabcdefghijklmnop long01éabcdefghijklmnop\rΩ\x0clong07éabcdefghijklmnop\nlong00éabcdefghijklmnop  😀\rnaïve\rnaïve\x0ca\x0blong00éabcdefghijklmnop long04éabcdefghijklmnop\tlong04éabcdefghijklmnop\x0blong05éabcdefghijklmnop\x0clong02éabcdefghijklmnop\t😀\x0bnaïve\x0c"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
