module text_0003

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "collision005a0e\x0ccafé  long11éabcdefghijklmnop\rlong06éabcdefghijklmnop\x0ca long07éabcdefghijklmnop b\rlong06éabcdefghijklmnop\rcafé\x0blong02éabcdefghijklmnop\x0blong03éabcdefghijklmnop\x0ca  long00éabcdefghijklmnop  long12éabcdefghijklmnop\rlong04éabcdefghijklmnop\nlong06éabcdefghijklmnop\nlong02éabcdefghijklmnop\nlong05éabcdefghijklmnop\nx y\rlong04éabcdefghijklmnop\x0ca\x0clong02éabcdefghijklmnop\x0clong08éabcdefghijklmnop\nlong08éabcdefghijklmnop\x0clong01éabcdefghijklmnop\x0b"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
