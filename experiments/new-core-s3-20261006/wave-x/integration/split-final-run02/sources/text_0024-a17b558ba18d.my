module text_0024

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long05éabcdefghijklmnop long05éabcdefghijklmnop\nlong05éabcdefghijklmnop long04éabcdefghijklmnop\tcollision002553\tlong02éabcdefghijklmnop\x0blong07éabcdefghijklmnop\x0cnaïve\rlong02éabcdefghijklmnop\rlong00éabcdefghijklmnop\x0clong03éabcdefghijklmnop\tcollision005a0e  a  long07éabcdefghijklmnop\tΩ\x0blong04éabcdefghijklmnop\x0cΩ\tlong02éabcdefghijklmnop\x0bnaïve long06éabcdefghijklmnop\rb\rx y x y a\x0clong02éabcdefghijklmnop\x0bb\rcafé  a café\x0clong02éabcdefghijklmnop b  naïve\x0blong01éabcdefghijklmnop long06éabcdefghijklmnop\tcollision005a0e\ra\rlong07éabcdefghijklmnop\nlong03éabcdefghijklmnop\rcafé\x0ba\x0bcafé\x0cb\x0clong04éabcdefghijklmnop\nΩ\x0blong06éabcdefghijklmnop\x0ccollision002553\rlong00éabcdefghijklmnop\x0b"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
