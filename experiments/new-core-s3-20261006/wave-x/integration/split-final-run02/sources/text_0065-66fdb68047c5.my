module text_0065

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "long00éabcdefghijklmnop\rlong01éabcdefghijklmnop\x0blong02éabcdefghijklmnop\x0bΩ\x0bx y\x0b😀\x0ccollision002553\x0clong00éabcdefghijklmnop\x0cx y\rlong00éabcdefghijklmnop\x0blong00éabcdefghijklmnop\tcollision005a0e x y\rlong00éabcdefghijklmnop 😀\tcafé  long00éabcdefghijklmnop  collision005a0e\x0clong00éabcdefghijklmnop\x0c😀\tb\x0cnaïve\na\ra\rb café  naïve  collision002553\tx y\tlong02éabcdefghijklmnop\x0clong01éabcdefghijklmnop\rlong02éabcdefghijklmnop a  a\nlong02éabcdefghijklmnop\x0blong02éabcdefghijklmnop\x0bnaïve\x0ccafé\tlong02éabcdefghijklmnop a long01éabcdefghijklmnop\x0b"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
