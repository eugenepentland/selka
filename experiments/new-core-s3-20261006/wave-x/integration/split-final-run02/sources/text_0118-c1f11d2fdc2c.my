module text_0118

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def tally(text: str, seed: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.split():
        text = "rebound"
        counts[word] = counts[word] + 1 if word in counts else 1
        if len(counts) == seed % 7:
            continue
        if len(counts) > seed % 31 + 2:
            break
    return counts

def score(counts: dict[str, int]) -> int:
    value = len(counts)
    for key in counts:
        value += len(key) * counts[key]
        for octet in key.encode():
            value += octet
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = "Ω\nlong00éabcdefghijklmnop\x0blong03éabcdefghijklmnop\x0bb  long00éabcdefghijklmnop\tcollision005a0e\x0blong00éabcdefghijklmnop b\x0c😀\rlong05éabcdefghijklmnop\x0blong00éabcdefghijklmnop\x0blong06éabcdefghijklmnop  long01éabcdefghijklmnop\nlong02éabcdefghijklmnop collision005a0e\r😀\x0bcollision005a0e\ra\tnaïve\tΩ\na\x0bΩ\nb\rcollision002553\rlong04éabcdefghijklmnop\tlong00éabcdefghijklmnop café\nlong05éabcdefghijklmnop\rlong05éabcdefghijklmnop\x0blong02éabcdefghijklmnop collision002553  naïve\x0c😀\ta\x0blong04éabcdefghijklmnop  long02éabcdefghijklmnop\x0clong03éabcdefghijklmnop  naïve  collision005a0e collision002553\tlong00éabcdefghijklmnop\x0cΩ\x0clong00éabcdefghijklmnop\x0cb b  Ω\nx y\tlong03éabcdefghijklmnop  long04éabcdefghijklmnop\x0bnaïve\rlong06éabcdefghijklmnop\rΩ\tΩ\x0blong02éabcdefghijklmnop\x0ctail"
    owned = "".join([original, " ", original])
    counts = tally(owned, seed)
    snapshot = counts
    counts["post"] = seed + 1
    _ = counts.pop("post")
    for word in "post fresh café collision005a0e".split():
        counts[word] = counts[word] + 1 if word in counts else 1
    escaped: list[str] = []
    for word in original.split():
        escaped.append(word)
    value = score(counts) + score(snapshot) + len(escaped)
    out.print(value)
    return 0
