def probe(xs: list[int], key: int) -> int:
    i = key % 12 - 2
    if i >= 0:
        if i <= len(xs):
            return xs[i]
    return 0


def helper0(a: int, b: int) -> int:
    if a <= (1000003 // (0 - 7)):
        return ((20 - 27) + b)
    return ((101 % 16) + (3037000500 % a))


def helper1(a: int, b: int) -> int:
    if (a // 2) > b:
        return ((a + b) * (12 % 2))
    return ((b // 2) % 1)


def number(text: str, fallback: int) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return fallback


def main(args: list[str], out: Stream) -> int:
    if len(args) != 3:
        return 2
    n = number(args[0], 3)
    rounds = number(args[1], 2)
    seed = number(args[2], 7)
    if n < 0 or n > 100 or rounds < 0 or rounds > 5:
        return 3
    values = [(j) % 4000 for j in range(n)]
    second = [(j * 45 + 3) % 4000 for j in range(n)]
    flags = [(j) % 3 < 19 for j in range(n)]
    acc = 0
    for b in range(rounds):
        phase = b % 7
        total = 0
        for j in range(n):
            x = values[j]
            y = second[j]
            v = (((phase % 16) // 17) * (phase + (x * 13)))
            if flags[j]:
                v = ((v + phase) * (v + phase))
            else:
                v = v + 20
            total += v
        acc = (acc + total) % 1000000007
    acc = acc + probe(second, (seed + 50))
    out.print(acc, len(values))
    return acc % 7

