module text_0000

def number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0

def score(text: str) -> int:
    value = len(text)
    for octet in text.encode():
        value += octet ^ 7
    return value

def main(args: list[str], out: Stream) -> int:
    seed = number(args[0])
    original = " 🙂ΩΩéΩΩ🙂BΩa 🙂B|a|\n a\r\nΩΩ🙂éa| Ω\té🙂|\né"
    changed = original
    for j in range(seed % 7):
        if j % 3 == 0:
            alias = changed
            changed += alias
        else:
            changed += "é🙂a"
    rebuilt = ""
    for ch in changed:
        rebuilt += ch
    sliced = changed[-24:34]
    parts = changed.split("|")
    value = score(original) + score(changed) + score(rebuilt) + score(sliced) + score("::".join(parts))
    value += changed.find("") + len(parts)
    value += changed.count("", -24, 34) + changed.rfind("", -24, 34)
    value += score(changed.upper()) + score(changed.lower()) + score(changed.strip())
    value += score(changed.strip("éΩ🙂aB")) + score(changed.lstrip("éΩ🙂aB")) + score(changed.rstrip("éΩ🙂aB"))
    value += score(changed.replace("é", "🙂x")) + score(repr(changed)) + score(repr(changed.encode()))
    value += score(changed[::-1]) + score(changed[-24:34:3])
    value += score("|".join(changed.splitlines()))
    value += score(chr(ord("🙂"))) + score(changed.zfill(40))
    value += score(f"{changed:*>20.7}")
    if changed.isdigit() or changed.isalpha() or changed.isspace():
        value += 17
    if changed.startswith("", -24, 34) or changed.endswith("", -24, 34):
        value += 31
    if changed.find("") >= 0:
        value += changed.index("") + changed.rindex("")
    raw = changed.encode()
    value += raw.count(b"a", -24, 34) + raw.rfind(b"a", -24, 34)
    value += raw.find_any(b"|aB", -24) + len(raw.strip()) + len(raw.view(-24, 34))
    match raw.decode():
        case Ok(text):
            value += score(text)
        case Err(text):
            value -= score(text)
    match raw.scalar_count():
        case Ok(count):
            value += count
        case Err(text):
            value -= score(text)
    match b"a\xffz".scalar_count():
        case Ok(count):
            value -= count
        case Err(text):
            value += score(text)
    reversed_parts = parts
    reversed_parts.extend(parts)
    reversed_parts.reverse()
    value += score("/".join(reversed_parts))
    out.print(value)
    return 0
