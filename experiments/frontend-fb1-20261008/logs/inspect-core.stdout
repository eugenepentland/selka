575:            .record => |fields| .{ .record = try allocator.dupe(Type, fields) },
576:            .@"union" => |cases| .{ .@"union" = try allocator.dupe(Type, cases) },
577:            .@"fn" => |signature| .{ .@"fn" = .{ .params = try allocator.dupe(Type, signature.params), .ret = signature.ret, .linkage = signature.linkage, .owned = signature.owned, .views = signature.views } },
580:        try self.compounds.append(allocator, owned);
