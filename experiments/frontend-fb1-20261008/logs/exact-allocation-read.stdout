    fn functionName(self: *ModuleState, index: u32) []const u8 {
        if (self.local.selection) |selected| if (selected.symbols[index]) |name| return name;
        return self.module.functions.items[index].name;
    }

    fn originalSymbol(self: *ModuleState, index: u32) ![]const u8 {
        const function = &self.module.functions.items[index];
        return if (function.signature.linkage == .internal) symbol(self.allocator, self.functionName(index)) else std.fmt.allocPrint(self.allocator, "@{s}", .{c_abi.symbol(self.functionName(index))});
    }

    fn dependency(self: *ModuleState, index: u32) !void {
    }

    /// The check an instruction gets emitted with: verify mode emits proven checks as exact ones.
    pub fn checkOf(self: *FunctionEmitter, inst: ir.Inst) ir.Check {
        return if (inst.check == .proven and self.state.options.verify) .exact else inst.check;
    }

    /// Whether `pred` → `header` is the edge a vectorized loop is entered by.
    fn vectorPreheader(self: *FunctionEmitter, pred: ir.BlockId, header: u32) bool {
        for (self.vectors.plans) |plan| {
            if (plan.loop.header.index() == header and plan.preheader == pred) return true;
        return self.state.rangeNode(info.bits, range);
    }

    /// Append in place: `myl_core_list_reserve` returns a block with room for one more element.
    fn listPush(self: *FunctionEmitter, out: *Out, name: []const u8, inst: ir.Inst) !void {
        const element = self.state.module.compound(inst.ty).list;
        const len_at = try self.fresh("%pl");
        const counter = if (inst.data == flags.fill_push) self.fillCounter(inst.a) else null;
        const len = if (counter) |ref| try self.value(ref) else try self.fresh("%plen");
        const next = try self.fresh("%pn");
        if (inst.data == stack_push) {
            // A promoted list's room is proven (`promote.zig`): no growth call.
            try out.print(self.a(), same_pointer, .{ name, try self.value(inst.a) });
        } else if (counter != null) {
            try out.print(self.a(), "  {s} = call ptr @myl_core_list_fill_reserve(ptr {s}, i64 {d}, i64 {s})\n", .{ name, try self.value(inst.a), self.state.stride(element), len });
        } else try out.print(self.a(), "  {s} = call ptr @myl_core_list_reserve(ptr {s}, i64 {d})\n", .{ name, try self.value(inst.a), self.state.stride(element) });
        if (counter != null) {
            try out.print(self.a(), header_pointer_line, .{ len_at, name, len_offset });
            if (self.state.options.verify) try self.assertFillRoom(out, name, len_at, len, inst);
        } else try out.print(self.a(), header_tagged_line, .{ len_at, name, len_offset, len, len_at });
        const slot = try self.elementSlot(out, name, len, element);
        if (element == .bool or element.isCompound()) {
            try self.storeOperand(out, element, inst.b, slot);
        } else {
            try out.print(self.a(), "  store {s}, ptr {s}, align {d}, " ++ tbaa_data ++ "\n", .{ try self.typedValue(inst.b), slot, elementSize(element) });
        }
        try out.print(self.a(), "  {s} = add nuw nsw i64 {s}, 1\n  store i64 {s}, ptr {s}, align 8, " ++ tbaa_header ++ "\n", .{ next, len, next, len_at });
    }

            while (at < block.insts.items.len) : (at += 1) {
                const ref = block.insts.items[at];
                var call = caller.insts.items[ref.index()];
                @import("build_fn.zig").directTarget(caller, &call);
                caller.insts.items[ref.index()] = call;
                if (call.op != .call or call.a.index() == index) continue;
                const callee = &module.functions.items[call.a.index()];
                const result = leaf(callee) orelse continue;
                if (proof.needsProof(callee)) {
                    if (known == null) known = try facts.analyze(arena, caller, .{ .fold = false, .mark = false, .params = if (index < parameters.len) parameters[index] else &.{} });
                    if (!try proof.trapFree(arena, caller, call, callee, known.?)) continue;
                }
                var clone = try provenance.prepare(arena, .{ .caller = @intCast(index), .callee = @intCast(call.a.index()), .block = @intCast(b), .ref = ref, .span = call.span }, callee) orelse continue;
                const cloned = try splice(arena, caller, callee, .{ .block = block, .at = at, .call = ref, .result = result }, &clone);
                at += cloned;
                count += 1;
            }
        }
    }
    return count;
}

/// The returned value of a qualifying leaf, or null.
/// Builds one function's Core IR by hand, for tests of operations the builder
/// does not produce yet. Instructions go into the current block in order.
pub const Hand = struct {
    arena: std.mem.Allocator,
    module: *ir.Module,
    function: ir.Function,
    block: ir.BlockId = @fromBackingInt(0),

    /// A function `name(params) -> ret` with one empty entry block.
    pub fn init(arena: std.mem.Allocator, module: *ir.Module, name: []const u8, signature: ir.Signature) Error!Hand {
        var hand: Hand = .{ .arena = arena, .module = module, .function = .{ .name = name, .signature = signature } };
        _ = try hand.newBlock();
        return hand;
    }

    /// Append `inst` to the current block; returns its value.
    pub fn emit(self: *Hand, inst: ir.Inst) Error!ir.Ref {
        const ref = try self.loose(inst);
        try self.function.blocks.items[self.block.index()].insts.append(self.arena, ref);
        return ref;
    }

    /// An instruction outside every block: a constant or parameter.
    pub fn loose(self: *Hand, inst: ir.Inst) Error!ir.Ref {
        const ref: ir.Ref = @fromBackingInt(@intCast(self.function.insts.items.len));
        try self.function.insts.append(self.arena, inst);
        return ref;
    }

    /// An integer constant of type `ty`.
    pub fn int(self: *Hand, ty: ir.Type, value: i64) Error!ir.Ref {
        return self.loose(.{ .op = .iconst, .ty = ty, .data = @bitCast(value) });
    }

    /// Parameter `index`.
    pub fn param(self: *Hand, index: u32) Error!ir.Ref {
        return self.loose(.{ .op = .param, .ty = self.function.signature.params[index], .data = index });
    }

    /// Pack `refs` as an instruction's `extra` list.
    pub fn extra(self: *Hand, refs: []const ir.Ref) Error!u64 {
        const start: u32 = @intCast(self.function.extra.items.len);
        try self.function.extra.appendSlice(self.arena, refs);
        return (ir.ExtraSlice{ .start = start, .len = @intCast(refs.len) }).pack();
    }

    /// A new empty block (not entered).
    pub fn newBlock(self: *Hand) Error!ir.BlockId {
        try self.function.blocks.append(self.arena, .{});
        return @fromBackingInt(@intCast(self.function.blocks.items.len - 1));
    }

    /// End the current block with a jump to `target`, recording the edge.
    pub fn jump(self: *Hand, target: ir.BlockId) Error!void {
        _ = try self.emit(.{ .op = .jump, .ty = .void, .data = @backingInt(target) });
        try self.function.blocks.items[target.index()].preds.append(self.arena, self.block);
    }

    /// End the current block with `if condition: then else otherwise`.
    pub fn branch(self: *Hand, condition: ir.Ref, then: ir.BlockId, otherwise: ir.BlockId) Error!void {
        _ = try self.emit(.{ .op = .branch, .ty = .void, .a = condition, .data = ir.packTargets(then, otherwise) });
        try self.function.blocks.items[then.index()].preds.append(self.arena, self.block);
        try self.function.blocks.items[otherwise.index()].preds.append(self.arena, self.block);
    }
