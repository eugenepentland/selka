        const configured = config.load(allocator, io, where, &failure) catch |err| {
            if (err == error.OutOfMemory) return error.OutOfMemory;
            try report.print(allocator, "{s}:{d}:{d}: error[E_PROJECT_CONFIG]: {s}\n", .{ failure.path, failure.location.line, failure.location.column, failure.detail });
            return error.ConfigurationFailed;
        };
        if (!configured.document.value_semantics) {
            try report.print(allocator, "{s}: error[E_CORE_UNSUPPORTED]: the new core requires value_semantics\n", .{configured.path});
            return error.SourceError;
        }
        entry.configuration = configured;
    }
    return entry;
}

fn rootFor(path: []const u8, relative: []const u8) ?[]const u8 {
    if (!std.mem.endsWith(u8, path, relative) or path.len <= relative.len) return null;
    const separator = path.len - relative.len - 1;
    if (path[separator] != std.fs.path.sep) return null;
    return if (separator == 0) path[0..1] else path[0..separator];
}

fn declaredModule(bytes: []const u8) ?[]const u8 {
    var lines = std.mem.splitScalar(u8, bytes, '\n');
    while (lines.next()) |raw| {
        const line = std.mem.trim(u8, raw, " \t\r");
        if (line.len == 0 or line[0] == '#') continue;
        if (!std.mem.startsWith(u8, line, "module ")) return null;
        var words = std.mem.tokenizeAny(u8, line["module ".len..], " \t\r#");
        const name = words.next() orelse return null;
        return if (language.project.validName(name)) name else null;
    }
    return null;
}

// spec: NEW-CORE-S4-PROJECT-1
test "nested module root resolution respects file boundaries and mismatched declarations" {
    try std.testing.expectEqualStrings("/project/src", rootFor("/project/src/types/shape.my", "types/shape.my").?);
    try std.testing.expectEqualStrings("/", rootFor("/main.my", "main.my").?);
    try std.testing.expect(rootFor("/project/my_main.my", "main.my") == null);
    try std.testing.expect(rootFor("/project/main.my", "wrong.my") == null);
    try std.testing.expectEqualStrings("types.shape", declaredModule("# comment\n\nmodule types.shape\n").?);
    try std.testing.expect(declaredModule("module ../escape\n") == null);
}

// spec: NEW-CORE-S5-POLICY-1
test "an import the configured policy denies is its own failure, with the policy gate's status 3" {
    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
    defer arena.deinit();
    const a = arena.allocator();
    var tmp = std.testing.tmpDir(.{});
    defer tmp.cleanup();
    try tmp.dir.writeFile(std.testing.io, .{ .sub_path = "main.my", .data = "module main\nimport helper\ndef main() -> int:\n    return helper.value()\n" });
    try tmp.dir.writeFile(std.testing.io, .{ .sub_path = "helper.my", .data = "module helper\npublic def value() -> int effects():\n    return 7\n" });
    try tmp.dir.writeFile(std.testing.io, .{ .sub_path = "mylang.json", .data = "{\"version\":1,\"import_policy\":\"policy.json\"}" });
    try tmp.dir.writeFile(std.testing.io, .{ .sub_path = "policy.json", .data = "{\"version\":1,\"default_action\":\"deny\",\"rules\":[]}" });
    const path = try tmp.dir.realPathFileAlloc(std.testing.io, "main.my", a);
    var report: std.ArrayList(u8) = .empty;
    const entry = try resolve(a, std.testing.io, path, &report);
    var session = frontend.Session.init(a, std.testing.io, entry.root);
    entry.configure(&session);
    _ = try session.checkFile(a, path, &report);
    try std.testing.expectError(error.PolicyDenied, entry.validate(a, &session, &report));
    try std.testing.expectEqual(@as(u8, 3), status(error.PolicyDenied));
    try std.testing.expectEqual(@as(u8, 1), status(error.SourceError));
    try tmp.dir.writeFile(std.testing.io, .{ .sub_path = "mylang.json", .data = "{" });
    try std.testing.expectError(error.ConfigurationFailed, resolve(a, std.testing.io, path, &report));
//! Helpers the new core's unit tests share: check a single-file program from
//! source text and build or render its Core IR.
const std = @import("std");
const language = @import("mylang");
const ir = @import("ir.zig");
const build = @import("build.zig");
const print = @import("print.zig");
const emit_llvm = @import("emit_llvm.zig");
const facts = @import("facts.zig");
const passes = @import("passes.zig");
const driver = @import("driver.zig");
const verify_ir = @import("verify_ir.zig");
const vector = @import("vector.zig");

/// Failure detail goes to the test's stderr.
const report = std.debug.print;

/// Everything checking, building or emitting a test program can fail with.
pub const Error = language.diagnostic.Error || build.Error || emit_llvm.Error || verify_ir.Error;

/// Check `source` as a header-less program and build its Core IR in `arena`; the
/// IR is verified (`verify_ir.zig`) before it is returned.
pub fn buildSource(arena: std.mem.Allocator, source: []const u8, refusal: *build.Refusal) Error!ir.Module {
    var unit = try language.Compilation.init(arena, "test.my", source);
    try unit.check();
    const module = try build.buildModule(arena, unit.program.?, refusal);
    try verified(arena, &module, &.{});
    return module;
}

/// Verify `module` and its vector plans; a failure prints the verifier's report.
pub fn verified(arena: std.mem.Allocator, module: *const ir.Module, plans: []const []const vector.Plan) verify_ir.Error!void {
    var text: std.ArrayList(u8) = .empty;
    verify_ir.check(arena, module, plans, &text) catch |err| {
        report("{s}", .{text.items});
        return err;
    };
}

/// Run the release passes in `mode` and verify the result, plans included.
pub fn runPasses(arena: std.mem.Allocator, module: *ir.Module, mode: passes.Mode) Error!passes.Result {
    const result = try passes.run(arena, module, mode);
    try verified(arena, module, result.plans);
    return result;
}

/// Carry every optimizer product to an emission fixture without dropping ancestry.
pub fn analysis(result: *const passes.Result) emit_llvm.Analysis {
    return .{ .facts = result.known, .vectors = result.plans, .provenance = &result.provenance };
}

/// The textual Core IR of `source`.
pub fn irText(arena: std.mem.Allocator, source: []const u8) Error![]u8 {
    var refusal: build.Refusal = .{};
    const module = try buildSource(arena, source, &refusal);
    return print.module(arena, &module);
}

fn firstLine(_: *const anyopaque, offset: u32) emit_llvm.Location {
    return .{ .line = 1, .column = offset + 1 };
}

/// The LLVM IR of `source`, with every trap located at line 1.
pub fn llvmText(arena: std.mem.Allocator, source: []const u8) Error![]u8 {
    var refusal: build.Refusal = .{};
    const module = try buildSource(arena, source, &refusal);
    const context: u8 = 0;
    return emit_llvm.emitModule(arena, &module, .{ .locator = .{ .context = &context, .locate = firstLine }, .source_path = "test.my", .main = .{ .parameters = &.{"out"} } });
}

/// The textual Core IR of `source` after the release fact pass marked what it proved.
pub fn factsText(arena: std.mem.Allocator, source: []const u8) Error![]u8 {
    var refusal: build.Refusal = .{};
    var module = try buildSource(arena, source, &refusal);
    for (module.functions.items) |*function| {
        if (function.signature.linkage == .internal) _ = try facts.analyze(arena, function, .{});
    }
    try verified(arena, &module, &.{});
    return print.module(arena, &module);
}

/// The textual Core IR of `source` after the release passes.
pub fn optimizedText(arena: std.mem.Allocator, source: []const u8) Error![]u8 {
    var refusal: build.Refusal = .{};
    var module = try buildSource(arena, source, &refusal);
    _ = try runPasses(arena, &module, .trusted);
    return print.module(arena, &module);
}

/// The LLVM IR a release build of `source` emits.
pub fn releaseLlvmText(arena: std.mem.Allocator, source: []const u8) Error![]u8 {
    return releaseLlvmTextFor(arena, source, @import("target.zig").current);
}

/// The LLVM IR a `--verify-facts` release build of `source` emits.
pub fn verifyLlvmText(arena: std.mem.Allocator, source: []const u8) Error![]u8 {
    var refusal: build.Refusal = .{};
    var module = try buildSource(arena, source, &refusal);
    const result = try runPasses(arena, &module, .verify);
    const context: u8 = 0;
    const locator: emit_llvm.Locator = .{ .context = &context, .locate = firstLine };
    return emit_llvm.emitModule(arena, &module, .{ .locator = locator, .source_path = "test.my", .main = .{ .parameters = &.{"out"} }, .analysis = analysis(&result), .verify = true });
}

/// The LLVM IR a release build of `source` emits for target description `target`.
pub fn releaseLlvmTextFor(arena: std.mem.Allocator, source: []const u8, target: @import("target.zig").Target) Error![]u8 {
    var refusal: build.Refusal = .{};
    var module = try buildSource(arena, source, &refusal);
    const result = try runPasses(arena, &module, .trusted);
    const context: u8 = 0;
    const locator: emit_llvm.Locator = .{ .context = &context, .locate = firstLine };
    return emit_llvm.emitModule(arena, &module, .{ .locator = locator, .source_path = "test.my", .main = .{ .parameters = &.{ "args", "out" } }, .analysis = analysis(&result), .target = target });
}

// ---- hand-built IR ------------------------------------------------------------------

/// Builds one function's Core IR by hand, for tests of operations the builder
/// does not produce yet. Instructions go into the current block in order.
pub const Hand = struct {
    arena: std.mem.Allocator,
///   executable;
/// - `zig build test-core` runs the core's unit tests and its end-to-end slice,
///   which drive that `mylang`, split into `-Dcore-shards=N` concurrent shards of
///   one test binary (default 8; a `-Dtest-filter` run is one process); it returns
///   that step, which `zig build test` depends on.
fn addCore(b: *std.Build, inputs: CoreInputs) *std.Build.Step {
    const platform = b.createModule(.{ .root_source_file = b.path("src/config_core_tool_platform.zig") });
    // The test runner's frame and byte ceilings share the run budget rules.
    const budget = b.modules.get("memory_budget") orelse @panic("memory_budget module");
    const options = b.addOptions();
    options.addOptionPath("core_path", inputs.compiler.getEmittedBin());
    // The differential mode compared the slice with the retired old back end.
    options.addOption(bool, "differential", false);
    options.addOption([]const u8, "old_path", "");
    options.addOptionPath("clock_path", b.path("benchmarks/runtime/ports/native_clock.c"));
    const root = std.Io.Dir.cwd().realPathFileAlloc(b.graph.io, ".", b.allocator) catch @panic("build root");
    options.addOption([]const u8, "fixtures", b.pathJoin(&.{ root, "test", "core" }));
    options.addOption([]const u8, "lang_tests", b.pathJoin(&.{ root, "tests", "lang" }));
    const unit = b.addTest(.{ .max_rss = rss.compile, .filters = inputs.filters, .test_runner = inputs.test_runner, .root_module = b.createModule(.{
        .root_source_file = b.path("src/core/root_test.zig"),
        .target = inputs.target,
        .optimize = inputs.optimize,
        .imports = &.{.{ .name = "mylang", .module = inputs.front_end }},
    }) });
    unit.root_module.addImport("core_tool_platform", platform);
    unit.root_module.addImport("build_identity", inputs.identity);
    unit.root_module.addImport("memory_budget", budget);
    unit.root_module.addOptions("core_test_options", options);
    // The number-text helper's target and CPU are fixed (`-mcpu baseline`), so it is
    // compiled once here and embedded, rather than by `zig build-obj` on a guest
    // machine's first build that prints a number (NEW-CORE-S3-NUMBER-1).
    const number_text = b.addObject(.{ .name = "core_number_text", .max_rss = rss.compile, .root_module = b.createModule(.{
        .root_source_file = b.path("src/core/runtime/core_number_text.zig"),
        .target = b.resolveTargetQuery(std.Target.Query.parse(.{ .arch_os_abi = "x86_64-linux-gnu.2.31", .cpu_features = "baseline" }) catch @panic("number-text target")),
        .optimize = .ReleaseFast,
        .pic = true,
        .stack_check = false,
        .stack_protector = false,
        .link_libc = true,
    }) });
    // `mylang` runs the new core for every command that builds, runs or tests
    // code. Its commands live in `src/core/cli.zig`, a module of its own; the core
    // reaches the front end only as `mylang`.
    const cli = b.createModule(.{
        .root_source_file = b.path("src/core/cli.zig"),
        .target = inputs.target,
        .optimize = inputs.optimize,
        .imports = &.{ .{ .name = "mylang", .module = inputs.front_end }, .{ .name = "core_tool_platform", .module = platform }, .{ .name = "build_identity", .module = inputs.identity }, .{ .name = "memory_budget", .module = budget } },
    });
    inputs.compiler.root_module.addImport("mylang_core", cli);
    for ([_]*std.Build.Module{ unit.root_module, cli }) |module| {
        module.addAnonymousImport("core_number_text_object", .{ .root_source_file = number_text.getEmittedBin() });
    }
    const step = b.step("test-core", "Run the new core's unit tests and its end-to-end slice");
    // Most of the root's time is end-to-end builds of guest programs, so shards
    // of the one binary run concurrently; each test uses its own temporary tree.
    const requested = b.option(usize, "core-shards", "test-core: concurrent shards of the core test root (default 8)") orelse 8;
    const shards = if (inputs.filters.len == 0) @max(1, requested) else 1;
    for (0..shards) |index| {
        const run = b.addRunArtifact(unit);
        run.step.max_rss = rss.driver;
        run.has_side_effects = true;
        if (shards > 1) guardian.announceShard(run, index, shards);
        step.dependOn(&run.step);
    }
    return step;
