record Item:
    text: bytes
    number: int
def empty() -> Item:
    return Item(b"fallback", 5)
def pick(items: list[Item], index: int) -> Item:
    if index < 0:
        return empty()
    return items[index]
def selected(items: list[Item], index: int) -> int:
    saved = pick(items, -1)
    current = pick(items, index)
    return saved.number + current.number
def main(args: list[str]) -> int:
    index = 0
    number = 7
    if len(args) == 1:
        index = 2
    elif len(args) == 2:
        index = -1
    elif len(args) == 3:
        number = 9223372036854775807
    return selected([Item(b"live", number)], index)
