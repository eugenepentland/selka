record Item:
    text: bytes
    number: int
record Huge:
    text: bytes
    padding: [6000]int
    number: int
def pick(items: list[Huge], index: int) -> Item:
    current = items[index]
    return Item(current.text, current.number)
def scalar(items: list[Huge]) -> int:
    saved = pick(items, 0)
    second = pick(items, 1)
    return saved.number + second.number + int(saved.text[0]) + int(second.text[0])
