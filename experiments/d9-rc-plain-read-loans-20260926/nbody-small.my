# nbody: five bodies advanced 5,000,000 steps. Each body is a value `record`
# held in a `list[Body]` and updated in place through `bodies[i].field = ...`.
# See SUITE.md section 2.
#
# The constants are zero-argument functions because a module `const` may not
# have type `float` (E_CONSTANT_TYPE: constant types currently require builtin
# integers or bool).


record Body:
    x: float
    y: float
    z: float
    vx: float
    vy: float
    vz: float
    mass: float


def pi() -> float:
    return 3.141592653589793


def solar_mass() -> float:
    return 4.0 * pi() * pi()


def days_per_year() -> float:
    return 365.24


def initial_bodies() -> list[Body]:
    dpy = days_per_year()
    sm = solar_mass()
    return [
        Body(x=0.0, y=0.0, z=0.0, vx=0.0, vy=0.0, vz=0.0, mass=sm),
        Body(
            x=4.84143144246472090e+00,
            y=-1.16032004402742839e+00,
            z=-1.03622044471123109e-01,
            vx=1.66007664274403694e-03 * dpy,
            vy=7.69901118419740425e-03 * dpy,
            vz=-6.90460016972063023e-05 * dpy,
            mass=9.54791938424326609e-04 * sm,
        ),
        Body(
            x=8.34336671824457987e+00,
            y=4.12479856412430479e+00,
            z=-4.03523417114321381e-01,
            vx=-2.76742510726862411e-03 * dpy,
            vy=4.99852801234917238e-03 * dpy,
            vz=2.30417297573763929e-05 * dpy,
            mass=2.85885980666130812e-04 * sm,
        ),
        Body(
            x=1.28943695621391310e+01,
            y=-1.51111514016986312e+01,
            z=-2.23307578892655734e-01,
            vx=2.96460137564761618e-03 * dpy,
            vy=2.37847173959480950e-03 * dpy,
            vz=-2.96589568540237556e-05 * dpy,
            mass=4.36624404335156298e-05 * sm,
        ),
        Body(
            x=1.53796971148509165e+01,
            y=-2.59193146099879641e+01,
            z=1.79258772950371181e-01,
            vx=2.68067772490389322e-03 * dpy,
            vy=1.62824170038242295e-03 * dpy,
            vz=-9.51592254519715870e-05 * dpy,
            mass=5.15138902046611451e-05 * sm,
        ),
    ]


def offset_momentum(bodies: mut list[Body]) -> None:
    px = 0.0
    py = 0.0
    pz = 0.0
    for b in bodies:
        px = px + b.vx * b.mass
        py = py + b.vy * b.mass
        pz = pz + b.vz * b.mass
    bodies[0].vx = (0.0 - px) / solar_mass()
    bodies[0].vy = (0.0 - py) / solar_mass()
    bodies[0].vz = (0.0 - pz) / solar_mass()


def energy(bodies: list[Body]) -> float:
    e = 0.0
    n = len(bodies)
    for i in range(n):
        b = bodies[i]
        e = e + 0.5 * b.mass * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz)
        for j in range(i + 1, n):
            c = bodies[j]
            dx = b.x - c.x
            dy = b.y - c.y
            dz = b.z - c.z
            e = e - (b.mass * c.mass) / sqrt(dx * dx + dy * dy + dz * dz)
    return e


def advance(bodies: mut list[Body], dt: float) -> None:
    n = len(bodies)
    for i in range(n):
        for j in range(i + 1, n):
            dx = bodies[i].x - bodies[j].x
            dy = bodies[i].y - bodies[j].y
            dz = bodies[i].z - bodies[j].z
            d2 = dx * dx + dy * dy + dz * dz
            mag = dt / (d2 * sqrt(d2))
            bodies[i].vx = bodies[i].vx - dx * bodies[j].mass * mag
            bodies[i].vy = bodies[i].vy - dy * bodies[j].mass * mag
            bodies[i].vz = bodies[i].vz - dz * bodies[j].mass * mag
            bodies[j].vx = bodies[j].vx + dx * bodies[i].mass * mag
            bodies[j].vy = bodies[j].vy + dy * bodies[i].mass * mag
            bodies[j].vz = bodies[j].vz + dz * bodies[i].mass * mag
    for i in range(n):
        bodies[i].x = bodies[i].x + dt * bodies[i].vx
        bodies[i].y = bodies[i].y + dt * bodies[i].vy
        bodies[i].z = bodies[i].z + dt * bodies[i].vz


def main(out: Stream) -> int:
    steps = 10000
    dt = 0.01
    bodies = initial_bodies()
    offset_momentum(mut bodies)
    out.print(int(energy(bodies) * 1e9))
    for _ in range(steps):
        advance(mut bodies, dt)
    out.print(int(energy(bodies) * 1e9))
    return 0
