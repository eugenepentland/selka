module main;
import io;
import std_json;
import std_json_view as json_view;
import std_result as r;
import std_text;
import std_ascii;
import std_order;
import std_collections;
buffer Words: i64;
result Acquired {
    ok: Words,
    err: i64
}
result Status {
    ok: bool,
    err: i64
}
fn main(heap: allocator) -> i64 {
    match execute(heap) {
        Status.ok(discard) => {
            return 0;
        },
        Status.err(code) => {
            return code;
        }
    }
}
fn execute(heap: allocator) -> Status {
    match std_text::read(heap, 1048576) {
        std_json::Input.err(discard) => {
            discard std_text::emit("{\"error\":\"invalid-request\"}");
        },
        std_json::Input.ok(bytes) => {
            match std_json::parse(heap, bytes, 1048576) {
                std_json::Parsed.err(discard) => {
                    discard std_text::emit("{\"error\":\"invalid-request\"}");
                },
                std_json::Parsed.ok(document) => {
                    let mut work = try acquire_buffer<Acquired>(heap, 17536);
                    discard try resize_buffer<Status>(work, 17536, 0);
                    let empty = new std_order::Item {
                        value: 0,
                        first: 0u64,
                        first_len: 0u64,
                        second: 0u64,
                        second_len: 0u64
                    };
                    match std_collections::filled::< std_order::Item >(heap, 16384u64, empty) {
                        std_collections::Created<std_order::Item>.err(code) => {
                            return new Status.err(code);
                        },
                        std_collections::Created<std_order::Item>.ok(storage) => {
                            let mut sorting = storage;
                            borrow mut sorting[0..len_buffer(sorting)] as items {
                                borrow document[0..len_buffer(document)] as t {
                                    borrow mut work[0..len_buffer(work)] as w {
                                        discard request(t, w, items);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return new Status.ok(true);
}
// Checked schema helpers run to completion before board-level semantic phases.
fn identifier(t: &[]i64, node: json_view::Node) -> r::Result<bool, r::Error> {
    let size = try json_view::text_length(t, node);
    if size < 1 || size > 32 {
        return new r::Result<bool, r::Error>.ok(false);
    }
    let head = new std_ascii::Class {
        lower: true,
        upper: false,
        digit: false,
        underscore: false,
        hyphen: false
    };
    let tail = new std_ascii::Class {
        lower: true,
        upper: false,
        digit: true,
        underscore: true,
        hyphen: true
    };
    if !std_ascii::contains::< u8 >(head, try json_view::text_byte(t, node, 0)) {
        return new r::Result<bool, r::Error>.ok(false);
    }
    let mut i = 1;
    while i < size {
        if !std_ascii::contains::< u8 >(tail, try json_view::text_byte(t, node, i)) {
            return new r::Result<bool, r::Error>.ok(false);
        }
        i += 1;
    }
    return new r::Result<bool, r::Error>.ok(true);
}
fn object(t: &[]i64, node: json_view::Node, size: i64) -> r::Result<bool, r::Error> {
    return new r::Result<bool, r::Error>.ok(try json_view::kind(t, node) == new json_view::Kind.object && try json_view::count_between(t, node, size, size) == size);
}
fn array(t: &[]i64, node: json_view::Node, limit: i64) -> r::Result<json_view::Cursor, r::Error> {
    if try json_view::kind(t, node) != new json_view::Kind.array {
        return new r::Result<json_view::Cursor, r::Error>.err(new r::Error {
            category: new r::Category.wrong_type,
            code: 0
        });
    }
    discard try json_view::count_between(t, node, 0, limit);
    return json_view::children(t, node);
}
fn component_schema(t: &[]i64, node: json_view::Node) -> r::Result<bool, r::Error> {
    if !(try object(t, node, 6)) || !(try identifier(t, try json_view::required(t, node, "id"))) {
        return new r::Result<bool, r::Error>.ok(false);
    }
    discard try json_view::integer_between(t, try json_view::required(t, node, "x"), - 1000000, 1000000);
    discard try json_view::integer_between(t, try json_view::required(t, node, "y"), - 1000000, 1000000);
    discard try json_view::integer_between(t, try json_view::required(t, node, "width"), 1, 1000000);
    discard try json_view::integer_between(t, try json_view::required(t, node, "height"), 1, 1000000);
    let pins = try json_view::required(t, node, "pins");
    let mut cursor = try array(t, pins, 32);
    let mut index = 0;
    while !cursor.done {
        let pin = try json_view::current(t, cursor);
        if !(try identifier(t, pin)) {
            return new r::Result<bool, r::Error>.ok(false);
        }
        let mut previous = 0;
        while previous < index {
            let other = try json_view::at(t, pins, previous);
            if std_json::equal(t, pin.id, other.id) {
                return new r::Result<bool, r::Error>.ok(false);
            }
            previous += 1;
        }
        index += 1;
        cursor = try json_view::advance(t, cursor);
    }
    return new r::Result<bool, r::Error>.ok(true);
}
fn net_schema(t: &[]i64, node: json_view::Node) -> r::Result<bool, r::Error> {
    if !(try object(t, node, 2)) || !(try identifier(t, try json_view::required(t, node, "id"))) {
        return new r::Result<bool, r::Error>.ok(false);
    }
    let mut cursor = try array(t, try json_view::required(t, node, "members"), 128);
    while !cursor.done {
        let member_node = try json_view::current(t, cursor);
        if !(try object(t, member_node, 2)) || !(try identifier(t, try json_view::required(t, member_node, "component"))) || !(try identifier(t, try json_view::required(t, member_node, "pin"))) {
            return new r::Result<bool, r::Error>.ok(false);
        }
        cursor = try json_view::advance(t, cursor);
    }
    return new r::Result<bool, r::Error>.ok(true);
}
fn checked_schema(t: &[]i64, node: json_view::Node) -> r::Result<bool, r::Error> {
    if !(try object(t, node, 7)) {
        return new r::Result<bool, r::Error>.ok(false);
    }
    discard try json_view::integer_between(t, try json_view::required(t, node, "version"), 1, 1);
    let unit_node = try json_view::required(t, node, "unit");
    if !(try json_view::textis(t, unit_node, "um")) && !(try json_view::textis(t, unit_node, "mm")) {
        return new r::Result<bool, r::Error>.ok(false);
    }
    discard try json_view::integer_between(t, try json_view::required(t, node, "width"), 1, 1000000);
    discard try json_view::integer_between(t, try json_view::required(t, node, "height"), 1, 1000000);
    discard try json_view::integer_between(t, try json_view::required(t, node, "clearance"), 0, 1000000);
    let mut components = try array(t, try json_view::required(t, node, "components"), 128);
    let mut nets = try array(t, try json_view::required(t, node, "nets"), 128);
    while !components.done {
        if !(try component_schema(t, try json_view::current(t, components))) {
            return new r::Result<bool, r::Error>.ok(false);
        }
        components = try json_view::advance(t, components);
    }
    while !nets.done {
        if !(try net_schema(t, try json_view::current(t, nets))) {
            return new r::Result<bool, r::Error>.ok(false);
        }
        nets = try json_view::advance(t, nets);
    }
    return new r::Result<bool, r::Error>.ok(true);
}
fn schema(t: &[]i64, b: i64) -> bool {
    match checked_schema(t, new json_view::Node {
        id: b
    }) {
        r::Result<bool, r::Error>.ok(valid) => {
            return valid;
        },
        r::Result<bool, r::Error>.err(discard) => {
            return false;
        }
    }
}
fn sort(t: &[]i64, w: &mut []i64, items: &mut []std_order::Item, base: i64, size: i64, mode: i64) -> i64 {
    let mut i = 0;
    while i < size {
        let node = read_slice(w, base + i);
        let mut first = node;
        let mut second = 0;
        if mode == 0 {
            first = std_json::field(t, node, "id");
        }
        if mode == 1 {
            first = std_json::field(t, node, "component");
            second = std_json::field(t, node, "pin");
        }
        let start = std_json::get(t, first, 1);
        let next = std_json::get(t, second, 1);
        write_slice(items, i, new std_order::Item {
            value: node,
            first: u64(start),
            first_len: u64(std_json::get(t, first, 2) - start),
            second: u64(next),
            second_len: u64(std_json::get(t, second, 2) - next)
        });
        i += 1;
    }
    discard std_order::sort(t, items, 0u64, u64(size));
    i = 0;
    while i < size {
        write_slice(w, base + i, read_slice(items, i).value);
        i += 1;
    }
    return 0;
}
fn collect(t: &[]i64, w: &mut []i64, base: i64, a: i64) -> i64 {
    let mut n = a + 1;
    let mut i = 0;
    while n < std_json::get(t, a, 3) {
        write_slice(w, base + i, n);
        i += 1;
        n = std_json::get(t, n, 3);
    }
    return i;
}
fn quote(t: &[]i64, n: i64) -> i64 {
    discard io::put(34u8);
    discard rawid(t, n);
    discard io::put(34u8);
    return 0;
}
// Schema-validated ASCII identifiers are safe in both JSON and SVG attributes.
fn rawid(t: &[]i64, n: i64) -> i64 {
    let mut p = std_json::get(t, n, 1);
    let end = std_json::get(t, n, 2);
    while p < end {
        discard io::put(u8(read_slice(t, p)));
        p += 1;
    }
    return 0;
}
fn member(t: &[]i64, m: i64) -> i64 {
    discard std_text::emit("{\"component\":");
    discard quote(t, std_json::field(t, m, "component"));
    discard std_text::emit(",\"pin\":");
    discard quote(t, std_json::field(t, m, "pin"));
    discard io::put(125u8);
    return 0;
}
fn findcomponent(t: &[]i64, w: &[]i64, nc: i64, id: i64) -> i64 {
    let mut lo = 0;
    let mut hi = nc;
    while lo < hi {
        let mid =(lo + hi) / 2;
        let c = std_json::compare(t, std_json::field(t, read_slice(w, mid), "id"), id);
        if c < 0 {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo < nc && std_json::equal(t, std_json::field(t, read_slice(w, lo), "id"), id) {
        return read_slice(w, lo);
    }
    return 0;
}
fn known(t: &[]i64, w: &[]i64, nc: i64, m: i64) -> bool {
    let c = findcomponent(t, w, nc, std_json::field(t, m, "component"));
    if c == 0 {
        return false;
    }
    let pins = std_json::field(t, c, "pins");
    let mut p = pins + 1;
    while p < std_json::get(t, pins, 3) {
        if std_json::equal(t, p, std_json::field(t, m, "pin")) {
            return true;
        }
        p += 1;
    }
    return false;
}
fn haspin(t: &[]i64, w: &[]i64, nr: i64, c: i64, p: i64) -> bool {
    let mut lo = 0;
    let mut hi = nr;
    while lo < hi {
        let mid =(lo + hi) / 2;
        let m = read_slice(w, 256 + mid);
        let mut cmp = std_json::compare(t, std_json::field(t, m, "component"), c);
        if cmp == 0 {
            cmp = std_json::compare(t, std_json::field(t, m, "pin"), p);
        }
        if cmp < 0 {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo >= nr {
        return false;
    }
    let m = read_slice(w, 256 + lo);
    return std_json::equal(t, std_json::field(t, m, "component"), c) && std_json::equal(t, std_json::field(t, m, "pin"), p);
}
fn distance(t: &[]i64, n: i64, key: &[]u8, mul: i64) -> i64 {
    return std_json::get(t, std_json::field(t, n, key), 5) * mul;
}
fn min(a: i64, b: i64) -> i64 {
    if a < b {
        return a;
    }
    return b;
}
fn max(a: i64, b: i64) -> i64 {
    if a > b {
        return a;
    }
    return b;
}
fn finding(t: &[]i64, code: i64, a: i64, b: i64, first: bool) -> i64 {
    if !first {
        discard io::put(44u8);
    }
    discard std_text::emit("{\"code\":\"");
    if code == 0 {
        discard std_text::emit("clearance");
    }
    if code == 1 {
        discard std_text::emit("outside-board");
    }
    if code == 2 {
        discard std_text::emit("unconnected-pin");
    }
    if code == 3 {
        discard std_text::emit("underconnected-net");
    }
    discard std_text::emit("\",\"subjects\":[");
    discard quote(t, a);
    if b != 0 {
        discard io::put(44u8);
        discard quote(t, b);
    }
    discard std_text::emit("]}");
    return 0;
}
fn board(t: &[]i64, w: &mut []i64, items: &mut []std_order::Item, b: i64) -> i64 {
    if !schema(t, b) {
        discard std_text::emit("{\"error\":\"invalid-board\"}");
        return 0;
    }
    let nc = collect(t, w, 0, std_json::field(t, b, "components"));
    let nn = collect(t, w, 128, std_json::field(t, b, "nets"));
    discard sort(t, w, items, 0, nc, 0);
    discard sort(t, w, items, 128, nn, 0);
    let mut duplicate = false;
    let mut i = 1;
    while i < nc {
        if nodecmp(t, read_slice(w, i - 1), read_slice(w, i), 0) == 0 {
            duplicate = true;
        }
        i += 1;
    }
    i = 1;
    while i < nn {
        if nodecmp(t, read_slice(w, 128 + i - 1), read_slice(w, 128 + i), 0) == 0 {
            duplicate = true;
        }
        i += 1;
    }
    if duplicate {
        discard std_text::emit("{\"error\":\"duplicate-id\",\"components\":[");
        let mut ns = 0;
        while ns < 2 {
            let mut base = 0;
            let mut count = nc;
            if ns == 1 {
                base = 128;
                count = nn;
            }
            let mut first = true;
            i = 1;
            while i < count {
                let current = read_slice(w, base + i);
                if nodecmp(t, current, read_slice(w, base + i - 1), 0) == 0 &&(i == 1 || nodecmp(t, current, read_slice(w, base + i - 2), 0) != 0) {
                    if !first {
                        discard io::put(44u8);
                    }
                    discard quote(t, std_json::field(t, current, "id"));
                    first = false;
                }
                i += 1;
            }
            if ns == 0 {
                discard std_text::emit("],\"nets\":[");
            }
            ns += 1;
        }
        discard std_text::emit("]}");
        return 0;
    }
    let mut nr = 0;
    i = 0;
    while i < nn {
        nr += collect(t, w, 256 + nr, std_json::field(t, read_slice(w, 128 + i), "members"));
        i += 1;
    }
    discard sort(t, w, items, 256, nr, 1);
    let mut unknown = false;
    let mut reused = false;
    i = 0;
    while i < nr {
        let m = read_slice(w, 256 + i);
        if !known(t, w, nc, m) {
            unknown = true;
        }
        if i > 0 && nodecmp(t, m, read_slice(w, 255 + i), 1) == 0 {
            reused = true;
        }
        i += 1;
    }
    if unknown || reused {
        if unknown {
            discard std_text::emit("{\"error\":\"unknown-pin\",\"refs\":[");
        } else {
            discard std_text::emit("{\"error\":\"reused-pin\",\"refs\":[");
        }
        let mut first = true;
        i = 0;
        while i < nr {
            let m = read_slice(w, 256 + i);
            let distinct = i == 0 || nodecmp(t, m, read_slice(w, 255 + i), 1) != 0;
            let mut report = false;
            if unknown {
                report = !known(t, w, nc, m);
            } else {
                report = i + 1 < nr && nodecmp(t, m, read_slice(w, 257 + i), 1) == 0;
            }
            if distinct && report {
                if !first {
                    discard io::put(44u8);
                }
                discard member(t, m);
                first = false;
            }
            i += 1;
        }
        discard std_text::emit("]}");
        return 0;
    }
    let mut mul = 1;
    let mm = "mm";
    borrow mm[0..len(mm)] as s {
        if std_json::textis(t, std_json::field(t, b, "unit"), s) {
            mul = 1000;
        }
    }
    let width = distance(t, b, "width", mul);
    let height = distance(t, b, "height", mul);
    let clearance = distance(t, b, "clearance", mul);
    // Cache normalized rectangles once, before the quadratic pair scan.
    i = 0;
    while i < nc {
        let component_node = read_slice(w, i);
        let base = 16768 + i * 6;
        let px = distance(t, component_node, "x", mul);
        let py = distance(t, component_node, "y", mul);
        write_slice(w, base, px);
        write_slice(w, base + 1, py);
        write_slice(w, base + 2, px + distance(t, component_node, "width", mul));
        write_slice(w, base + 3, py + distance(t, component_node, "height", mul));
        write_slice(w, base + 4, std_json::field(t, component_node, "id"));
        i += 1;
    }
    discard std_text::emit("{\"unit\":\"um\",\"findings\":[");
    let mut first = true;
    i = 0;
    while i < nc {
        let base = 16768 + i * 6;
        let id = read_slice(w, base + 4);
        let x = read_slice(w, base);
        let y = read_slice(w, base + 1);
        let xe = read_slice(w, base + 2);
        let ye = read_slice(w, base + 3);
        let mut j = i + 1;
        while j < nc {
            let other = 16768 + j * 6;
            let dx = read_slice(w, other);
            let dy = read_slice(w, other + 1);
            let dxe = read_slice(w, other + 2);
            let dye = read_slice(w, other + 3);
            let gx = max(0, max(x - dxe, dx - xe));
            let gy = max(0, max(y - dye, dy - ye));
            // Equality passes; positive-area overlap still fails at zero clearance.
            if gx * gx + gy * gy < clearance * clearance || (min(xe, dxe) > max(x, dx) && min(ye, dye) > max(y, dy)) {
                discard finding(t, 0, id, read_slice(w, other + 4), first);
                first = false;
            }
            j += 1;
        }
        i += 1;
    }
    i = 0;
    while i < nc {
        let c = read_slice(w, i);
        let x = distance(t, c, "x", mul);
        let y = distance(t, c, "y", mul);
        if x < 0 || y < 0 || x + distance(t, c, "width", mul) > width || y + distance(t, c, "height", mul) > height {
            discard finding(t, 1, std_json::field(t, c, "id"), 0, first);
            first = false;
        }
        i += 1;
    }
    i = 0;
    while i < nc {
        let c = read_slice(w, i);
        let id = std_json::field(t, c, "id");
        let np = collect(t, w, 16640, std_json::field(t, c, "pins"));
        discard sort(t, w, items, 16640, np, 2);
        let mut j = 0;
        while j < np {
            let p = read_slice(w, 16640 + j);
            if !haspin(t, w, nr, id, p) {
                discard finding(t, 2, id, p, first);
                first = false;
            }
            j += 1;
        }
        i += 1;
    }
    i = 0;
    while i < nn {
        let net = read_slice(w, 128 + i);
        if std_json::get(t, std_json::field(t, net, "members"), 4) < 2 {
            discard finding(t, 3, std_json::field(t, net, "id"), 0, first);
            first = false;
        }
        i += 1;
    }
    discard std_text::emit("],\"nets\":[");
    i = 0;
    while i < nn {
        let net = read_slice(w, 128 + i);
        if i > 0 {
            discard io::put(44u8);
        }
        discard std_text::emit("{\"id\":");
        discard quote(t, std_json::field(t, net, "id"));
        discard std_text::emit(",\"members\":[");
        let nm = collect(t, w, 16640, std_json::field(t, net, "members"));
        discard sort(t, w, items, 16640, nm, 1);
        let mut lx = 0;
        let mut hx = 0;
        let mut ly = 0;
        let mut hy = 0;
        let mut j = 0;
        while j < nm {
            let ref = read_slice(w, 16640 + j);
            if j > 0 {
                discard io::put(44u8);
            }
            discard member(t, ref);
            let c = findcomponent(t, w, nc, std_json::field(t, ref, "component"));
            let x = 2 * distance(t, c, "x", mul) + distance(t, c, "width", mul);
            let y = 2 * distance(t, c, "y", mul) + distance(t, c, "height", mul);
            if j == 0 {
                lx = x;
                hx = x;
                ly = y;
                hy = y;
            } else {
                lx = min(lx, x);
                hx = max(hx, x);
                ly = min(ly, y);
                hy = max(hy, y);
            }
            j += 1;
        }
        discard std_text::emit("],\"span\":");
        discard std_text::number((hx - lx + hy - ly + 1) / 2);
        discard io::put(125u8);
        i += 1;
    }
    discard std_text::emit("],\"svg\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 ");
    discard std_text::number(width);
    discard io::put(32u8);
    discard std_text::number(height);
    discard std_text::emit("\\\"><rect x=\\\"0\\\" y=\\\"0\\\" width=\\\"");
    discard std_text::number(width);
    discard std_text::emit("\\\" height=\\\"");
    discard std_text::number(height);
    discard std_text::emit("\\\" fill=\\\"white\\\" stroke=\\\"black\\\"/>");
    i = 0;
    while i < nc {
        let c = read_slice(w, i);
        discard std_text::emit("<rect id=\\\"");
        discard rawid(t, std_json::field(t, c, "id"));
        discard std_text::emit("\\\" x=\\\"");
        discard std_text::number(distance(t, c, "x", mul));
        discard std_text::emit("\\\" y=\\\"");
        discard std_text::number(distance(t, c, "y", mul));
        discard std_text::emit("\\\" width=\\\"");
        discard std_text::number(distance(t, c, "width", mul));
        discard std_text::emit("\\\" height=\\\"");
        discard std_text::number(distance(t, c, "height", mul));
        discard std_text::emit("\\\" fill=\\\"none\\\" stroke=\\\"black\\\"/>");
        i += 1;
    }
    discard std_text::emit("</svg>\"}");
    return 0;
}
fn envelope(t: &[]i64) -> r::Result<json_view::Cursor, r::Error> {
    let root = try json_view::root(t);
    if !(try object(t, root, 1)) {
        return new r::Result<json_view::Cursor, r::Error>.err(new r::Error {
            category: new r::Category.wrong_type,
            code: 0
        });
    }
    return array(t, try json_view::required(t, root, "cases"), 64);
}
fn checked_request(t: &[]i64, w: &mut []i64, items: &mut []std_order::Item, cases: json_view::Cursor) -> r::Result<i64, r::Error> {
    discard std_text::emit("{\"results\":[");
    let mut cursor = cases;
    let mut first = true;
    while !cursor.done {
        if !first {
            discard io::put(44u8);
        }
        let case_node = try json_view::current(t, cursor);
        discard board(t, w, items, case_node.id);
        first = false;
        cursor = try json_view::advance(t, cursor);
    }
    discard std_text::emit("]}");
    return new r::Result<i64, r::Error>.ok(0);
}
fn request(t: &[]i64, w: &mut []i64, items: &mut []std_order::Item) -> i64 {
    match envelope(t) {
        r::Result<json_view::Cursor, r::Error>.err(discard) => {
            discard std_text::emit("{\"error\":\"invalid-request\"}");
            return 0;
        },
        r::Result<json_view::Cursor, r::Error>.ok(cases) => {
            match checked_request(t, w, items, cases) {
                r::Result<i64, r::Error>.ok(answer) => {
                    return answer;
                },
                r::Result<i64, r::Error>.err(discard) => {
                    return 1;
                }
            }
        }
    }
}
// IEEE binary64 overflow midpoint: 2^1024 - 2^970. Compare the normalized
// decimal significand exactly; truncation to 17 digits misclassifies neighbors.
fn nodecmp(t: &[]i64, a: i64, b: i64, mode: i64) -> i64 {
    if mode == 0 {
        return std_json::compare(t, std_json::field(t, a, "id"), std_json::field(t, b, "id"));
    }
    if mode == 2 {
        return std_json::compare(t, a, b);
    }
    let first = std_json::compare(t, std_json::field(t, a, "component"), std_json::field(t, b, "component"));
    if first != 0 {
        return first;
    }
    return std_json::compare(t, std_json::field(t, a, "pin"), std_json::field(t, b, "pin"));
}
