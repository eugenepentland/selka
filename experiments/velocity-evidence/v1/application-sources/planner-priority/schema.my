module schema;
import json;
import std_json;
import std_json_view;
import std_result;
export field;
export count;
export manifest;
export envelope;
type Checked = std_result::Result<i64, std_result::Error>;
type Predicate = std_result::Result<bool, std_result::Error>;
// After schema validation, graph queries use these small tape adapters.
fn field(t: &[]i64, p: i64, name: &[]u8) -> i64 {
    return std_json::field(t, p, name);
}
fn count(t: &[]i64, p: i64) -> i64 {
    return std_json::get(t, p, 4);
}
fn object(t: &[]i64, p: std_json_view::Node, fields: i64) -> Predicate {
    return new Predicate.ok(try std_json_view::kind(t, p) == new std_json_view::Kind.object && try std_json_view::count_between(t, p, fields, fields) == fields);
}
fn array(t: &[]i64, p: std_json_view::Node, maximum: i64) -> Predicate {
    return new Predicate.ok(try std_json_view::kind(t, p) == new std_json_view::Kind.array && try std_json_view::count_between(t, p, 0, maximum) >= 0);
}
fn envelope(t: &[]i64, p: i64) -> i64 {
    match checked_envelope(t, new std_json_view::Node {
        id: p
    }) {
        Checked.ok(a) => {
            return a;
        },
        Checked.err(discard) => {
            return - 1;
        }
    }
}
fn checked_envelope(t: &[]i64, p: std_json_view::Node) -> Checked {
    if !try object(t, p, 1) {
        return new Checked.ok(- 1);
    }
    let cases = try std_json_view::required(t, p, "cases");
    if !try array(t, cases, 64) {
        return new Checked.ok(- 1);
    }
    return new Checked.ok(cases.id);
}
fn manifest(t: &[]i64, p: i64) -> i64 {
    match checked_manifest(t, new std_json_view::Node {
        id: p
    }) {
        Checked.ok(a) => {
            return a;
        },
        Checked.err(discard) => {
            return - 1;
        }
    }
}
fn checked_manifest(t: &[]i64, p: std_json_view::Node) -> Checked {
    if !try object(t, p, 2) {
        return new Checked.ok(- 1);
    }
    let version = try std_json_view::required(t, p, "version");
    discard try std_json_view::integer_between(t, version, 1, 1);
    let jobs = try std_json_view::required(t, p, "jobs");
    if !try array(t, jobs, 128) {
        return new Checked.ok(- 1);
    }
    let mut cursor = try std_json_view::children(t, jobs);
    while !cursor.done {
        let job = try std_json_view::current(t, cursor);
        if try std_json_view::kind(t, job) != new std_json_view::Kind.object {
            return new Checked.ok(- 1);
        }
        let names = new [4]std_json_view::Name[
            new std_json_view::Name {start: 0u64, end: 2u64},
            new std_json_view::Name {start: 2u64, end: 10u64},
            new std_json_view::Name {start: 10u64, end: 15u64},
            new std_json_view::Name {start: 15u64, end: 23u64}
        ];
        borrow names[..] as allowed {
            if !try std_json_view::only_fields(t, job, "iddurationneedspriority", allowed) {
                return new Checked.ok(- 1);
            }
        }
        let priority = try std_json_view::integer_or(t, job, "priority", 0);
        if priority < -1000 || priority > 1000 {
            return new Checked.ok(- 1);
        }
        let id = try std_json_view::required(t, job, "id");
        let duration = try std_json_view::required(t, job, "duration");
        let needs = try std_json_view::required(t, job, "needs");
        if !json::identifier(t, id.id) {
            return new Checked.ok(- 1);
        }
        discard try std_json_view::integer_between(t, duration, 0, 1000000);
        if !try array(t, needs, 128) {
            return new Checked.ok(- 1);
        }
        let mut dependencies = try std_json_view::children(t, needs);
        while !dependencies.done {
            let dependency = try std_json_view::current(t, dependencies);
            if !json::identifier(t, dependency.id) {
                return new Checked.ok(- 1);
            }
            dependencies = try std_json_view::advance(t, dependencies);
        }
        cursor = try std_json_view::advance(t, cursor);
    }
    return new Checked.ok(jobs.id);
}
