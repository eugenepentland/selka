module planner;
import json;
import schema;
import output;
import std_collections;
import std_graph;
import std_math;
export run;
struct Job {
    duration: i64,
    priority: i64,
    needs: i64,
    finish: i64
}
result Outcome {
    ok: i64,
    err: i64
}
// IDs are JSON string nodes; borrowed document context supplies their ordering.
fn before(t: &[]i64, left: i64, right: i64) -> bool effects() {
    return json::less(t, left, right);
}
fn sort(t: &[]i64, a: &mut []i64, n: i64) -> i64 {
    borrow mut a[0..n] as items {
        discard std_collections::sort_by::< i64,
        i64 >(items, t, before);
    }
    return 0;
}
fn emit(t: &[]i64, a: &[]i64, n: i64) -> i64 {
    let mut i = 0;
    let mut prev = - 1;
    while i < n {
        let v = read_slice(a, i);
        if prev < 0 || !json::equal(t, prev, v) {
            if prev >= 0 {
                discard output::comma();
            }
            discard json::quoted(t, v);
            prev = v;
        }
        i += 1;
    }
    discard output::close();
    return 0;
}
fn lookup(t: &[]i64, ids: &[]i64, n: i64, p: i64) -> i64 {
    borrow ids[0..n] as keys {
        let at = std_collections::lower_bound_by::< i64,
        i64 >(keys, t, p, before);
        if at < u64(n) && json::equal(t, read_slice(keys, at), p) {
            return i64(at);
        }
    }
    return - 1;
}
// Called only after the complete schema phase has checked the optional integer.
fn priority(t: &[]i64, job: i64) -> i64 {
    let node = schema::field(t, job, "priority");
    if node == 0 {
        return 0;
    }
    return json::integer(t, node);
}
// Resolve application identifier dependencies into reusable graph edges.
fn graph(t: &[]i64, ids: &[]i64, jobs: &[]Job, n: i64, edges: &mut []std_graph::Edge) -> i64 {
    let mut i = 0;
    let mut at = 0u64;
    while i < n {
        let mut p = read_slice(jobs, i).needs + 1;
        while p < json::next(t, read_slice(jobs, i).needs) {
            write_slice(edges, at, new std_graph::Edge {
                from: u64(lookup(t, ids, n, p)),
                to: u64(i)
            });
            at += 1u64;
            p = json::next(t, p);
        }
        i += 1;
    }
    return 0;
}
fn edge_count(t: &[]i64, jobs: i64) -> u64 {
    let mut count = 0u64;
    let mut p = jobs + 1;
    while p < json::next(t, jobs) {
        count += u64(schema::count(t, schema::field(t, p, "needs")));
        p = json::next(t, p);
    }
    return count;
}
// Complete each validation phase before emitting a result.
fn work(t: &[]i64, a: i64, ids: &mut []i64, jobs: &mut []Job, done: &mut []i64, unknown: &mut []i64, scratch: &mut []i64, edges: &mut []std_graph::Edge) -> i64 {
    let n = schema::count(t, a);
    let mut p = a + 1;
    let mut i = 0;
    while i < n {
        let v = schema::field(t, p, "id");
        write_slice(ids, i, v);
        p = json::next(t, p);
        i += 1;
    }
    discard sort(t, ids, n);
    let mut repeated = 0;
    i = 1;
    while i < n {
        if json::equal(t, read_slice(ids, i - 1), read_slice(ids, i)) {
            write_slice(unknown, repeated, read_slice(ids, i));
            repeated += 1;
        }
        i += 1;
    }
    if repeated > 0 {
        discard output::dup_id();
        return emit(t, unknown, repeated);
    }
    p = a + 1;
    while p < json::next(t, a) {
        let j = lookup(t, ids, n, schema::field(t, p, "id"));
        write_slice(jobs, j, new Job {
            duration: json::integer(t, schema::field(t, p, "duration")),
            priority: priority(t, p),
            needs: schema::field(t, p, "needs"),
            finish: 0
        });
        p = json::next(t, p);
    }
    i = 0;
    while i < n {
        let mut x = read_slice(jobs, i).needs + 1;
        let mut count = 0;
        while x < json::next(t, read_slice(jobs, i).needs) {
            write_slice(scratch, count, x);
            count += 1;
            x = json::next(t, x);
        }
        discard sort(t, scratch, count);
        let mut j = 1;
        while j < count {
            if json::equal(t, read_slice(scratch, j - 1), read_slice(scratch, j)) {
                write_slice(done, i, 1);
            }
            j += 1;
        }
        i += 1;
    }
    i = 0;
    while i < n {
        if read_slice(done, i) == 1 {
            write_slice(unknown, repeated, read_slice(ids, i));
            repeated += 1;
            write_slice(done, i, 0);
        }
        i += 1;
    }
    if repeated > 0 {
        discard output::dup_dep();
        return emit(t, unknown, repeated);
    }
    i = 0;
    while i < n {
        let mut x = read_slice(jobs, i).needs + 1;
        while x < json::next(t, read_slice(jobs, i).needs) {
            if lookup(t, ids, n, x) < 0 {
                write_slice(unknown, repeated, x);
                repeated += 1;
            }
            x = json::next(t, x);
        }
        i += 1;
    }
    if repeated > 0 {
        discard sort(t, unknown, repeated);
        discard output::unknown();
        return emit(t, unknown, repeated);
    }
    discard graph(t, ids, jobs, n, edges);
    discard std_graph::prepare(done, edges);
    let mut removed = 0;
    let mut progress = true;
    while progress {
        progress = false;
        i = 0;
        while i < n {
            if std_graph::ready(done, u64(i)) {
                discard std_graph::take_ready(done, u64(i));
                discard std_graph::complete(done, edges, u64(i));
                removed += 1;
                progress = true;
            }
            i += 1;
        }
    }
    if removed < n {
        i = 0;
        while i < n {
            if read_slice(done, i) != - 1 {
                write_slice(unknown, repeated, read_slice(ids, i));
                repeated += 1;
            }
            i += 1;
        }
        discard output::cycle();
        return emit(t, unknown, repeated);
    }
    discard std_graph::prepare(done, edges);
    discard output::order();
    removed = 0;
    while removed < n {
        let mut chosen = - 1;
        i = 0;
        // IDs are ascending: retain the first candidate on equal priority.
        // Reconsider every ready job after each completion releases dependencies.
        while i < n {
            if std_graph::ready(done, u64(i)) {
                if chosen < 0 || read_slice(jobs, i).priority > read_slice(jobs, chosen).priority {
                    chosen = i;
                }
            }
            i += 1;
        }
        if removed > 0 {
            discard output::comma();
        }
        discard json::quoted(t, read_slice(ids, chosen));
        let mut start = 0;
        let mut d = read_slice(jobs, chosen).needs + 1;
        while d < json::next(t, read_slice(jobs, chosen).needs) {
            let f = read_slice(jobs, lookup(t, ids, n, d)).finish;
            start = std_math::max::< i64 >(start, f);
            d = json::next(t, d);
        }
        write_slice(jobs, chosen, update(read_slice(jobs, chosen)) {
            finish: start + read_slice(jobs, chosen).duration
        });
        discard std_graph::take_ready(done, u64(chosen));
        discard std_graph::complete(done, edges, u64(chosen));
        removed += 1;
    }
    discard output::layers();
    discard std_graph::prepare(done, edges);
    removed = 0;
    let mut rounds = 0;
    while removed < n {
        if rounds > 0 {
            discard output::comma();
        }
        discard output::open();
        let mut count = 0;
        i = 0;
        while i < n {
            if std_graph::ready(done, u64(i)) {
                write_slice(unknown, count, i);
                count += 1;
            }
            i += 1;
        }
        i = 0;
        while i < count {
            if i > 0 {
                discard output::comma();
            }
            let j = read_slice(unknown, i);
            discard json::quoted(t, read_slice(ids, j));
            discard std_graph::take_ready(done, u64(j));
            discard std_graph::complete(done, edges, u64(j));
            i += 1;
        }
        removed += count;
        rounds += 1;
        discard output::shut();
    }
    discard output::timings();
    let mut makespan = 0;
    i = 0;
    while i < n {
        if i > 0 {
            discard output::comma();
        }
        discard output::id();
        discard json::quoted(t, read_slice(ids, i));
        discard output::start();
        let f = read_slice(jobs, i).finish;
        discard json::number(f - read_slice(jobs, i).duration);
        discard output::finish();
        discard json::number(f);
        discard output::brace();
        makespan = std_math::max::< i64 >(makespan, f);
        i += 1;
    }
    discard output::makespan();
    discard json::number(makespan);
    discard output::brace();
    return 0;
}
// Owned buffers keep mutable scratch writes proportional to the changed element.
fn run(heap: allocator, t: &[]i64, p: i64) -> i64 {
    let a = schema::manifest(t, p);
    if a < 0 {
        return output::invalid_manifest();
    }
    match storage(t, heap, a) {
        Outcome.ok(value) => {
            return value;
        },
        Outcome.err(discard) => {
            return 1;
        }
    }
}
fn storage(t: &[]i64, heap: allocator, a: i64) -> Outcome {
    let mut ids = try std_collections::filled::< i64 >(heap, 128u64, 0);
    let mut jobs = try std_collections::filled::< Job >(heap, 128u64, new Job {
        duration: 0,
        priority: 0,
        needs: 0,
        finish: 0
    });
    let mut done = try std_collections::filled::< i64 >(heap, u64(schema::count(t, a)), 0);
    let mut unknown = try std_collections::filled::< i64 >(heap, 16384u64, 0);
    let mut scratch = try std_collections::filled::< i64 >(heap, 128u64, 0);
    let mut edges = try std_collections::filled::< std_graph::Edge >(heap, edge_count(t, a), new std_graph::Edge {
        from: 0u64,
        to: 0u64
    });
    borrow mut edges[..] as edges_view,
    mut ids[..] as ids_view,
    mut jobs[..] as jobs_view,
    mut done[..] as done_view,
    mut unknown[..] as unknown_view,
    mut scratch[..] as scratch_view {
        return new Outcome.ok(work(t, a, ids_view, jobs_view, done_view, unknown_view, scratch_view, edges_view));
    }
}
