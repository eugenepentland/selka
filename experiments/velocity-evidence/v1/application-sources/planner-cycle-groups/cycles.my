module cycles;
import json;
import output;
import std_graph;
import std_math;
export emit;

// Iterative Tarjan traversal on the reversed dependency graph. Graph edges
// are contiguous by dependent (to), so each DFS vertex visits its needs once.
// Each vertex uses seven scratch words: index, lowlink, cursor, end, parent,
// on-stack flag, and component. The separate stack holds active vertices.
fn get(state: &[]i64, node: i64, field: i64) -> i64 {
    return read_slice(state, node * 7 + field);
}
fn put(state: &mut []i64, node: i64, field: i64, value: i64) -> i64 {
    write_slice(state, node * 7 + field, value);
    return 0;
}
fn discover(state: &mut []i64, stack: &mut []i64, node: i64, index: i64, top: i64, parent: i64) -> i64 {
    discard put(state, node, 0, index);
    discard put(state, node, 1, index);
    discard put(state, node, 4, parent);
    discard put(state, node, 5, 1);
    write_slice(stack, top, node);
    return 0;
}
fn components(edges: &[]std_graph::Edge, stack: &mut []i64, state: &mut []i64, n: i64) -> i64 {
    let mut edge = 0;
    let mut i = 0;
    while i < n {
        discard put(state, i, 0, -1);
        discard put(state, i, 2, edge);
        while edge < i64(len_slice(edges)) && read_slice(edges, edge).to == u64(i) {
            edge += 1;
        }
        discard put(state, i, 3, edge);
        discard put(state, i, 5, 0);
        discard put(state, i, 6, -1);
        i += 1;
    }
    let mut index = 0;
    let mut top = 0;
    let mut root = 0;
    while root < n {
        if get(state, root, 0) < 0 {
            discard discover(state, stack, root, index, top, -1);
            index += 1;
            top += 1;
            let mut current = root;
            while current >= 0 {
                let cursor = get(state, current, 2);
                if cursor < get(state, current, 3) {
                    let target = i64(read_slice(edges, cursor).from);
                    discard put(state, current, 2, cursor + 1);
                    if get(state, target, 0) < 0 {
                        discard discover(state, stack, target, index, top, current);
                        index += 1;
                        top += 1;
                        current = target;
                    } else {
                        if get(state, target, 5) == 1 {
                            discard put(state, current, 1, std_math::min::<i64>(get(state, current, 1), get(state, target, 0)));
                        }
                    }
                } else {
                    if get(state, current, 1) == get(state, current, 0) {
                        let mut popped = -1;
                        while popped != current {
                            top -= 1;
                            popped = read_slice(stack, top);
                            discard put(state, popped, 5, 0);
                            discard put(state, popped, 6, current);
                        }
                    }
                    let parent = get(state, current, 4);
                    if parent >= 0 {
                        discard put(state, parent, 1, std_math::min::<i64>(get(state, parent, 1), get(state, current, 1)));
                    }
                    current = parent;
                }
            }
        }
        root += 1;
    }
    return 0;
}
// IDs already have ASCII order. Visiting each component at its first member
// sorts groups lexicographically, and scanning members preserves their order.
fn emit(t: &[]i64, ids: &[]i64, edges: &[]std_graph::Edge, stack: &mut []i64, state: &mut []i64, n: i64) -> i64 {
    discard components(edges, stack, state, n);
    discard json::text("],\"cycles\":[");
    let mut groups = 0;
    let mut i = 0;
    while i < n {
        let component = get(state, i, 6);
        let mut first = n;
        let mut count = 0;
        let mut j = 0;
        while j < n {
            if get(state, j, 6) == component {
                first = std_math::min::<i64>(first, j);
                count += 1;
            }
            j += 1;
        }
        let mut cyclic = count > 1;
        if count == 1 {
            let mut e = 0u64;
            while e < len_slice(edges) {
                let edge = read_slice(edges, e);
                if edge.from == u64(i) && edge.to == u64(i) {
                    cyclic = true;
                }
                e += 1u64;
            }
        }
        if first == i && cyclic {
            if groups > 0 { discard output::comma(); }
            discard output::open();
            let mut members = 0;
            j = 0;
            while j < n {
                if get(state, j, 6) == component {
                    if members > 0 { discard output::comma(); }
                    discard json::quoted(t, read_slice(ids, j));
                    members += 1;
                }
                j += 1;
            }
            discard output::shut();
            groups += 1;
        }
        i += 1;
    }
    return output::close();
}
