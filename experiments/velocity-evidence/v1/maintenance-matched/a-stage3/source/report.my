module report;
import ledger;
import model;
export score;
fn score(heap: allocator, input: [4]i64, floor: i64, ceiling: i64) -> i64 {
    match ledger::summarize(heap, input, floor, ceiling) {
        model::Answer.ok(reply) => { return reply.net * 100 + cast<i64>(reply.accepted) * 10 + cast<i64>(reply.rejected); },
        model::Answer.err(code) => { return -9000000 + code; }
    }
}
