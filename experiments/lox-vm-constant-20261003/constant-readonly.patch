+# Every constant operand byte, including 255, must advance IP before the
+# checked pool read; consecutive prints then keep the following opcode aligned.
+public def test_run_constant_operand_last_byte(out: Stream) -> bool:
+    source = b""
+    expected = b""
+    i = 0
+    while i < 256:
+        text = str(i).encode()
+        source = source + b"print " + text + b";"
+        expected = expected + text + b"\n"
+        i = i + 1
+    observed = driver.run_source(source, driver.Engine.VM, True, out, None)
+    return observed.status == 0 and observed.stdout == expected and observed.stderr == b"" and observed.collections == observed.allocations
