module ledger;
import model;
export summarize;
fn append<T: copy>(values: &mut model::Vec<T>, value: T) -> model::Status noalloc {
    return append_buffer<model::Status>(values, value);
}
fn summarize(heap: allocator, input: [4]i64, floor: i64, ceiling: i64) -> model::Answer {
    let mut values = try acquire_buffer<model::Open<i64>>(heap, 4);
    borrow mut values as view {
        let mut i = 0u64;
        while i < 4u64 {
            discard try append::<i64>(view, input[i]);
            i += 1u64;
        }
    }
    let mut net = 0;
    let mut accepted = 0u64;
    let mut i = 0u64;
    while i < 4u64 {
        let n = read_buffer(values, i);
        if n >= floor {
            if n > ceiling { net += ceiling; } else { net += n; }
            accepted += 1u64;
        }
        i += 1u64;
    }
    return new model::Answer.ok(new model::Reply { net: net, accepted: accepted, rejected: 4u64 - accepted });
}
