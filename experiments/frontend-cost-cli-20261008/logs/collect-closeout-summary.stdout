map(one, jobs):         print(r[0], r[1], r[2], \"TIMEOUT\" if r[3] is None else f\"{r[3]:.2f}\", r[4], r[5], flush=True) EOF ls bench/expected | head -4; /home/epentland/ai/canopy/mylang-worktrees/claude-bench-newcore/scripts/build-slot.sh build -- python3 .tmp/timed/feasible.py $PWD 150 2>&1 | grep -v \"^build-slot\" | sort | awk '\"'\"'{printf \"%-16s %-5s %-7s %8s %s %s\\n\",$1,$2,$3,$4,$5,$6}'\"'\"'' && pwd -P >| /tmp/claude-d504-cwd",
