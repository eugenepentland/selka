diff --git a/docs/tooling/cost.md b/docs/tooling/cost.md
index 04e56a233..64663fff3 100644
--- a/docs/tooling/cost.md
+++ b/docs/tooling/cost.md
@@ -78,3 +78,17 @@ ownership exposes conditional and unconditional copy-on-write allocations. This
 prevents release-only stack promotion or unreachable-code proof from satisfying
 an allocation promise that fails in debug builds. The report itself describes
 the chosen optimized build, which may eliminate those sites.
+
+## Costs alongside interfaces
+
+`mylang list-interfaces ENTRY.my --cost` prints the ordinary public declaration
+listing followed by the exact release `cost-v1` report from `mylang cost ENTRY.my`.
+It is mutually exclusive with `--contracts`, which emits a JSON manifest. The
+cost rows describe the entry's reachable
+emitted functions, including private functions and specializations; an uncalled
+public declaration has no emitted cost row. Totals sum those emitted rows.
+
+The option checks bodies and requires an executable entry. A body or Core error
+fails the command before it prints a partial listing. Without `--cost`, the
+existing declaration listing and its handling of bodies are unchanged. Use
+`mylang cost` directly for JSON, function selection and alternative build modes.
diff --git a/docs/tooling/navigation.md b/docs/tooling/navigation.md
index 08847d659..f592e9082 100644
--- a/docs/tooling/navigation.md
+++ b/docs/tooling/navigation.md
@@ -219,3 +219,8 @@ and exits 1.
 The same index backs two other surfaces: `mylang lint` attaches the reachable
 tests to any finding that names a declaration, and `mylang list-interfaces`
 prints the count as a `tests(N)` column.
+
+`mylang list-interfaces ENTRY.my --cost` appends the entry's release per-function
+[cost report](cost.md) after the public declarations. The cost analysis requires
+checked bodies and an executable entry. `--cost` and the JSON `--contracts`
+manifest are mutually exclusive.
diff --git a/src/core/cli.zig b/src/core/cli.zig
index 42c742dc3..992e9c305 100644
--- a/src/core/cli.zig
+++ b/src/core/cli.zig
@@ -103,6 +103,11 @@ pub fn dispatch(init: std.process.Init, args: []const []const u8) Error!?u8 {
     return status;
 }
 
+/// The same default release cost output appended by the interface CLI.
+pub fn interfaceCost(init: std.process.Init, path: []const u8) Error!cost_command.Output {
+    return cost_command.output(init, .{ .path = path });
+}
+
 /// Whether a `build` names one of the core's developer-only switches, which the
 /// core's own build command answers (S5-D8: `mylang-core` merged into `mylang`).
 fn developerBuild(args: []const []const u8) bool {
diff --git a/src/core/cost_command.zig b/src/core/cost_command.zig
index c50f71ea2..a4df977b8 100644
--- a/src/core/cost_command.zig
+++ b/src/core/cost_command.zig
@@ -52,12 +52,22 @@ pub fn parse(args: []const []const u8) ?Request {
 /// Errors already have diagnostics; other failures propagate to the shared CLI.
 pub const Error = frontend.Error || build.Error || project_entry.Error || pipeline.Error || std.Io.File.Writer.Error;
 
-/// Run one cost analysis. Project policy, configuration and refusal handling match build.
+/// Rendered command output and its diagnosed exit status.
+pub const Output = struct { text: []const u8 = "", status: u8 = 0 };
+
+/// Run one cost analysis and write its result.
 pub fn run(init: std.process.Init, args: []const []const u8) Error!u8 {
     const request = parse(args) orelse {
         try std.Io.File.stderr().writeStreamingAll(init.io, usage);
         return 2;
     };
+    const rendered = try output(init, request);
+    try std.Io.File.stdout().writeStreamingAll(init.io, rendered.text);
+    return rendered.status;
+}
+
+/// Shared output for cost and list-interfaces --cost; one pipeline and schema.
+pub fn output(init: std.process.Init, request: Request) Error!Output {
     const a = init.arena.allocator();
     var diagnostics: std.ArrayList(u8) = .empty;
     const entry = project_entry.resolve(a, init.io, request.path, &diagnostics) catch |err| return failure(init, diagnostics.items, err);
@@ -87,21 +97,20 @@ pub fn run(init: std.process.Init, args: []const []const u8) Error!u8 {
     if (report.functions.len == 0) {
         const message = try std.fmt.allocPrint(a, "mylang cost: no reachable function named {s}\n", .{request.function orelse "<entry>"});
         try std.Io.File.stderr().writeStreamingAll(init.io, message);
-        return 2;
+        return .{ .status = 2 };
     }
     if (request.llvm_remarks) |path| {
         const bytes = std.Io.Dir.cwd().readFileAlloc(init.io, path, a, .limited(64 << 20)) catch {
             try std.Io.File.stderr().writeStreamingAll(init.io, "mylang cost: cannot read LLVM optimization remarks\n");
-            return 2;
+            return .{ .status = 2 };
         };
         remarks.apply(&report, bytes);
     }
-    try std.Io.File.stdout().writeStreamingAll(init.io, try cost.render(a, report, request.json));
-    return 0;
+    return .{ .text = try cost.render(a, report, request.json) };
 }
 
-fn failure(init: std.process.Init, text: []const u8, err: anyerror) Error!u8 {
+fn failure(init: std.process.Init, text: []const u8, err: anyerror) Error!Output {
     if (err == error.OutOfMemory) return error.OutOfMemory;
     try std.Io.File.stderr().writeStreamingAll(init.io, text);
-    return if (err == error.PolicyDenied) 3 else if (err == error.ConfigurationFailed or err == error.ToolFailed or err == error.InvalidIr or err == error.WriteFailed) 2 else 1;
+    return .{ .status = if (err == error.PolicyDenied) 3 else if (err == error.ConfigurationFailed or err == error.ToolFailed or err == error.InvalidIr or err == error.WriteFailed) 2 else 1 };
 }
