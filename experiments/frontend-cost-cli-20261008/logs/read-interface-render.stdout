fn listInterfaces(init: Context, project: *language.project.Project, parsed: Parsed, cache: ?*language.syntax_cache.Cache, frontend: ?*language.frontend_cache.Cache) !u8 {
    var index = (try buildIndex(init, project, cache, frontend)) orelse return partialNavigation(init, project, parsed, null);
    if (parsed.contracts) {
        const contracts = index.renderContracts(init.gpa) catch |err| switch (err) {
            error.SourceError, error.IncompleteProject => {
                const message = try diagnostic_output.renderProject(init.gpa, project, init.diagnostics);
                defer init.gpa.free(message);
                try std.Io.File.stderr().writeStreamingAll(init.io, message);
                return 1;
            },
            else => return err,
        };
        defer init.gpa.free(contracts);
        try std.Io.File.stdout().writeStreamingAll(init.io, contracts);
        return 0;
    }
    // Attach checked bodies when they are available so the default listing can
    // publish each function's inferred `effects(...)`. A body that fails to
    // check is ignored: the interface gate lists declarations whether or not
    // bodies type-check, and it never reports body diagnostics.
    var attached: ?language.project_compile.Compilation = language.project_compile.Compilation.init(&index) catch |err| switch (err) {
        error.OutOfMemory => return err,
        else => null,
    };
    if (attached) |*compilation| {
        // Body checking may record a project problem; the interface gate owns
        // only declaration diagnostics, so restore the pre-check problem.
        const saved_problem = project.problem;
        compilation.check() catch |err| switch (err) {
            error.OutOfMemory => return err,
            error.SourceError, error.InternalError => {},
        };
        project.problem = saved_problem;
        index.program = compilation.program;
    }
    const text = try index.render(init.gpa);
    defer init.gpa.free(text);
    try std.Io.File.stdout().writeStreamingAll(init.io, text);
    return 0;
}

/// The commands answered from the declaration index alone, without checking
/// bodies: `list-interfaces` and `api`. Null for every other command.
fn declarationCommand(init: Context, project: *language.project.Project, parsed: Parsed, sources: ApiSources) !?u8 {
    const status = switch (parsed.command) {
        .@"list-interfaces" => try listInterfaces(init, project, parsed, sources.syntax, sources.frontend),
        .api => try apiFiles(init, project, parsed, sources),
        else => return null,
    };
    return status;
}

/// The first step after bodies check: `context` answers here (even from a
pub fn render(self: *Index, allocator: std.mem.Allocator) ContractError![]u8 {
        if (self.project.problem != null) return error.IncompleteProject;
        var output: std.Io.Writer.Allocating = .init(allocator);
        errdefer output.deinit();
        // The `tests` column reads the same reachability index `tests-for`
        // answers from; it is absent when no checked program is attached.
        var tests: ?tests_index.Index = try self.buildTestsIndex(allocator);
        defer {
            if (tests) |*index| index.deinit();
        }
        const functions = try self.functionTable();
        output.writer.writeAll("module interfaces v1; declarations/signature visibility checked; bodies not type checked\n") catch return error.OutOfMemory;
        for (self.project.order.items) |module| {
            output.writer.print("module {s}\n", .{self.project.modules.items[module].name}) catch return error.OutOfMemory;
            for (self.units[module].symbols.items) |symbol| {
                if (!symbol.exported) continue;
                if (symbol.kind == .function) {
                    try self.renderFunctionLine(&output.writer, .{ .module = module, .symbol = symbol }, if (tests) |*index| index else null, &functions);
                    continue;
                }
                output.writer.print("  export {s} {s}", .{ @tagName(symbol.kind), symbol.name }) catch return error.OutOfMemory;
                const origin = self.declarationSource(module, symbol);
                try self.appendContractClauses(&output.writer, origin.module, origin.symbol);
                try self.appendDocstringLine(&output.writer, module, symbol);
                output.writer.writeAll("\n") catch return error.OutOfMemory;
            }
        }
        return output.toOwnedSlice();
    }
    /// Effects one declaration's parameter list permits by construction. It is
    /// read from the signature alone — resolved capability parameter types, the
    /// `mut` markers, every callback parameter's declared ceiling, and the
    /// effects an external resource type carries in the parameters or the
    /// result — plus `managed_allocation`, which is always ambient. A checked
    /// body may not exceed it, and an explicit `noalloc`/`noio`/`effects(...)`
    /// clause only narrows it, so this is the ceiling the interface publishes for
    /// a declaration whose body was never checked.
    fn derivedCeiling(self: *Index, module: usize, signature: ast.FunctionSignature) ContractError!effect_set.Mask {
        var mask = effect_set.bit(.managed_allocation);
        mask |= try self.resourceTypeEffect(module, signature.return_type);
        for (signature.parameters) |parameter| {
            if (parameter.mut) mask |= effect_set.bit(.mutation);
            mask |= try self.typeAuthority(module, parameter.ty, signature.type_parameters, 0);
        }
        return mask;
    }

    /// Authority one parameter type carries, read from the declaration alone: a
    /// capability type permits its effect, a callback type the bounded ceiling it
    /// declares, an external `resource` the family it belongs to, and a local
    /// record whatever its own fields carry, so a record holding an
    /// `Environment` publishes `environment` exactly as the capability does.
    fn typeAuthority(self: *Index, module: usize, span: source.Span, parameters: []const ast.TypeParameter, depth: usize) ContractError!effect_set.Mask {
        if (depth == 32) return 0;
        var mask: effect_set.Mask = 0;
        const text = try self.contractTypeText(module, span, parameters);
        if (capabilityEffect(text)) |effect| mask |= effect_set.bit(effect);
        mask |= try self.resourceTypeEffect(module, span);
        for (self.units[module].syntax.types.expressions.callbacks) |callback| {
            if (callback.span.start != span.start or callback.span.end != span.end) continue;
            // An omitted callback ceiling is the unbounded `all` mask, which

pub fn dispatch(init: std.process.Init, args: []const []const u8) Error!?u8 {
    if (args.len < 2) return null;
    const command = args[1];
    const rest = args[2..];
    const status = status: {
        for (retired_commands) |retired| if (std.mem.eql(u8, command, retired.name)) break :status try refuse(init, command, retired.message);
        if (retiredFlag(rest)) |retired| break :status try refuse(init, command, retired.message);
        if (std.mem.eql(u8, command, "build")) break :status if (developerBuild(rest)) try core_main.buildCommand(init, rest) else try buildCommand(init, rest);
        if (std.mem.eql(u8, command, "run") or std.mem.eql(u8, command, "run-project")) break :status try cli_run.runCommand(init, command, rest);
        if (std.mem.eql(u8, command, "cost")) break :status try cost_command.run(init, rest);
        if (std.mem.eql(u8, command, "test")) break :status try testCommand(init, rest);
        for ([_][]const u8{ "dump-ir", "dump-typed", "coverage" }) |name| if (std.mem.eql(u8, command, name)) break :status try core_main.developer(init, args);
        return null;
    };
    return status;
}

/// Whether a `build` names one of the core's developer-only switches, which the
/// core's own build command answers (S5-D8: `mylang-core` merged into `mylang`).
fn developerBuild(args: []const []const u8) bool {
    for (args) |arg| {
        if (std.mem.startsWith(u8, arg, "--sabotage-facts") or std.mem.eql(u8, arg, "--generic-vectors") or std.mem.startsWith(u8, arg, "--trap-frames=")) return true;
    }
    return false;
}

/// The retirement a flag before `--` names, or null.
fn retiredFlag(args: []const []const u8) ?Retirement {
    for (args) |arg| {
        if (std.mem.eql(u8, arg, "--")) return null;
        const name = arg[0 .. std.mem.indexOfScalar(u8, arg, '=') orelse arg.len];
        for (retired_flags) |retired| if (std.mem.eql(u8, name, retired.name)) return retired;
    }
    return null;
}

fn refuse(init: std.process.Init, command: []const u8, message: []const u8) Error!u8 {
    try write(init, try std.fmt.allocPrint(init.arena.allocator(), "mylang {s}: {s}\n", .{ command, message }));
    return 2;
}

fn write(init: std.process.Init, text: []const u8) Error!void {
    std.Io.File.stderr().writeStreamingAll(init.io, text) catch return error.WriteFailed;
}

const build_usage =
    \\usage: mylang build <file.my> (-o <output> | --run [run options] [-- ARGS...]) [--release] [--link FILE.c]... [--emit-llvm PATH]
    \\       [--cache-dir DIR] [--no-cache] [--zig PATH] [--report] [--cache-report] [--verify-cache] [--stats] [--diagnostics=text|json]
    \\
;

/// `mylang build FILE.my -o OUT` and `build --run`.
fn buildCommand(init: std.process.Init, args: []const []const u8) Error!u8 {
    const request = try cli_run.parseRequest(init, .build, args, build_usage) orelse return 2;
    if (request.run != null) return cli_run.run(init, request, "build");
    // CLI-INPUT-REFUSED-1: an entry that cannot be read is refused by name, as `run` refuses it.
    if (try cli_run.unreadable(init, "build", request.path)) |message| {
        try write(init, message);
        return 2;
    }
    var options = request.build;
    if (request.no_cache) options.cache = try cli_run.privateCache(init, options.cache);
    defer if (request.no_cache) cli_run.discard(init.io, options.cache);
    var report: std.ArrayList(u8) = .empty;
    const status = pipeline.build(init, request.path, options, &report) catch |err| switch (err) {
        error.OutOfMemory => return error.OutOfMemory,
        error.SourceError, error.Unsupported => 1,
        error.PolicyDenied => 3,
        error.ConfigurationFailed => 2,
        error.ToolFailed, error.WriteFailed, error.InvalidIr => 2,
    };
    try write(init, report.items);
    return status;
}

/// `mylang test`: the new core's runner (`test_runner.zig`), with the old CLI's
/// `--flag=VALUE` spellings, `--qbe` ignored and `--whole-program` accepted (S5-D6).
fn testCommand(init: std.process.Init, args: []const []const u8) Error!u8 {
    const a = init.arena.allocator();
    var normalized: std.ArrayList([]const u8) = .empty;
    // A later `--zig` wins over the environment's.
    try normalized.appendSlice(a, &.{ "--zig", cli_run.zigPath(init) });
    var index: usize = 0;
    while (index < args.len) : (index += 1) {
        const arg = args[index];
        const split = std.mem.indexOfScalar(u8, arg, '=') orelse arg.len;
        const name = arg[0..split];
        for (dropped_test_flags) |dropped| if (std.mem.eql(u8, name, dropped)) {
            return refuse(init, "test", try std.fmt.allocPrint(a, "{s} was dropped with the old test runner (S5-D6)", .{name}));
        };
        if (testRefusal(arg)) |message| return refuse(init, "test", message);
        if (std.mem.eql(u8, arg, "--whole-program")) continue;
        if (std.mem.eql(u8, name, "--qbe")) {
            if (split == arg.len) index += 1;
            continue;
        }
        // The core reads `--jobs=N` and `--max-steps=N` itself; any other `--flag=VALUE`
        // is split into the `--flag VALUE` it reads.
        const joined = std.mem.eql(u8, name, "--jobs") or std.mem.eql(u8, name, "--max-steps");
        if (split < arg.len and std.mem.startsWith(u8, arg, "--") and !joined) {
            try normalized.appendSlice(a, &.{ name, arg[split + 1 ..] });
            continue;
        }
        try normalized.append(a, arg);
    }
    // Test processes inherit the caller's address space, not the compiler's own
    // ceiling; each lowers it to its byte ceiling (NEW-CORE-S4-MEMORY-1).
    cli_run.restoreAddressSpace(init.environ_map);
    const status = try core_main.testCommand(init, normalized.items);
    return status;
}

