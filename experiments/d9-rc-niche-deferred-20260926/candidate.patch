+fn nicheValue(comptime E: type, self: *E, variant: @FieldType(Op, "make_variant"), height: usize) Error!bool {
+    if ((try self.layout(variant.ty)).kind != .niche) return false;
+    const payload = self.program.records[variant.ty.recordIndex()].shape.variants.?.cases[variant.tag].payload;
+    if (payload) |ty| {
+        if (@import("value_semantics.zig").isLiveView(self.program.records, ty)) return false;
+        // The optional and its payload have the same physical pointer word.
+        // Preserve the pin-aware owned/borrowed transfer, then publish directly
+        // under the result type without a second partial aggregate journal.
+        try values.prepareOperand(E, self, ty, height - 1);
+        try values.publish(E, self, variant.ty, height - 1);
+    } else {
+        const pointer = try self.aggregatePointer();
+        try self.print(" storel 0, %v{d}\n", .{pointer});
+        try self.store(height, pointer);
+        try values.finish(E, self, .{ .ty = variant.ty, .base = height, .consumed = 0, .origin = .owned });
+    }
+    try error_trace.Lower(E).construction(self, variant.ty, variant.tag);
+    return true;
+}
