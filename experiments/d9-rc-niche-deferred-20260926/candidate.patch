diff --git a/tests/lang/rc_aggregate_values.my b/tests/lang/rc_aggregate_values.my
index 10faff09..08283c01 100644
--- a/tests/lang/rc_aggregate_values.my
+++ b/tests/lang/rc_aggregate_values.my
@@ -177,3 +177,38 @@ def main() -> int:
     assert test_propagating_error_releases_preceding_constructor_operands()
     assert test_propagating_none_releases_preceding_constructor_operands()
     return 0
+
+
+def optional_pinned(items: mut list[int]) -> Option[list[int]]:
+    snapshot = Some(items)
+    items.append(3)
+    return snapshot
+
+
+# spec: RC-NICHE-MOVE-1
+public def test_optional_pointer_transfer_snapshots_a_pinned_payload() -> bool:
+    items = [1, 2]
+    wrapped = optional_pinned(mut items)
+    match wrapped:
+        case Some(snapshot):
+            return snapshot == [1, 2] and items == [1, 2, 3]
+        case None:
+            return False
+
+
+def optional_arena() -> Option[list[int]]:
+    with arena() as scratch:
+        items = [17, 23]
+        return scratch.escape(Some(items))
+
+
+# spec-case: RC-NICHE-MOVE-1
+public def test_optional_pointer_transfer_survives_arena_exit_and_none() -> bool:
+    value = optional_arena()
+    retained = value
+    value = None
+    match retained:
+        case Some(items):
+            return items == [17, 23] and value is None
+        case None:
+            return False
