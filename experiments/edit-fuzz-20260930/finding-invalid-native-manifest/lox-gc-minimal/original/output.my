module output
# Where a run's text goes (SPEC §1 and §11.1): stdout through a 64 KiB buffer
# and stderr line by line to the process streams, or both into memory when a
# test captures the run. Also `print_value`, Lox's value rendering (SPEC §5).
import heap
import object
import value


const BUFFER_SIZE: int = 65536


# In capture mode the streams are held only as the authority capture stands
# in for: nothing is written to them, and `stdout` and `stderr` keep
# everything instead.
public record Output:
    stdout: byte_buffer
    stderr: byte_buffer
    out: Stream
    err: Stream
    capturing: bool


def new_buffer() -> byte_buffer:
    empty: list[int] = []
    buffer = byte_buffer(empty)
    _ = buffer.reserve(BUFFER_SIZE)
    return buffer


# Output bound to the process's standard streams.
public def to_streams(out: Stream, err: Stream) -> Output:
    return Output(stdout=new_buffer(), stderr=new_buffer(), out=out, err=err, capturing=False)


# Output kept in memory in place of `out`, for tests.
public def capture(out: Stream) -> Output:
    return Output(stdout=new_buffer(), stderr=new_buffer(), out=out, err=out, capturing=True)


# Writes buffered stdout to the stream and starts an empty buffer. A no-op in
# capture mode, where the buffer is the result.
public def flush(o: mut Output):
    if o.capturing or len(o.stdout) == 0:
        return
    stream = o.out
    _ = stream.write(o.stdout)
    o.stdout = new_buffer()


# Appends `text` then a newline to stdout, flushing first when the pair
# would overflow the buffer.
public def write_line(o: mut Output, text: bytes):
    if len(o.stdout) + len(text) + 1 > BUFFER_SIZE:
        flush(mut o)
    _ = o.stdout.append_range(text, 0, len(text))
    _ = o.stdout.append_byte(10)


# Writes one diagnostic line to stderr immediately; it never shares the
# stdout buffer.
public def error_line(o: mut Output, text: bytes):
    if o.capturing:
        _ = o.stderr.append_range(text, 0, len(text))
        _ = o.stderr.append_byte(10)
        return
    empty: list[int] = []
    line = byte_buffer(empty)
    _ = line.append_range(text, 0, len(text))
    _ = line.append_byte(10)
    stream = o.err
    _ = stream.write(line)


def string_chars(rt: heap.Runtime, ref: value.ObjRef) -> bytes:
    return heap.string_obj(rt, ref).chars


def function_text(rt: heap.Runtime, function: object.FunctionObj) -> bytes:
    if function.name == value.NO_OBJ:
        return b"<script>"
    return b"<fn " + string_chars(rt, function.name) + b">"


def closure_text(rt: heap.Runtime, closure: value.ObjRef) -> bytes:
    return function_text(rt, heap.function_obj(rt, heap.closure_obj(rt, closure).function))


def object_text(rt: heap.Runtime, ref: value.ObjRef) -> bytes:
    match rt.objects[ref]:
        case object.Obj.string(payload):
            return payload.chars
        case object.Obj.function(payload):
            return function_text(rt, payload)
        case object.Obj.native(_):
            return b"<native fn>"
        case object.Obj.closure(_):
            return closure_text(rt, ref)
        case object.Obj.upvalue(_):
            return b"upvalue"
        case object.Obj.klass(payload):
            return string_chars(rt, payload.name)
        case object.Obj.instance(payload):
            return string_chars(rt, heap.class_obj(rt, payload.klass).name) + b" instance"
        case object.Obj.bound_method(payload):
            return closure_text(rt, payload.method)
        case object.Obj.env(_):
            return b"env"
        case object.Obj.tree_function(payload):
            return b"<fn " + string_chars(rt, payload.name) + b">"
        case object.Obj.free:
            assert False, "printing a freed object"
            return b""


# A value's text as `print` shows it.
public def value_text(rt: heap.Runtime, item: value.Value) -> bytes:
    match item:
        case value.Value.nil:
            return b"nil"
        case value.Value.boolean(flag):
            if flag:
                return b"true"
            return b"false"
        case value.Value.number(number):
            return value.format_number(number)
        case value.Value.obj(ref):
            return object_text(rt, ref)


# Lox's `print`: the value's text and a newline, through the stdout buffer.
public def print_value(rt: heap.Runtime, o: mut Output, item: value.Value):
    write_line(mut o, value_text(rt, item))
