module driver_tests
# SPEC §11.2 tests 53-63, each running its program on both engines.
#
# These tests reach the `clock` native, and mylang lets a function reach a
# clock read only with a Clock parameter, which the test runner cannot
# supply. So they run through driver_cases.json, which substitutes a
# natives.my whose `clock` reads nothing (the runner's provider fixtures),
# and the file is named `_tests` rather than `_test` so a directory run,
# which cannot take a cases file, leaves it out. `out` is the authority the
# captured Output stands in for; nothing is written to it.
import driver


def run(source: bytes, engine: driver.Engine, out: Stream) -> driver.RunResult:
    return driver.run_source(source, engine, False, out, None)


# Both engines print `expected` and exit 0.
def prints(source: bytes, expected: bytes, out: Stream) -> bool:
    vm = run(source, driver.Engine.VM, out)
    tree = run(source, driver.Engine.TREE, out)
    return vm.status == 0 and vm.stdout == expected and tree.status == 0 and tree.stdout == expected


def first_line(text: bytes) -> bytes:
    end = text.find(b"\n")
    if end == -1:
        return text
    return text[0:end]


public def test_run_arithmetic(out: Stream) -> bool:
    return prints(b"print 1 + 2 * 3; print (1 + 2) * 3; print 10 / 4;", b"7\n9\n2.5\n", out)


public def test_run_string_concat(out: Stream) -> bool:
    return prints(b"var a = \"foo\"; var b = a + \"bar\"; print b; print b == \"foobar\";", b"foobar\ntrue\n", out)


public def test_run_closure_counter(out: Stream) -> bool:
    source = b"fun makeCounter() { var i = 0; fun count() { i = i + 1; print i; } return count; }\nvar counter = makeCounter();\ncounter(); counter(); counter();"
    return prints(source, b"1\n2\n3\n", out)


public def test_run_shared_upvalue(out: Stream) -> bool:
    source = b"var inc; var get;\nfun make() { var n = 0; fun i() { n = n + 1; } fun g() { return n; } inc = i; get = g; }\nmake(); inc(); inc(); print get();"
    return prints(source, b"2\n", out)


public def test_run_class_init_method(out: Stream) -> bool:
    source = b"class P { init(x) { this.x = x; } double() { return this.x * 2; } } print P(21).double();"
    return prints(source, b"42\n", out)


public def test_run_inheritance_super(out: Stream) -> bool:
    source = b"class A { name() { return \"A\"; } } class B < A { name() { return \"B\" + super.name(); } } print B().name();"
    return prints(source, b"BA\n", out)


public def test_run_runtime_error_trace(out: Stream) -> bool:
    source = b"print 1;\nprint -\"x\";"
    vm = run(source, driver.Engine.VM, out)
    tree = run(source, driver.Engine.TREE, out)
    vm_ok = vm.status == 70 and vm.stdout == b"1\n" and vm.stderr == b"Operand must be a number.\n[line 2] in script\n"
    tree_ok = tree.status == 70 and tree.stdout == b"1\n" and tree.stderr == b"Operand must be a number.\n[line 2]\n"
    return vm_ok and tree_ok


public def test_run_compile_error_status(out: Stream) -> bool:
    source = b"print 1 +;"
    expected = b"[line 1] Error at ';': Expect expression.\n"
    vm = run(source, driver.Engine.VM, out)
    tree = run(source, driver.Engine.TREE, out)
    return vm.status == 65 and vm.stdout == b"" and vm.stderr == expected and tree.status == 65 and tree.stdout == b"" and tree.stderr == expected


public def test_run_stack_overflow(out: Stream) -> bool:
    source = b"fun f() { f(); } f();"
    vm = run(source, driver.Engine.VM, out)
    tree = run(source, driver.Engine.TREE, out)
    return vm.status == 70 and first_line(vm.stderr) == b"Stack overflow." and tree.status == 70 and first_line(tree.stderr) == b"Stack overflow."


public def test_run_print_value_kinds(out: Stream) -> bool:
    source = b"fun f() {} class C {} print f; print C; print C(); print clock; print nil; print true;"
    return prints(source, b"<fn f>\nC\nC instance\n<native fn>\nnil\ntrue\n", out)


public def test_run_gc_stress_same_output(out: Stream) -> bool:
    source = b"class Node { init(value, next) { this.value = value; this.next = next; } }\nfun adder(n) { fun add(x) { return x + n; } return add; }\nvar list = nil;\nfor (var i = 0; i < 5; i = i + 1) { list = Node(adder(i)(i), list); }\nvar total = 0;\nwhile (list != nil) { total = total + list.value; list = list.next; }\nprint total;\nprint \"done\" + \"!\";"
    vm = run(source, driver.Engine.VM, out)
    vm_stress = driver.run_source(source, driver.Engine.VM, True, out, None)
    tree = run(source, driver.Engine.TREE, out)
    tree_stress = driver.run_source(source, driver.Engine.TREE, True, out, None)
    same_output = vm.stdout == b"20\ndone!\n" and vm_stress.stdout == vm.stdout and tree.stdout == vm.stdout and tree_stress.stdout == vm.stdout
    stressed = vm_stress.collections == vm_stress.allocations and tree_stress.collections == tree_stress.allocations
    return same_output and stressed and vm_stress.status == 0 and tree_stress.status == 0


# A setter must retain property changes made while evaluating its RHS.
public def test_run_set_rhs_keeps_receiver_mutations(out: Stream) -> bool:
    source = b"class Box {} var box = Box(); box.keep = 1; fun rhs() { box.keep = 9; return 7; } box.value = rhs(); print box.keep; print box.value;"
    return prints(source, b"9\n7\n", out)


# The receiver is the object evaluated before the RHS rebinds its variable.
public def test_run_set_rhs_keeps_original_receiver(out: Stream) -> bool:
    source = b"class Box {} var box = Box(); var saved = box; saved.keep = 1; fun rhs() { box = Box(); box.value = 42; saved.keep = 9; return 7; } box.value = rhs(); print saved.keep; print saved.value; print box.value;"
    return prints(source, b"9\n7\n42\n", out)
