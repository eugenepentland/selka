module interpreter
# The tree-walking evaluator (SPEC §9.4-§9.6). Every expression pushes
# exactly one value on the Runtime's value stack, which doubles as the
# operand stack; every statement leaves the stack as it found it. Runtime
# errors unwind as `Err` results, restoring the current env on the way out.
import ast
import heap
import natives
import object
import output
import parser
import lox_strings
import resolver
import table
import value

# jlox's RuntimeError: the message and the line of the token it names.
public record RuntimeError:
    message: bytes
    line: int


enum Flow:
    NORMAL,
    RETURN


# 64 frames counting the top level, as in the VM.
const MAX_DEPTH: int = 63


# The evaluator's state: the program being run (nodes are addressed by
# index), the runtime and output, the active call count, and the return
# register a `return` unwinds with.
record Interpreter:
    program: ast.Program
    rt: heap.Runtime
    out: output.Output
    depth: int
    returned: value.Value


def fail(message: bytes, line: int) -> RuntimeError:
    return RuntimeError(message=message, line=line)


def tree_function_obj(rt: heap.Runtime, ref: value.ObjRef) -> object.TreeFunctionObj:
    match rt.objects[ref]:
        case object.Obj.tree_function(payload):
            return payload
        case _:
            assert False, "object is not a tree function"
            return tree_function_obj(rt, ref)


def as_obj(item: value.Value) -> value.ObjRef:
    match item:
        case value.Value.obj(ref):
            return ref
        case _:
            assert False, "value is not an object"
            return value.NO_OBJ


def number_of(item: value.Value) -> Option[float]:
    match item:
        case value.Value.number(number):
            return Some(number)
        case _:
            return None


def is_string(rt: heap.Runtime, item: value.Value) -> bool:
    match item:
        case value.Value.obj(ref):
            match rt.objects[ref]:
                case object.Obj.string(_):
                    return True
                case _:
                    return False
        case _:
            return False


def instance_of(rt: heap.Runtime, item: value.Value) -> Option[object.InstanceObj]:
    match item:
        case value.Value.obj(ref):
            match rt.objects[ref]:
                case object.Obj.instance(payload):
                    return Some(payload)
                case _:
                    return None
        case _:
            return None


def name_text(rt: heap.Runtime, name: value.ObjRef) -> bytes:
    return heap.string_obj(rt, name).chars


def replace_top(rt: mut heap.Runtime, item: value.Value):
    rt.stack[rt.stack_top - 1] = item


# The env `hops` levels out from the current one.
def env_at(rt: heap.Runtime, hops: int) -> value.ObjRef:
    env = rt.current_env
    i = 0
    while i < hops:
        env = heap.env_enclosing(rt, env)
        i += 1
    return env


def new_env(rt: mut heap.Runtime, enclosing: value.ObjRef, slot_count: int) -> value.ObjRef:
    return heap.allocate(mut rt, object.Obj.env(object.new_env(enclosing, slot_count)))


# A method bound to a receiver: an Env holding the receiver, then a
# TreeFunction closing over it (SPEC §9.5). The Env stays on the stack
# across the second allocation.
def bind(rt: mut heap.Runtime, receiver: value.Value, method_ref: value.ObjRef) -> value.ObjRef:
    method = tree_function_obj(rt, method_ref)
    env = new_env(mut rt, method.closure, 1)
    heap.set_env_slot(mut rt, env, 0, receiver)
    heap.push(mut rt, value.Value.obj(env))
    bound = heap.allocate(mut rt, object.Obj.tree_function(object.TreeFunctionObj(decl=method.decl, name=method.name, closure=env, is_initializer=method.is_initializer)))
    _ = heap.pop(mut rt)
    return bound


def get_variable(it: mut Interpreter, name: value.ObjRef, hops: int, slot: int, line: int) -> Result[None, RuntimeError]:
    if hops == ast.GLOBAL:
        match table.get(it.rt.globals, name, heap.string_hash(it.rt, name)):
            case Some(found):
                __wb_137 = it.rt
                heap.push(mut __wb_137, found)
                it.rt = __wb_137
                return Ok(None)
            case None:
                return Err(fail(b"Undefined variable '" + name_text(it.rt, name) + b"'.", line))
    __wb_141 = it.rt
    heap.push(mut __wb_141, heap.env_slot(__wb_141, env_at(__wb_141, hops), slot))
    it.rt = __wb_141
    return Ok(None)


# Evaluates the value, then stores the top of the stack, which stays pushed.
def assign(it: mut Interpreter, node: ast.AssignExpr) -> Result[None, RuntimeError]:
    evaluate(mut it, node.assigned)?
    if node.hops == ast.GLOBAL:
        match table.get(it.rt.globals, node.name_ref, heap.string_hash(it.rt, node.name_ref)):
            case Some(_):
                __wb_151 = it.rt
                _ = heap.set_global(mut __wb_151, node.name_ref, heap.peek(__wb_151, 0))
                it.rt = __wb_151
            case None:
                return Err(fail(b"Undefined variable '" + name_text(it.rt, node.name_ref) + b"'.", node.name.line))
    else:
        __wb_155 = it.rt
        heap.set_env_slot(mut __wb_155, env_at(__wb_155, node.hops), node.slot, heap.peek(__wb_155, 0))
        it.rt = __wb_155
    return Ok(None)


# Computes a binary operator with both operands still on the stack, then
# pops them and pushes the result. `+` on strings concatenates before the
# operands are popped.
def binary(it: mut Interpreter, node: ast.BinaryExpr) -> Result[None, RuntimeError]:
    evaluate(mut it, node.left)?
    evaluate(mut it, node.right)?
    left = heap.peek(it.rt, 1)
    right = heap.peek(it.rt, 0)
    kind = node.operator.kind
    result = value.Value.nil
    if kind == ast.TokenKind.EQUAL_EQUAL:
        result = value.Value.boolean(value.values_equal(left, right))
    elif kind == ast.TokenKind.BANG_EQUAL:
        result = value.Value.boolean(not value.values_equal(left, right))
    else:
        a = number_of(left)
        b = number_of(right)
        if kind == ast.TokenKind.PLUS:
            if a is not None and b is not None:
                result = value.Value.number(a + b)
            elif is_string(it.rt, left) and is_string(it.rt, right):
                __wb_180 = it.rt
                result = value.Value.obj(lox_strings.concat(mut __wb_180, as_obj(left), as_obj(right)))
                it.rt = __wb_180
            else:
                return Err(fail(b"Operands must be two numbers or two strings.", node.operator.line))
        elif a is None or b is None:
            return Err(fail(b"Operands must be numbers.", node.operator.line))
        else:
            result = arithmetic(kind, a, b)
    __wb_187 = it.rt
    _ = heap.pop(mut __wb_187)
    it.rt = __wb_187
    __wb_188 = it.rt
    replace_top(mut __wb_188, result)
    it.rt = __wb_188
    return Ok(None)


def arithmetic(kind: ast.TokenKind, a: float, b: float) -> value.Value:
    match kind:
        case ast.TokenKind.GREATER:
            return value.Value.boolean(a > b)
        case ast.TokenKind.GREATER_EQUAL:
            return value.Value.boolean(a >= b)
        case ast.TokenKind.LESS:
            return value.Value.boolean(a < b)
        case ast.TokenKind.LESS_EQUAL:
            return value.Value.boolean(a <= b)
        case ast.TokenKind.MINUS:
            return value.Value.number(a - b)
        case ast.TokenKind.SLASH:
            return value.Value.number(a / b)
        case _:
            return value.Value.number(a * b)


def unary(it: mut Interpreter, node: ast.UnaryExpr) -> Result[None, RuntimeError]:
    evaluate(mut it, node.right)?
    operand = heap.peek(it.rt, 0)
    if node.operator.kind == ast.TokenKind.BANG:
        __wb_214 = it.rt
        replace_top(mut __wb_214, value.Value.boolean(value.is_falsey(operand)))
        it.rt = __wb_214
        return Ok(None)
    match operand:
        case value.Value.number(number):
            __wb_218 = it.rt
            replace_top(mut __wb_218, value.Value.number(-number))
            it.rt = __wb_218
            return Ok(None)
        case _:
            return Err(fail(b"Operand must be a number.", node.operator.line))


def logical(it: mut Interpreter, node: ast.LogicalExpr) -> Result[None, RuntimeError]:
    evaluate(mut it, node.left)?
    falsey = value.is_falsey(heap.peek(it.rt, 0))
    if node.operator.kind == ast.TokenKind.OR:
        if not falsey:
            return Ok(None)
    elif falsey:
        return Ok(None)
    __wb_232 = it.rt
    _ = heap.pop(mut __wb_232)
    it.rt = __wb_232
    return evaluate(mut it, node.right)


def call_expr(it: mut Interpreter, id: int) -> Result[None, RuntimeError]:
    node = call_node(it, id)
    evaluate(mut it, node.callee)?
    for argument in node.arguments:
        evaluate(mut it, argument)?
    return call_value(mut it, len(node.arguments), node.paren.line)


def call_node(it: Interpreter, id: int) -> ast.CallExpr:
    match it.program.exprs[id]:
        case ast.Expr.call(node):
            return node
        case _:
            assert False, "expression is not a call"
            return call_node(it, id)


# A field replaces the instance on top of the stack; otherwise a method is
# bound while the instance is still there.
def get(it: mut Interpreter, node: ast.GetExpr) -> Result[None, RuntimeError]:
    evaluate(mut it, node.target)?
    match instance_of(it.rt, heap.peek(it.rt, 0)):
        case Some(instance):
            hash = heap.string_hash(it.rt, node.name_ref)
            match table.get(instance.fields, node.name_ref, hash):
                case Some(field):
                    __wb_262 = it.rt
                    replace_top(mut __wb_262, field)
                    it.rt = __wb_262
                    return Ok(None)
                case None:
                    pass
            match table.get(heap.class_obj(it.rt, instance.klass).methods, node.name_ref, hash):
                case Some(method):
                    __wb_268 = it.rt
                    bound = bind(mut __wb_268, heap.peek(__wb_268, 0), as_obj(method))
                    it.rt = __wb_268
                    __wb_269 = it.rt
                    replace_top(mut __wb_269, value.Value.obj(bound))
                    it.rt = __wb_269
                    return Ok(None)
                case None:
                    return Err(fail(b"Undefined property '" + name_text(it.rt, node.name_ref) + b"'.", node.name.line))
        case None:
            return Err(fail(b"Only instances have properties.", node.name.line))


# The target must be an instance before the value is evaluated.
def set(it: mut Interpreter, node: ast.SetExpr) -> Result[None, RuntimeError]:
    evaluate(mut it, node.target)?
    receiver = instance_of(it.rt, heap.peek(it.rt, 0))
    if receiver is None:
        return Err(fail(b"Only instances have fields.", node.name.line))
    evaluate(mut it, node.assigned)?
    # The RHS may change this same object. Read its current fields afterward.
    match instance_of(it.rt, heap.peek(it.rt, 1)):
        case Some(instance):
            fields = instance.fields
            _ = table.set(mut fields, node.name_ref, heap.string_hash(it.rt, node.name_ref), heap.peek(it.rt, 0))
            instance_ref = as_obj(heap.peek(it.rt, 1))
            updated_instance = instance
            updated_instance.fields = fields
            it.rt.objects[instance_ref] = object.Obj.instance(updated_instance)
            __wb_285 = it.rt
            assigned = heap.pop(mut __wb_285)
            it.rt = __wb_285
            __wb_286 = it.rt
            replace_top(mut __wb_286, assigned)
            it.rt = __wb_286
            return Ok(None)
        case None:
            return Err(fail(b"Only instances have fields.", node.name.line))


def super_access(it: mut Interpreter, node: ast.SuperExpr) -> Result[None, RuntimeError]:
    superclass = heap.env_slot(it.rt, env_at(it.rt, node.hops), 0)
    receiver = heap.env_slot(it.rt, env_at(it.rt, node.hops - 1), 0)
    methods = heap.class_obj(it.rt, as_obj(superclass)).methods
    match table.get(methods, node.method_ref, heap.string_hash(it.rt, node.method_ref)):
        case Some(method):
            __wb_298 = it.rt
            heap.push(mut __wb_298, value.Value.obj(bind(mut __wb_298, receiver, as_obj(method))))
            it.rt = __wb_298
            return Ok(None)
        case None:
            return Err(fail(b"Undefined property '" + name_text(it.rt, node.method_ref) + b"'.", node.method.line))


# Evaluates expression `id`, pushing exactly one value.
def evaluate_literal(it: mut Interpreter, node: ast.LiteralExpr) -> Result[None, RuntimeError]:
    __wb_318 = it.rt
    heap.push(mut __wb_318, node.constant)
    it.rt = __wb_318
    return Ok(None)


def evaluate_this(it: mut Interpreter, node: ast.ThisExpr) -> Result[None, RuntimeError]:
    __wb_327 = it.rt
    heap.push(mut __wb_327, heap.env_slot(__wb_327, env_at(__wb_327, node.hops), node.slot))
    it.rt = __wb_327
    return Ok(None)


def evaluate(it: mut Interpreter, id: int) -> Result[None, RuntimeError]:
    match it.program.exprs[id]:
        case ast.Expr.assign(node):
            return assign(mut it, node)
        case ast.Expr.binary(node):
            return binary(mut it, node)
        case ast.Expr.call(_):
            return call_expr(mut it, id)
        case ast.Expr.get(node):
            return get(mut it, node)
        case ast.Expr.grouping(node):
            return evaluate(mut it, node.inner)
        case ast.Expr.literal(node):
            return evaluate_literal(mut it, node)
        case ast.Expr.logical(node):
            return logical(mut it, node)
        case ast.Expr.set(node):
            return set(mut it, node)
        case ast.Expr.super_access(node):
            return super_access(mut it, node)
        case ast.Expr.this(node):
            return evaluate_this(mut it, node)
        case ast.Expr.unary(node):
            return unary(mut it, node)
        case ast.Expr.variable(node):
            return get_variable(mut it, node.name_ref, node.hops, node.slot, node.name.line)


# Checks arity and depth, then allocates the call's env with the callee and
# arguments still on the stack and copies the arguments from `args` into
# slots 0..count.
def enter_function(it: mut Interpreter, function: object.TreeFunctionObj, enclosing: value.ObjRef, count: int, args: int, line: int) -> Result[value.ObjRef, RuntimeError]:
    arity = len(it.program.functions[function.decl].params)
    if count != arity:
        return Err(fail(f"Expected {arity} arguments but got {count}.".encode(), line))
    if it.depth + 1 > MAX_DEPTH:
        return Err(fail(b"Stack overflow.", line))
    __wb_344 = it.rt
    env = new_env(mut __wb_344, enclosing, it.program.functions[function.decl].slot_count)
    it.rt = __wb_344
    i = 0
    while i < count:
        __wb_347 = it.rt
        heap.set_env_slot(mut __wb_347, env, i, __wb_347.stack[args + i])
        it.rt = __wb_347
        i += 1
    return Ok(env)


def switch_env(rt: mut heap.Runtime, env: value.ObjRef):
    rt.saved_envs.append(rt.current_env)
    rt.current_env = env


def restore_env(rt: mut heap.Runtime):
    rt.current_env = rt.saved_envs.pop()


# Runs a function body in its env and answers the call's value: the
# returned value or nil, or `this` for an initializer.
def run_function(it: mut Interpreter, function: object.TreeFunctionObj, env: value.ObjRef) -> Result[value.Value, RuntimeError]:
    it.depth = it.depth + 1
    __wb_365 = it.rt
    switch_env(mut __wb_365, env)
    it.rt = __wb_365
    outcome = run_body(mut it, function.decl)
    __wb_367 = it.rt
    restore_env(mut __wb_367)
    it.rt = __wb_367
    it.depth = it.depth - 1
    flow = outcome?
    if function.is_initializer:
        return Ok(heap.env_slot(it.rt, heap.env_enclosing(it.rt, env), 0))
    if flow == Flow.RETURN:
        return Ok(it.returned)
    return Ok(value.Value.nil)


def finish_call(rt: mut heap.Runtime, count: int, result: value.Value):
    rt.stack_top = rt.stack_top - count
    replace_top(mut rt, result)


# Calls the callee below `count` arguments on the stack, leaving the result
# in place of the callee and arguments (SPEC §9.5).
def call_value(it: mut Interpreter, count: int, line: int) -> Result[None, RuntimeError]:
    callee_slot = it.rt.stack_top - count - 1
    match it.rt.stack[callee_slot]:
        case value.Value.obj(ref):
            match it.rt.objects[ref]:
                case object.Obj.tree_function(function):
                    env = enter_function(mut it, function, function.closure, count, callee_slot + 1, line)?
                    result = run_function(mut it, function, env)?
                    __wb_392 = it.rt
                    finish_call(mut __wb_392, count, result)
                    it.rt = __wb_392
                    return Ok(None)
                case object.Obj.klass(_):
                    return instantiate(mut it, ref, count, line)
                case object.Obj.native(native):
                    if count != native.arity:
                        return Err(fail(f"Expected {native.arity} arguments but got {count}.".encode(), line))
                    __wb_399 = it.rt
                    finish_call(mut __wb_399, count, natives.call_native(__wb_399, native.id))
                    it.rt = __wb_399
                    return Ok(None)
                case _:
                    pass
        case _:
            pass
    return Err(fail(b"Can only call functions and classes.", line))


# A class call: the Instance replaces the callee. `init`, if any, runs
# unbound in an Env holding the instance, which stays on the stack until
# the call's own env exists.
def instantiate(it: mut Interpreter, class_ref: value.ObjRef, count: int, line: int) -> Result[None, RuntimeError]:
    callee_slot = it.rt.stack_top - count - 1
    __wb_413 = it.rt
    instance = heap.allocate(mut __wb_413, object.Obj.instance(object.InstanceObj(klass=class_ref, fields=table.new_table())))
    it.rt = __wb_413
    it.rt.stack[callee_slot] = value.Value.obj(instance)
    methods = heap.class_obj(it.rt, class_ref).methods
    match table.get(methods, it.rt.init_string, heap.string_hash(it.rt, it.rt.init_string)):
        case Some(init_value):
            initializer = tree_function_obj(it.rt, as_obj(init_value))
            __wb_419 = it.rt
            this_env = new_env(mut __wb_419, initializer.closure, 1)
            it.rt = __wb_419
            __wb_420 = it.rt
            heap.set_env_slot(mut __wb_420, this_env, 0, value.Value.obj(instance))
            it.rt = __wb_420
            __wb_421 = it.rt
            heap.push(mut __wb_421, value.Value.obj(this_env))
            it.rt = __wb_421
            env = enter_function(mut it, initializer, this_env, count, callee_slot + 1, line)?
            __wb_423 = it.rt
            _ = heap.pop(mut __wb_423)
            it.rt = __wb_423
            _ = run_function(mut it, initializer, env)?
        case None:
