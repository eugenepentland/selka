def execute(it: mut Interpreter, id: int) -> Result[Flow, RuntimeError]:
    match it.program.stmts[id]:
        case ast.Stmt.block(node):
            return execute_block(mut it, id, node.slot_count)
        case ast.Stmt.class_decl(_):
            class_declaration(mut it, id)?
        case ast.Stmt.expression(expr):
            return execute_expression(mut it, expr)
        case ast.Stmt.function(index):
            return execute_function(mut it, index)
        case ast.Stmt.if_stmt(node):
            return execute_if_stmt(mut it, node)
        case ast.Stmt.print(expr):
            return execute_print(mut it, expr)
        case ast.Stmt.return_stmt(node):
            return execute_return_stmt(mut it, node)
        case ast.Stmt.var_decl(node):
            return execute_var_decl(mut it, node)
        case ast.Stmt.while_stmt(node):
            return execute_while_stmt(mut it, node)
    return Ok(Flow.NORMAL)


# Executes a block's statements in order until one returns.
def run_block(it: mut Interpreter, id: int) -> Result[Flow, RuntimeError]:
    match it.program.stmts[id]:
        case ast.Stmt.block(node):
            for statement in node.statements:
                flow = execute(mut it, statement)?
                if flow == Flow.RETURN:
                    return Ok(flow)
        case _:
            pass
    return Ok(Flow.NORMAL)


# Executes function `index`'s body in order until a statement returns.
def run_body(it: mut Interpreter, index: int) -> Result[Flow, RuntimeError]:
    for statement in it.program.functions[index].body:
        flow = execute(mut it, statement)?
        if flow == Flow.RETURN:
            return Ok(flow)
    return Ok(Flow.NORMAL)


# Runs a script on a fresh runtime: the startup allocations, then parse,
# resolve and execute. Answers the exit status (0, 65 or 70).
public def interpret(rt: mut heap.Runtime, o: mut output.Output, source: bytes) -> int:
    natives.start(mut rt)
    match parser.parse(mut rt, mut o, source):
        case Some(parsed):
            program = parsed
            if not resolver.resolve(mut program, source, mut o):
                return 65
            it = Interpreter(program=program, rt=rt, out=o, depth=0, returned=value.Value.nil)
            for statement in program.statements:
                match execute(mut it, statement):
                    case Ok(_):
                        pass
                    case Err(error):
                        __wb_604 = it.out
                        output.error_line(mut __wb_604, error.message)
                        it.out = __wb_604
                        __wb_605 = it.out
                        output.error_line(mut __wb_605, f"[line {error.line}]".encode())
                        it.out = __wb_605
                        rt = it.rt
                        o = it.out
                        return 70
            rt = it.rt
            o = it.out
            return 0
        case None:
            return 65
