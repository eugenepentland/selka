        env = new_env(mut __wb_490, __wb_490.current_env, 1)
        it.rt = __wb_490
        __wb_491 = it.rt
        heap.set_env_slot(mut __wb_491, env, 0, value.Value.obj(superclass))
        it.rt = __wb_491
        __wb_492 = it.rt
        switch_env(mut __wb_492, env)
        it.rt = __wb_492
