def execute_while_stmt(it: mut Interpreter, node: ast.WhileStmt) -> Result[Flow, RuntimeError]:
    while True:
        evaluate(mut it, node.condition)?
        __wb_560 = it.rt
        __condition_560 = value.is_falsey(heap.pop(mut __wb_560))
        it.rt = __wb_560
        if __condition_560:
