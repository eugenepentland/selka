        __wb_495 = it.rt
        function = heap.allocate(mut __wb_495, object.Obj.tree_function(object.TreeFunctionObj(decl=method, name=decl.name_ref, closure=__wb_495.current_env, is_initializer=decl.name_ref == __wb_495.init_string)))
        it.rt = __wb_495
        _ = table.set(mut methods, decl.name_ref, heap.string_hash(it.rt, decl.name_ref), value.Value.obj(function))
        __wb_methods = it.rt
        heap.set_class_methods(mut __wb_methods, klass_ref, methods)
        it.rt = __wb_methods
