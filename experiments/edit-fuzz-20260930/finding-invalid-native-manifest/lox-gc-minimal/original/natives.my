module natives
# Native functions (SPEC §7.5). Lox has one: `clock`.
import time
import heap
import lox_strings
import object
import value


public const CLOCK: int = 0


# Seconds from the Runtime's clock capability; 0 when none was granted.
def clock_native(rt: heap.Runtime) -> value.Value:
    match rt.clock:
        case Some(clock):
            match time.now(clock):
                case Ok(instant):
                    return value.Value.number(float(instant.unix_nanoseconds) / 1000000000.0)
                case Err(_):
                    return value.Value.number(0.0)
        case None:
            return value.Value.number(0.0)


# Runs native `id` on the arguments at the top of the stack; the caller has
# already checked the arity.
public def call_native(rt: heap.Runtime, id: int) -> value.Value:
    assert id == CLOCK, "unknown native"
    return clock_native(rt)


# The allocations every run starts with (SPEC §7.5): the `init` string the
# runtime keeps as a root, then the natives.
public def start(rt: mut heap.Runtime):
    rt.init_string = lox_strings.copy_string(mut rt, b"init")
    define_natives(mut rt)


# Allocates the natives and binds them as globals, rooting the name and the
# native on the stack across the allocations as clox does.
def define_natives(rt: mut heap.Runtime):
    name = lox_strings.copy_string(mut rt, b"clock")
    heap.push(mut rt, value.Value.obj(name))
    native = heap.allocate(mut rt, object.Obj.native(object.NativeObj(id=CLOCK, arity=0)))
    heap.push(mut rt, value.Value.obj(native))
    _ = heap.set_global(mut rt, name, value.Value.obj(native))
    _ = heap.pop(mut rt)
    _ = heap.pop(mut rt)
