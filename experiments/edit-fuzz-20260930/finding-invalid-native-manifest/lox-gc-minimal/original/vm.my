module vm
# clox's stack VM (SPEC §8.5 and §8.6). All live state -- the value stack,
# the call frames and the open upvalues -- sits in the Runtime's root fields.
import chunk
import compiler
import heap
import lox_strings
import natives
import object
import output
import table
import value


public enum InterpretResult:
    OK,
    COMPILE_ERROR,
    RUNTIME_ERROR


# Cached data for the currently running frame. The Runtime stores only the
# scalar CallFrame so each instruction does not share code and upvalue lists.
record ExecFrame:
    constants: list[value.Value]
    code: list[int]
    upvalues: list[value.ObjRef]
    ip: int
    base: int


def load_frame(rt: heap.Runtime, stored: heap.CallFrame) -> ExecFrame:
    match rt.objects[stored.closure]:
        case object.Obj.closure(closure):
            match rt.objects[closure.function]:
                case object.Obj.function(function):
                    return ExecFrame(
                        constants=function.code.constants,
                        code=function.code.code,
                        upvalues=closure.upvalues,
                        ip=stored.ip,
                        base=stored.base
                    )
                case _:
                    assert False, "object is not a function"
        case _:
            assert False, "object is not a closure"
    return ExecFrame(constants=[], code=[], upvalues=[], ip=stored.ip, base=stored.base)



def reset_stack(rt: mut heap.Runtime):
    rt.stack_top = 0
    rt.frame_count = 0
    rt.open_upvalues = value.NO_OBJ


# Reports a runtime error with one trace line per frame, innermost first,
# naming the line of the instruction that failed, then resets the stack.
# Always answers False so callers can `return runtime_error(...)`.
def runtime_error(rt: mut heap.Runtime, o: mut output.Output, message: bytes) -> bool:
    output.error_line(mut o, message)
    i = rt.frame_count - 1
    while i >= 0:
        frame = rt.frames[i]
        function = heap.function_obj(rt, heap.closure_obj(rt, frame.closure).function)
        empty: list[int] = []
        line = byte_buffer(empty)
        _ = line.append_utf8("[line ")
        _ = line.append_int(function.code.lines[frame.ip - 1])
        _ = line.append_utf8("] in ")
        if function.name == value.NO_OBJ:
            _ = line.append_utf8("script")
        else:
            name = heap.string_obj(rt, function.name).chars
            _ = line.append_range(name, 0, len(name))
            _ = line.append_utf8("()")
        output.error_line(mut o, bytes(line))
        i -= 1
    reset_stack(mut rt)
    return False


def as_obj(item: value.Value) -> value.ObjRef:
    match item:
        case value.Value.obj(ref):
            return ref
        case _:
            assert False, "value is not an object"
            return value.NO_OBJ


def as_number(item: value.Value) -> float:
    match item:
        case value.Value.number(number):
            return number
        case _:
            assert False, "value is not a number"
            return 0.0


def is_number(item: value.Value) -> bool:
    match item:
        case value.Value.number(_):
            return True
        case _:
            return False


def is_string(rt: heap.Runtime, item: value.Value) -> bool:
    match item:
        case value.Value.obj(ref):
            match rt.objects[ref]:
                case object.Obj.string(_):
                    return True
                case _:
                    return False
        case _:
            return False


def is_class(rt: heap.Runtime, item: value.Value) -> bool:
    match item:
        case value.Value.obj(ref):
            match rt.objects[ref]:
                case object.Obj.klass(_):
                    return True
                case _:
                    return False
        case _:
            return False


def instance_of(rt: heap.Runtime, item: value.Value) -> Option[value.ObjRef]:
    match item:
        case value.Value.obj(ref):
            match rt.objects[ref]:
                case object.Obj.instance(_):
                    return Some(ref)
                case _:
                    return None
        case _:
            return None


def name_text(rt: heap.Runtime, name: value.ObjRef) -> bytes:
    return heap.string_obj(rt, name).chars


def undefined_property(rt: mut heap.Runtime, o: mut output.Output, name: value.ObjRef) -> bool:
    return runtime_error(mut rt, mut o, b"Undefined property '" + name_text(rt, name) + b"'.")


def arity_error(rt: mut heap.Runtime, o: mut output.Output, arity: int, count: int) -> bool:
    return runtime_error(mut rt, mut o, f"Expected {arity} arguments but got {count}.".encode())


# Pushes a frame for the closure whose callee and arguments are on the stack.
def call(rt: mut heap.Runtime, o: mut output.Output, closure: value.ObjRef, count: int) -> bool:
    arity = heap.function_arity(rt, heap.closure_function(rt, closure))
    if count != arity:
        return arity_error(mut rt, mut o, arity, count)
    if rt.frame_count == heap.FRAMES_MAX:
        return runtime_error(mut rt, mut o, b"Stack overflow.")
    frame_index = rt.frame_count
    rt.frame_count = rt.frame_count + 1
    rt.frames[frame_index] = heap.CallFrame(
        closure=closure,
        ip=0,
        base=rt.stack_top - count - 1
    )
    return True


def call_value(rt: mut heap.Runtime, o: mut output.Output, callee: value.Value, count: int) -> bool:
    match callee:
        case value.Value.obj(ref):
            match rt.objects[ref]:
                case object.Obj.bound_method(bound):
                    rt.stack[rt.stack_top - count - 1] = bound.receiver
                    return call(mut rt, mut o, bound.method, count)
                case object.Obj.klass(_):
                    instance = heap.allocate(mut rt, object.Obj.instance(object.InstanceObj(klass=ref, fields=table.new_table())))
                    rt.stack[rt.stack_top - count - 1] = value.Value.obj(instance)
                    match heap.class_method(rt, ref, rt.init_string):
                        case Some(initializer):
                            return call(mut rt, mut o, as_obj(initializer), count)
                        case None:
                            if count != 0:
                                return arity_error(mut rt, mut o, 0, count)
                            return True
                case object.Obj.closure(_):
                    return call(mut rt, mut o, ref, count)
                case object.Obj.native(native):
                    if count != native.arity:
                        return arity_error(mut rt, mut o, native.arity, count)
                    result = natives.call_native(rt, native.id)
                    rt.stack_top = rt.stack_top - count - 1
                    heap.push(mut rt, result)
                    return True
                case _:
                    pass
        case _:
            pass
    return runtime_error(mut rt, mut o, b"Can only call functions and classes.")


def invoke_from_class(rt: mut heap.Runtime, o: mut output.Output, klass: value.ObjRef, name: value.ObjRef, count: int) -> bool:
    match heap.class_method(rt, klass, name):
        case Some(method):
            return call(mut rt, mut o, as_obj(method), count)
        case None:
            return undefined_property(mut rt, mut o, name)


def invoke(rt: mut heap.Runtime, o: mut output.Output, name: value.ObjRef, count: int) -> bool:
    match instance_of(rt, heap.peek(rt, count)):
        case Some(instance_ref):
            match rt.objects[instance_ref]:
                case object.Obj.instance(instance):
                    match table.get(instance.fields, name, heap.string_hash(rt, name)):
                        case Some(field):
                            rt.stack[rt.stack_top - count - 1] = field
                            return call_value(mut rt, mut o, field, count)
                        case None:
                            return invoke_from_class(mut rt, mut o, instance.klass, name, count)
                case _:
                    assert False, "object is not an instance"
                    return False
        case None:
            return runtime_error(mut rt, mut o, b"Only instances have methods.")


# Replaces the receiver on top of the stack with a bound method. The
# receiver stays on the stack across the allocation.


def bind_method(rt: mut heap.Runtime, o: mut output.Output, klass: value.ObjRef, name: value.ObjRef) -> bool:
    match heap.class_method(rt, klass, name):
        case Some(method):
            bound = heap.allocate(mut rt, object.Obj.bound_method(object.BoundMethodObj(receiver=heap.peek(rt, 0), method=as_obj(method))))
            _ = heap.pop(mut rt)
            heap.push(mut rt, value.Value.obj(bound))
            return True
        case None:
            return undefined_property(mut rt, mut o, name)


# The open upvalue for stack slot `slot`, created and linked into the list
# (sorted by descending slot) when none exists.
def capture_upvalue(rt: mut heap.Runtime, slot: int) -> value.ObjRef:
    previous = value.NO_OBJ
    upvalue = rt.open_upvalues
    while upvalue != value.NO_OBJ and heap.upvalue_obj(rt, upvalue).slot > slot:
        previous = upvalue
        upvalue = heap.upvalue_obj(rt, upvalue).next_open
    if upvalue != value.NO_OBJ and heap.upvalue_obj(rt, upvalue).slot == slot:
        return upvalue
    created = heap.allocate(mut rt, object.Obj.upvalue(object.UpvalueObj(slot=slot, closed=value.Value.nil, next_open=upvalue)))
    if previous == value.NO_OBJ:
        rt.open_upvalues = created
    else:
        link = heap.upvalue_obj(rt, previous)
        link.next_open = created
        rt.objects[previous] = object.Obj.upvalue(link)
    return created


# Closes every open upvalue at or above stack slot `last`.
def close_upvalues(rt: mut heap.Runtime, last: int):
    while rt.open_upvalues != value.NO_OBJ and heap.upvalue_obj(rt, rt.open_upvalues).slot >= last:
        upvalue = heap.upvalue_obj(rt, rt.open_upvalues)
        upvalue.closed = rt.stack[upvalue.slot]
        upvalue.slot = object.NO_SLOT
        rt.objects[rt.open_upvalues] = object.Obj.upvalue(upvalue)
        rt.open_upvalues = upvalue.next_open


def concatenate(rt: mut heap.Runtime):
    b = as_obj(heap.peek(rt, 0))
    a = as_obj(heap.peek(rt, 1))
    result = lox_strings.concat(mut rt, a, b)
    _ = heap.pop(mut rt)
    _ = heap.pop(mut rt)
    heap.push(mut rt, value.Value.obj(result))


def read_byte(frame: mut ExecFrame) -> int:
    byte = frame.code[frame.ip]
    frame.ip = frame.ip + 1
    return byte


def read_short(frame: mut ExecFrame) -> int:
    frame.ip = frame.ip + 2
    return frame.code[frame.ip - 2] * 256 + frame.code[frame.ip - 1]


def read_constant(frame: mut ExecFrame) -> value.Value:
    return frame.constants[read_byte(mut frame)]


def read_string(frame: mut ExecFrame) -> value.ObjRef:
    return as_obj(read_constant(mut frame))


def get_global(rt: mut heap.Runtime, o: mut output.Output, frame: mut ExecFrame) -> bool:
    name = read_string(mut frame)
    match table.get(rt.globals, name, heap.string_hash(rt, name)):
        case Some(found):
            heap.push(mut rt, found)
            return True
        case None:
            return runtime_error(mut rt, mut o, b"Undefined variable '" + name_text(rt, name) + b"'.")


# Assigning an undefined global is an error; the entry the failed `set`
# just made is deleted again, leaving a tombstone as clox does.
def set_global(rt: mut heap.Runtime, o: mut output.Output, frame: mut ExecFrame) -> bool:
    name = read_string(mut frame)
    if heap.set_global(mut rt, name, heap.peek(rt, 0)):
        __wb_282 = rt.globals
        _ = table.delete(mut __wb_282, name, heap.string_hash(rt, name))
        rt.globals = __wb_282
        return runtime_error(mut rt, mut o, b"Undefined variable '" + name_text(rt, name) + b"'.")
    return True


def get_upvalue(rt: mut heap.Runtime, frame: mut ExecFrame):
    upvalue = heap.upvalue_obj(rt, frame.upvalues[read_byte(mut frame)])
    if upvalue.slot != object.NO_SLOT:
        heap.push(mut rt, rt.stack[upvalue.slot])
    else:
        heap.push(mut rt, upvalue.closed)


def set_upvalue(rt: mut heap.Runtime, frame: mut ExecFrame):
    ref = frame.upvalues[read_byte(mut frame)]
    upvalue = heap.upvalue_obj(rt, ref)
    if upvalue.slot != object.NO_SLOT:
        rt.stack[upvalue.slot] = heap.peek(rt, 0)
    else:
        upvalue.closed = heap.peek(rt, 0)
        rt.objects[ref] = object.Obj.upvalue(upvalue)


def get_property(rt: mut heap.Runtime, o: mut output.Output, frame: mut ExecFrame) -> bool:
    match instance_of(rt, heap.peek(rt, 0)):
        case Some(instance_ref):
            name = read_string(mut frame)
            match rt.objects[instance_ref]:
                case object.Obj.instance(instance):
                    match table.get(instance.fields, name, heap.string_hash(rt, name)):
                        case Some(field):
                            _ = heap.pop(mut rt)
                            heap.push(mut rt, field)
                            return True
                        case None:
                            return bind_method(mut rt, mut o, instance.klass, name)
                case _:
                    assert False, "object is not an instance"
                    return False
        case None:
            return runtime_error(mut rt, mut o, b"Only instances have properties.")


def set_property(rt: mut heap.Runtime, o: mut output.Output, frame: mut ExecFrame) -> bool:
    match instance_of(rt, heap.peek(rt, 1)):
        case Some(instance_ref):
            name = read_string(mut frame)
            hash = heap.string_hash(rt, name)
            assigned = heap.peek(rt, 0)
            heap.set_instance_field(mut rt, instance_ref, name, hash, assigned)
            _ = heap.pop(mut rt)
            _ = heap.pop(mut rt)
            heap.push(mut rt, assigned)
            return True
        case None:
            return runtime_error(mut rt, mut o, b"Only instances have fields.")


# GREATER, LESS, SUBTRACT, MULTIPLY and DIVIDE: two numbers in, one out.


def numeric(rt: mut heap.Runtime, o: mut output.Output, instruction: int) -> bool:
    if not is_number(heap.peek(rt, 0)) or not is_number(heap.peek(rt, 1)):
        return runtime_error(mut rt, mut o, b"Operands must be numbers.")
    b = as_number(heap.pop(mut rt))
    a = as_number(heap.pop(mut rt))
    if instruction == chunk.OP_GREATER:
        heap.push(mut rt, value.Value.boolean(a > b))
    elif instruction == chunk.OP_LESS:
        heap.push(mut rt, value.Value.boolean(a < b))
    elif instruction == chunk.OP_SUBTRACT:
        heap.push(mut rt, value.Value.number(a - b))
    elif instruction == chunk.OP_MULTIPLY:
        heap.push(mut rt, value.Value.number(a * b))
    else:
        heap.push(mut rt, value.Value.number(a / b))
    return True


def add(rt: mut heap.Runtime, o: mut output.Output) -> bool:
    if is_string(rt, heap.peek(rt, 0)) and is_string(rt, heap.peek(rt, 1)):
        concatenate(mut rt)
    elif is_number(heap.peek(rt, 0)) and is_number(heap.peek(rt, 1)):
        b = as_number(heap.pop(mut rt))
        a = as_number(heap.pop(mut rt))
        heap.push(mut rt, value.Value.number(a + b))
    else:
        return runtime_error(mut rt, mut o, b"Operands must be two numbers or two strings.")
    return True


def negate(rt: mut heap.Runtime, o: mut output.Output) -> bool:
    if not is_number(heap.peek(rt, 0)):
        return runtime_error(mut rt, mut o, b"Operand must be a number.")
    heap.push(mut rt, value.Value.number(-as_number(heap.pop(mut rt))))
    return True


# Captured upvalues stay rooted in the open list or the executing closure.
# Publish the completed closure after capturing, then root it on the stack.
def make_closure(rt: mut heap.Runtime, frame: mut ExecFrame):
    function_ref = read_string(mut frame)
    upvalue_count = heap.function_upvalue_count(rt, function_ref)
    closure = object.new_closure(function_ref, upvalue_count)
    captured = closure.upvalues
    i = 0
    while i < upvalue_count:
        is_local = read_byte(mut frame)
        index = read_byte(mut frame)
        if is_local == 1:
            captured[i] = capture_upvalue(mut rt, frame.base + index)
        else:
            captured[i] = frame.upvalues[index]
        i += 1
    closure_ref = heap.allocate(mut rt, object.Obj.closure(object.ClosureObj(function=function_ref, upvalues=captured)))
    heap.push(mut rt, value.Value.obj(closure_ref))


def inherit(rt: mut heap.Runtime, o: mut output.Output) -> bool:
    parent = heap.peek(rt, 1)
    if not is_class(rt, parent):
        return runtime_error(mut rt, mut o, b"Superclass must be a class.")
    methods = heap.class_obj(rt, as_obj(heap.peek(rt, 0))).methods
    source = heap.class_obj(rt, as_obj(parent)).methods
    snapshot = table.Table(entries=source.entries.copy(), count=source.count)
    table.add_all(snapshot, mut methods)
    subclass_ref = as_obj(heap.peek(rt, 0))
    subclass = heap.class_obj(rt, subclass_ref)
    subclass.methods = methods
    rt.objects[subclass_ref] = object.Obj.klass(subclass)
    _ = heap.pop(mut rt)
    return True


def define_method(rt: mut heap.Runtime, frame: mut ExecFrame):
    name = read_string(mut frame)
    methods = heap.class_obj(rt, as_obj(heap.peek(rt, 1))).methods
    _ = table.set(mut methods, name, heap.string_hash(rt, name), heap.peek(rt, 0))
    class_ref = as_obj(heap.peek(rt, 1))
    klass = heap.class_obj(rt, class_ref)
    klass.methods = methods
    rt.objects[class_ref] = object.Obj.klass(klass)
    _ = heap.pop(mut rt)


# The dispatch loop, one opcode per iteration of `frame`, the innermost
# call frame. Handlers answer False after reporting a runtime error.
def run(rt: mut heap.Runtime, o: mut output.Output) -> InterpretResult:
    frame = load_frame(rt, rt.frames[rt.frame_count - 1])
    while True:
        instruction = frame.code[frame.ip]
        frame.ip = frame.ip + 1
        # The closure/base root stays in rt.frames throughout this activation.
        # Publish IP only before a handler can report a Lox error or call away.
        ok = True
        if instruction == chunk.OP_CONSTANT:
            constant = read_constant(mut frame)
            rt.stack[rt.stack_top] = constant
            rt.stack_top = rt.stack_top + 1
        elif instruction == chunk.OP_NIL:
            rt.stack[rt.stack_top] = value.Value.nil
            rt.stack_top = rt.stack_top + 1
        elif instruction == chunk.OP_TRUE:
            rt.stack[rt.stack_top] = value.Value.boolean(True)
            rt.stack_top = rt.stack_top + 1
        elif instruction == chunk.OP_FALSE:
            rt.stack[rt.stack_top] = value.Value.boolean(False)
            rt.stack_top = rt.stack_top + 1
        elif instruction == chunk.OP_POP:
            rt.stack_top = rt.stack_top - 1
        elif instruction == chunk.OP_GET_LOCAL:
            local = rt.stack[frame.base + read_byte(mut frame)]
            rt.stack[rt.stack_top] = local
            rt.stack_top = rt.stack_top + 1
        elif instruction == chunk.OP_SET_LOCAL:
            rt.stack[frame.base + read_byte(mut frame)] = heap.peek(rt, 0)
        elif instruction == chunk.OP_GET_GLOBAL:
            rt.frames[rt.frame_count - 1].ip = frame.ip
            ok = get_global(mut rt, mut o, mut frame)
        elif instruction == chunk.OP_DEFINE_GLOBAL:
            _ = heap.set_global(mut rt, read_string(mut frame), heap.peek(rt, 0))
            rt.stack_top = rt.stack_top - 1
        elif instruction == chunk.OP_SET_GLOBAL:
            rt.frames[rt.frame_count - 1].ip = frame.ip
            ok = set_global(mut rt, mut o, mut frame)
        elif instruction == chunk.OP_GET_UPVALUE:
            get_upvalue(mut rt, mut frame)
        elif instruction == chunk.OP_SET_UPVALUE:
            set_upvalue(mut rt, mut frame)
        elif instruction == chunk.OP_GET_PROPERTY:
            rt.frames[rt.frame_count - 1].ip = frame.ip
            ok = get_property(mut rt, mut o, mut frame)
        elif instruction == chunk.OP_SET_PROPERTY:
            rt.frames[rt.frame_count - 1].ip = frame.ip
            ok = set_property(mut rt, mut o, mut frame)
        elif instruction == chunk.OP_GET_SUPER:
            rt.frames[rt.frame_count - 1].ip = frame.ip
            name = read_string(mut frame)
            rt.stack_top = rt.stack_top - 1
            superclass = as_obj(rt.stack[rt.stack_top])
            ok = bind_method(mut rt, mut o, superclass, name)
        elif instruction == chunk.OP_EQUAL:
            right = rt.stack[rt.stack_top - 1]
            left = rt.stack[rt.stack_top - 2]
            rt.stack_top = rt.stack_top - 1
            rt.stack[rt.stack_top - 1] = value.Value.boolean(value.values_equal(left, right))
        elif instruction == chunk.OP_GREATER or instruction == chunk.OP_LESS or instruction == chunk.OP_SUBTRACT or instruction == chunk.OP_MULTIPLY or instruction == chunk.OP_DIVIDE:
            rt.frames[rt.frame_count - 1].ip = frame.ip
            ok = numeric(mut rt, mut o, instruction)
        elif instruction == chunk.OP_ADD:
            rt.frames[rt.frame_count - 1].ip = frame.ip
            ok = add(mut rt, mut o)
        elif instruction == chunk.OP_NOT:
            top = rt.stack_top - 1
            rt.stack[top] = value.Value.boolean(value.is_falsey(rt.stack[top]))
        elif instruction == chunk.OP_NEGATE:
            rt.frames[rt.frame_count - 1].ip = frame.ip
            ok = negate(mut rt, mut o)
        elif instruction == chunk.OP_PRINT:
            rt.stack_top = rt.stack_top - 1
            output.print_value(rt, mut o, rt.stack[rt.stack_top])
        elif instruction == chunk.OP_JUMP:
            offset = read_short(mut frame)
            frame.ip = frame.ip + offset
        elif instruction == chunk.OP_JUMP_IF_FALSE:
            offset = read_short(mut frame)
            if value.is_falsey(heap.peek(rt, 0)):
                frame.ip = frame.ip + offset
        elif instruction == chunk.OP_LOOP:
            offset = read_short(mut frame)
            frame.ip = frame.ip - offset
        elif instruction == chunk.OP_CALL:
            count = read_byte(mut frame)
            rt.frames[rt.frame_count - 1].ip = frame.ip
            ok = call_value(mut rt, mut o, heap.peek(rt, count), count)
            if ok:
                frame = load_frame(rt, rt.frames[rt.frame_count - 1])
        elif instruction == chunk.OP_INVOKE:
            method = read_string(mut frame)
            count = read_byte(mut frame)
            rt.frames[rt.frame_count - 1].ip = frame.ip
            ok = invoke(mut rt, mut o, method, count)
            if ok:
                frame = load_frame(rt, rt.frames[rt.frame_count - 1])
        elif instruction == chunk.OP_SUPER_INVOKE:
            method = read_string(mut frame)
            count = read_byte(mut frame)
            rt.frames[rt.frame_count - 1].ip = frame.ip
            rt.stack_top = rt.stack_top - 1
            superclass = as_obj(rt.stack[rt.stack_top])
            ok = invoke_from_class(mut rt, mut o, superclass, method, count)
            if ok:
                frame = load_frame(rt, rt.frames[rt.frame_count - 1])
        elif instruction == chunk.OP_CLOSURE:
            make_closure(mut rt, mut frame)
        elif instruction == chunk.OP_CLOSE_UPVALUE:
            close_upvalues(mut rt, rt.stack_top - 1)
            rt.stack_top = rt.stack_top - 1
        elif instruction == chunk.OP_RETURN:
            rt.stack_top = rt.stack_top - 1
            result = rt.stack[rt.stack_top]
            close_upvalues(mut rt, frame.base)
            rt.frame_count = rt.frame_count - 1
            if rt.frame_count == 0:
                rt.stack_top = rt.stack_top - 1
                return InterpretResult.OK
            rt.stack_top = frame.base
            rt.stack[rt.stack_top] = result
            rt.stack_top = rt.stack_top + 1
            frame = load_frame(rt, rt.frames[rt.frame_count - 1])
        elif instruction == chunk.OP_CLASS:
            name = read_string(mut frame)
            klass = heap.allocate(mut rt, object.Obj.klass(object.ClassObj(name=name, methods=table.new_table())))
            rt.stack[rt.stack_top] = value.Value.obj(klass)
            rt.stack_top = rt.stack_top + 1
        elif instruction == chunk.OP_INHERIT:
            rt.frames[rt.frame_count - 1].ip = frame.ip
            ok = inherit(mut rt, mut o)
        elif instruction == chunk.OP_METHOD:
            define_method(mut rt, mut frame)
        if not ok:
            return InterpretResult.RUNTIME_ERROR


# Runs a script on a fresh runtime (SPEC §8.5): the startup allocations,
# then compile; push the script function, wrap it in a closure, swap the
# closure in, call it with no arguments and run.
public def interpret(rt: mut heap.Runtime, o: mut output.Output, source: bytes) -> InterpretResult:
    natives.start(mut rt)
    function = compiler.compile(mut rt, mut o, source)
    if function == value.NO_OBJ:
        return InterpretResult.COMPILE_ERROR
    heap.push(mut rt, value.Value.obj(function))
    closure = heap.allocate(mut rt, object.Obj.closure(object.new_closure(function, 0)))
    _ = heap.pop(mut rt)
    heap.push(mut rt, value.Value.obj(closure))
    _ = call(mut rt, mut o, closure, 0)
    return run(mut rt, mut o)
