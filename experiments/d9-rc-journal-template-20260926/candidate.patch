diff --git a/src/qbe_rc_templates.zig b/src/qbe_rc_templates.zig
new file mode 100644
index 00000000..4d2bbb0c
--- /dev/null
+++ b/src/qbe_rc_templates.zig
@@ -0,0 +1,53 @@
+//! Immutable initial journal metadata; dynamic addresses are patched before linking.
+const std = @import("std");
+const typed = @import("typed.zig");
+const bytecode = @import("bytecode.zig");
+const native = @import("native_types.zig");
+const shapes = @import("rc_shape.zig");
+const descriptors = @import("native_descriptors.zig");
+/// Metadata generation and validated stack-analysis failures.
+pub const Error = native.Error || @import("native_ir.zig").AnalyzeError;
+/// Content-addressed initial metadata, with zero dynamic addresses and guards.
+pub const Template = struct { symbol: []const u8, body: []const u8, count: usize };
+
+/// Describe every lowered local followed by the operand and two work entries.
+pub fn describe(a: std.mem.Allocator, catalog: *shapes.Catalog, locals: []const typed.Local, extra: usize) Error!Template {
+    var output: std.Io.Writer.Allocating = .init(a);
+    defer output.deinit();
+    for (locals) |local| try entry(a, &output.writer, catalog, local.ty);
+    for (0..extra) |_| try entry(a, &output.writer, catalog, .unit);
+    const body = try output.toOwnedSlice();
+    var digest: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(body, &digest, .{});
+    return .{ .symbol = try std.fmt.allocPrint(a, "myl_rc_journal_v1_{s}", .{std.fmt.bytesToHex(digest, .lower)}), .body = body, .count = locals.len + extra };
+}
+
+fn entry(a: std.mem.Allocator, writer: *std.Io.Writer, catalog: *shapes.Catalog, ty: typed.Type) Error!void {
+    const shape = try catalog.get(ty);
+    const flags = @as(u32, @intFromBool(shape.unique_drop)) | (@as(u32, @intFromBool(shape.counted)) << 1);
+    writer.print("{{.type=&{s}, .address=0, .initialized=0, .flags={d}}},\n", .{ try descriptors.symbol(a, catalog.native, ty), flags }) catch return error.OutOfMemory;
+}
+
+/// Generate deterministic C arrays independently of lean/cached unit emission.
+pub fn generate(allocator: std.mem.Allocator, layouts: *native.Catalog, program: bytecode.Program) Error![]const u8 {
+    var arena = std.heap.ArenaAllocator.init(allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var seen: std.StringHashMapUnmanaged(void) = .empty;
+    var output: std.Io.Writer.Allocating = .init(allocator);
+    defer output.deinit();
+    output.writer.writeAll("#include \"qbe_runtime.h\"\n_Static_assert(sizeof(MylQbeRcSlot)==32, \"journal template ABI\");\n") catch return error.OutOfMemory;
+    for (program.functions) |function| {
+        if (function.policy.c_abi or function.policy.host != null or function.scope.instructions.len == 0) continue;
+        var scratch = std.heap.ArenaAllocator.init(a);
+        defer scratch.deinit();
+        const work = scratch.allocator();
+        const ir = try @import("native_ir.zig").analyze(work, program, function);
+        var catalog = try shapes.Catalog.init(work, layouts);
+        const template = try describe(work, &catalog, function.scope.locals, ir.stack_capacity + 2);
+        if (seen.contains(template.symbol)) continue;
+        try seen.put(a, try a.dupe(u8, template.symbol), {});
+        output.writer.print("const MylQbeRcSlot {s}[{d}] = {{\n{s}}};\n", .{ template.symbol, template.count, template.body }) catch return error.OutOfMemory;
+    }
+    return output.toOwnedSlice();
+}
diff --git a/src/qbe_rc_templates_test.zig b/src/qbe_rc_templates_test.zig
new file mode 100644
index 00000000..dbe2efe2
--- /dev/null
+++ b/src/qbe_rc_templates_test.zig
@@ -0,0 +1,49 @@
+//! Initial RC metadata templates preserve typed cleanup and cache identity.
+const std = @import("std");
+const compiler = @import("compiler.zig");
+const runtime = @import("runtime_mode.zig");
+const native = @import("native_types.zig");
+const shapes = @import("rc_shape.zig");
+const templates = @import("qbe_rc_templates.zig");
+const t = std.testing;
+
+// spec: RC-JOURNAL-TEMPLATE-1
+test "RC journal templates replace initial metadata stores and retain dynamic binding" {
+    const saved = runtime.get();
+    defer runtime.set(saved);
+    runtime.set(.rc);
+    var compilation = try compiler.Compilation.init(t.allocator, "rc_templates.my",
+        \\def total(values: list[int]) -> int:
+        \\    result = 0
+        \\    for value in values:
+        \\        result += value
+        \\    return result
+        \\def main() -> int:
+        \\    return total([1, 2])
+    );
+    defer compilation.deinit();
+    const text = try compilation.emitQbe(t.allocator);
+    defer t.allocator.free(text);
+    try t.expect(std.mem.indexOf(u8, text, "const MylQbeRcSlot myl_rc_journal_v1_") != null);
+    try t.expect(std.mem.indexOf(u8, text, "call $memcpy(l %rcentries, l extern $myl_rc_journal_v1_") != null);
+    try t.expect(std.mem.indexOf(u8, text, "call $memset(l %rcentries") == null);
+    try t.expect(std.mem.indexOf(u8, text, "call $myl_qbe_rc_frame_enter") != null);
+}
+
+// spec-case: RC-JOURNAL-TEMPLATE-1
+test "RC journal templates hash complete ordered local types and all physical extra entries" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var layouts = try native.Catalog.initRecords(a, &.{});
+    defer layouts.deinit();
+    var catalog = try shapes.Catalog.init(a, &layouts);
+    const first = try templates.describe(a, &catalog, &.{.{ .name = "n", .declaration = .{ .start = 0, .end = 0 }, .mutable = false, .ty = .i64 }}, 3);
+    const repeat = try templates.describe(a, &catalog, &.{.{ .name = "renamed", .declaration = .{ .start = 0, .end = 0 }, .mutable = false, .ty = .i64 }}, 3);
+    const changed = try templates.describe(a, &catalog, &.{.{ .name = "n", .declaration = .{ .start = 0, .end = 0 }, .mutable = false, .ty = .bool }}, 3);
+    const wider = try templates.describe(a, &catalog, &.{.{ .name = "n", .declaration = .{ .start = 0, .end = 0 }, .mutable = false, .ty = .i64 }}, 4);
+    try t.expectEqual(@as(usize, 4), first.count);
+    try t.expectEqualStrings(first.symbol, repeat.symbol);
+    try t.expect(!std.mem.eql(u8, first.symbol, changed.symbol));
+    try t.expect(!std.mem.eql(u8, first.symbol, wider.symbol));
+}
