+# Capturing two locals plus a parameter walks the sorted open-upvalue chain;
+# one local closes at a block boundary and the rest close on function return.
+public def test_run_upvalues_across_block_and_return(out: Stream) -> bool:
+    source = b"var captured;\nfun outer(n) {\n  var first = 1;\n  { var second = 2;\n    fun pair() { first = first + 1; second = second + 2; return first + second + n; }\n    captured = pair;\n  }\n  var x = captured();\n  return captured;\n}\nvar f = outer(3); print f(); print f();\n"
+    vm = driver.run_source(source, driver.Engine.VM, True, out, None)
+    tree = driver.run_source(source, driver.Engine.TREE, True, out, None)
+    return vm.status == 0 and tree.status == 0 and vm.stdout == b"12\n15\n" and tree.stdout == vm.stdout and vm.stderr == b"" and tree.stderr == b"" and vm.collections == vm.allocations and tree.collections == tree.allocations
+
+
+# Two child activations return before the parent fails, so the retained
+# activation index must publish the resumed parent's exact error position.
+public def test_run_error_after_child_returns(out: Stream) -> bool:
+    source = b"fun dive(n) {\n  if (n > 0) {\n    var child = dive(n - 1);\n    if (n == 2) return absent;\n    return child + 1;\n  }\n  return 0;\n}\nprint dive(4);\n"
+    expected = b"Undefined variable 'absent'.\n[line 4] in dive()\n[line 3] in dive()\n[line 3] in dive()\n[line 9] in script\n"
+    observed = driver.run_source(source, driver.Engine.VM, True, out, None)
+    return observed.status == 70 and observed.stdout == b"" and observed.stderr == expected
