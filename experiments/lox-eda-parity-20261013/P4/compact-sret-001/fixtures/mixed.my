record Big:
    a: int
    b: int
    c: int
    d: int
    e: int
    f: int
func step(mut big: Big, mut scalar: int, n: int) -> int:
    big.a += n
    scalar += 1
    return big.a + scalar
func main(out: Stream) -> int:
    mut big = Big(a=1, b=2, c=3, d=4, e=5, f=6)
    mut scalar = 10
    out.print(step(mut big, mut scalar, 4), big.a, scalar)
    return 0
