# The tree engine's syntax tree (SPEC §9.1): jlox's Expr and Stmt nodes as
# unions of records held in the Program's node arrays, children named by
# index, with the resolver's slot annotations written back into the nodes.
# Also the expression printer the parser tests use.
#
# Why indices rather than a graph of classes: a function that takes the
# interpreter's state as `mut` next to a read-only node makes mylang prove
# the two type graphs disjoint, and that proof grows exponentially with two
# recursive graphs (see repros/overlap_proof_blowup.my). Node indices keep
# every such call down to integers.
import scanner
import value
export scanner.TokenKind
export scanner.Token

# `hops` for a name the resolver left to the globals table, and `slot` for a
# declaration made at the top level.
public const GLOBAL: int = -1


public record AssignExpr:
    name: scanner.Token
    name_ref: value.ObjRef
    assigned: int
    hops: int
    slot: int


public record BinaryExpr:
    left: int
    operator: scanner.Token
    right: int


public record CallExpr:
    callee: int
    paren: scanner.Token
    arguments: int[]


public record GetExpr:
    target: int
    name: scanner.Token
    name_ref: value.ObjRef


public record GroupingExpr:
    inner: int


# A number, string, boolean or nil. A string literal's value is the parser's
# interned ref; `token` is kept so the printer can show the string's bytes.
public record LiteralExpr:
    constant: value.Value
    token: scanner.Token


public record LogicalExpr:
    left: int
    operator: scanner.Token
    right: int


public record SetExpr:
    target: int
    name: scanner.Token
    name_ref: value.ObjRef
    assigned: int


public record SuperExpr:
    keyword: scanner.Token
    method: scanner.Token
    method_ref: value.ObjRef
    hops: int
    slot: int


public record ThisExpr:
    keyword: scanner.Token
    hops: int
    slot: int


public record UnaryExpr:
    operator: scanner.Token
    right: int


public record VariableExpr:
    name: scanner.Token
    name_ref: value.ObjRef
    hops: int
    slot: int


public enum Expr:
    assign(value: AssignExpr)
    binary(value: BinaryExpr)
    call(value: CallExpr)
    get(value: GetExpr)
    grouping(value: GroupingExpr)
    literal(value: LiteralExpr)
    logical(value: LogicalExpr)
    set(value: SetExpr)
    super_access(value: SuperExpr)
    this(value: ThisExpr)
    unary(value: UnaryExpr)
    variable(value: VariableExpr)


public record BlockStmt:
    statements: int[]
    slot_count: int


# `superclass` is a Variable expression; `methods` are function indices.
public record ClassStmt:
    name: scanner.Token
    name_ref: value.ObjRef
    slot: int
    superclass: int?
    methods: int[]


# A parameter: its token and its interned name.
public record Param:
    name: scanner.Token
    name_ref: value.ObjRef


# A function or method declaration. `slot_count` covers the parameters plus
# the locals declared directly in the body, which shares their scope.
public record FunctionDecl:
    name: scanner.Token
    name_ref: value.ObjRef
    params: Param[]
    body: int[]
    slot: int
    slot_count: int


public record IfStmt:
    condition: int
    then_branch: int
    else_branch: int?


public record ReturnStmt:
    keyword: scanner.Token
    result: int?


public record VarStmt:
    name: scanner.Token
    name_ref: value.ObjRef
    initializer: int?
    slot: int


public record WhileStmt:
    condition: int
    body: int


# `expression` and `print` hold an expression index, `function` a function
# index.
public enum Stmt:
    block(value: BlockStmt)
    class_decl(value: ClassStmt)
    expression(value: int)
    function(value: int)
    if_stmt(value: IfStmt)
    print(value: int)
    return_stmt(value: ReturnStmt)
    var_decl(value: VarStmt)
    while_stmt(value: WhileStmt)


# A parsed script: the node arrays and the top-level statements. A runtime
# TreeFunction names its declaration by its index in `functions`.
public record Program:
    exprs: Expr[]
    stmts: Stmt[]
    functions: FunctionDecl[]
    statements: int[]


public func new_program() -> Program:
    return Program(exprs=[], stmts=[], functions=[], statements=[])


func append_text(mut buffer: byte_buffer, text: bytes):
    _ = buffer.append_range(text, 0, len(text))


func append_token(mut buffer: byte_buffer, source: bytes, token: scanner.Token):
    _ = buffer.append_range(source, token.start, token.start + token.length)


# `(HEAD ` for a node whose head is a fixed word or an operator's lexeme.
func open_form(mut buffer: byte_buffer, head: bytes):
    append_text(mut buffer, b"(")
    append_text(mut buffer, head)
    append_text(mut buffer, b" ")


func write_literal(mut buffer: byte_buffer, source: bytes, literal: LiteralExpr):
    match literal.constant:
        case value.Value.nil:
            append_text(mut buffer, b"nil")
        case value.Value.boolean(value=flag):
            if flag:
                append_text(mut buffer, b"true")
            else:
                append_text(mut buffer, b"false")
        case value.Value.number(value=number):
            append_text(mut buffer, value.format_number(number))
        case value.Value.obj(value=_):
            mut token = literal.token.copy()
            _ = buffer.append_range(source, token.start + 1, token.start + token.length - 1)


func write_operation(mut buffer: byte_buffer, program: Program, source: bytes, operator: scanner.Token, left: int, right: int):
    open_form(mut buffer, scanner.lexeme(source, operator))
    write_expr(mut buffer, program, source, left)
    append_text(mut buffer, b" ")
    write_expr(mut buffer, program, source, right)
    append_text(mut buffer, b")")


func write_expr(mut buffer: byte_buffer, program: Program, source: bytes, id: int):
    match program.exprs[id]:
        case Expr.assign(value=node):
            open_form(mut buffer, b"=")
            append_token(mut buffer, source, node.name)
            append_text(mut buffer, b" ")
            write_expr(mut buffer, program, source, node.assigned)
            append_text(mut buffer, b")")
        case Expr.binary(value=node):
            write_operation(mut buffer, program, source, node.operator, node.left, node.right)
        case Expr.call(value=node):
            open_form(mut buffer, b"call")
            write_expr(mut buffer, program, source, node.callee)
            for argument in node.arguments:
                append_text(mut buffer, b" ")
                write_expr(mut buffer, program, source, argument)
            append_text(mut buffer, b")")
        case Expr.get(value=node):
            open_form(mut buffer, b".")
            write_expr(mut buffer, program, source, node.target)
            append_text(mut buffer, b" ")
            append_token(mut buffer, source, node.name)
            append_text(mut buffer, b")")
        case Expr.grouping(value=node):
            open_form(mut buffer, b"group")
            write_expr(mut buffer, program, source, node.inner)
            append_text(mut buffer, b")")
        case Expr.literal(value=node):
            write_literal(mut buffer, source, node)
        case Expr.logical(value=node):
            write_operation(mut buffer, program, source, node.operator, node.left, node.right)
        case Expr.set(value=node):
            open_form(mut buffer, b".=")
            write_expr(mut buffer, program, source, node.target)
            append_text(mut buffer, b" ")
            append_token(mut buffer, source, node.name)
            append_text(mut buffer, b" ")
            write_expr(mut buffer, program, source, node.assigned)
            append_text(mut buffer, b")")
        case Expr.super_access(value=node):
            open_form(mut buffer, b"super")
            append_token(mut buffer, source, node.method)
            append_text(mut buffer, b")")
        case Expr.this(value=_):
            append_text(mut buffer, b"this")
        case Expr.unary(value=node):
            open_form(mut buffer, scanner.lexeme(source, node.operator))
            write_expr(mut buffer, program, source, node.right)
            append_text(mut buffer, b")")
        case Expr.variable(value=node):
            append_token(mut buffer, source, node.name)


# The parenthesized prefix form of expression `id` (SPEC §9.1).
public func print_expr(program: Program, source: bytes, id: int) -> bytes:
    mut empty: int[] = []
    mut buffer = byte_buffer(empty)
    write_expr(mut buffer, program, source, id)
    return bytes(buffer)
