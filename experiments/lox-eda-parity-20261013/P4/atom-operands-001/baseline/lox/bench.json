{
  "language": "mylang",
  "version": [
    "{mylang}",
    "--features"
  ],
  "env": {
    "XDG_CACHE_HOME": "{cache}/xdg",
    "PYTHONPYCACHEPREFIX": "{cache}/pycache",
    "ZIG_GLOBAL_CACHE_DIR": "{cache}/zig-global",
    "ZIG_LOCAL_CACHE_DIR": "{cache}/zig-local"
  },
  "profiles": {
    "release": {
      "build": [
        "{mylang}",
        "build",
        "main.my",
        "--experimental-zero-rc",
        "--release",
        "-o",
        "{cache}/lox-release",
        "--cache-dir",
        "{cache}/mylang"
      ],
      "binary": "{cache}/lox-release"
    },
    "debug": {
      "build": [
        "{mylang}",
        "build",
        "main.my",
        "--experimental-zero-rc",
        "-o",
        "{cache}/lox-debug",
        "--cache-dir",
        "{cache}/mylang"
      ],
      "binary": "{cache}/lox-debug"
    }
  },
  "test": {
    "run": [
      "sh",
      "-c",
      "\"$0\" test . --experimental-zero-rc --max-steps=100000000 --cache-dir \"$1/test\" && \"$0\" test driver_tests.my --experimental-zero-rc --cases driver_cases.json --max-steps=100000000 --cache-dir \"$1/test\"",
      "{mylang}",
      "{cache}"
    ],
    "force": [
      "sh",
      "-c",
      "\"$0\" test . --experimental-zero-rc --max-steps=100000000 --cache-dir \"$1/test\" --force && \"$0\" test driver_tests.my --experimental-zero-rc --cases driver_cases.json --max-steps=100000000 --cache-dir \"$1/test\" --force",
      "{mylang}",
      "{cache}"
    ]
  },
  "edits": {
    "hub_comment": {
      "file": "value.my",
      "find": "# True exactly for nil and false.\n",
      "replace": "# True exactly for nil and false.\n# (Lox has no other falsey values.)\n"
    },
    "leaf_body": {
      "file": "natives.my",
      "find": "                    return value.Value.number(value=float(instant.unix_nanoseconds) / 1000000000.0)\n",
      "replace": "                    const seconds = float(instant.unix_nanoseconds) / 1000000000.0\n                    return value.Value.number(value=seconds)\n"
    },
    "hub_body": {
      "file": "value.my",
      "find": "                case Value.number(value=right):\n                    return left == right\n",
      "replace": "                case Value.number(value=right):\n                    const same = left == right\n                    return same\n"
    },
    "hub_interface": {
      "file": "value.my",
      "find": "# The shortest round-trip digits",
      "replace": "# Lox inequality, the negation of `values_equal`.\npublic func values_not_equal(a: Value, b: Value) -> bool:\n    return not values_equal(a, b)\n\n\n# The shortest round-trip digits"
    }
  }
}
