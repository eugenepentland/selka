+# Operand atoms keep the ordinary checked read and push sequence. Complex and
+# global expressions return False so the caller retains full evaluation.
+func try_push_atom(program: ast.Program, mut rt: heap.Runtime, id: int) -> bool:
+    match program.exprs[id]:
+        case ast.Expr.literal(value=node):
+            heap.push(mut rt, node.constant)
+            return True
+        case ast.Expr.variable(value=node):
+            if node.hops != ast.GLOBAL:
+                mut env = env_at(rt, node.hops)
+                mut item = heap.env_slot(rt, env, node.slot)
+                heap.push(mut rt, item)
+                return True
+        case _:
+            pass
+    return False
+
