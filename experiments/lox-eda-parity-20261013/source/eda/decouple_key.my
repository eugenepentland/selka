
import support_strs as strs
import support_parse as parse_mod

# The pad encoded by a per-pin decoupling origin key, and capacitance SI
# prefixes, have one owner so ERC, placement and export cannot drift.
public func bulk_farads() -> float:
    return 4.7e-6


public func pin_from_origin(origin_key: bytes) -> bytes?:
    mut at = origin_key.find(b"@")
    if at < 0:
        return None
    mut hash_ = strs.index_of_scalar_pos(origin_key, at + 1, 35)
    if hash_ < 0:
        return None
    mut pin = origin_key[at + 1:hash_]
    if len(pin) == 0:
        return None
    return Some(pin)


public func cap_farads(s: bytes) -> float:
    mut i = 0
    while i < len(s) and (strs.is_digit(s[i]) or s[i] == 46):
        i += 1
    if i == 0 or i >= len(s):
        return 0.0
    mut number = parse_mod.parse_float(strs.text(s[0:i]))
    if number is None:
        return 0.0
    # UTF-8 micro sign U+00B5 is a u-equivalent.
    if s[i] == 194 and i + 1 < len(s) and s[i + 1] == 181:
        return number * 1e-6
    mut prefix = s[i]
    if prefix == 112 or prefix == 80:
        return number * 1e-12
    if prefix == 110 or prefix == 78:
        return number * 1e-9
    if prefix == 117 or prefix == 85:
        return number * 1e-6
    if prefix == 109:
        return number * 1e-3
    return 0.0
