
import support_float_fmt as ff

# The float table of PORTING.md ("Float formatting"): Zig rounds the shortest
# digits half up, exact-binary rounding (Go, Rust, strings.format_float) does not.
public func test_prec_rounds_the_shortest_digits_half_up() -> bool:
    if ff.fmt_float_prec(0.15, 1) != "0.2" or ff.fmt_float_prec(0.15, 2) != "0.15":
        return False
    if ff.fmt_float_prec(0.25, 1) != "0.3" or ff.fmt_float_prec(0.25, 2) != "0.25":
        return False
    if ff.fmt_float_prec(1.005, 1) != "1.0" or ff.fmt_float_prec(1.005, 2) != "1.01":
        return False
    if ff.fmt_float_prec(2.675, 1) != "2.7" or ff.fmt_float_prec(2.675, 2) != "2.68":
        return False
    if ff.fmt_float_prec(-1.25, 1) != "-1.3" or ff.fmt_float_prec(-1.25, 2) != "-1.25":
        return False
    return ff.fmt_float_prec(2.5, 0) == "3"


public func test_prec_pads_carries_and_keeps_the_sign_of_zero() -> bool:
    if ff.fmt_float_prec(-0.0, 1) != "-0.0" or ff.fmt_float_prec(-0.0, 2) != "-0.00":
        return False
    if ff.fmt_float_prec(1.0, 4) != "1.0000" or ff.fmt_float_prec(9.99, 1) != "10.0":
        return False
    if ff.fmt_float_prec(99.96, 1) != "100.0" or ff.fmt_float_prec(0.0004, 3) != "0.000":
        return False
    return ff.fmt_float_prec(0.0005, 3) == "0.001"


public func test_plain_d_is_shortest_digits_without_an_exponent() -> bool:
    if ff.fmt_float(1.0) != "1" or ff.fmt_float(-0.0) != "-0":
        return False
    if ff.fmt_float(0.5) != "0.5" or ff.fmt_float(1.5e-7) != "0.00000015":
        return False
    return ff.fmt_float(1000000.0) == "1000000"
