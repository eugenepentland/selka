

# Byte-identical fixtures; D5 literals of at most 256 bytes.
public func vendor_flat() -> bytes:
    mut parts: bytes[] = [b"(kicad_symbol_lib (version 20211014) (generator SamacSys_ECAD_Model)\n  (symbol \"ACME-3\" (in_bom yes) (on_board yes)\n    (property \"Reference\" \"U\" (at 29.21 7.62 0)\n      (effects (font (size 1.27 1.27)) (justify left top))\n    )\n", b"    (property \"Value\" \"ACME-3\" (at 29.21 5.08 0)\n      (effects (font (size 1.27 1.27)) (justify left top))\n    )\n    (property \"Footprint\" \"SOT95P260X110-3N\" (at 29.21 -94.92 0)\n      (effects (font (size 1.27 1.27)) (justify left top) hide)\n    )\n", b"    (rectangle\n      (start 5.08 2.54)\n      (end 27.94 -5.08)\n      (stroke (width 0.254) (type default))\n      (fill (type background))\n    )\n    (pin passive line (at 0 0 0) (length 5.08)\n      (name \"G\" (effects (font (size 1.27 1.27))))\n", b"      (number \"1\" (effects (font (size 1.27 1.27))))\n    )\n    (pin passive line (at 0 -2.54 0) (length 5.08)\n      (name \"S\" (effects (font (size 1.27 1.27))))\n      (number \"2\" (effects (font (size 1.27 1.27))))\n    )\n", b"    (pin passive line (at 33.02 0 180) (length 5.08)\n      (name \"D\" (effects (font (size 1.27 1.27))))\n      (number \"3\" (effects (font (size 1.27 1.27))))\n    )\n  )\n)\n"]
    return b"".join(parts)


