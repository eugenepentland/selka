+# Read the section in a bounded call; only independently owned keys leave it.
+func attachment_section_nets(sec: env_mod.Section) -> set[str]:
+    mut nets: set[str] = set()
+    for pg in sec.pin_groups:
+        for pin in pg.pins:
+            nets.add(strs.text(pin.net))
+    for port in sec.ports:
+        nets.add(strs.text(port.name))
+    return nets
+
+
+# The caller needs a scalar category, never an owned section snapshot.
+func attachment_section_is_connector(sec: env_mod.Section) -> bool:
+    return rb.classify_by_name(sec.name, sec.instances) == rb.Category.connector
+
+
