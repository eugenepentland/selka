record Env:
    slots: int[]

enum Obj:
    free
    env(value: Env)

func allocate_owned(mut objects: Obj[], obj: Obj):
    objects.append(obj)

func main(out: Stream) -> int:
    mut objects: Obj[] = []
    allocate_owned(mut objects, Obj.env(value=Env(slots=[1])))
    match objects[0]:
        case Obj.env(value=payload):
            out.print(payload.slots[0])
        case _:
            return 1
    return 0
