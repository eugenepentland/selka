record Env:
    slots: int[]

enum Obj:
    free
    env(value: Env)

func set_slot(mut objects: dict[int, Obj], index: int):
    mut removed = objects.pop(index)
    match removed:
        case Obj.env(value=payload):
            mut updated = payload
            updated.slots[0] = 2
            objects[index] = Obj.env(value=updated)
        case _:
            objects[index] = removed
            assert False

func main(out: Stream) -> int:
    mut objects = {0: Obj.env(value=Env(slots=[1]))}
    mut saved = objects.copy()
    set_slot(mut objects, 0)
    match objects[0]:
        case Obj.env(value=payload):
            out.print(payload.slots[0])
        case _:
            return 1
    match saved[0]:
        case Obj.env(value=payload):
            out.print(payload.slots[0])
        case _:
            return 1
    return 0
