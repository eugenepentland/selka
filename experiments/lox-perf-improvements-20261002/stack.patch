+public def test_stack_full_capacity_and_negative_index_reads() -> bool:
+    rt = heap.new_runtime(False, None)
+    i = 0
+    while i < heap.STACK_MAX:
+        heap.push(mut rt, value.Value.number(float(i)))
+        i += 1
+    full = heap.peek(rt, 0) == value.Value.number(float(heap.STACK_MAX - 1)) and heap.peek(rt, heap.STACK_MAX - 1) == value.Value.number(0.0)
+    last = heap.pop(mut rt)
+    return full and last == value.Value.number(float(heap.STACK_MAX - 1)) and rt.stack_top == heap.STACK_MAX - 1 and rt.stack[-1] == last
