+# Stack reads and writes retain normal list value semantics even after helper
+# fusion in VM arithmetic; publishing a snapshot must still detach on write.
+public def test_stack_snapshot_survives_write() -> bool:
+    rt = heap.new_runtime(False, None)
+    heap.push(mut rt, value.Value.number(11.0))
+    snapshot = rt.stack
+    heap.push(mut rt, value.Value.number(22.0))
+    popped = heap.pop(mut rt)
+    rt.stack[0] = value.Value.number(33.0)
+    return len(snapshot) == heap.STACK_MAX and snapshot[0] == value.Value.number(11.0) and snapshot[1] == value.Value.nil and popped == value.Value.number(22.0) and heap.peek(rt, 0) == value.Value.number(33.0) and rt.stack_top == 1
+
