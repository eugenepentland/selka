+# The chain starts in the last slot and wraps through deleted entries.
+# A read must cross tombstones, stop at an empty slot, and see replacements.
+public def test_table_read_probe_wraparound_tombstones() -> bool:
+    t = table.new_table()
+    _ = table.set(mut t, 100, 7u32, value.Value.number(1.0))
+    _ = table.set(mut t, 200, 7u32, value.Value.nil)
+    _ = table.set(mut t, 300, 7u32, value.Value.boolean(False))
+    _ = table.set(mut t, 400, 7u32, value.Value.number(4.0))
+    _ = table.delete(mut t, 100, 7u32)
+    _ = table.delete(mut t, 300, 7u32)
+    nil_present = table.get(t, 200, 7u32) == Some(value.Value.nil)
+    tail_present = table.get(t, 400, 7u32) == Some(value.Value.number(4.0))
+    missing = table.get(t, 500, 7u32).is_none() and table.get(t, value.NO_OBJ, 7u32).is_none()
+    _ = table.set(mut t, 400, 7u32, value.Value.number(9.0))
+    _ = table.set(mut t, 500, 7u32, value.Value.boolean(True))
+    return nil_present and tail_present and missing and table.get(t, 400, 7u32) == Some(value.Value.number(9.0)) and table.get(t, 500, 7u32) == Some(value.Value.boolean(True))
