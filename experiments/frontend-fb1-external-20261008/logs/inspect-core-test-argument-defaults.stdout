284-/// The usage error for the flag at `args[start]` whose value (after `=`, or the
285-/// argument at `index`) is not one the flag accepts (NEW-CORE-S5-TEST-USAGE-1).
286-fn invalidValue(init: std.process.Init, args: []const []const u8, start: usize, index: usize) Error!u8 {
287-    const arg = args[start];
288-    const split = std.mem.indexOfScalar(u8, arg, '=');
289-    const value = if (split) |at| arg[at + 1 ..] else if (index > start) args[index] else "";
290-    return testUsage(init, try std.fmt.allocPrint(init.arena.allocator(), "invalid value '{s}' for {s}", .{ value, arg[0 .. split orelse arg.len] }));
291-}
