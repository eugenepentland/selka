277-/// Print `mylang test: PROBLEM` (when there is one) and the test usage; status 2.
278-fn testUsage(init: std.process.Init, problem: ?[]const u8) Error!u8 {
279-    const text = if (problem) |line| try std.fmt.allocPrint(init.arena.allocator(), "mylang test: {s}\n" ++ test_usage, .{line}) else test_usage;
280-    try std.Io.File.stderr().writeStreamingAll(init.io, text);
281-    return 2;
282-}
