293-/// Whether `arg` is a `mylang test` flag that reads the next argument as its value.
294-fn takesValue(arg: []const u8) bool {
295-    const valued = [_][]const u8{ "--filter", "--cases", "--jobs", "--mode", "--max-steps", "--max-frames", "--max-memory", "--timeout-ms", "--seed", "--property-runs", "--link", "--zig", cache_dir_flag, "--against" };
296-    for (valued) |name| if (std.mem.eql(u8, arg, name)) return true;
297-    return false;
298-}
