diff --git a/src/core/fuse_text.zig b/src/core/fuse_text.zig
index 85c30f8e6..ee56cba21 100644
--- a/src/core/fuse_text.zig
+++ b/src/core/fuse_text.zig
@@ -69,6 +69,7 @@ pub fn cursors(arena: std.mem.Allocator, module: *ir.Module, f: *ir.Function) st
                 changed += 1;
             }
         }
+        try hoistWidth(arena, module, f, loop, source, offset, width);
     }
     changed += try scalar.run(arena, module, f);
     return changed;
@@ -85,3 +86,27 @@ fn append(arena: std.mem.Allocator, f: *ir.Function, inst: ir.Inst) std.mem.Allo
     try f.insts.append(arena, inst);
     return ref;
 }
+
+// A successful located character read proves the same position can supply its
+// width. Place the pure width read before body calls can hide that shared load
+// from LLVM, only when the character dominates every latch path and the source
+// and its owners cannot change. Wider functions retain the original placement.
+fn hoistWidth(a: std.mem.Allocator, module: *const ir.Module, f: *ir.Function, loop: ir.Loop, source: ir.Ref, offset: ir.Ref, width: ir.Ref) !void {
+    if (!module.zero_rc or f.insts.items.len > 4096 or f.loops.items.len > 32) return;
+    if (try @import("fuse_slice_key.zig").updated(a, f, module, source)) return;
+    for (f.blocks.items, 0..) |block, bi| {
+        for (block.insts.items) |ref| {
+            const character = f.inst(ref);
+            if (character.op != .str_char) continue;
+            if (f.resolve(character.a) != source or f.resolve(character.b) != offset) continue;
+            if (!try @import("own.zig").dominatesBlock(a, f, @intCast(bi), @intCast(loop.latch.index()))) continue;
+            const latch = &f.blocks.items[loop.latch.index()].insts;
+            const old = std.mem.indexOfScalar(ir.Ref, latch.items, width) orelse return;
+            _ = latch.orderedRemove(old);
+            const reads = &f.blocks.items[bi].insts;
+            const at = std.mem.indexOfScalar(ir.Ref, reads.items, ref) orelse unreachable;
+            try reads.insert(a, at + 1, width);
+            return;
+        }
+    }
+}
