def nested(xs: mut list[list[int]], ys: mut list[int]) -> int:
    xs.append([5])
    row = xs[0]
    ys.append(9)
    ys[0] = 77
    return len(row) * 100 + row[0]

def same(xs: mut list[list[int]], ys: mut list[list[int]]) -> int:
    xs.append([5])
    row = xs[0]
    ys[0].append(9)
    return len(row) * 100 + row[0]

def main(out: Stream) -> int:
    a = [[1, 2], [3]]
    out.print(nested(mut a, mut a[0]), a)
    b = [[1, 2], [3]]
    out.print(same(mut b, mut b), b)
    return 0
