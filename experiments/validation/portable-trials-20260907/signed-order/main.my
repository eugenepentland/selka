module main;
import std_order;
fn entry(id: i64) -> std_order::Item {
    let mut length = 1u64;
    if id == 6 {
        length = 2u64;
    }
    return new std_order::Item {
        value: id,
        first: cast<u64>(id) * 2u64,
        first_len: 1u64,
        second: cast<u64>(id) * 2u64 + 1u64,
        second_len: length
    };
}
fn main() -> i64 {
    // IDs 0..6: (-1000,z), (0,z), (1000,a), (-1000,a),
    // (0,a), (1000,z), (0,aa). The final secondary key has length two.
    let data = new [15]i64[- 1000, 122, 0, 122, 1000, 97, - 1000, 97, 0, 97, 1000, 122, 0, 97, 97];
    let expected_sorted = new [7]i64[3, 0, 4, 6, 1, 2, 5];
    let mut items = new [7]std_order::Item[entry(0), entry(1), entry(2), entry(3), entry(4), entry(5), entry(6)];
    borrow data[0..15] as keys {
        borrow expected_sorted[0..7] as expected {
            borrow mut items[0..7] as values {
                if !std_order::sort(keys, values, 0u64, 7u64) {
                    return - 1;
                }
                let mut at = 0u64;
                while at < 7u64 {
                    if read_slice(values, at).value != read_slice(expected, at) {
                        return - 2;
                    }
                    at += 1u64;
                }
            }
        }
        // Nonnegative operations push an ID; -1 pops the current minimum.
        let operations = new [14]i64[2, 1, 0, - 1, 4, 3, - 1, - 1, 6, 5, - 1, - 1, - 1, - 1];
        let expected_pops = new [7]i64[0, 3, 4, 6, 1, 2, 5];
        borrow operations[0..14] as commands {
            borrow expected_pops[0..7] as expected {
                borrow mut items[0..7] as heap {
                    let mut count = 0u64;
                    let mut popped = 0u64;
                    let mut at = 0u64;
                    while at < len_slice(commands) {
                        let command = read_slice(commands, at);
                        if command >= 0 {
                            if !std_order::heap_push(keys, heap, count, entry(command)) {
                                return - 3;
                            }
                            count += 1u64;
                        } else {
                            let result = std_order::heap_pop(keys, heap, count, entry(0));
                            if !result.found || popped >= len_slice(expected) {
                                return - 4;
                            }
                            if result.value.value != read_slice(expected, popped) {
                                return - 5;
                            }
                            count = result.count;
                            popped += 1u64;
                        }
                        at += 1u64;
                    }
                    if count != 0u64 || popped != 7u64 {
                        return - 6;
                    }
                    if std_order::heap_pop(keys, heap, 0u64, entry(0)).found {
                        return - 7;
                    }
                }
            }
        }
    }
    return 42;
}
