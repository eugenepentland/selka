buffer B: u8;
result Open {
    ok: B,
    err: i64
}
buffer Vec < T: storable >: T;
result Created<T: storable> {
    ok: Vec<T>,
    err: i64
}
result Taken<T: storable> {
    ok: T,
    err: i64
}
result Status {
    ok: bool,
    err: i64
}
result Answer {
    ok: i64,
    err: i64
}
fn child(heap: allocator, n: u8) -> Open {
    let mut value = try acquire_buffer<Open>(heap, 1);
    discard try append_buffer<Status>(value, n);
    return new Open.ok(value);
}
fn work(heap: allocator) -> Answer {
    let mut outer = try acquire_buffer<Created<B>>(heap, 2);
    discard try append_buffer<Status>(outer, try child(heap, 1u8));
    discard try append_buffer<Status>(outer, try child(heap, 2u8));
    match append_buffer<Status>(outer, try child(heap, 3u8)) {
        Status.ok(discard) => {
            return new Answer.ok(- 1);
        },
        Status.err(code) => {
            if code != 2 {
                return new Answer.ok(- 2);
            }
        }
    }
    discard try reserve_buffer<Status>(outer, heap, 4);
    discard try append_buffer<Status>(outer, try child(heap, 4u8));
    discard try write_buffer<Status>(outer, 0, try child(heap, 42u8));
    match write_buffer<Status>(outer, 10, try child(heap, 5u8)) {
        Status.ok(discard) => {
            return new Answer.ok(- 3);
        },
        Status.err(code) => {
            if code != 3 {
                return new Answer.ok(- 4);
            }
        }
    }
    match truncate_buffer<Status>(outer, 9) {
        Status.ok(discard) => {
            return new Answer.ok(- 5);
        },
        Status.err(code) => {
            if code != 3 {
                return new Answer.ok(- 6);
            }
        }
    }
    if len_buffer(outer) != 3u64 {
        return new Answer.ok(- 7);
    }
    let last = try take_buffer<Taken<B>>(outer, 1);
    if read_buffer(last, 0) != 2u8 {
        return new Answer.ok(- 8);
    }
    let swapped = try take_buffer<Taken<B>>(outer, 1);
    if read_buffer(swapped, 0) != 4u8 {
        return new Answer.ok(- 9);
    }
    discard try append_buffer<Status>(outer, try child(heap, 6u8));
    discard try truncate_buffer<Status>(outer, 1);
    let answer = try take_buffer<Taken<B>>(outer, 0);
    if len_buffer(outer) != 0u64 {
        return new Answer.ok(- 10);
    }
    return new Answer.ok(i64(read_buffer(answer, 0)));
}
fn once(heap: allocator) -> i64 {
    match work(heap) {
        Answer.ok(n) => {
            return n;
        },
        Answer.err(code) => {
            return code;
        }
    }
}

fn main(heap:allocator)->i64{let mut total=0;let mut i=0;while i<2000{total+=once(heap);i+=1;}return total;}
