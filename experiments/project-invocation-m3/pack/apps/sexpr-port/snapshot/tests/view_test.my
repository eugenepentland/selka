module tests.view_test

# Tests for sexpr.view, the source-range type every AST leaf now carries.
#
# A view is the representation change the reader is built on, so its contract is
# tested on its own: a range that never copies its source, a text conversion
# that reports invalid UTF-8 instead of substituting, comparisons against a
# fixed word, and a byte/range length that counts the source rather than the
# decoded scalars.

import sexpr.view as view


def text_in(found: view.View) -> str:
    match view.text_of(found):
        case Ok(text):
            return text
        case Err(_):
            return "<invalid>"


public def test_range_length_and_first_byte() -> bool:
    source = b"alpha beta"
    whole = view.View(source=source, start=0, end=len(source))
    word = view.View(source=source, start=6, end=10)
    return view.view_len(whole) == 10 and view.view_len(word) == 4 and view.first_byte(word) == 98


# An empty view has no first byte. -1 is the missing-byte sentinel the
# tokenizer's peek already uses, so no real byte can collide with it.
public def test_empty_view_has_no_first_byte() -> bool:
    empty = view.at(b"abc", 3)
    return view.view_len(empty) == 0 and view.first_byte(empty) == -1 and view.first_byte(view.at(b"abc", 9)) == -1


public def test_text_conversion_reports_the_range() -> bool:
    source = "héllo".encode()
    # `é` is two bytes, so a range that starts at byte 1 is a valid scalar and
    # one that starts at byte 2 is not: the boundaries are byte boundaries.
    first = view.View(source=source, start=0, end=3)
    rest = view.View(source=source, start=1, end=3)
    return text_in(first) == "hé" and text_in(rest) == "é" and text_in(view.at(source, 0)) == ""


# A range that is not UTF-8 is reported, never replaced: the caller decides
# whether an invalid spelling is a diagnostic or a pass-through.
public def test_invalid_utf8_is_reported() -> bool:
    source = b"a\xffb"
    broken = view.View(source=source, start=1, end=2)
    return text_in(broken) == "<invalid>" and view.view_len(broken) == 1


public def test_matches_a_fixed_word_without_decoding_it() -> bool:
    source = b"(>= 3.3V)"
    operator = view.View(source=source, start=1, end=3)
    return view.matches(operator, ">=") and not view.matches(operator, ">") and not view.matches(operator, " <")


public def test_equal_compares_content_not_identity() -> bool:
    source = b"net net gnd"
    first = view.View(source=source, start=0, end=3)
    second = view.View(source=source, start=4, end=7)
    third = view.View(source=source, start=8, end=11)
    same_bytes_elsewhere = view.View(source=b"net", start=0, end=3)
    return view.equal(first, second) and not view.equal(first, third) and view.equal(first, same_bytes_elsewhere)


public def test_take_and_skip_clamp_to_the_range() -> bool:
    source = b"0123456789"
    middle = view.View(source=source, start=2, end=6)
    return (view.view_len(view.take(middle, 2)) == 2 and text_in(view.take(middle, 2)) == "23" and text_in(view.take(middle, 99)) == "2345" and text_in(view.take(middle, 0)) == "" and text_in(view.take(middle, -3)) == "" and text_in(view.skip(middle, 2)) == "45" and text_in(view.skip(middle, 99)) == "" and text_in(view.skip(middle, -1)) == "2345")


# `through` joins a range that starts after another one ends, so a keyword and
# the token following it become one range with no copy. A reversed pair, or a
# pair from different buffers, is empty.
public def test_through_joins_adjacent_ranges() -> bool:
    source = b"name=value"
    name = view.View(source=source, start=0, end=4)
    value = view.View(source=source, start=5, end=10)
    other_buffer = view.View(source=b"value", start=0, end=5)
    return (text_in(view.through(name, value)) == "=value" and text_in(view.through(value, name)) == ""
            and text_in(view.through(name, other_buffer)) == ""
            and text_in(view.through(name, view.at(source, 10))) == "=value")
