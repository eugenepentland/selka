record Node:
    mapping: dict[int,int]
    child: Option[Node]

def through(value: Option[Node]) -> Option[Node]:
    return value

def main(out: Stream) -> int:
    original: Option[Node] = Some(Node({1:7}, None))
    kept: list[Option[Node]] = [original]
    if original is not None:
        live = original.mapping.values()
        original.mapping[1] = 13
        out.print(list(live))
        out.print(original.mapping[1])
    saved = kept[0]
    if saved is not None:
        out.print(saved.mapping[1])
    return 0
