diff --git a/tests/lang/rc_journal_types.my b/tests/lang/rc_journal_types.my
new file mode 100644
index 00000000..6cc542b3
--- /dev/null
+++ b/tests/lang/rc_journal_types.my
@@ -0,0 +1,37 @@
+module rc_journal_types
+
+record Mixed:
+    values: list[int]
+    view: DictValues[int, list[int]]
+
+
+def rebuilt(mapping: dict[int, list[int]], count: int) -> Mixed:
+    result = Mixed([0], mapping.values())
+    for index in range(count):
+        if index % 2 == 0:
+            result = Mixed([index, index + 1], mapping.values())
+        else:
+            saved = result
+            result = Mixed(list(saved.view)[0], mapping.values())
+    return result
+
+
+# spec: RC-STABLE-JOURNAL-1
+public def test_reused_constructor_values_keep_their_current_cleanup_roles() -> bool:
+    mapping = {1: [7, 8]}
+    result = rebuilt(mapping, 6)
+    mapping[1] = [9]
+    return result.values == [7, 8] and list(result.view) == [[9]]
+
+
+def escaped() -> Mixed:
+    with arena() as scratch:
+        mapping = {1: [3, 4]}
+        value = rebuilt(mapping, 5)
+        return scratch.escape(value)
+
+
+# spec-case: RC-STABLE-JOURNAL-1
+public def test_reused_owners_and_held_values_escape_with_valid_storage() -> bool:
+    result = escaped()
+    return result.values == [4, 5] and list(result.view) == [[3, 4]]
