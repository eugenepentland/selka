+
+// spec: RC-EMPTY-FRAME-1
+test "RC empty frame slots omit speculative descriptors until publication" {
+    const saved = runtime.get();
+    defer runtime.set(saved);
+    runtime.set(.rc);
+    var compilation = try compiler.Compilation.init(t.allocator, "rc_empty_frame.my",
+        \\def append_count(values: mut list[int], item: int) -> int:
+        \\    values.append(item)
+        \\    return len(values)
+        \\def main() -> int:
+        \\    values: list[int] = []
+        \\    return append_count(mut values, 7)
+    );
+    defer compilation.deinit();
+    const emitted = try compilation.emitQbe(t.allocator);
+    defer t.allocator.free(emitted);
+    var manifest = try std.json.parseFromSlice(Manifest, t.allocator, emitted, .{ .ignore_unknown_fields = true });
+    defer manifest.deinit();
+    const text = try findFunction(manifest.value, "append_count");
+    var layouts = try @import("native_types.zig").Catalog.initRecords(t.allocator, compilation.program.?.records);
+    defer layouts.deinit();
+    const unit = try @import("native_descriptors.zig").symbol(t.allocator, &layouts, .unit);
+    defer t.allocator.free(unit);
+    try t.expect(std.mem.indexOf(u8, text, unit) == null);
+    try t.expect(std.mem.indexOf(u8, text, "call $myl_qbe_rc_frame_enter") != null);
+    try t.expect(std.mem.indexOf(u8, text, "call $myl_qbe_rc_frame_cleanup") != null);
+}
