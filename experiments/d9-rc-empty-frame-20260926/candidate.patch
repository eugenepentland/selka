+// Uninitialized entries need only a readable guard. Publication writes their
+// complete type/address/role before setting that guard, so empty frame cleanup
+// never consults speculative unit metadata or operand addresses.
+fn emptyEntry(comptime E: type, self: *E, index: usize) Error!void {
+    const at_guard = self.temp();
+    try self.print(" %v{d} =l add %rcentries, {d}\n", .{ at_guard, index * entry_bytes + 16 });
+    try self.print(" storel %v{d}, %v{d}\n", .{ try guard(E, self, index), at_guard });
+}
