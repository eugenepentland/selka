+# A copied Runtime and a separately saved env payload are value snapshots.
+# Updating the live heap must preserve each, including untouched slots.
+public def test_env_indexed_set_preserves_runtime_and_payload_snapshots() -> bool:
+    rt = heap.new_runtime(False, None)
+    ref = heap.allocate(mut rt, object.Obj.env(object.new_env(value.NO_OBJ, 2)))
+    heap.set_env_slot(mut rt, ref, 0, value.Value.number(1.0))
+    heap.set_env_slot(mut rt, ref, 1, value.Value.number(2.0))
+    before = rt
+    payload = heap.env_obj(rt, ref)
+    heap.set_env_slot(mut rt, ref, 0, value.Value.number(9.0))
+    live = heap.env_slot(rt, ref, 0) == value.Value.number(9.0) and heap.env_slot(rt, ref, 1) == value.Value.number(2.0)
+    saved = heap.env_slot(before, ref, 0) == value.Value.number(1.0) and heap.env_slot(before, ref, 1) == value.Value.number(2.0)
+    return live and saved and payload.slots[0] == value.Value.number(1.0) and payload.slots[1] == value.Value.number(2.0)
