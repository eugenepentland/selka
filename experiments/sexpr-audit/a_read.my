module a_read

# Audit driver: read the input only, so the read cost can be subtracted from
# every later phase. Prints one short line; nothing is parsed.
def main(args: list[str], fs: Filesystem, out: Stream, err: Stream) -> int:
    source = b""
    match read_file(fs, args[0]):
        case Ok(data):
            source = data
        case Err(problem):
            err.print("read failed", problem)
            return 2
    out.print(f"bytes={len(source)}")
    return 0
