module i_index

# Index every byte and accumulate it; no comparison branch. Isolates the cost of
# a `bytes[i]` read in generated code.
def main(args: list[str], fs: Filesystem, out: Stream, err: Stream) -> int:
    source = b""
    match read_file(fs, args[0]):
        case Ok(data):
            source = data
        case Err(problem):
            err.print("read failed", problem)
            return 2
    size = len(source)
    total = 0
    index = 0
    while index < size:
        total = total + source[index]
        index = index + 1
    out.print(f"bytes={size} total={total}")
    return 0
