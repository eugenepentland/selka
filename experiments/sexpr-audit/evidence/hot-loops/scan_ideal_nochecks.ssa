data $fmt = { b "bytes=%ld delims=%ld\n", b 0 }
export function w $main(w %argc, l %argv) {
@start
 %pp =l add %argv, 8
 %path =l loadl %pp
 %fd =w call $open(l %path, w 0)
 %buf =l call $malloc(l 2000000)
 %n =l call $read(w %fd, l %buf, l 2000000)
 # fake managed bytes header: length at 0, storage at 32
 %hdr =l alloc8 40
 storel %n, %hdr
 %hs =l add %hdr, 32
 storel %buf, %hs
 # frame block holding the traced local `source` (memory-resident, address escapes)
 %frame =l alloc8 64
 storel %hdr, %frame
 %ctxdummy =l alloc8 64
 call $myl_fake_register(l %frame)
 # scalar locals: promotable allocs
 %size =l alloc8 8
 %count =l alloc8 8
 %index =l alloc8 8
 %sz =l loadl %hdr
 storel %sz, %size
 storel 0, %count
 storel 0, %index
@loop
 %i =l loadl %index
 %s =l loadl %size
 %c =l csltl %i, %s
 jnz %c, @body, @done
@body
 # source[index], first read
 %src =l loadl %frame
 %len =l loadl %src
 jmp @in1
@in1
 %stp =l add %src, 32
 %st =l loadl %stp
 %ad =l add %st, %i
 %b =l loadub %ad
 %e1 =l ceql %b, 40
 jnz %e1, @hit, @second
@second
 %src2 =l loadl %frame
 %len2 =l loadl %src2
 jmp @in2
@in2
 %stp2 =l add %src2, 32
 %st2 =l loadl %stp2
 %ad2 =l add %st2, %i
 %b2 =l loadub %ad2
 %e2 =l ceql %b2, 41
 jnz %e2, @hit, @next
@hit
 %cnt =l loadl %count
 %cnt1 =l add %cnt, 1
 jmp @ck1
@ck1
 storel %cnt1, %count
 jmp @next
@next
 %i2 =l loadl %index
 %i3 =l add %i2, 1
 jmp @ck2
@ck2
 storel %i3, %index
 jmp @loop
@oob
 call $myl_fake_fail(l %ctxdummy, l 55, l %i)
 jmp @done
@overflow
 call $myl_fake_fail(l %ctxdummy, l 71, l 0)
 jmp @done
@done
 %fs =l loadl %size
 %fc =l loadl %count
 call $printf(l $fmt, l %fs, l %fc)
 ret 0
}
