module e_scan

# Walk every input byte with a comparison and no allocation: isolates the raw
# per-byte loop cost of generated mylang code.
def main(args: list[str], fs: Filesystem, out: Stream, err: Stream) -> int:
    source = b""
    match read_file(fs, args[0]):
        case Ok(data):
            source = data
        case Err(problem):
            err.print("read failed", problem)
            return 2
    size = len(source)
    count = 0
    index = 0
    while index < size:
        if source[index] == 40 or source[index] == 41:
            count = count + 1
        index = index + 1
    out.print(f"bytes={size} delims={count}")
    return 0
