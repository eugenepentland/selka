module f_calls

# Call a trivial function one million times: isolates call + loop overhead.
const ROUNDS: int = 1000000


def bump(value: int) -> int:
    return value + 1


def main(args: list[str], fs: Filesystem, out: Stream, err: Stream) -> int:
    total = 0
    index = 0
    while index < ROUNDS:
        total = bump(total)
        index = index + 1
    out.print(f"calls={ROUNDS} total={total}")
    return 0
