module j_one

# One-statement loop: the baseline for per-statement codegen overhead.
def main(args: list[str], fs: Filesystem, out: Stream, err: Stream) -> int:
    source = b""
    match read_file(fs, args[0]):
        case Ok(data):
            source = data
        case Err(problem):
            err.print("read failed", problem)
            return 2
    size = len(source)
    index = 0
    while index < size:
        index = index + 1
    out.print(f"bytes={size} index={index}")
    return 0
