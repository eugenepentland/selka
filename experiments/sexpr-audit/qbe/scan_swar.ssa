# Hand-written QBE IR for the sexpr scan task, SWAR variant.
#
#   zig-out/bin/qbe scan_swar.ssa -o scan_swar.s && cc -static -o scan-swar scan_swar.s
#
# QBE has no vector types, so a byte-at-a-time loop is the obvious IR. But 64-bit
# integer arithmetic can process eight bytes at once: `(` and `)` are 0x28/0x29,
# so masking off bit 0 turns both into 0x28 and one comparison catches either.
# Zero bytes are then counted exactly with
#
#     z = ~(((x & 0x7F..) + 0x7F..) | x) & 0x80..
#
# (the usual `(x - 0x01..) & ~x & 0x80..` trick is a *presence* test and
# over-counts when a 0x01 byte borrows from a neighbouring 0x00 — verified), and
# the eight 0x80 bits are summed with a multiply. 12 instructions per 8 bytes
# against ~9 per byte for the scalar loop.

data $lit_bytes = { b "bytes=", b 0 }
data $lit_delims = { b " delims=", b 0 }

function l $copy(l %src, l %dst, l %n) {
@start
	jmp @loop
@loop
	%p =l phi @start %src, @body %p1
	%d =l phi @start %dst, @body %d1
	%i =l phi @start 0, @body %i1
	%more =w cultl %i, %n
	jnz %more, @body, @done
@body
	%b =w loadub %p
	storeb %b, %d
	%p1 =l add %p, 1
	%d1 =l add %d, 1
	%i1 =l add %i, 1
	jmp @loop
@done
	ret %d
}

function l $put_u64(l %v, l %dst) {
@start
	%tmp =l alloc8 32
	%end =l add %tmp, 32
	%iszero =w ceql %v, 0
	jnz %iszero, @zero, @collect
@zero
	%z =w copy 48
	storeb %z, %dst
	%one =l add %dst, 1
	ret %one
@collect
	%p =l phi @start %end, @digits %p2
	%x =l phi @start %v, @digits %q
	%done =w ceql %x, 0
	jnz %done, @emit, @digits
@digits
	%ten =l copy 10
	%q =l udiv %x, %ten
	%r =l urem %x, %ten
	%rw =w copy %r
	%ch =w add %rw, 48
	%p2 =l sub %p, 1
	storeb %ch, %p2
	jmp @collect
@emit
	%n =l sub %end, %p
	%d =l call $copy(l %p, l %dst, l %n)
	ret %d
}

export function w $main(w %argc, l %argv) {
@start
	%ok =w csgtw %argc, 1
	jnz %ok, @open, @usage
@usage
	ret 2
@open
	%pp =l add %argv, 8
	%path =l loadl %pp
	%fd =w call $open(l %path, w 0)
	%bad =w csltw %fd, 0
	jnz %bad, @fail, @alloc
@alloc
	%buf =l call $malloc(l 16777216)
	%n =l call $read(w %fd, l %buf, l 16777216)
	%neg =w csltl %n, 0
	jnz %neg, @fail, @init
@init
	%words =l udiv %n, 8
	%mask_fe =l copy -72340172838076674
	%c28 =l copy 2893606913523066920
	%c7f =l copy 9187201950435737471
	%c80 =l copy -9187201950435737472
	%c01 =l copy 72340172838076673
	jmp @loop
@loop
	%wi =l phi @init 0, @body %wi1
	%cnt =l phi @init 0, @body %cntnext
	%more =w cultl %wi, %words
	jnz %more, @body, @tail
@body
	%off =l mul %wi, 8
	%addr =l add %buf, %off
	%w =l loadl %addr
	%m =l and %w, %mask_fe
	%x =l xor %m, %c28
	%a =l and %x, %c7f
	%b =l add %a, %c7f
	%nz =l or %b, %x
	%zi =l xor %nz, -1
	%zf =l and %zi, %c80
	%bits =l shr %zf, 7
	%prod =l mul %bits, %c01
	%c =l shr %prod, 56
	%cntnext =l add %cnt, %c
	%wi1 =l add %wi, 1
	jmp @loop
@tail
	%tstart =l mul %words, 8
	jmp @tloop
@tloop
	%ti =l phi @tail %tstart, @tbody %ti1
	%tcnt =l phi @tail %cnt, @tbody %tcntnext
	%tmore =w cultl %ti, %n
	jnz %tmore, @tbody, @done
@tbody
	%taddr =l add %buf, %ti
	%tb =w loadub %taddr
	%topen =w ceqw %tb, 40
	%tclose =w ceqw %tb, 41
	%tm =w or %topen, %tclose
	%tinc =l extuw %tm
	%tcntnext =l add %tcnt, %tinc
	%ti1 =l add %ti, 1
	jmp @tloop
@done
	%out =l call $malloc(l 64)
	%p0 =l copy $lit_bytes
	%p1 =l call $copy(l %p0, l %out, l 6)
	%p2 =l call $put_u64(l %n, l %p1)
	%p3 =l copy $lit_delims
	%p4 =l call $copy(l %p3, l %p2, l 8)
	%p5 =l call $put_u64(l %tcnt, l %p4)
	%nl =w copy 10
	storeb %nl, %p5
	%p6 =l add %p5, 1
	%len =l sub %p6, %out
	%w2 =l call $write(w 1, l %out, l %len)
	ret 0
@fail
	ret 2
}
