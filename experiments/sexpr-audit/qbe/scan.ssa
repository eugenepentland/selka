# Hand-written QBE IR for the sexpr scan task.
#
#   zig-out/bin/qbe scan.ssa -o scan.s && cc -static -o scan-qbe scan.s
#
# It performs exactly the work `zig-bench --scan` does: open the file, read it,
# count the bytes equal to '(' or ')', and print `bytes=<n> delims=<m>`. The
# integer formatting is written in the IR too, so the only external calls are
# open/read/write/malloc. No SIMD: QBE has no vector types, so this is the best
# a scalar QBE loop can do, and it is what mylang's backend is limited to.
#
# The scan loop is byte-at-a-time on purpose (first version below); a SWAR
# variant is in scan_swar.ssa.

data $lit_bytes = { b "bytes=", b 0 }
data $lit_delims = { b " delims=", b 0 }

# QBE has no `declare`: a call to an undefined $symbol becomes an external
# reference, so open/read/write/malloc link straight against libc.

# copy %n bytes from %src to %dst, returning the new destination end
function l $copy(l %src, l %dst, l %n) {
@start
	jmp @loop
@loop
	%p =l phi @start %src, @body %p1
	%d =l phi @start %dst, @body %d1
	%i =l phi @start 0, @body %i1
	%more =w cultl %i, %n
	jnz %more, @body, @done
@body
	%b =w loadub %p
	storeb %b, %d
	%p1 =l add %p, 1
	%d1 =l add %d, 1
	%i1 =l add %i, 1
	jmp @loop
@done
	ret %d
}

# write the decimal spelling of %v at %dst, returning the new end
function l $put_u64(l %v, l %dst) {
@start
	%tmp =l alloc8 32
	%end =l add %tmp, 32
	%iszero =w ceql %v, 0
	jnz %iszero, @zero, @collect
@zero
	%z =w copy 48
	storeb %z, %dst
	%one =l add %dst, 1
	ret %one
@collect
	%p =l phi @start %end, @digits %p2
	%x =l phi @start %v, @digits %q
	%done =w ceql %x, 0
	jnz %done, @emit, @digits
@digits
	%ten =l copy 10
	%q =l udiv %x, %ten
	%r =l urem %x, %ten
	%rw =w copy %r
	%ch =w add %rw, 48
	%p2 =l sub %p, 1
	storeb %ch, %p2
	jmp @collect
@emit
	%n =l sub %end, %p
	%d =l call $copy(l %p, l %dst, l %n)
	ret %d
}

export function w $main(w %argc, l %argv) {
@start
	%ok =w csgtw %argc, 1
	jnz %ok, @open, @usage
@usage
	ret 2
@open
	%pp =l add %argv, 8
	%path =l loadl %pp
	%fd =w call $open(l %path, w 0)
	%bad =w csltw %fd, 0
	jnz %bad, @fail, @alloc
@alloc
	%buf =l call $malloc(l 16777216)
	%n =l call $read(w %fd, l %buf, l 16777216)
	%neg =w csltl %n, 0
	jnz %neg, @fail, @init
@init
	jmp @loop
@loop
	%i =l phi @init 0, @body %inext
	%cnt =l phi @init 0, @body %cntnext
	%more =w cultl %i, %n
	jnz %more, @body, @done
@body
	%addr =l add %buf, %i
	%b =w loadub %addr
	%isopen =w ceqw %b, 40
	%isclose =w ceqw %b, 41
	%m =w or %isopen, %isclose
	%inc =l extuw %m
	%cntnext =l add %cnt, %inc
	%inext =l add %i, 1
	jmp @loop
@done
	%out =l call $malloc(l 64)
	%p0 =l copy $lit_bytes
	%p1 =l call $copy(l %p0, l %out, l 6)
	%p2 =l call $put_u64(l %n, l %p1)
	%p3 =l copy $lit_delims
	%p4 =l call $copy(l %p3, l %p2, l 8)
	%p5 =l call $put_u64(l %cnt, l %p4)
	%nl =w copy 10
	storeb %nl, %p5
	%p6 =l add %p5, 1
	%len =l sub %p6, %out
	%w =l call $write(w 1, l %out, l %len)
	ret 0
@fail
	ret 2
}
