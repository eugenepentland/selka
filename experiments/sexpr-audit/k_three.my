module k_three

# Three-statement loop: the slope against j_one gives per-statement overhead.
def main(args: list[str], fs: Filesystem, out: Stream, err: Stream) -> int:
    source = b""
    match read_file(fs, args[0]):
        case Ok(data):
            source = data
        case Err(problem):
            err.print("read failed", problem)
            return 2
    size = len(source)
    index = 0
    count = 0
    while index < size:
        count = count + 1
        count = count + 1
        index = index + 1
    out.print(f"bytes={size} count={count}")
    return 0
