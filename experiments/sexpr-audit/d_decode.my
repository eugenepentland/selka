module d_decode

# Scan the input and decode 19_155 eight-byte slices, but keep no list and do no
# scanning logic: isolates the cost of `bytes[a:b].decode()` itself.
const LIMIT: int = 19155


def main(args: list[str], fs: Filesystem, out: Stream, err: Stream) -> int:
    source = b""
    match read_file(fs, args[0]):
        case Ok(data):
            source = data
        case Err(problem):
            err.print("read failed", problem)
            return 2
    total = 0
    index = 0
    while index < LIMIT:
        start = index * 8
        match source[start:start + 8].decode():
            case Ok(text):
                total = total + len(text)
            case Err(_):
                total = total
        index = index + 1
    out.print(f"decoded={LIMIT} chars={total}")
    return 0
