module h_loop

# The e_scan loop WITHOUT indexing: isolates loop bookkeeping and the integer
# compare, with no bytes access at all.
def main(args: list[str], fs: Filesystem, out: Stream, err: Stream) -> int:
    source = b""
    match read_file(fs, args[0]):
        case Ok(data):
            source = data
        case Err(problem):
            err.print("read failed", problem)
            return 2
    size = len(source)
    count = 0
    index = 0
    while index < size:
        count = count + 1
        index = index + 1
    out.print(f"bytes={size} count={count}")
    return 0
