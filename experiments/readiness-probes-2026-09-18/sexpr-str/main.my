module main

# Probe 1: KiCad-style S-expression parser written the way a Python programmer would.

record Pos:
    offset: int
    line: int
    col: int

record ParseError:
    message: str
    pos: Pos

union Node:
    atom: str,
    text: str,
    items: list[Node]

class Cursor:
    src: str
    pos: int
    line: int
    col: int

def here(c: Cursor) -> Pos:
    return Pos(offset=c.pos, line=c.line, col=c.col)

def peek(c: Cursor) -> str:
    if c.pos >= len(c.src):
        return ""
    return c.src[c.pos]

def advance(c: Cursor) -> None:
    ch = c.src[c.pos]
    c.pos = c.pos + 1
    if ch == "\n":
        c.line = c.line + 1
        c.col = 1
    else:
        c.col = c.col + 1

def skip_ws(c: Cursor) -> None:
    while c.pos < len(c.src):
        ch = peek(c)
        if ch.isspace():
            advance(c)
        elif ch == "#":
            while c.pos < len(c.src) and peek(c) != "\n":
                advance(c)
        else:
            break

def fail(c: Cursor, message: str) -> ParseError:
    return ParseError(message=message, pos=here(c))

def parse_string(c: Cursor) -> Result[Node, ParseError]:
    advance(c)  # opening quote
    out = ""
    while True:
        if c.pos >= len(c.src):
            return Err(fail(c, "unterminated string"))
        ch = peek(c)
        if ch == '"':
            advance(c)
            return Ok(Node.text(out))
        if ch == "\\":
            advance(c)
            esc = peek(c)
            if esc == "n":
                out = out + "\n"
            elif esc == "t":
                out = out + "\t"
            else:
                out = out + esc
            advance(c)
        else:
            out = out + ch
            advance(c)

def parse_atom(c: Cursor) -> Result[Node, ParseError]:
    start = c.pos
    while c.pos < len(c.src):
        ch = peek(c)
        if ch.isspace() or ch == "(" or ch == ")":
            break
        advance(c)
    if start == c.pos:
        return Err(fail(c, "expected atom"))
    return Ok(Node.atom(c.src[start:c.pos]))

def parse_node(c: Cursor) -> Result[Node, ParseError]:
    skip_ws(c)
    ch = peek(c)
    if ch == "":
        return Err(fail(c, "unexpected end of input"))
    if ch == "(":
        return parse_list(c)
    if ch == '"':
        return parse_string(c)
    if ch == ")":
        return Err(fail(c, "unexpected ')'"))
    return parse_atom(c)

def parse_list(c: Cursor) -> Result[Node, ParseError]:
    advance(c)  # (
    items: list[Node] = []
    while True:
        skip_ws(c)
        if peek(c) == ")":
            advance(c)
            return Ok(Node.items(items))
        if peek(c) == "":
            return Err(fail(c, "unclosed list"))
        node = parse_node(c)?
        items.append(node)

def parse(src: str) -> Result[Node, ParseError]:
    c = Cursor(src=src, pos=0, line=1, col=1)
    node = parse_node(c)?
    skip_ws(c)
    if c.pos != len(c.src):
        return Err(fail(c, "trailing input"))
    return Ok(node)

# --- queries -----------------------------------------------------------

def head(node: Node) -> str:
    match node:
        case Node.items(xs):
            if len(xs) == 0:
                return ""
            return head(xs[0])
        case Node.atom(a):
            return a
        case Node.text(t):
            return t

def children(node: Node, name: str) -> list[Node]:
    out: list[Node] = []
    match node:
        case Node.items(xs):
            for x in xs:
                match x:
                    case Node.items(inner):
                        if head(x) == name:
                            out.append(x)
                    case _:
                        pass
        case _:
            pass
    return out

def nth_atom(node: Node, index: int) -> str:
    match node:
        case Node.items(xs):
            if index < len(xs):
                return head(xs[index])
            return ""
        case _:
            return ""

def render(node: Node) -> str:
    match node:
        case Node.atom(a):
            return a
        case Node.text(t):
            return '"' + t + '"'
        case Node.items(xs):
            parts = [render(x) for x in xs]
            return "(" + " ".join(parts) + ")"

# --- tests ---------------------------------------------------------------

public def test_roundtrip() -> bool:
    match parse('(kicad_pcb (version 20240108) (net 0 "") (net 1 "GND"))'):
        case Ok(node):
            return render(node) == '(kicad_pcb (version 20240108) (net 0 "") (net 1 "GND"))'
        case Err(e):
            return False

public def test_nets() -> bool:
    match parse('(kicad_pcb (net 0 "") (net 1 "GND") (footprint "R_0402"))'):
        case Ok(node):
            nets = children(node, "net")
            return len(nets) == 2 and nth_atom(nets[1], 2) == "GND"
        case Err(e):
            return False

public def test_error_position() -> bool:
    match parse("(a\n  (b"):
        case Ok(node):
            return False
        case Err(e):
            return e.message == "unclosed list" and e.pos.line == 2

def main() -> int:
    return 0
