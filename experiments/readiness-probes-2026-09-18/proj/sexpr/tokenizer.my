module sexpr.tokenizer

public enum Kind:
    lparen,
    rparen,
    atom,
    text,
    eof

public record Token:
    kind: Kind
    start: int
    end: int
    line: int

public record LexError:
    message: str
    offset: int
    line: int

def is_space(b: int) -> bool:
    return b == 32 or b == 10 or b == 13 or b == 9

public def lexeme(src: bytes, tok: Token) -> str:
    match src[tok.start:tok.end].decode():
        case Ok(s):
            return s
        case Err(e):
            return ""

public def tokenize(src: bytes) -> Result[list[Token], LexError]:
    tokens: list[Token] = []
    i = 0
    line = 1
    n = len(src)
    while i < n:
        b = src[i]
        if b == 10:
            line = line + 1
            i = i + 1
        elif is_space(b):
            i = i + 1
        elif b == 35:
            while i < n and src[i] != 10:
                i = i + 1
        elif b == 40:
            tokens.append(Token(kind=Kind.lparen, start=i, end=i + 1, line=line))
            i = i + 1
        elif b == 41:
            tokens.append(Token(kind=Kind.rparen, start=i, end=i + 1, line=line))
            i = i + 1
        elif b == 34:
            start = i
            i = i + 1
            while i < n and src[i] != 34:
                if src[i] == 92:
                    i = i + 1
                if src[i] == 10:
                    line = line + 1
                i = i + 1
            if i >= n:
                return Err(LexError(message="unterminated string", offset=start, line=line))
            i = i + 1
            tokens.append(Token(kind=Kind.text, start=start + 1, end=i - 1, line=line))
        else:
            start = i
            while i < n and not is_space(src[i]) and src[i] != 40 and src[i] != 41:
                i = i + 1
            tokens.append(Token(kind=Kind.atom, start=start, end=i, line=line))
    tokens.append(Token(kind=Kind.eof, start=n, end=n, line=line))
    return Ok(tokens)
