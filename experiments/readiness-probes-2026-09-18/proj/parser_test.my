module parser_test
import sexpr.parser as sp

def roundtrip(text: str) -> str:
    match sp.parse(text.encode()):
        case Ok(node):
            return sp.render(node)
        case Err(e):
            return f"error: {e.message} at line {e.line}"

public def test_roundtrip() -> bool:
    return roundtrip('(kicad_pcb (version 20240108) (net 0 "") (net 1 "GND"))') == '(kicad_pcb (version 20240108) (net 0 "") (net 1 "GND"))'

public def test_comments_and_lines() -> bool:
    return roundtrip("(a # comment\n  b c)") == "(a b c)"

public def test_unclosed() -> bool:
    return roundtrip("(a\n  (b") == "error: unclosed list at line 2"

public def test_children() -> bool:
    match sp.parse(b'(pcb (net 0 "") (net 1 "GND") (footprint "R"))'):
        case Ok(node):
            return len(sp.children(node, "net")) == 2
        case Err(e):
            return False
