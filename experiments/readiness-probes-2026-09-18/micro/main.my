def main(args: list[str], fs: Filesystem, out: Stream) -> int:
    src = ""
    match read_text(fs, args[0]):
        case Ok(text):
            src = text
        case Err(problem):
            return 2
    mode = args[1]
    n = len(src)
    total = 0
    if mode == "index":
        i = 0
        while i < n:
            if src[i] == "(":
                total = total + 1
            i = i + 1
    elif mode == "iter":
        for ch in src:
            if ch == "(":
                total = total + 1
    elif mode == "append":
        acc = ""
        i = 0
        while i < 200000:
            acc = acc + src[i]
            i = i + 1
        total = len(acc)
    elif mode == "slice":
        i = 0
        while i + 8 < n:
            if src[i:i + 8] == "(net 1 \"":
                total = total + 1
            i = i + 1
    out.print(mode, total)
    return 0
