func sum_values(values: int[]) -> int:
    mut total = 0
    for value in values:
        total += value
    return total


func probe(n: int) -> int:
    mut values = [for i in range(8) yield n + i]
    const snapshot = values.copy()
    values.append(n + 8)
    return 10 * sum_values(snapshot) + sum_values(values)

func main(args: str[], out: Stream) -> int:
    const n = len(args)
    out.print(probe(n))
    return 0

