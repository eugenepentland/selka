record State:
    items: list[int]
    count: int
def grow() -> int:
    items = [0]
    for i in range(1000000):
        items.append(i)
    return len(items)
def change(state: mut State):
    state.count = grow()
def main(out: Stream) -> int:
    items = [7]
    with arena():
        state = State(items, 41)
        saved = state
        out.print("before")
        change(mut state)
        out.print(saved.count)
    return 0
