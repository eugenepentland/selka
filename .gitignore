# Evidence stays out of git (experiments/README.md): under experiments/ only
# write-ups and small sources are tracked; data, logs, archives and binaries go in
# ~/ai/canopy/mylang-evidence-archive/. Already tracked files are unaffected.
experiments/**
!experiments/**/
!experiments/**/*.md
!experiments/**/*.my
!experiments/**/*.selka
!experiments/**/*.py
!experiments/**/*.sh
!experiments/**/*.zig
!experiments/**/*.c
!experiments/**/*.h
!experiments/**/.gitignore
docs/audits/evidence/**
!docs/audits/evidence/**/
!docs/audits/evidence/**/*.md
*.tar
*.tar.gz
*.tgz
# Scratch inside experiments/ stays ignored: these come after the whitelist above
# because the later rule wins.
experiments/**/.mylang-cache/
experiments/**/.selka-cache/
experiments/**/.zig-cache*/
experiments/**/.tmp/
experiments/**/__pycache__/
