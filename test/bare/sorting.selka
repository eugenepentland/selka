# Sorting a list of integers, ascending and descending.
func main() -> int:
    mut values: int[] = []
    for i in range(300):
        append(mut values, (i * 7919) % 1009)
    sort(mut values)
    mut ok = 0
    for i in range(1, len(values)):
        if values[i - 1] <= values[i]:
            ok += 1
    sort(mut values, reverse=True)
    return (ok + values[0] + values[299]) % 256
