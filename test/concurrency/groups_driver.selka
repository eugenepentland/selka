# Parallel task groups: the lowered surface (`with parallel.group()`, `submit`, `result`). Each test joins its tasks on
# every exit edge, and each argument shape is checked for its value, worked out from the functions' definitions.
# Tests run one thread; `SELKA_THREADS=8` runs the same code concurrently.
import parallel

# A reduction with real work: the task reads its list after the work, so a list dropped before the join would be read freed.
func weigh(values: int[], work: int) -> int:
    mut total = 0
    for i in range(work):
        total += i % 3
    for v in values:
        total += v
    return total


# Allocates and frees while the group's tasks may still be running.
func churn(count: int) -> int:
    mut seen = 0
    for i in range(count):
        const scratch = [i, i + 1, i + 2, i + 3]
        seen += len(scratch)
    return seen


func consume(own values: int[]) -> int:
    mut total = 0
    for v in values:
        total += v
    return total


func make_list(size: int) -> int[]:
    mut out: int[] = []
    for i in range(size):
        append(mut out, i)
    return out


func length_of(values: int[], pad: int) -> int:
    return len(values) + pad


func load(path: str) -> int fails str:
    if len(path) == 0:
        fail "empty path"
    return len(path)


record Design:
    name: str
    nets: int[]


func count_nets(design: Design, extra: int) -> int:
    mut total = extra
    for net in design.nets:
        total += net
    return total + len(design.name)


func consume_design(own design: Design, extra: int) -> int:
    return count_nets(design, extra)


# Fall-through: a list declared in the block and lent to the task, read after real work.
func fall_through() -> int:
    mut out = 0
    with parallel.group() as g:
        const xs = [1, 2, 3, 4]
        const t = g.submit(weigh, xs, 2000)
        out = t.result()
    return out


# `return` from inside the block joins before it returns.
func by_return(flag: int) -> int:
    with parallel.group() as g:
        const xs = [1, 2, 3, 4]
        const t = g.submit(weigh, xs, 3000)
        if flag > 0:
            return t.result() + churn(500)
        mut sink = churn(100)
        return sink


# `break` leaves the loop from inside the block, after the join.
func by_break() -> int:
    mut out = 0
    for i in range(5):
        with parallel.group() as g:
            const xs = [i, i, i]
            const t = g.submit(weigh, xs, 2000)
            if i == 2:
                out += churn(50)
                break
            out += t.result()
    return out


# `continue` skips the rest of the block; the join still happens.
func by_continue() -> int:
    mut out = 0
    for i in range(4):
        with parallel.group() as g:
            const xs = [i, 1]
            const t = g.submit(weigh, xs, 1500)
            if i == 1:
                continue
            out += t.result() + churn(10)
    return out


# `fail` from inside the block joins, then the failure leaves the function.
func by_fail(flag: int) -> int fails str:
    with parallel.group() as g:
        const xs = [5, 6]
        const t = g.submit(weigh, xs, 2500)
        if flag > 0:
            fail "failed after submit"
        return t.result()


# `try` on a fallible task's result: the failure leaves the block through the join.
func by_try(flag: int) -> int fails str:
    with parallel.group() as g:
        mut path = ""
        if flag != 0:
            path = "x"
        const t = g.submit(load, path)
        const n = try t.result()
        return n + 40


# Two handles in one block, both read.
func two_handles() -> int:
    with parallel.group() as g:
        const a = g.submit(weigh, [1, 2], 10)
        const b = g.submit(weigh, [3], 20)
        return a.result() + b.result()


# A fallible task read with `match`.
func match_result(path: str) -> int:
    with parallel.group() as g:
        const t = g.submit(load, path)
        match t.result():
            case Ok(value):
                return value
            case Err(error):
                return -1


# A `const` handle in a loop body: one task per iteration, read in the same iteration.
func handle_in_loop(data: int[]) -> int:
    mut sum = 0
    with parallel.group() as g:
        for value in data:
            const t = g.submit(weigh, [value], 3)
            sum += t.result()
    return sum


# A bare submit of a procedure that returns nothing.
func tick(n: int):
    return


func bare_submit() -> int:
    mut counter = 7
    with parallel.group() as g:
        g.submit(tick, counter)
    return counter


# Nested groups: the inner block joins before the outer one.
func nested_groups() -> int:
    mut out = 0
    with parallel.group() as outer:
        const a = outer.submit(weigh, [3], 1)
        with parallel.group() as inner:
            const b = inner.submit(weigh, [4], 1)
            out = b.result()
        out += a.result()
    return out


# A group in a `while` loop, with `continue` before the read.
func while_continue(limit: int) -> int:
    mut i = 0
    mut sum = 0
    while i < limit:
        i += 1
        with parallel.group() as g:
            const t = g.submit(weigh, [i], 0)
            if i == 2:
                continue
            sum += t.result()
    return sum


# A lent owner's read during the window sees its value unchanged, and the task's result is the value at submit.
func loan_read() -> int:
    mut data = [1, 2, 3]
    mut n = 0
    with parallel.group() as g:
        const t = g.submit(weigh, data, 0)
        n = len(data) * 100 + data[0]
        n += t.result()
    return n


# The owned argument: the callee takes the list and frees it.
func owned_list() -> int:
    mut answer = 0
    with parallel.group() as g:
        const xs = [1, 2, 3, 4]
        const t = g.submit(consume, own xs)
        answer = t.result()
    return answer


# A temporary handed to the task: the environment owns it and frees it once.
func temporary() -> int:
    mut answer = 0
    with parallel.group() as g:
        const t = g.submit(length_of, make_list(7), 3)
        answer = t.result()
    return answer


# A lent record with a list field: the design is read after the join.
func lent_record() -> int:
    const design = Design(name="top", nets=[1, 2, 3])
    mut answer = 0
    with parallel.group() as g:
        const t = g.submit(count_nets, design, 100)
        answer = t.result()
    return answer + len(design.nets)


# An owned record.
func owned_record() -> int:
    mut answer = 0
    with parallel.group() as g:
        const d = Design(name="xy", nets=[4, 5])
        const t = g.submit(consume_design, own d, 1)
        answer = t.result()
    return answer


# Owned, lent and temporary arguments in one submit.
func mixed_masks() -> int:
    mut answer = 0
    with parallel.group() as g:
        const xs = [1, 2]
        const ys = [10, 20, 30]
        const t = g.submit(mixed, own xs, ys, 5)
        answer = t.result()
    return answer


func mixed(own values: int[], other: int[], tag: int) -> int:
    return consume(own values) + length_of(other, tag)


public func test_fall_through_reads_lent_list_after_work() -> bool:
    return fall_through() == 2009


public func test_return_joins_before_leaving() -> bool:
    return by_return(1) == 5010 and by_return(0) == 400


public func test_break_joins_before_leaving_the_loop() -> bool:
    return by_break() == 4201


public func test_continue_joins_before_the_next_iteration() -> bool:
    return by_continue() == 4628


public func test_fail_leaves_after_the_join() -> bool:
    match by_fail(0):
        case Ok(value):
            return value == 2510
        case Err(text):
            return False


public func test_fail_after_submit_reports_the_failure() -> bool:
    match by_fail(1):
        case Ok(value):
            return False
        case Err(text):
            return text == "failed after submit"


public func test_try_reads_a_fallible_task() -> bool:
    match by_try(1):
        case Ok(value):
            return value == 41
        case Err(text):
            return False


public func test_try_passes_a_task_failure_out() -> bool:
    match by_try(0):
        case Ok(value):
            return False
        case Err(text):
            return text == "empty path"


public func test_two_handles_are_both_read() -> bool:
    return two_handles() == 34


public func test_match_on_a_fallible_result() -> bool:
    return match_result("abc") == 3 and match_result("") == -1


public func test_handle_in_a_loop_reads_each_task() -> bool:
    return handle_in_loop([1, 2, 3]) == 15


public func test_bare_submit_of_a_procedure() -> bool:
    return bare_submit() == 7


public func test_nested_groups_join_inner_first() -> bool:
    return nested_groups() == 7


public func test_group_in_while_skips_on_continue() -> bool:
    return while_continue(3) == 4


public func test_loan_read_sees_the_value_at_submit() -> bool:
    return loan_read() == 307


public func test_owned_argument_is_taken_by_the_callee() -> bool:
    return owned_list() == 10


public func test_temporary_is_handed_over() -> bool:
    return temporary() == 10


public func test_lent_record_is_read_after_the_join() -> bool:
    return lent_record() == 112


public func test_owned_record_is_taken_by_the_callee() -> bool:
    return owned_record() == 12


public func test_owned_lent_and_temporary_masks() -> bool:
    return mixed_masks() == 11


func consume_list(own values: int[]) -> int:
    mut total = 0
    for v in values:
        total += v
    return total


# A value lent to one group, moved with `own` after that group's block, then followed by a second group: the second
# group's join must not read the moved value.
func moved_between_groups() -> int:
    mut data = [1, 2, 3]
    mut first = 0
    with parallel.group() as g1:
        const t = g1.submit(weigh, data, 0)
        first = t.result()
    const taken = consume_list(own data)
    mut second = 0
    const other = [4, 5]
    with parallel.group() as g2:
        const u = g2.submit(weigh, other, 0)
        second = u.result()
    return first + taken + second


public func test_group_after_a_move_between_groups() -> bool:
    return moved_between_groups() == 6 + 6 + 9


record Pair:
    values: int[]


record Bag:
    items: int[]
    inner: Pair


func weigh_pair(pair: Pair, work: int) -> int:
    return weigh(pair.values, work)


# A list field lent to a task, read after real work, with the owner dropped only after the join.
public func test_lent_list_field_is_read_after_the_join() -> bool:
    const bag = Bag(items=[1, 2, 3], inner=Pair(values=[4, 5]))
    mut out = 0
    with parallel.group() as g:
        const t = g.submit(weigh, bag.items, 3000)
        const noise = churn(300)
        out = t.result() + noise * 0
    return out == 3006


# A record field lent to a record parameter.
public func test_lent_record_field_is_read_after_the_join() -> bool:
    const bag = Bag(items=[1, 2, 3], inner=Pair(values=[4, 5]))
    mut out = 0
    with parallel.group() as g:
        const t = g.submit(weigh_pair, bag.inner, 3000)
        const noise = churn(300)
        out = t.result() + noise * 0
    return out == 3009


# A top-level borrowed binding of a field, then lent.
public func test_lent_borrowed_binding_is_read_after_the_join() -> bool:
    const bag = Bag(items=[1, 2, 3], inner=Pair(values=[4, 5]))
    const items = bag.items
    mut out = 0
    with parallel.group() as g:
        const t = g.submit(weigh, items, 3000)
        const noise = churn(300)
        out = t.result() + noise * 0
    return out == 3006


# A list element lent through a binding first.
public func test_lent_bound_list_element_is_read_after_the_join() -> bool:
    const rows = [[1, 2], [3, 4, 5]]
    mut out = 0
    with parallel.group() as g:
        const row = rows[1]
        const t = g.submit(weigh, row, 3000)
        const noise = churn(300)
        out = t.result() + noise * 0
    return out == 3012


# A dictionary value lent directly.
public func test_lent_dictionary_value_is_read_after_the_join() -> bool:
    const table = {"k": [7, 8]}
    mut out = 0
    with parallel.group() as g:
        const t = g.submit(weigh, table["k"], 3000)
        const noise = churn(300)
        out = t.result() + noise * 0
    return out == 3015


func main(out: Stream) -> int:
    mut failed = 0
    if not test_fall_through_reads_lent_list_after_work():
        failed += 1
        print(out, "FAIL test_fall_through_reads_lent_list_after_work")
    if not test_return_joins_before_leaving():
        failed += 1
        print(out, "FAIL test_return_joins_before_leaving")
    if not test_break_joins_before_leaving_the_loop():
        failed += 1
        print(out, "FAIL test_break_joins_before_leaving_the_loop")
    if not test_continue_joins_before_the_next_iteration():
        failed += 1
        print(out, "FAIL test_continue_joins_before_the_next_iteration")
    if not test_fail_leaves_after_the_join():
        failed += 1
        print(out, "FAIL test_fail_leaves_after_the_join")
    if not test_fail_after_submit_reports_the_failure():
        failed += 1
        print(out, "FAIL test_fail_after_submit_reports_the_failure")
    if not test_try_reads_a_fallible_task():
        failed += 1
        print(out, "FAIL test_try_reads_a_fallible_task")
    if not test_try_passes_a_task_failure_out():
        failed += 1
        print(out, "FAIL test_try_passes_a_task_failure_out")
    if not test_two_handles_are_both_read():
        failed += 1
        print(out, "FAIL test_two_handles_are_both_read")
    if not test_match_on_a_fallible_result():
        failed += 1
        print(out, "FAIL test_match_on_a_fallible_result")
    if not test_handle_in_a_loop_reads_each_task():
        failed += 1
        print(out, "FAIL test_handle_in_a_loop_reads_each_task")
    if not test_bare_submit_of_a_procedure():
        failed += 1
        print(out, "FAIL test_bare_submit_of_a_procedure")
    if not test_nested_groups_join_inner_first():
        failed += 1
        print(out, "FAIL test_nested_groups_join_inner_first")
    if not test_group_in_while_skips_on_continue():
        failed += 1
        print(out, "FAIL test_group_in_while_skips_on_continue")
    if not test_loan_read_sees_the_value_at_submit():
        failed += 1
        print(out, "FAIL test_loan_read_sees_the_value_at_submit")
    if not test_owned_argument_is_taken_by_the_callee():
        failed += 1
        print(out, "FAIL test_owned_argument_is_taken_by_the_callee")
    if not test_temporary_is_handed_over():
        failed += 1
        print(out, "FAIL test_temporary_is_handed_over")
    if not test_lent_record_is_read_after_the_join():
        failed += 1
        print(out, "FAIL test_lent_record_is_read_after_the_join")
    if not test_owned_record_is_taken_by_the_callee():
        failed += 1
        print(out, "FAIL test_owned_record_is_taken_by_the_callee")
    if not test_owned_lent_and_temporary_masks():
        failed += 1
        print(out, "FAIL test_owned_lent_and_temporary_masks")
    if not test_group_after_a_move_between_groups():
        failed += 1
        print(out, "FAIL test_group_after_a_move_between_groups")
    if not test_lent_list_field_is_read_after_the_join():
        failed += 1
        print(out, "FAIL test_lent_list_field_is_read_after_the_join")
    if not test_lent_record_field_is_read_after_the_join():
        failed += 1
        print(out, "FAIL test_lent_record_field_is_read_after_the_join")
    if not test_lent_borrowed_binding_is_read_after_the_join():
        failed += 1
        print(out, "FAIL test_lent_borrowed_binding_is_read_after_the_join")
    if not test_lent_bound_list_element_is_read_after_the_join():
        failed += 1
        print(out, "FAIL test_lent_bound_list_element_is_read_after_the_join")
    if not test_lent_dictionary_value_is_read_after_the_join():
        failed += 1
        print(out, "FAIL test_lent_dictionary_value_is_read_after_the_join")
    print(out, "tests", 26, "failed", failed)
    return failed
