    {
      "name": "an unchanged producer is served to a new process with its parts, and nothing is recomputed",
      "graph": { "nodes": [
        {"ops": [{"file": "/src/a.txt"}, {"file": "/src/b.txt"}], "expose": [{"name": "p0", "op": 0}, {"name": "p1", "op": 1}]},
        {"ops": [{"part": {"node": 0, "names": ["p0"]}}]},
        {"ops": [{"node": 0}]},
        {"ops": [{"part": {"node": 0, "names": ["p1", "pz"]}}]},
        {"ops": [{"part": {"node": 1, "names": ["p0"]}}]}
      ] },
      "steps": [
        {"edits": [{"write": ["/src/a.txt", "alpha"]}, {"write": ["/src/b.txt", "bravo"]}, {"advance_ms": 1000}], "query": [1, 3], "results": ["644a9bc5", "056f1e7e,~"], "expect": {"recomputed": 3, "served": 0, "early_cutoffs": 0, "reads": 2}},
        {"edits": [], "query": [1, 3], "results": ["644a9bc5", "056f1e7e,~"], "expect": {"recomputed": 0, "served": 3, "early_cutoffs": 0, "reads": 0}}
      ]
    },
    {
      "name": "a producer touched without changing is hashed once, and both readers are served",
      "graph": { "nodes": [
        {"ops": [{"file": "/src/a.txt"}, {"file": "/src/b.txt"}], "expose": [{"name": "p0", "op": 0}, {"name": "p1", "op": 1}]},
        {"ops": [{"part": {"node": 0, "names": ["p0"]}}]},
        {"ops": [{"node": 0}]},
        {"ops": [{"part": {"node": 0, "names": ["p1", "pz"]}}]},
        {"ops": [{"part": {"node": 1, "names": ["p0"]}}]}
      ] },
      "steps": [
        {"edits": [{"write": ["/src/a.txt", "alpha"]}, {"write": ["/src/b.txt", "bravo"]}, {"advance_ms": 1000}], "query": [1], "results": ["644a9bc5"], "expect": {"recomputed": 2, "served": 0, "early_cutoffs": 0, "reads": 2}},
        {"edits": [{"advance_ms": 1000}, {"touch": "/src/b.txt"}], "query": [1], "results": ["644a9bc5"], "expect": {"recomputed": 0, "served": 2, "early_cutoffs": 0, "reads": 1}}
      ]
    }
