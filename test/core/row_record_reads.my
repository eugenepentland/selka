module row_record_reads

extern def runtime_bench_now(host: Host) -> i64 effects(host)

# Row `record_reads` of benchmarks/runtime/ports/main.my as a program of its own, like compute_s0.my: arguments
# `size iterations seed` (the original takes the row name first), the same setup, kernel,
# checksum and output `checksum elapsed`. Setup that only other rows use is left out.


record Item:
    code: int
    bias: int
    payload: list[int]


def read_item(item: Item) -> int:
    return item.code + item.bias + item.payload[0]


def parse_number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0


def main(args: list[str], host: Host, out: Stream) -> int:
    if len(args) != 3:
        return 2
    size = parse_number(args[0])
    iterations = parse_number(args[1])
    seed = parse_number(args[2])
    if size < 2 or iterations < 1 or seed < 1 or seed > 1000000:
        return 2
    checksum = 0
    records: list[Item] = []
    for j in range(size):
        records.append(Item(code=(seed + j * 17) % 1009, bias=(seed * 3 + j * 7) % 257, payload=[j + seed, j + seed + 1, j + seed + 2, j + seed + 3]))
    index = seed % size
    start = runtime_bench_now(host)
    for step in range(iterations):
        item = records[index]
        result = read_item(item)
        checksum = (checksum + result) % 1000000007
        index = (index + 2 * seed + 1) % size
    elapsed = runtime_bench_now(host) - start
    out.print(checksum, elapsed)
    return 0
