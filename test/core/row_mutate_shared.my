module row_mutate_shared

extern def runtime_bench_now(host: Host) -> i64 effects(host)

# Row `mutate_shared` of benchmarks/runtime/ports/main.my as a program of its own, like compute_s0.my: arguments
# `size iterations seed` (the original takes the row name first), the same setup, kernel,
# checksum and output `checksum elapsed`. The original also holds mutate_unique in the same branch; this program is the shared half.


def parse_number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0


def main(args: list[str], host: Host, out: Stream) -> int:
    if len(args) != 3:
        return 2
    size = parse_number(args[0])
    iterations = parse_number(args[1])
    seed = parse_number(args[2])
    if size < 2 or iterations < 1 or seed < 1 or seed > 1000000:
        return 2
    checksum = 0
    values = [(seed + j * 13) % 1009 for j in range(size)]
    start = runtime_bench_now(host)
    for batch in range(iterations):
        index = (seed + batch * 17) % size
        snapshot = values
        values[index] = (values[index] + batch + 1) % 1000003
        checksum = (checksum + snapshot[index] + values[index]) % 1000000007
        snapshot = []
    elapsed = runtime_bench_now(host) - start
    for value in values:
        checksum = (checksum + value) % 1000000007
    out.print(checksum, elapsed)
    return 0
