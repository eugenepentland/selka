# Byte-string slices copy their octets without an ASCII scan; one of an ASCII block keeps
# the flag (NEW-CORE-S1-ASCII-1). Every answer here is the base compiler's (`main`
# cafe7fea7): lengths, decoding, equality, search and dictionary keys.
import bytes
import dicts
import strings

func decoded(raw: bytes) -> str:
    match strings.decode(raw):
        case Ok(value):
            return value
        case Err(message):
            return "!" + message


func main(out: Stream) -> int:
    mut t = strings.encode("héllo wörld")
    mut a = strings.encode("hello world")
    mut parts = [copy(t[0:3]), copy(t[1:3]), copy(t[1:2]), copy(t[2:2]), copy(a[1:4]), copy(a[6:11]), copy(t[7:10]), copy(t[max(len(t) - 4, 0):]), copy(t[0:99]), copy(a[max(len(a) - 100, 0):3])]
    mut keys: dict[bytes, int] = {}
    for p in parts:
        mut text = decoded(p)
        print(out, len(p), text, strings.char_count(text), p == a[1:4], bytes.find(p, b"l"))
        keys[copy(p)] = dicts.get(keys, p, 0) + len(p)
    print(out, len(keys), keys[a[1:4]], dicts.get(keys, t[0:3], -1))
    mut s = decoded(a[0:5]) + decoded(t[0:3])
    print(out, s, strings.char_count(s), strings.char_at(s, 5), strings.char_find(s, "é"), strings.char_slice(s, 1, 6))
    return 0
