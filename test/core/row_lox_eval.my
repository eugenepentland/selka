
# Split from benchmarks/runtime/expanded/collections/main.my; identical timed work.

extern func runtime_bench_now(host: Host) -> i64 effects(host)

enum Value:
    integer(value: int)
    boolean(value: bool)

record Instruction:
    op: int
    arg: int

func integer(value: Value) -> int:
    match value:
        case Value.integer(value=n):
            return n
        case Value.boolean(value=_):
            return 0

func boolean(value: Value) -> bool:
    match value:
        case Value.boolean(value=b):
            return b
        case Value.integer(value=_):
            return False

func execute(program: Instruction[], size: int, seed: int) -> int:
    mut stack: Value[] = []
    mut returns: int[] = []
    mut variables = [0, 0]
    mut pc = 0
    while True:
        mut ins = program[pc]
        pc += 1
        if ins.op == 0:
            stack.append(Value.integer(value=seed))
        elif ins.op == 1:
            stack.append(Value.integer(value=size))
        elif ins.op == 2:
            stack.append(Value.integer(value=ins.arg))
        elif ins.op == 3:
            stack.append(Value.integer(value=variables[ins.arg]))
        elif ins.op == 4:
            variables[ins.arg] = integer(stack.pop())
        elif ins.op >= 5 and ins.op <= 9:
            mut b = integer(stack.pop())
            mut a = integer(stack.pop())
            if ins.op == 5:
                stack.append(Value.integer(value=a + b))
            elif ins.op == 6:
                stack.append(Value.integer(value=a * b))
            elif ins.op == 7:
                stack.append(Value.integer(value=a % b))
            elif ins.op == 8:
                stack.append(Value.boolean(value=a < b))
            else:
                stack.append(Value.boolean(value=a == b))
        elif ins.op == 10:
            if not boolean(stack.pop()):
                pc = ins.arg
        elif ins.op == 11:
            pc = ins.arg
        elif ins.op == 12:
            returns.append(pc)
            pc = ins.arg
        elif ins.op == 13:
            pc = returns.pop()
        else:
            return integer(stack.pop())
    return 0

func parse_number(text: str) -> int:
    match parse_int(text):
        case Some(n):
            return n
        case None:
            return 0

func batch_result(size: int, batch: int, seed: int, program: Instruction[]) -> int:
    return execute(program, size, seed + batch)

func main(args: str[], host: Host, out: Stream) -> int:
    if len(args) != 3:
        return 2
    mut size = parse_number(args[0])
    mut iterations = parse_number(args[1])
    mut seed = parse_number(args[2])
    if size < 2 or iterations < 1 or seed < 1 or seed > 1000000:
        return 2
    mut program = [Instruction(op=0, arg=0), Instruction(op=4, arg=0), Instruction(op=2, arg=0), Instruction(op=4, arg=1), Instruction(op=3, arg=1), Instruction(op=1, arg=0), Instruction(op=8, arg=0), Instruction(op=10, arg=29), Instruction(op=3, arg=1), Instruction(op=2, arg=2), Instruction(op=7, arg=0), Instruction(op=2, arg=0), Instruction(op=9, arg=0), Instruction(op=10, arg=18), Instruction(op=3, arg=0), Instruction(op=12, arg=31), Instruction(op=4, arg=0), Instruction(op=11, arg=24), Instruction(op=3, arg=0), Instruction(op=3, arg=1), Instruction(op=5, arg=0), Instruction(op=2, arg=1000003), Instruction(op=7, arg=0), Instruction(op=4, arg=0), Instruction(op=3, arg=1), Instruction(op=2, arg=1), Instruction(op=5, arg=0), Instruction(op=4, arg=1), Instruction(op=11, arg=4), Instruction(op=3, arg=0), Instruction(op=14, arg=0), Instruction(op=2, arg=3), Instruction(op=6, arg=0), Instruction(op=2, arg=7), Instruction(op=5, arg=0), Instruction(op=2, arg=1000003), Instruction(op=7, arg=0), Instruction(op=13, arg=0)]
    mut checksum = 0
    mut start = runtime_bench_now(host)
    for batch in range(iterations):
        mut part = batch_result(size, batch, seed, program)
        if part < 0:
            return 2
        checksum = (checksum + part) % 1000000007
    mut elapsed = runtime_bench_now(host) - start
    out.print(checksum, elapsed)
    return 0
