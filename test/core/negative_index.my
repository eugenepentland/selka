def parse_index(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0


def main(args: list[str]) -> int:
    index = parse_index(args[1])
    xs = [10, 20]
    fixed: [2]int = [30, 40]
    if args[0] == "list-read":
        return xs[index]
    if args[0] == "list-write":
        xs[index] = 9
        return xs[0]
    if args[0] == "array-read":
        return fixed[index]
    fixed[index] = 9
    return fixed[0]
