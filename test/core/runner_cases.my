# Fixture of `mylang-core test` (NEW-CORE-TEST-*): one test of every verdict. The old core
# reports the same passes, failures and trap codes, and runs the tests marked
# `unsupported` in the new core's report too (they use a dict, which is S2).

def get(xs: list[int], index: int) -> int:
    return xs[index]


def fill(count: int) -> list[int]:
    total = 0
    for i in range(count):
        total += i * 3
    return [total + j for j in range(count)]


def first_entry() -> int:
    table = {1: 2}
    return table[1]


def test_loop_sum_passes() -> bool:
    values = fill(10)
    return len(values) == 10 and values[9] == 144


def test_comparison_passes() -> bool:
    return 7 // 2 == 3 and -7 // 2 == -4 and -7 % 3 == 2


def test_false_verdict_fails() -> bool:
    return 1 + 1 == 3


def test_bounds_trap() -> bool:
    values = [1, 2, 3]
    return get(values, 7) == 1


def test_overflow_trap() -> bool:
    big = 9223372036854775807
    return big + 1 > 0


def test_division_trap() -> bool:
    zero = len([1, 2]) - 2
    return 10 // zero == 0


def test_reaches_a_dict() -> bool:
    return first_entry() == 2


public def test_property(x: int) -> bool:
    return x == x


public def test_takes_a_stream(out: Stream) -> bool:
    values = fill(3)
    out.print(len(values))
    return len(values) == 3


@test
public def checks_marked_by_attribute() -> bool:
    return get([4, 5, 6], 1) == 5
