# Fixture of `mylang-core test` (NEW-CORE-TEST-*): one test of every verdict. The old core
# reports the same passes, failures and trap codes, and runs the tests marked
# `unsupported` in the new core's report too (they use a dict, which is S2).

func get(xs: int[], index: int) -> int:
    return xs[index]


func fill(count: int) -> int[]:
    mut total = 0
    for i in range(count):
        total += i * 3
    return [for j in range(count) yield total + j]


func first_entry() -> int:
    mut table = {1: 2}
    return table[1]


func test_loop_sum_passes() -> bool:
    mut values = fill(10)
    return len(values) == 10 and values[9] == 144


func test_comparison_passes() -> bool:
    return 7 // 2 == 3 and -7 // 2 == -4 and -7 % 3 == 2


func test_false_verdict_fails() -> bool:
    return 1 + 1 == 3


func test_bounds_trap() -> bool:
    mut values = [1, 2, 3]
    return get(values, 7) == 1


func test_overflow_trap() -> bool:
    mut big = 9223372036854775807
    return big + 1 > 0


func test_division_trap() -> bool:
    mut zero = len([1, 2]) - 2
    return 10 // zero == 0


func test_reaches_a_dict() -> bool:
    return first_entry() == 2


public func test_property(x: int) -> bool:
    return x == x


public func test_takes_a_stream(out: Stream) -> bool:
    mut values = fill(3)
    out.print(len(values))
    return len(values) == 3


@test
public func checks_marked_by_attribute() -> bool:
    return get([4, 5, 6], 1) == 5
