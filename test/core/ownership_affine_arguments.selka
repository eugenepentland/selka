import filesystem

resource File: filesystem


result Open:
    ok: File,
    err: int


record Failure:
    code: int
    resource: File


result Finish:
    ok: bool,
    err: Failure


func complete_failure(own failure: Failure) -> Finish:
    return complete_resource[Finish](own failure.resource)


func retry(own file: File) -> Finish:
    match complete_resource[Finish](own file):
        case ok(done):
            return Ok(done)
        case err(failure):
            return complete_failure(own failure)


record Outer:
    marker: int
    failure: Failure


func complete_outer(own outer: Outer) -> Finish:
    return complete_resource[Finish](own outer.failure.resource)


func retry_nested(own file: File) -> Finish:
    match complete_resource[Finish](own file):
        case ok(done):
            return Ok(done)
        case err(failure):
            const outer = Outer(marker=42, failure=own failure)
            return complete_outer(own outer)


func exercise_retry(nested: bool) -> bool:
    mut fs = filesystem.memory()
    with fs.open("data", "w") as output:
        _ = output.write("owned")
    with fs.read_only() as readonly:
        match acquire_resource[Open](readonly, FixedArray[u8, 6]([114u8, 58u8, 100u8, 97u8, 116u8, 97u8])):
            case ok(file):
                mut finished: Finish
                if nested:
                    finished = retry_nested(own file)
                else:
                    finished = retry(own file)
                match own finished:
                    case ok(done):
                        return not done
                    case err(failure):
                        return failure.code == 2
            case err(code):
                return code == 0


# spec-case: OWNERSHIP-CONTRACT-1
public func test_resource_field_retry_preserves_provider_and_cleanup() -> bool:
    return exercise_retry(False)


# spec-case: OWNERSHIP-CONTRACT-1
public func test_nested_resource_field_retry_preserves_provider_and_cleanup() -> bool:
    return exercise_retry(True)


func main() -> int:
    assert test_resource_field_retry_preserves_provider_and_cleanup()
    assert test_nested_resource_field_retry_preserves_provider_and_cleanup()
    return 0
