# Fixed arrays of capabilities (NEW-CORE-S5-CAP-COLLECTIONS-1): `[N]Stream`, `[N]Host` and
# `[N]Filesystem` as locals, record fields, union payloads, `mut` parameters and results,
# indexed, iterated, copied and rewritten. Stdout and stderr match the old core's.
import filesystem

record Grid:
    ports: FixedArray[Stream, 2]
    label: str


enum Route:
    one(value: Stream)
    many(value: FixedArray[Stream, 2])


func shout(g: Grid, i: int) -> int effects(output):
    g.ports[i].print(g.label, i)
    return i


func swap(ports: FixedArray[Stream, 2]) -> FixedArray[Stream, 2]:
    return FixedArray[stream_cap, 2]([ports[1], ports[0]])


func fill(mut ports: FixedArray[Stream, 2], s: Stream) -> Unit:
    ports[1] = s


func send(r: Route, text: str) -> Unit effects(output):
    match r:
        case Route.one(value=s):
            s.print(text)
        case Route.many(value=ss):
            for s in ss:
                s.print(text)


func read(fs: Filesystem, out: Stream) -> Unit:
    match fs.read_text("x.txt"):
        case Ok(t):
            out.print(t)
        case Err(e):
            out.print(e)


func files(out: Stream) -> int:
    const first = filesystem.memory()
    const second = filesystem.memory()
    _ = first.write_text("x.txt", "in a")
    _ = second.write_text("x.txt", "in b")
    read(first, out)
    read(second, out)
    read(first, out)
    return 2


func main(host: Host, out: Stream, err: Stream) -> int:
    mut ports: FixedArray[Stream, 2] = FixedArray[stream_cap, 2]([out, err])
    ports[0].print("zero")
    ports[1].print("one")
    mut g = Grid(ports=ports, label="grid")
    mut total = shout(g, 0) + shout(g, 1)
    mut s = swap(g.ports)
    s[0].print("swapped")
    s[1] = s[0]
    s[1].print("rewritten")
    g.ports[0].print("the record keeps its copy")
    fill(mut s, out)
    for i, p in enumerate(s):
        p.print("filled", i)
    mut grid: FixedArray[FixedArray[Stream, 2], 2] = FixedArray[FixedArray[Stream, 2], 2]([FixedArray[Stream, 2]([out, err]), FixedArray[Stream, 2]([err, out])])
    grid[1][1].print("nested")
    grid[0] = s
    grid[0][0].print("row replaced")
    send(Route.one(value=out), "one route")
    send(Route.many(value=FixedArray[Stream, 2]([out, err])), "many routes")
    mut hosts: FixedArray[Host, 2] = FixedArray[Host, 2]([host, host])
    _ = hosts[1]
    return total + files(out) + len(grid)
