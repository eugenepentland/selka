# Split from benchmarks/runtime/expanded/text/main.selka; identical timed work.
import strings

extern func runtime_bench_now(host: Host) -> i64


record Inputs:
    raw: bytes
    texts: str[]
    other: str[]
    numbers: int[]
    fragments: str[]


func number(text: str) -> int:
    match parse_int(text):
        case Some(value):
            return value
        case None:
            return 0


func row_name(j: int) -> str:
    const selection: str
    if (j % 2 == 0):
        selection = ('café,"item"')
    else:
        selection = ("naïve,item")
    return selection + str(j)


func score(text: str) -> int:
    mut raw = strings.encode(text)
    mut result = len(raw)
    for value in raw:
        result += value
    return result


func csv_rows(text: str) -> str[][]:
    mut rows: str[][] = []
    mut fields: str[] = []
    mut field = ""
    mut quoted = False
    mut pending_quote = False
    for ch in strings.chars(text):
        if quoted:
            if ch == '"':
                if pending_quote:
                    field += '"'
                    pending_quote = False
                else:
                    pending_quote = True
            elif pending_quote:
                quoted = False
                pending_quote = False
                if ch == ",":
                    append(mut fields, own field)
                    field = ""
                elif ch == "\n":
                    append(mut fields, own field)
                    append(mut rows, own fields)
                    fields = []
                    field = ""
            else:
                field += ch
        elif ch == '"':
            quoted = True
        elif ch == ",":
            append(mut fields, own field)
            field = ""
        elif ch == "\n":
            append(mut fields, own field)
            append(mut rows, own fields)
            fields = []
            field = ""
        else:
            field += ch
    return rows


func csv_job(text: str) -> int:
    mut groups: dict[str, int] = {"east": 0, "west": 0, "north": 0}
    mut accepted = 0
    mut rejected = 0
    mut names = 0
    for row in csv_rows(text):
        match parse_int(row[3]):
            case Some(amount):
                if row[4] == "1":
                    groups[copy(row[2])] += amount
                    accepted += 1
                    names += score(row[1])
            case None:
                rejected += 1
    return groups["east"] + groups["west"] * 2 + groups["north"] * 3 + accepted * 17 + rejected * 101 + names


func inputs(kind: str, size: int, seed: int) -> Inputs:
    mut raw = b""
    mut texts: str[] = []
    mut other: str[] = []
    mut numbers: int[] = []
    mut fragments: str[] = []
    mut regions = ["east", "west", "north"]
    mut csv_chunks: str[] = []
    for j in range(size):
        const amount: str
        if (j % 11 == 0):
            amount = ("oops")
        else:
            amount = (str((seed + j * 19) % 100003))
        mut quoted = '"' + strings.replace(row_name(j), '"', '""') + '"'
        mut manual_prefix = str(seed + j) + "," + quoted + "," + regions[(seed + j) % 3] + "," + amount + ","
        mut manual_flag = "0"
        if (seed + j) % 3 != 0:
            manual_flag = "1"
        append(mut csv_chunks, manual_prefix + manual_flag + "\n")
    texts = [strings.join(csv_chunks, "")]
    return Inputs(raw=own raw, texts=own texts, other=own other, numbers=own numbers, fragments=own fragments)


func kernel(kind: str, data: Inputs, iterations: int, seed: int) -> int:
    mut checksum = 0
    for step in range(iterations):
        mut cursor = seed + step
        mut value = csv_job(data.texts[0])
        checksum = (checksum + value) % 1000000007
    return checksum


func main(args: str[], host: Host, out: Stream) -> int:
    if len(args) != 3:
        return 2
    mut kind = "csv_aggregate"
    mut size = number(args[0])
    mut iterations = number(args[1])
    mut seed = number(args[2])
    if size < 2 or iterations < 1 or seed < 1 or seed > 1000000:
        return 2
    mut data = inputs(kind, size, seed)
    mut checksum = 0
    mut start = runtime_bench_now(host)
    checksum = kernel(kind, data, iterations, seed)
    mut elapsed = runtime_bench_now(host) - start
    print(out, checksum, elapsed)
    return 0
