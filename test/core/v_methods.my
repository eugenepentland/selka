module v_methods


record Doc:
    title: str
    rows: list[list[int]]


def count_chars(d: Doc) -> int:
    return len(d.title) + len(d.rows)


def fill(xs: mut list[int]) -> int:
    xs.clear()
    xs.append(5)
    return len(xs)


def pair(a: int, b: int) -> int:
    return a * 10 + b


def push(xs: mut list[int]) -> int:
    xs.append(9)
    return len(xs)


def lst(a: list[int], b: int) -> int:
    return len(a) * 100 + b


def main(out: Stream) -> int:
    d = Doc(title="héllo", rows=[[1], [2, 3]])
    out.print(count_chars(d))
    xs = [1, 2, 3]
    ys = xs.copy()
    ys.append(4)
    out.print(len(xs), len(ys))
    zs = [7, 8]
    snapshot = zs
    out.print(fill(mut zs), len(snapshot), len(zs))
    rows = [[1], [2]]
    rows.clear()
    rows.append([3])
    out.print(len(rows), len(rows[0]))
    out.print(pair(b=3, a=4))
    ws = [1]
    out.print(lst(b=push(mut ws), a=ws))
    return 0
