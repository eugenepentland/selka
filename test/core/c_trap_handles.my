import network

extern func trap_flag(host: Host) -> int effects(host)


func main(net: Network, host: Host) -> int:
    with net.host("127.0.0.1:1234") as scoped:
        match network.connect(scoped):
            case network.Connected.err(_):
                return 2
            case network.Connected.ok(resource):
                # Keep the owner live across a dynamic failed assertion.
                assert trap_flag(host) == 1
                match network.close(resource):
                    case network.Closed.ok(_):
                        return 0
                    case network.Closed.err(_):
                        return 3
