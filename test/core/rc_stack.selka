func short_sums(n: int, seed: int) -> int:
    mut total = 0
    for j in range(n):
        mut gather_result: int[] = []
        for k in range(0, 4):
            const gather_value: int = seed + j + k
            append(mut gather_result, gather_value)
        mut short = own gather_result
        for value in short:
            total += value
        short = []
        mut tail = [j, j + 1]
        total += len(tail) + tail[1] + len(short)
    return total


func bounded(seed: int) -> int:
    mut m = seed % 5
    mut xs: int[] = []
    for k in range(0, m):
        append(mut xs, k * 2)
    mut total = len(xs)
    for x in xs:
        total += x
    return total


func escapes(n: int) -> int[]:
    mut out: int[] = []
    for k in range(0, n):
        append(mut out, k)
    return out


func main(args: str[], out: Stream) -> int:
    print(out, short_sums(10, len(args)), bounded(len(args)), len(escapes(3)))
    return 0
