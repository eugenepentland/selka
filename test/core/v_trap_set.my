module v_trap_set

record Cell:
    code: int
    flag: bool


def write(cells0: list[Cell], i: int, v: int) -> int:
    cells = cells0
    cells[i] = Cell(code=v, flag=True)
    return cells[i].code


def main(out: Stream) -> int:
    cells = [Cell(code=1, flag=False), Cell(code=2, flag=False)]
    out.print(write(cells, 1, 9))
    out.print(write(cells, 2, 9))
    return 0
