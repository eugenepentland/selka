module propagation_case_5


def first(values: list[i64]) -> Option[i64]:
    if len(values) == 0:
        return None
    return Some(values[0])


def pick(values: list[i64]) -> Option[i64]:
    value = first(values)?
    return Some(value + 1)


public def program() -> i64:
    match pick([]):
        case Some(value):
            return value
        case None:
            return 7
