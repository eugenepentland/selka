# Checks made on every edge into a loop header (lane F2, NEW-CORE-F2-INDEX-5): `run` reads
# `m.items[former_position(len(m.items), m.top - 1)]` before its loop and at the end of each pass, so the same read at the
# top of each pass is covered on both edges into the loop; `unguarded` makes no read
# before its loop, so its top read keeps its check. Each further argument adds a pass;
# enough passes take `top` below zero (the reads wrap) and then past the list (a trap).
record Machine:
    items: int[]
    top: int


func run(mut m: Machine, steps: int) -> int:
    mut total = m.items[former_position(len(m.items), m.top - 1)]
    mut k = 0
    while k < steps:
        total = total + m.items[former_position(len(m.items), m.top - 1)]
        if total % 2 == 0:
            m.top = m.top - 1
        k += 1
        total = total + m.items[former_position(len(m.items), m.top - 1)]
    return total


func unguarded(mut m: Machine, steps: int) -> int:
    mut total = 0
    mut k = 0
    while k < steps:
        total = total + m.items[former_position(len(m.items), m.top - 1)]
        if total % 2 == 0:
            m.top = m.top - 1
        k += 1
        total = total + m.items[former_position(len(m.items), m.top - 1)]
    return total


func main(args: str[], out: Stream) -> int:
    mut m = Machine(items=[1, 2, 3, 4, 5, 6, 7, 8], top=8)
    print(out, run(mut m, 3 + len(args)), m.top)
    mut m2 = Machine(items=[1, 2, 3, 4, 5, 6, 7, 8], top=8)
    print(out, unguarded(mut m2, 3 + len(args)), m2.top)
    return 0


# Preserve the original fixture's from-end cases explicitly at each access.
func former_position(length: int, index: int) -> int:
    if index < 0:
        return length + index
    return index
