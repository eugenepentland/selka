extern func runtime_bench_now(host: Host) -> i64 effects(host)


# Row `tagged_stack` of benchmarks/runtime/ports/main.my as a program of its own, like compute_s0.my: arguments
# `size iterations seed` (the original takes the row name first), the same setup, kernel,
# checksum and output `checksum elapsed`. Setup that only other rows use is left out.
enum Value:
    integer(value: int)
    boolean(value: bool)


func as_integer(value: Value) -> int:
    match value:
        case Value.integer(value=n):
            return n
        case Value.boolean(value=_):
            return 0


func parse_number(text: str) -> int:
    match parse_int(text):
        case Some(value):
            return value
        case None:
            return 0


func main(args: str[], host: Host, out: Stream) -> int:
    if len(args) != 3:
        return 2
    mut size = parse_number(args[0])
    mut iterations = parse_number(args[1])
    mut seed = parse_number(args[2])
    if size < 2 or iterations < 1 or seed < 1 or seed > 1000000:
        return 2
    mut checksum = 0
    mut opcodes = [for j in range(size) yield (j + seed) % 4]
    mut stack: Value[] = [Value.integer(value=seed), Value.boolean(value=False)]
    mut cursor = 0
    mut start = runtime_bench_now(host)
    for step in range(iterations):
        mut popped = stack.pop()
        mut base = as_integer(stack[0])
        mut opcode = opcodes[cursor]
        mut delta = 0
        match popped:
            case Value.boolean(value=b):
                if opcode == 0:
                    delta = if (b) then (3) else (1)
                elif opcode == 1:
                    delta = 7
                elif opcode == 2:
                    delta = 11
                else:
                    delta = 13
            case Value.integer(value=n):
                if opcode == 0:
                    delta = n % 5
                elif opcode == 1:
                    delta = n % 7
                elif opcode == 2:
                    delta = n % 11
                else:
                    delta = n % 13
        mut new_base = (base + delta + opcode + 1) % 1000003
        stack[0] = Value.integer(value=new_base)
        if opcode == 0 or opcode == 2:
            stack.append(Value.boolean(value=new_base % 2 == 0))
        else:
            stack.append(Value.integer(value=new_base % 97))
        cursor = (cursor + 1) % size
    mut elapsed = runtime_bench_now(host) - start
    checksum = as_integer(stack[0]) * 101
    match stack[1]:
        case Value.boolean(value=b):
            checksum += if (b) then (1) else (0)
        case Value.integer(value=n):
            checksum += n
    out.print(checksum, elapsed)
    return 0
