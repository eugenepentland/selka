enum Failure:
    text(value: str)
    code(value: int)


func parse(x: int) -> int fails str:
    if x < 0:
        fail "negative"
    return x


func forward(x: int) -> int fails str:
    mut r = parse(x)
    return try own r


func pass_on(x: int) -> int fails str:
    mut v = try forward(x)
    return v + 1


func lift(x: int) -> int fails Failure:
    mut v = try pass_on(x)
    return v * 2


func describe(f: Failure) -> str:
    match f:
        case text(value=t):
            return copy(t)
        case code(value=_):
            return "code"


func run(x: int) -> int fails str:
    match lift(x):
        case Ok(v):
            return v
        case Err(f):
            fail describe(f)


func main(args: str[], out: Stream) -> Result[int, str]:
    mut a = try pass_on(len(args) + 2)
    match run(3):
        case Ok(v):
            print(out, "run", a, v)
        case Err(e):
            print(out, "run failed", e)
    match run(0 - 3):
        case Ok(v):
            print(out, "run", v)
        case Err(e):
            print(out, "run failed", e)
    mut b = try pass_on(0 - len(args))
    return Ok(a + b)
