import lists

record Holder:
    items: int[]


func clear_needle(mut values: int[]) -> int:
    lists.clear(mut values)
    return 3


func mark(mut log: int[], value: int) -> int:
    append(mut log, value)
    return value


# spec: NEW-CORE-LIST-S3-2
public func test_bounds_first_occurrence_and_scalar_snapshots() -> bool:
    mut values = [3, 1, 2, 1]
    mut before = copy(values)
    if lists.index_of(values, 1) != 1:
        return False
    lists.insert(mut values, max(len(values) - 99, 0), 8)
    lists.insert(mut values, 99, 9)
    lists.insert(mut values, max(len(values) - 1, 0), 7)
    if values != [8, 3, 1, 2, 1, 7, 9]:
        return False
    lists.remove(mut values, 1)
    mut last = lists.pop_at(mut values, len(values) - 1)
    mut first = lists.pop_at(mut values, 0)
    return before == [3, 1, 2, 1] and values == [3, 2, 1, 7] and last == 9 and first == 8


# spec-case: NEW-CORE-LIST-S3-2
public func test_managed_removed_values_and_none_placeholders_survive_clear() -> bool:
    mut values = [[1], [2], [1]]
    mut before = copy(values)
    mut removed = lists.pop_at(mut values, len(values) - 2)
    lists.insert(mut values, 0, copy(removed))
    lists.remove(mut values, [1])
    append(mut values[0], 9)
    lists.clear(mut values)
    mut units: Unit[] = [(), ()]
    lists.insert(mut units, max(len(units) - 1, 0), ())
    lists.remove(mut units, ())
    mut popped = lists.pop_at(mut units, 0)
    return before == [[1], [2], [1]] and removed == [2] and len(values) == 0 and len(units) == 1 and lists.index_of(units, ()) == 0 and f"{popped}" == "None"


# spec-case: NEW-CORE-LIST-S3-2
public func test_readonly_index_captures_receiver_before_needle_mutation() -> bool:
    mut values = [1, 2, 3]
    const captured_values = copy(values)
    const needle = clear_needle(mut values)
    mut index = lists.index_of(captured_values, needle)
    mut holder = Holder(items=[1, 2, 3])
    const captured_items = copy(holder.items)
    const nested_needle = clear_needle(mut holder.items)
    mut nested = lists.index_of(captured_items, nested_needle)
    return index == 2 and nested == 2 and len(values) == 0 and len(holder.items) == 0


# spec-case: NEW-CORE-LIST-S3-2
public func test_stepped_slice_clamps_endpoints_preserves_elements_and_evaluates_once() -> bool:
    mut values = [1, 2, 3, 4, 5, 6]
    if lists.stride(values, 0, 6, 2) != [1, 3, 5] or lists.stride(values, None, None, -1) != [6, 5, 4, 3, 2, 1]:
        return False
    if lists.stride(values, 99, 0, -1) != [6, 5, 4, 3, 2] or lists.stride(values, max(len(values) - 99, 0), 99, 3) != [1, 4]:
        return False
    if lists.stride(values, len(values) - 1, 0, -2) != [6, 4, 2] or lists.stride(values, 0, 6, 99) != [1] or len(lists.stride(values, 2, 2, -1)) != 0:
        return False
    if lists.stride(values, None, None, 1000000000000000000) != [1] or lists.stride(values, None, None, -1000000000000000000) != [6]:
        return False
    mut log: int[] = []
    mut selected = lists.stride(values, mark(mut log, 0), mark(mut log, 6), mark(mut log, 2))
    mut children = [[1], [2], [3]]
    mut reversed = lists.stride(children, None, None, -2)
    append(mut reversed[0], 9)
    lists.clear(mut children)
    return selected == [1, 3, 5] and log == [0, 6, 2] and reversed == [[3, 9], [1]]


# spec-case: NEW-CORE-LIST-S3-2
public func test_missing_index_traps() -> bool:
    mut values = [1, 2]
    return lists.index_of(values, 3) == 0


# spec-case: NEW-CORE-LIST-S3-2
public func test_missing_remove_traps() -> bool:
    mut values = [[1]]
    lists.remove(mut values, [2])
    return True


# spec-case: NEW-CORE-LIST-S3-2
public func test_indexed_pop_reports_original_negative_index() -> bool:
    mut values = [1, 2]
    return lists.pop_at(mut values, len(values) - 99) == 0


# spec-case: NEW-CORE-LIST-S3-2
public func test_zero_step_traps() -> bool:
    mut values = [1, 2]
    mut selected = lists.stride(values, None, None, 0)
    return len(selected) == 0
