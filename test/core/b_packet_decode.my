module b_packet_decode

record Packet:
    identifier: int
    payload_sum: int
    length: int

# Port of benchmarks/runtime/expanded/compute/main.my::decode, without setup/I/O.
def decode(raw: bytes) -> Result[Packet, int]:
    if len(raw) < 6:
        return Err(3)
    if raw[0] != 165:
        return Err(1)
    if raw[1] != 1:
        return Err(2)
    length = raw[4]
    if len(raw) != length + 6:
        return Err(3)
    check = 0
    for i in range(len(raw) - 1):
        check += raw[i]
    if check % 256 != raw[len(raw) - 1]:
        return Err(4)
    total = 0
    for i in range(5, len(raw) - 1):
        total += raw[i]
    return Ok(Packet(identifier=raw[2] * 256 + raw[3], payload_sum=total, length=length))

# spec-case: NEW-CORE-S3-NUMBER-1
public def test_packet_decode_octet_operations() -> bool:
    match decode(b"\xa5\x01\x00\x07\x04\x0a\x0b\x0c\x0d\xdf"):
        case Ok(packet):
            if packet.identifier != 7 or packet.payload_sum != 46 or packet.length != 4:
                return False
        case Err(_):
            return False
    return decode(b"\xa5\x01\x00\x07\x04\x0a\x0b\x0c\x0d\x00") == Err(4) and decode(b"\x00\x01\x00\x07\x04\x0a\x0b\x0c\x0d\xdf") == Err(1) and decode(b"short") == Err(3)

def main() -> int:
    return 0
