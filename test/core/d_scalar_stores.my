module d_scalar_stores

public def test_integer_cow_index_and_tombstone() -> bool:
    values: dict[str, int] = {str(j): j for j in range(20)}
    snapshot = values
    values["3"] = 90
    _ = values.pop("4")
    values["5"] = 91
    values["4"] = 92
    return len(values) == 20 and snapshot["3"] == 3 and snapshot["4"] == 4 and values["3"] == 90 and values["5"] == 91 and values["4"] == 92

public def test_bool_store_and_snapshot() -> bool:
    values: dict[bool, bool] = {False: False, True: True}
    snapshot = values
    values[False] = True
    _ = values.pop(True)
    values[False] = False
    return not snapshot[False] and snapshot[True] and not values[False] and len(values) == 1

public def test_unit_store_and_snapshot() -> bool:
    values: dict[int, None] = {1: None, 2: None}
    snapshot = values
    values[1] = None
    _ = values.pop(2)
    values[1] = None
    _ = snapshot[2]
    _ = values[1]
    return len(snapshot) == 2 and len(values) == 1 and 2 in snapshot and 1 in values

public def test_narrow_store_and_snapshot() -> bool:
    values: dict[i8, u8] = {i8(-7): u8(3), i8(8): u8(4)}
    snapshot = values
    values[i8(-7)] = u8(255)
    _ = values.pop(i8(8))
    values[i8(-7)] = u8(0)
    return snapshot[i8(-7)] == u8(3) and values[i8(-7)] == u8(0) and snapshot[i8(8)] == u8(4) and len(values) == 1

public def test_float_store_nan_and_snapshot() -> bool:
    nan = 0.0
    match float("nan"):
        case Some(value):
            nan = value
        case None:
            return False
    values: dict[str, float] = {"zero": -0.0, "nan": nan}
    snapshot = values
    values["zero"] = 1.25
    values["nan"] = nan
    return snapshot["zero"] == 0.0 and values["zero"] == 1.25 and values["nan"] != values["nan"] and snapshot["nan"] != snapshot["nan"]
