import dicts

func main(out: Stream) -> int:
    mut d: dict[int, int] = {2: 7, 1: 9}
    print(out, len(d), d[2], dicts.get(d, 3, 99), 2 in d)
    mut saved = copy(d)
    d[2] = 11
    d[3] = dicts.get(d, 3, 0) + 8
    print(out, saved[2], d[2], len(d))
    for key, value in dicts.items(d):
        print(out, key, value)
    mut popped = dicts.pop(mut d, 1)
    d[1] = 42
    print(out, popped, dicts.get(d, 1, 0))
    for key in d:
        print(out, key)
    mut other: dict[int, int] = {1: 42, 3: 8, 2: 11}
    print(out, d == other)
    return 0
