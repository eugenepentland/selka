record Big:
    a: int
    b: int
    c: int
    d: int
    names: int[]
    more: int[]


enum Slot:
    empty
    one(value: int)
    big(value: Big)


func mk(i: int) -> Big:
    return Big(a=i, b=i + 1, c=i + 2, d=i + 3, names=[i, i + 1], more=[])


func grow(b0: Big, v: int) -> Big:
    mut b = copy(b0)
    append(mut b.names, v)
    append(mut b.more, v * 2)
    b.a = b.a + 1
    return b


func weight(s: Slot) -> int:
    match s:
        case empty:
            return 0
        case one(value=n):
            return n
        case big(value=b):
            return b.a + b.d + len(b.names) * 100 + len(b.more) * 1000


func spin(b0: Big, n: int) -> int:
    mut b = copy(b0)
    mut other = mk(100)
    for i in range(n):
        mut t = own b
        b = grow(other, i)
        other = own t
    return b.a * 1000 + other.a + len(b.names) + len(other.names)


func main(out: Stream) -> int:
    mut slots: Slot[] = [Slot.empty, Slot.one(value=5), Slot.big(value=mk(7))]
    mut shared = grow(mk(1), 9)
    append(mut slots, Slot.big(value=copy(shared)))
    append(mut slots, Slot.big(value=copy(shared)))
    mut total = 0
    for i in range(len(slots)):
        total += weight(slots[i])
    print(out, total, len(shared.names), len(shared.more))
    print(out, spin(mk(1), 5), spin(mk(3), 0))
    mut bigs = [mk(1), mk(2)]
    bigs[0] = grow(bigs[0], 4)
    append(mut bigs[1].names, 8)
    bigs[1].a = 50
    print(out, len(bigs[0].names), len(bigs[1].names), bigs[1].a, bigs[0].a)
    return 0
