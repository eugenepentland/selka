module rc_alias_paths

# rc_fuzz.py seed 62 case 26: an alias read across a loop that appends to the original,
# where only one of several paths into the loop carries a shared block (NEW-CORE-RC-9).

def make_ints(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i)
    return out

def grow_int(xs: list[int], n: int) -> list[int]:
    ys = xs
    if n > 1:
        return xs
    ys.append(n)
    return ys

def grow_str(xs: list[str], n: int) -> list[str]:
    ys = xs
    if n > 1:
        return xs
    ys.append("a")
    return ys

def grow_row(xs: list[list[int]], n: int) -> list[list[int]]:
    ys = xs
    if n > 1:
        return xs
    ys.append(make_ints(2))
    return ys

def body(seed: int, out: Stream) -> int:
    acc = 0
    il1: list[int] = []
    il1.append(6)
    sl2: list[str] = []
    sl2.append("xyz")
    rl3: list[list[int]] = []
    rl3.append(make_ints(seed))
    acc = acc + len(il1)
    for i2 in range(3):
        for i1 in range(2):
            sl2.append("xyz")
            il1.append(i2)
            ig4 = grow_int(il1, 1)
            if len(rl3) > 0:
                inner5 = rl3[0]
                inner5.append(5)
                acc = acc + len(inner5) + len(rl3[0])
            acc = acc + len(rl3)
        ra6 = rl3
        ia7 = il1
        sa8 = sl2
        for i1 in range(2):
            acc = acc + len(sa8)
            rg9 = grow_row(ra6, seed)
            acc = acc + len(ia7)
            sl2.append("bc")
        if len(ia7) > 3:
            acc = acc + len(sa8)
            sg10 = grow_str(sa8, seed)
            acc = acc + len(ia7)
            return acc + len(ia7)
    acc = acc + len(il1)
    if len(sl2) > 0:
        out.print(sl2[len(sl2) - 1])
    acc = acc + len(sl2)
    acc = acc + len(rl3)
    return acc

def main(args: list[str], out: Stream) -> int:
    out.print(body(len(args), out))
    return 0
