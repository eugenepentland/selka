module v_trace

union Failure:
    text: str,
    code: int


def parse(x: int) -> Result[int, str]:
    if x < 0:
        return Err("negative")
    return Ok(x)


def forward(x: int) -> Result[int, str]:
    r = parse(x)
    return r


def pass_on(x: int) -> Result[int, str]:
    v = forward(x)?
    return Ok(v + 1)


def lift(x: int) -> Result[int, Failure]:
    v = pass_on(x)?
    return Ok(v * 2)


def describe(f: Failure) -> str:
    match f:
        case Failure.text(t):
            return t
        case Failure.code(_):
            return "code"


def run(x: int) -> Result[int, str]:
    match lift(x):
        case Ok(v):
            return Ok(v)
        case Err(f):
            return Err(describe(f))


def main(args: list[str], out: Stream) -> Result[int, str]:
    a = pass_on(len(args) + 2)?
    match run(3):
        case Ok(v):
            out.print("run", a, v)
        case Err(e):
            out.print("run failed", e)
    match run(0 - 3):
        case Ok(v):
            out.print("run", v)
        case Err(e):
            out.print("run failed", e)
    b = pass_on(0 - len(args))?
    return Ok(a + b)
