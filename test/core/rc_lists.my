func shared_tail(xs: int[], extra: int) -> int[]:
    mut ys = xs.copy()
    ys.append(extra)
    return ys


func build(n: int) -> int[]:
    mut out: int[] = []
    for i in range(n):
        out.append(i * 2)
    return out


func early(xs: int[], limit: int) -> int:
    mut temp = build(limit)
    if len(xs) > limit:
        return len(temp)
    mut other = build(2)
    return len(temp) + len(other)


func names(n: int) -> str[]:
    mut out: str[] = []
    for i in range(n):
        if i % 2 == 0:
            out.append("even")
        else:
            out.append("odd")
    return out


func nested(n: int) -> int:
    mut rows: int[][] = []
    for i in range(n):
        mut row = build(i)
        rows.append(row.copy())
        rows.append(row)
    mut total = 0
    for r in rows:
        total = total + len(r)
    return total


func alias_phi(n: int) -> int:
    mut a = build(3)
    mut b = a.copy()
    if n > 2:
        b = build(n)
    b.append(7)
    return len(a) * 100 + len(b)


func keep_first(rows: int[][]) -> int[]:
    mut first = rows[0].copy()
    return first


func main(args: str[], out: Stream) -> int:
    mut base = build(4)
    mut grown = shared_tail(base, 9)
    out.print(len(base), len(grown), grown[4])
    out.print(early(base, 2), early(base, 10))
    mut words = names(5)
    out.print(len(words), words[0], words[1], len(args))
    out.print(nested(6), alias_phi(1), alias_phi(5))
    mut copy = words.copy()
    copy.append("x")
    out.print(len(words), len(copy), copy[5])
    mut grid: int[][] = []
    grid.append(base.copy())
    grid.append(grown)
    mut kept = keep_first(grid)
    kept.append(1)
    out.print(len(kept), len(base), len(grid[0]))
    return 0
