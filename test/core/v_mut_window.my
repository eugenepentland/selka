module v_mut_window

record Box:
    tag: int
    names: list[int]


record State:
    boxes: list[Box]
    seen: int


def count_boxes(state: mut State) -> int:
    state.seen = state.seen + 1
    return len(state.boxes)


def outer(state: mut State, counted: int, tag: int) -> int:
    state.boxes[0].names.append(tag)
    return counted * 100 + len(state.boxes[0].names)


def first(names: list[int], state: mut State) -> int:
    state.boxes[0].names.append(7)
    return len(names)


def main(out: Stream) -> int:
    state = State([Box(2, [1])], 0)
    box = state.boxes[0]
    seen = outer(mut state, count_boxes(mut state), box.tag)
    out.print(seen, state.boxes[0].names == [1, 2], state.seen)
    other = State([Box(4, [1, 2])], 0)
    held = other.boxes[0]
    got = first(held.names, mut other)
    out.print(got, len(other.boxes[0].names), len(held.names))
    return 0
