func published() -> int:
    mut items = [1]
    mut saved: int[][] = []
    for outer in range(3):
        for at in range(2):
            append(mut items, at)
        append(mut saved, copy(items))
    return len(saved[0]) * 1000 + len(saved[1]) * 100 + len(saved[2]) * 10 + len(items)


func snapshot(out: Stream) -> int:
    mut items = [1]
    mut before = copy(items)
    for at in range(5):
        append(mut items, at)
    print(out, len(before), len(items), before == [1])
    return 0


func main(out: Stream) -> int:
    mut code = published()
    print(out, code // 1000, code // 100 % 10, code // 10 % 10, code % 10)
    return snapshot(out)
