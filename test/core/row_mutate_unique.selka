extern func runtime_bench_now(host: Host) -> i64 effects(host)


# Row `mutate_unique` of benchmarks/runtime/ports/main.my as a program of its own, like compute_s0.selka: arguments
# `size iterations seed` (the original takes the row name first), the same setup, kernel,
# checksum and output `checksum elapsed`. The original also holds mutate_shared in the same branch; this program is the unique half.
func parse_number(text: str) -> int:
    match parse_int(text):
        case Some(value):
            return value
        case None:
            return 0


func main(args: str[], host: Host, out: Stream) -> int:
    if len(args) != 3:
        return 2
    mut size = parse_number(args[0])
    mut iterations = parse_number(args[1])
    mut seed = parse_number(args[2])
    if size < 2 or iterations < 1 or seed < 1 or seed > 1000000:
        return 2
    mut checksum = 0
    mut values = [for j in range(size) yield (seed + j * 13) % 1009]
    mut start = runtime_bench_now(host)
    for batch in range(iterations):
        mut index = (seed + batch * 17) % size
        values[index] = (values[index] + batch + 1) % 1000003
        checksum = (checksum + values[index]) % 1000000007
    mut elapsed = runtime_bench_now(host) - start
    for value in values:
        checksum = (checksum + value) % 1000000007
    out.print(checksum, elapsed)
    return 0
