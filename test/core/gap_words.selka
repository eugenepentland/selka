# Explicit copies at dictionary insertion remain independent after split fusion.
import strings

func count_words(s: str) -> dict[str, int]:
    mut counts: dict[str, int] = {}
    for word in strings.words(s):
        mut manual_key = copy(copy(word))
        mut manual_count = 1
        if word in counts:
            manual_count = counts[word] + 1
        counts[own manual_key] = manual_count
    return counts


func early(s: str) -> int:
    mut counts: dict[str, int] = {}
    for word in strings.words(s):
        if word in counts:
            return counts[word]
        counts[copy(word)] = 1
    return 0


func interrupted(s: str) -> dict[str, int]:
    mut counts: dict[str, int] = {}
    for word in strings.words(s):
        if word in counts:
            continue
        counts[copy(word)] = 1
        if len(counts) == 2:
            break
    return counts


public func test_words_unicode_empty_and_owned_keys() -> bool:
    mut empty = count_words("")
    assert len(empty) == 0
    mut spaces = count_words(" \t\n\r\x0b\x0c ")
    assert len(spaces) == 0
    mut source = "é é 😀 é x"
    mut counts = count_words(source)
    source += " changed"
    assert counts["é"] == 2
    assert counts["😀"] == 1
    assert counts["é x"] == 1
    assert len(counts) == 3
    return True


public func test_words_early_return_break_continue() -> bool:
    assert early("a b a") == 1
    mut counts = interrupted("a a b c")
    assert len(counts) == 2
    assert counts["a"] == 1
    assert counts["b"] == 1
    return True


public func test_split_standalone_still_owns_strings() -> bool:
    mut source = "x y"
    mut parts = strings.words(source)
    source += " z"
    assert parts == ["x", "y"]
    mut explicit = strings.split("|é||😀|", "|")
    assert explicit == ["", "é", "", "😀", ""]
    mut empty = strings.split("", "|")
    assert empty == [""]
    return True
