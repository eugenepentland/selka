module b_buffer_values

record Packet:
    body: byte_buffer

# spec-case: NEW-CORE-S3-NUMBER-1
public def test_byte_buffer_snapshots_copies_and_places() -> bool:
    source = [1, 2, 3]
    buffer = byte_buffer(source)
    copy = buffer
    snapshot = bytes(buffer)
    if not buffer.append_byte(4):
        return False
    if copy != b"\x01\x02\x03" or snapshot != copy or len(source) != 3 or source[0] != 1 or source[1] != 2 or source[2] != 3:
        return False
    packet = Packet(buffer)
    if not packet.body.append_byte(5):
        return False
    return packet.body == b"\x01\x02\x03\x04\x05" and buffer == b"\x01\x02\x03\x04"

# spec-case: NEW-CORE-S3-NUMBER-1
public def test_buffer_append_range_utf8_and_float_preserve_inputs() -> bool:
    buffer = byte_buffer([])
    if not buffer.reserve(32) or not buffer.append_utf8("λ") or not buffer.append_float(-0.0):
        return False
    if buffer.append_byte(256) or buffer.append_range(b"abc", 2, 1):
        return False
    return bytes(buffer) == b"\xce\xbb-0.0"

def main() -> int:
    return 0
