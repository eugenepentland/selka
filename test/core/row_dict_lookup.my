
extern func runtime_bench_now(host: Host) -> i64 effects(host)

func batch_result(size: int, batch: int, seed: int, values: int[], keys: str[], lookup: dict[int, int], lookup_str: dict[str, int]) -> int:
    mut total = 0
    for j in range(size):
        mut key = (seed + j * 17 + batch) % (size * 2)
        total += lookup.get(key, 17)
    return total

func parse_number(text: str) -> int:
    match parse_int(text):
        case Some(n):
            return n
        case None:
            return 0


func main(args: str[], host: Host, out: Stream) -> int:
    if len(args) != 3:
        return 2
    mut size = parse_number(args[0])
    mut iterations = parse_number(args[1])
    mut seed = parse_number(args[2])
    if size < 2 or iterations < 1 or seed < 1 or seed > 1000000:
        return 2
    mut values = [for j in range(size) yield (seed + j * 13) % 1009]
    mut keys: str[] = []
    mut lookup: dict[int, int] = {}
    mut lookup_str: dict[str, int] = {}
    for j in range(size):
        lookup[j] = values[j]
    mut checksum = 0
    mut start = runtime_bench_now(host)
    for batch in range(iterations):
        mut part = batch_result(size, batch, seed, values, keys, lookup, lookup_str)
        if part < 0:
            return 2
        checksum = (checksum + part) % 1000000007
    mut elapsed = runtime_bench_now(host) - start
    out.print(checksum, elapsed)
    return 0
