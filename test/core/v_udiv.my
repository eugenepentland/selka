

func half(x: u8) -> u8:
    return x // 2u8


func rest(x: u32) -> u32:
    return x % 7u32


func whole(x: u64) -> u64:
    return x // 1u64


func third(x: u64) -> u64:
    return x // 3u64


func main(out: Stream) -> int:
    out.print(half(254u8), half(255u8), rest(4294967294u32), whole(18446744073709551615u64), third(18446744073709551615u64))
    return 0
