module f2_index

# Index facts (lane F2, NEW-CORE-F2-*): a written index tested as written before its
# normalization from the end, a fill loop's length only after the loop, a dominating
# `i < len(other)` for a list of the same length, and checks a dominating check already
# made. `main` runs every scenario that must succeed; a first argument names one scenario
# (some of them must trap), and each further argument makes it larger.


record Point:
    x: int
    y: int


record Stack:
    items: list[int]
    top: int


def at(xs: list[int], i: int) -> int:
    return xs[i]


def put(xs: mut list[int], i: int, v: int):
    xs[i] = v


def shift(ps: mut list[Point], i: int, dx: int) -> int:
    ps[i].x = ps[i].x + dx
    return ps[i].x * 100 + ps[i].y


# Negative indexes count from the end, read, written, and in element fields.
def wraps(size: int) -> int:
    xs = [10, 20, 30, 40 + size]
    total = at(xs, 0) + at(xs, -1) * 10 + at(xs, -4) * 100
    put(mut xs, -2, 7)
    put(mut xs, 1, 9)
    ps = [Point(x=1, y=2), Point(x=3, y=4)]
    moved = shift(mut ps, -1, 5) + shift(mut ps, -2, size)
    return total * 1000000 + xs[1] * 10000 + xs[2] * 100 + moved


# An index that is negative on one path only: both reads see the same element.
def one_path(xs: list[int], negative: bool, size: int) -> int:
    i = 1
    if negative:
        i = -1 - size
    a = xs[i]
    b = xs[i]
    return a * 10 + b


# A list read inside the loop that fills it: shorter than the fill bound there.
def fill_inside(n: int) -> int:
    zs: list[int] = []
    total = 0
    for i in range(n):
        total = total + zs[i]
        zs.append(i)
    return total


# The same list read after its fill loop has exited: in range.
def fill_after(n: int) -> int:
    ys: list[int] = []
    for i in range(n):
        ys.append(i * 3)
    total = 0
    for i in range(n):
        total = total + ys[i]
    return total


# A pop between two reads of one index: the second read is checked again.
def shrink(xs: mut list[int], i: int) -> int:
    a = xs[i]
    _ = xs.pop()
    b = xs[i]
    return a * 100 + b


def drop(xs: mut list[int]):
    _ = xs.pop()


# A loop whose list loses elements in the body, directly or through a `mut` callee.
def loop_shrink(xs: mut list[int], through_callee: bool) -> int:
    total = 0
    for i in range(len(xs)):
        total = total + xs[i]
        if i == 1:
            if through_callee:
                drop(mut xs)
            else:
                _ = xs.pop()
    return total


# A field written between two reads: the second index is another value.
def bump(s: mut Stack) -> int:
    a = s.items[s.top]
    s.top = s.top + 1
    b = s.items[s.top]
    return a * 100 + b


# Hoare partition's swap after its scans (sort_quick's shape), and a list of the same
# length written through a copy.
def partition(xs: mut list[int], lo: int, hi: int) -> int:
    pivot = xs[lo + (hi - lo) // 2]
    i = lo
    j = hi
    while i <= j:
        while xs[i] < pivot:
            i = i + 1
        while xs[j] > pivot:
            j = j - 1
        if i <= j:
            temp = xs[i]
            xs[i] = xs[j]
            xs[j] = temp
            i = i + 1
            j = j - 1
    return i * 1000 + j


def same_length(xs: list[int], extra: int) -> int:
    ys = xs
    ys[0] = 99
    zs = [1 for _ in range(extra)]
    total = 0
    for i in range(len(xs)):
        total = total + ys[i] * 10 + xs[i]
    for i in range(len(zs)):
        total = total + xs[i]
    return total


# A stack as the Lox VM keeps it: a top field and a frame count read before each write.
def machine(steps: int) -> int:
    s = Stack(items=[0 for _ in range(8)], top=0)
    frames = [Point(x=0, y=0), Point(x=0, y=0)]
    count = 1
    acc = 0
    for k in range(steps):
        frame = frames[count - 1]
        frame.x = frame.x + 1
        frames[count - 1] = frame
        s.items[s.top] = k
        s.top = s.top + 1
        if s.top == 8:
            while s.top > 0:
                s.top = s.top - 1
                acc = acc + s.items[s.top] * s.items[s.top - 1 - 0 + 1 - 1]
        frames[count - 1] = frame
    return acc * 10 + frames[0].x


# The next index after a checked one: in range only while `i + 1 < len(xs)`.
def next_index(xs: list[int], i: int) -> int:
    a = xs[i]
    b = xs[i + 1]
    return a * 100 + b


def scenario(name: str, size: int, out: Stream) -> int:
    xs = [5, 3, 8, 1, 9, 2, 7 + size]
    if name == "wraps" or name == "all":
        out.print(wraps(size))
    if name == "one_path" or name == "all":
        out.print(one_path(xs, False, size), one_path(xs, True, size))
    if name == "fill_after" or name == "all":
        out.print(fill_after(10 + size))
    if name == "fill_inside":
        out.print(fill_inside(3 + size))
    if name == "shrink" or name == "all":
        ys = [1, 2, 3, 4 + size]
        out.print(shrink(mut ys, 1), shrink(mut ys, -1))
    if name == "shrink_trap":
        ys = [1, 2, 3, 4 + size]
        out.print(shrink(mut ys, 3))
    if name == "loop_shrink":
        ys = [1, 2, 3, 4 + size]
        out.print(loop_shrink(mut ys, size > 0))
    if name == "bump" or name == "all":
        s = Stack(items=[4, 5, 6 + size], top=0)
        out.print(bump(mut s), s.top)
    if name == "bump_trap":
        s = Stack(items=[4, 5, 6 + size], top=2 + size)
        out.print(bump(mut s))
    if name == "partition" or name == "all":
        ys = [5, 3, 8, 1, 9, 2, 7 + size, 4, 6]
        out.print(partition(mut ys, 0, len(ys) - 1), ys[0], ys[8])
    if name == "same_length" or name == "all":
        out.print(same_length(xs, 3 + size))
    if name == "same_length_trap":
        out.print(same_length(xs, 8 + size))
    if name == "machine" or name == "all":
        out.print(machine(20 + size))
    if name == "next" or name == "all":
        out.print(next_index(xs, 2 + size))
    if name == "next_trap":
        out.print(next_index(xs, 6))
    return 0


def main(args: list[str], out: Stream) -> int:
    if len(args) == 0:
        return scenario("all", 0, out)
    return scenario(args[0], len(args) - 1, out)
