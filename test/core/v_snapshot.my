record Frame:
    code: int[]
    ip: int


func poke(mut xs: int[]) -> int:
    xs[0] = 50
    return 0


func grow(mut xs: int[]) -> int:
    xs.append(99)
    return 0


func swap(mut xs: int[]) -> int:
    xs = [7, 8, 9]
    xs.append(1)
    return 0


func replace_code(mut frame: Frame) -> int:
    frame.code = [17, 19, 23]
    return 1


func selected(mut frame: Frame) -> int:
    const code = frame.code.copy()
    return code[replace_code(mut frame)]


func main(out: Stream) -> int:
    mut a = [1, 2, 3]
    const before_a = a.copy()
    out.print(before_a[poke(mut a)], a[0])
    mut b = [1, 2, 3]
    const before_b = b.copy()
    out.print(before_b[grow(mut b)], len(b))
    mut c = [1, 2, 3]
    const before_c = c.copy()
    out.print(before_c[swap(mut c)], c[0])
    mut d = [1, 2, 3]
    mut snapshot = d.copy()
    const before_d = d.copy()
    out.print(before_d[poke(mut d)], d[0], snapshot[0])
    mut frame = Frame(code=[7, 11], ip=0)
    out.print(selected(mut frame), len(frame.code), frame.code[0])
    return 0
