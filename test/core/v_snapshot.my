module v_snapshot


record Frame:
    code: list[int]
    ip: int


def poke(xs: mut list[int]) -> int:
    xs[0] = 50
    return 0


def grow(xs: mut list[int]) -> int:
    xs.append(99)
    return 0


def swap(xs: mut list[int]) -> int:
    xs = [7, 8, 9]
    xs.append(1)
    return 0


def replace_code(frame: mut Frame) -> int:
    frame.code = [17, 19, 23]
    return 1


def selected(frame: mut Frame) -> int:
    return frame.code[replace_code(mut frame)]


def main(out: Stream) -> int:
    a = [1, 2, 3]
    out.print(a[poke(mut a)], a[0])
    b = [1, 2, 3]
    out.print(b[grow(mut b)], len(b))
    c = [1, 2, 3]
    out.print(c[swap(mut c)], c[0])
    d = [1, 2, 3]
    snapshot = d
    out.print(d[poke(mut d)], d[0], snapshot[0])
    frame = Frame(code=[7, 11], ip=0)
    out.print(selected(mut frame), len(frame.code), frame.code[0])
    return 0
