extern func runtime_bench_now(host: Host) -> i64 effects(host)


# Row `option_handle` of benchmarks/runtime/expanded/compute/main.my as a program of its own, like compute_s0.selka: arguments
# `size iterations seed` (the original takes the row name first), the same setup, kernel,
# checksum and output `checksum elapsed`. The frames, flags, ordered values and function value other rows need are left out; none of them reaches this checksum.
func optional(x: int, phase: int) -> int?:
    if x % 4 == 0:
        return None
    return Some(x + phase)


func parse_number(text: str) -> int:
    match parse_int(text):
        case Some(value):
            return value
        case None:
            return 0


func main(args: str[], host: Host, out: Stream) -> int:
    if len(args) != 3:
        return 2
    mut size = parse_number(args[0])
    mut iterations = parse_number(args[1])
    mut seed = parse_number(args[2])
    if size < 2 or iterations < 1 or seed < 1 or seed > 1000000:
        return 2
    mut values = [for j in range(size) yield (seed + j * 37) % 1009]
    mut checksum = 0
    mut start = runtime_bench_now(host)
    for batch in range(iterations):
        mut phase = batch % 17
        mut pass_total = 0
        for j in range(size):
            mut x = values[j]
            mut value = 0
            match optional(x, phase):
                case Some(number):
                    value = number * 3 + 1
                case None:
                    value = 19
            pass_total += value
        checksum = (checksum + pass_total) % 1000000007
    mut elapsed = runtime_bench_now(host) - start
    out.print(checksum, elapsed)
    return 0
