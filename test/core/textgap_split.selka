import strings

func score(text: str) -> int:
    mut raw = strings.encode(text)
    mut result = len(raw)
    for value in raw:
        result += value
    return result


func fold(text: str, separator: str) -> int:
    mut parts = strings.split(text, separator)
    mut result = len(parts) * 7
    for part in parts:
        result += score(part)
    return result


func owned(text: str, separator: str) -> str[]:
    return strings.split(text, separator)


func first(text: str, separator: str) -> str:
    for part in strings.split(text, separator):
        return copy(part)
    return "missing"


func unstable(text: str, separator: str) -> int:
    mut source = copy(text)
    mut parts = strings.split(source, separator)
    mut result = len(parts) * 7
    for part in parts:
        source += "changed"
        result += score(part)
    return result


func unstable_separator(text: str) -> int:
    mut separator = "|"
    mut parts = strings.split(text, separator)
    mut result = len(parts) * 7
    for part in parts:
        separator += "changed"
        result += score(part)
    return result


func main(out: Stream) -> int:
    print(out, fold("", "::"), fold("a||é|", "|"), fold("é::😀::::", "::"), fold("abc", "::"))
    mut source = "a|b|c"
    mut parts = owned(source, "|")
    mut token = first(source, "|")
    source += "changed"
    assert parts == ["a", "b", "c"]
    assert token == "a"
    print(out, unstable("a|b|c", "|"), unstable_separator("a|b|c"))
    return 0
