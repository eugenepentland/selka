module rc_promote_order

# A list field read after its record was already consumed by an earlier update
# (a copy's field rebound through `mut`) is borrowed, not promoted: updating it
# while a snapshot of the record is still live copies (NEW-CORE-RC-13).

record Bucket:
    count: int
    items: list[int]


def replace_once(xs: mut list[int], k: int):
    xs = [k]


def replace_loop(xs: mut list[int], k: int):
    for phase in range(k % 4):
        xs.append(phase)
        xs = [(k + phase) % 1009]
        xs.append(phase)


def main(out: Stream) -> int:
    xs = [1, 2, 3]
    b = Bucket(3, xs)
    c = b
    replace_once(mut c.items, 9)
    xs.append(4)
    snap = b
    b.items.append(5)
    out.print(xs, b.items, c.items, snap.items)
    ys = [7, 8]
    d = Bucket(2, ys)
    e = d
    replace_loop(mut e.items, 3)
    ys.append(9)
    keep = d
    d.items.append(10)
    out.print(ys, d.items, e.items, keep.items, len(keep.items) * 5 + len(d.items))
    return 0
