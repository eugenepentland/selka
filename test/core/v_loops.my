

func find_first(xs: int[], target: int) -> int:
    mut at = 0
    while True:
        if at >= len(xs):
            return -1
        if xs[at] == target:
            return at
        at += 1


func count_up(n: int) -> int:
    mut total = 0
    mut at = 0
    while True:
        if at == n:
            break
        total += at
        at += 1
    return total


func skip_odd(n: int) -> int:
    mut total = 0
    mut at = -1
    while True:
        at += 1
        if at >= n:
            break
        if at % 2 == 1:
            continue
        total += at
    return total


func rebinding(values: int[]) -> int:
    mut total = 0
    mut names = values
    for x in names:
        names = [7]
        total += x
    return total * 10 + len(names)


func main(out: Stream) -> int:
    mut xs = [4, 8, 15, 16, 23, 42]
    out.print(find_first(xs, 15), find_first(xs, 5), find_first([], 1))
    out.print(count_up(10), count_up(0), skip_odd(11), skip_odd(0))
    out.print(rebinding([1, 2, 3]), rebinding([]))
    return 0
