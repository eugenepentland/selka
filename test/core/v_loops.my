module v_loops


def find_first(xs: list[int], target: int) -> int:
    at = 0
    while True:
        if at >= len(xs):
            return -1
        if xs[at] == target:
            return at
        at += 1


def count_up(n: int) -> int:
    total = 0
    at = 0
    while True:
        if at == n:
            break
        total += at
        at += 1
    return total


def skip_odd(n: int) -> int:
    total = 0
    at = -1
    while True:
        at += 1
        if at >= n:
            break
        if at % 2 == 1:
            continue
        total += at
    return total


def main(out: Stream) -> int:
    xs = [4, 8, 15, 16, 23, 42]
    out.print(find_first(xs, 15), find_first(xs, 5), find_first([], 1))
    out.print(count_up(10), count_up(0), skip_odd(11), skip_odd(0))
    return 0
