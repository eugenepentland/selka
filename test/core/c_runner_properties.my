@invariant(self.low <= self.high, "ordered generated interval")
public record Interval:
    low: int
    high: int


public enum Tree:
    leaf(value: int)
    branch(value: Tree)


public enum Tone:
    red
    green
    blue


public func test_enum_table_set_boolean_and_float(tone: Tone, grid: [Tone] i8, flags: set[int], bit: bool, scalar: float) -> bool:
    for value in flags:
        if value not in flags:
            return False
    return tone == tone and grid[Tone.red] <= 127i8 and (bit or not bit) and (scalar == scalar or scalar != scalar)


public func test_integer_identity(x: int, width: u8) -> bool:
    return x == x and width <= 255u8


@requires(n >= 0, "nonnegative input")
public func test_own_precondition_discards(n: int) -> bool:
    return n // 2 <= n


public func test_record_invariant_discards(span: Interval) -> bool:
    return span.low <= span.high


public func test_list_and_dictionary(xs: int[], d: dict[str, int]) -> bool:
    return xs == xs and len(d) >= 0


public func test_text_and_bytes(text: str, octets: bytes) -> bool:
    return text == text and octets == octets


public func test_option_and_array(value: int?, fixed: FixedArray[u8, 4]) -> bool:
    return value == value and len(fixed) == 4


public func test_recursive_generated_value(tree: Tree) -> bool:
    return tree == tree


public func test_result_true(value: int) -> Result[bool, str]:
    return Ok(value == value)


public func test_stdout_and_stderr_are_trial_local(value: int, out: Stream, err: Stream) -> bool:
    out.print(value)
    err.print(value)
    return True
