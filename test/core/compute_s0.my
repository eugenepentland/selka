module compute_s0

extern def runtime_bench_now(host: Host) -> i64 effects(host)

# The S0 kinds of benchmarks/runtime/expanded/compute/main.my in one program, with
# the same per-element dispatch on an invariant `kind` inside the timed loop.
# Kinds: 0 integer_math, 1 float_math, 2 branch_predictable, 3 branch_mixed,
# 6 call_direct, 10 binary_search (the benchmark's numbering).

def parse_number(text: str) -> int:
    match int(text):
        case Some(value):
            return value
        case None:
            return 0


def affine_a(x: int) -> int:
    return x * 3 + 7


def search(values: list[int], key: int) -> int:
    low = 0
    high = len(values)
    while low < high:
        middle = (low + high) // 2
        if values[middle] < key:
            low = middle + 1
        else:
            high = middle
    if low < len(values) and values[low] == key:
        return low + 1
    return 0


def main(args: list[str], host: Host, out: Stream) -> int:
    if len(args) != 4:
        return 2
    kind = parse_number(args[0])
    size = parse_number(args[1])
    iterations = parse_number(args[2])
    seed = parse_number(args[3])
    if size < 2 or iterations < 1 or seed < 1 or seed > 1000000:
        return 2
    values = [(seed + j * 37) % 1009 for j in range(size)]
    ordered = [j * 3 + seed % 11 for j in range(size)]
    predictable = [j % 16 != 0 for j in range(size)]
    mixed = [(values[j] * 73 + j * 19 + seed) % 101 < 50 for j in range(size)]
    checksum = 0
    start = runtime_bench_now(host)
    for batch in range(iterations):
        phase = batch % 17
        pass_total = 0
        for j in range(size):
            x = values[j]
            value = 0
            if kind == 0:
                value = ((x + phase) * 17 + 23) // 7 % 1009
            elif kind == 1:
                a = float(x) / 8.0 + float(phase) / 4.0
                b = float(x) / 16.0 + 1.0
                value = int((a * b + 0.5) * 128.0)
            elif kind == 2:
                if predictable[j]:
                    value = (x + phase) * 3 + 1
                else:
                    value = (x + phase) * 5 + 7
            elif kind == 3:
                if mixed[j]:
                    value = (x + phase) * 3 + 1
                else:
                    value = (x + phase) * 5 + 7
            elif kind == 6:
                value = affine_a(x + phase)
            elif kind == 10:
                value = search(ordered, (x + phase) % (size * 3 + 3) + seed % 11)
            else:
                return 2
            pass_total += value
        checksum = (checksum + pass_total) % 1000000007
    elapsed = runtime_bench_now(host) - start
    out.print(checksum, elapsed)
    return 0
