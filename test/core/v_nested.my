module v_nested

record Item:
    code: int
    payload: list[int]


record Box:
    items: list[Item]


def grow(rows0: list[list[int]], i: int, v: int) -> int:
    rows = rows0
    rows[i].append(v)
    return len(rows[i]) * 100 + len(rows0[i])


def deep(b0: Box, v: int) -> int:
    b = b0
    b.items[0].payload[0] = v
    b.items[1].payload.append(v + 1)
    b.items[1].code = 77
    return b.items[0].payload[0] * 10000 + len(b.items[1].payload) * 100 + b0.items[0].payload[0] + b.items[1].code


def main(out: Stream) -> int:
    rows = [[1], [2, 3]]
    out.print(grow(rows, 1, 9), len(rows[1]))
    items = [Item(code=1, payload=[1, 2]), Item(code=2, payload=[3])]
    out.print(deep(Box(items=items), 55), items[0].payload[0], len(items[1].payload))
    return 0
