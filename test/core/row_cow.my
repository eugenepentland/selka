# s19_shared_during_build.my
def same_s19(xs: list[list[int]]) -> list[list[int]]:
    return xs


def shape_s19(out: Stream) -> int:
    b = [[1, 2]]
    snap = b
    b.append([3, 4])
    for i in range(2):
        b[i][0] = 7
    out.print(snap[0][0], b[0][0])
    c = [[1, 2]]
    t = same_s19(c)
    c.append([3, 4])
    for i in range(2):
        c[i][0] = 7
    out.print(t[0][0], c[0][0])
    d = [[1, 2], [5, 6]]
    u = d
    d[1] = [3, 4]
    for i in range(2):
        d[i][0] = 7
    out.print(u[0][0], d[0][0])
    return 0


# s20_calls_in_loop.my
def row_s20(xs: list[list[int]], i: int) -> list[int] effects():
    return xs[i]


def pick_s20(f: def(list[list[int]], int) -> list[int] effects(), xs: list[list[int]], i: int) -> list[int]:
    return f(xs, i)


def shape_s20(out: Stream) -> int:
    b = [[1, 2], [3, 4], [5, 6]]
    k = [0]
    for i in range(3):
        b[i][0] = 9
        if i == 0:
            k = row_s20(b, 2)
    out.print(k[0], b[2][0])
    c = [[1, 2], [3, 4], [5, 6]]
    kc = [0]
    for i in range(3):
        c[i][0] = 9
        if i == 0:
            kc = pick_s20(row_s20, c, 2)
    out.print(kc[0], c[2][0])
    d = [[1, 2], [3, 4]]
    kd = pick_s20(row_s20, d, 1)
    for i in range(2):
        d[i][0] = 7
    out.print(kd[0], d[1][0])
    return 0


# s21_slice_loop.my
def shape_s21(out: Stream) -> int:
    b = [[1, 2], [3, 4]]
    acc = 0
    for r in b[0:2]:
        b[1][0] = 9
        acc += r[0]
    out.print(acc, b[1][0])
    c = [[1, 2], [3, 4]]
    acc2 = 0
    for r in c:
        c[1][0] = 9
        acc2 += r[0]
    out.print(acc2, c[1][0])
    d = [[1, 2], [3, 4]]
    acc3 = 0
    for i in range(2):
        r = d[i]
        d[1][0] = 9
        acc3 += r[0]
    out.print(acc3, d[1][0])
    return 0


# s22_row_aliases_row.my
def shape_s22(out: Stream) -> int:
    b = [[1, 2], [3, 4]]
    b[0] = b[1]
    b[0][0] = b[0][0] + 0
    for i in range(1, 2):
        b[i][0] = 7
    out.print(b[1][0], b[0][0])
    c = [[1, 2]]
    c.append(c[0])
    for i in range(1, 2):
        c[i][0] = 7
    out.print(c[1][0], c[0][0])
    r = [1, 2]
    d = [r, r]
    for i in range(1, 2):
        d[i][0] = 7
    out.print(d[1][0], d[0][0])
    return 0


def main(out: Stream) -> int:
    _ = shape_rb(out)
    _ = shape_rc(out)
    _ = shape_rd(out)
    _ = shape_rf(out)
    _ = shape_s01(out)
    _ = shape_s02(out)
    _ = shape_s03(out)
    _ = shape_s04(out)
    _ = shape_s05(out)
    _ = shape_s06(out)
    _ = shape_s07(out)
    _ = shape_s08(out)
    _ = shape_s09(out)
    _ = shape_s10(out)
    _ = shape_s11(out)
    _ = shape_s12(out)
    _ = shape_s13(out)
    _ = shape_s14(out)
    _ = shape_s15(out)
    _ = shape_s16(out)
    _ = shape_s17(out)
    _ = shape_s18(out)
    _ = shape_s19(out)
    _ = shape_s20(out)
    _ = shape_s21(out)
    _ = shape_s22(out)
    return 0
