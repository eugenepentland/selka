# NEW-CORE-ROW-COW: one program of every shape in experiments/fix-row-cow-20261009/shapes
# (tools/fixture.py), run by src/core/row_cow_test.zig at debug, release and
# --verify-facts under the leak check against row_cow.expected.
# r_b.my
def scale_rb(c: mut list[list[float]], n: int):
    for i in range(n):
        for j in range(n):
            c[i][j] = c[i][j] * 2.0


def shape_rb(out: Stream) -> int:
    rows3 = [[1.0, 2.0], [3.0, 4.0]]
    keep3 = rows3[1]
    scale_rb(mut rows3, 2)
    out.print(rows3[1][1], keep3[1])
    return 0


# r_c.my
def shape_rc(out: Stream) -> int:
    rows3 = [[1.0, 2.0], [3.0, 4.0]]
    keep3 = rows3[1]
    for i in range(2):
        for j in range(2):
            rows3[i][j] = rows3[i][j] * 2.0
    out.print(rows3[1][1], keep3[1])
    return 0


# r_d.my
def scale_rd(c: mut list[list[float]], n: int):
    for i in range(n):
        for j in range(n):
            c[i][j] = c[i][j] * 2.0


def shape_rd(out: Stream) -> int:
    rows3 = [[1.0, 2.0], [3.0, 4.0]]
    keep3 = rows3[1]
    scale_rd(mut rows3, 2)
    scale_rd(mut rows3, 2)
    out.print(rows3[1][1], keep3[1])
    return 0


# r_f.my
def shape_rf(out: Stream) -> int:
    a = [[1, 2], [3, 4]]
    ka = a[1]
    a[1][0] = a[1][0] * 2
    out.print("readwrite-const", a[1][0], ka[0])
    b = [[1, 2], [3, 4]]
    kb = b[1]
    for i in range(2):
        b[i][0] = 7
    out.print("loop-write", b[1][0], kb[0])
    c = [[1, 2], [3, 4]]
    kc = c[1]
    for i in range(2):
        c[i][0] = c[i][0] * 2
    out.print("loop-readwrite", c[1][0], kc[0])
    d = [[1, 2], [3, 4]]
    kd = d[1]
    i = 1
    d[i][0] = d[i][0] + 10
    out.print("var-readwrite", d[1][0], kd[0])
    return 0


# s01_int_loop.my
def shape_s01(out: Stream) -> int:
    b = [[1, 2], [3, 4]]
    kb = b[1]
    ka = b[0]
    for i in range(2):
        b[i][0] = 7
    out.print(b[1][0], kb[0], b[0][0], ka[0])
    return 0


# s02_alias_inside_loop.my
def shape_s02(out: Stream) -> int:
    b = [[1, 2], [3, 4], [5, 6]]
    k = [0]
    for i in range(3):
        if i == 0:
            k = b[1]
        b[i][0] = 9
    out.print(k[0], b[0][0], b[1][0], b[2][0])
    c = [[1, 2], [3, 4]]
    acc = 0
    for i in range(2):
        r = c[i]
        c[i][0] = 0
        acc = acc + r[0] - c[i][0]
    out.print(acc, c[0][0] + 1)
    return 0


# s03_callee_alias.my
def row_s03(xs: list[list[int]], i: int) -> list[int]:
    return xs[i]


def grab_s03(xs: mut list[list[int]], i: int) -> list[int]:
    xs[0][1] = xs[0][1] + 0
    return xs[i]


def shape_s03(out: Stream) -> int:
    b = [[1, 2], [3, 4]]
    k = row_s03(b, 1)
    for i in range(2):
        b[i][0] = 7
    out.print(k[0], b[1][0])
    c = [[1, 2], [3, 4]]
    kc = grab_s03(mut c, 1)
    for i in range(2):
        c[i][0] = 7
    out.print(kc[0], c[1][0])
    return 0


# s04_record_items.my
record Bag_s04:
    n: int
    items: list[int]


def shape_s04(out: Stream) -> int:
    xs = [Bag_s04(n=1, items=[1, 2]), Bag_s04(n=2, items=[3, 4])]
    kept = xs[1]
    ki = xs[1].items
    for i in range(2):
        xs[i].items[0] = 7
    out.print(kept.items[0], xs[1].items[0], ki[0])
    ys = [Bag_s04(n=1, items=[1, 2]), Bag_s04(n=2, items=[3, 4])]
    ky = ys[1].items
    for i in range(2):
        ys[i].items.append(5)
    out.print(len(ky), len(ys[1].items) - 1)
    zs = [Bag_s04(n=1, items=[1]), Bag_s04(n=2, items=[3])]
    kz = zs[0]
    for i in range(2):
        zs[i].n = 5
    out.print(kz.n, zs[0].n)
    return 0


