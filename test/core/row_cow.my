# s09_append_filled.my
def shape_s09(out: Stream) -> int:
    b: list[list[int]] = []
    for i in range(3):
        row: list[int] = []
        for j in range(2):
            row.append(i * 2 + j + 1)
        b.append(row)
    k = b[1]
    first = b[0]
    for i in range(3):
        for j in range(2):
            b[i][j] = 7
    out.print(k[0], b[1][0], first[0])
    return 0


# s10_mut_param.my
def bump_s10(c: mut list[list[int]], n: int):
    for i in range(n):
        c[i][0] = c[i][0] * 2


def bump_big_s10(c: mut list[list[int]], n: int, out: Stream) effects(output, mutation):
    for i in range(n):
        j = 0
        while j < len(c[i]):
            c[i][j] = c[i][j] * 2
            j += 1
        if i > 100:
            out.print("never")


def shape_s10(out: Stream) -> int:
    b = [[1, 2], [3, 4]]
    k = b[1]
    bump_s10(mut b, 2)
    bump_s10(mut b, 2)
    k2 = b[1]
    bump_s10(mut b, 2)
    out.print(k[0], b[1][0] - 10, k2[0] - 9)
    c = [[1, 2], [3, 4]]
    kc = c[1]
    bump_big_s10(mut c, 2, out)
    bump_big_s10(mut c, 2, out)
    out.print(kc[0], c[1][0] + 2)
    return 0


# s11_control.my
def early_s11(b: mut list[list[int]], stop: int) -> int:
    for i in range(len(b)):
        if i == stop:
            return i
        b[i][0] = 7
    return -1


def shape_s11(out: Stream) -> int:
    b = [[1, 2], [3, 4], [5, 6]]
    k = b[1]
    i = 0
    while i < 3:
        b[i][0] = 7
        i += 1
    out.print(k[0], b[1][0])
    c = [[1, 2], [3, 4], [5, 6]]
    kc = c[1]
    for i2 in range(3):
        for j in range(2):
            if j == 1:
                continue
            c[i2][j] = 7
    out.print(kc[0], c[1][0])
    d = [[1, 2], [3, 4], [5, 6]]
    kd = d[1]
    for i3 in range(3):
        d[i3][0] = 7
        if i3 == 1:
            break
    out.print(kd[0], d[1][0])
    e = [[1, 2], [3, 4], [5, 6]]
    ke = e[1]
    stopped = early_s11(mut e, 2)
    out.print(ke[0], e[2][0] - 5 + stopped - 2)
    g = [[1, 2], [3, 4], [5, 6]]
    kg = g[1]
    n = 0
    for i4 in range(3):
        if i4 == 0:
            continue
        g[i4][0] = 7
        n += 1
    out.print(kg[0], g[1][0])
    return 0


