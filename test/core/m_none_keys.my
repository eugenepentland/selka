
func selected_key(mut log: int[]) -> Unit:
    log.append(1)

func selected_default(mut log: int[]) -> int:
    log.append(2)
    return 99

func grow(mut value: int[]) -> Unit:
    value.append(7)

record UnitKey:
    number: u64
    small: i16
    empty: Unit

# spec: NEW-CORE-S3-VALUES-1
# spec-case: HASH-KEYS-1
public func test_none_keys_replace_lookup_and_evaluate_operands_once() -> bool:
    mut mapping: dict[Unit, int] = {(): 3, (): 4}
    mut log: int[] = []
    mapping[selected_key(mut log)] = 8
    mut found = mapping.get(selected_key(mut log), selected_default(mut log))
    mut existing = mapping.setdefault((), 12)
    mut saved = mapping
    mut removed = mapping.pop(())
    mut absent = mapping.get((), 17)
    if len(mapping) != 0 or () in mapping or found != 8 or existing != 8:
        return False
    mut inserted = mapping.setdefault((), 23)
    return log == [1, 1, 2] and removed == 8 and absent == 17 and inserted == 23 and mapping[()] == 23 and saved == {(): 8} and () in saved

# spec-case: NEW-CORE-S3-VALUES-1
# spec-case: COW-MUT-ARGUMENT-1
public func test_none_key_mut_values_preserve_parent_and_readonly_snapshots() -> bool:
    mut mapping: dict[Unit, int[]] = {(): [1]}
    mut saved = mapping
    grow(mut mapping[()])
    mapping[()].append(9)
    mut removed = mapping.pop(())
    grow(mut removed)
    mapping[()] = removed
    mapping.update({(): [4, 5]})
    return saved == {(): [1]} and removed == [1, 7, 9, 7] and mapping == {(): [4, 5]}

# spec-case: NEW-CORE-S3-VALUES-1
# spec-case: HASH-KEYS-1
public func test_none_key_and_value_collections_keep_source_unit_spelling() -> bool:
    mut mapping: dict[Unit, Unit] = {(): ()}
    mut keys = list(mapping.keys())
    mut values = list(mapping.values())
    if f"{mapping}" != "{None: None}" or f"{keys}" != "[None]" or f"{values}" != "[None]":
        return False
    _ = mapping.pop(())
    mapping[()] = ()
    mut units: set[Unit] = {(), ()}
    mut saved = units
    mut popped = units.pop()
    if f"{popped}" != "None" or len(units) != 0 or () not in saved:
        return False
    units.add(())
    units.discard(())
    return len(mapping) == 1 and () in mapping and f"{mapping[()]}" == "None" and len(saved) == 1 and len(units) == 0

# spec-case: NEW-CORE-S3-VALUES-1
# spec-case: HASH-KEYS-1
public func test_structural_unit_keys_hash_equal_without_padding() -> bool:
    mut mapping: dict[UnitKey, int] = {}
    for i in range(100):
        mapping[UnitKey(number=u64(i), small=i16(i % 7), empty=())] = i + 1
    mut total = 0
    for i in range(100):
        total += mapping[UnitKey(number=u64(i), small=i16(i % 7), empty=())]
    mut some: Unit? = Some(())
    mut absent: Unit? = None
    mut options: dict[Unit?, int] = {some: 11, absent: 13}
    mut fixed: FixedArray[Unit, 2] = FixedArray[Unit, 2]([(), ()])
    mut arrays: dict[FixedArray[Unit, 2], int] = {fixed: 17}
    mut other: FixedArray[Unit, 2] = FixedArray[Unit, 2]([(), ()])
    return len(mapping) == 100 and total == 5050 and len(options) == 2 and options[some] == 11 and options[absent] == 13 and arrays[other] == 17

# spec-case: NEW-CORE-S3-VALUES-1
# spec-case: HASH-KEYS-1
public func test_none_key_remove_reinsert_tombstones_and_defaults() -> bool:
    mut mapping: dict[Unit, int[]] = {}
    mut empty = mapping.pop((), [0])
    for i in range(100):
        mapping[()] = [i]
        if mapping.get((), [999]) != [i]:
            return False
        mut removed = mapping.pop(())
        if removed != [i] or () in mapping:
            return False
    mapping[()] = [100]
    mut saved = mapping
    mapping.clear()
    return empty == [0] and saved == {(): [100]} and len(mapping) == 0

# spec-case: NEW-CORE-S3-VALUES-1
public func test_missing_none_key_traps() -> bool:
    mut mapping: dict[Unit, int] = {}
    return mapping[()] == 0
