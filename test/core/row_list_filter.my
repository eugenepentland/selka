module row_list_filter

extern def runtime_bench_now(host: Host) -> i64 effects(host)

# Row `list_filter` of benchmarks/runtime/expanded/collections/main.my as a program of its own, like
# compute_s0.my: arguments `size iterations seed` (the original takes the row name first), the same
# setup, kernel (the row's branch of `batch_result`), checksum and output `checksum elapsed`.
# The dictionaries, keys and Lox program the original builds for other rows are left out.


def fold(values: list[int]) -> int:
    total = 0
    for j in range(len(values)):
        total += (j + 1) * values[j]
    return total


def batch_result(size: int, batch: int, seed: int) -> int:
    input_values = [(seed + batch + j * 13) % 1009 for j in range(size)]
    filtered = [value for value in input_values if value % 3 == 0]
    return fold(filtered)


def parse_number(text: str) -> int:
    match int(text):
        case Some(n):
            return n
        case None:
            return 0


def main(args: list[str], host: Host, out: Stream) -> int:
    if len(args) != 3:
        return 2
    size = parse_number(args[0])
    iterations = parse_number(args[1])
    seed = parse_number(args[2])
    if size < 2 or iterations < 1 or seed < 1 or seed > 1000000:
        return 2
    checksum = 0
    start = runtime_bench_now(host)
    for batch in range(iterations):
        part = batch_result(size, batch, seed)
        if part < 0:
            return 2
        checksum = (checksum + part) % 1000000007
    elapsed = runtime_bench_now(host) - start
    out.print(checksum, elapsed)
    return 0
