module c_runner_state_capture
import time
import random

# Deliberately fail so the old/new reports preserve two independent trials'
# state. Clock, filesystem and entropy mutations must not reach the next trial.
public def test_failed_trials_start_from_identical_state(value: int, out: Stream, clock: Clock, entropy: Entropy, fs: Filesystem, env: Environment) -> bool:
    match time.now(clock):
        case Ok(start):
            out.print("clock", start.unix_nanoseconds)
        case Err(message):
            out.print(message)
    out.print("file", fs.exists("trial.txt"), "environment", len(env.names()))
    match random.from_entropy(entropy):
        case Ok(sampled):
            generator = sampled
            out.print("entropy", random.next_word(mut generator), random.next_word(mut generator))
        case Err(message):
            out.print(message)
    _ = fs.write_text("trial.txt", "written")
    _ = time.advance(clock, time.nanoseconds(1))
    out.print("input", value)
    return False
