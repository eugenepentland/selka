module u1_growth

# Growth of byte buffers and lists (NEW-CORE-U1-GROW-1): a large block grows with
# `realloc`. Appends start from an empty buffer, cross the small-block classes, the
# small-to-large boundary and many large doublings (some through `reserve`); a buffer
# another name still holds is copied before its append. Every answer here
# is the base compiler's (main 35df839be).


def checksum(buffer: byte_buffer) -> int:
    total = 0
    for i in range(len(buffer)):
        total = (total * 31 + buffer[i] + i) % 1000003
    return total


def piece_appends(count: int) -> int:
    empty: list[int] = []
    buffer = byte_buffer(empty)
    piece = b"0123456789abcdefghij"
    for i in range(count):
        _ = buffer.append_range(piece, i % 7, 7 + i % 13)
        if i % 997 == 0:
            _ = buffer.reserve(i)
    return checksum(buffer) * 1000 + len(buffer)


def byte_appends(count: int) -> int:
    empty: list[int] = []
    buffer = byte_buffer(empty)
    for i in range(count):
        _ = buffer.append_byte(i % 251)
    return checksum(buffer) + len(buffer) * 1000003


# The append copies `b` because `kept` still holds it: `kept` keeps the old octets.
def shared_append(count: int) -> int:
    empty: list[int] = []
    b = byte_buffer(empty)
    for i in range(count):
        _ = b.append_byte(i % 200)
    kept = b
    for i in range(count):
        _ = b.append_range(b"xyz", 0, 3)
    _ = kept.append_byte(7)
    return checksum(b) * 7 + checksum(kept) + len(b) * 100 + len(kept)


def numbers(count: int) -> int:
    empty: list[int] = []
    buffer = byte_buffer(empty)
    for i in range(count):
        _ = buffer.append_int(i * 7919 - 50000)
        _ = buffer.append_byte(44)
    return checksum(buffer) + len(buffer)


def list_growth(count: int) -> int:
    xs: list[int] = []
    for i in range(count):
        xs.append(i * 3)
    keep = xs
    xs.append(1)
    total = 0
    for x in keep:
        total = (total + x) % 1000003
    return total + len(xs) + len(keep)


def main(args: list[str], out: Stream) -> int:
    scale = 1 + len(args) * 9
    out.print(piece_appends(3000 * scale), byte_appends(70000 * scale))
    out.print(shared_append(5000 * scale), numbers(20000 * scale), list_growth(100000 * scale))
    empty: list[int] = []
    small = byte_buffer(empty)
    out.print(len(small))
    _ = small.append_byte(1)
    out.print(len(small), small[0])
    return 0
