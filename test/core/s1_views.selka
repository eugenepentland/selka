# Slices used as dictionary keys borrow their source (NEW-CORE-S1-VIEW-1..4). Every
# answer here is the base compiler's (`main` cafe7fea7, debug) and CPython's.
import dicts
import strings

func summary(d: dict[str, int]) -> str:
    mut keys = sorted(list(dicts.keys(d)))
    mut parts: str[] = []
    for key in keys:
        append(mut parts, key + "=" + str(d[key]))
    return strings.join(parts, ",")


# The knucleotide shape: a fused get-then-set count of every k-letter slice.
func counts(seq: str, k: int) -> dict[str, int]:
    mut d: dict[str, int] = {}
    for i in range(strings.char_count(seq) - k + 1):
        mut key = copy(strings.char_slice(seq, i, i + k))
        d[own key] = dicts.get(d, key, 0) + 1
    return d


# A key inserted, then its source rebound and changed while the slice is still live.
func rebound(seq: str) -> str:
    mut d: dict[str, int] = {}
    mut s = seq + "!"
    for i in range(strings.char_count(seq) - 1):
        mut key = copy(strings.char_slice(s, i, i + 2))
        s = s + str(i % 10)
        d[own key] = dicts.get(d, key, 0) + strings.char_count(s)
    return summary(d) + "|" + s


# The source is an element of a list that is replaced while the slice is live.
func element_source(mut words: str[]) -> str:
    mut d: dict[str, int] = {}
    for i in range(len(words)):
        mut key = copy(strings.char_slice(words[i], 0, 3))
        words[i] = "zz" + str(i)
        d[own key] = dicts.get(d, key, 0) + 1
    return summary(d) + "|" + strings.join(words, ",")


# One slice is the key of two dictionaries.
func two_dicts(seq: str) -> str:
    mut a: dict[str, int] = {}
    mut b: dict[str, int] = {}
    for i in range(strings.char_count(seq) - 1):
        mut key = copy(strings.char_slice(seq, i, i + 2))
        a[copy(key)] = dicts.get(a, key, 0) + 1
        if key not in b:
            b[own key] = len(b)
    return summary(a) + "|" + summary(b)


# Unicode: slices index scalars, never octets.
func scalars(seq: str) -> str:
    mut d: dict[str, int] = {}
    for i in range(strings.char_count(seq)):
        for w in range(4):
            mut key = copy(strings.char_slice(seq, i, i + w))
            d[own key] = dicts.get(d, key, 0) + 1
    return summary(d)


# Clamped, negative, reversed, empty and past-the-end bounds.
func bounds(seq: str) -> str:
    mut d: dict[str, int] = {}
    mut n = strings.char_count(seq)
    for lo in range(-n - 3, n + 4):
        for hi in [-n - 5, -2, -1, 0, 1, n - 1, n, n + 7]:
            mut key = copy(strings.char_slice(seq, former_bound(n, lo), former_bound(n, hi)))
            d[own key] = dicts.get(d, key, 0) + 1
    return summary(d)


# Probes of keys inserted from other sources: literals and other strings' slices.
func foreign(seq: str, other: str) -> str:
    mut d: dict[str, int] = {"ab": 1, "": 2, "abcdefgh": 3, "abcdefghijklmno": 4, "abcdefghijklmnop": 5, "abcdefghijklmnopq": 6}
    mut found: str[] = []
    for lo in range(strings.char_count(other)):
        for hi in range(lo, strings.char_count(other) + 1):
            mut key = copy(strings.char_slice(other, lo, hi))
            if key in d:
                append(mut found, str(lo) + ":" + str(hi) + "=" + str(d[key]))
            mut v = dicts.get(d, strings.char_slice(seq, lo, hi), -1)
            if v >= 0:
                append(mut found, "s" + str(lo) + ":" + str(hi) + "=" + str(v))
    return strings.join(found, ",")


# Near misses at every length up to 20: equal lengths, one octet different at the start,
# the middle or the end, so a short-key compare must look at every octet.
func near_misses(base: str) -> str:
    mut d: dict[str, int] = {}
    for n in range(21):
        d[copy(strings.char_slice(base, 0, n))] = n
    mut hits = 0
    mut misses = 0
    for n in range(21):
        for at in range(n):
            mut changed = strings.char_slice(base, 0, at) + "#" + strings.char_slice(base, at + 1, n)
            if dicts.get(d, strings.char_slice(changed, 0, n), -1) >= 0:
                hits += 1
            else:
                misses += 1
        if dicts.get(d, strings.char_slice(base, 0, n), -1) == n:
            hits += 1
    return str(hits) + " " + str(misses)


# Deletions leave dead entries, in a small table and in an indexed one.
func deletions(seq: str, size: int) -> str:
    mut d: dict[str, int] = {}
    for i in range(size):
        d[copy(strings.char_slice(seq, i, i + 3))] = i
    for i in range(0, size, 3):
        mut key = copy(strings.char_slice(seq, i, i + 3))
        if key in d:
            _ = dicts.pop(mut d, key)
    mut total = 0
    for i in range(size + 3):
        total = total * 3 + dicts.get(d, strings.char_slice(seq, i, i + 3), -1)
        total = total % 1000003
    d[copy(strings.char_slice(seq, 1, 4))] = 99
    return str(total) + " " + str(len(d)) + " " + str(dicts.get(d, strings.char_slice(seq, 1, 4), -1))


func add_one(mut d: dict[str, int], key: str) -> Unit:
    d[copy(key)] = dicts.get(d, key, 0) + 1


# A slice probed, then the dictionary changed by a call, then the slice inserted.
func across_call(seq: str) -> str:
    mut d: dict[str, int] = {}
    for i in range(strings.char_count(seq) - 1):
        mut key = copy(strings.char_slice(seq, i, i + 2))
        mut before = dicts.get(d, key, 0)
        add_one(mut d, strings.char_slice(seq, i + 1, i + 3))
        d[own key] = before + 10
    return summary(d)


# The slice escapes into a call, so it stays a string.
func measured(key: str) -> int:
    return strings.char_count(key) * 2


func escaping(seq: str) -> str:
    mut d: dict[str, int] = {}
    for i in range(strings.char_count(seq) - 1):
        mut key = copy(strings.char_slice(seq, i, i + 2))
        d[own key] = dicts.get(d, key, 0) + measured(key)
    return summary(d)


# `break`, `continue` and an early return between the probe and the insert.
func control(seq: str, stop: int) -> str:
    mut d: dict[str, int] = {}
    for i in range(strings.char_count(seq) - 1):
        mut key = copy(strings.char_slice(seq, i, i + 2))
        if key in d:
            if d[key] > 3:
                break
            d[own key] = d[key] + 1
            continue
        if i == stop:
            return "stopped " + summary(d)
        d[own key] = 1
    return summary(d)


# A shared dictionary is copied before the insert; the original must not change (value
# semantics: CPython's oracle reads `e = d` as `e = dict(d)`).
func shared(seq: str) -> str:
    mut d: dict[str, int] = {"zz": 0}
    mut e = copy(d)
    for i in range(strings.char_count(seq) - 2):
        mut key = copy(strings.char_slice(seq, i, i + 3))
        e[own key] = dicts.get(e, key, 0) + 1
    return summary(d) + "|" + summary(e)


# Many distinct keys: the table grows (and its index is rebuilt) between probes and inserts.
func growth(n: int) -> str:
    mut parts: str[] = []
    for i in range(n):
        append(mut parts, str(i * 7919 % 10007))
    mut seq = strings.join(parts, "")
    mut d: dict[str, int] = {}
    for i in range(strings.char_count(seq) - 4):
        mut key = copy(strings.char_slice(seq, i, i + 5))
        d[own key] = dicts.get(d, key, 0) + 1
    mut total = 0
    for stored in dicts.keys(d):
        total = (total * 31 + d[stored] * strings.char_count(stored)) % 1000003
    return str(len(d)) + " " + str(total) + " " + str(dicts.get(d, strings.char_slice(seq, 0, 5), 0))


# Lookups only: `in`, `get` and indexing with a slice, no insert.
func lookups(seq: str, d: dict[str, int]) -> int:
    mut total = 0
    for i in range(strings.char_count(seq) - 1):
        if strings.char_slice(seq, i, i + 2) in d:
            total += d[strings.char_slice(seq, i, i + 2)]
        total += dicts.get(d, strings.char_slice(seq, i, i + 1), 100)
    return total


func main(out: Stream) -> int:
    mut dna = "GGTATTTTAATTTATAGTACGTACGTGGTATTTTAATT"
    print(out, summary(counts(dna, 1)), summary(counts(dna, 2)))
    print(out, len(counts(dna, 12)), len(counts(dna, 17)), len(counts(dna, 40)), len(counts("", 3)))
    print(out, rebound("abcabcab"))
    mut words = ["alpha", "beta", "alps", "be", ""]
    print(out, element_source(mut words), words[0])
    print(out, two_dicts("abracadabra"))
    print(out, scalars("héé€😀a"))
    print(out, bounds("abcdé"))
    print(out, foreign("abcdefghijklmnopqrs", "xabcdefghijklmnopq"))
    print(out, near_misses("0123456789abcdefghijklmn"))
    print(out, deletions("abcdefghijklmnopqrstuvwxyz0123456789", 6), deletions("abcdefghijklmnopqrstuvwxyz0123456789", 30))
    print(out, across_call("abcabd"))
    print(out, escaping("abcab"))
    print(out, control("abababab", 100), control("abcabcabc", 3), control("abcdefabc", 100))
    print(out, shared("abcabcab"))
    print(out, growth(300))
    print(out, lookups("abcab", {"ab": 1, "b": 20, "bc": 300}))
    return 0


# Preserve the original clamped endpoint matrix with nonnegative source bounds.
func former_bound(length: int, bound: int) -> int:
    if bound < 0:
        return max(length + bound, 0)
    return bound
