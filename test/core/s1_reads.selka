# Slices that are only read borrow their source (NEW-CORE-S1-VIEW-4): equality, length,
# prefixes, suffixes and containment over ASCII and non-ASCII text, clamped, empty and
# reversed bounds, and slices of slices. CPython's answers.
import strings

func reads(s: str, t: str) -> str:
    mut out: str[] = []
    mut n = strings.char_count(s)
    for i in range(-2, n + 2):
        for j in range(i - 1, n + 3):
            mut row = 0
            if strings.char_slice(s, i, j) == t:
                row += 1
            if strings.char_slice(s, i, j) != "é":
                row += 2
            if t == strings.char_slice(s, i, j):
                row += 4
            if strings.starts_with(strings.char_slice(s, i, j), "a"):
                row += 8
            if strings.ends_with(strings.char_slice(s, i, j), "é"):
                row += 16
            if "bé" in strings.char_slice(s, i, j):
                row += 32
            if strings.char_slice(s, i, j) == strings.char_slice(s, j, i + 3):
                row += 64
            append(mut out, str(strings.char_count(strings.char_slice(s, i, j))) + ":" + str(row))
    return strings.join(out, ",")


# A view read after its source is rebound in the same iteration.
func rebound(s: str) -> int:
    mut total = 0
    mut t = copy(s)
    for i in range(strings.char_count(s)):
        mut head = copy(strings.char_slice(t, 0, i))
        t = t + "x"
        if strings.starts_with(head, "ab"):
            total += strings.char_count(head)
        if head == strings.char_slice(s, 0, i):
            total += 100
    return total


# The source is handed to a list while the view is live, and the list's copy is then
# extended: the view still reads the original octets.
func stored(s: str) -> str:
    mut xs: str[] = []
    mut t = s + "!"
    mut head = copy(strings.char_slice(t, 0, 3))
    append(mut xs, own t)
    xs[0] += "?"
    mut out = ""
    if head == "abc":
        out = "same"
    if strings.starts_with(head, "ab"):
        out += "+"
    return out + xs[0] + str(strings.char_count(head))


# A slice that is also printed stays a copy; one that is only compared is a view.
func mixed(s: str, out: Stream) -> int:
    mut hits = 0
    for i in range(strings.char_count(s) - 1):
        mut pair = copy(strings.char_slice(s, i, i + 2))
        if pair == "ab":
            hits += 1
        if strings.char_slice(s, i, i + 2) == "ba":
            print(out, pair)
    return hits


func main(out: Stream) -> int:
    print(out, reads("abébé", "bé"))
    print(out, reads("abcab", "ab"))
    print(out, reads("", ""))
    print(out, rebound("abcabd"), rebound("éaé"))
    print(out, mixed("abbaab", out))
    print(out, stored("abcdef"), stored("xé"))
    return 0
