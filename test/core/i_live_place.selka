func change(mut items: int[]) -> Unit:
    items[1] = 9


record Box:
    items: int[]


public func test_shared_element_write() -> bool:
    mut items = [1, 2]
    mut saved = items
    mut total = 0
    for value in items:
        total += value
        items[1] = 9
    return total == 10 and saved == [1, 2]


public func test_append_continue_growth() -> bool:
    mut items = [1]
    mut saved = items
    mut total = 0
    for value in items:
        total += value
        if value < 4:
            items.append(value + 1)
            continue
    return total == 10 and saved == [1]


public func test_mut_callee_write() -> bool:
    mut items = [1, 2]
    mut saved = items
    mut total = 0
    for value in items:
        total += value
        change(mut items)
    return total == 10 and saved == [1, 2]


public func test_record_field_write() -> bool:
    mut box = Box(items=[1, 2])
    mut saved = box
    mut total = 0
    for value in box.items:
        total += value
        box.items[1] = 9
    return total == 10 and saved.items == [1, 2]


public func test_root_rebind_snapshot() -> bool:
    mut items = [1, 2]
    mut total = 0
    for value in items:
        items[1] = 9
        items = [7, 8]
        total += value
    return total == 3 and items == [7, 8]


func main() -> int:
    assert test_shared_element_write()
    assert test_append_continue_growth()
    assert test_mut_callee_write()
    assert test_record_field_write()
    assert test_root_rebind_snapshot()
    return 0
