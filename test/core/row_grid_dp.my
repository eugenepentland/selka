extern func runtime_bench_now(host: Host) -> i64 effects(host)


# Row `grid_dp` (CONTRACT.md): a minimum-cost path DP over two nested dynamic grids.
# Arguments `size iterations seed`; output `checksum elapsed`. Both grids are `list[list[int]]`,
# built row by row and released inside every batch.
# The largest w with w * w <= n, the same integer loop in every language.
func isqrt(n: int) -> int:
    mut w = 0
    while (w + 1) * (w + 1) <= n:
        w += 1
    return w


func batch_result(w: int, h: int, batch: int, seed: int) -> int:
    mut cost = [for i in range(h) yield [for j in range(w) yield (seed + batch + 13 * (i * w + j)) % 1009]]
    mut dp = [for i in range(h) yield [for j in range(w) yield 0]]
    dp[0][0] = cost[0][0]
    for j in range(1, w):
        dp[0][j] = dp[0][j - 1] + cost[0][j]
    for i in range(1, h):
        dp[i][0] = dp[i - 1][0] + cost[i][0]
        for j in range(1, w):
            dp[i][j] = cost[i][j] + min(dp[i - 1][j], dp[i][j - 1])
    return dp[h - 1][w - 1] + sum(dp[h - 1])


func parse_number(text: str) -> int:
    match parse_int(text):
        case Some(n):
            return n
        case None:
            return 0


func main(args: str[], host: Host, out: Stream) -> int:
    if len(args) != 3:
        return 2
    mut size = parse_number(args[0])
    mut iterations = parse_number(args[1])
    mut seed = parse_number(args[2])
    if size < 2 or iterations < 1 or seed < 1 or seed > 1000000:
        return 2
    mut w = isqrt(size)
    mut h = size // w
    mut checksum = 0
    mut start = runtime_bench_now(host)
    for batch in range(iterations):
        mut part = batch_result(w, h, batch, seed)
        if part < 0:
            return 2
        checksum = (checksum + part) % 1000000007
    mut elapsed = runtime_bench_now(host) - start
    out.print(checksum, elapsed)
    return 0
