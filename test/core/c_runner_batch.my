module c_runner_batch

# Batched tests (NEW-CORE-TEST-BATCH-1) share a process, yet each trial starts
# fresh: output, the memory ceiling and the wall-clock limit are its own, whatever
# ran before it. Run with --max-steps 0, a small --max-memory and --timeout-ms.
public def test_a_prints_then_fails(out: Stream) -> bool:
    out.print("noisy")
    return False

public def test_b_fails_quietly() -> bool:
    return False

public def test_c_exhausts_memory() -> bool:
    values: list[int] = []
    while True:
        values.append(len(values))
    return True

public def test_d_allocates_after() -> bool:
    values: list[int] = []
    for i in range(100000):
        values.append(i)
    return len(values) == 100000

public def test_e_hangs() -> bool:
    while True:
        pass
    return True

public def test_f_passes_after_a_hang() -> bool:
    return True
