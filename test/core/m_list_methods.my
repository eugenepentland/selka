record Holder:
    items: int[]


func clear_needle(mut values: int[]) -> int:
    values.clear()
    return 3


func mark(mut log: int[], value: int) -> int:
    log.append(value)
    return value


# spec: NEW-CORE-LIST-S3-2
public func test_bounds_first_occurrence_and_scalar_snapshots() -> bool:
    mut values = [3, 1, 2, 1]
    mut before = values.copy()
    if values.index(1) != 1:
        return False
    values.insert(-99, 8)
    values.insert(99, 9)
    values.insert(-1, 7)
    if values != [8, 3, 1, 2, 1, 7, 9]:
        return False
    values.remove(1)
    mut last = values.pop(-1)
    mut first = values.pop(0)
    return before == [3, 1, 2, 1] and values == [3, 2, 1, 7] and last == 9 and first == 8


# spec-case: NEW-CORE-LIST-S3-2
public func test_managed_removed_values_and_none_placeholders_survive_clear() -> bool:
    mut values = [[1], [2], [1]]
    mut before = values.copy()
    mut removed = values.pop(-2)
    values.insert(0, removed.copy())
    values.remove([1])
    values[0].append(9)
    values.clear()
    mut units: Unit[] = [(), ()]
    units.insert(-1, ())
    units.remove(())
    mut popped = units.pop(0)
    return before == [[1], [2], [1]] and removed == [2] and len(values) == 0 and len(units) == 1 and units.index(()) == 0 and f"{popped}" == "None"


# spec-case: NEW-CORE-LIST-S3-2
public func test_readonly_index_captures_receiver_before_needle_mutation() -> bool:
    mut values = [1, 2, 3]
    const captured_values = values.copy()
    const needle = clear_needle(mut values)
    mut index = captured_values.index(needle)
    mut holder = Holder(items=[1, 2, 3])
    const captured_items = holder.items.copy()
    const nested_needle = clear_needle(mut holder.items)
    mut nested = captured_items.index(nested_needle)
    return index == 2 and nested == 2 and len(values) == 0 and len(holder.items) == 0


# spec-case: NEW-CORE-LIST-S3-2
public func test_stepped_slice_clamps_endpoints_preserves_elements_and_evaluates_once() -> bool:
    mut values = [1, 2, 3, 4, 5, 6]
    if values[0:6:2] != [1, 3, 5] or values[::-1] != [6, 5, 4, 3, 2, 1]:
        return False
    if values[99:0:-1] != [6, 5, 4, 3, 2] or values[-99:99:3] != [1, 4]:
        return False
    if values[-1:0:-2] != [6, 4, 2] or values[0:6:99] != [1] or len(values[2:2:-1]) != 0:
        return False
    if values[::1000000000000000000] != [1] or values[::-1000000000000000000] != [6]:
        return False
    mut log: int[] = []
    mut selected = values[mark(mut log, 0):mark(mut log, 6):mark(mut log, 2)]
    mut children = [[1], [2], [3]]
    mut reversed = children[::-2]
    reversed[0].append(9)
    children.clear()
    return selected == [1, 3, 5] and log == [0, 6, 2] and reversed == [[3, 9], [1]]


# spec-case: NEW-CORE-LIST-S3-2
public func test_missing_index_traps() -> bool:
    mut values = [1, 2]
    return values.index(3) == 0


# spec-case: NEW-CORE-LIST-S3-2
public func test_missing_remove_traps() -> bool:
    mut values = [[1]]
    values.remove([2])
    return True


# spec-case: NEW-CORE-LIST-S3-2
public func test_indexed_pop_reports_original_negative_index() -> bool:
    mut values = [1, 2]
    return values.pop(-99) == 0


# spec-case: NEW-CORE-LIST-S3-2
public func test_zero_step_traps() -> bool:
    mut values = [1, 2]
    mut selected = values[::0]
    return len(selected) == 0
