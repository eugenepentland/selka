func replace_list(mut items: int[], other: int[]) -> int[]:
    items.append(5)
    items = other.copy()
    items.append(7)
    items[0] = 9
    return items.copy()


func replace_rows(mut items: int[][], other: int[][]) -> int[][]:
    items = other.copy()
    for index in range(6):
        items[index % 2][0] = index
    return items.copy()


func rebound_twice(mut items: int[], first: int[], second: int[]) -> int:
    items.append(1)
    items = first.copy()
    items.append(2)
    items = second.copy()
    items[0] = 3
    return len(items)


func early(mut items: int[], other: int[], leave: bool) -> int:
    items.append(4)
    if leave:
        items = other.copy()
        items.append(6)
        return len(items)
    items.append(8)
    return len(items)


record Box:
    items: int[]
    n: int


func reset_box(mut b: Box, other: Box) -> int:
    b.n = 5
    b.items.append(1)
    b = other.copy()
    b.n = b.n + 100
    b.items.append(2)
    return len(b.items)


func digest(xs: int[]) -> int:
    mut h = len(xs)
    for x in xs:
        h = h * 31 + x
    return h


func digest_rows(rows: int[][]) -> int:
    mut h = len(rows)
    for row in rows:
        h = h * 131 + digest(row)
    return h


func main(out: Stream) -> int:
    mut items = [1]
    mut source = [2]
    mut changed = replace_list(mut items, source)
    out.print(digest(changed), digest(source), digest(items))
    mut rows = [[1]]
    mut row = [2]
    mut shared = [row.copy(), row.copy()]
    mut moved = replace_rows(mut rows, shared)
    out.print(digest_rows(moved), digest_rows(shared), digest(row), digest_rows(rows))
    mut held = [0]
    mut first = [10, 11]
    mut second = [20]
    out.print(rebound_twice(mut held, first, second), digest(held), digest(first), digest(second))
    mut a = [1]
    mut b = [1]
    mut other = [2]
    out.print(early(mut a, other, True), early(mut b, other, False), digest(a), digest(b), digest(other))
    mut box = Box(items=[10], n=1)
    mut spare = Box(items=[20, 21], n=2)
    mut got = reset_box(mut box, spare)
    out.print(got, box.n, digest(box.items), spare.n, digest(spare.items))
    return 0
