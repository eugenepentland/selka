module rc_field_take


record Runtime:
    objects: list[int]
    count: int


# The Lox heap's shape: the slot is the length read before the append.
def allocate(rt: mut Runtime, obj: int) -> int:
    slot = len(rt.objects)
    rt.objects.append(obj)
    rt.count = rt.count + 1
    return slot


# An earlier read of the same field reaches its element before the append.
def bump_last(rt: mut Runtime, obj: int) -> int:
    last = rt.objects[len(rt.objects) - 1]
    rt.objects.append(obj + last)
    return last


# A write through an index: a negative index's branch puts the read and the write-back
# in different blocks.
def put(rt: mut Runtime, at: int, v: int):
    rt.objects[at] = v


# A copy of the field taken before the append is still read after it: it keeps the
# list as it was.
def keep(rt: mut Runtime, obj: int) -> int:
    before = rt.objects
    rt.objects.append(obj)
    return len(before)


record Marker:
    marks: list[bool]
    gray: list[int]


record Heap:
    objects: list[int]
    marker: Marker
    free_slots: list[int]
    allocations: int


# The Lox heap: one arm reuses a free slot, the other grows the list and, through a
# nested field, the marks with it.
def heap_allocate(h: mut Heap, obj: int) -> int:
    slot = len(h.objects)
    if len(h.free_slots) > 0:
        slot = h.free_slots.pop()
        h.objects[slot] = obj
    else:
        h.objects.append(obj)
        h.marker.marks.append(False)
    h.allocations = h.allocations + 1
    return slot


def heap_free(h: mut Heap, slot: int):
    h.free_slots.append(slot)


record Shelf:
    rows: list[list[int]]


# A row read before the write-back, which sits in another block, is read again after it:
# it keeps its own count, so replacing that very row in place does not free it.
def replace_row(s: mut Shelf, at: int, row: list[int]) -> int:
    old = s.rows[at]
    if at != 5:
        s.rows[at] = row
    return len(old) * 100 + old[0]


def main(args: list[str], out: Stream) -> int:
    rt = Runtime(objects=[], count=0)
    n = len(args) * 50000
    last = 0
    i = 0
    while i < n:
        last = allocate(mut rt, i)
        put(mut rt, -1, i * 2)
        i = i + 1
    previous = bump_last(mut rt, 7)
    kept = keep(mut rt, -1)
    out.print(rt.count, len(rt.objects), last, previous, rt.objects[n], kept, rt.objects[n + 1])
    h = Heap(objects=[], marker=Marker(marks=[], gray=[]), free_slots=[], allocations=0)
    total = 0
    j = 0
    while j < n:
        s = heap_allocate(mut h, j)
        if j % 3 == 0:
            heap_free(mut h, s)
        total = total + s
        j = j + 1
    out.print(len(h.objects), len(h.marker.marks), h.allocations, total, h.objects[0], h.objects[len(h.objects) - 1])
    shelf = Shelf(rows=[[1, 2, 3], [4, 5]])
    first = replace_row(mut shelf, 0, [9])
    second = replace_row(mut shelf, -1, [7, 7, 7, 7])
    out.print(first, second, len(shelf.rows[0]), len(shelf.rows[1]), shelf.rows[0][0])
    return 0
