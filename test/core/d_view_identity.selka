record Holder:
    mapping: dict[int, int]


enum Captured:
    Mapping(value: dict[int, int])


func retain_mapping(d: dict[int, int]) -> Holder:
    return Holder(mapping=d)


func fresh_mapping() -> dict[int, int]:
    return {1: 7}


public func test_record_alias_before_view() -> bool:
    mut d = {1: 7}
    mut holder = Holder(mapping=d)
    mut view = list(d.values())
    d[1] = 9
    return list(view) == [7] and holder.mapping[1] == 7 and d[1] == 9


public func test_record_alias_after_view() -> bool:
    mut d = {1: 7}
    mut view = list(d.values())
    mut holder = Holder(mapping=d)
    d[1] = 9
    return list(view) == [7] and holder.mapping[1] == 7


public func test_tuple_and_aggregate_copy_before_view() -> bool:
    mut d = {1: 7}
    mut holder = (d, 11)
    mut saved = holder
    mut view = list(d.values())
    d[1] = 9
    selected, marker = saved
    return list(view) == [7] and selected[1] == 7 and marker == 11


public func test_union_payload_before_view() -> bool:
    mut d = {1: 7}
    mut holder = Captured.Mapping(value=d)
    mut view = list(d.values())
    d[1] = 9
    match holder:
        case Captured.Mapping(value=saved):
            return list(view) == [7] and saved[1] == 7


public func test_list_alias_before_view() -> bool:
    mut d = {1: 7}
    mut holders = [d]
    mut view = list(d.values())
    d[1] = 9
    return list(view) == [7] and holders[0][1] == 7


public func test_nested_dictionary_alias_before_view() -> bool:
    mut d = {1: 7}
    mut holders = {2: d}
    mut view = list(d.values())
    d[1] = 9
    return list(view) == [7] and holders[2][1] == 7


public func test_returned_alias_before_view() -> bool:
    mut d = {1: 7}
    mut holder = retain_mapping(d)
    mut view = list(d.values())
    d[1] = 9
    return list(view) == [7] and holder.mapping[1] == 7


public func test_fixed_array_alias_before_view() -> bool:
    mut d = {1: 7}
    mut holders: FixedArray[dict[int, int], 1] = FixedArray[dict[int, int], 1]([d])
    mut view = list(d.values())
    d[1] = 9
    return list(view) == [7] and holders[0][1] == 7


public func test_returned_dictionary_snapshot_is_independent() -> bool:
    mut d = fresh_mapping()
    mut view = list(d.values())
    d[1] = 9
    return list(view) == [7]


public func test_fixed_array_stored_snapshot() -> bool:
    mut d = {1: 7}
    mut views: FixedArray[int[], 1] = FixedArray[int[], 1]([list(d.values())])
    d[1] = 9
    return list(views[0]) == [7]
