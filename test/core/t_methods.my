# spec: NEW-CORE-TEXT-S3-1
public func test_case_classify_replace_count_and_lines_preserve_snapshots() -> bool:
    mut text = "aBé🙂aB"
    mut saved = text.copy()
    return text.upper() == "ABé🙂AB" and text.lower() == "abé🙂ab" and text.count("aB") == 2 and text.count("") == 7 and text.replace("aB", "x") == "xé🙂x" and saved == text and "a\r\nb\rc\n".splitlines() == ["a", "b", "c"] and len("".splitlines()) == 0 and "19".isdigit() and "aB".isalpha() and " \t".isspace() and not "é".isalpha()


# spec-case: NEW-CORE-TEXT-S3-1
public func test_scalar_search_bounds_and_charset_trim() -> bool:
    mut text = "aé🙂aé"
    return text.find("é", 2) == 4 and text.rfind("é", 0, 4) == 1 and text.index("🙂") == 2 and text.rindex("é") == 4 and text.count("", 1, 4) == 4 and text.count("", 9) == 0 and text.startswith("é", 1) and text.endswith("🙂", 1, 3) and "\u0085\u00a0x\u2028".strip() == "x" and "éabcé".strip("é") == "abc" and "éabcé".lstrip("é") == "abcé" and "éabcé".rstrip("é") == "éabc"


# spec-case: NEW-CORE-TEXT-S3-1
public func test_repr_scalar_ord_chr_and_packed_text_format() -> bool:
    return chr(0x1f642) == "🙂" and ord("🙂") == 0x1f642 and ord(chr(0)) == 0 and repr("é🙂") == "'é🙂'" and repr("\u00a0\u2028") == "'\\xa0\\u2028'" and repr(b"\x00\xff") == "b'\\x00\\xff'" and f"{'é🙂abc':🙂^7.3}" == "🙂🙂é🙂a🙂🙂" and "-7".zfill(4) == "-007"


# spec-case: NEW-CORE-TEXT-S3-1
public func test_bytes_count_search_trim_and_find_any() -> bool:
    mut raw = b"\xffa,a\xff"
    return raw.count(b"a") == 2 and raw.rfind(b"a", 0, -1) == 3 and raw.index(b",") == 2 and raw.find_any(b",\xff", 1) == 2 and raw.find_any(b"a", -1) == 1 and raw.strip(b"\xff") == b"a,a" and raw.count(b"", 99) == 0 and raw[1:-1] == b"a,a" and b" \tx\n".strip() == b"x"


# spec-case: NEW-CORE-TEXT-S3-1
public func test_decode_and_scalar_count_validate_utf8_and_clamped_ranges() -> bool:
    mut raw = b"a\xc3\xa9\xf0\x9f\x99\x82"
    match raw.decode():
        case Ok(text):
            if text != "aé🙂":
                return False
        case Err(_):
            return False
    match raw.scalar_count():
        case Ok(count):
            if count != 3:
                return False
        case Err(_):
            return False
    match raw.scalar_count_range(1, 3):
        case Ok(count):
            if count != 1:
                return False
        case Err(_):
            return False
    match b"\xed\xa0\x80".decode():
        case Ok(_):
            return False
        case Err(message):
            return message == "invalid UTF-8 in byte string"


# spec-case: NEW-CORE-LIST-S3-1
public func test_extend_and_reverse_preserve_self_and_nested_snapshots() -> bool:
    mut values = ["a", "é"]
    mut saved = values.copy()
    values.extend(values)
    values.reverse()
    mut nested = [values.copy()]
    values.reverse()
    return saved == ["a", "é"] and nested == [["é", "a", "é", "a"]] and values == ["a", "é", "a", "é"]


# spec-case: NEW-CORE-TEXT-S3-1
public func test_missing_index_traps_at_the_call() -> bool:
    _ = "aé".index("z")
    return False


# spec-case: NEW-CORE-TEXT-S3-1
public func test_invalid_chr_traps_at_the_call() -> bool:
    _ = chr(0xd800)
    return False


# spec-case: NEW-CORE-TEXT-S3-1
public func test_verified_lengths_survive_the_large_source_last_use() -> bool:
    return large_bytes_length() == 4100 and large_string_length() == 4096 and large_list_length() == 256


func large_bytes_length() -> int:
    mut raw = b"x"
    for _ in range(12):
        raw += raw
    raw = raw + b"tail"
    return len(raw)


func large_string_length() -> int:
    mut text = "x"
    for _ in range(12):
        text += text
    return len(text)


func large_list_length() -> int:
    mut values: int[] = []
    for item in range(256):
        values.append(item)
    return len(values)
