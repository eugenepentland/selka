# Byte-string slices copy their octets without an ASCII scan; one of an ASCII block keeps
# the flag (NEW-CORE-S1-ASCII-1). Every answer here is the base compiler's (`main`
# cafe7fea7): lengths, decoding, equality, search and dictionary keys.
func decoded(raw: bytes) -> str:
    match raw.decode():
        case Ok(value):
            return value
        case Err(message):
            return "!" + message


func main(out: Stream) -> int:
    mut t = "héllo wörld".encode()
    mut a = "hello world".encode()
    mut parts = [t[0:3], t[1:3], t[1:2], t[2:2], a[1:4], a[6:11], t[7:10], t[-4:], t[0:99], a[-100:3]]
    mut keys: dict[bytes, int] = {}
    for p in parts:
        mut text = decoded(p)
        out.print(len(p), text, len(text), p == a[1:4], p.find(b"l"))
        keys[p.copy()] = keys.get(p, 0) + len(p)
    out.print(len(keys), keys[a[1:4]], keys.get(t[0:3], -1))
    mut s = decoded(a[0:5]) + decoded(t[0:3])
    out.print(s, len(s), s[5], s.find("é"), s[1:6])
    return 0
