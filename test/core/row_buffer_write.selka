extern func runtime_bench_now(host: Host) -> i64 effects(host)


# Row `buffer_write` of the S4 contract: each batch appends the decimal digits of SIZE
# values, a comma after each and a newline after every sixteenth, to a fresh
# `byte_buffer` with its own `append_int` and `append_byte`, then folds the finished
# buffer's octets and releases it.
func batch_result(size: int, batch: int, seed: int) -> int:
    mut buffer = byte_buffer([])
    for j in range(size):
        mut v = (seed + batch + 13 * j) % 100003
        _ = buffer.append_int(v)
        _ = buffer.append_byte(44)
        if j % 16 == 15:
            _ = buffer.append_byte(10)
    mut h = 0
    for c in buffer:
        h = (h * 131 + c) % 1000000007
    return (len(buffer) + h) % 1000000007


func parse_number(text: str) -> int:
    match parse_int(text):
        case Some(n):
            return n
        case None:
            return 0


func main(args: str[], host: Host, out: Stream) -> int:
    if len(args) != 3:
        return 2
    mut size = parse_number(args[0])
    mut iterations = parse_number(args[1])
    mut seed = parse_number(args[2])
    if size < 2 or iterations < 1 or seed < 1 or seed > 1000000:
        return 2
    mut checksum = 0
    mut start = runtime_bench_now(host)
    for batch in range(iterations):
        mut part = batch_result(size, batch, seed)
        if part < 0:
            return 2
        checksum = (checksum + part) % 1000000007
    mut elapsed = runtime_bench_now(host) - start
    out.print(checksum, elapsed)
    return 0
