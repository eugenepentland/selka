# Source `extern def` calls with narrow integer and bool arguments
# (NEW-CORE-S5-EXTERN-ABI-1): the C callee reads the register widened to 32 bits,
# so each argument carries its SysV sign or zero extension. Built with `--link
# v_extern_narrow.c`; the values come from runtime inputs and from constants.
extern func widen_i8(host: Host, x: i8) -> i64


extern func widen_i16(host: Host, x: i16) -> i64


extern func widen_u8(host: Host, x: u8) -> i64


extern func widen_u16(host: Host, x: u16) -> i64


extern func widen_i32(host: Host, x: i32) -> i64


extern func widen_u32(host: Host, x: u32) -> i64


extern func widen_bool(host: Host, x: bool) -> i64


extern func neg_i8(host: Host, x: i64) -> i8


extern func make_u8(host: Host, x: i64) -> u8


extern func neg_i16(host: Host, x: i64) -> i16


extern func make_u16(host: Host, x: i64) -> u16


extern func is_odd(host: Host, x: i64) -> bool


extern func many(host: Host, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i8, i: u16, x: float, y: float, z: float) -> i64


func main(host: Host, out: Stream) -> int:
    print(out, widen_i8(host, -5i8), widen_i16(host, -300i16), widen_u8(host, 250u8), widen_u16(host, 65000u16), widen_i32(host, -70000i32), widen_u32(host, 4000000000u32))
    print(out, widen_bool(host, True), widen_bool(host, False), widen_bool(host, is_odd(host, 3)))
    mut small = neg_i8(host, 5)
    mut wide = neg_i16(host, 300)
    print(out, small, make_u8(host, 300), wide, make_u16(host, 70000))
    print(out, widen_i8(host, small), widen_i16(host, wide), widen_u8(host, make_u8(host, 255)), widen_u16(host, make_u16(host, 65535)))
    print(out, many(host, 1, 2, 3, 4, 5, 6, 7, small, make_u16(host, 9), 1.0, 2.0, 3.0))
    return 0
