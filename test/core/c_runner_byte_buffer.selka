import buffers

public record Packet:
    tag: int
    body: byte_buffer


public func test_buffer_copy_appends_alone(buffer: byte_buffer) -> bool:
    mut before = len(buffer)
    mut saved = copy(buffer)
    _ = buffers.append_byte(mut saved, 7)
    return len(buffer) == before and len(saved) == before + 1 and saved[before] == 7


public func test_buffers_inside_records_lists_and_options(packet: Packet, items: byte_buffer[], frame: byte_buffer?) -> bool:
    mut total = len(packet.body)
    for item in items:
        total = total + len(item)
    match frame:
        case Some(body):
            total = total + len(body)
        case None:
            total = total + 0
    return total >= 0


public func test_short_buffer(buffer: byte_buffer) -> bool:
    return len(buffer) < 3


public func test_buffer_error_result(buffer: byte_buffer) -> bool fails byte_buffer:
    if len(buffer) > 2:
        fail copy(buffer)
    return True
