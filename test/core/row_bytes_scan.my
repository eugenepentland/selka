
# Split from benchmarks/runtime/expanded/text/main.my; identical timed work.

extern func runtime_bench_now(host: Host) -> i64 effects(host)

record Inputs:
    raw: bytes
    texts: str[]
    other: str[]
    numbers: int[]
    fragments: str[]



func number(text: str) -> int:
    match parse_int(text):
        case Some(value):
            return value
        case None:
            return 0

func repeated(text: str, count: int) -> str:
    mut result = ""
    for j in range(count):
        result += text
    return result

func bytes_job(raw: bytes, mask: int) -> int:
    mut total = 0
    for value in raw:
        total += value ^ mask
    return total

func inputs(kind: str, size: int, seed: int) -> Inputs:
    mut raw = b""
    mut texts: str[] = []
    mut other: str[] = []
    mut numbers: int[] = []
    mut fragments: str[] = []
    raw = bytes([for j in range(size) yield (seed + j * 37) % 256])
    return Inputs(raw=raw, texts=texts, other=other, numbers=numbers, fragments=fragments)

func kernel(kind: str, data: Inputs, iterations: int, seed: int) -> int:
    mut checksum = 0
    for step in range(iterations):
        mut cursor = seed + step
        mut value = bytes_job(data.raw, cursor % 256)
        checksum = (checksum + value) % 1000000007
    return checksum

func main(args: str[], host: Host, out: Stream) -> int:
    if len(args) != 3:
        return 2
    mut kind = "bytes_scan"
    mut size = number(args[0])
    mut iterations = number(args[1])
    mut seed = number(args[2])
    if size < 2 or iterations < 1 or seed < 1 or seed > 1000000:
        return 2
    mut data = inputs(kind, size, seed)
    mut checksum = 0
    mut start = runtime_bench_now(host)
    checksum = kernel(kind, data, iterations, seed)
    mut elapsed = runtime_bench_now(host) - start
    out.print(checksum, elapsed)
    return 0
