import strings

public func test_unicode_index_slice_and_loop() -> bool:
    mut text = "aé🙂z"
    mut joined = ""
    for ch in strings.chars(text):
        joined += ch
    return strings.char_count(text) == 4 and strings.char_at(text, 1) == "é" and strings.char_at(text, strings.char_count(text) - 2) == "🙂" and strings.char_slice(text, 1, 3) == "é🙂" and joined == text


public func test_empty_split_join_and_find() -> bool:
    mut parts = strings.split("|a||café|", "|")
    return len(parts) == 5 and strings.join(parts, ":") == ":a::café:" and strings.char_find("aé🙂z", "🙂") == 2 and strings.char_find("", "") == 0


public func test_encode_bytes_xor() -> bool:
    mut raw = strings.encode("café")
    mut total = 0
    for value in raw:
        total += bit_xor(value, 7)
    return len(raw) == 5 and total == 669 and raw[3] == 195 and raw[len(raw) - 1] == 169


public func test_append_keeps_shared_text() -> bool:
    mut original = "café"
    mut changed = copy(original)
    for j in range(10):
        changed += "🙂"
    return original == "café" and strings.char_count(changed) == 14


public func test_large_unicode_index_and_reverse_slice() -> bool:
    mut text = ""
    for j in range(80):
        text += "aé🙂z"
    return strings.char_count(text) == 320 and strings.char_at(text, 257) == "é" and strings.char_at(text, strings.char_count(text) - 2) == "🙂" and strings.char_stride(text, 2, 10, 3) == "🙂éa" and strings.char_stride("aé🙂z", None, None, -1) == "z🙂éa"


public func test_long_byte_xor_reduction() -> bool:
    mut text = ""
    for j in range(300):
        text += "0123"
    mut total = 0
    for octet in strings.encode(text):
        total += bit_xor(octet, 7)
    return total == 64200


public func test_doubling_and_self_character_append_preserve_snapshots() -> bool:
    mut text = "ab"
    for j in range(8):
        text += text
    mut saved = copy(text)
    text += strings.char_at(text, 0)
    mut alias = copy(text)
    text += alias
    return strings.char_count(saved) == 512 and strings.char_count(alias) == 513 and strings.char_count(text) == 1026 and strings.char_at(text, strings.char_count(text) - 1) == "a" and strings.char_at(saved, strings.char_count(saved) - 1) == "b"


public func test_append_alias_through_phi_preserves_the_other_owner() -> bool:
    mut text = "" + "ab"
    mut total = 0
    for j in range(16):
        mut other = "x"
        if j % 2 == 0:
            other = copy(text)
        mut before = strings.char_count(other)
        text += other
        total += before
        if strings.char_count(other) != before:
            return False
    return strings.char_count(text) == total + 2 and strings.char_at(text, strings.char_count(text) - 1) == "x"


public func test_empty_separator_traps() -> bool:
    _ = strings.split("a", "")
    return False


public func test_zero_slice_step_traps() -> bool:
    _ = strings.char_stride("a", None, None, 0)
    return False
