module d_basic

def main(out: Stream) -> int:
    d: dict[int, int] = {2: 7, 1: 9}
    out.print(len(d), d[2], d.get(3, 99), 2 in d)
    copy = d
    d[2] = 11
    d[3] = d.get(3, 0) + 8
    out.print(copy[2], d[2], len(d))
    for key, value in d.items():
        out.print(key, value)
    popped = d.pop(1)
    d[1] = 42
    out.print(popped, d.get(1, 0))
    for key in d:
        out.print(key)
    other: dict[int, int] = {1: 42, 3: 8, 2: 11}
    out.print(d == other)
    return 0
