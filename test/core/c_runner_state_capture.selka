import random
import time

# Deliberately fail so the old/new reports preserve two independent trials'
# state. Clock, filesystem and entropy mutations must not reach the next trial.
public func test_failed_trials_start_from_identical_state(value: int, out: Stream, clock: Clock, entropy: Entropy, fs: Filesystem, env: Environment) -> bool:
    match time.now(clock):
        case Ok(start):
            print(out, "clock", start.unix_nanoseconds)
        case Err(message):
            print(out, message)
    print(out, "file", fs.exists("trial.txt"), "environment", len(env.names()))
    match random.from_entropy(entropy):
        case Ok(sampled):
            mut generator = own sampled
            print(out, "entropy", random.next_word(mut generator), random.next_word(mut generator))
        case Err(message):
            print(out, message)
    _ = fs.write_text("trial.txt", "written")
    _ = time.advance(clock, time.nanoseconds(1))
    print(out, "input", value)
    return False
