# The D-FFI additions end to end against c_interop.c: lent spans, a copied bytes result, out-parameters into a local,
# a record field and a list element, and opaque handles (null, ==, copy, take, defaults, a handle out-parameter).
extern type Thing


extern func ffi_span_sum(host: Host, data: bytes, scale: i64) -> i64


extern func ffi_span_two(host: Host, a: str, b: str) -> i64


extern func ffi_give(host: Host, mode: i64) -> bytes


extern func ffi_give_heap(host: Host, n: i64) -> bytes


extern func ffi_split(host: Host, value: i64, mut high: i64, mut low: i32, mut ok: bool) -> i32


extern func ffi_bump(host: Host, mut x: i64) -> Unit


extern func ffi_thing_new(host: Host, value: i64) -> Thing


extern func ffi_thing_value(host: Host, thing: Thing) -> i64


extern func ffi_thing_free(host: Host, thing: Thing) -> Unit


extern func ffi_live_things(host: Host) -> i64


extern func ffi_thing_open(host: Host, name: str, mut out: Thing) -> i32


record Pair:
    a: i64
    b: i32


record Holder:
    thing: Thing = Thing()
    count: int = 0


func owned_text(n: int) -> str:
    mut text = ""
    for _ in range(n):
        text = text + "é"
    return text


func spans(host: Host, out: Stream):
    const raw = b"\x00\x01\xff"
    print(out, ffi_span_sum(host, raw, 1), ffi_span_sum(host, raw[1:3], 2), ffi_span_sum(host, b"", 5))
    const big = owned_text(1000)
    print(out, ffi_span_two(host, big, big[0:2]), ffi_span_two(host, "abc"[1:], ""))


func results(host: Host, out: Stream):
    print(out, ffi_give(host, 0) == b"hi\x00\xffz", len(ffi_give(host, 1)), len(ffi_give(host, 2)))
    mut total = 0
    for i in range(1000):
        total += len(ffi_give_heap(host, i % 7))
    print(out, total)


func outs(host: Host, out: Stream):
    mut high = 0
    mut low = i32(0)
    mut ok = False
    const rc = ffi_split(host, 81604378629, mut high, mut low, mut ok)
    print(out, rc, high, low, ok)
    mut pair = Pair(a=0, b=i32(0))
    _ = ffi_split(host, 4294967298, mut pair.a, mut pair.b, mut ok)
    print(out, pair.a, pair.b)
    mut xs: i64[] = [10, 20]
    ffi_bump(host, mut xs[1])
    ffi_bump(host, mut xs[1])
    print(out, xs[0], xs[1])


func handles(host: Host, out: Stream):
    const thing = ffi_thing_new(host, 41)
    print(out, ffi_thing_value(host, thing), ffi_thing_value(host, Thing()), thing == Thing(), thing != Thing())
    mut holder = Holder(thing=thing, count=1)
    const twin = copy(holder)
    print(out, ffi_thing_value(host, twin.thing), twin.thing == holder.thing)
    const taken = take(mut holder)
    print(out, ffi_thing_value(host, holder.thing), holder.count, ffi_thing_value(host, Holder().thing))
    mut opened = Thing()
    const status = ffi_thing_open(host, "A", mut opened)
    mut failed = Thing()
    const refused = ffi_thing_open(host, "", mut failed)
    print(out, status, ffi_thing_value(host, opened), refused, failed == Thing())
    mut seen: dict[Thing, int] = {}
    seen[thing] = 1
    seen[opened] = 2
    seen[thing] = 3
    print(out, len(seen), seen[thing])
    ffi_thing_free(host, taken.thing)
    ffi_thing_free(host, opened)
    print(out, ffi_live_things(host))


func main(host: Host, out: Stream) -> int:
    spans(host, out)
    results(host, out)
    outs(host, out)
    handles(host, out)
    return 0
