# CE2-B fixture (docs/audits/values-keys-trap-search-plan-2026-10-07.md §4.5 "CE2"): results built
# in the caller's `sret` destination, arguments read where they lie, `sret` shared with a by-value
# argument, pushes and element-field containers updated in place. Every function prints what value
# semantics says; the shapes are the adversarial ones each transformation must refuse or survive.
record Span:
    line: int
    col: int
    offset: int


record Token:
    tag: int
    text: str
    span: Span


record Cursor:
    pos: int
    line: int
    col: int
    error_span: Span


record Tokenizer:
    source: bytes
    cur: Cursor


enum LexError:
    bad
    eof


record Diag:
    count: int
    last: str


record Big:
    a: int
    b: int
    c: int
    d: int
    e: int


record Pair:
    x: Big
    y: Big


# ---- step 1: declared results built in %ret ----
func make_token(src: bytes, t: Cursor, tag: int) -> Token:
    return Token(tag=tag, text=str(len(src) * 10 + t.pos), span=Span(line=t.line, col=t.col, offset=t.pos))


func advance(src: bytes, mut t: Cursor):
    if t.pos < len(src):
        if src[t.pos] == 10:
            t.line += 1
            t.col = 1
        else:
            t.col += 1
        t.pos += 1


# `return Ok(make_token(...))` next to a `mut` cursor, with early returns of other shapes.
func next_in(src: bytes, mut t: Cursor) -> Result[Token, LexError]:
    if t.pos >= len(src):
        return Ok(Token(tag=0, text="", span=Span(line=t.line, col=t.col, offset=t.pos)))
    mut c = src[t.pos]
    if c == 33:
        t.error_span = Span(line=t.line, col=t.col, offset=t.pos)
        advance(src, mut t)
        return Err(LexError.bad)
    mut start = t
    advance(src, mut t)
    if c == 35:
        # The token is built from the cursor before the advance: a snapshot still read.
        return Ok(make_token(src, start, 2))
    return Ok(make_token(src, t, 1))


# `r = next_in(...)`, then the cursor written back and `r` returned: `r` is a view of the call's
# result, so that result is built where `r` is returned.
func next(mut t: Tokenizer) -> Result[Token, LexError]:
    mut src = t.source.copy()
    mut cur = t.cur
    mut r = next_in(src, mut cur)
    t.cur = cur
    return r


# The payload of a callee's result returned again under another error type (`?`-style).
func next_token(mut tok: Tokenizer, mut errors: Diag) -> Result[Token, str]:
    match next(mut tok):
        case Ok(token):
            return Ok(token)
        case Err(err):
            errors.count += 1
            if err == LexError.bad:
                return Err("bad")
            return Err("eof")


# `?` propagates the callee's error; the payload it unwraps is returned again in %ret.
func next_checked(mut tok: Tokenizer, mut count: Diag) -> Result[Token, LexError]:
    mut first = try next(mut tok)
    count.count += 1
    if first.tag == 2:
        mut second = try next(mut tok)
        count.count += 1
        return Ok(second)
    return Ok(first)


func checked(text: bytes) -> str:
    mut tok = Tokenizer(source=text.copy(), cur=Cursor(pos=0, line=1, col=1, error_span=Span(line=0, col=0, offset=0)))
    mut count = Diag(count=0, last="")
    mut out = ""
    for _ in range(len(text)):
        match next_checked(mut tok, mut count):
            case Ok(token):
                out = out + token.text + "@" + str(token.span.offset) + " "
            case Err(_):
                out = out + "! "
    return out + str(count.count)


func tokens(text: bytes) -> str:
    mut tok = Tokenizer(source=text.copy(), cur=Cursor(pos=0, line=1, col=1, error_span=Span(line=0, col=0, offset=0)))
    mut errors = Diag(count=0, last="")
    mut out = ""
    for _ in range(len(text) + 2):
        match next_token(mut tok, mut errors):
            case Ok(token):
                out = out + str(token.tag) + ":" + token.text + "@" + str(token.span.line) + "." + str(token.span.col) + " "
            case Err(e):
                out = out + e + " "
    return out + str(errors.count) + " " + str(tok.cur.error_span.offset)


func make_pair(k: int) -> Pair:
    return Pair(x=Big(a=k, b=k + 1, c=k + 2, d=k + 3, e=k + 4), y=Big(a=10 * k, b=0, c=0, d=0, e=10 * k + 4))


# A value returned whole on one path and read field-swapped on another: the swap must not
# overwrite a half it still reads.
func pick(k: int, flag: bool) -> Pair:
    mut w = make_pair(k)
    if flag:
        return w
    return Pair(x=w.y, y=w.x)


# The same swap next to a `mut` record: `w` may live inside `%ret` where its halves land.
func swap_mut(k: int, mut t: Cursor) -> Pair:
    t.pos += k
    mut w = make_pair(k)
    return Pair(x=w.y, y=w.x)


# The same half stored twice, and a half moved into the other's place.
func twice(k: int, mut t: Cursor) -> Pair:
    t.col += 1
    mut w = make_pair(k)
    if k % 2 == 0:
        return Pair(x=w.y, y=w.y)
    return Pair(x=w.x, y=w.x)


# A value built in %ret and then overwritten by another built while it is still read.
func rebuild(k: int, mut t: Cursor) -> Result[Big, LexError]:
    mut first = make_pair(k)
    mut second = make_pair(first.y.a)
    t.line += 1
    if k > 5:
        return Ok(first.x)
    return Ok(Big(a=second.x.a, b=first.x.b, c=second.y.a, d=first.y.e, e=k))


# A result carried around a loop with an early return of a trap-checked value.
func walk(n: int, mut t: Cursor) -> Result[Big, LexError]:
    mut acc = Big(a=0, b=0, c=0, d=0, e=0)
    for i in range(n):
        t.pos += 1
        if i == 7:
            return Err(LexError.eof)
        acc.a += i
        acc.e = acc.e * 2 + 1
    return Ok(acc)


func pairs() -> str:
    mut t = Cursor(pos=0, line=0, col=0, error_span=Span(line=0, col=0, offset=0))
    mut p = pick(1, False)
    mut q = pick(2, True)
    mut s = swap_mut(3, mut t)
    mut w1 = twice(4, mut t)
    mut w2 = twice(5, mut t)
    mut out = str(p.x.a) + " " + str(p.y.a) + " " + str(p.x.e) + " " + str(p.y.e) + " " + str(q.x.a) + " " + str(q.y.a)
    out = out + " | " + str(s.x.a) + " " + str(s.y.a) + " " + str(s.x.e) + " " + str(s.y.e) + " " + str(t.pos)
    out = out + " | " + str(w1.x.a) + " " + str(w1.y.e) + " " + str(w2.x.a) + " " + str(w2.y.e) + " " + str(t.col)
    for k in [1, 7]:
        match rebuild(k, mut t):
            case Ok(b):
                out = out + " | " + str(b.a) + " " + str(b.b) + " " + str(b.c) + " " + str(b.d) + " " + str(b.e)
            case Err(_):
                out = out + " | err"
    for n in [5, 9]:
        match walk(n, mut t):
            case Ok(b):
                out = out + " | " + str(b.a) + " " + str(b.e)
            case Err(_):
                out = out + " | early"
    return out + " | " + str(t.line) + " " + str(t.pos)


# ---- step 2: list elements lent to calls where they lie ----
record Holder:
    items: Big[]
    n: int


enum Obj:
    free
    big(value: Big)
    name(value: str)


func weight(x: Big) -> int:
    return x.a + 2 * x.e


# A callee that writes its by-value parameter works on its own copy.
func bump(input: Big) -> int:
    mut x = input
    x.a += 100
    return x.a + x.e


func is_free(o: Obj) -> bool:
    match o:
        case Obj.free:
            return True
        case _:
            return False


func cost(o: Obj) -> int:
    match o:
        case Obj.big(value=b):
            return b.a + b.b
        case Obj.name(value=s):
            return len(s)
        case _:
            return 0


# A `mut` argument of the same call that reaches the element's list: the element must be a copy.
func grow(mut h: Holder, x: Big) -> int:
    h.items.append(Big(a=x.a + 1, b=0, c=0, d=0, e=0))
    h.items[0] = Big(a=-1, b=-1, c=-1, d=-1, e=-1)
    return x.a + len(h.items) + h.items[0].a


func sweep(objs: Obj[]) -> int:
    mut total = 0
    for i in range(len(objs)):
        if not is_free(objs[i]):
            total += cost(objs[i])
    return total


func lent() -> str:
    mut xs = [for i in range(5) yield Big(a=i, b=i, c=i, d=i, e=i * 3)]
    mut total = 0
    for i in range(len(xs)):
        total += weight(xs[i]) + bump(xs[i])
    mut h = Holder(items=xs.copy(), n=0)
    const first_item = h.items[0]
    mut r = grow(mut h, first_item)
    # The element read, then its slot overwritten, then the read value passed: the old value.
    mut y = xs[1]
    xs[1] = Big(a=50, b=0, c=0, d=0, e=0)
    total += weight(y)
    mut objs = [Obj.free, Obj.big(value=Big(a=1, b=2, c=3, d=4, e=5)), Obj.name(value="hello"), Obj.free]
    mut shared = objs.copy()
    objs[1] = Obj.name(value="xy")
    return str(total) + " " + str(r) + " " + str(h.items[0].a) + " " + str(len(h.items)) + " " + str(xs[0].a) + " " + str(xs[1].a) + " " + str(sweep(objs)) + " " + str(sweep(shared))


# ---- step 3: `sret` shared with a by-value argument that dies at the call ----
record State:
    f0: int
    f1: int
    f2: int
    f3: int
    f4: int
    f5: int


func rotate(s: State, x: int) -> State:
    mut t = (s.f0 * 31 + x) % 1009
    return State(f0=s.f1, f1=s.f2, f2=s.f3, f3=s.f4, f4=s.f5, f5=t)


# Reads a half of `s` after storing the other: may not share (the halves would be overwritten).
func swap_halves(p: Pair, k: int) -> Pair:
    return Pair(x=p.y, y=Big(a=p.x.a + k, b=p.x.b, c=p.x.c, d=p.x.d, e=p.x.e))


# Reads `p.x` after storing over it: may not share.
func flip(p: Pair) -> Pair:
    return Pair(x=p.y, y=p.x)


# Stores a half of `p` onto itself, then the other half from elsewhere: may share.
func keep_x(p: Pair, k: int) -> Pair:
    return Pair(x=p.x, y=Big(a=k, b=p.x.a, c=p.y.a, d=0, e=0))


# A record updated in place and returned: lives in `%ret` before the return, so may not share.
func bumped(s: State, k: int) -> State:
    mut c = s
    c.f0 += k
    c.f5 = s.f0 * 2
    return c


# Called through a function value: the call passes distinct memories, whatever the callee allows.
func both_ways(s: State, x: int) -> State:
    return State(f0=s.f5, f1=s.f4 + x, f2=s.f3, f3=s.f2, f4=s.f1, f5=s.f0)


func both(a: State, b: State) -> State:
    return State(f0=a.f0 + b.f5, f1=a.f1, f2=a.f2, f3=a.f3, f4=a.f4, f5=b.f0)


func sharing() -> str:
    mut s = State(f0=1, f1=2, f2=3, f3=4, f4=5, f5=6)
    for j in range(20):
        s = rotate(s, j)
    mut kept = s
    mut t = rotate(s, 7)
    mut p = Pair(x=Big(a=1, b=2, c=3, d=4, e=5), y=Big(a=6, b=7, c=8, d=9, e=10))
    for k in range(3):
        p = swap_halves(p, k)
    mut q = Pair(x=Big(a=1, b=2, c=3, d=4, e=5), y=Big(a=6, b=7, c=8, d=9, e=10))
    for k in range(3):
        q = keep_x(q, k)
    for k in range(3):
        q = flip(q)
    mut u = State(f0=1, f1=1, f2=1, f3=1, f4=1, f5=1)
    for k in range(4):
        u = bumped(u, k)
    mut w = both(s, s)
    w = both(w, w)
    mut steps = [rotate, both_ways]
    mut v = s
    for j in range(3):
        mut step = steps[(j + s.f0) % 2]
        v = step(v, j)
    return str(s.f0) + " " + str(s.f5) + " " + str(kept.f5) + " " + str(t.f5) + " | " + str(p.x.a) + " " + str(p.y.a) + " " + str(p.y.e) + " | " + str(q.x.a) + " " + str(q.y.b) + " " + str(q.y.c) + " | " + str(u.f0) + " " + str(u.f5) + " | " + str(w.f0) + " " + str(w.f5) + " | " + str(v.f5)


# ---- step 5: a field taken for a `mut` call next to calls that borrow its record ----
record Slot:
    key: int
    value: int


record Table:
    entries: Slot[]
    count: int


record Globals:
    names: str[]
    table: Table


func hash_of(g: Globals, k: int) -> int:
    return len(g.names[k % len(g.names)]) + len(g.table.entries)


func grab(g: Globals) -> Table:
    return g.table.copy()


func put(mut t: Table, k: int, h: int, v: int) -> bool:
    mut i = (k + h) % len(t.entries)
    mut fresh = t.entries[i].key == -1
    t.entries[i] = Slot(key=k, value=v)
    if fresh:
        t.count += 1
    return fresh


func set_global(mut g: Globals, k: int, v: int) -> bool:
    mut wb = g.table.copy()
    mut r = put(mut wb, k, hash_of(g, k), v)
    g.table = wb
    return r


# The borrowing call keeps the old table: the update must copy, and the kept table is the old one.
func keep_then_put(mut g: Globals, k: int) -> int:
    mut wb = g.table.copy()
    mut kept = grab(g)
    _ = put(mut wb, k, 0, 99)
    g.table = wb
    return kept.entries[k % len(kept.entries)].value * 1000 + g.table.entries[k % len(g.table.entries)].value


# A read of the field after the `mut` call sees the old table.
func peek_after(mut g: Globals, k: int) -> int:
    mut wb = g.table.copy()
    mut r = put(mut wb, k, 0, 7)
    mut seen = hash_of(g, k) + g.table.entries[k % len(g.table.entries)].value
    g.table = wb
    return seen + (if (r) then (1) else (0))


func globals() -> str:
    mut g = Globals(names=["a", "bb", "ccc"], table=Table(entries=[for _ in range(16) yield Slot(key=-1, value=0)], count=0))
    mut snapshot = g.table.copy()
    mut n = 0
    for k in range(40):
        if set_global(mut g, k, k * 2):
            n += 1
    mut kept = keep_then_put(mut g, 3)
    return str(n) + " " + str(g.table.count) + " " + str(g.table.entries[3].value) + " " + str(snapshot.count) + " " + str(len(snapshot.entries)) + " " + str(kept) + " " + str(peek_after(mut g, 5)) + " " + str(g.table.entries[5].value)


# ---- step 6: container updates of an element's field in place ----
record Bucket:
    name: str
    items: int[]
    seen: dict[int, int]
    a: int
    b: int


func buckets(n: int) -> str:
    mut xs = [for k in range(4) yield Bucket(name="b" + str(k), items=[], seen={}, a=k, b=0)]
    mut before = xs.copy()
    mut keep = xs[1].items.copy()
    for i in range(n):
        xs[i % 4].items.append(i)
        xs[i % 3].seen[i % 5] = i
        if i % 7 == 0:
            _ = xs[i % 4].items.pop()
        if i == 10:
            keep = xs[1].items.copy()
    mut total = 0
    for x in xs:
        total += len(x.items) * 100 + x.items[len(x.items) - 1] + len(x.seen) * 7 + x.a
    return str(total) + " " + str(len(before[0].items)) + " " + str(len(keep)) + " " + str(keep[len(keep) - 1]) + " " + xs[3].name + " " + str(xs[2].seen[4])


# A trap between the build in %ret and the return.
func trapping(k: int, mut t: Cursor) -> Result[Token, LexError]:
    mut tok = make_token(b"xyz", t, 3)
    t.col += k
    return Ok(tok)


func main(args: str[], out: Stream) -> int:
    out.print(tokens(b"ab\n#c!d"))
    out.print(tokens(b"!!x"))
    out.print(checked(b"a#bc!d#"))
    out.print(pairs())
    out.print(lent())
    out.print(sharing())
    out.print(globals())
    out.print(buckets(300))
    if len(args) > 0:
        mut t = Cursor(pos=0, line=0, col=9223372036854775807, error_span=Span(line=0, col=0, offset=0))
        match trapping(len(args), mut t):
            case Ok(tok):
                out.print(tok.text)
            case Err(_):
                out.print("err")
    return 0
