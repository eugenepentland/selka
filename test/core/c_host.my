module c_host

public record Pair:
    number: int
    small: u8

host def echo(host: Host, value: Pair) -> Pair effects(host)
host def raw(host: Host, value: bytes) -> bytes effects(host)
extern def scalar_echo(host: Host, value: int) -> int effects(host)

def main(host: Host) -> int:
    value = echo(host, Pair(number=42, small=7u8))
    assert value.number == 42 and value.small == 7u8
    assert raw(host, b"abc") == b"abc"
    return scalar_echo(host, 3) - 3
