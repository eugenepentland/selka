
extern func runtime_bench_now(host: Host) -> i64 effects(host)

# Row `mutate_nested` of benchmarks/runtime/expanded/collections/main.my as a program of its own, like
# compute_s0.my: arguments `size iterations seed` (the original takes the row name first), the same
# setup, kernel (the row's branch of `batch_result`), checksum and output `checksum elapsed`.
# The dictionaries, keys and Lox program the original builds for other rows are left out.


func batch_result(size: int, batch: int, seed: int, mut nested: int[][]) -> int:
    mut snapshot = nested
    mut index = (seed + batch * 17) % size
    nested[index][1] = (nested[index][1] + batch + 1) % 1000003
    return snapshot[index][1] + nested[index][1]


func parse_number(text: str) -> int:
    match parse_int(text):
        case Some(n):
            return n
        case None:
            return 0


func main(args: str[], host: Host, out: Stream) -> int:
    if len(args) != 3:
        return 2
    mut size = parse_number(args[0])
    mut iterations = parse_number(args[1])
    mut seed = parse_number(args[2])
    if size < 2 or iterations < 1 or seed < 1 or seed > 1000000:
        return 2
    mut nested = [for j in range(size) yield [for k in range(4) yield (seed + j * 13 + k) % 1009]]
    mut checksum = 0
    mut start = runtime_bench_now(host)
    for batch in range(iterations):
        mut part = batch_result(size, batch, seed, mut nested)
        if part < 0:
            return 2
        checksum = (checksum + part) % 1000000007
    mut elapsed = runtime_bench_now(host) - start
    for inner in nested:
        for value in inner:
            checksum = (checksum + value) % 1000000007
    out.print(checksum, elapsed)
    return 0
