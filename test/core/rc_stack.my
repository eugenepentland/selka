module rc_stack


def short_sums(n: int, seed: int) -> int:
    total = 0
    for j in range(n):
        short = [seed + j + k for k in range(4)]
        for value in short:
            total += value
        short = []
        tail = [j, j + 1]
        total += len(tail) + tail[1] + len(short)
    return total


def bounded(seed: int) -> int:
    m = seed % 5
    xs = [k * 2 for k in range(m)]
    total = len(xs)
    for x in xs:
        total += x
    return total


def escapes(n: int) -> list[int]:
    out = [k for k in range(n)]
    return out


def main(args: list[str], out: Stream) -> int:
    out.print(short_sums(10, len(args)), bounded(len(args)), len(escapes(3)))
    return 0
