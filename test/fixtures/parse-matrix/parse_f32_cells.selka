# the parse parse_f32 that checks, builds and runs as its oracle does; test/parse_matrix_cli_test.zig runs it.
import strings

record Holder:
    text: str = ""
    n: int = 0


record Outer:
    inner: Holder = Holder()
    n: int = 0


enum Tok:
    blank
    word(text: str)


func pick(s: str) -> str from s:
    return s


func make(s: str) -> str:
    return copy(s)


func field_of(h: Holder) -> str from h:
    return h.text


func head(s: str, n: int) -> str from s:
    return s[0:n]


func report(out: Stream, name: str, got: str, want: str) -> int:
    if got == want:
        print(out, "ok", name, got)
        return 0
    print(out, "DIFF", name, got, want)
    return 1


func cell_param_show(text: str) -> str:
    return str(parse_f32(text))


func cell_param_unwrap(text: str) -> str:
    return str(parse_f32(text).unwrap_or(-1.0))


func cell_param_plus(text: str) -> str:
    return str(parse_f32(text).unwrap_or(-1.0) + 1.0)


func cell_param_bind(text: str) -> str:
    const r = parse_f32(text)
    return str(r)


func cell_param_is(text: str) -> str:
    mut got = "none"
    if parse_f32(text) is Some(x):
        got = str(x)
    return got


func cell_param_match(text: str) -> str:
    mut got = "none"
    match parse_f32(text):
        case Some(x):
            got = str(x)
        case None:
            got = "none"
    return got


