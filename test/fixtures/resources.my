resource File: filesystem;
result Open { ok: File, err: i64 }
struct Failure { code: i64, resource: File }
result Finish { ok: bool, err: Failure }

fn retry(file: File) -> Finish effects(filesystem) {
    match complete_resource<Finish>(file) {
        Finish.ok(done) => { return new Finish.ok(done); },
        Finish.err(failure) => {
            if read_field(failure, code) == 3 {
                return complete_resource<Finish>(failure.resource);
            } else {
                return new Finish.err(failure);
            }
        }
    }
}

fn main(fs: filesystem_cap) -> i64 noalloc {
    match acquire_resource<Open>(fs, new [1]u8 [42u8]) {
        Open.ok(file) => {
            match retry(file) {
                Finish.ok(done) => {
                    if done { return 7; } else { return 0; }
                },
                Finish.err(failure) => { return failure.code; }
            }
        },
        Open.err(code) => { return code; }
    }
}
