resource File: filesystem

result Open:
    ok: File,
    err: int


class Chunk:
    bytes: [16]u8
    length: u64
    eof: bool


result Read:
    ok: Chunk,
    err: int


result Written:
    ok: u64,
    err: int


result Status:
    ok: int,
    err: int


def work(fs: Filesystem) -> Status effects(filesystem):
    request: [1]u8 = [42u8]
    file = acquire_resource[Open](fs, request)?
    chunk = read_resource[Read](file)?
    # The count reports actual write progress. This example sends one byte.
    payload: [1]u8 = [7u8]
    written = write_resource[Written](file, payload)?
    return Ok(int(chunk.length) + int(written))


def main(fs: Filesystem) -> int noalloc:
    match work(fs):
        case Status.ok(value):
            return value
        case Status.err(code):
            return -code
