record Point:
    x: int
    y: int


record Segment:
    start: Point
    end: Point
    visible: bool


def move(point: Point, dx: int) -> Point:
    moved = point
    moved.x = point.x + dx
    return moved


def main() -> int:
    origin = Point(y=2, x=3)
    segment = Segment(start=origin, end=move(origin, 4), visible=True)
    if segment.visible:
        return segment.start.x + segment.end.x + segment.end.y
    return 0
