struct Point { x: i64, y: i64 }
struct Segment { start: Point, end: Point, visible: bool }

fn move(point: Point, dx: i64) -> Point {
    return update(point) { x: point.x + dx };
}

fn main() -> i64 {
    let origin = new Point { y: 2, x: 3 };
    let segment = new Segment {
        start: origin,
        end: move(origin, 4),
        visible: true
    };
    if segment.visible {
        return segment.start.x + segment.end.x + segment.end.y;
    }
    return 0;
}
