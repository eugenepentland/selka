class Sample:
    value: u8


class WideSample:
    value: u64


conversion def widen(sample: Sample) -> WideSample:
    return WideSample(value=cast<u64>(sample.value))


def main() -> i64:
    small = Sample(value=255u8)
    wide = widen(small)
    quotient = 18446744073709551615u64 // 3u64
    return cast<i64>(quotient - wide.value)
