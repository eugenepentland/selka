record Entry:
    bytes: [64]u8
    length: u64
    present: bool


result Lookup:
    ok: Entry,
    err: int


def lookup(env: Environment) -> Lookup effects(environment):
    # The injected provider defines which names it permits; these bytes spell K.
    return environment_get[Lookup](env, [75u8])


def main(env: Environment) -> int noio:
    match lookup(env):
        case Lookup.ok(entry):
            if entry.present:
                return int(entry.length)
            return -1
        case Lookup.err(code):
            return -code - 1
