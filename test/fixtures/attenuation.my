resource File: filesystem

result Open:
    ok: File,
    err: i64


class Chunk:
    bytes: [16]u8
    length: u64
    eof: bool


result Read:
    ok: Chunk,
    err: i64


def delegate(fs: filesystem_cap) -> filesystem_cap effects():
    return restrict_resource<read>(fs)


def main(fs: filesystem_cap) -> i64:
    reader = delegate(fs)
    request: [1]u8 = [42u8]
    match acquire_resource<Open>(reader, request):
        case Open.ok(input):
            file = input
            match read_resource<Read>(file):
                case Read.ok(chunk):
                    return cast<i64>(chunk.length)
                case Read.err(code):
                    return -code
        case Open.err(code):
            return -code
