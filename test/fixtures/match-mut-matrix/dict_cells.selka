func cell_iterate_element(out: Stream):
    mut xs = [Slot.Has(value=make())]
    match mut xs[0]:
        case Has(value):
            for e in value:
                print(out, e)
        case Nothing:
            print(out, "nothing")
    after(out, xs[0])


