import lists
import sets
import strings

record Pair:
    n: int
    s: str


enum Inner:
    Leaf(text: str)
    Stem


enum Slot:
    Has(value: Inner)
    Nothing


record Holder:
    slot: Slot
    tag: int


enum Outer:
    Wrap(slot: Slot)
    Bare


enum Twin:
    Two(value: Inner, n: int)
    Zero


func make() -> Inner:
    return Inner.Leaf(text="xy")


func look(x: Inner) -> int:
    match x:
        case Leaf(text):
            return len(text)
        case Stem:
            return -1


func touch(mut x: Inner):
    x = Inner.Stem


func after(out: Stream, s: Slot):
    match s:
        case Has(value):
            print(out, look(value))
        case Nothing:
            print(out, "nothing")


func cell_compare_element(out: Stream):
    mut xs = [Slot.Has(value=make())]
    match mut xs[0]:
        case Has(value):
            print(out, value == make())
        case Nothing:
            print(out, "nothing")
    after(out, xs[0])


func cell_compare_element_field(out: Stream):
    mut hs = [Holder(slot=Slot.Has(value=make()), tag=0)]
    match mut hs[0].slot:
        case Has(value):
            print(out, value == make())
        case Nothing:
            print(out, "nothing")
    after(out, hs[0].slot)


func cell_compare_field(out: Stream):
    mut h = Holder(slot=Slot.Has(value=make()), tag=0)
    match mut h.slot:
        case Has(value):
            print(out, value == make())
        case Nothing:
            print(out, "nothing")
    after(out, h.slot)


func cell_compare_local(out: Stream):
    mut s = Slot.Has(value=make())
    match mut s:
        case Has(value):
            print(out, value == make())
        case Nothing:
            print(out, "nothing")
    after(out, s)


func work_compare_mut_param(out: Stream, mut s: Slot):
    match mut s:
        case Has(value):
            print(out, value == make())
        case Nothing:
            print(out, "nothing")
    after(out, s)


func cell_compare_mut_param(out: Stream):
    mut s = Slot.Has(value=make())
    work_compare_mut_param(out, mut s)


func cell_compare_nested(out: Stream):
    mut o = Outer.Wrap(slot=Slot.Has(value=make()))
    match mut o:
        case Wrap(slot):
            match mut slot:
                case Has(value):
                    print(out, value == make())
                case Nothing:
                    print(out, "nothing")
        case Bare:
            print(out, "bare")
    match o:
        case Wrap(slot):
            after(out, slot)
        case Bare:
            print(out, "bare")


func cell_compare_option(out: Stream):
    mut o: Inner? = Some(make())
    match mut o:
        case Some(value):
            print(out, value == make())
        case None:
            print(out, "nothing")
    match o:
        case Some(value):
            print(out, look(value))
        case None:
            print(out, "nothing")


func cell_compare_two_fields(out: Stream):
    mut w = Twin.Two(value=make(), n=5)
    match mut w:
        case Two(value, n):
            print(out, value == make())
        case Zero:
            print(out, "nothing")
    match w:
        case Two(value, n):
            print(out, look(value))
        case Zero:
            print(out, "nothing")


func cell_copy_element(out: Stream):
    mut xs = [Slot.Has(value=make())]
    match mut xs[0]:
        case Has(value):
            const c = copy(value)
            print(out, look(c))
        case Nothing:
            print(out, "nothing")
    after(out, xs[0])


