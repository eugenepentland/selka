func main(out: Stream) -> int:
    print(out, "== compare element")
    cell_compare_element(out)
    print(out, "== compare element_field")
    cell_compare_element_field(out)
    print(out, "== compare field")
    cell_compare_field(out)
    print(out, "== compare local")
    cell_compare_local(out)
    print(out, "== compare mut_param")
    cell_compare_mut_param(out)
    print(out, "== compare nested")
    cell_compare_nested(out)
    print(out, "== compare option")
    cell_compare_option(out)
    print(out, "== compare two_fields")
    cell_compare_two_fields(out)
    print(out, "== copy element")
    cell_copy_element(out)
    print(out, "== copy element_field")
    cell_copy_element_field(out)
    print(out, "== copy field")
    cell_copy_field(out)
    print(out, "== copy local")
    cell_copy_local(out)
    print(out, "== copy mut_param")
    cell_copy_mut_param(out)
    print(out, "== copy nested")
    cell_copy_nested(out)
    print(out, "== copy option")
    cell_copy_option(out)
    print(out, "== copy two_fields")
    cell_copy_two_fields(out)
    print(out, "== hole element")
    cell_hole_element(out)
    print(out, "== hole element_field")
    cell_hole_element_field(out)
    print(out, "== hole field")
    cell_hole_field(out)
    print(out, "== hole local")
    cell_hole_local(out)
    print(out, "== hole mut_param")
    cell_hole_mut_param(out)
    print(out, "== hole nested")
    cell_hole_nested(out)
    print(out, "== hole option")
    cell_hole_option(out)
    print(out, "== hole two_fields")
    cell_hole_two_fields(out)
    print(out, "== mutparam element")
    cell_mutparam_element(out)
    print(out, "== mutparam element_field")
    cell_mutparam_element_field(out)
    print(out, "== mutparam field")
    cell_mutparam_field(out)
    print(out, "== mutparam local")
    cell_mutparam_local(out)
    print(out, "== mutparam mut_param")
    cell_mutparam_mut_param(out)
    print(out, "== mutparam nested")
    cell_mutparam_nested(out)
    print(out, "== mutparam option")
    cell_mutparam_option(out)
    print(out, "== mutparam two_fields")
    cell_mutparam_two_fields(out)
    print(out, "== param element")
    cell_param_element(out)
    print(out, "== param element_field")
    cell_param_element_field(out)
    print(out, "== param field")
    cell_param_field(out)
    print(out, "== param local")
    cell_param_local(out)
    print(out, "== param mut_param")
    cell_param_mut_param(out)
    print(out, "== param nested")
    cell_param_nested(out)
    print(out, "== param option")
    cell_param_option(out)
    print(out, "== param two_fields")
    cell_param_two_fields(out)
    print(out, "== print element")
    cell_print_element(out)
    print(out, "== print element_field")
    cell_print_element_field(out)
    print(out, "== print field")
    cell_print_field(out)
    print(out, "== print local")
    cell_print_local(out)
    print(out, "== print mut_param")
    cell_print_mut_param(out)
    print(out, "== print nested")
    cell_print_nested(out)
    print(out, "== print option")
    cell_print_option(out)
    print(out, "== print two_fields")
    cell_print_two_fields(out)
    return 0
