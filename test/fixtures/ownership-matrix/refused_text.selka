record Item:
    name: str
    count: int


record Rec:
    name: str
    items: int[]
    item: Item
    raw: bytes


record TextBox:
    value: str


record ItemBox:
    value: Item


record BytesBox:
    value: bytes


record IntsBox:
    value: int[]


func make_bytes(n: int) -> bytes:
    if n > 100:
        return b"long" + b"er"
    return b"ab" + b"cd"


func make_ints(n: int) -> int[]:
    return [n, n + 1]


func first_bytes(r: Rec) -> bytes from r:
    return r.raw


func first_ints(r: Rec) -> int[] from r:
    return r.items


func read_bytes(s: bytes) -> int:
    return len(s)


func read_ints(s: int[]) -> int:
    return len(s)


func keep_bytes(own s: bytes) -> int:
    return len(s)


func keep_ints(own s: int[]) -> int:
    return len(s)


func make_text(n: int) -> str:
    return f"text{n}"


func make_item(n: int) -> Item:
    return Item(name=f"item{n}", count=n)


func first_text(r: Rec) -> str from r:
    return r.name


func first_item(r: Rec) -> Item from r:
    return r.item


func read_text(s: str) -> int:
    return len(s)


func read_item(i: Item) -> int:
    return i.count


func keep_text(own s: str) -> int:
    return len(s)


func keep_item(own i: Item) -> int:
    return i.count


