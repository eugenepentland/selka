# A program that sleeps until it hears a stop (FR5b, STOP-1), then takes 2 s over its goodbye: the first sleep ends early on
# the stop, the goodbye's sleep lasts its whole length because the stop has been read, and a second signal during it ends
# the program. It sleeps at most 60 s in all.
import filesystem
import process
import time

func main(fs: Filesystem, clock: Clock, err: Stream, stop: Stop) -> int:
    match filesystem.realpath(fs, "/proc/self"):
        case Ok(path):
            print(err, "guest " + path)
        case Err(_):
            return 1
    mut sleeps = 0
    while not process.stop_requested(stop) and sleeps < 3:
        time.sleep(clock, 20000000000)
        sleeps += 1
    print(err, "heard after " + str(sleeps) + " sleeps")
    time.sleep(clock, 2000000000)
    print(err, "goodbye")
    return 0
