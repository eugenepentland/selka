# SP1-F-3, W3-F-4: a module constant written without its type, `const NAME = value`. When the value is one literal of a
# plain type (int, float, str, bool), `selka fix` inserts the type after the name; any other value keeps its message.
const LIMIT: int = 40
public const OFFSET: int = -2
const RATIO: float = 0.5
const GREETING: str = "hello"
const VERBOSE: bool = True


func main(out: Stream) -> int:
    if VERBOSE:
        print(out, GREETING)
    return LIMIT + OFFSET + int(RATIO * 4.0)
