# A skeleton written in the Zig's names: the module builds and reads its own `Unit`, which the builtin used to win, so it never
# checked. The repair renames the declaration, the references in the importers and every `Unit` this module writes, since it
# builds one (`Unit(number=...)`) and so plainly means its own record by the name.
public record ShapeUnit:
    number: int
    name: str = "u"


public enum Kind:
    plain
    tagged(code: int)


public record Holder:
    units: ShapeUnit[]


public func make(n: int) -> ShapeUnit:
    return ShapeUnit(number=n)


public func maybe(n: int) -> ShapeUnit?:
    if n > 0:
        return Some(ShapeUnit(number=n, name="m"))
    return None
