func negate(value: int) -> int:
    return 0 - value


func main(out: Stream) -> int:
    mut values = [5]
    values.append(3)
    values.append(1)
    values.append(2)
    values.sort()
    mut descended = [5]
    descended.append(2)
    descended.append(1)
    descended.sort(reverse=True)
    mut keyed = [5]
    keyed.append(9)
    keyed.append(4)
    keyed.sort(key=negate, reverse=False)
    out.print(values[0], descended[0], keyed[0])
    return 0
