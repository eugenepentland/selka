# A Unicode marker keeps the fix spans tied to UTF-8 bytes: λ.
public func choose(left: str[], right: str[], take_left: bool) -> str[] from left, right:
    if take_left:
        return left
    return right


public func view(data: bytes) -> bytes from data:
    return data[1:3]


public func checked(value: str, failed: bool) -> str from value fails str:
    if failed:
        fail "rejected"
    return value[0:2]


public func through(mut values: str[]) -> str[] from values:
    return values


public func generic[T](value: T) -> T from value:
    return value
