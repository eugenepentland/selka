record Shelf:
    counts: dict[str, int]


func drain[K: equality, V: copy + storable](mut mapping: dict[K, V], key: K) -> V:
    return mapping.pop(key)


func main(out: Stream) -> int:
    mut counts: dict[str, int] = {"a": 1, "b": 2}
    print(out, counts.get("a", 0), counts.get("z", 7))
    _ = counts.setdefault("c", 3)
    counts.update({"d": 4})
    mut total = 0
    for key in counts.keys():
        total += len(key)
    for value in counts.values():
        total += value
    for name, value in counts.items():
        total += value + len(name)
    print(out, total, drain(mut counts, "d"), counts.pop("zz", 9), counts.pop("a"))
    mut shelf = Shelf(counts={"s": 2})
    print(out, shelf.counts.get("s", 0))
    counts.clear()
    print(out, len(counts))
    return 0
