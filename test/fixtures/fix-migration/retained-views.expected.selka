import bytes

const RAW: bytes = b"xx42"


@noalloc
func parsed[T](raw: bytes, marker: T) -> int?:
    return bytes.parse_int(raw[2:4])


func main(out: Stream) -> int:
    match parsed[int](RAW, 0):
        case Some(value):
            print(out, value)
        case None:
            return 1
    match bytes.parse_int(RAW[2:4]):
        case Some(value):
            print(out, value)
        case None:
            return 2
    match bytes.parse_int((b"xx42")[2:4]):
        case Some(value):
            print(out, value)
        case None:
            return 3
    return 0
# lint: allow-file match-else reason="this corpus pins its own migration; the flat forms have unwrapping-match.selka"
# lint: allow-file match-is reason="this corpus pins its own migration; the flat forms have unwrapping-match.selka"
