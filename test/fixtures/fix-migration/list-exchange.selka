# W13 slice 3: `xs.exchange(i, v)` is the operation `lists.exchange(mut xs, i, v)` supplies, so `selka fix` rewrites
# every spelling of it: an index of any integer type, any element, a fresh replacement whose type comes from the list,
# and a named managed replacement, which needs `own` in both spellings and keeps it.
record Point:
    x: int
    y: int


func first_kept(mut results: Result[int, str][]) -> int:
    const value = results.exchange(1, Ok(5)) else Err(_):
        return 0 - 1
    return value


func main(out: Stream) -> int:
    mut values = [1, 2, 3]
    const small = 1u8
    print(out, values.exchange(small, 9), values)
    print(out, values.exchange(2u64, 7), values.exchange(0i8, 5), values)
    mut results: Result[int, str][] = [Ok(1), Err("no")]
    print(out, first_kept(mut results), first_kept(mut results))
    _ = results
    mut names = ["a", "b"]
    mut name = "c"
    const old = names.exchange(0, own name)
    print(out, old, names)
    mut points = [Point(x=1, y=2)]
    const point = points.exchange(0, Point(x=3, y=4))
    print(out, point.x, points[0].y)
    mut rows = [[1], [2]]
    const row = rows.exchange(1, [3, 4])
    print(out, row, rows)
    return 0
