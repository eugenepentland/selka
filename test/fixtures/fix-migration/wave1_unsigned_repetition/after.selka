func mark_count(mut log: int[]) -> u64:
    append(mut log, 1)
    return 18446744073709551615u64


func mark_bytes(mut log: int[]) -> bytes:
    append(mut log, 2)
    return b""


func list_count(mut values: int[]) -> u64:
    append(mut values, 9)
    return 2u64


public func generic_empty[T](tag: T, count: u64) -> str:
    _ = tag
    return repeat_sequence_334("", count)


func main() -> int:
    mut log: int[] = []
    const huge: u64 = 18446744073709551615
    const empty: int[] = []
    if repeat_sequence_504("", huge) != "" or repeat_sequence_543(mark_count(mut log), mark_bytes(mut log)) != b"":
        return 1
    if len(repeat_sequence_641(empty, huge)) != 0 or generic_empty(0, huge) != "":
        return 2
    mut text = "ab"
    const repeated_source_754 = copy(text)
    const repeated_count_754 = 3u64
    text = repeat_sequence_754(repeated_source_754, repeated_count_754)
    mut data = b"ab"
    const repeated_source_926 = copy(data)
    const repeated_count_926 = 3u64
    data = repeat_sequence_926(repeated_source_926, repeated_count_926)
    mut values: int[] = []
    const repeated_source_1104 = copy(values)
    const repeated_count_1104 = huge
    values = repeat_sequence_1104(repeated_source_1104, repeated_count_1104)
    mut snapshots = [1]
    const repeated_source_1288 = copy(snapshots)
    const repeated_count_1288 = list_count(mut snapshots)
    snapshots = repeat_sequence_1288(repeated_source_1288, repeated_count_1288)
    if snapshots != [1, 1]:
        return 4
    const narrow: u8 = 2
    mut narrow_values = [5]
    const repeated_source_925 = copy(narrow_values)
    mut repeated_count_925 = int(narrow)
    if len(repeated_source_925) == 0:
        repeated_count_925 = 0
    narrow_values = []
    for _ in range(repeated_count_925):
        for repeated_element_925 in repeated_source_925:
            append(mut narrow_values, copy(repeated_element_925))
    if narrow_values != [5, 5]:
        return 3
    if text == "ababab" and data == b"ababab" and len(values) == 0 and log == [1, 2]:
        return 42
    return 0


func repeat_sequence_334(repeat_source_334: str, repeat_times_334: u64) -> str:
    if repeat_times_334 == 0u64 or len(repeat_source_334) == 0:
        return ""
    mut repeat_output_334 = copy(repeat_source_334)
    mut repeat_copies_334 = 1u64
    while repeat_copies_334 <= repeat_times_334 - repeat_copies_334:
        repeat_output_334 = repeat_output_334 + repeat_output_334
        repeat_copies_334 *= 2u64
    if repeat_copies_334 < repeat_times_334:
        repeat_output_334 = repeat_output_334 + repeat_output_334[:len(repeat_source_334) * int(repeat_times_334 - repeat_copies_334)]
    return repeat_output_334


