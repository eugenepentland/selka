import emit
import kicad.shape


func main(out: Stream) -> int:
    shape.note(out)
    const first = shape.ShapeUnit(number=7, name="x")
    const second = emit.build()
    print(out, emit.count([copy(first), copy(second)]), first.number + second.number, first.name)
    return shape.describe(shape.Mode.inverted)
