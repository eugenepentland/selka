import buffers

func main(out: Stream) -> int:
    mut empty: int[] = []
    mut data = byte_buffer(empty)
    _ = buffers.append_byte(mut data, 65)
    buffers.append(mut data, b"BC")
    buffers.append_int(mut data, 1)
    buffers.append_utf8(mut data, "é")
    _ = buffers.append_range(mut data, b"0123", 1, 3)
    _ = buffers.reserve(mut data, 4096)
    print(out, len(data), bytes(data) == b"ABC1\xc3\xa912")
    buffers.clear(mut data)
    print(out, len(data))
    return 0
