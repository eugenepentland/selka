import filesystem
import ops
import random

func probe(fs: Filesystem, path: str) -> bool:
    return fs.exists(path)


# A parameter passed on as `mut` keeps its own `mut` until the callee loses its; the rounds settle the chain.
func relay(fs: Filesystem, path: str) -> bool:
    return probe(fs, path)


func top(fs: Filesystem, path: str) -> bool:
    return relay(fs, path)


# Passed on to a callee that assigns its parameter: this `mut` stays.
func keeps(mut fs: Filesystem) -> bool:
    return ops.replace_fs(mut fs)


func main(out: Stream) -> int:
    mut fs = filesystem.memory()
    mut entropy = random.seeded_entropy(7)
    _ = fs.write_text("a", "x")
    print(out, top(fs, "a"), ops.has_file(fs, "b"), keeps(mut fs))
    print(out, ops.draw(entropy, 1))
    return 0
