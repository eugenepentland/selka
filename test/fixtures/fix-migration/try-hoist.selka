# F-3, then TRY-2: `selka fix` once declared each `try` that stood inside an expression on its own line before its
# statement. Since TRY-2 (17 November 2026) a `try` stands as an operand or an argument anywhere a value is computed at
# run time, so this program checks as written and `selka fix` leaves it; try-hoist.expected.selka is what it once wrote.
record Pair:
    left: int
    right: int


func read(text: str) -> int fails str:
    if text == "":
        fail "empty"
    return len(text)


func names(n: int) -> str[] fails str:
    if n < 0:
        fail "negative"
    return ["a", "bc"]


func header_line(name: str) -> str fails str:
    return name + ";"


func pair(a: str, b: str) -> Pair fails str:
    return Pair(left=try read(a), right=try read(b))


func larger(a: str, b: str) -> int fails str:
    const x = max(try read(a), 1)
    const y = max(try read(b), 2)
    return x + y


func text_of(name: str) -> str fails str:
    mut text = "head: "
    text = text + try header_line(name)
    return text


func count(n: int) -> int fails str:
    mut seen = 0
    for name in try names(n):
        seen += len(name)
    return seen


func main(out: Stream) -> int:
    match pair("ab", "c"):
        case Ok(found):
            print(out, found.left + found.right)
        case Err(reason):
            print(out, reason)
    match larger("abc", "d"):
        case Ok(found):
            print(out, found)
        case Err(reason):
            print(out, reason)
    match text_of("x"):
        case Ok(found):
            print(out, found)
        case Err(reason):
            print(out, reason)
    match count(1):
        case Ok(found):
            print(out, found)
        case Err(reason):
            print(out, reason)
    return 0
