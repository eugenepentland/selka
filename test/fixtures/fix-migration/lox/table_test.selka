module table_test
# SPEC §11.2 tests 16-20 and 22. Keys are object refs whose hashes the
# table caches, so these tests pick refs and hashes without a heap.
import table
import value


def hash_of(key: int) -> u32:
    return u32(key * 2654435761 % 4294967296)


def put(target: mut table.Table, key: int, number: float) -> bool:
    return table.set(target, key, hash_of(key), value.Value.number(number))


def lookup(source: table.Table, key: int) -> Option[value.Value]:
    return table.get(source, key, hash_of(key))


def holds(source: table.Table, key: int, number: float) -> bool:
    match lookup(source, key):
        case Some(found):
            return found == value.Value.number(number)
        case None:
            return False


public def test_table_set_get() -> bool:
    t = table.new_table()
    _ = put(t, 1, 1.0)
    return holds(t, 1, 1.0) and lookup(t, 2).is_none()


public def test_table_set_reports_new_key() -> bool:
    t = table.new_table()
    first = put(t, 1, 1.0)
    second = put(t, 1, 2.0)
    return first and not second and holds(t, 1, 2.0)


public def test_table_grows_at_load_factor() -> bool:
    t = table.new_table()
    empty = table.capacity(t)
    _ = put(t, 1, 1.0)
    after_first = table.capacity(t)
    key = 2
    while key <= 6:
        _ = put(t, key, 1.0)
        key += 1
    after_sixth = table.capacity(t)
    _ = put(t, 7, 1.0)
    return empty == 0 and after_first == 8 and after_sixth == 8 and table.capacity(t) == 16


public def test_table_delete_leaves_tombstone() -> bool:
    t = table.new_table()
    _ = put(t, 1, 1.0)
    _ = put(t, 2, 2.0)
    _ = put(t, 3, 3.0)
    deleted = table.delete(t, 2, hash_of(2))
    return deleted and holds(t, 1, 1.0) and holds(t, 3, 3.0) and lookup(t, 2).is_none() and t.count == 3


public def test_table_tombstone_reuse() -> bool:
    t = table.new_table()
    _ = put(t, 1, 1.0)
    _ = put(t, 2, 2.0)
    _ = put(t, 3, 3.0)
    _ = table.delete(t, 2, hash_of(2))
    is_new = put(t, 2, 4.0)
    return is_new and t.count == 3 and holds(t, 2, 4.0)


public def test_table_add_all() -> bool:
    source = table.new_table()
    key = 1
    while key <= 10:
        _ = put(source, key, float(key))
        key += 1
    target = table.new_table()
    table.add_all(source, target)
    found = 0
    key = 1
    while key <= 10:
        if holds(target, key, float(key)):
            found += 1
        key += 1
    return found == 10
