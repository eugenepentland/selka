module heap_test
# SPEC §11.2 tests 31-36, on a runtime with nothing allocated at startup.
import heap
import lox_strings
import object
import table
import value


def root(rt: mut heap.Runtime, ref: value.ObjRef):
    heap.push(rt, value.Value.obj(ref))


public def test_gc_frees_unreachable() -> bool:
    rt = heap.new_runtime(False, None)
    _ = lox_strings.copy_string(rt, b"one")
    kept = lox_strings.copy_string(rt, b"two")
    _ = lox_strings.copy_string(rt, b"three")
    root(rt, kept)
    heap.collect(rt)
    return rt.freed == 2 and rt.allocations - rt.freed == 1


public def test_gc_traces_instance_fields() -> bool:
    rt = heap.new_runtime(False, None)
    name = lox_strings.copy_string(rt, b"Point")
    root(rt, name)
    klass = heap.allocate(rt, object.Obj.klass(object.ClassObj(name=name, methods=table.new_table())))
    root(rt, klass)
    fields = table.new_table()
    instance = heap.allocate(rt, object.Obj.instance(object.InstanceObj(klass=klass, fields=fields)))
    field_name = lox_strings.copy_string(rt, b"x")
    field_value = lox_strings.copy_string(rt, b"unrooted")
    _ = table.set(fields, field_name, heap.string_hash(rt, field_name), value.Value.obj(field_value))
    rt.objects[instance] = object.Obj.instance(object.InstanceObj(klass=klass, fields=fields))
    rt.stack_top = 0
    root(rt, instance)
    heap.collect(rt)
    return rt.freed == 0 and heap.string_obj(rt, field_value).chars == b"unrooted"


public def test_gc_intern_table_is_weak() -> bool:
    rt = heap.new_runtime(False, None)
    _ = lox_strings.copy_string(rt, b"gone")
    heap.collect(rt)
    missing = lox_strings.find_string(rt, b"gone", lox_strings.fnv1a(b"gone")) == value.NO_OBJ
    before = rt.allocations
    _ = lox_strings.copy_string(rt, b"gone")
    return rt.freed == 1 and missing and rt.allocations == before + 1


public def test_gc_reuses_free_slot() -> bool:
    rt = heap.new_runtime(False, None)
    freed = lox_strings.copy_string(rt, b"freed")
    kept = lox_strings.copy_string(rt, b"kept")
    root(rt, kept)
    heap.collect(rt)
    size = len(rt.objects)
    reused = lox_strings.copy_string(rt, b"reused")
    return reused == freed and len(rt.objects) == size


public def test_gc_threshold_accounting() -> bool:
    rt = heap.new_runtime(False, None)
    small = lox_strings.copy_string(rt, b"abcd")
    charged = rt.bytes_allocated == 36
    root(rt, small)
    heap.collect(rt)
    return charged and rt.bytes_allocated == 36 and rt.next_gc == max(2 * 36, 1048576)


public def test_gc_stress_collects_each_allocation() -> bool:
    rt = heap.new_runtime(True, None)
    count = 0
    while count < 25:
        ref = lox_strings.copy_string(rt, str(count).encode())
        root(rt, ref)
        count += 1
    return rt.allocations == 25 and rt.collections == 25
