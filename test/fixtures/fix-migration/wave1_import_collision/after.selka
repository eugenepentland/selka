import byte_builder as byte_builder_wave1_0
import strings as strings_wave1_0
import lists as lists_wave1_0
func count(lists: int) -> int:
    return lists


func main() -> int:
    const lists = 3
    const strings = 4
    const byte_builder = 5
    const octets: bytes = b"x"
    const values = lists_wave1_0.filled(lists, 7)
    if len(values) != count(lists) or not lists_wave1_0.contains(values, 7):
        return 1
    if len(strings_wave1_0.repeat("x", strings)) != 4 or len(byte_builder_wave1_0.repeat(octets, byte_builder)) != 5:
        return 2
    return 42
