# F-76: a call written as a statement with `else Err(e):` or `else None:`. `else` unwraps the value of a declaration or
# of `_ =`, and a statement that is only a call has none to bind; `selka fix` writes `if CALL is Err(e):`, the test of
# a call that gives nothing back (the bare `else:` has no case to carry over and stays, with its message).
func check(n: int) fails str:
    if n < 0:
        fail "negative"


func parse(n: int) -> int fails str:
    if n < 0:
        fail "negative"
    return n


func find(n: int) -> int?:
    if n == 0:
        return None
    return Some(n)


func total(values: int[]) -> int:
    mut sum = 0
    for value in values:
        if check(value) is Err(_):
            continue
        sum += value
    return sum


func main(out: Stream) -> int:
    if check(-1) is Err(reason):
        print(out, "check:", reason)
    if parse(-2) is Err(reason):
        print(out, "parse:", reason)
    if find(0) is None:
        print(out, "find: nothing")
    print(out, total([1, -2, 3]))
    return 0
