# `head` returns a view of its text, and `apply` takes a function whose result must
# be owned, so `head` cannot be passed as it is: the migration writes a copying wrapper.
func head(text: str) -> str:
    return text[0:4]


func apply(callback: func(str) -> str, text: str) -> int:
    return len(callback(text))


func main(out: Stream) -> int:
    out.print(apply(head, "abcdefgh"))
    return 0
