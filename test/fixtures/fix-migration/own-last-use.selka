# A copy of an owned local or an `own` parameter at its last use, where the value is taken over, is a needless copy
# (W_NEEDLESS_COPY case v): `selka fix` writes `own value` (a bare `value` when returned). The copies that must stay are
# beside them: a value used again, copied in a loop it was not declared in, borrowed by a live alias, or a borrowed
# parameter.
import sets


record Box:
    name: str


func eat(own s: str) -> int:
    return len(s)


func keep(own x: str, mut out: str[]):
    append(mut out, copy(x))


func keep_each(own x: str, mut out: str[]):
    for i in range(2):
        append(mut out, copy(x))


func keep_borrowed(x: str, mut out: str[]):
    append(mut out, copy(x))


func fresh() -> str:
    const x = "r" + str(1)
    return copy(x)


func main(out: Stream) -> int:
    mut list: str[] = []
    mut seen: dict[str, int] = {}
    mut names: set[str] = set()
    const a = "a" + str(1)
    append(mut list, copy(a))
    const b = "b" + str(2)
    seen[copy(b)] = 1
    const c = "c" + str(3)
    sets.add(mut names, copy(c))
    const e = "e" + str(5)
    const box = Box(name=copy(e))
    const g = "g" + str(7)
    const n = eat(copy(g))
    for i in range(2):
        const inside = "i" + str(i)
        append(mut list, copy(inside))
    const outside = "o" + str(1)
    for i in range(2):
        append(mut list, copy(outside))
    const later = "l" + str(1)
    append(mut list, copy(later))
    const aliased = "s" + str(1)
    const alias = aliased
    append(mut list, copy(aliased))
    keep("k", mut list)
    keep_each("p", mut list)
    keep_borrowed("q", mut list)
    print(out, len(list), len(seen), len(names), box.name, n, fresh(), later, alias)
    return 0
