        case empty:
            return 1


func builtin_cell_matchmut_own_passed_own(out: Stream):
    mut b = Box.full(items=[1, 2])
    _ = builtin_cell_matchmut_own_passed_own_at(out, mut b)
    print(out, "  after", b)


func builtin_cell_matchmut_call_bound_at(out: Stream, mut b: Box) -> int:
    match mut b:
        case full(items=items):
            print(out, "  at")
            const was = exchange(mut items[0], make_new())
            print(out, "  was", was)
            return 0
        case empty:
            return 1


func builtin_cell_matchmut_call_bound(out: Stream):
