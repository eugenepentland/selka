func builtin_cell_matchmut_call_passed_at(out: Stream, mut b: Box) -> int:
    match mut b:
        case full(items=items):
            print(out, "  at")
            _ = show(out, exchange(mut items[0], make_new()))
            return 0
        case empty:
            return 1


func builtin_cell_matchmut_call_passed(out: Stream):
