# plain `mut` local do; test/match_mut_pairs_cli_test.zig runs it.
import dicts

enum PairBox:
    empty
    full(items: dict[str, int])


func cell_store_new_store_new_none_at(out: Stream, mut b: PairBox) -> int:
    match mut b:
        case full(items):
            print(out, "  at")
            items["n1"] = 1
            items["n2"] = 2
            return 0
        case empty:
            return 1


