    _ = cell_pop_store_new_none_at(out, mut b)
    match b:
        case full(items):
            print(out, "  after", items)
        case empty:
            print(out, "  empty")


func cell_pop_store_new_between_at(out: Stream, mut b: PairBox) -> int:
    match mut b:
        case full(items):
            print(out, "  at")
            const w1 = dicts.pop(mut items, "b")
            print(out, "  w1", w1)
            print(out, "  read", items)
            items["n2"] = 2
            return 0
        case empty:
            return 1


