    mut b = PairBox.full(items={"a": 1, "b": 2, "c": 3})
    _ = cell_store_new_store_new_none_at(out, mut b)
    match b:
        case full(items):
            print(out, "  after", items)
        case empty:
            print(out, "  empty")


