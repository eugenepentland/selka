func cell_pop_pop_between(out: Stream):
    mut b = PairBox.full(items=[1, 2, 3])
    _ = cell_pop_pop_between_at(out, mut b)
    match b:
        case full(items):
            print(out, "  after", items)
        case empty:
            print(out, "  empty")


func cell_pop_pop_after_at(out: Stream, mut b: PairBox) -> int:
    match mut b:
        case full(items):
            print(out, "  at")
            const w1 = lists.pop(mut items)
            print(out, "  w1", w1)
            const w2 = lists.pop(mut items)
            print(out, "  w2", w2)
            print(out, "  read", items)
            return 0
        case empty:
            return 1


func cell_pop_pop_after(out: Stream):
    mut b = PairBox.full(items=[1, 2, 3])
    _ = cell_pop_pop_after_at(out, mut b)
    match b:
        case full(items):
            print(out, "  after", items)
        case empty:
            print(out, "  empty")


