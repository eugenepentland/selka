import lists

enum PairBox:
    empty
    full(items: int[])


func cell_assign_assign_none_at(out: Stream, mut b: PairBox) -> int:
    match mut b:
        case full(items):
            print(out, "  at")
            items[0] = 11
            items[1] = 12
            return 0
        case empty:
            return 1


