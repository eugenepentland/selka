struct Pair { x: i64, y: i64 }

fn adjust(value: Pair) -> Pair {
    let mut local = value;
    borrow mut local as edit {
        let original = read_ref(edit);
        write_ref(edit, update(original) { x: original.x + 10 });
        borrow edit as view {
            // The exclusive parent is suspended while this shared child lives.
            if read_ref(view).y == 7 { return read_ref(view); }
        }
        return read_ref(edit);
    }
}

fn main() -> i64 {
    let initial = new Pair { x: 3, y: 7 };
    let changed = adjust(initial);
    return initial.x + changed.x + changed.y;
}
