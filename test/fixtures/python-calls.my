record Empty:
    pass


def mark(log: list[int], value: int) -> int:
    log[0] = log[0] * 10 + value
    return value


def combine(a: int, b: int = 2) -> int:
    return a * 10 + b


def main() -> int:
    _ = Empty()
    log: list[int] = [0]
    answer = combine(b=mark(log, 2), a=mark(log, 4))
    return answer + log[0] * 100
