

public func test_unshared_mapping_write_preserves_live_identity() -> bool:
    mut mapping = {1: 7}
    mut view = mapping.values()
    view.mapping[1] = 9
    return list(view) == [9] and mapping[1] == 9


public func test_shared_mapping_write_replaces_only_held_edge() -> bool:
    mut mapping = {1: 7}
    mut snapshot = mapping
    mut view = mapping.values()
    view.mapping[1] = 9
    return list(view) == [9] and mapping[1] == 7 and snapshot[1] == 7


func only_view() -> DictValues[int, int]:
    mut mapping = {1: 7}
    return mapping.values()


public func test_held_only_mapping_remains_mutable() -> bool:
    mut view = only_view()
    view.mapping[1] = 9
    view.mapping[2] = 11
    return list(view) == [9, 11]


record Holder:
    view: DictValues[int, int]


public func test_nested_view_field_detaches_without_releasing_snapshot() -> bool:
    mut mapping = {1: 7}
    mut snapshot = mapping
    mut holder = Holder(mapping.values())
    holder.view.mapping.clear()
    return len(holder.view) == 0 and mapping[1] == 7 and snapshot[1] == 7


func capture_mapping(mapping: dict[int, int[]], mut saved: dict[int, int[]][]) -> int:
    saved.append(mapping)
    return 9


public func test_pending_nested_mapping_receiver_pins_snapshot_path() -> bool:
    mut mapping = {1: [7]}
    mut view = mapping.values()
    mut saved: dict[int, int[]][] = []
    view.mapping[1].append(capture_mapping(mapping, mut saved))
    return list(view) == [[7, 9]] and mapping[1] == [7, 9] and saved[0][1] == [7]


func replace_mapping(mut view: DictValues[int, int[]]) -> int:
    view.mapping = {2: [8]}
    return 9


public func test_explicit_row_snapshot_survives_view_rebinding() -> bool:
    mut mapping = {1: [7]}
    mut view = mapping.values()
    mut selected_row = view.mapping[1]
    mut value = replace_mapping(mut view)
    selected_row.append(value)
    return list(view) == [[8]] and mapping[1] == [7] and selected_row == [7, 9]


public func test_list_of_views_preserves_ordinary_mapping_snapshots() -> bool:
    mut mapping = {1: 7}
    mut snapshot = mapping
    mut views = [mapping.values()]
    views[0].mapping[1] = 9
    return list(views[0]) == [9] and mapping[1] == 7 and snapshot[1] == 7


func main() -> int:
    assert test_unshared_mapping_write_preserves_live_identity()
    assert test_shared_mapping_write_replaces_only_held_edge()
    assert test_held_only_mapping_remains_mutable()
    assert test_nested_view_field_detaches_without_releasing_snapshot()
    assert test_pending_nested_mapping_receiver_pins_snapshot_path()
    assert test_explicit_row_snapshot_survives_view_rebinding()
    assert test_list_of_views_preserves_ordinary_mapping_snapshots()
    return 0
