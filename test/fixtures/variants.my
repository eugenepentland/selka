enum Color { red, green, blue }
struct Point { x: i64, y: i64 }
union Shape { point: Point, radius: i64, empty }

fn score(shape: Shape) -> i64 {
    match shape {
        Shape.empty => { return 0; },
        Shape.radius(r) => { return r * r; },
        Shape.point(p) => { return p.x + p.y; }
    }
}

fn color_score(color: Color) -> i64 {
    match color {
        Color.red => { return 1; },
        Color.green => { return 2; },
        Color.blue => { return 3; }
    }
}

fn main() -> i64 {
    let shapes = new [3]Shape [
        new Shape.point(new Point { x: 2, y: 3 }),
        new Shape.radius(4),
        new Shape.empty
    ];
    return score(shapes[0]) + score(shapes[1]) + score(shapes[2]) + color_score(new Color.blue);
}
