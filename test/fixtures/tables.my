enum Status:
    ok,
    missing,
    failed


def response_codes() -> [Status]u16:
    return {Status.failed: 500u16, Status.ok: 200u16, Status.missing: 404u16}


def main() -> i64:
    original = response_codes()
    revised = replace(original, Status.failed, 503u16)
    return i64(original[Status.failed]) + i64(revised[Status.failed]) + i64(revised[Status.missing])
