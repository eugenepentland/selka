fn sum(values: &[]i64) -> i64 {
    let mut total = 0;
    let mut i = 0u64;
    while i < len_slice(values) {
        total += read_slice(values, i);
        i += 1u64;
    }
    return total;
}

fn increment(values: &mut []i64) -> i64 {
    let mut i = 0u64;
    while i < len_slice(values) {
        write_slice(values, i, read_slice(values, i) + 1);
        i += 1u64;
    }
    return sum(values);
}

fn main() -> i64 {
    let mut values = new [4]i64 [2, 3, 5, 7];
    let snapshot = values;
    borrow mut values[1..3] as window {
        discard increment(window);
        borrow window[0..1] as first {
            discard sum(first);
        }
    }
    return snapshot[1] + values[1] + values[2];
}
