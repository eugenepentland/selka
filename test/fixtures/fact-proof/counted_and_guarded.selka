func total(n: int) -> int:
    mut acc = 0
    for i in range(n):
        acc += i * 2
    return acc


func get(xs: int[], i: int) -> int:
    if i >= 0:
        if i < len(xs):
            return xs[i]
    return 0


func main(out: Stream) -> int:
    const xs = [1, 2, 3]
    print(out, total(10) + get(xs, 1))
    return 0
