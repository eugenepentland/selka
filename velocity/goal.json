{
  "version": "velocity-goal-v1",
  "owner": "user",
  "rule": "Agents read this file and report against it. An agent may propose a change to a weight, target or tolerance only in a commit that touches nothing else; it never edits this file as part of a language change.",
  "objective": "Fewest agent turns and least repair from a task description to a verified program, at every project size.",
  "measured_on": "2026-09-17",
  "baseline_binary": "commit 237871a6, zig-out/bin/selka",
  "budget": {
    "iterations_per_day": 24,
    "solver_runs_per_night": 35,
    "max_candidate_wall_clock_s": 7200
