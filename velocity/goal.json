  "acceptance": {
    "rule": "pareto-with-ratchet",
    "steps": [
      "every lane E gate passes",
      "no B, C or D metric is worse than baseline.json by more than its tolerance",
      "at least one metric improved beyond its noise floor, or the commit names the backlog prerequisite it completes"
    ],
    "noise_floor": {
      "latency_relative": 0.05,
      "fraction_absolute": 0.005,
      "count_absolute": 1
    },
    "on_accept": "write baseline.json, append history",
    "on_reject": "append history with numbers and reason, discard the worktree"
  },
  "normalization": {
    "log": "score = clamp(ln(baseline / value) / ln(baseline / target), 0, 1) for direction down; inverted for up",
    "linear": "score = clamp((value - baseline) / (target - baseline), 0, 1)",
    "composite": "weighted mean of lane scores; trend only, never an acceptance criterion"
  }
