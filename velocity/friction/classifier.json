{
  "version": "friction-classifier-v1",
  "note": "diagnostic code plus a source regex maps to an idiom name; the first matching row wins; no match is 'unclassified'. `hints` names the idioms the parser itself answers with a targeted message: the `declaration_hints` table in `src/parser.zig` and this array are one table, and `src/declaration_hints_test.zig` plus `tests/parser_hints.py` fail when either side gains a form the other lacks.",
  "hints": ["module-constant", "method", "from-import", "chained-assign", "exceptions", "match-literal", "del", "string-prefix", "main-guard", "option-unwrap", "walrus"],
  "rules": [
    {"code": "E_SYNTAX", "regex": "^\\s*from\\s+[A-Za-z_][A-Za-z_0-9]*(\\.[A-Za-z_][A-Za-z_0-9]*)*\\s+import\\b", "idiom": "from-import"},
    {"code": "E_SYNTAX", "regex": "^\\s*\"\"\"|^\\s*'''", "idiom": "docstring"},
    {"code": "E_BYTE_LITERAL", "regex": "\"\"\"", "idiom": "docstring"},
    {"code": "E_SYNTAX", "regex": "^[A-Z_][A-Z_0-9]*\\s*=", "idiom": "module-constant"},
    {"code": "E_SYNTAX", "regex": "def\\s+\\w+\\(self", "idiom": "method"},
    {"code": "E_FORMAT_STRING", "regex": ":\\.?\\d*[fdxs<>^]", "idiom": "format-spec"},
    {"code": "E_EXPRESSION", "regex": "\\*\\*", "idiom": "power"},
    {"code": "E_REMOVED_SPELLING", "regex": "[&|^~]|<<|>>", "idiom": "bit-operator"},
    {"code": "E_TOKEN", "regex": "[|^~]|<<|>>", "idiom": "bit-operator"},
    {"code": "E_UNKNOWN_TYPE", "regex": "\\bset\\[", "idiom": "set"},
    {"code": "E_SYNTAX", "regex": "\\bfor\\b.*\\bfor\\b", "idiom": "nested-comprehension"},
    {"code": "E_SYNTAX", "regex": "\\b(any|all|sum|min|max|sorted)\\(.*\\bfor\\b", "idiom": "generator-argument"},
    {"code": "E_COLLECTION_METHOD", "regex": "\\w+\\.\\w+\\.\\w+\\(", "idiom": "dotted-module-call"},
    {"code": "E_UNKNOWN_TYPE", "regex": "\\.(unwrap_or|is_none|is_some|splitlines)\\(", "idiom": "option-result-method"},
    {"code": "E_SYNTAX", "regex": "\\b(try|except|raise)\\b", "idiom": "exceptions"},
    {"code": "E_SYNTAX", "regex": "\\bdel\\b", "idiom": "del"},
    {"code": "E_SYNTAX", "regex": "^\\s*[A-Za-z_][A-Za-z_0-9]*\\s*=\\s*[A-Za-z_][A-Za-z_0-9]*\\s*=", "idiom": "chained-assign"},
    {"code": "E_SYNTAX", "regex": "^\\s*case\\s+[\"'\\d-]", "idiom": "match-literal"},
    {"code": "E_SYNTAX", "regex": "(?<![A-Za-z_0-9\"'])[rRuU][\"']", "idiom": "string-prefix"},
    {"code": "E_SYNTAX", "regex": "^\\s*if\\s+__name__\\s*==", "idiom": "main-guard"},
    {"code": "E_SYNTAX", "regex": "\\.unwrap\\s*\\(", "idiom": "option-unwrap"},
    {"code": "E_SYNTAX", "regex": "\\{[^{}]*:[^{}]*\\bfor\\b", "idiom": "dict-comprehension"},
    {"code": "E_SYNTAX", "regex": ":=", "idiom": "walrus"},
    {"code": "E_RESULT_UNHANDLED", "regex": ".", "idiom": "unhandled-result"},
    {"code": "E_EFFECT_BOUND", "regex": ".", "idiom": "effect-ceiling"},
    {"code": "E_ARENA_ESCAPE", "regex": ".", "idiom": "arena-escape"},
    {"code": "E_MODULE_NAME", "regex": ".", "idiom": "module-header"},
    {"code": "E_PRIVATE_SYMBOL", "regex": ".", "idiom": "missing-export"}
  ]
}
