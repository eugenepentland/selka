module python_strings


# spec: PY-STR-1
public def test_trimming_case_mapping_and_padding_copy_the_receiver_without_changing_it() -> bool:
    padded = "  value  "
    score = 0
    if padded.strip() == "value":
        score = score + 1
    if padded.lstrip() == "value  ":
        score = score + 2
    if padded.rstrip() == "  value":
        score = score + 4
    if "aB".upper() == "AB" and "aB".lower() == "ab":
        score = score + 8
    if "7".zfill(3) == "007" and "-7".zfill(3) == "-07":
        score = score + 16
    if padded == "  value  ":
        score = score + 11
    return score == 42


# spec: PY-STR-2
public def test_search_replacement_and_classification_follow_python_answers() -> bool:
    text = "a,b,a"
    score = 0
    if text.replace("a", "z") == "z,b,z":
        score = score + 1
    if text.find("b") == 2 and text.find("q") == -1:
        score = score + 2
    if text.count("a") == 2:
        score = score + 4
    if text.startswith("a,") and text.endswith(",a"):
        score = score + 8
    if "42".isdigit() and "ab".isalpha() and " \t".isspace():
        score = score + 16
    if not "".isdigit() and not "4a".isalpha():
        score = score + 11
    return score == 42


# spec: PY-STR-3
public def test_splitlines_drops_terminators_and_int_float_parse_a_whole_string() -> bool:
    lines = "a\nb\r\nc".splitlines()
    total = len(lines) * 10
    match int("12"):
        case Some(value):
            total = total + value
        case None:
            total = total - 1
    match int("12x"):
        case Some(value):
            total = total + value
        case None:
            total = total
    match float("0.5"):
        case Some(value):
            total = total + int(value * 2.0)
        case None:
            total = total - 1
    return total - 1 == 42


# `str.find` answers the first scalar index for one-scalar, multi-scalar and
# longer-than-the-receiver needles, including multi-byte scalars whose low byte
# also occurs inside another scalar (from the retired `qbe_text_test.zig`).
# spec-case: PY-STR-2
public def test_find_answers_the_first_scalar_index_for_short_long_and_overlong_needles() -> bool:
    text = "the quick brown fox"
    assert text.find("t") == 0
    assert text.find("q") == 4
    assert text.find("quick") == 4
    assert text.find("fox") == 16
    assert text.find("zebra") == -1
    assert "aaa".find("aaaa") == -1
    assert "héllo".find("é") == 1
    assert "héllo".find("llo") == 2
    assert "日本語".find("本") == 1
    assert "日本語".find("語日") == -1
    return True


def main() -> int:
    return 0
