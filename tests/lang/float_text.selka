import math
import strings

# Positive floats as "bits text": the IEEE bit pattern of the float, then Python's `repr` of it (the system's Python 3.14,
# written by a script with a fixed seed). These are the ones a person would try: 0.1, thirds, the edges of the plain range,
# the subnormals, the largest finite float, powers of two near the integer range.
