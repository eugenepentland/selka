func text_of(value: float) -> str:
    return strings.format_shortest(value)


func reads_back(text: str, value: float) -> bool:
    const parsed = parse_float(text)
    const back = parsed else:
        return False
    return math.bits(back) == math.bits(value)


# The float a vector names, from its bit pattern: it is below 2^63, so `parse_int` holds it.
func vector_value(entry: str) -> float:
    const parts = strings.split(entry, " ")
    const pattern = parse_int(parts[0]) else:
        return 0.0
    return math.from_bits(u64(pattern))


func vector_text(entry: str) -> str:
    mut parts = strings.split(entry, " ")
    return take(mut parts[1])


func vectors_print_like_python(entries: str[]) -> bool:
    for entry in entries:
        const value = vector_value(entry)
        const expected = vector_text(entry)
        if text_of(value) != expected or text_of(0.0 - value) != "-" + expected:
            return False
    return True


func vectors_read_back(entries: str[]) -> bool:
    for entry in entries:
        const value = vector_value(entry)
        if not reads_back(text_of(value), value) or not reads_back(text_of(0.0 - value), 0.0 - value):
            return False
    return True


# The text `1e<exponent>` has in the exponent form: a sign and at least two digits.
func exponent_form(exponent: int) -> str:
    mut sign = "+"
    if exponent < 0:
        sign = "-"
    return "1e" + sign + strings.zfill(str(abs(exponent)), 2)


func powers_of_ten_read_back() -> bool:
    for exponent in range(-320, 309):
        const value = parse_float(f"1e{exponent}") else:
            return False
        const text = text_of(value)
        if not reads_back(text, value):
            return False
        if -4 <= exponent < 16 and text != str(value):
            return False
        if (exponent < -4 or exponent >= 16) and text != exponent_form(exponent):
            return False
    return True


func nan_reads_back() -> bool:
    const parsed = parse_float(text_of(math.nan())) else:
        return False
    return math.is_nan(parsed)


# spec: FLOAT-TEXT-1
public func test_format_shortest_is_pythons_repr_on_the_vectors() -> bool:
    return vectors_print_like_python(vectors_chosen()) and vectors_print_like_python(vectors_random_low()) and vectors_print_like_python(vectors_random_high())


# spec-case: FLOAT-TEXT-1
public func test_format_shortest_reads_back_as_the_same_float() -> bool:
    return vectors_read_back(vectors_chosen()) and vectors_read_back(vectors_random_low()) and vectors_read_back(vectors_random_high())


# spec-case: FLOAT-TEXT-1
public func test_every_power_of_ten_from_1e_minus_320_to_1e308_reads_back() -> bool:
    return powers_of_ten_read_back()


# spec-case: FLOAT-TEXT-1
public func test_format_shortest_switches_to_an_exponent_at_1e_minus_4_and_1e16() -> bool:
    return text_of(0.0001) == "0.0001" and text_of(9.999999999999999e-05) == "9.999999999999999e-05" and text_of(1e-5) == "1e-05" and text_of(0.000012345) == "1.2345e-05" and text_of(9999999999999998.0) == "9999999999999998.0" and text_of(1e16) == "1e+16" and text_of(1.5e16) == "1.5e+16" and text_of(123456789012345678.0) == "1.2345678901234568e+17" and text_of(0.1) == "0.1" and text_of(100000.0) == "100000.0" and text_of(0.0 - 2.5) == "-2.5"


# spec-case: FLOAT-TEXT-1
public func test_format_shortest_of_the_extremes() -> bool:
    return text_of(5e-324) == "5e-324" and text_of(0.0 - 5e-324) == "-5e-324" and text_of(2.225073858507201e-308) == "2.225073858507201e-308" and text_of(2.2250738585072014e-308) == "2.2250738585072014e-308" and text_of(1.7976931348623157e308) == "1.7976931348623157e+308" and text_of(0.0 - 1.7976931348623157e308) == "-1.7976931348623157e+308"


# spec-case: FLOAT-TEXT-1
public func test_format_shortest_of_zero_infinities_and_not_a_number() -> bool:
    const negative_zero = math.from_bits(9223372036854775808u64)
    return text_of(0.0) == "0.0" and text_of(negative_zero) == "-0.0" and text_of(math.infinity()) == "inf" and text_of(0.0 - math.infinity()) == "-inf" and text_of(math.nan()) == "nan"


# spec-case: FLOAT-TEXT-1
public func test_specials_read_back_and_negative_zero_keeps_its_sign() -> bool:
    const negative_zero = math.from_bits(9223372036854775808u64)
    return reads_back(text_of(negative_zero), negative_zero) and reads_back(text_of(math.infinity()), math.infinity()) and reads_back(text_of(0.0 - math.infinity()), 0.0 - math.infinity()) and nan_reads_back()


# spec-case: FLOAT-TEXT-1
public func test_str_keeps_the_plain_digits() -> bool:
    return strings.char_count(str(1e300)) == 303 and strings.char_count(str(5e-324)) == 326 and str(1e16) == "10000000000000000.0" and f"{1e-5}" == "0.00001"
