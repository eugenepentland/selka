# Operands evaluate left to right and each operand's value is fixed when it is
# evaluated (VALUE-SEMANTICS-14): a lent read-only operand whose root a later
# operand of the same expression writes in place is copied when it is read.
# Both runtimes agree.
import operand_snapshot_helpers

record Pair:
    items: int[]
    n: int


record Holder:
    items: int[]
    tag: int


enum Slot:
    empty
    pair(value: Pair)


func lst(a: int[], b: int) -> int:
    return len(a) * 100 + b


func lst3(a: int[], b: int, c: int[]) -> int:
    return len(a) * 10000 + b * 100 + len(c)


func hold(h: Holder, b: int) -> int:
    return len(h.items) * 100 + b


func dl(d: dict[str, int], b: int) -> int:
    return len(d) * 100 + b


func sl(s: set[int], b: int) -> int:
    return len(s) * 100 + b


func push(mut xs: int[]) -> int:
    xs.append(9)
    return 1


func pushed_copy(mut xs: int[]) -> int[]:
    xs.append(9)
    return xs.copy()


func clear0(mut xs: int[]) -> int:
    xs.clear()
    return 0


func grow(mut h: Holder) -> int:
    h.items.append(9)
    return 1


func put(mut d: dict[str, int]) -> int:
    d["z"] = 1
    return 1


func add(mut s: set[int]) -> int:
    s.add(99)
    return 1


func ident(v: int) -> int:
    return v


func push_first(mut rows: int[][]) -> int:
    rows[0].append(9)
    return 1


func arr_len(a: FixedArray[int[], 2], b: int) -> int:
    return len(a[0]) * 100 + b


func arr_push(mut a: FixedArray[int[], 2]) -> int:
    a[0].append(9)
    return 1


func bb_len(b: byte_buffer, n: int) -> int:
    return len(b) * 100 + n


func bb_add(mut b: byte_buffer) -> int:
    _ = b.append_byte(7)
    return 1


func hold3(a: int, b: int, c: Holder) -> int:
    return a * 10000 + b * 100 + len(c.items)


func arr_touch(mut a: FixedArray[int[], 2]) -> int:
    a[0].append(9)
    return 0


func via_value(f: func(int[], int) -> int effects(), mut xs: int[]) -> int:
    return f(xs.copy(), push(mut xs))


func mut_param_root(mut xs: int[]) -> int:
    return lst(xs.copy(), push(mut xs))


# spec: VALUE-SEMANTICS-14
public func test_call_positional_mut() -> bool:
    mut xs = [1, 2, 3]
    mut v = lst(xs.copy(), push(mut xs))
    return v == 301 and len(xs) == 4


# spec-case: VALUE-SEMANTICS-14
public func test_call_positional_pop() -> bool:
    mut xs = [1, 2, 3]
    mut v = lst(xs.copy(), xs.pop())
    return v == 303 and len(xs) == 2


# spec-case: VALUE-SEMANTICS-14
public func test_call_positional_clear() -> bool:
    mut xs = [1, 2, 3]
    mut v = lst(xs.copy(), clear0(mut xs))
    return v == 300 and len(xs) == 0


# spec-case: VALUE-SEMANTICS-14
public func test_call_nested_later() -> bool:
    mut xs = [1, 2, 3]
    mut v = lst(xs.copy(), 1 + ident(push(mut xs)))
    return v == 302


# spec-case: VALUE-SEMANTICS-14
public func test_call_three_operands() -> bool:
    mut xs = [1, 2, 3]
    mut v = lst3(xs.copy(), push(mut xs), xs)
    return v == 30104


# spec-case: VALUE-SEMANTICS-14
public func test_call_keyword_source_order() -> bool:
    mut xs = [1, 2, 3]
    mut v = lst(a=xs.copy(), b=push(mut xs))
    return v == 301


# spec-case: VALUE-SEMANTICS-14
public func test_call_keyword_reversed() -> bool:
    mut xs = [1, 2, 3]
    mut v = lst(b=push(mut xs), a=xs)
    return v == 401


# spec-case: VALUE-SEMANTICS-14
public func test_call_module_qualified() -> bool:
    mut xs = [1, 2, 3]
    mut v = operand_snapshot_helpers.weigh(xs.copy(), push(mut xs))
    return v == 301


# spec-case: VALUE-SEMANTICS-14
public func test_call_function_value() -> bool:
    mut xs = [1, 2, 3]
    mut f = lst
    mut v = f(xs.copy(), push(mut xs))
    return v == 301


# spec-case: VALUE-SEMANTICS-14
public func test_call_function_value_param() -> bool:
    mut xs = [1, 2, 3]
    mut v = via_value(lst, mut xs)
    return v == 301


# spec-case: VALUE-SEMANTICS-14
public func test_call_mut_param_root() -> bool:
    mut xs = [1, 2, 3]
    mut v = mut_param_root(mut xs)
    return v == 301 and len(xs) == 4


# spec-case: VALUE-SEMANTICS-14
public func test_return_call() -> bool:
    mut xs = [1, 2, 3]
    return mut_param_root(mut xs) == 301


# spec-case: VALUE-SEMANTICS-14
public func test_call_borrowed_local() -> bool:
    mut xs = [1, 2, 3]
    mut ys = xs.copy()
    mut v = lst(ys, push(mut xs))
    return v == 301


# spec-case: VALUE-SEMANTICS-14
public func test_call_field_path_mut_record() -> bool:
    mut h = Holder(items=[1, 2, 3], tag=0)
    mut v = lst(h.items.copy(), grow(mut h))
    return v == 301


# spec-case: VALUE-SEMANTICS-14
public func test_call_field_path_mut_field() -> bool:
    mut h = Holder(items=[1, 2, 3], tag=0)
    mut v = lst(h.items.copy(), push(mut h.items))
    return v == 301


# spec-case: VALUE-SEMANTICS-14
public func test_call_field_path_pop() -> bool:
    mut h = Holder(items=[1, 2, 3], tag=0)
    mut v = lst(h.items.copy(), h.items.pop())
    return v == 303


# spec-case: VALUE-SEMANTICS-14
public func test_call_record_whole() -> bool:
    mut h = Holder(items=[1, 2, 3], tag=0)
    mut v = hold(h.copy(), grow(mut h))
    return v == 301


# spec-case: VALUE-SEMANTICS-14
public func test_call_record_whole_field_mut() -> bool:
    mut h = Holder(items=[1, 2, 3], tag=0)
    mut v = hold(h.copy(), push(mut h.items))
    return v == 301


# spec-case: VALUE-SEMANTICS-14
public func test_call_element() -> bool:
    mut grid = [[1, 2, 3]]
    mut v = lst(grid[0].copy(), push(mut grid[0]))
    return v == 301


# spec-case: VALUE-SEMANTICS-14
public func test_call_element_parent_mut() -> bool:
    mut grid = [[1, 2, 3]]
    mut v = lst(grid[0].copy(), push_first(mut grid))
    return v == 301


# spec-case: VALUE-SEMANTICS-14
public func test_call_dict() -> bool:
    mut d = {"a": 1}
    mut v = dl(d.copy(), put(mut d))
    return v == 101


# spec-case: VALUE-SEMANTICS-14
public func test_call_set() -> bool:
    mut s = {1, 2}
    mut v = sl(s.copy(), add(mut s))
    return v == 201


# spec-case: VALUE-SEMANTICS-14
public func test_method_index_receiver() -> bool:
    mut xs = [1, 2, 3]
    mut v = xs.copy().index(3 * clear0(mut xs) + 3)
    return v == 2


# spec-case: VALUE-SEMANTICS-14
public func test_dict_get_receiver() -> bool:
    mut d = {"a": 1}
    mut v = d.copy().get("z", put(mut d) + 40)
    return v == 41


# spec-case: VALUE-SEMANTICS-14
public func test_eq_operator() -> bool:
    mut xs = [1, 2, 3]
    return not (xs.copy() == pushed_copy(mut xs))


# spec-case: VALUE-SEMANTICS-14
public func test_ne_operator() -> bool:
    mut xs = [1, 2, 3]
    return xs.copy() != pushed_copy(mut xs)


# spec-case: VALUE-SEMANTICS-14
public func test_in_operator() -> bool:
    mut xs = [1, 2, 3]
    return not (xs.copy() in [pushed_copy(mut xs)])


# spec-case: VALUE-SEMANTICS-14
public func test_record_eq_operator() -> bool:
    mut h = Holder(items=[1, 2, 3], tag=0)
    return h.copy() == Holder(items=[1, 2, 3], tag=grow(mut h) - 1) and len(h.items) == 4


# spec-case: VALUE-SEMANTICS-14
public func test_fstring() -> bool:
    mut xs = [1, 2, 3]
    mut text = f"{xs.copy()} {push(mut xs)}"
    return text == "[1, 2, 3] 1"


# spec-case: VALUE-SEMANTICS-14
public func test_record_constructor() -> bool:
    mut xs = [1, 2, 3]
    mut p = Pair(items=xs.copy(), n=push(mut xs))
    return len(p.items) == 3


# spec-case: VALUE-SEMANTICS-14
public func test_record_constructor_keyword() -> bool:
    mut xs = [1, 2, 3]
    mut p = Pair(items=xs.copy(), n=push(mut xs))
    return len(p.items) == 3


# spec-case: VALUE-SEMANTICS-14
public func test_record_constructor_keyword_reversed() -> bool:
    mut xs = [1, 2, 3]
    mut p = Pair(n=push(mut xs), items=xs)
    return len(p.items) == 4


# spec-case: VALUE-SEMANTICS-14
public func test_union_constructor() -> bool:
    mut xs = [1, 2, 3]
    mut s = Slot.pair(value=Pair(items=xs.copy(), n=push(mut xs)))
    match s:
        case Slot.pair(value=p):
            return len(p.items) == 3
        case Slot.empty:
            return False


# spec-case: VALUE-SEMANTICS-14
public func test_record_update() -> bool:
    mut h = Holder(items=[1, 2, 3], tag=0)
    mut r = replace(h.copy(), tag=grow(mut h))
    return len(r.items) == 3 and r.tag == 1


# spec-case: VALUE-SEMANTICS-14
public func test_list_literal() -> bool:
    mut xs = [1, 2, 3]
    mut rows = [xs.copy(), pushed_copy(mut xs)]
    return len(rows[0]) == 3 and len(rows[1]) == 4


# spec-case: VALUE-SEMANTICS-14
public func test_dict_literal() -> bool:
    mut xs = [1, 2, 3]
    mut d = {"a": xs.copy(), "b": pushed_copy(mut xs)}
    return len(d["a"]) == 3


# spec-case: VALUE-SEMANTICS-14
public func test_subscript_receiver() -> bool:
    mut xs = [1, 2, 3]
    mut v = xs.copy()[clear0(mut xs)]
    return v == 1


# spec-case: VALUE-SEMANTICS-14
public func test_subscript_field_receiver() -> bool:
    mut h = Holder(items=[1, 2, 3], tag=0)
    mut v = h.items.copy()[clear0(mut h.items)]
    return v == 1


# spec-case: VALUE-SEMANTICS-14
public func test_subscript_lent_into_call() -> bool:
    mut grid = [[1, 2, 3]]
    mut v = lst(grid[0].copy(), clear0(mut grid[0]))
    return v == 300


# spec-case: VALUE-SEMANTICS-14
public func test_zip_sources() -> bool:
    mut xs = [1, 2, 3]
    mut count = 0
    for a, b in zip(xs.copy(), pushed_copy(mut xs)):
        count += a + b - a - b + 1
    return count == 3


# spec-case: VALUE-SEMANTICS-14
public func test_conditional_operand() -> bool:
    mut xs = [1, 2, 3]
    mut ys = [5]
    mut flag = len(ys) == 1
    mut v = lst(if (flag) then (xs.copy()) else (ys.copy()), push(mut xs))
    return v == 301


# spec-case: VALUE-SEMANTICS-14
public func test_call_nested_consumer() -> bool:
    mut xs = [1, 2, 3]
    mut v = lst(xs.copy(), lst(xs.copy(), push(mut xs)))
    return v == 601 and len(xs) == 4


# spec-case: VALUE-SEMANTICS-14
public func test_call_in_comprehension() -> bool:
    mut xs = [1, 2, 3]
    mut vs = [for _ in range(2) yield lst(xs.copy(), push(mut xs))]
    return vs[0] == 301 and vs[1] == 401


# spec-case: VALUE-SEMANTICS-14
public func test_call_in_loop() -> bool:
    mut xs = [1, 2, 3]
    mut total = 0
    for _ in range(3):
        total += lst(xs.copy(), push(mut xs))
    return total == 1203


# spec-case: VALUE-SEMANTICS-14
public func test_call_fixed_array_of_lists() -> bool:
    mut arr: FixedArray[int[], 2] = FixedArray[int[], 2]([[1], [2]])
    mut v = arr_len(arr.copy(), arr_push(mut arr))
    return v == 101 and len(arr[0]) == 2


# spec-case: VALUE-SEMANTICS-14
public func test_call_byte_buffer() -> bool:
    mut b = byte_buffer([1])
    mut v = bb_len(b.copy(), bb_add(mut b))
    return v == 101 and len(b) == 2


# spec-case: VALUE-SEMANTICS-14
public func test_method_path_receiver() -> bool:
    mut h = Holder(items=[1, 2, 3], tag=0)
    mut v = h.items.copy().index(3 * clear0(mut h.items) + 3)
    return v == 2 and len(h.items) == 0


# spec-case: VALUE-SEMANTICS-14
public func test_call_keyword_run_list() -> bool:
    mut xs = [1, 2, 3]
    mut ys = [1]
    mut v = lst3(c=xs.copy(), a=ys, b=push(mut xs))
    return v == 10103


# spec-case: VALUE-SEMANTICS-14
public func test_call_keyword_run_record() -> bool:
    mut h = Holder(items=[1, 2, 3], tag=0)
    mut v = hold3(c=h.copy(), a=1, b=grow(mut h))
    return v == 10103 and len(h.items) == 4


# spec-case: VALUE-SEMANTICS-14
public func test_fixed_array_index_base() -> bool:
    mut arr: FixedArray[int[], 2] = FixedArray[int[], 2]([[1], [2]])
    const before = arr.copy()
    const index = arr_touch(mut arr)
    mut v = len(before[index])
    return v == 1 and len(arr[0]) == 2


func first[T](a: T[], b: int) -> int:
    return len(a) * 100 + b


# spec-case: VALUE-SEMANTICS-14
public func test_generic_call() -> bool:
    mut xs = [1, 2, 3]
    mut v = first(xs.copy(), push(mut xs))
    return v == 301


# spec-case: VALUE-SEMANTICS-14
public func test_builtin_in_later_operand() -> bool:
    mut xs = [3, 1, 2]
    mut v = lst(xs.copy(), len(sorted(pushed_copy(mut xs))))
    return v == 304


# spec: PRELUDE-EXTREME-2
public func test_max_of_two_evaluates_each_argument_once() -> bool:
    mut xs = [1, 2, 3]
    mut v = max(len(xs), push(mut xs) + len(xs))
    return v == 5 and len(xs) == 4


# spec-case: PRELUDE-EXTREME-2
public func test_min_of_two_evaluates_each_argument_once() -> bool:
    mut xs = [1, 2, 3]
    mut v = min(10, push(mut xs) + len(xs))
    return v == 5 and len(xs) == 4


func bump_first(mut value: dict[str, FixedArray[int[], 1]]) -> int:
    value["k"][0].append(7)
    return 0


# spec-case: VALUE-SEMANTICS-14
public func test_a_write_through_a_fixed_array_read_keeps_the_pending_place() -> bool:
    mut original: dict[str, FixedArray[int[], 1]] = {"k": FixedArray[int[], 1]([[1]])}
    mut changed = original.copy()
    mut mutation_result_528 = bump_first(mut changed)
    changed["k"][mutation_result_528].append(2)
    return original["k"][0] == [1] and changed["k"][0] == [1, 7, 2]
