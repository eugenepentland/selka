func mkodd(i: int) -> Odd:
    return Odd(f0=i + 0, f1=i + 3, f2=i + 6, f3=i + 9, f4=i + 12, f5=i + 15, f6=i + 18, f7=i + 21, f8=i + 24, f9=i + 27, f10=i + 30, f11=i + 33, f12=i + 36, f13=i + 39, f14=i + 42, f15=i + 45, f16=i + 48, f17=i + 51, f18=i + 54, f19=i + 57, f20=i + 60, f21=i + 63, f22=i + 66, f23=i + 69, f24=i + 72, f25=i + 75, f26=i + 78, f27=i + 81, f28=i + 84, f29=i + 87, f30=i + 90, f31=i + 93, f32=i + 96, f33=i + 99, f34=i + 102, f35=i + 105, f36=i + 108, f37=i + 111, f38=i + 114, f39=i + 117, f40=i + 120, f41=i + 123, f42=i + 126, f43=i + 129, f44=i + 132, f45=i + 135, f46=i + 138, f47=i + 141, f48=i + 144, f49=i + 147, f50=i + 150, f51=i + 153, f52=i + 156, f53=i + 159, f54=i + 162, f55=i + 165, f56=i + 168, f57=i + 171, f58=i + 174, f59=i + 177, f60=i + 180, f61=i + 183, f62=i + 186, f63=i + 189, f64=i + 192)


func sumodd(o: Odd) -> int:
    return o.f0 * 2 + o.f1 * 3 + o.f2 * 4 + o.f3 * 5 + o.f4 * 6 + o.f5 * 7 + o.f6 * 8 + o.f7 * 9 + o.f8 * 10 + o.f9 * 11 + o.f10 * 12 + o.f11 * 13 + o.f12 * 14 + o.f13 * 15 + o.f14 * 16 + o.f15 * 17 + o.f16 * 18 + o.f17 * 19 + o.f18 * 20 + o.f19 * 21 + o.f20 * 22 + o.f21 * 23 + o.f22 * 24 + o.f23 * 25 + o.f24 * 26 + o.f25 * 27 + o.f26 * 28 + o.f27 * 29 + o.f28 * 30 + o.f29 * 31 + o.f30 * 32 + o.f31 * 33 + o.f32 * 34 + o.f33 * 35 + o.f34 * 36 + o.f35 * 37 + o.f36 * 38 + o.f37 * 39 + o.f38 * 40 + o.f39 * 41 + o.f40 * 42 + o.f41 * 43 + o.f42 * 44 + o.f43 * 45 + o.f44 * 46 + o.f45 * 47 + o.f46 * 48 + o.f47 * 49 + o.f48 * 50 + o.f49 * 51 + o.f50 * 52 + o.f51 * 53 + o.f52 * 54 + o.f53 * 55 + o.f54 * 56 + o.f55 * 57 + o.f56 * 58 + o.f57 * 59 + o.f58 * 60 + o.f59 * 61 + o.f60 * 62 + o.f61 * 63 + o.f62 * 64 + o.f63 * 65 + o.f64 * 66


record Holder2:
    h: Holder
    k: int


func mkh2(i: int) -> Holder2:
    return Holder2(h=mkh(i), k=i * 2)


func b_task_temp(n: int) -> int:
    mut acc = 0
    acc += sumb(mk(n + 2100))
    acc += sumb(mk(n + 2101))
    acc += sumb(mk(n + 2102))
    acc += sumb(mk(n + 2103))
    acc += sumb(mk(n + 2104))
    acc += sumb(mk(n + 2105))
    acc += sumb(mk(n + 2106))
    acc += sumb(mk(n + 2107))
    with parallel.group() as g:
        const t1 = g.submit(task_sum, mk(n))
        const t2 = g.submit(task_sum, bump(mk(n + 1), 3))
        acc += sumb(mk(n + 2200))
        acc += sumb(mk(n + 2201))
        acc += sumb(mk(n + 2202))
        acc += sumb(mk(n + 2203))
        acc += sumb(mk(n + 2204))
        acc += sumb(mk(n + 2205))
        acc += sumb(mk(n + 2206))
        acc += sumb(mk(n + 2207))
        acc += t1.result() * 3 + t2.result() * 5
    return acc


func b_swap(n: int) -> int:
    mut acc = 0
    mut a = mk(n)
    mut b = mk(n + 1)
    acc += sumb(mk(n + 2300))
    acc += sumb(mk(n + 2301))
    acc += sumb(mk(n + 2302))
    acc += sumb(mk(n + 2303))
    acc += sumb(mk(n + 2304))
    acc += sumb(mk(n + 2305))
    acc += sumb(mk(n + 2306))
    acc += sumb(mk(n + 2307))
    for i in range(5):
        const t = a
        a = bump(b, i)
        b = t
        acc += sumb(mk(i)) + sumb(a) * 2
    acc += sumb(a) * 3 + sumb(b) * 5
    return acc


func b_inside_only(n: int) -> int:
    mut acc = 0
    const pre = mk(n)
    const pre2 = mkodd(n)
    acc += sumb(mk(n + 2400))
    acc += sumb(mk(n + 2401))
    acc += sumb(mk(n + 2402))
    acc += sumb(mk(n + 2403))
    acc += sumb(mk(n + 2404))
    acc += sumb(mk(n + 2405))
    acc += sumb(mk(n + 2406))
    acc += sumb(mk(n + 2407))
    mut i = 0
    while i < 5:
        acc += sumb(pre) * (i + 1) + sumodd(pre2)
        const x = mk(n + i * 11)
        const y = bump(x, i)
        const o = mkodd(i)
        acc += sumb(y) + sumodd(o)
        if i == 3:
            const z = mk(i)
            acc += sumb(z)
            i += 1
            continue
        i += 1
    return acc


func b_nested_view(n: int) -> int:
    mut acc = 0
    const v = mkh2(n).h.inner
    acc += sumb(mk(n + 2500))
    acc += sumb(mk(n + 2501))
    acc += sumb(mk(n + 2502))
    acc += sumb(mk(n + 2503))
    acc += sumb(mk(n + 2504))
    acc += sumb(mk(n + 2505))
    acc += sumb(mk(n + 2506))
    acc += sumb(mk(n + 2507))
    const w = mkh2(n + 1)
    const v2 = w.h.inner
    acc += sumb(mk(n + 2600))
    acc += sumb(mk(n + 2601))
    acc += sumb(mk(n + 2602))
    acc += sumb(mk(n + 2603))
    acc += sumb(v) * 3 + sumb(v2) * 5 + w.k
    return acc


func b_join_keep(n: int, c: bool) -> int:
    mut acc = 0
    const x0 = mk(n)
    mut x = x0
    acc += sumb(mk(n + 2700))
    acc += sumb(mk(n + 2701))
    acc += sumb(mk(n + 2702))
    acc += sumb(mk(n + 2703))
    if c:
        acc += sumb(mk(n + 1))
        x = mk(n + 2)
    const after = mk(n + 3)
    acc += sumb(mk(n + 2800))
    acc += sumb(mk(n + 2801))
    acc += sumb(mk(n + 2802))
    acc += sumb(mk(n + 2803))
    acc += sumb(x) * 3 + sumb(x0) * 5 + sumb(after) * 7
    return acc


func b_mixed(n: int) -> int:
    mut acc = 0
    const s0 = shape_of(n, 0)
    const o0 = mkodd(n)
    acc += sumb(mk(n + 2900))
    acc += sumb(mk(n + 2901))
    acc += sumb(mk(n + 2902))
    acc += sumb(mk(n + 2903))
    const s1 = shape_of(n, 1)
    const o1 = mkodd(n + 1)
    for i in range(4):
        const s = shape_of(n, i)
        const o = mkodd(n + i)
        match s:
            case wide(b):
                acc += sumb(b) + sumodd(o)
            case tall(t):
                acc += sumt(t) + sumodd(o) * 2
            case flat(n=m):
                acc += m + sumodd(o) * 3
    match s0:
        case wide(b):
            acc += sumb(b) * 11
        case tall(t):
            acc += sumt(t) * 13
        case flat(n=m):
            acc += m * 17
    match s1:
        case wide(b):
            acc += sumb(b) * 19
        case tall(t):
            acc += sumt(t) * 23
        case flat(n=m):
            acc += m * 29
    acc += sumodd(o0) * 31 + sumodd(o1) * 37
    return acc


func b_break(n: int) -> int:
    mut acc = 0
    const keepme = mk(n)
    mut last = mk(n + 1)
    acc += sumb(mk(n + 3000))
    acc += sumb(mk(n + 3001))
    acc += sumb(mk(n + 3002))
    acc += sumb(mk(n + 3003))
    acc += sumb(mk(n + 3004))
    acc += sumb(mk(n + 3005))
    acc += sumb(mk(n + 3006))
    acc += sumb(mk(n + 3007))
    for i in range(10):
        const v = mk(n + i)
        if i == 6:
            last = v
            break
        const w = bump(v, i)
        acc += sumb(w)
    acc += sumb(keepme) * 3 + sumb(last) * 5
    return acc


func check_t(i: int) -> int fails Oops:
    if i % 4 == 3:
        fail mko(i)
    return i


func c_text_fail(n: int) -> int fails Oops:
    mut acc = 0
    const a = mkt(n)
    acc += sumt(mkt(n + 3100))
    acc += sumt(mkt(n + 3101))
    acc += sumt(mkt(n + 3102))
    acc += sumt(mkt(n + 3103))
    acc += sumt(mkt(n + 3104))
    acc += sumt(mkt(n + 3105))
    acc += sumt(mkt(n + 3106))
    acc += sumt(mkt(n + 3107))
    const b = mkt(n + 1)
    acc += sumt(a)
    const c = mkt(n + 2)
    acc += try check_t(n)
    const d = mkt(n + 3)
    acc += sumt(b) + sumt(c) * 2
    acc += try check_t(n + 1)
    acc += sumt(mkt(n + 3200))
    acc += sumt(mkt(n + 3201))
    acc += sumt(mkt(n + 3202))
    acc += sumt(mkt(n + 3203))
    acc += sumt(d) * 3
    return acc


func c_text_loop(n: int) -> int:
    mut acc = 0
    const keepme = mkt(n)
    mut carry = mkt(n + 1)
    acc += sumt(mkt(n + 3300))
    acc += sumt(mkt(n + 3301))
    acc += sumt(mkt(n + 3302))
    acc += sumt(mkt(n + 3303))
    acc += sumt(mkt(n + 3304))
    acc += sumt(mkt(n + 3305))
    acc += sumt(mkt(n + 3306))
    acc += sumt(mkt(n + 3307))
    for i in range(6):
        const t = mkt(n + i)
        match c_text_fail(n + i):
            case Ok(v):
                acc += v + sumt(t)
                carry = keep(own carry)
            case Err(e):
                acc += sumo(e) + sumt(t) * 2
                carry = mkt(i)
    acc += sumt(keepme) * 3 + sumt(carry) * 5
    return acc


func c_text_return(n: int, k: int) -> Tagged:
    mut acc = 0
    const a = mkt(n)
    const b = mkt(n + 1)
    acc += sumt(mkt(n + 3400))
    acc += sumt(mkt(n + 3401))
    acc += sumt(mkt(n + 3402))
    acc += sumt(mkt(n + 3403))
    acc += sumt(mkt(n + 3404))
    acc += sumt(mkt(n + 3405))
    acc += sumt(mkt(n + 3406))
    acc += sumt(mkt(n + 3407))
    if k == 0:
        return a
    if k == 1:
        return b
    const c = mkt(n + 2)
    if k == 2:
        return keep(own c)
    return mkt(acc % 1000)


public func test_a_value_made_before_a_loop_survives_the_values_made_inside_it() -> bool:
    return a_loop(3) == 128833120 and b_inside_only(5) == 1747861830 and b_break(9) == 2172813760


public func test_values_live_across_both_arms_of_an_if_and_a_match_survive() -> bool:
    if a_if(4, True) != 169936000 or a_if(5, False) != 172729440:
        return False
    if b_join_keep(7, True) != 1988380160 or b_join_keep(7, False) != 1987040640:
        return False
    return a_match(6, 0) == 237887520 and a_match(6, 1) == 237433225 and a_match(6, 2) == 234536640


public func test_a_call_result_survives_later_results_of_its_size() -> bool:
    return a_later(7) == 310086400 and b_swap(4) == 1662308960 and b_mixed(8) == 1076825986


public func test_borrowed_results_and_field_views_survive_later_calls() -> bool:
    return a_from(8) == 371198835 and a_view(9) == 443838899 and b_nested_view(6) == 2734944174


public func test_mut_arguments_own_moves_and_task_arguments_keep_their_slots() -> bool:
    return a_mut(10) == 549951802 and a_own(11) == 692322082 and a_task(12) == 810736160 and b_task_temp(3) == 3090821760


public func test_failing_calls_in_loops_keep_values_and_errors_apart() -> bool:
    mut total = 0
    for i in range(8):
        match c_text_fail(i):
            case Ok(v):
                total += v
            case Err(e):
                total += sumo(e) * 7
    return a_try(13) == 1851279150 and total == 303719998 and c_text_loop(5) == 280472481


public func test_returned_values_and_recursion_through_two_functions_keep_their_slots() -> bool:
    if sumt(c_text_return(1, 0)) != 83375 or sumt(c_text_return(2, 1)) != 87281:
        return False
    if sumt(c_text_return(3, 2)) != 91187 or sumt(c_text_return(4, 3)) != 388090:
        return False
    return sumb(ping(9)) == 178880
