import byte_builder
import hex
import http
import strings

# The HTTP codec reads its header section as octets. These cases pin its observable behavior:
# every `expected` text was produced by the line-by-line text implementation this scanner
# replaced, including the order in which a message's problems are reported.
record Case:
    wire: bytes
    expected: str


record WriteCase:
    a: str
    b: str
    c: str
    status: int
    names: str[]
    values: str[]
    body: bytes
    expected: str


func fmt_str(text: str) -> str:
    return str(strings.char_count(text)) + ":" + text


func fmt_error(error: http.Error) -> str:
    match error:
        case Incomplete:
            return "Incomplete"
        case Malformed(value=detail):
            return "Malformed:" + fmt_str(detail)
        case Unsupported(value=detail):
            return "Unsupported:" + fmt_str(detail)
        case HeaderTooLarge(value=detail):
            return "HeaderTooLarge:" + fmt_str(detail)
        case BodyTooLarge(value=detail):
            return "BodyTooLarge:" + fmt_str(detail)
        case UnsupportedVersion(value=detail):
            return "UnsupportedVersion:" + fmt_str(detail)


func fmt_fields(fields: http.Header[]) -> str:
    mut out = ""
    for item in fields:
        out = out + "[" + fmt_str(item.name) + "=" + fmt_str(item.value) + "]"
    return out


func request_text(data: bytes) -> str:
    match http.parse_request(data):
        case Ok(parsed):
            return "OK " + fmt_str(parsed.method) + fmt_str(parsed.target) + fmt_str(parsed.version) + fmt_fields(parsed.headers) + "body=" + hex.encode(parsed.body)
        case Err(error):
            return "ERR " + fmt_error(error)


func response_text(data: bytes, closed: bool) -> str:
    match http.parse_response(data, closed):
        case Ok(parsed):
            return "OK " + fmt_str(parsed.version) + str(parsed.status) + fmt_str(parsed.reason) + fmt_fields(parsed.headers) + "body=" + hex.encode(parsed.body)
        case Err(error):
            return "ERR " + fmt_error(error)


func probe_names() -> str[]:
    return ["z9", "Z9", "x_1", "X_1", "az", "AZ", "host", "HOST", "Host", "Content-Length", "content-length", "transfer-encoding", "Transfer-Encoding", "X-Empty", "x-empty", "A", "a", "", "héllo", "HÉLLO", "connection", "Connection", "user-agent", "hos", "hosts", "café"]


# Both lookups of every probe name over a parsed request's fields, then the derived text accessors.
func lookup_text(data: bytes) -> str:
    match http.parse_request(data):
        case Ok(parsed):
            mut out = ""
            for name in probe_names():
                match http.header(parsed.headers, name):
                    case Some(value):
                        out = out + "H" + fmt_str(value)
                    case None:
                        out = out + "H-"
                out = out + "L"
                for value in http.headers(parsed.headers, name):
                    out = out + fmt_str(value)
            return out + "|" + http.method(parsed) + "|" + http.path(parsed) + "|" + http.query(parsed) + "|" + http.target(parsed)
        case Err(_):
            return "-"


func fields_of(names: str[], values: str[]) -> http.Header[]:
    mut fields: http.Header[] = []
    mut index = 0
    while index < len(names):
        append(mut fields, http.Header(name=copy(names[index]), value=copy(values[index])))
        index += 1
    return fields


func request_wire_text(item: WriteCase) -> str:
    mut built = http.Request(method=copy(item.a), target=copy(item.b), version=copy(item.c), headers=fields_of(item.names, item.values), body=copy(item.body))
    match http.write_request(built):
        case Ok(wire):
            return "OK " + hex.encode(wire)
        case Err(error):
            return "ERR " + fmt_error(error)


func response_wire_text(item: WriteCase) -> str:
    mut made = http.Response(version=copy(item.a), status=item.status, reason=copy(item.b), headers=fields_of(item.names, item.values), body=copy(item.body))
    match http.write_response(made):
        case Ok(wire):
            return "OK " + hex.encode(wire)
        case Err(error):
            return "ERR " + fmt_error(error)


func many_fields(first: bytes, count: int, last: bytes) -> bytes:
    mut out = byte_builder.create()
    byte_builder.append(mut out, first)
    for index in range(count):
        byte_builder.append(mut out, b"\r\nH")
        byte_builder.append_int(mut out, index)
        byte_builder.append(mut out, b": v")
    byte_builder.append(mut out, last)
    return byte_builder.finish(out)


func big_head(first: bytes, size: int) -> bytes:
    return first + byte_builder.repeat(b"y", size) + b"\r\n\r\n"


func request_cases() -> Case[]:
    return [Case(wire=b"GET / HTTP/1.1\r\nH0: v0\r\n\r\n", expected="OK 3:GET1:/8:HTTP/1.1[2:H0=2:v0]body="), Case(wire=b"GET / HTTP/1.1\r\nHost: example.test\r\n\r\n", expected="OK 3:GET1:/8:HTTP/1.1[4:Host=12:example.test]body="), Case(wire=b"GET /hello?x=1 HTTP/1.1\r\nHost: example.test\r\nContent-Length: 5\r\n\r\nhello", expected="OK 3:GET10:/hello?x=18:HTTP/1.1[4:Host=12:example.test][14:Content-Length=1:5]body=68656c6c6f"), Case(wire=b"POST /kv/a HTTP/1.1\r\nHost: h\r\nContent-Length: 3\r\nContent-Type: application/json\r\n\r\n[1]", expected="OK 4:POST5:/kv/a8:HTTP/1.1[4:Host=1:h][14:Content-Length=1:3][12:Content-Type=16:application/json]body=5b315d"), Case(wire=b"PUT /kv/key HTTP/1.0\r\nhost:   spaced value \t \r\nX-Empty:\r\nConnection: keep-alive\r\n\r\nbody bytes", expected="OK 3:PUT7:/kv/key8:HTTP/1.0[4:host=12:spaced value][7:X-Empty=0:][10:Connection=10:keep-alive]body="), Case(wire=b"GET http://example.test/a/b?c=d#frag HTTP/1.1\r\nHOST: example.test\r\nUser-Agent: Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36\r\nAccept: */*\r\nAccept-Encoding: gzip, deflate\r\nCookie: a=b; c=d\r\n\r\n", expected="ERR Malformed:34:request target contains a fragment"), Case(wire=b"DELETE /x HTTP/1.1\r\nHost: a\r\nHost: b\r\nTransfer-Encoding: chunked\r\n\r\n", expected="ERR Unsupported:40:chunked request bodies are not supported"), Case(wire=b"GET /\xc3\xa9t\xc3\xa9 HTTP/1.1\r\nHost: caf\xc3\xa9.test\r\nX-Note: na\xc3\xafve \xc2\xa0 value\xc2\xa0\r\n\r\n", expected="OK 3:GET4:/été8:HTTP/1.1[4:Host=9:café.test][6:X-Note=14:naïve   value ]body="), Case(wire=b"BREW /pot HTTP/1.1\r\nHost: a\r\nContent-Length: 0\r\nContent-Length: 0\r\n\r\n", expected="OK 4:BREW4:/pot8:HTTP/1.1[4:Host=1:a][14:Content-Length=1:0][14:Content-Length=1:0]body="), Case(wire=b"GET / HTTP/1.1\r\nContent-Length: 4\r\nCONTENT-LENGTH: 4\r\nHost: x\r\n\r\nabcdEXTRA", expected="OK 3:GET1:/8:HTTP/1.1[14:Content-Length=1:4][14:CONTENT-LENGTH=1:4][4:Host=1:x]body=61626364"), Case(wire=b"GET / HTTP/2.