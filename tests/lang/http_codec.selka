    return [WriteCase(a="HTTP/1.1", b="OK", c="", status=200, names=["Content-Type"], values=["text/plain"], body=b"ok", expected="OK 485454502f312e3120323030204f4b0d0a436f6e74656e742d547970653a20746578742f706c61696e0d0a436f6e74656e742d4c656e6774683a20320d0a0d0a6f6b"), WriteCase(a="HTTP/1.1", b="", c="", status=204, names=[], values=[], body=b"", expected="OK 485454502f312e31203230340d0a0d0a"), WriteCase(a="HTTP/1.1", b="Not Found", c="", status=404, names=["Content-Length"], values=["3"], body=b"abc", expected="OK 485454502f312e3120343034204e6f7420466f756e640d0a436f6e74656e742d4c656e6774683a20330d0a0d0a616263"), WriteCase(a="HTTP/1.1", b="Not Found", c="", status=404, names=["Content-Length"], values=["4"], body=b"abc", expected="ERR Malformed:47:Content-Length does not match the response body"), WriteCase(a="HTTP/1.1", b="OK", c="", status=200, names=["content-length"], values=["-1"], body=b"", expected="ERR Malformed:26:Content-Length is negative"), WriteCase(a="HTTP/1.1", b="OK", c="", status=200, names=["Content-Length", "content-length"], values=["3", "4"], body=b"abc", expected="ERR Malformed:33:conflicting Content-Length values"), WriteCase(a="HTTP/1.0", b="OK", c="", status=200, names=["Server", "Date"], values=["x", "d"], body=b"body", expected="OK 485454502f312e3020323030204f4b0d0a5365727665723a20780d0a446174653a20640d0a436f6e74656e742d4c656e6774683a20340d0a0d0a626f6479"), WriteCase(a="HTTP/2.0", b="OK", c="", status=200, names=[], values=[], body=b"", expected="ERR UnsupportedVersion:40:only HTTP/1.0 and HTTP/1.1 are supported"), WriteCase(a="HTTP/1.1", b="Low", c="", status=99, names=[], values=[], body=b"", expected="ERR Malformed:31:status code is outside 100..999"), WriteCase(a="HTTP/1.1", b="High", c="", status=1000, names=[], values=[], body=b"", expected="ERR Malformed:31:status code is outside 100..999"), WriteCase(a="HTTP/1.1", b="R\x01", c="", status=200, names=[], values=[], body=b"", expected="ERR Malformed:43:status reason contains an invalid character"), WriteCase(a="HTTP/1.1", b="café", c="", status=200, names=["X"], values=["é"], body=b"", expected="OK 485454502f312e312032303020636166c3a90d0a583a20c3a90d0a436f6e74656e742d4c656e6774683a20300d0a0d0a"), WriteCase(a="HTTP/1.1", b="a\tb", c="", status=200, names=[], values=[], body=b"", expected="OK 485454502f312e3120323030206109620d0a436f6e74656e742d4c656e6774683a20300d0a0d0a"), WriteCase(a="HTTP/1.1", b="line\nbreak", c="", status=200, names=[], values=[], body=b"", expected="ERR Malformed:43:status reason contains an invalid character"), WriteCase(a="HTTP/1.1", b="OK", c="", status=200, names=["Bad Name"], values=["v"], body=b"", expected="ERR Malformed:41:header name contains an invalid character"), WriteCase(a="HTTP/1.1", b="OK", c="", status=200, names=["X"], values=["v\x7f"], body=b"", expected="ERR Malformed:42:header value contains an invalid character"), WriteCase(a="HTTP/1.1", b="R\x01", c="", status=200, names=["Bad Name"], values=["v"], body=b"abc", expected="ERR Malformed:43:status reason contains an invalid character"), WriteCase(a="HTTP/1.1", b="Moved", c="", status=301, names=["Location", "Connection"], values=["/dir/", "close"], body=b"", expected="OK 485454502f312e3120333031204d6f7665640d0a4c6f636174696f6e3a202f6469722f0d0a436f6e6e656374696f6e3a20636c6f73650d0a436f6e74656e742d4c656e6774683a20300d0a0d0a")]


# Requests, parsed or refused, come out exactly as the reference implementation produced them.
# spec: STANDARD-HTTP-2
public func test_requests_parse_and_refuse_as_the_reference_codec_did() -> bool:
    for item in request_cases():
        if request_text(item.wire) != item.expected:
            return False
    return True


# Responses likewise, with the peer still open and with the connection already closed.
# spec-case: STANDARD-HTTP-2
public func test_responses_parse_and_refuse_as_the_reference_codec_did() -> bool:
    for item in response_cases_open():
        if response_text(item.wire, False) != item.expected:
            return False
    for item in response_cases_closed():
        if response_text(item.wire, True) != item.expected:
            return False
    return True


# Case-insensitive lookup, repeated fields and the derived accessors answer as before.
# spec-case: STANDARD-HTTP-2
public func test_header_lookup_is_case_insensitive_as_before() -> bool:
    for item in lookup_cases():
        if lookup_text(item.wire) != item.expected:
            return False
    return True


# Serialization validates names, values, reasons and Content-Length in the same order.
# spec-case: STANDARD-HTTP-2
public func test_serialization_validates_and_renders_as_before() -> bool:
    for item in request_writes():
        if request_wire_text(item) != item.expected:
            return False
    for item in response_writes():
        if response_wire_text(item) != item.expected:
            return False
    return True


# 100 header fields are accepted and a 101st is refused; a header section of exactly 65,536 octets
# is accepted and one more is refused (the status line of a response is one octet longer than the
# request line used here, so its largest field is one octet shorter).
# spec-case: STANDARD-HTTP-2
public func test_field_count_and_section_size_limits_hold() -> bool:
    if not strings.starts_with(request_text(many_fields(b"GET / HTTP/1.1", 99, b"\r\n\r\n")), "OK"):
        return False
    if not strings.starts_with(request_text(many_fields(b"GET / HTTP/1.1", 100, b"\r\n\r\n")), "OK"):
        return False
    if request_text(many_fields(b"GET / HTTP/1.1", 101, b"\r\n\r\n")) != "ERR HeaderTooLarge:22:too many header fields":
        return False
    if response_text(many_fields(b"HTTP/1.1 200 OK", 100, b"\r\nContent-Length: 0\r\n\r\n"), False) != "ERR HeaderTooLarge:22:too many header fields":
        return False
    if not strings.starts_with(request_text(big_head(b"GET / HTTP/1.1\r\nX: ", 65517)), "OK"):
        return False
    if request_text(big_head(b"GET / HTTP/1.1\r\nX: ", 65518)) != "ERR HeaderTooLarge:27:header section is too large":
        return False
    return response_text(big_head(b"HTTP/1.1 200 OK\r\nX: ", 65517), True) == "ERR HeaderTooLarge:27:header section is too large"


# A name, a value, a target or a method with one ASCII octet in it is accepted exactly when the octet
# belongs to the alphabet that field allows (RFC 9110 token characters, visible characters and
# horizontal tab, no `#` in a target, and so on); only a space and a horizontal tab are trimmed at the
# ends of a value, so a control octet there is refused like one inside it (lane FR13, F-63).
# spec-case: STANDARD-HTTP-2
public func test_every_ascii_octet_is_classified_per_field() -> bool:
    mut tokens = b"!#$%&'*+-.^_`|~0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
    for octet in range(128):
        mut one = byte_builder.create()
        _ = byte_builder.append_byte(mut one, octet)
        mut single = byte_builder.finish(one)
        mut in_tokens = octet in tokens
        mut in_name = in_tokens or octet == 58
        mut in_value = octet == 9 or (32 <= octet <= 126)
        mut at_edge = octet == 9 or (32 <= octet <= 126)
        mut in_target = octet > 32 and octet != 127 and octet != 35
        if strings.starts_with(request_text(b"GET / HTTP/1.1\r\nX" + single + b"Y: v\r\n\r\n"), "OK") != in_name:
            return False
        if strings.starts_with(request_text(b"GET / HTTP/1.1\r\nX: a" + single + b"b\r\n\r\n"), "OK") != in_value:
            return False
        if strings.starts_with(request_text(b"GET / HTTP/1.1\r\nX:" + single + b"b\r\n\r\n"), "OK") != at_edge:
            return False
        if strings.starts_with(request_text(b"GET / HTTP/1.1\r\nX: a" + single + b"\r\n\r\n"), "OK") != at_edge:
            return False
        if strings.starts_with(request_text(b"GET /a" + single + b"b HTTP/1.1\r\n\r\n"), "OK") != in_target:
            return False
        if strings.starts_with(request_text(single + b"ET / HTTP/1.1\r\n\r\n"), "OK") != in_tokens:
            return False
        if strings.starts_with(response_text(b"HTTP/1.1 200 R" + single + b"\r\n\r\n", True), "OK") != at_edge:
            return False
    return True


# The kind of a refusal is a value, not text: a server answers 431 for a header section or field count past the limits,
# 413 for a body past them, 505 for another HTTP version, 501 for a feature the codec lacks and 400 for everything else.
func request_status(data: bytes) -> int:
    match http.parse_request(data):
        case Ok(_):
            return 200
        case Err(error):
            return http.status(error)


func response_status(data: bytes, closed: bool) -> int:
    match http.parse_response(data, closed):
        case Ok(_):
            return 200
        case Err(error):
            return http.status(error)


func chunked_response(size_line: bytes) -> bytes:
    return b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n" + size_line + b"\r\n"


# spec-case: STANDARD-HTTP-2
public func test_a_header_section_or_field_count_past_the_limits_is_a_header_too_large_error_with_status_431() -> bool:
    const fields = many_fields(b"GET / HTTP/1.1", 101, b"\r\n\r\n")
    if request_status(fields) != 431:
        return False
    if request_status(big_head(b"GET / HTTP/1.1\r\nX: ", 65518)) != 431:
        return False
    if response_status(many_fields(b"HTTP/1.1 200 OK", 100, b"\r\nContent-Length: 0\r\n\r\n"), False) != 431:
        return False
    if response_status(big_head(b"HTTP/1.1 200 OK\r\nX: ", 65518), True) != 431:
        return False
    return request_text(fields) == "ERR HeaderTooLarge:22:too many header fields"


# spec-case: STANDARD-HTTP-2
public func test_a_body_past_the_limit_is_a_body_too_large_error_with_status_413() -> bool:
    if request_status(b"POST / HTTP/1.1\r\nContent-Length: 1048576\r\n\r\n") != 400:
        return False
    if request_status(b"POST / HTTP/1.1\r\nContent-Length: 1048577\r\n\r\n") != 413:
        return False
    if response_status(b"HTTP/1.1 200 OK\r\nContent-Length: 1048577\r\n\r\n", False) != 413:
        return False
    const long = byte_builder.repeat(b"z", 1048577)
    if response_status(b"HTTP/1.1 200 OK\r\n\r\n" + long, True) != 413:
        return False
    if response_status(chunked_response(b"100001"), False) != 413:
        return False
    if response_status(chunked_response(b"100000000"), False) != 413:
        return False
    return request_text(b"POST / HTTP/1.1\r\nContent-Length: 1048577\r\n\r\n") == "ERR BodyTooLarge:42:body length is outside the supported limit"


# spec-case: STANDARD-HTTP-2
public func test_another_http_version_is_an_unsupported_version_error_with_status_505() -> bool:
    if request_status(b"GET / HTTP/2.0\r\nHost: x\r\n\r\n") != 505:
        return False
    if response_status(b"HTTP/2.0 200 OK\r\nContent-Length: 0\r\n\r\n", False) != 505:
        return False
    if request_text(b"GET / HTTP/9.9\r\n\r\n") != "ERR UnsupportedVersion:40:only HTTP/1.0 and HTTP/1.1 are supported":
        return False
    if request_text(b"GET / HTTP/2\r\n\r\n") != "ERR Unsupported:40:only HTTP/1.0 and HTTP/1.1 are supported":
        return False
    if request_status(b"GET / HTTPS/1.1\r\n\r\n") != 501:
        return False
    match http.write_response(http.Response(version="HTTP/2.0", status=200, reason="OK", headers=[], body=b"")):
        case Err(error):
            return http.status(error) == 505 and http.message(error) == "only HTTP/1.0 and HTTP/1.1 are supported"
        case Ok(_):
            return False


# spec-case: STANDARD-HTTP-2
public func test_the_other_refusals_keep_their_kind_and_map_to_400_or_501() -> bool:
    if request_status(b"GET /a b HTTP/1.1\r\nHost: x\r\n\r\n") != 400:
        return False
    if request_status(b"POST / HTTP/1.1\r\nContent-Length: 99\r\n\r\nshort") != 400:
        return False
    if request_status(b"DELETE /x HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n") != 501:
        return False
    if response_status(b"HTTP/1.1 200 OK\r\nTransfer-Encoding: gzip\r\n\r\n", False) != 501:
        return False
    if http.status(http.Error.Incomplete) != 400 or http.status(http.Error.Malformed(value="m")) != 400:
        return False
    if http.status(http.Error.Unsupported(value="u")) != 501:
        return False
    return http.message(http.Error.UnsupportedVersion(value="v")) == "v" and http.message(http.Error.BodyTooLarge(value="b")) == "b" and http.message(http.Error.HeaderTooLarge(value="h")) == "h"


# FR1 (F-7): the answer to a HEAD request is the GET answer's header section and nothing else.
func head_bytes(response: http.Response) -> bytes:
    match http.write_response_head(response):
        case Ok(data):
            return data
        case Err(error):
            return strings.encode(("ERR " + http.message(error)))


# The repro's shape: the GET answer's Content-Length over an empty body is written as declared.
public func test_write_response_head_writes_a_declared_length_over_an_empty_body() -> bool:
    const fields = [http.Header(name="Content-Length", value="5")]
    const head = http.Response(version="HTTP/1.1", status=200, reason="OK", headers=fields, body=b"")
    const get = http.Response(version="HTTP/1.1", status=200, reason="OK", headers=copy(fields), body=b"hello")
    match http.write_response(get):
        case Ok(whole):
            return head_bytes(head) == b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\n" and whole == head_bytes(head) + b"hello"
        case Err(_):
            return False


# Given the GET answer itself, body and all, the head is its header section with the body's length, and no body.
public func test_write_response_head_of_the_get_answer_is_its_header_section() -> bool:
    const fields = [http.Header(name="Content-Type", value="text/plain")]
    const get = http.Response(version="HTTP/1.1", status=404, reason="Not Found", headers=fields, body=b"missing")
    match http.write_response(get):
        case Ok(whole):
            const head = head_bytes(get)
            return head == b"HTTP/1.1 404 Not Found\r\nContent-Type: text/plain\r\nContent-Length: 7\r\n\r\n" and whole == head + b"missing"
        case Err(_):
            return False


# The checks of `write_response` still hold: a nonempty body must match its declared length, a declared length must be a
# number, and an empty body with no length gets no field; `write_response` itself still refuses the HEAD shape.
public func test_write_response_head_keeps_the_writer_checks() -> bool:
    const wrong = http.Response(version="HTTP/1.1", status=200, reason="OK", headers=[http.Header(name="Content-Length", value="5")], body=b"hey")
    const garbled = http.Response(version="HTTP/1.1", status=200, reason="OK", headers=[http.Header(name="Content-Length", value="five")], body=b"")
    const bare = http.Response(version="HTTP/1.1", status=204, reason="No Content", headers=[], body=b"")
    const declared = http.Response(version="HTTP/1.1", status=200, reason="OK", headers=[http.Header(name="Content-Length", value="5")], body=b"")
    const refused = head_bytes(wrong) == b"ERR Content-Length does not match the response body" and head_bytes(garbled) == b"ERR Content-Length is not a decimal integer"
    match http.write_response(declared):
        case Ok(_):
            return False
        case Err(error):
            return refused and head_bytes(bare) == b"HTTP/1.1 204 No Content\r\n\r\n" and http.message(error) == "Content-Length does not match the response body"


# FR1 (F-9): a caller's limits. The repro's shape at 5 MiB: a body at the limit parses, one byte over it is `BodyTooLarge`.
func upload(size: int) -> bytes:
    const head = "PUT /f HTTP/1.1\r\nHost: x\r\nContent-Length: " + str(size) + "\r\n\r\n"
    return strings.encode(head) + byte_builder.repeat(b"x", size)


func within_text(data: bytes, limits: http.Limits) -> str:
    match http.parse_request_within(data, limits):
        case Ok(request):
            return "OK " + str(len(request.body))
        case Err(error):
            return "ERR " + fmt_error(error) + " " + str(http.status(error))


public func test_parse_request_within_takes_a_body_up_to_the_callers_limit() -> bool:
    const limits = http.Limits(body_bytes=5 * 1048576)
    const two = within_text(upload(2097152), limits) == "OK 2097152"
    const five = within_text(upload(5 * 1048576), limits) == "OK 5242880"
    const over = within_text(upload(5 * 1048576 + 1), limits) == "ERR BodyTooLarge:42:body length is outside the supported limit 413"
    return two and five and over and request_status(upload(2097152)) == 413


# A declared length over the limit is refused before the body arrives, and a smaller limit than the default holds too.
public func test_parse_request_within_refuses_a_declared_length_over_the_limit_as_too_large_not_malformed() -> bool:
    const small = http.Limits(body_bytes=10)
    const declared = within_text(b"POST / HTTP/1.1\r\nContent-Length: 11\r\n\r\n", small) == "ERR BodyTooLarge:42:body length is outside the supported limit 413"
    const fits = within_text(b"POST / HTTP/1.1\r\nContent-Length: 10\r\n\r\n0123456789", small) == "OK 10"
    const garbled = within_text(b"POST / HTTP/1.1\r\nContent-Length: ten\r\n\r\n", small) == "ERR Malformed:39:Content-Length is not a decimal integer 400"
    return declared and fits and garbled


# The header section's limits are the caller's too, and `Limits()` is `parse_request`'s.
public func test_parse_request_within_holds_the_header_limits() -> bool:
    const defaults = http.Limits()
    const tight = http.Limits(header_bytes=64, header_fields=2)
    const three = within_text(many_fields(b"GET / HTTP/1.1", 3, b"\r\n\r\n"), tight) == "ERR HeaderTooLarge:22:too many header fields 431"
    const two = strings.starts_with(within_text(many_fields(b"GET / HTTP/1.1", 2, b"\r\n\r\n"), tight), "OK")
    const wide = within_text(big_head(b"GET / HTTP/1.1\r\nX: ", 60), tight) == "ERR HeaderTooLarge:27:header section is too large 431"
    const same = within_text(many_fields(b"GET / HTTP/1.1", 101, b"\r\n\r\n"), defaults) == "ERR " + request_text(many_fields(b"GET / HTTP/1.1", 101, b"\r\n\r\n"))[4:] + " 431"
    return defaults.header_bytes == 65536 and defaults.header_fields == 100 and defaults.body_bytes == 1048576 and three and two and wide and same


# The path, query and fragment-free target of a request whose target is `text`, joined by `|`.
func target_parts(text: str) -> str:
    const request = http.Request(method="GET", target=copy(text), version="HTTP/1.1", headers=[], body=b"")
    return http.path(request) + "|" + http.query(request) + "|" + http.target(request)


# F-59: a `://` in the query is query text, so it never moves the path.
public func test_a_url_in_the_query_does_not_move_the_path() -> bool:
    const viewer = target_parts("/p/lab/plot/?file=https://evil.example/x.html") == "/p/lab/plot/|file=https://evil.example/x.html|/p/lab/plot/?file=https://evil.example/x.html"
    const next = target_parts("/?next=http://a/p/other/page/") == "/|next=http://a/p/other/page/|/?next=http://a/p/other/page/"
    const plain = target_parts("/p/lab/plot/?file=index.html") == "/p/lab/plot/|file=index.html|/p/lab/plot/?file=index.html"
    const in_path = target_parts("/public/x://h/admin/delete") == "/public/x://h/admin/delete||/public/x://h/admin/delete"
    const no_slash = target_parts("admin?x=http://h/y") == "/admin|x=http://h/y|admin?x=http://h/y"
    return viewer and next and plain and in_path and no_slash


# An absolute-form target answers the path after its authority, with or without a query, as before.
public func test_an_absolute_form_target_answers_its_path_and_query() -> bool:
    const bare = target_parts("http://example.test/a/b") == "/a/b||http://example.test/a/b"
    const queried = target_parts("http://example.test/a/b?c=d&e=http://x/y") == "/a/b|c=d&e=http://x/y|http://example.test/a/b?c=d&e=http://x/y"
    const no_path = target_parts("http://example.test") == "/||http://example.test"
    const no_path_query = target_parts("http://example.test?u=/x/y") == "/|u=/x/y|http://example.test?u=/x/y"
    return bare and queried and no_path and no_path_query


# The asterisk and authority forms have no path (the empty string, which no route table holds), and no query; a request
# a program builds by hand with an empty target, a second `?` or a fragment answers as before (lane FR13, F-66).
public func test_asterisk_and_authority_targets_have_no_path_and_the_other_forms_keep_their_answers() -> bool:
    const star = target_parts("*") == "||*"
    const authority = target_parts("example.test:443") == "||example.test:443"
    const literal = target_parts("[::1]:8080") == "||[::1]:8080"
    const empty = target_parts("") == "/||"
    const second = target_parts("/a?b=1?c=2") == "/a|b=1?c=2|/a?b=1?c=2"
    const fragment = target_parts("/a?b=1#c?d=2") == "/a|b=1|/a?b=1"
    const fragment_first = target_parts("/a#b?c=1") == "/a||/a"
    return star and authority and literal and empty and second and fragment and fragment_first
