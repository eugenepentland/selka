    return [Case(wire=b"GET / HTTP/1.1\r\nH0: v0\r\n\r\n", expected="H-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-L|get|/||/"), Case(wire=b"GET / HTTP/1.1\r\nHost: example.test\r\n\r\n", expected="H-LH-LH-LH-LH-LH-LH12:example.testL12:example.testH12:example.testL12:example.testH12:example.testL12:example.testH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-L|get|/||/"), Case(wire=b"GET /hello?x=1 HTTP/1.1\r\nHost: example.test\r\nContent-Length: 5\r\n\r\nhello", expected="H-LH-LH-LH-LH-LH-LH12:example.testL12:example.testH12:example.testL12:example.testH12:example.testL12:example.testH1:5L1:5H1:5L1:5H-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-L|get|/hello|x=1|/hello?x=1"), Case(wire=b"POST /kv/a HTTP/1.1\r\nHost: h\r\nContent-Length: 3\r\nContent-Type: application/json\r\n\r\n[1]", expected="H-LH-LH-LH-LH-LH-LH1:hL1:hH1:hL1:hH1:hL1:hH1:3L1:3H1:3L1:3H-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-L|post|/kv/a||/kv/a"), Case(wire=b"PUT /kv/key HTTP/1.0\r\nhost:   spaced value \t \r\nX-Empty:\r\nConnection: keep-alive\r\n\r\nbody bytes", expected="H-LH-LH-LH-LH-LH-LH12:spaced valueL12:spaced valueH12:spaced valueL12:spaced valueH12:spaced valueL12:spaced valueH-LH-LH-LH-LH0:L0:H0:L0:H-LH-LH-LH-LH-LH10:keep-aliveL10:keep-aliveH10:keep-aliveL10:keep-aliveH-LH-LH-LH-L|put|/kv/key||/kv/key"), Case(wire=b"GET http://example.test/a/b?c=d#frag HTTP/1.1\r\nHOST: example.test\r\nUser-Agent: Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36\r\nAccept: */*\r\nAccept-Encoding: gzip, deflate\r\nCookie: a=b; c=d\r\n\r\n", expected="-"), Case(wire=b"DELETE /x HTTP/1.1\r\nHost: a\r\nHost: b\r\nTransfer-Encoding: chunked\r\n\r\n", expected="-"), Case(wire=b"GET /\xc3\xa9t\xc3\xa9 HTTP/1.1\r\nHost: caf\xc3\xa9.test\r\nX-Note: na\xc3\xafve \xc2\xa0 value\xc2\xa0\r\n\r\n", expected="H-LH-LH-LH-LH-LH-LH9:café.testL9:café.testH9:café.testL9:café.testH9:café.testL9:café.testH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-LH-L|get|/été||/été"), Case(wire=b"BREW /