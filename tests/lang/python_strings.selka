# spec: PY-STR-1
import strings

public func test_trimming_case_mapping_and_padding_copy_the_receiver_without_changing_it() -> bool:
    mut padded = "  value  "
    mut score = 0
    if strings.strip(padded) == "value":
        score = score + 1
    if strings.lstrip(padded) == "value  ":
        score = score + 2
    if strings.rstrip(padded) == "  value":
        score = score + 4
    if strings.upper("aB") == "AB" and strings.lower("aB") == "ab":
        score = score + 8
    if strings.zfill("7", 3) == "007" and strings.zfill("-7", 3) == "-07":
        score = score + 16
    if padded == "  value  ":
        score = score + 11
    return score == 42


# spec: PY-STR-2
public func test_search_replacement_and_classification_follow_python_answers() -> bool:
    mut text = "a,b,a"
    mut score = 0
    if strings.replace(text, "a", "z") == "z,b,z":
        score = score + 1
    if strings.char_find(text, "b") == 2 and strings.char_find(text, "q") == -1:
        score = score + 2
    if strings.count(text, "a") == 2:
        score = score + 4
    if strings.starts_with(text, "a,") and strings.ends_with(text, ",a"):
        score = score + 8
    if strings.is_digit("42") and strings.is_alpha("ab") and strings.is_space(" \t"):
        score = score + 16
    if not strings.is_digit("") and not strings.is_alpha("4a"):
        score = score + 11
    return score == 42


# spec: PY-STR-3
public func test_splitlines_drops_terminators_and_int_float_parse_a_whole_string() -> bool:
    mut lines = strings.lines("a\nb\r\nc")
    mut total = len(lines) * 10
    match parse_int("12"):
        case Some(value):
            total = total + value
        case None:
            total = total - 1
    match parse_int("12x"):
        case Some(value):
            total = total + value
        case None:
            total = total
    match parse_float("0.5"):
        case Some(value):
            total = total + int(value * 2.0)
        case None:
            total = total - 1
    return total - 1 == 42


func main() -> int:
    return 0
