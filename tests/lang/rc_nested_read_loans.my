module rc_nested_read_loans

def select(cubes: list[list[list[int]]], i: int, j: int, k: int, output: mut list[int]) -> int:
    value = cubes[i][j][k]
    output.append(value)
    return value


# spec-case: RC-NESTED-READ-LOAN-1
public def test_nested_read_loans_follow_negative_indices_and_loop_roots() -> bool:
    output: list[int] = []
    total = 0
    for index in range(20):
        cubes = [[[index, index + 1]], [[index + 2, index + 3]]]
        if index % 2 == 0:
            total += select(cubes, 0, 0, 0, mut output)
        else:
            total += select(cubes, -1, -1, -1, mut output)
    return total == 220 and len(output) == 20 and output[0] == 0 and output[-1] == 22


def replace_row(rows: mut list[list[int]]) -> int:
    rows[0] = [91]
    return 0


# spec-case: RC-NESTED-READ-LOAN-1
public def test_nested_read_loans_keep_the_row_captured_before_a_callback() -> bool:
    rows = [[7, 8]]
    selected = rows[0][replace_row(mut rows)]
    return selected == 7 and rows == [[91]]


# spec-case: RC-NESTED-READ-LOAN-1
public def test_named_row_keeps_ownership_after_root_replacement() -> bool:
    rows = [[7, 8]]
    selected = rows[0]
    rows = [[91]]
    return selected[-1] == 8 and rows[0][0] == 91


# spec-case: RC-NESTED-READ-LOAN-1
public def test_nested_reads_preserve_mutating_receiver_snapshots() -> bool:
    rows = [[7, 8]]
    snapshot = rows
    rows[0].append(rows[0][0])
    return rows == [[7, 8, 7]] and snapshot == [[7, 8]]


# spec-case: RC-NESTED-READ-LOAN-1
public def test_nested_reads_leave_dictionary_and_view_roles_owned() -> bool:
    mapping = {0: [[7, 8]]}
    view = mapping.values()
    result = mapping[0][0][-1]
    mapping[0] = [[91]]
    total = 0
    for rows in view:
        total += rows[0][0]
    return result == 8 and total == 91


# spec-case: RC-NESTED-READ-LOAN-1
public def test_text_index_results_remain_fresh_owned_values() -> bool:
    words = ["αβγ", "abcdef"]
    total = 0
    for index in range(20):
        total += len(words[0][1]) + len(words[1][-1])
    return total == 40 and words == ["αβγ", "abcdef"]


# spec-case: RC-NESTED-READ-LOAN-1
public def test_nested_reads_inside_arena_escape_only_scalars() -> bool:
    total = 0
    with arena():
        cubes = [[[3, 5, 8]]]
        output: list[int] = []
        total = select(cubes, 0, 0, -1, mut output)
        total += cubes[0][0][0]
    return total == 11


def main() -> int:
    assert test_nested_read_loans_follow_negative_indices_and_loop_roots()
    assert test_nested_read_loans_keep_the_row_captured_before_a_callback()
    assert test_named_row_keeps_ownership_after_root_replacement()
    assert test_nested_reads_preserve_mutating_receiver_snapshots()
    assert test_nested_reads_leave_dictionary_and_view_roles_owned()
    assert test_text_index_results_remain_fresh_owned_values()
    assert test_nested_reads_inside_arena_escape_only_scalars()
    return 0
