# Python expression idioms, each checked against the answer CPython gives for the
# same expression (the expected values below were produced by CPython 3). The
# f-string format specifications and `round(x, n)` live in format_specs.my.
func ordered(a: str, b: str) -> bool[]:
    return [a < b, a <= b, a > b, a >= b]


func ordered_bytes(a: bytes, b: bytes) -> bool[]:
    return [a < b, a <= b, a > b, a >= b]


# spec: PY-TEXT-ORDER-1
public func test_str_orders_by_code_point_with_a_prefix_first() -> bool:
    if ordered("apple", "banana") != [True, True, False, False]:
        return False
    if ordered("abc", "abc") != [False, True, False, True]:
        return False
    if ordered("ab", "abc") != [True, True, False, False]:
        return False
    if ordered("", "a") != [True, True, False, False]:
        return False
    # Code point order, not a locale collation: uppercase sorts before lowercase
    # and a non-ASCII scalar after every ASCII one.
    if ordered("Zebra", "apple") != [True, True, False, False]:
        return False
    if ordered("é", "z") != [False, False, True, True]:
        return False
    return "abc" < "abd" and not ("b" < "a")


func first_word[T](tag: T, a: str, b: str) -> str:
    _ = tag
    if a <= b:
        return a.copy()
    return b.copy()


# spec-case: PY-TEXT-ORDER-1
public func test_a_generic_body_orders_its_str_operands() -> bool:
    return first_word(1, "pear", "fig") == "fig" and first_word(True, "ant", "bee") == "ant"


# spec-case: PY-TEXT-ORDER-1
public func test_bytes_order_by_octet_with_a_prefix_first() -> bool:
    if ordered_bytes(b"ab", b"abc") != [True, True, False, False]:
        return False
    if ordered_bytes(b"abc", b"abc") != [False, True, False, True]:
        return False
    if ordered_bytes(b"\xff", b"a") != [False, False, True, True]:
        return False
    return ordered_bytes(b"", b"\x00") == [True, True, False, False]


const IN_RANGE: bool = 0 < 5 <= 5


# The false first link leaves `1 // 0` unevaluated, as it does at run time.
const SKIPPED: bool = 1 < 0 < 1 // 0


func mark(mut log: int[], value: int) -> int:
    log.append(value)
    return value


# spec: PY-CHAIN-1
public func test_a_comparison_chain_reads_as_python_and() -> bool:
    mut x = 5
    if [0 < x < 10, 0 < x < 5, 1 <= x <= 5, x == 5 == x, 10 > x > 1 > 0, 1 < 2 < 3 < 4 < 3] != [True, False, True, True, True, False]:
        return False
    if [0 < x != 5, 5 <= x == 5, 1 < x < 7.5, 0.5 < 1 < 2] != [False, True, True, True]:
        return False
    return "a" < "b" <= "b" and not ("b" < "a" < "c")


# spec-case: PY-CHAIN-1
public func test_a_chain_evaluates_each_operand_once_and_stops_at_a_false_link() -> bool:
    mut log: int[] = []
    mut held = mark(mut log, 1) < mark(mut log, 2) < mark(mut log, 3)
    if not held or log != [1, 2, 3]:
        return False
    log.clear()
    mut broken = mark(mut log, 3) < mark(mut log, 2) < mark(mut log, 9)
    return not broken and log == [3, 2]


# spec-case: PY-CHAIN-1
public func test_a_chain_types_each_literal_by_its_neighbour() -> bool:
    mut small: u8 = 7
    mut wide: i64 = 7
    return 0 < small < 200 and not (200 < small < 250) and -3 < wide <= 7


# spec-case: PY-CHAIN-1
public func test_a_parenthesized_comparison_is_a_bool_operand() -> bool:
    return ((1 < 2) == (3 < 4)) and (5 > 3) == True


# spec-case: PY-CHAIN-1
public func test_a_constant_chain_folds_and_short_circuits() -> bool:
    return IN_RANGE and not SKIPPED


func between[T](tag: T, low: int, value: int, high: int) -> bool:
    _ = tag
    return low <= value < high


# spec-case: PY-CHAIN-1
public func test_a_generic_body_checks_each_link_of_a_chain() -> bool:
    return between("t", 1, 1, 3) and not between(2, 1, 3, 3)


func stepped(start: int, stop: int, step: int) -> int[]:
    mut values: int[] = []
    for i in range(start, stop, step):
        values.append(i)
    return values


# spec: PY-RANGE-STEP-1
public func test_range_counts_by_its_step_in_either_direction() -> bool:
    if stepped(0, 10, 2) != [0, 2, 4, 6, 8] or stepped(0, 10, 3) != [0, 3, 6, 9]:
        return False
    if stepped(10, 0, -3) != [10, 7, 4, 1] or stepped(5, -1, -1) != [5, 4, 3, 2, 1, 0]:
        return False
    if len(stepped(0, 10, -1)) + len(stepped(10, 0, 1)) + len(stepped(3, 3, 1)) != 0:
        return False
    mut total = 0
    for i in range(0, 10, 2):
        total += i
    mut down: int[] = []
    for j in range(9, -1, -4):
        down.append(j)
    return total == 20 and down == [9, 5, 1]


# spec-case: PY-RANGE-STEP-1
public func test_a_stepped_range_feeds_a_comprehension_and_list() -> bool:
    if [for i in range(1, 10, 4) yield i * i] != [1, 25, 81]:
        return False
    if [for i in range(20, 0, -6) if i % 4 == 0 yield i] != [20, 8]:
        return False
    return list(range(0, 7, 3)) == [0, 3, 6] and list(range(7, 0, -3)) == [7, 4, 1]


# spec-case: PY-RANGE-STEP-1
public func test_the_last_step_never_overflows_the_counter_type() -> bool:
    mut top = 9223372036854775807
    mut near: int[] = []
    for i in range(top - 5, top, 4):
        near.append(i)
    mut small: u8[] = []
    for b in range(u8(200), u8(255), u8(50)):
        small.append(b)
    mut low = -9223372036854775807 - 1
    mut floor: int[] = []
    for k in range(low + 5, low, -3):
        floor.append(k)
    return near == [top - 5, top - 1] and small == [u8(200), u8(250)] and floor == [low + 5, low + 2]


func times(text: str, count: int) -> str:
    return text.copy() * count


# spec: PY-REPEAT-1
public func test_str_and_bytes_repeat_by_an_integer_on_either_side() -> bool:
    if ["ab" * 3, 3 * "ab", times("ab", 0), times("ab", -2), "é" * 2] != ["ababab", "ababab", "", "", "éé"]:
        return False
    mut small: u8 = 2
    if b"xy" * 2 != b"xyxy" or len(b"xy" * 0) != 0 or "-" * small != "--":
        return False
    mut s = "ab"
    s *= 2
    return s == "abab" and len("ab" * 3) * 7 == 42


# spec-case: PY-REPEAT-1
public func test_an_int_times_a_float_is_still_arithmetic() -> bool:
    mut x = 3
    mut y = 1.5
    return x * y == 4.5 and y * x == 4.5 and x * 2 == 6


# spec-case: PY-REPEAT-1
public func test_a_list_repeats_by_an_integer_into_independent_values() -> bool:
    if [0] * 3 != [0, 0, 0] or 2 * [1, 2] != [1, 2, 1, 2] or len([1] * 0) != 0:
        return False
    # Value semantics: a copy taken before `*=` keeps its own contents.
    mut xs = [1]
    mut before = xs.copy()
    xs *= 3
    if before != [1] or xs != [1, 1, 1]:
        return False
    xs *= 0
    if len(xs) != 0 or before != [1]:
        return False
    # Each repeated element is its own value: writing one leaves the others.
    mut inner = [0]
    mut grid = [inner.copy()] * 2
    grid[0].append(9)
    return grid == [[0, 9], [0]] and inner == [0]


func mark_text(mut log: int[], value: int, text: str) -> str:
    log.append(value)
    return text.copy()


func mark_count(mut log: int[], value: int) -> int:
    log.append(value)
    return value


# spec-case: PY-REPEAT-1
public func test_a_repetition_evaluates_its_operands_once_in_order() -> bool:
    mut log: int[] = []
    mut left = mark_count(mut log, 2) * mark_text(mut log, 5, "ab")
    mut right = mark_text(mut log, 7, "c") * mark_count(mut log, 3)
    return left == "abab" and right == "ccc" and log == [2, 5, 7, 3]


func repeated[T](tag: T, text: str, count: int) -> str:
    _ = tag
    return text.copy() * count


# spec-case: PY-REPEAT-1
public func test_a_generic_body_repeats_text() -> bool:
    return repeated(1, "xy", 2) == "xyxy"
