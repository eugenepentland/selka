# Owned slices, split pieces, lines, stripped text and fields preserve their
# values after source destruction and replacement. These fixtures retain the
# original value assertions; they do not require shared backing or collection.
# `times` copies of `piece` by doubling, so a long input costs a logarithmic
# number of guest steps.
import dicts
import strings

func repeated(piece: str, times: int) -> str:
    mut out = ""
    mut chunk = copy(piece)
    mut remaining = times
    while remaining > 0:
        if remaining % 2 == 1:
            out = out + chunk
        remaining = remaining // 2
        if remaining > 0:
            chunk = chunk + chunk
    return out


# The receiver lives only inside this call: the piece it answers outlives it.
func middle_of_fresh_text() -> str:
    mut text = repeated("0123456789", 100) + "tail"
    return copy(strings.char_slice(text, 5, strings.char_count(text) - 2))


# Three 299-scalar lines of a text that lives only inside this call.
func lines_of_fresh_text() -> str[]:
    mut text = repeated(repeated("L", 297) + "-x\n", 3)
    return strings.split(text, "\n")


func churn(rounds: int) -> int:
    mut total = 0
    for index in range(rounds):
        total += strings.char_count(f"garbage {index} {index * 7}")
    return total


# spec-case: NEW-CORE-ZERO-RC-LIBRARY-1
public func test_pieces_outlive_every_other_reference_to_their_receiver() -> bool:
    mut piece = middle_of_fresh_text()
    mut lines = lines_of_fresh_text()
    _ = churn(2000)
    mut ok = strings.char_count(piece) == 997 and strings.char_slice(piece, None, 6) == "567890" and strings.char_slice(piece, max(strings.char_count(piece) - 4, 0), None) == "89ta"
    ok = ok and len(lines) == 4 and strings.char_count(lines[0]) == 299 and strings.char_slice(lines[0], max(strings.char_count(lines[0]) - 3, 0), None) == "L-x"
    return ok and lines[2] == lines[0] and lines[3] == "" and strings.count(piece, "0123456789") == 99


# spec-case: NEW-CORE-ZERO-RC-LIBRARY-1
public func test_nested_owned_slices_read_the_right_octets() -> bool:
    mut base = repeated("abcdefghijklmnopqrstuvwxyz", 40)
    mut first = copy(strings.char_slice(base, 3, 900))
    mut second = copy(strings.char_slice(first, 20, 800))
    mut third = copy(strings.char_slice(second, 100, 500))
    mut fourth = copy(strings.char_slice(third, 1, None))
    mut ok = strings.char_at(first, 0) == "d" and strings.char_at(second, 0) == "x" and strings.char_at(third, 0) == "t" and strings.char_at(fourth, 0) == "u"
    ok = ok and strings.char_count(first) == 897 and strings.char_count(second) == 780 and strings.char_count(third) == 400 and strings.char_count(fourth) == 399
    ok = ok and third == strings.char_slice(base, 123, 523) and fourth == strings.char_slice(base, 124, 523)
    return ok and strings.char_find(fourth, "abc") == 6 and strings.char_at(fourth, strings.char_count(fourth) - 1) == "c"


# Non-ASCII receivers: scalar indexing, lengths and searches of a piece count
# the piece's own scalars, whatever octet of the receiver it starts at.
# spec-case: NEW-CORE-ZERO-RC-LIBRARY-1
public func test_non_ascii_pieces_index_by_scalar() -> bool:
    mut base = repeated("aé🙂z—", 200)
    mut piece = copy(strings.char_slice(base, 7, 600))
    mut inner = copy(strings.char_slice(piece, 3, 400))
    mut ok = strings.char_count(base) == 1000 and strings.char_count(piece) == 593 and strings.char_count(inner) == 397
    ok = ok and strings.char_at(piece, 0) == "🙂" and strings.char_at(piece, 1) == "z" and strings.char_at(piece, 2) == "—" and strings.char_at(inner, 0) == "a"
    ok = ok and strings.char_at(inner, 1) == "é" and strings.char_at(inner, strings.char_count(inner) - 1) == strings.char_at(base, 406) and strings.char_find(inner, "🙂") == 2
    ok = ok and inner == strings.char_slice(base, 10, 407) and strings.count(inner, "é") == 80
    return ok and strings.split(piece, "—")[1] == "aé🙂z" and ord(strings.char_at(inner, 2)) == 128578


# Pieces as dictionary keys: a stored piece, a fresh piece and an owned copy of
# the same octets all find one entry, and iteration answers the stored keys.
# spec-case: NEW-CORE-ZERO-RC-LIBRARY-1
public func test_pieces_are_dictionary_keys_equal_to_owned_text() -> bool:
    mut base = repeated("GATTACA-CATTAGA-", 50)
    mut counts: dict[str, int] = {}
    for index in range(strings.char_count(base) - 250):
        mut key = copy(strings.char_slice(base, index, index + 250))
        counts[own key] = dicts.get(counts, key, 0) + 1
    mut ok = len(counts) == 16 and counts[strings.char_slice(base, 0, 250)] == 35 and counts[strings.char_slice(base, 1, 251)] == 35
    mut owned = repeated("GATTACA-CATTAGA-", 15) + "GATTACA-CA"
    ok = ok and owned in counts and counts[owned] == 35 and counts[strings.char_slice(base, 32, 282)] == 35
    mut keys = sorted(list(dicts.keys(counts)))
    ok = ok and strings.char_slice(keys[0], None, 15) == "-CATTAGA-GATTAC" and len(keys) == 16
    mut dropped = dicts.pop(mut counts, strings.char_slice(base, 16, 266))
    return ok and dropped == 35 and len(counts) == 15 and not (owned in counts)


# Every consumer reads a piece's octets: number parsing, formatting, encoding,
# joining, case mapping, comparison and sorting.
# spec-case: NEW-CORE-ZERO-RC-LIBRARY-1
public func test_every_consumer_reads_a_piece() -> bool:
    mut pair = strings.split("12345678901,-4250.0000e-1", ",")
    mut ok = False
    match parse_int(pair[0]):
        case Some(value):
            ok = value == 12345678901
        case None:
            ok = False
    match parse_float(pair[1]):
        case Some(value):
            ok = ok and value == -425.0
        case None:
            ok = False
    mut row = repeated("x", 30) + ",  padded words here  ," + repeated("y", 30)
    mut fields = strings.split(row, ",")
    mut words = strings.split(strings.strip(fields[1]), " ")
    ok = ok and words == ["padded", "words", "here"] and strings.join(words, " ") == "padded words here"
    ok = ok and f"<{strings.strip(fields[1])}>" == "<padded words here>" and str(pair[0]) == "12345678901"
    ok = ok and len(strings.encode(fields[0])) == 30 and strings.encode(fields[2]) == strings.encode(repeated("y", 30))
    ok = ok and sorted([copy(fields[0]), copy(fields[2])])[1] == fields[2] and sorted([copy(fields[2]), copy(fields[0]), copy(fields[1])])[0] == fields[1]
    ok = ok and strings.upper(fields[1]) == "  PADDED WORDS HERE  " and strings.zfill(pair[0], 13) == "0012345678901"
    ok = ok and strings.replace(fields[1], "words", "w") == "  padded w here  " and strings.is_digit(pair[0])
    return ok and strings.starts_with(fields[1], "  pad") and strings.ends_with(fields[1], "re  ") and fields[0] + "," + fields[1] == strings.char_slice(row, None, 52)


func inner_piece(index: int) -> str:
    return copy(strings.char_slice(repeated("inner-text-", 100), index, index + 300))


# Omitted upper bounds produce owned suffixes, including a suffix of a suffix.
# Scalar indexing and consumers preserve the selected value.
public func test_streaming_tails_preserve_scalars_and_consumers() -> bool:
    mut owner = repeated("abcdefé😀", 40) + "é😀abcdefghi"
    mut tail = copy(strings.char_slice(owner, max(strings.char_count(owner) - 11, 0), None))
    mut nested = copy(strings.char_slice(tail, 1, None))
    mut ok = tail == "é😀abcdefghi" and nested == "😀abcdefghi"
    ok = ok and strings.char_slice(nested, 1, None) == "abcdefghi" and strings.char_slice(nested, 2, None) == "bcdefghi"
    ok = ok and strings.char_slice(owner, strings.char_count(owner), None) == "" and strings.char_slice(owner, strings.char_count(owner) + 5, None) == ""
    ok = ok and strings.char_slice(owner, max(strings.char_count(owner) - 10000, 0), None) == owner and strings.char_slice(nested, None, 9) == "😀abcdefgh"
    ok = ok and strings.char_find(nested, "ghi") == 7 and strings.char_rfind(nested, "a", 0, 10) == 1
    ok = ok and strings.strip_chars(nested, "😀i") == "abcdefgh" and repr(nested) == "'😀abcdefghi'"
    return ok and strings.encode(nested) == b"\xf0\x9f\x98\x80abcdefghi"


# C9: a view binding passed to a runtime text helper (`strings.char_find`, and the `count` method, which
# has no span form) is read in place or copied, and answers the same as the owned text.
public func test_c9_view_binding_is_the_needle_of_runtime_text_helpers() -> bool:
    const text = "abcdef"
    const needle = text[1:3]
    return strings.char_find(text, needle) == 1 and strings.count(text, needle) == 1


# C9 2b: trim, octet slice, stepped slice, join and split take their texts as spans. Each answer below is the
# one main gives for the same owned text, including multi-byte scalars, empty pieces and a negative step.
public func test_c9_2b_span_text_helpers_answer_as_main_does() -> bool:
    const text = "  héllo wörld, ünïcode  "
    const sep = text[0:2]
    const ascii = "  the quick brown fox  "
    const parts = ["a", "bb", "", "cccc"]
    return strings.strip_chars(text, " o") == "héllo wörld, ünïcode" and strings.strip_chars(text, "ü") == text and text[2:9] == "héllo " and text[0:0] == "" and strings.strip_chars(ascii, "tk ") == "he quick brown fox" and strings.char_stride(text, 3, 1, -1) == "éh" and strings.join(parts, ", ") == "a, bb, , cccc" and strings.join(parts, sep) == "a  bb    cccc" and len(strings.split(text, "zz")) == 1 and len(strings.split(ascii, "the")) == 2


func main() -> int:
    return 0
