# Byte-buffer append loops whose uniqueness check runs at the loop entry
# (RC-BUFFER-HOIST-1). Each result is the same under the collector and RC.
func repeated(count: int, piece: bytes) -> byte_buffer:
    mut empty: int[] = []
    mut buffer = byte_buffer(empty)
    for index in range(count):
        _ = buffer.append_range(piece, 0, 2)
        _ = buffer.append_byte(48 + index % 10)
    return buffer


public func test_zero_and_many_iterations_append_the_same_octets() -> bool:
    mut piece = b"ab"
    return repeated(0, piece) == b"" and repeated(3, piece) == b"ab0ab1ab2" and len(repeated(1000, piece)) == 3000


public func test_a_snapshot_taken_before_the_loop_keeps_its_octets() -> bool:
    mut empty: int[] = []
    mut buffer = byte_buffer(empty)
    _ = buffer.append_byte(65)
    mut before = bytes(buffer)
    mut shared = buffer.copy()
    mut piece = b"xyz"
    for index in range(5):
        if index == 4:
            break
        if index % 2 == 0:
            continue
        _ = buffer.append_range(piece, index - 1, 3)
    return buffer == b"Axyzz" and before == b"A" and shared == b"A"


public func test_text_and_number_appends_share_one_entry_check() -> bool:
    mut empty: int[] = []
    mut buffer = byte_buffer(empty)
    mut word = "λx"
    for index in range(3):
        _ = buffer.append_utf8(word)
        _ = buffer.append_int(index - 1)
        _ = buffer.reserve(2)
    return buffer == b"\xce\xbbx-1\xce\xbbx0\xce\xbbx1"


func grow(mut buffer: byte_buffer) -> int:
    _ = buffer.append_byte(33)
    return 46


public func test_a_callback_or_snapshot_inside_the_loop_keeps_every_check() -> bool:
    mut empty: int[] = []
    mut buffer = byte_buffer(empty)
    mut kept = bytes(buffer)
    for index in range(3):
        kept = bytes(buffer)
        mut value = grow(mut buffer)
        _ = buffer.append_byte(value)
    return buffer == b"!.!.!." and kept == b"!.!."


public func test_refused_appends_inside_the_loop_write_nothing() -> bool:
    mut empty: int[] = []
    mut buffer = byte_buffer(empty)
    mut piece = b"abc"
    mut refused = 0
    for index in range(6):
        if not buffer.append_range(piece, index, 3):
            refused = refused + 1
        if not buffer.append_byte(251 + index):
            refused = refused + 1
    return buffer == b"abc\xfbbc\xfcc\xfd\xfe\xff" and refused == 3


func main() -> int:
    assert test_zero_and_many_iterations_append_the_same_octets()
    assert test_a_snapshot_taken_before_the_loop_keeps_its_octets()
    assert test_text_and_number_appends_share_one_entry_check()
    assert test_a_callback_or_snapshot_inside_the_loop_keeps_every_check()
    assert test_refused_appends_inside_the_loop_write_nothing()
    return 0
