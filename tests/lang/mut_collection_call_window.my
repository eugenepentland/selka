# Explicit copies preserve values observed after a callback mutates the source.
# The former implicit snapshot call windows are rejected under checked ownership;
# a03_migration_boundaries_test.zig retains those negative contracts.
record Box:
    tag: int
    names: int[]


record State:
    boxes: Box[]


func weigh(names: int[], b: int) -> int:
    return len(names) * 100 + b


func hold(names: int[], mut boxes: Box[]) -> int:
    boxes[0].names.append(7)
    return len(names)


func hold_after(mut boxes: Box[], names: int[]) -> int:
    boxes[0].names.append(7)
    return len(names)


func append_first(mut boxes: Box[]) -> int:
    boxes[0].names.append(7)
    return 1


func push(mut xs: int[]) -> int:
    xs.append(9)
    return 1


func probe(mut state: State) -> int:
    mut box = state.boxes[0].copy()
    return hold(box.names, mut state.boxes)


public func test_a_borrowed_field_passed_before_a_mut_collection_argument_keeps_its_value() -> bool:
    mut state = State(boxes=[Box(tag=1, names=[1])])
    mut seen = probe(mut state)
    return seen == 1 and len(state.boxes[0].names) == 2


public func test_a_borrowed_field_passed_after_a_mut_collection_argument_keeps_its_value() -> bool:
    mut state = State(boxes=[Box(tag=1, names=[1])])
    mut box = state.boxes[0].copy()
    mut seen = hold_after(mut state.boxes, box.names)
    return seen == 1 and len(state.boxes[0].names) == 2


public func test_a_borrowed_field_keeps_its_value_across_a_later_nested_mut_call() -> bool:
    mut state = State(boxes=[Box(tag=1, names=[1])])
    mut box = state.boxes[0].copy()
    mut seen = weigh(box.names, append_first(mut state.boxes))
    return seen == 101 and len(state.boxes[0].names) == 2


public func test_a_borrowed_field_keeps_its_value_across_a_later_pop_through_the_root() -> bool:
    mut state = State(boxes=[Box(tag=1, names=[1, 2])])
    mut box = state.boxes[0].copy()
    mut seen = weigh(box.names, state.boxes[0].names.pop())
    return seen == 202 and len(state.boxes[0].names) == 1


public func test_a_borrowed_local_keeps_its_value_across_a_later_mut_call_of_its_source() -> bool:
    mut xs = [1, 2, 3]
    mut ys = xs.copy()
    mut seen = weigh(ys, push(mut xs))
    return seen == 301 and len(xs) == 4


public func test_a_borrow_the_write_consumes_stays_a_borrow_of_the_same_value() -> bool:
    mut state = State(boxes=[Box(tag=1, names=[1])])
    mut box = state.boxes[0].copy()
    state.boxes.append(Box(tag=2, names=box.names.copy()))
    return len(state.boxes) == 2 and len(state.boxes[1].names) == 1 and len(box.names) == 1
