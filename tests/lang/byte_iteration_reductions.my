

func reduce(raw: bytes, mask: int, seed: int) -> int:
    mut total = seed
    for value in raw:
        total += value ^ mask
    return total


func indexed(raw: bytes, mask: int, seed: int) -> int:
    mut total = seed
    for index in range(len(raw)):
        total += raw[index] ^ mask
    return total


public func test_byte_iteration_lengths_views_and_unbounded_masks() -> bool:
    mut masks = [0, 1, 127, 255, -1, 256, 1000003]
    for length in [0, 1, 15, 16, 17, 31, 32, 1024, 1041]:
        mut source = bytes([for i in range(length + 17) yield (i * 37 + 11) % 256])
        mut raw = source[7:7 + length]
        for mask in masks:
            if reduce(raw, mask, 13) != indexed(raw, mask, 13):
                return False
    return reduce(b"", 255, -9223372036854775808) == -9223372036854775808


public func test_byte_iteration_keeps_immutable_snapshot_storage() -> bool:
    mut empty: int[] = []
    mut builder = byte_buffer(empty)
    for i in range(64):
        _ = builder.append_byte(i)
    mut raw = bytes(builder)
    for i in range(32):
        _ = builder.append_byte(255)
    return len(raw) == 64 and reduce(raw, 17, 0) == indexed(raw, 17, 0) and len(builder) == 96
