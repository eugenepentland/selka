module byte_iteration_reductions


def reduce(raw: bytes, mask: int, seed: int) -> int:
    total = seed
    for value in raw:
        total += value ^ mask
    return total


def indexed(raw: bytes, mask: int, seed: int) -> int:
    total = seed
    for index in range(len(raw)):
        total += raw[index] ^ mask
    return total


public def test_byte_iteration_lengths_views_and_unbounded_masks() -> bool:
    masks = [0, 1, 127, 255, -1, 256, 1000003]
    for length in [0, 1, 15, 16, 17, 31, 32, 1024, 1041]:
        source = bytes([(i * 37 + 11) % 256 for i in range(length + 17)])
        raw = source[7:7 + length]
        for mask in masks:
            if reduce(raw, mask, 13) != indexed(raw, mask, 13):
                return False
    return reduce(b"", 255, -9223372036854775808) == -9223372036854775808


public def test_byte_iteration_keeps_immutable_snapshot_storage() -> bool:
    empty: list[int] = []
    builder = byte_buffer(empty)
    for i in range(64):
        _ = builder.append_byte(i)
    raw = bytes(builder)
    for i in range(32):
        _ = builder.append_byte(255)
    return len(raw) == 64 and reduce(raw, 17, 0) == indexed(raw, 17, 0) and len(builder) == 96

def pattern_sum(length: int, mask: int, seed: int) -> int:
    raw = bytes([(i * 37) % 256 for i in range(length)])
    total = seed
    for value in raw:
        total += value ^ mask
    return total


public def test_byte_iteration_sums_keep_exact_values_across_lengths() -> bool:
    assert reduce(b"abcd", 7, 13) == 415
    assert pattern_sum(0, 255, 13) == 13
    assert pattern_sum(1, 255, 13) == 268
    assert pattern_sum(15, 255, 13) == 2257
    assert pattern_sum(16, 255, 13) == 2469
    assert pattern_sum(17, 255, 13) == 2644
    assert pattern_sum(1024, 255, 13) == 130573
    assert pattern_sum(1041, 255, 13) == 133204
    return True


public def test_byte_iteration_keeps_exact_values_for_masks_beyond_a_byte_and_extreme_seeds() -> bool:
    assert pattern_sum(32, -1, 0) == -3536
    assert pattern_sum(32, 256, 0) == 11696
    assert pattern_sum(1, -9223372036854775807 - 1, 0) == -9223372036854775807 - 1
    assert pattern_sum(1, 9223372036854775807, 0) == 9223372036854775807
    assert pattern_sum(32, 0, -9223372036854775807 - 1) == -9223372036854772304
    assert pattern_sum(32, 0, 9223372036854775807 - 1000000) == 9223372036853779311
    return True
