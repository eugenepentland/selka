public func test_narrow_inputs_extend_and_integer_zero_is_positive() -> bool:
    mut a = -128i8
    mut b = -32768i16
    mut c = -2147483648i32
    mut d = 255u8
    mut e = 65535u16
    mut f = 4294967295u32
    mut zero = 0
    return float(a) == -128.0 and float(b) == -32768.0 and float(c) == -2147483648.0 and float(d) == 255.0 and float(e) == 65535.0 and float(f) == 4294967295.0 and divtrunc(1.0, float(zero)) > 0.0

func main() -> int:
    return 0
