# A plain `bytes` parameter takes a view (C9 bytes): a slice passed to it makes no copy, whether it is an inline
# argument, a const binding of a parameter passed on, a parameter forwarded through a hop, a function value or a
# generic instantiated at `bytes`. The octets are a literal, so every slice is a view of static bytes, and each shape
# allocates nothing per run.
import testing

const DATA: bytes = b"abcdefghijkl"


func bytes_view_params_take(data: bytes) -> int:
    return len(data) + int(data[0])


func forward(data: bytes) -> int:
    return bytes_view_params_take(data)


func apply(f: func(bytes) -> int, data: bytes) -> int:
    return f(data)


func generic_take[T: copy](value: T) -> int:
    _ = value
    return 1


# An inline slice argument.
func inline_slice(n: int) -> int:
    mut total = 0
    for i in range(n):
        total += bytes_view_params_take(DATA[i % 4:i % 4 + 2])
    return total


# A const slice binding of a parameter, passed on.
func const_binding(data: bytes, n: int) -> int:
    mut total = 0
    for i in range(n):
        const piece = data[i % 4:i % 4 + 2]
        total += bytes_view_params_take(piece)
    return total


func call_const_binding(n: int) -> int:
    return const_binding(DATA, n)


# A slice forwarded through a parameter that passes it to a `bytes` parameter.
func forwarded(n: int) -> int:
    mut total = 0
    for i in range(n):
        total += forward(DATA[i % 4:i % 4 + 2])
    return total


# A slice passed through a function value whose parameter is `bytes`.
func function_value(n: int) -> int:
    mut total = 0
    for i in range(n):
        total += apply(bytes_view_params_take, DATA[i % 4:i % 4 + 2])
    return total


# A slice passed to a generic instantiated at `bytes`.
func generic_at_bytes(n: int) -> int:
    mut total = 0
    for i in range(n):
        total += generic_take(DATA[i % 4:i % 4 + 2])
    return total


# spec: NEW-CORE-C9-BYTES-1
public func test_bytes_inline_slice_argument_makes_no_copy() -> bool:
    return testing.allocations(inline_slice, 100) == 0


# spec: NEW-CORE-C9-BYTES-1
public func test_bytes_const_slice_binding_passed_on_makes_no_copy() -> bool:
    return testing.allocations(call_const_binding, 100) == 0


# spec: NEW-CORE-C9-BYTES-1
public func test_bytes_slice_forwarded_through_a_parameter_makes_no_copy() -> bool:
    return testing.allocations(forwarded, 100) == 0


# spec: NEW-CORE-C9-BYTES-1
public func test_bytes_slice_passed_through_a_function_value_makes_no_copy() -> bool:
    return testing.allocations(function_value, 100) == 0


# spec: NEW-CORE-C9-BYTES-1
public func test_bytes_slice_passed_to_a_generic_at_bytes_makes_no_copy() -> bool:
    return testing.allocations(generic_at_bytes, 100) == 0


# spec: NEW-CORE-C9-BYTES-1
public func test_bytes_view_parameter_reads_the_octets_it_borrows() -> bool:
    return inline_slice(3) == 300 and forwarded(1) == 99 and generic_at_bytes(1) == 1
