module arena_regions

# Every arena allocation carries its depth in the header in front of it, so the
# store barrier, collection and `escape` never search the arena's chunks
# (SPEC.md ARENA-MANAGED-11). These programs put thousands of objects into one
# scope, so containers and values land in different chunks, and check that
# every store the barrier must accept is accepted and every value reads back.
# The test runner collects at every allocation (`--gc-stress`), which also
# walks every arena header on each collection.


record Tagged:
    name: str
    size: int


def labels(prefix: str, count: int) -> list[str]:
    items: list[str] = []
    for index in range(count):
        items.append(f"{prefix}{index}")
    return items


def put_all(target: mut list[str], values: list[str]) -> int:
    for value in values:
        target.append(value)
    return len(target)


def index_all(target: mut dict[str, int], values: list[str]) -> int:
    for value in values:
        target[value] = len(value)
    return len(target)


# spec: ARENA-MANAGED-11
public def test_arena_values_fill_an_arena_list_spanning_many_chunks() -> bool:
    ok = False
    with arena():
        items = labels("k", 3000)
        ok = len(items) == 3000 and items[0] == "k0" and items[1500] == "k1500" and items[2999] == "k2999"
    return ok


# spec-case: ARENA-MANAGED-11
public def test_collected_values_store_into_arena_lists_and_dictionaries() -> bool:
    outer = labels("o", 50)
    ok = False
    with arena():
        padding = labels("p", 2000)
        inner: list[str] = []
        stored = put_all(mut inner, outer)
        index: dict[str, int] = {}
        keys = index_all(mut index, outer)
        ok = stored == 50 and keys == 50 and inner[49] == "o49" and index["o7"] == 2 and len(padding) == 2000
    return ok and outer[49] == "o49"


# spec-case: ARENA-MANAGED-11
public def test_a_younger_arena_container_accepts_values_of_the_older_arena() -> bool:
    ok = False
    with arena():
        older = labels("a", 2000)
        inner_ok = False
        with arena():
            younger = labels("b", 2000)
            mixed: list[str] = []
            _ = put_all(mut mixed, older)
            _ = put_all(mut mixed, younger)
            inner_ok = len(mixed) == 4000 and mixed[0] == "a0" and mixed[1999] == "a1999" and mixed[3999] == "b1999"
        ok = inner_ok and older[1999] == "a1999"
    return ok


# spec-case: ARENA-MANAGED-11
public def test_records_holding_arena_text_store_into_an_arena_list() -> bool:
    total = 0
    with arena():
        rows: list[Tagged] = []
        for index in range(1500):
            rows.append(Tagged(name=f"r{index}", size=index))
        if rows[1499].name == "r1499" and rows[0].name == "r0":
            total = len(rows) + rows[1499].size
    return total == 1500 + 1499


# spec-case: ARENA-MANAGED-11
public def test_escape_copies_a_list_that_spans_many_chunks() -> bool:
    kept: list[str] = []
    with arena() as scratch:
        built = labels("e", 3000)
        kept = scratch.escape(built)
    return len(kept) == 3000 and kept[0] == "e0" and kept[1234] == "e1234" and kept[2999] == "e2999"


def main() -> int:
    return 0
