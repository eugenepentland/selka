# A slice bound to a `const` and returned must be the value the inline slice
# returns, including when the caller's argument came from concatenation. The
# bytes form materializes its owned result at the return; the text form is a
# view return of the one borrowable parameter. Regression for the B1 follow-up
# where the bound bytes form produced invalid Core IR only after concatenation.
func clean(source: bytes, start: int, stop: int) -> bytes:
    const raw = source[start:stop]
    return copy(raw)


func clean_inline(source: bytes, start: int, stop: int) -> bytes:
    return copy(source[start:stop])


func head(source: str, start: int, stop: int) -> str from source:
    const part = source[start:stop]
    return part


# spec-case: NEW-CORE-ZERO-RC-VIEWS-1
public func test_bound_bytes_slice_return_matches_the_inline_form() -> bool:
    mut data = b"abcd"
    data = data + b"efgh"
    const bound = clean(data, 0, 8)
    const inline = clean_inline(data, 0, 8)
    if len(bound) != 8 or bound != b"abcdefgh" or bound != inline:
        return False
    const tail = clean(data, 2, 5)
    return len(tail) == 3 and tail == b"cde"


# spec-case: NEW-CORE-ZERO-RC-VIEWS-1
public func test_bound_text_slice_return_reads_the_borrowed_source() -> bool:
    mut text = "ab" + "cd"
    const part = head(text, 1, 3)
    if part != "bc":
        return False
    return len(part) == 2 and text == "abcd"
