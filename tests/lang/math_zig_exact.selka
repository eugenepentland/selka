# The special cases Zig documents for ln, atan, acos and asin, read straight from the functions.
public func test_ln_atan_acos_asin_follow_zigs_documented_cases() -> bool:
    assert math.ln(1.0) == 0.0 and math.bits(math.ln(1.0)) == math.bits(0.0)
    assert math.ln(0.0) == -math.infinity() and math.ln(-0.0) == -math.infinity()
    assert math.is_nan(math.ln(-1.0)) and math.is_nan(math.ln(math.nan())) and math.is_nan(math.ln(-math.infinity()))
    assert math.ln(math.infinity()) == math.infinity()
    assert math.atan(math.infinity()) == math.pi() / 2.0 and math.atan(-math.infinity()) == -math.pi() / 2.0
    assert math.bits(math.atan(-0.0)) == math.bits(-0.0) and math.bits(math.atan(0.0)) == math.bits(0.0)
    assert math.atan(1.0) == math.pi() / 4.0 and math.is_nan(math.atan(math.nan()))
    assert math.atan(1.0e300) == math.pi() / 2.0
    assert math.acos(1.0) == 0.0 and math.bits(math.acos(-1.0)) == math.bits(math.pi())
    assert math.acos(0.0) == math.pi() / 2.0
    assert math.is_nan(math.acos(1.0000000000000002)) and math.is_nan(math.acos(-2.0)) and math.is_nan(math.acos(math.nan()))
    assert math.is_nan(math.acos(math.infinity()))
    assert math.asin(1.0) == math.pi() / 2.0 and math.asin(-1.0) == -math.pi() / 2.0
    assert math.bits(math.asin(-0.0)) == math.bits(-0.0) and math.bits(math.asin(0.0)) == math.bits(0.0)
    assert math.asin(5.0e-324) == 5.0e-324 and math.asin(-5.0e-324) == -5.0e-324
    assert math.is_nan(math.asin(2.0)) and math.is_nan(math.asin(-1.0000000000000002)) and math.is_nan(math.asin(math.nan()))
    return True


# The special cases Zig documents for expm1, sinh, cosh, tanh and cbrt.
public func test_expm1_hyperbolics_and_cbrt_follow_zigs_documented_cases() -> bool:
    assert math.expm1(0.0) == 0.0 and math.bits(math.expm1(-0.0)) == math.bits(-0.0)
    assert math.expm1(-math.infinity()) == -1.0 and math.expm1(-60.0) == -1.0
    assert math.expm1(math.infinity()) == math.infinity() and math.expm1(710.0) == math.infinity()
    assert math.is_nan(math.expm1(math.nan()))
    assert math.sinh(0.0) == 0.0 and math.bits(math.sinh(-0.0)) == math.bits(-0.0)
    assert math.sinh(math.infinity()) == math.infinity() and math.sinh(-math.infinity()) == -math.infinity()
    assert math.sinh(1000.0) == math.infinity() and math.sinh(-1000.0) == -math.infinity()
    assert math.is_nan(math.sinh(math.nan()))
    assert math.cosh(0.0) == 1.0 and math.cosh(-0.0) == 1.0
    assert math.cosh(math.infinity()) == math.infinity() and math.cosh(-math.infinity()) == math.infinity()
    assert math.cosh(1000.0) == math.infinity() and math.is_nan(math.cosh(math.nan()))
    assert math.tanh(0.0) == 0.0 and math.bits(math.tanh(-0.0)) == math.bits(-0.0)
    assert math.tanh(math.infinity()) == 1.0 and math.tanh(-math.infinity()) == -1.0
    assert math.tanh(100.0) == 1.0 and math.tanh(-100.0) == -1.0 and math.is_nan(math.tanh(math.nan()))
    assert math.cbrt(27.0) == 3.0 and math.cbrt(-8.0) == -2.0 and math.cbrt(1.0) == 1.0
    assert math.bits(math.cbrt(0.0)) == math.bits(0.0) and math.bits(math.cbrt(-0.0)) == math.bits(-0.0)
    assert math.cbrt(math.infinity()) == math.infinity() and math.cbrt(-math.infinity()) == -math.infinity()
    assert math.is_nan(math.cbrt(math.nan()))
    return True


# sin, cos and tan: signed zeros, subnormals, the nonfinite arguments, and reduction of the largest finite one without a trap.
public func test_sin_cos_tan_follow_zigs_documented_cases() -> bool:
    assert math.bits(math.sin(-0.0)) == math.bits(-0.0) and math.bits(math.tan(-0.0)) == math.bits(-0.0)
    assert math.cos(-0.0) == 1.0 and math.cos(5.0e-324) == 1.0 and math.tan(5.0e-324) == 5.0e-324
    assert math.sin(5.0e-324) == 5.0e-324 and math.sin(-5.0e-324) == -5.0e-324
    assert math.is_nan(math.sin(math.infinity())) and math.is_nan(math.cos(-math.infinity())) and math.is_nan(math.tan(math.infinity()))
    assert math.is_nan(math.sin(math.nan())) and math.is_nan(math.cos(math.nan())) and math.is_nan(math.tan(math.nan()))
    assert math.sin(math.pi() / 2.0) == 1.0 and math.cos(math.pi()) == -1.0
    # Arguments past 2^20 * pi/2 take the Payne-Hanek reduction; none traps and the results stay in range.
    const huge = 1.7976931348623157e308
    assert math.fabs(math.sin(huge)) <= 1.0 and math.fabs(math.cos(huge)) <= 1.0 and math.is_finite(math.tan(huge))
    assert math.fabs(math.sin(-huge)) <= 1.0 and math.sin(-huge) == -math.sin(huge)
    assert math.cos(-huge) == math.cos(huge) and math.tan(-huge) == -math.tan(huge)
    return True
