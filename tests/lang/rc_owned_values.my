# Physical RC ownership shares these value semantics with the default collector.
func selected(items: int[]) -> int[]:
    return items.copy()


func mixed(items: int[], fresh: bool) -> int[]:
    if fresh:
        return [8, 9]
    return items.copy()


public func test_owned_return_survives_original_replacement() -> bool:
    mut values = [1, 2]
    mut other = selected(values)
    values = [3]
    return len(other) == 2 and other[0] == 1 and values[0] == 3


public func test_mixed_fresh_and_parameter_returns_own_their_results() -> bool:
    mut original = [4, 5]
    mut fresh = mixed(original, True)
    mut borrowed = mixed(original, False)
    original = [6]
    return fresh[0] == 8 and borrowed[0] == 4 and original[0] == 6


public func test_repeated_local_replacement_preserves_retained_value() -> bool:
    mut values = [1, 2]
    mut retained = values.copy()
    mut index = 0
    while index < 1000:
        values = [index]
        index += 1
    return len(retained) == 2 and retained[1] == 2 and values[0] == 999


public func test_list_mutation_preserves_owned_snapshot() -> bool:
    mut original = [1, 2]
    mut changed = original.copy()
    changed.append(3)
    changed[0] = 9
    return len(original) == 2 and original[0] == 1 and len(changed) == 3 and changed[0] == 9


public func test_dictionary_mutation_preserves_owned_snapshot() -> bool:
    mut original = {1: [1, 2]}
    mut changed = original.copy()
    changed[1] = [8]
    changed[2] = [3]
    return len(original) == 1 and len(original[1]) == 2 and changed[1][0] == 8


public func test_loop_mutation_rechecks_new_snapshot_owners() -> bool:
    mut values = [0]
    mut retained = values.copy()
    mut index = 0
    while index < 10:
        retained = values.copy()
        values.append(index)
        index += 1
    return len(retained) == 10 and len(values) == 11


public func test_nested_list_mutation_preserves_each_snapshot() -> bool:
    mut original = [[1, 2], [3]]
    mut child = original[0].copy()
    mut changed = original.copy()
    changed[0].append(4)
    return len(original[0]) == 2 and len(child) == 2 and len(changed[0]) == 3


public func test_nested_dictionary_value_mutation_preserves_snapshot() -> bool:
    mut original = {1: [1, 2]}
    mut changed = original.copy()
    changed[1].append(4)
    return len(original[1]) == 2 and len(changed[1]) == 3


func clear_pending_rows(mut rows: int[][]) -> int:
    rows.clear()
    return 7


public func test_clearing_parent_keeps_captured_receiver_alive() -> bool:
    mut rows = [[1]]
    mut selected_row = rows[0].copy()
    mut value = clear_pending_rows(mut rows)
    selected_row.append(value)
    return len(rows) == 0 and selected_row == [1, 7]
