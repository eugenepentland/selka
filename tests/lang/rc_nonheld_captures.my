# Canonical scalar-list captures remain distinct from real iterator holds.


def test_writes_then_iteration_preserve_snapshot() -> bool:
    flags = [True, True, True]
    saved = flags
    for at in range(20):
        flags[0] = False
    count = 0
    for flag in flags:
        if flag:
            count += 1
    return count == 2 and saved[0] and not flags[0]


def test_earlier_iteration_then_writes_preserve_identity() -> bool:
    flags = [True, True, False]
    count = 0
    for flag in flags:
        if flag:
            count += 1
    for at in range(12):
        flags[1] = False
    after = 0
    for flag in flags:
        if flag:
            after += 1
    return count == 2 and after == 1


def returned_flags() -> list[bool]:
    return [True, True]


def test_helper_return_is_published_before_capture() -> bool:
    flags = returned_flags()
    for at in range(8):
        flags[0] = False
    count = 0
    for flag in flags:
        if flag:
            count += 1
    return count == 1


def test_user_loop_copy_remains_independent() -> bool:
    groups = [[True, True], [True, True]]
    count = 0
    for element in groups:
        flags = element
        flags[0] = False
        for flag in flags:
            if flag:
                count += 1
    return count == 2 and groups[0][0] and groups[1][0]


def replace_index(flags: mut list[bool]) -> int:
    flags.clear()
    flags.append(True)
    flags.append(True)
    return 0


def test_call_then_source_rebind_preserves_values() -> bool:
    flags = [True, False]
    mutation_result_67 = replace_index(mut flags)
    flags[mutation_result_67] = False
    count = 0
    for flag in flags:
        if flag:
            count += 1
    flags = [True, True, True]
    flags[1] = False
    second = 0
    for flag in flags:
        if flag:
            second += 1
    return count == 1 and second == 2


def mutate_parameter(flags: mut list[bool]) -> int:
    flags[0] = False
    count = 0
    for flag in flags:
        if flag:
            count += 1
    return count


def test_parameter_snapshot_and_arena_cleanup() -> bool:
    flags = [True, True]
    saved = flags
    count = 0
    with arena():
        count = mutate_parameter(mut flags)
        local = [True, True, False]
        local[0] = False
        for flag in local:
            if flag:
                count += 1
    return count == 2 and saved[0] and not flags[0]


def test_named_source_iteration_sees_element_changes() -> bool:
    flags = [True, True]
    count = 0
    for flag in flags:
        if flag:
            count += 1
        flags[1] = False
    return count == 1 and not flags[1]


def main() -> int:
    if not test_writes_then_iteration_preserve_snapshot():
        return 1
    if not test_earlier_iteration_then_writes_preserve_identity():
        return 2
    if not test_helper_return_is_published_before_capture():
        return 3
    if not test_user_loop_copy_remains_independent():
        return 4
    if not test_call_then_source_rebind_preserves_values():
        return 5
    if not test_parameter_snapshot_and_arena_cleanup():
        return 6
    if not test_named_source_iteration_sees_element_changes():
        return 7
    return 0
