# Fixed arrays written, iterated and passed `mut` with the list spelling
# (PY-ARRAY-WRITE-1, PY-ARRAY-ITER-1, PY-ARRAY-MUT-1). Every write keeps the
# value semantics of `replace`: an earlier copy keeps its value, a callee
# handed a plain array writes its own copy, and a `mut` parameter is the
# caller's own variable. The traced element types run under `--gc-stress`.
enum Status:
    ok
    missing
    failed


record Point:
    x: i64
    y: i64


record Segment:
    start: Point
    end: Point


record Bag:
    items: str[]
    tag: str


record Grid:
    cells: FixedArray[i64, 4]
    label: str


record Board:
    cells: FixedArray[i64, 3]


func sum4(values: FixedArray[i64, 4]) -> i64:
    return values[0] + values[1] + values[2] + values[3]


func label(index: i64) -> str:
    return "w" + str(index)


func churn(rounds: i64) -> i64:
    mut total = 0
    for round in range(rounds):
        mut scratch = [for k in range(8) yield str(k)]
        total += len(scratch) + round
    return total


func fill(mut values: FixedArray[i64, 4], start: i64) -> Unit:
    for index in range(4):
        values[index] = start + index


func fill_then_bump(mut values: FixedArray[i64, 4]) -> Unit:
    fill(mut values, 10)
    values[3] += 100


func move_first(mut points: FixedArray[Point, 2], dx: i64) -> Unit:
    points[0].x = points[0].x + dx


func stamp(mut words: FixedArray[str, 3], round: i64) -> Unit:
    for index in range(3):
        words[index] = label(round * 10 + index)
        _ = churn(2)


func grow(mut bags: FixedArray[Bag, 2], word: str) -> Unit:
    bags[0].items.append(word)
    bags[1] = Bag(items=[word, word], tag=word + "!")


func reverse_into(mut target: FixedArray[i64, 4], source: FixedArray[i64, 4]) -> Unit:
    for index in range(4):
        target[index] = source[3 - index]


func local_copy_write(values: FixedArray[i64, 4]) -> i64:
    mut copy = values
    copy[0] = 100
    return copy[0] + values[0]


func side_effect(mut values: FixedArray[i64, 4]) -> i64:
    values[1] = 50
    return 7


# spec: PY-ARRAY-WRITE-1
public func test_an_element_write_changes_one_element_and_leaves_an_earlier_copy() -> bool:
    mut values: FixedArray[i64, 4] = FixedArray[int, 4]([1, 2, 3, 4])
    mut before = values
    values[2] = 30
    return values[0] == 1 and values[2] == 30 and before[2] == 3 and sum4(before) == 10


# spec-case: PY-ARRAY-WRITE-1
public func test_augmented_element_writes_combine_with_the_old_element() -> bool:
    mut values: FixedArray[i64, 4] = FixedArray[int, 4]([1, 2, 3, 4])
    values[0] += 10
    values[1] -= 2
    values[2] *= 5
    values[3] //= 2
    return values[0] == 11 and values[1] == 0 and values[2] == 15 and values[3] == 2


# spec-case: PY-ARRAY-WRITE-1
public func test_a_loop_of_element_writes_fills_every_slot() -> bool:
    mut values: FixedArray[i64, 4] = FixedArray[int, 4]([0, 0, 0, 0])
    for index in range(4):
        values[index] = index * index
    return values[0] == 0 and values[1] == 1 and values[2] == 4 and values[3] == 9


# spec-case: PY-ARRAY-WRITE-1
public func test_a_field_of_one_element_is_written_in_place() -> bool:
    mut points: FixedArray[Point, 2] = FixedArray[Point, 2]([Point(x=1, y=2), Point(x=3, y=4)])
    points[1].y = 40
    points[0].x = points[0].x + 5
    return points[0].x == 6 and points[0].y == 2 and points[1].x == 3 and points[1].y == 40


# spec-case: PY-ARRAY-WRITE-1
public func test_a_nested_field_path_below_an_element_is_written() -> bool:
    mut segments: FixedArray[Segment, 2] = FixedArray[Segment, 2]([Segment(start=Point(x=0, y=0), end=Point(x=1, y=1)), Segment(start=Point(x=2, y=2), end=Point(x=3, y=3))])
    segments[1].end.y = 30
    return segments[1].end.y == 30 and segments[1].end.x == 3 and segments[0].end.y == 1


# spec-case: PY-ARRAY-WRITE-1
public func test_an_array_of_arrays_writes_one_cell_and_copies_one_row() -> bool:
    mut grid: FixedArray[FixedArray[i64, 3], 2] = FixedArray[FixedArray[int, 3], 2]([FixedArray[int, 3]([1, 2, 3]), FixedArray[int, 3]([4, 5, 6])])
    grid[1][2] = 60
    grid[0] = grid[1]
    grid[0][0] = 40
    return grid[0][0] == 40 and grid[0][2] == 60 and grid[1][0] == 4 and grid[1][2] == 60


# spec-case: PY-ARRAY-WRITE-1
public func test_an_array_field_of_a_record_is_written_and_a_copy_is_not() -> bool:
    mut grid = Grid(cells=FixedArray[int, 4]([1, 2, 3, 4]), label="g")
    mut copy = grid
    grid.cells[0] = 100
    return grid.cells[0] == 100 and copy.cells[0] == 1 and grid.label == "g"


# spec-case: PY-ARRAY-WRITE-1
public func test_an_array_field_of_a_record_is_copied_for_each_name() -> bool:
    mut board = Board(cells=FixedArray[int, 3]([1, 2, 3]))
    mut alias = board
    alias.cells[2] = 30
    return board.cells[2] == 3 and alias.cells[2] == 30 and board.cells[0] == 1


# spec-case: PY-ARRAY-WRITE-1
public func test_an_array_inside_a_list_slot_is_written_where_the_list_holds_it() -> bool:
    mut rows: FixedArray[i64, 2][] = [FixedArray[int, 2]([1, 2]), FixedArray[int, 2]([3, 4])]
    rows[1][0] = 30
    mut grids: Grid[] = [Grid(cells=FixedArray[int, 4]([0, 0, 0, 0]), label="a")]
    grids[0].cells[3] = 9
    return rows[1][0] == 30 and rows[0][0] == 1 and grids[0].cells[3] == 9


# spec-case: PY-ARRAY-WRITE-1
public func test_an_enum_table_entry_is_written_by_its_key() -> bool:
    mut codes: [Status] i64 = {Status.failed: 500, Status.ok: 200, Status.missing: 404}
    codes[Status.ok] = 201
    codes[Status.failed] += 1
    return codes[Status.ok] == 201 and codes[Status.missing] == 404 and codes[Status.failed] == 501


# spec-case: PY-ARRAY-WRITE-1
public func test_an_array_parameter_written_after_a_local_copy_leaves_the_caller_alone() -> bool:
    mut values: FixedArray[i64, 4] = FixedArray[int, 4]([1, 2, 3, 4])
    return local_copy_write(values) == 101 and values[0] == 1


# spec-case: PY-ARRAY-WRITE-1
public func test_the_value_is_computed_before_the_array_is_read() -> bool:
    mut values: FixedArray[i64, 4] = FixedArray[int, 4]([1, 2, 3, 4])
    mut mutation_result_189 = side_effect(mut values)
    values[0] = mutation_result_189
    return values[0] == 7 and values[1] == 50


# spec-case: PY-ARRAY-WRITE-1
public func test_traced_elements_written_one_at_a_time_survive_collection() -> bool:
    mut words: FixedArray[str, 3] = FixedArray[str, 3](["a", "b", "c"])
    mut before = words
    for index in range(3):
        words[index] = label(index) + words[index]
        _ = churn(3)
    mut grid: FixedArray[FixedArray[str, 2], 2] = FixedArray[FixedArray[str, 2], 2]([FixedArray[str, 2](["p", "q"]), FixedArray[str, 2](["r", "s"])])
    grid[1][0] = label(7)
    _ = churn(3)
    return words[0] == "w0a" and words[2] == "w2c" and before[1] == "b" and grid[1][0] == "w7" and grid[0][1] == "q"


# spec: PY-ARRAY-ITER-1
public func test_a_for_loop_walks_every_element_in_order() -> bool:
    mut values: FixedArray[i64, 4] = FixedArray[int, 4]([3, 1, 4, 1])
    mut total = 0
    mut order = 0
    for value in values:
        total += value
        order = order * 10 + value
    return total == 9 and order == 3141


# spec-case: PY-ARRAY-ITER-1
public func test_enumerate_and_a_comprehension_walk_an_array() -> bool:
    mut values: FixedArray[i64, 3] = FixedArray[int, 3]([5, 6, 7])
    mut weighted = 0
    for index, value in enumerate(values):
        weighted += index * value
    mut squares = [for value in values if value != 6 yield value * value]
    return weighted == 20 and len(squares) == 2 and squares[0] == 25 and squares[1] == 49


# spec-case: PY-ARRAY-ITER-1
public func test_a_loop_reads_later_writes_to_the_array_place() -> bool:
    mut values: FixedArray[i64, 3] = FixedArray[int, 3]([1, 2, 3])
    mut saved = values
    mut seen = 0
    for value in values:
        values[2] = 100
        seen = seen * 10 + value
    return seen == 220 and values[2] == 100 and saved[2] == 3


# spec-case: PY-ARRAY-ITER-1
public func test_a_loop_over_traced_elements_survives_collection() -> bool:
    mut words: FixedArray[str, 3] = FixedArray[str, 3](["x", "y", "z"])
    mut joined = ""
    for word in words:
        _ = churn(2)
        joined = joined + word
    return joined == "xyz"


# spec: PY-ARRAY-MUT-1
public func test_a_mut_array_parameter_writes_the_callers_array() -> bool:
    mut values: FixedArray[i64, 4] = FixedArray[int, 4]([0, 0, 0, 0])
    mut before = values
    fill(mut values, 5)
    return values[0] == 5 and values[3] == 8 and before[3] == 0


# spec-case: PY-ARRAY-MUT-1
public func test_a_mut_array_parameter_passed_on_writes_the_first_callers_array() -> bool:
    mut values: FixedArray[i64, 4] = FixedArray[int, 4]([0, 0, 0, 0])
    fill_then_bump(mut values)
    return values[0] == 10 and values[3] == 113


# spec-case: PY-ARRAY-MUT-1
public func test_a_field_write_through_a_mut_array_of_records_reaches_the_caller() -> bool:
    mut points: FixedArray[Point, 2] = FixedArray[Point, 2]([Point(x=0, y=0), Point(x=5, y=5)])
    move_first(mut points, 3)
    move_first(mut points, 4)
    return points[0].x == 7 and points[1].x == 5


# spec-case: PY-ARRAY-MUT-1
public func test_a_read_only_argument_of_the_same_array_is_a_snapshot() -> bool:
    mut values: FixedArray[i64, 4] = FixedArray[int, 4]([1, 2, 3, 4])
    reverse_into(mut values, values)
    return values[0] == 4 and values[1] == 3 and values[2] == 2 and values[3] == 1


# spec-case: PY-ARRAY-MUT-1
public func test_managed_values_a_callee_stores_stay_rooted_in_the_caller() -> bool:
    mut words: FixedArray[str, 3] = FixedArray[str, 3](["a", "b", "c"])
    for round in range(3):
        stamp(mut words, round)
        _ = churn(4)
    mut bags: FixedArray[Bag, 2] = FixedArray[Bag, 2]([Bag(items=[], tag="x"), Bag(items=[], tag="y")])
    for index in range(4):
        grow(mut bags, label(index))
        _ = churn(4)
    return words[0] == "w20" and words[2] == "w22" and len(bags[0].items) == 4 and bags[1].items[1] == "w3" and bags[1].tag == "w3!"
