record Packet:
    tag: str
    body: byte_buffer


func buffer_of(data: bytes) -> byte_buffer:
    mut empty: int[] = []
    mut buffer = byte_buffer(empty)
    _ = buffer.append_range(data, 0, len(data))
    return buffer


func widest(values: int[]) -> byte_buffer:
    return byte_buffer(values)


func buffer_pair[T: copy + storable](buffer: byte_buffer) -> byte_buffer[]:
    mut both: byte_buffer[] = [buffer, buffer]
    both.append(buffer)
    if len(buffer) < 0:
        return both
    return both


# The mutable octet buffer accepts every fragment kind, refuses an out-of-range
# or misordered request without writing, and reads back exactly what it wrote.
# spec-case: PY-BYTES-6
public func test_append_methods_write_in_place_and_refuse_without_writing() -> bool:
    mut empty: int[] = []
    mut buffer = byte_buffer(empty)
    if len(buffer) != 0 or buffer != b"":
        return False
    if not buffer.append_byte(65):
        return False
    if not buffer.append_range(b"0123456789", 1, 4):
        return False
    if not buffer.append_utf8("λ"):
        return False
    if not buffer.append_int(0 - 7):
        return False
    if buffer != b"A123\xce\xbb-7":
        return False
    if buffer.append_byte(256) or buffer.append_byte(0 - 1):
        return False
    if buffer.append_range(b"0123456789", 0 - 1, 3):
        return False
    if buffer.append_range(b"0123456789", 4, 3):
        return False
    if buffer.append_range(b"0123456789", 4, 11):
        return False
    if buffer.reserve(0 - 1):
        return False
    if buffer != b"A123\xce\xbb-7":
        return False
    if not buffer.append_range(b"0123456789", 4, 4):
        return False
    if not buffer.reserve(0):
        return False
    if buffer != b"A123\xce\xbb-7":
        return False
    return buffer[0] == 65 and len(buffer) == 8


# A buffer update can be stored back explicitly; an immutable snapshot taken
# before the append remains unchanged.
# spec-case: PY-BYTES-6
public func test_a_buffer_storeback_preserves_an_earlier_snapshot() -> bool:
    mut empty: int[] = []
    mut buffer = byte_buffer(empty)
    _ = buffer.append_range(b"seed", 0, 4)
    mut alias = buffer
    if len(alias) != 4 or alias != b"seed":
        return False
    mut snapshot = bytes(buffer)
    if not alias.append_byte(33):
        return False
    buffer = alias
    if buffer != b"seed!" or alias != b"seed!":
        return False
    if snapshot != b"seed" or len(snapshot) != 4:
        return False
    if snapshot == buffer:
        return False
    return snapshot != alias


# Growth past several capacity doublings keeps the content and identity, and
# every earlier immutable snapshot stays byte-for-byte what it was.
# spec-case: PY-BYTES-6
public func test_growth_preserves_identity_content_and_earlier_snapshots() -> bool:
    mut empty: int[] = []
    mut buffer = byte_buffer(empty)
    if not buffer.reserve(4096):
        return False
    mut early = bytes(buffer)
    mut total = 0
    mut index = 0
    while index < 5000:
        if not buffer.append_byte(index % 256):
            return False
        total += index % 256
        index += 1
    if len(buffer) != 5000 or total != 629340:
        return False
    if not buffer.append_utf8("λ"):
        return False
    if not buffer.append_int(0 - 5000):
        return False
    mut tail = bytes(buffer[5000:len(buffer)])
    if tail != b"\xce\xbb-5000":
        return False
    if len(early) != 0 or buffer[4999] != 4999 % 256 or buffer[5000] != 206:
        return False
    return buffer[0] == 0 and buffer[255] == 255


# The two byte kinds compare by content with each other, and the mutable one
# keeps every read operation of the immutable one.
# spec-case: PY-BYTES-6
public func test_byte_kinds_share_reads_and_compare_by_content() -> bool:
    mut buffer = buffer_of(b"needle-in-haystack")
    mut immutable = b"needle-in-haystack"
    if buffer != immutable or immutable != buffer:
        return False
    if buffer.find(b"-") != 6 or buffer.find_any(b"-", 7) != 9:
        return False
    if not buffer.startswith(b"needle") or not buffer.endswith(b"stack"):
        return False
    if b"-" not in buffer or b"hay" not in buffer:
        return False
    if buffer[0:6] != b"needle":
        return False
    if not buffer.append_byte(33):
        return False
    if buffer == immutable:
        return False
    if immutable != b"needle-in-haystack":
        return False
    match buffer.decode():
        case Ok(text):
            return text == "needle-in-haystack!"
        case Err(_):
            return False


# A buffer survives collection at every allocation and can be stored back into
# a record field or list slot after a local mutation.
# spec-case: PY-BYTES-6
public func test_buffers_are_traced_through_record_fields_lists_and_generics() -> bool:
    mut packet = Packet(tag="head", body=buffer_of(b"body"))
    if packet.body != b"body":
        return False
    mut body = packet.body
    if not body.append_byte(33):
        return False
    packet.body = body
    if packet.body != b"body!" or packet.tag != "head":
        return False
    mut both = buffer_pair[i64](buffer_of(b"7"))
    both[1] = buffer_of(b"7")
    both[2] = buffer_of(b"7")
    if len(both) != 3:
        return False
    if both[0] != b"7" or both[2] != b"7":
        return False
    mut index = 0
    mut first = both[0]
    while index < 200:
        _ = first.append_byte(index % 256)
        index += 1
    both[0] = first
    if len(both[0]) != 201 or len(both[1]) != 1 or len(both[2]) != 1:
        return False
    return both[0][0] == 55 and both[0][200] == 199 and both[2][0] == 55


# A buffer built from an integer list carries exactly those octets, and an
# empty list builds the empty buffer.
# spec-case: PY-BYTES-6
public func test_byte_buffer_builds_from_an_integer_list() -> bool:
    mut values: int[] = [0, 65, 255]
    mut buffer = widest(values)
    if len(buffer) != 3 or buffer != b"\x00A\xff":
        return False
    if not buffer.append_byte(66):
        return False
    if len(values) != 3 or buffer != b"\x00A\xffB":
        return False
    mut empty: int[] = []
    if len(byte_buffer(empty)) != 0:
        return False
    return buffer.to_list() == [0, 65, 255, 66]


# The float append writes exactly the spelling `str(value)` prints, computed into
# the buffer's own capacity, and a buffer that already holds text keeps it.
# spec-case: PY-BYTES-6
public func test_append_float_matches_the_printed_spelling() -> bool:
    mut values: float[] = [0.1, 1.0, 2.5, 1.0 / 3.0, 1e300, 1e-300, 0.0 - 2.5e-7, 123456789.0]
    mut empty: int[] = []
    mut index = 0
    while index < len(values):
        mut value = values[index]
        mut piece = byte_buffer(empty)
        if not piece.append_float(value):
            return False
        if bytes(piece) != str(value).encode():
            return False
        if not piece.append_float(value):
            return False
        if bytes(piece) != str(value).encode() + str(value).encode():
            return False
        index += 1
    mut seeded = byte_buffer(empty)
    if not seeded.append_range(b"area=", 0, 5):
        return False
    if not seeded.append_float(2.5):
        return False
    if not seeded.append_utf8("mm"):
        return False
    if bytes(seeded) != b"area=2.5mm":
        return False
    mut huge = 1e300 * 1e300
    mut infinite = byte_buffer(empty)
    if not infinite.append_float(huge):
        return False
    if not infinite.append_byte(44):
        return False
    if not infinite.append_float(0.0 - huge):
        return False
    if bytes(infinite) != b"inf,-inf":
        return False
    return len(bytes(seeded)) == 10


# A backing that outgrows the size classes grows by extending its own
# reservation, so every octet written before the growth is still there after it,
# while the grown value's length and element descriptor are unchanged.
# spec: BUFFER-GROWTH-1
public func test_growth_past_the_segment_threshold_keeps_every_octet() -> bool:
    mut seed = byte_buffer([for index in range(65536) yield index % 256])
    if len(seed) != 65536:
        return False
    mut empty: int[] = []
    mut buffer = byte_buffer(empty)
    mut writes = 0
    while writes < 6:
        if not buffer.append_range(seed, 0, 65536):
            return False
        writes += 1
    if len(buffer) != 6 * 65536:
        return False
    mut check = 0
    while check < 6 * 65536:
        if buffer[check] != check % 256:
            return False
        check += 1021
    if not buffer.append_byte(7):
        return False
    if buffer[6 * 65536] != 7:
        return False
    return buffer[6 * 65536 - 1] == 255
