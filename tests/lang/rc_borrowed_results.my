record Span:
    source: bytes
    start: int


record Node:
    span: Span
    next: int


func empty() -> Span:
    return Span(source=b"", start=0)


func at(nodes: Node[], index: int) -> Node:
    if index < 0 or index >= len(nodes):
        return Node(span=empty(), next=len(nodes))
    return nodes[index]


func octets(node: Node) -> bytes:
    return node.span.source


func invoke(reader: func(Node[], int) -> Node, nodes: Node[], index: int) -> Node:
    return reader(nodes, index)


public func test_borrowed_projection_survives_anchor_clear() -> bool:
    mut source = b"alpha" + b"-tail"
    mut nodes = [Node(span=Span(source=source, start=2), next=1)]
    mut selected = at(nodes, 0)
    mut retained = octets(selected)
    nodes.clear()
    selected = Node(span=empty(), next=0)
    source = b"replacement"
    return retained == b"alpha-tail"


public func test_immortal_fallback_copies_inline_result_bits() -> bool:
    mut nodes = [Node(span=Span(source=b"allocated" + b"-source", start=3), next=1)]
    mut negative = at(nodes, -1)
    mut past = at(nodes, 1)
    nodes.clear()
    return negative.span.source == b"" and past.span.source == b"" and negative.next == 1 and past.next == 1


public func test_indirect_accessor_keeps_canonical_owned_result() -> bool:
    mut nodes = [Node(span=Span(source=b"owned" + b"-result", start=4), next=1)]
    mut selected = invoke(at, nodes, 0)
    nodes.clear()
    return selected.span.source == b"owned-result" and selected.span.start == 4


public func test_repeated_borrowed_projection_keeps_source_live() -> bool:
    mut nodes = [Node(span=Span(source=b"repeat" + b"-me", start=2), next=1)]
    mut total = 0
    for index in range(300):
        mut selected = at(nodes, 0)
        total += len(octets(selected))
    return total == 2700 and nodes[0].span.source == b"repeat-me"


func main() -> int:
    if not test_borrowed_projection_survives_anchor_clear():
        return 1
    if not test_immortal_fallback_copies_inline_result_bits():
        return 2
    if not test_indirect_accessor_keeps_canonical_owned_result():
        return 3
    if not test_repeated_borrowed_projection_keeps_source_live():
        return 4
    return 0
