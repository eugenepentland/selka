import math

func close(a: float, b: float) -> bool:
    return math.fabs(a - b) < 1.0e-15


func generic_wave[T](value: float, tag: T) -> float:
    _ = tag
    return math.sin(value) + math.cos(value)


# spec: STANDARD-MATH-TRIG-1
public func test_principal_angles_and_finite_range_reduction() -> bool:
    assert math.sin(0.0) == 0.0 and math.cos(0.0) == 1.0
    assert math.sin(math.pi() / 2.0) == 1.0
    assert math.cos(math.pi()) == -1.0
    assert close(math.sin(math.pi() / 6.0), 0.5)
    assert close(math.cos(math.pi() / 3.0), 0.5)
    assert close(math.sin(1.0e300), -0.8178819121159085)
    assert close(math.cos(1.0e300), -0.5753861119575491)
    assert math.sin(-1.0) == -math.sin(1.0)
    assert math.cos(-1.0) == math.cos(1.0)
    return True


# spec-case: STANDARD-MATH-TRIG-1
public func test_zero_sign_subnormal_and_nonfinite_arguments() -> bool:
    assert str(math.sin(-0.0)) == "-0.0"
    assert str(math.cos(-0.0)) == "1.0"
    assert math.sin(5.0e-324) == 5.0e-324
    assert math.sin(-5.0e-324) == -5.0e-324
    assert math.cos(5.0e-324) == 1.0
    assert math.is_nan(math.sin(math.infinity()))
    assert math.is_nan(math.cos(-math.infinity()))
    assert math.is_nan(math.sin(math.nan()))
    assert math.is_nan(math.cos(math.nan()))
    return True


# spec-case: STANDARD-MATH-TRIG-1
public func test_rotated_paste_window_preserves_native_geometry() -> bool:
    mut angle = 45.0 * math.pi() / 180.0
    mut x = 3.0 + 2.0 * math.cos(angle) - 1.0 * math.sin(angle)
    mut y = 4.0 + 2.0 * math.sin(angle) + 1.0 * math.cos(angle)
    assert close(x, 3.7071067811865475)
    assert close(y, 6.121320343559643)
    return True


# spec-case: STANDARD-MATH-TRIG-1
public func test_generic_trigonometry_uses_the_public_wrappers() -> bool:
    assert generic_wave[int](0.0, 1) == 1.0
    assert close(generic_wave[bool](math.pi() / 2.0, True), 1.0)
    assert math.is_nan(generic_wave[bytes](math.infinity(), b"tag"))
    return True
