
# f-string format specifications and `round(x, n)`, each expected value the one
# CPython 3.14 prints for the same expression. The exhaustive CPython oracle
# (about 7,700 rows) runs in src/format_spec_test.zig; these tests pin the
# language path end to end: parsing, checking, lowering and the native runtime.


func money(x: float) -> str:
    return f"{x:.2f}"


# spec: PY-FSTRING-SPEC-1
public func test_fixed_precision_rounds_the_exact_binary_value_to_even() -> bool:
    if [money(3.14159), money(2.675), money(0.125), money(0.375), money(-0.001), money(1e16)] != ["3.14", "2.67", "0.12", "0.38", "-0.00", "10000000000000000.00"]:
        return False
    mut x = 3.14159
    if [f"{x:.0f}", f"{0.5:.0f}", f"{1.5:.0f}", f"{2.5:.0f}", f"{9.9995:.3f}", f"{x:f}"] != ["3", "0", "2", "2", "9.999", "3.141590"]:
        return False
    return f"{x:.2f}" == "3.14" and f"total {x:.1f} units" == "total 3.1 units"


# spec-case: PY-FSTRING-SPEC-1
public func test_width_fill_alignment_and_sign_lay_a_number_out() -> bool:
    mut n = 42
    mut x = 3.14159
    if [f"{n:05d}", f"{n:>6}", f"{n:<6}|", f"{n:^7}", f"{n:*^9}", f"{-n:=+8}", f"{n:+}", f"{n: }"] != ["00042", "    42", "42    |", "  42   ", "***42****", "-     42", "+42", " 42"]:
        return False
    if [f"{x:^10.3f}", f"{x:>10}", f"{x:010.2f}", f"{-x:+.3f}", f"{x:<8.1f}|"] != ["  3.142   ", "   3.14159", "0000003.14", "-3.142", "3.1     |"]:
        return False
    mut small: u8 = 7
    return f"{small:03}" == "007" and f"{-0.0:z.1f}" == "0.0"


# spec-case: PY-FSTRING-SPEC-1
public func test_grouping_and_radix_types_match_python() -> bool:
    mut big = 1234567
    if [f"{big:,}", f"{big:_}", f"{1234567.891:,.2f}", f"{1:08,}", f"{1234:010,}"] != ["1,234,567", "1_234_567", "1,234,567.89", "0,000,001", "00,001,234"]:
        return False
    if [f"{255:x}", f"{255:X}", f"{255:#x}", f"{255:#010x}", f"{8:o}", f"{8:#o}", f"{10:b}", f"{255:_b}", f"{-255:#X}"] != ["ff", "FF", "0xff", "0x000000ff", "10", "0o10", "1010", "1111_1111", "-0XFF"]:
        return False
    mut top: u64 = 18446744073709551615
    return f"{top:,}" == "18,446,744,073,709,551,615" and f"{top:_x}" == "ffff_ffff_ffff_ffff"


# spec-case: PY-FSTRING-SPEC-1
public func test_exponent_general_and_percent_types_match_python() -> bool:
    mut x = 1234.5678
    if [f"{x:e}", f"{x:.2e}", f"{x:E}", f"{x:g}", f"{x:.3g}", f"{0.00001234:g}", f"{1e20:g}", f"{x:G}"] != ["1.234568e+03", "1.23e+03", "1.234568E+03", "1234.57", "1.23e+03", "1.234e-05", "1e+20", "1234.57"]:
        return False
    if [f"{0.5:%}", f"{0.125:.1%}", f"{0.25:.0%}", f"{7:e}", f"{5:.2f}", f"{1e16:.0e}", f"{123.0:.3}", f"{12.0:.3}"] != ["50.000000%", "12.5%", "25%", "7.000000e+00", "5.00", "1e+16", "1.23e+02", "12.0"]:
        return False
    mut inf = 1.0 / 0.0
    return f"{inf:.2f}" == "inf" and f"{-inf:+}" == "-inf" and f"{inf:F}" == "INF"


# spec-case: PY-FSTRING-SPEC-1
public func test_text_pads_and_truncates_by_scalar() -> bool:
    mut name = "héllo"
    if [f"{name:>8}", f"{name:<8}|", f"{name:^9}", f"{name:*^9}", f"{name:.3}", f"{name:>8.3}", f"{name:s}"] != ["   héllo", "héllo   |", "  héllo  ", "**héllo**", "hél", "     hél", "héllo"]:
        return False
    return f"{'ab':05}" == "ab000" and f"{'ab':>05}" == "000ab" and f"{name:}" == "héllo"


func rounded(x: float, n: int) -> float:
    return round(x, n)


# spec: PRELUDE-ROUND-2
public func test_round_to_digits_rounds_the_exact_value_with_halves_away_from_zero() -> bool:
    if [round(3.14159, 2), round(2.675, 2), round(1.005, 2), round(-3.14159, 3), round(1234.5678, 1)] != [3.14, 2.67, 1.0, -3.142, 1234.6]:
        return False
    # The declared divergence: an exact tie rounds away from zero, where CPython
    # rounds it to even (0.12, 2.0, -2.0, 1200.0).
    if [round(0.125, 2), rounded(2.5, 0), rounded(-2.5, 0), rounded(0.375, 2), rounded(1250.0, -2)] != [0.13, 3.0, -3.0, 0.38, 1300.0]:
        return False
    if [rounded(1234.5, -2), rounded(51.0, -2), rounded(0.001, 2), rounded(7.25, 400), rounded(7.25, -400)] != [1200.0, 100.0, 0.0, 7.25, 0.0]:
        return False
    return f"{round(3.14159, 2)}" == "3.14" and round(3.14159, 2) + 0.0 == 3.14
