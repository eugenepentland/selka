record Plain:
    left: int
    right: int


func update(mut value: Plain, items: int[]) -> int:
    value.left = items[0]
    return value.left + value.right


public func test_plain_updates_stage_bits_inside_a_managed_frame() -> bool:
    mut items = [8]
    mut value = Plain(left=1, right=2)
    value.right = 5
    mut total = update(mut value, items)
    return total == 13 and value.left == 8 and value.right == 5 and items == [8]


func escaped() -> int[]:
    mut count = 2
    mut outside = [5]
    mut scale = 3
    mut first = [count]
    mut lifted: int[] = []
    mut suffix = 4
    mut second = [first[0] + suffix]
    lifted = second
    first.extend(lifted)
    first.append(outside[0] + scale)
    return first


public func test_reused_operands_retain_ordinary_and_held_cleanup_roles() -> bool:
    mut mapping = {1: [3]}
    mut live = list(mapping.values())
    mut ordinary = mapping.copy()
    mut scalar = len(ordinary)
    mapping[1] = [7]
    mut materialized = list(live)
    return scalar == 1 and ordinary[1] == [3] and materialized == [[3]]
