func retained_text() -> str:
    mut source = "prefix-λ-日本語-😀-abcdefghijklmnop-suffix" + "!"
    return source[7:33]


func retained_bytes() -> bytes:
    mut source = b"prefix-\x00\xff-abcdefghijklmnop-suffix" + b"!"
    return source[7:26]


# spec-case: UTF8-TEXT-1
# spec-case: TEXT-VIEW-2
public func test_text_equality_reads_distinct_owned_values_and_retained_unicode_views() -> bool:
    mut kept = retained_text()
    mut same = "λ-日本語-😀-abcdefghijklmnop-s"
    if kept != same or kept == same + "!":
        return False
    if "" != "" or "é" == "e\u0301":
        return False
    if "abc" == "xbc" or "abc" == "abx" or "abc" == "abcd":
        return False
    mut copies = [str(42), str(42)]
    return copies[0] == copies[1] and kept == kept


# spec-case: PY-BYTES-1
# spec-case: PY-BYTES-7
public func test_bytes_equality_reads_retained_views_and_snapshot_contents() -> bool:
    mut kept = retained_bytes()
    if kept != b"\x00\xff-abcdefghijklmnop" or kept == b"\x00\xfe-abcdefghijklmnop":
        return False
    mut empty: int[] = []
    mut buffer = byte_buffer(empty)
    _ = buffer.append_range(kept, 0, len(kept))
    mut snapshot = bytes(buffer)
    _ = buffer.append_byte(33)
    return snapshot == kept and snapshot != buffer and b"" == b"" and kept == kept


# spec-case: EQUALITY-SCRATCH-1
public func test_structural_equality_still_visits_same_object_nan_leaves() -> bool:
    mut values: float[] = [0.0 / 0.0]
    return values != values
