# Lane FX (12 November 2026): `lists.stride` on a list view (a parameter, an inline slice, a slice binding) gives the
# values it gives on an owned list. Until FX the new core refused it (E_CORE_UNSUPPORTED, "slice_step"); the stepped copy
# now reads the view in place and copies only the elements it selects into a fresh list.
import lists

record Shelf:
    names: str[]


func stepped(values: int[], step: int) -> int[]:
    return lists.stride(values, None, None, step)


func bounded(values: int[], start: int, end: int, step: int) -> int[]:
    return lists.stride(values, start, end, step)


func stepped_names(names: str[], step: int) -> str[]:
    return lists.stride(names, None, None, step)


func reversed_shelf(shelf: Shelf) -> str[]:
    return lists.stride(shelf.names, None, None, -1)


func generic_stepped[T: copy + storable](values: T[], step: int) -> T[]:
    return lists.stride(values, None, None, step)


func checked_stepped(values: int[], step: int) -> int[] fails str:
    if step == 0:
        fail "a step of zero"
    return lists.stride(values, None, None, step)


func same_everywhere(owned: int[], step: int) -> bool:
    mut mine = copy(owned)
    append(mut mine, 8)
    const expected = lists.stride(mine, None, None, step)
    const view = mine[0:8]
    return stepped(mine, step) == expected and lists.stride(mine[0:8], None, None, step) == expected and lists.stride(view, None, None, step) == expected


public func test_list_stride_of_a_view_matches_the_owned_list_for_every_step() -> bool:
    const values = [1, 2, 3, 4, 5, 6, 7]
    mut agree = True
    for step in [1, 2, 3, 7, 8, 100, -1, -2, -3, -8, -100]:
        agree = agree and same_everywhere(values, step)
    return agree and stepped(values, -2) == [7, 5, 3, 1] and stepped(values, 100) == [1] and stepped(values, -100) == [7]


public func test_list_stride_of_a_view_clamps_its_bounds() -> bool:
    const values = [1, 2, 3, 4, 5, 6, 7]
    const middle = values[1:6]
    const forward = bounded(values, 2, 5, 1) == [3, 4, 5] and bounded(values, 3, 100, 2) == [4, 6]
    const backward = bounded(values, 5, 1, -1) == [6, 5, 4, 3] and lists.stride(middle, 10, 0, -1) == [6, 5, 4, 3]
    return forward and backward and lists.stride(values[1:6], 1, 3, 1) == [3, 4] and bounded(middle, 0, 10, 2) == [2, 4, 6]


public func test_list_stride_of_an_empty_view_is_empty() -> bool:
    const values = [1, 2, 3]
    const empty: int[] = []
    return len(stepped(empty, 2)) == 0 and len(lists.stride(values[1:1], None, None, -1)) == 0 and len(bounded(values, 2, 1, 1)) == 0


public func test_list_stride_of_a_view_of_text_copies_the_selected_names() -> bool:
    const names = ["a", "bb", "ccc", "dddd"]
    const tail = names[1:4]
    const whole = stepped_names(names, 1) == names and stepped_names(names, 2) == ["a", "ccc"]
    const back = stepped_names(names, -1) == ["dddd", "ccc", "bb", "a"] and lists.stride(tail, None, None, 2) == ["bb", "dddd"]
    return whole and back and lists.stride(names[1:4], None, None, 1) == ["bb", "ccc", "dddd"]


public func test_list_stride_through_a_field_a_generic_and_a_failing_function() -> bool:
    const names = ["a", "bb", "ccc"]
    const values = [1, 2, 3, 4, 5, 6, 7]
    const field = reversed_shelf(Shelf(names=copy(names))) == ["ccc", "bb", "a"]
    const generic = generic_stepped(values, 3) == [1, 4, 7] and generic_stepped(names, -2) == ["ccc", "a"]
    mut failing = False
    match checked_stepped(values[2:7], -2):
        case Ok(picked):
            failing = picked == [7, 5, 3]
        case Err(reason):
            failing = len(reason) == 0
    return field and generic and failing
