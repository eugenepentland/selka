module rc_dictionary_views

# spec-case: D2-VIEW-STORAGE-1
public def test_explicit_snapshot_preserves_prior_values() -> bool:
    mapping = {1: 7}
    saved = list(mapping.values())
    mapping[1] = 9
    mapping[2] = 11
    return saved == [7] and list(mapping.values()) == [9, 11]

record Saved:
    values: list[list[int]]
    items: list[DictItem[int, list[int]]]

def collect(mapping: dict[int, list[int]]) -> Saved:
    return Saved(list(mapping.values()), list(mapping.items()))

# spec-case: D2-VIEW-STORAGE-1
public def test_returned_nested_snapshots_keep_managed_values() -> bool:
    mapping = {1: [7, 8]}
    saved = collect(mapping)
    mapping[1].append(9)
    saved.values[0].append(11)
    return saved.values == [[7, 8, 11]] and saved.items[0].value == [7, 8] and mapping[1] == [7, 8, 9]
