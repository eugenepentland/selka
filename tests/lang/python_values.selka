import dicts
import lists
import strings

record ValuesBox:
    values: dict[str, int]


func package[T: copy + storable](value: T) -> dict[str, T]:
    mut values: dict[str, T] = {}
    values["key"] = copy(value)
    for key in values:
        if key not in values:
            return {}
    return values


func label[T: integer](number: T) -> str:
    return "n=" + str(number)


# spec-case: PY-TEXT-1
public func test_python_values_unicode_literals_chained_methods_indexing_and_membership() -> bool:
    mut text = "hé🙂,x,"
    mut parts = strings.split(text, ",")
    if strings.join(parts, ",") != text:
        return False
    if "é🙂" not in text:
        return False
    if strings.char_at(parts[0], 2) != "🙂":
        return False
    return strings.char_count(text) == 6


# spec-case: PY-DICT-1
public func test_python_values_dictionary_snapshot_and_arbitrary_method_receivers() -> bool:
    mut box = ValuesBox(values={"one": 1})
    mut before = copy(box.values)
    box.values["two"] = 40
    if "two" in before or "two" not in box.values:
        return False
    if list(dicts.keys(box.values))[0] != "one":
        return False
    return dicts.get(box.values, "two", 0) + dicts.get({"fallback": 2}, "fallback", 0) == 42


# spec-case: PY-DICT-1
public func test_python_values_dictionary_and_unicode_text_iteration_preserve_order() -> bool:
    mut values = {"a": 10, "b": 20}
    mut total = 0
    for key in values:
        total += values[key]
    for index, ch in enumerate(strings.chars("é🙂")):
        total += index + strings.char_count(ch)
    return total == 33


# spec-case: PY-TEXT-1
public func test_python_values_unicode_slicing_clamps_endpoints_and_returns_independent_text() -> bool:
    mut text = "aé🙂z"
    mut middle = copy(strings.char_slice(text, 1, max(strings.char_count(text) - 1, 0)))
    if middle != "é🙂":
        return False
    if strings.char_slice(text, max(strings.char_count(text) - 99, 0), 99) != text:
        return False
    if strings.char_slice(text, 3, 1) != "":
        return False
    return strings.char_count(strings.char_slice(text, None, None)) + strings.char_count(middle) == 6


# spec-case: PY-DICT-1
public func test_python_values_generic_dictionary_preserves_symbolic_value_types() -> bool:
    return package(42)["key"] == 42


# spec-case: PY-TEXT-1
public func test_python_values_generic_str_conversion_and_unicode_escapes() -> bool:
    if label(42) != "n=42":
        return False
    if "\u00e9\U0001f642" != "é🙂":
        return False
    return True


# spec-case: PY-DICT-1
public func test_python_values_collection_float_equality_and_membership_preserve_numeric_semantics() -> bool:
    mut zeros = [0.0]
    mut negative = [-0.0]
    if zeros != negative or not lists.contains(zeros, -0.0):
        return False
    mut nan = 0.0 / 0.0
    mut nans = [nan]
    if nans == nans or lists.contains(nans, nan):
        return False
    if {"value": 0.0} != {"value": -0.0}:
        return False
    if {"value": nan} == {"value": nan}:
        return False
    if [[0.0]] != [[-0.0]]:
        return False
    return True


func read_scalar(text: str, index: int) -> str:
    return strings.char_at(text, index)


# spec-case: PY-TEXT-1
public func test_ascii_scalar_indexing_survives_frame_restores_and_collections() -> bool:
    mut text = "abcdefghijklmnopqrstuvwxyz0123456789"
    mut kept: str[] = []
    mut index = 0
    while index < 512:
        append(mut kept, read_scalar(text, index % strings.char_count(text)))
        index = index + 1
    if kept[0] != "a":
        return False
    if kept[25] != "z":
        return False
    if kept[36] != "a":
        return False
    if kept[511] != "h":
        return False
    return True


func main() -> int:
    return 0
