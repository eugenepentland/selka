# Ownership operations `--rc-runtime=sites` showed the compiler could drop,
# each with the near misses that must keep them. Every test checks values
# only; the operation counts are asserted by the sites build test.
union Value:
    nil,
    number: float,
    text: str


record Runtime:
    stack: list[Value]
    top: int


record Chunk:
    code: list[int]
    names: list[str]


record Frame:
    chunk: Chunk
    at: int


record CallFrame:
    ip: int
    base: int


record Machine:
    stack: list[Value]
    frames: list[CallFrame]
    names: list[str]
    top: int
    count: int


def push(m: mut Machine, item: Value):
    m.stack[m.top] = item
    m.top = m.top + 1


def step(m: mut Machine, ip: int):
    m.frames[m.count - 1].ip = ip


def grow_stack(m: mut Machine) -> int:
    m.stack = [Value.nil, Value.nil, Value.nil]
    return 1


def replaced_receiver(m: mut Machine, item: Value):
    m.stack[grow_stack(mut m)] = item


def rename(m: mut Machine, name: str):
    m.names[0] = name


def local_machine(item: Value) -> list[Value]:
    m = Machine([Value.nil, Value.nil], [], [], 0, 0)
    m.stack[m.top] = item
    m.stack[-1] = item
    return m.stack


record Name:
    chars: bytes
    hash: u32


record Code:
    ops: list[int]


record Callable:
    arity: int
    code: Code


union Obj:
    free,
    name: Name,
    callable: Callable


def arity_of(objects: list[Obj], at: int) -> int:
    match objects[at]:
        case Obj.callable(payload):
            return payload.arity + len(payload.code.ops)
        case _:
            return -1


def name_of(objects: list[Obj], at: int) -> Name:
    match objects[at]:
        case Obj.name(payload):
            return payload
        case _:
            return Name(b"", 0u32)


def freed_arity(objects: mut list[Obj], at: int) -> int:
    match objects[at]:
        case Obj.callable(payload):
            objects[at] = Obj.free
            return payload.arity + len(payload.code.ops)
        case _:
            return -1


def joined(left: bytes, right: bytes) -> Name:
    made = Name(left + right, 3u32)
    return made


def same(value: Name) -> Name:
    return value


record Unit:
    arity: int
    chunk: Chunk


record Loaded:
    code: list[int]
    names: list[str]
    at: int


def load(unit: Unit, at: int) -> Loaded:
    return Loaded(code=unit.chunk.code, names=unit.chunk.names, at=at)


def load_mut(unit: mut Unit) -> Loaded:
    loaded = Loaded(code=unit.chunk.code, names=unit.chunk.names, at=unit.arity)
    unit.chunk.code.append(99)
    return loaded


def made_unit() -> Unit:
    return Unit(3, Chunk([4, 5], ["made"]))


def load_made() -> Loaded:
    return Loaded(code=made_unit().chunk.code, names=made_unit().chunk.names, at=0)


record Table:
    objects: list[Obj]
    count: int


def table_arity(table: Table, at: int) -> int:
    match table.objects[at]:
        case Obj.callable(payload):
            return payload.arity + len(payload.code.ops)
        case _:
            return -1


def table_name(table: Table, at: int) -> Name:
    match table.objects[at]:
        case Obj.name(payload):
            return payload
        case _:
            return Name(b"", 0u32)


def table_ops(table: Table, at: int) -> list[int]:
    match table.objects[at]:
        case Obj.callable(payload):
            return payload.code.ops
        case _:
            return []


def nested_anchor(table: Table) -> int:
    total = 0
    for i in range(len(table.objects)):
        match table.objects[i]:
            case Obj.callable(outer):
                match table.objects[outer.arity]:
                    case Obj.name(inner):
                        total += len(inner.chars)
                    case _:
                        total += 100
            case _:
                total += 1
    return total


def replaced_table(table: mut Table, at: int) -> int:
    table.count = table.count + 1
    match table.objects[at]:
        case Obj.callable(payload):
            table.objects[at] = Obj.free
            return payload.arity + len(payload.code.ops)
        case _:
            return -1


record Cursor:
    code: list[int]
    ip: int


def advance(cursor: mut Cursor) -> int:
    cursor.ip = cursor.ip + 1
    return cursor.code[cursor.ip - 1]


def fetch(rt: mut Runtime, cursor: mut Cursor) -> Value:
    rt.top = rt.top + 1
    return rt.stack[advance(mut cursor)]


def reset_stack(rt: mut Runtime) -> int:
    rt.stack = [Value.text("fresh")]
    return 0


def fetch_reset(rt: mut Runtime) -> Value:
    return rt.stack[reset_stack(mut rt)]


record Globals:
    entries: list[Value]


record Vm:
    globals: Globals
    names: list[str]
    top: int


def entry_at(globals: Globals, at: int) -> Value:
    return globals.entries[at]


def name_length(vm: Vm, at: int) -> int:
    return len(vm.names[at])


def global_value(vm: mut Vm, at: int) -> Value:
    vm.top = vm.top + 1
    return entry_at(vm.globals, name_length(vm, at))


def wipe(vm: mut Vm) -> int:
    vm.globals = Globals([Value.text("wiped")])
    return 0


def wiped_value(vm: mut Vm) -> Value:
    return entry_at(vm.globals, wipe(mut vm))


def pop(rt: mut Runtime) -> Value:
    rt.top = rt.top - 1
    return rt.stack[rt.top]


def peek(rt: Runtime, distance: int) -> Value:
    return rt.stack[rt.top - 1 - distance]


def number(item: Value) -> float:
    match item:
        case Value.number(x):
            return x
        case _:
            return -1.0


def swap_stack(rt: mut Runtime) -> int:
    rt.stack = [Value.number(99.0)]
    return 0


def replaced_during_index(rt: mut Runtime) -> Value:
    return rt.stack[swap_stack(mut rt)]


def next_name(frame: mut Frame) -> str:
    frame.at = frame.at + 1
    return frame.chunk.names[frame.at - 1]


def owned_rows(count: int) -> list[Value]:
    rows: list[Value] = []
    for i in range(count):
        rows.append(Value.number(float(i)))
    return rows


def last_owned(count: int) -> Value:
    return owned_rows(count)[-1]


# spec-case: RC-LOAN-RELOCATE-1
public def test_loaned_field_reads_keep_values_through_their_temporaries() -> bool:
    rt = Runtime([Value.number(1.5), Value.nil, Value.number(2.5)], 3)
    snapshot = rt
    first = number(pop(mut rt))
    second = pop(mut rt)
    third = number(pop(mut rt))
    return first == 2.5 and second == Value.nil and third == 1.5 and rt.top == 0 and snapshot.stack == rt.stack


# spec-case: RC-LOAN-RELOCATE-1
public def test_loaned_reads_through_negative_indices_and_readonly_parameters() -> bool:
    rt = Runtime([Value.number(4.0), Value.text("x")], 0)
    return pop(mut rt) == Value.text("x") and number(peek(rt, 0)) == 4.0 and rt.top == -1


# spec-case: RC-LOAN-RELOCATE-1
public def test_index_callback_replacing_the_list_keeps_the_loaned_original() -> bool:
    rt = Runtime([Value.number(7.0), Value.number(8.0)], 2)
    item = replaced_during_index(mut rt)
    return number(item) == 7.0 and rt.stack == [Value.number(99.0)]


# spec-case: RC-LOAN-RELOCATE-1
public def test_managed_elements_and_nested_record_fields_relocate_whole_values() -> bool:
    frame = Frame(Chunk([1, 2], ["alpha", "beta"]), 0)
    saved = frame
    names = next_name(mut frame) + next_name(mut frame)
    return names == "alphabeta" and frame.at == 2 and saved.at == 0 and saved.chunk.names == ["alpha", "beta"]


# spec-case: RC-LOAN-RELOCATE-1
public def test_owned_temporaries_are_taken_not_relocated() -> bool:
    return number(last_owned(5)) == 4.0 and number(last_owned(1)) == 0.0


# spec-case: RC-LOAN-RELOCATE-1
public def test_relocated_loans_inside_arenas() -> bool:
    total = 0.0
    with arena():
        rt = Runtime([Value.number(3.0), Value.number(5.0)], 2)
        total += number(pop(mut rt))
        with arena():
            total += number(pop(mut rt))
    return total == 8.0


# spec-case: RC-INERT-FIELD-RECEIVER-1
public def test_field_receivers_write_through_mut_records_and_keep_snapshots() -> bool:
    m = Machine([Value.nil, Value.nil, Value.nil], [CallFrame(0, 0), CallFrame(5, 1)], ["a"], 0, 2)
    before = m
    push(mut m, Value.number(1.0))
    push(mut m, Value.text("two"))
    step(mut m, 9)
    step(mut m, 11)
    return m.stack == [Value.number(1.0), Value.text("two"), Value.nil] and m.top == 2 and m.frames[1].ip == 11 and m.frames[0].ip == 0 and before.stack == [Value.nil, Value.nil, Value.nil] and before.frames[1].ip == 5


# spec-case: RC-INERT-FIELD-RECEIVER-1
public def test_field_receivers_of_local_records_and_negative_indices() -> bool:
    return local_machine(Value.number(3.0)) == [Value.number(3.0), Value.number(3.0)]


# spec-case: RC-INERT-FIELD-RECEIVER-1
public def test_index_callback_replacing_the_field_list_keeps_scoped_receiver() -> bool:
    m = Machine([Value.nil, Value.nil], [], [], 0, 0)
    replaced_receiver(mut m, Value.number(4.0))
    return m.stack == [Value.nil, Value.nil, Value.nil]


# spec-case: RC-INERT-FIELD-RECEIVER-1
public def test_managed_element_field_stores_keep_their_scope() -> bool:
    m = Machine([], [], ["a", "b"], 0, 0)
    saved = m
    rename(mut m, "c")
    return m.names == ["c", "b"] and saved.names == ["a", "b"]


# spec-case: RC-INERT-FIELD-RECEIVER-1
public def test_field_receivers_inside_arenas() -> bool:
    count = 0
    with arena():
        m = Machine([Value.nil, Value.nil], [CallFrame(0, 0)], [], 0, 1)
        push(mut m, Value.number(2.0))
        with arena():
            step(mut m, 4)
            push(mut m, Value.text("inner"))
        count = m.top + m.frames[0].ip
    return count == 6


# spec-case: RC-SELF-STORE-1
public def test_payload_bindings_read_in_place_keep_their_owner() -> bool:
    objects = [Obj.free, Obj.callable(Callable(2, Code([1, 2, 3])))]
    saved = objects
    total = 0
    for i in range(4):
        total += arity_of(objects, 1) + arity_of(objects, 0)
    return total == 16 and saved == objects


# spec-case: RC-SELF-STORE-1
public def test_payload_bindings_outliving_a_scrutinee_write_keep_their_copy() -> bool:
    objects = [Obj.callable(Callable(4, Code([9])))]
    first = freed_arity(mut objects, 0)
    second = freed_arity(mut objects, 0)
    return first == 5 and second == -1 and objects == [Obj.free]


# spec-case: RC-RETURN-MOVE-1
public def test_returned_bindings_and_locals_move_their_owner() -> bool:
    objects = [Obj.name(Name(b"ab" + b"c", 7u32)), Obj.free]
    found = name_of(objects, 0)
    objects[0] = Obj.free
    made = joined(b"x", b"yz")
    return found.chars == b"abc" and found.hash == 7u32 and made.chars == b"xyz" and name_of(objects, 1).chars == b""


# spec-case: RC-RETURN-MOVE-1
public def test_returned_parameters_keep_the_callers_value() -> bool:
    original = Name(b"k" + b"eep", 1u32)
    copy = same(original)
    again = same(copy)
    return copy.chars == b"keep" and again.chars == b"keep" and original.chars == b"keep"


# spec-case: RC-TRANSIENT-FIELD-1
public def test_nested_field_copies_into_constructors_stay_independent() -> bool:
    unit = Unit(1, Chunk([1, 2], ["a", "b"]))
    loaded = load(unit, 7)
    loaded.code.append(3)
    loaded.names[0] = "z"
    return loaded.code == [1, 2, 3] and loaded.names == ["z", "b"] and unit.chunk.code == [1, 2] and unit.chunk.names == ["a", "b"] and loaded.at == 7


# spec-case: RC-TRANSIENT-FIELD-1
public def test_nested_field_copies_from_mut_parameters_and_call_results() -> bool:
    unit = Unit(2, Chunk([8], ["m"]))
    loaded = load_mut(mut unit)
    made = load_made()
    return loaded.code == [8] and unit.chunk.code == [8, 99] and loaded.at == 2 and made.code == [4, 5] and made.names == ["made"]


# spec-case: RC-TRANSIENT-FIELD-1
public def test_nested_field_copies_inside_arenas() -> bool:
    total = 0
    with arena():
        unit = Unit(1, Chunk([1, 2, 3], ["q"]))
        with arena():
            loaded = load(unit, 1)
            total = len(loaded.code) + len(loaded.names)
    return total == 4


# spec-case: RC-READONLY-ANCHOR-1
public def test_readonly_table_reads_borrow_payloads_in_place() -> bool:
    table = Table([Obj.callable(Callable(1, Code([4, 5]))), Obj.name(Name(b"n" + b"ame", 9u32))], 2)
    saved = table
    arity = table_arity(table, 0) + table_arity(table, 1)
    name = table_name(table, 1)
    ops = table_ops(table, 0)
    ops.append(6)
    table.objects[1] = Obj.free
    return arity == 2 and name.chars == b"name" and ops == [4, 5, 6] and saved.objects[1] == Obj.name(Name(b"name", 9u32)) and table_ops(saved, 0) == [4, 5]


# spec-case: RC-READONLY-ANCHOR-1
public def test_nested_readonly_matches_in_loops() -> bool:
    table = Table([Obj.callable(Callable(1, Code([]))), Obj.name(Name(b"abc", 1u32)), Obj.free], 3)
    return nested_anchor(table) == 5


# spec-case: RC-READONLY-ANCHOR-1
public def test_mut_roots_keep_owned_bindings() -> bool:
    table = Table([Obj.callable(Callable(3, Code([1])))], 0)
    first = replaced_table(mut table, 0)
    return first == 4 and table.count == 1 and table.objects == [Obj.free]


# spec-case: RC-READONLY-ANCHOR-1
public def test_readonly_reads_inside_arenas() -> bool:
    total = 0
    table = Table([Obj.name(Name(b"ar" + b"ena", 2u32))], 1)
    with arena():
        inner = Table([Obj.callable(Callable(5, Code([1, 2])))], 1)
        total = table_arity(inner, 0) + len(table_name(table, 0).chars)
    return total == 12


# spec-case: RC-INTERVAL-ANCHOR-1
public def test_mut_root_list_reads_across_unrelated_calls() -> bool:
    rt = Runtime([Value.number(1.0), Value.text("b"), Value.nil], 0)
    cursor = Cursor([2, 0, 1], 0)
    first = fetch(mut rt, mut cursor)
    second = fetch(mut rt, mut cursor)
    third = fetch(mut rt, mut cursor)
    return first == Value.nil and number(second) == 1.0 and third == Value.text("b") and rt.top == 3 and cursor.ip == 3


# spec-case: RC-INTERVAL-ANCHOR-1
public def test_mut_root_list_reads_keep_the_list_a_call_replaces() -> bool:
    rt = Runtime([Value.number(8.0), Value.nil], 0)
    item = fetch_reset(mut rt)
    return number(item) == 8.0 and rt.stack == [Value.text("fresh")]


# spec-case: RC-INTERVAL-ANCHOR-1
public def test_mut_root_list_reads_inside_arenas() -> bool:
    total = 0.0
    with arena():
        rt = Runtime([Value.number(2.0), Value.number(3.0)], 0)
        cursor = Cursor([1, 0], 0)
        with arena():
            total = number(fetch(mut rt, mut cursor)) + number(fetch(mut rt, mut cursor))
    return total == 5.0


# spec-case: RC-OPERAND-ANCHOR-1
public def test_mut_root_fields_passed_to_calls_read_the_current_value() -> bool:
    vm = Vm(Globals([Value.nil, Value.number(1.0), Value.text("two")]), ["a", "bb"], 0)
    first = global_value(mut vm, 0)
    second = global_value(mut vm, 1)
    return number(first) == 1.0 and second == Value.text("two") and vm.top == 2


# The collector lends the argument's field in place, so it reads the list the
# later `mut` call installed; RC keeps its loan on the list read first. Both
# must survive the replacement; the counted build checks nothing leaks.
# spec-case: RC-OPERAND-ANCHOR-1
public def test_mut_root_fields_keep_the_value_a_later_mut_call_replaces() -> bool:
    vm = Vm(Globals([Value.number(6.0)]), [], 0)
    item = wiped_value(mut vm)
    return (number(item) == 6.0 or item == Value.text("wiped")) and vm.globals.entries == [Value.text("wiped")]


# Run every test once, so `mylang run --rc-runtime=stats` shows balanced counts
# for the whole file; the result is the number of failures.
def main() -> int:
    failures = 0
    for passed in [
        test_loaned_field_reads_keep_values_through_their_temporaries(),
        test_loaned_reads_through_negative_indices_and_readonly_parameters(),
        test_index_callback_replacing_the_list_keeps_the_loaned_original(),
        test_managed_elements_and_nested_record_fields_relocate_whole_values(),
        test_owned_temporaries_are_taken_not_relocated(),
        test_relocated_loans_inside_arenas(),
        test_field_receivers_write_through_mut_records_and_keep_snapshots(),
        test_field_receivers_of_local_records_and_negative_indices(),
        test_index_callback_replacing_the_field_list_keeps_scoped_receiver(),
        test_managed_element_field_stores_keep_their_scope(),
        test_field_receivers_inside_arenas(),
        test_payload_bindings_read_in_place_keep_their_owner(),
        test_payload_bindings_outliving_a_scrutinee_write_keep_their_copy(),
        test_returned_bindings_and_locals_move_their_owner(),
        test_returned_parameters_keep_the_callers_value(),
        test_nested_field_copies_into_constructors_stay_independent(),
        test_nested_field_copies_from_mut_parameters_and_call_results(),
        test_nested_field_copies_inside_arenas(),
        test_readonly_table_reads_borrow_payloads_in_place(),
        test_nested_readonly_matches_in_loops(),
        test_mut_roots_keep_owned_bindings(),
        test_readonly_reads_inside_arenas(),
        test_mut_root_list_reads_across_unrelated_calls(),
        test_mut_root_list_reads_keep_the_list_a_call_replaces(),
        test_mut_root_list_reads_inside_arenas(),
        test_mut_root_fields_passed_to_calls_read_the_current_value(),
        test_mut_root_fields_keep_the_value_a_later_mut_call_replaces(),
    ]:
        if not passed:
            failures += 1
    return failures
