# Historical collector-footprint fixtures retained as ownership regressions.
# Trees, lists, and text remain valid while other owned values are allocated and
# destroyed. The old test names preserve coverage identity; they do not describe
# a collector in the checked-ownership runtime.
record Node:
    left: Node?
    right: Node?
    value: int


func tree(depth: int, value: int) -> Node:
    if depth == 0:
        return Node(left=None, right=None, value=value)
    return Node(left=Some(tree(depth - 1, value * 2)), right=Some(tree(depth - 1, value * 2 + 1)), value=value)


# The trees are perfect, so a node has both children or neither.
func total(node: Node) -> int:
    match node.left:
        case Some(left):
            match node.right:
                case Some(right):
                    return node.value + total(left) + total(right)
                case None:
                    return node.value
        case None:
            return node.value


# About 8 KB of short-lived text per round, so a few hundred rounds run minor
# collections within a test's instruction budget.
func churn(rounds: int) -> int:
    mut done = 0
    for _ in range(rounds):
        mut text = "abcdefgh"
        for doubling in range(9):
            text = text + text
        done += len(text) // 4096
    return done


func words(prefix: str, count: int) -> str[]:
    mut items: str[] = []
    for index in range(count):
        items.append(f"{prefix.copy()}{index}")
    return items


func joined_length(items: str[]) -> int:
    mut size = 0
    for item in items:
        size += len(item)
    return size


# A tree that churns garbage while it is being built, so minor collections run
# with parts of it finished and parts still on the stack.
func churning_tree(depth: int, value: int) -> Node:
    if depth >= 6:
        _ = churn(8)
    if depth == 0:
        return Node(left=None, right=None, value=value)
    mut left = churning_tree(depth - 1, value * 2)
    return Node(left=Some(left), right=Some(churning_tree(depth - 1, value * 2 + 1)), value=value)


# Trees of 2^11 nodes are built one after another, each still under
# construction when minor collections run: a subtree the first one finds is
# kept young, the next promotes what is still reachable, and a finished tree
# that died young is reclaimed without ever being promoted.
public func test_trees_built_across_minor_collections_keep_every_node() -> bool:
    mut ok = True
    for round in range(6):
        mut node = churning_tree(10, 1)
        ok = ok and total(node) == (2048 * 2047) // 2
    mut kept = tree(8, 1)
    _ = churn(600)
    return ok and total(kept) == (512 * 511) // 2


public func test_a_young_subtree_hung_on_an_old_node_survives_two_minor_collections() -> bool:
    mut old = tree(4, 1)
    _ = churn(600)
    mut young = tree(5, 1)
    old.left = Some(young)
    _ = churn(300)
    young = tree(1, 1)
    _ = churn(600)
    match old.left:
        case Some(left):
            return total(left) == (64 * 63) // 2 and total(young) == 6
        case None:
            return False


# One phase builds a large list and drops it, the next builds another of
# longer texts from the storage the first one freed.
public func test_a_dropped_phase_and_the_next_one_both_read_back() -> bool:
    mut first = words("first phase element ", 5000)
    mut first_size = joined_length(first)
    _ = churn(400)
    first = words("x", 1)
    mut second = words("second phase element ", 5000)
    _ = churn(400)
    # 5000 prefixes of 20 octets and 10 + 180 + 2700 + 16000 digits.
    return first_size == 118890 and second[4999] == "second phase element 4999" and len(first) == 1


# Short texts fill one size class, die, and the storage is reused by texts of
# a longer class and by nodes; every value reads back.
public func test_storage_freed_by_one_size_class_serves_another() -> bool:
    mut short = words("s", 3000)
    mut short_size = joined_length(short)
    short = words("t", 1)
    mut long = words("a much longer prefix for every element ", 3000)
    mut trees: Node[] = []
    for index in range(40):
        trees.append(tree(4, index))
    mut sum = 0
    for node in trees:
        sum += total(node)
    # "s0" to "s2999": 3000 prefixes and 10 + 180 + 2700 + 8000 digits; a
    # depth-4 tree rooted at v holds 341 * v + 155.
    return short_size == 13890 and long[2999] == "a much longer prefix for every element 2999" and sum == 341 * 780 + 40 * 155


# Texts built after the heap has churned through many other texts reuse their
# slots without clearing them first; equality, hashing and slicing must see
# only the octets each text was built with.
public func test_texts_built_on_reused_slots_compare_and_hash_by_their_own_octets() -> bool:
    _ = churn(400)
    mut counts: dict[str, int] = {}
    for index in range(4000):
        mut key = f"k{index % 37}"
        counts[key] = counts.get(key, 0) + 1
    mut probe = f"k{3}"
    return counts[probe] == 109 and counts["k36"] == 108 and len(counts) == 37 and probe[1:] == "3"


# An old list of many texts is rescanned by every minor collection while young
# texts are appended to it and old slots are replaced.
public func test_an_old_list_of_texts_keeps_young_texts_through_rescans() -> bool:
    mut items = words("w", 5000)
    _ = churn(600)
    for index in range(500):
        items.append(f"young{index}")
        items[index * 7] = f"new{index}"
    _ = churn(600)
    return len(items) == 5500 and items[5499] == "young499" and items[7] == "new1" and items[8] == "w8"
