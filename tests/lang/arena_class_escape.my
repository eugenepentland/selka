module arena_class_escape

# `name.escape(value)` copies `class` instances out of an arena exactly as it
# copies collections: each instance reachable in the dying arena gets one clone
# in the enclosing region, sharing and cycles are preserved, and an instance
# that already lives in an older region is shared. Under `--gc-stress` every
# allocation collects, so the clones are exercised as ordinary collected
# objects: they are promoted, then given young objects through the class store
# barrier, and must keep them.


class Node:
    value: int
    next: Option[Node]


class Box:
    items: list[Node]
    label: str


class Empty:
    pass


def churn(rounds: int) -> int:
    total = 0
    for index in range(rounds):
        scratch: list[int] = [index, index + 1]
        total = total + len(scratch)
    return total


def next_value(node: Node) -> int:
    match node.next:
        case Some(child):
            return child.value
        case None:
            return 0 - 1


# spec: ARENA-ESCAPE-CLASS-1
public def test_escape_copies_a_class_instance_and_the_instances_it_reaches() -> bool:
    kept = Node(value=0, next=None)
    with arena() as scratch:
        leaf = Node(value=5, next=None)
        kept = scratch.escape(Node(value=7, next=Some(leaf)))
    _ = churn(20)
    return kept.value * 10 + next_value(kept) == 75


# spec-case: ARENA-ESCAPE-CLASS-1
public def test_escape_preserves_a_cycle_through_class_instances() -> bool:
    kept = Node(value=0, next=None)
    with arena() as scratch:
        first = Node(value=1, next=None)
        second = Node(value=2, next=Some(first))
        first.next = Some(second)
        kept = scratch.escape(first)
    _ = churn(20)
    back = kept
    match kept.next:
        case Some(child):
            match child.next:
                case Some(again):
                    back = again
                case None:
                    pass
        case None:
            pass
    back.value = 100
    return kept.value == 100 and next_value(kept) == 2


# spec-case: ARENA-ESCAPE-CLASS-1
public def test_escape_copies_classes_inside_lists_and_lists_inside_classes() -> bool:
    kept = Box(items=[], label="")
    with arena() as scratch:
        shared = Node(value=3, next=None)
        box = Box(items=[shared, shared, Node(value=4, next=None)], label="made in the arena")
        kept = scratch.escape(box)
    _ = churn(20)
    kept.items[0].value = 30
    return kept.items[1].value == 30 and kept.items[2].value == 4 and kept.label == "made in the arena"


# spec-case: ARENA-ESCAPE-CLASS-1
public def test_escape_shares_a_class_instance_that_already_lives_outside_the_arena() -> bool:
    older = Node(value=9, next=None)
    kept = Node(value=0, next=None)
    with arena() as scratch:
        kept = scratch.escape(Node(value=1, next=Some(older)))
    older.value = 90
    return next_value(kept) == 90


# spec-case: ARENA-ESCAPE-CLASS-1
public def test_an_escaped_class_instance_keeps_a_young_object_stored_after_promotion() -> bool:
    kept = Node(value=0, next=None)
    with arena() as scratch:
        kept = scratch.escape(Node(value=1, next=None))
    _ = churn(20)
    kept.next = Some(Node(value=6, next=None))
    _ = churn(20)
    return next_value(kept) == 6


# spec-case: ARENA-ESCAPE-CLASS-1
public def test_escape_into_an_enclosing_arena_copies_the_class_instance_there() -> bool:
    total = 0
    with arena() as outer:
        middle = Node(value=0, next=None)
        with arena() as inner:
            middle = inner.escape(Node(value=2, next=Some(Node(value=3, next=None))))
        _ = churn(5)
        total = middle.value * 10 + next_value(middle)
    return total == 23


# spec-case: ARENA-ESCAPE-CLASS-1
public def test_escape_copies_a_class_with_no_fields() -> bool:
    kept: list[Empty] = []
    with arena() as scratch:
        made = Empty()
        kept = scratch.escape([made, made])
    return len(kept) == 2
