module arena_class_escape

# `name.escape(value)` carries finite value trees and nested lists out of an
# arena. Earlier values remain independent after a copied value is changed.


record Node:
    value: int
    next: Option[Node]


record Box:
    items: list[Node]
    label: str


record Empty:
    pass


def churn(rounds: int) -> int:
    total = 0
    for index in range(rounds):
        scratch: list[int] = [index, index + 1]
        total = total + len(scratch)
    return total


def next_value(node: Node) -> int:
    match node.next:
        case Some(child):
            return child.value
        case None:
            return 0 - 1


# spec: ARENA-ESCAPE-VALUE-1
public def test_escape_copies_a_record_and_the_values_it_reaches() -> bool:
    kept = Node(value=0, next=None)
    with arena() as scratch:
        leaf = Node(value=5, next=None)
        kept = scratch.escape(Node(value=7, next=Some(leaf)))
    _ = churn(20)
    return kept.value * 10 + next_value(kept) == 75


# spec-case: ARENA-ESCAPE-VALUE-1
public def test_escape_copies_a_finite_recursive_record() -> bool:
    kept = Node(value=0, next=None)
    with arena() as scratch:
        first = Node(value=1, next=None)
        second = Node(value=2, next=Some(first))
        kept = scratch.escape(second)
    _ = churn(20)
    earlier = kept
    kept.value = 100
    return earlier.value == 2 and kept.value == 100 and next_value(kept) == 1


# spec-case: ARENA-ESCAPE-VALUE-1
public def test_escape_copies_records_inside_lists_and_lists_inside_records() -> bool:
    kept = Box(items=[], label="")
    with arena() as scratch:
        shared = Node(value=3, next=None)
        box = Box(items=[shared, shared, Node(value=4, next=None)], label="made in the arena")
        kept = scratch.escape(box)
    _ = churn(20)
    kept.items[0].value = 30
    return kept.items[1].value == 3 and kept.items[2].value == 4 and kept.label == "made in the arena"


# spec-case: ARENA-ESCAPE-VALUE-1
public def test_escape_keeps_an_older_value_independent() -> bool:
    older = Node(value=9, next=None)
    kept = Node(value=0, next=None)
    with arena() as scratch:
        kept = scratch.escape(Node(value=1, next=Some(older)))
    older.value = 90
    return next_value(kept) == 9 and older.value == 90


# spec-case: ARENA-ESCAPE-VALUE-1
public def test_an_escaped_record_keeps_a_young_value_stored_after_promotion() -> bool:
    kept = Node(value=0, next=None)
    with arena() as scratch:
        kept = scratch.escape(Node(value=1, next=None))
    _ = churn(20)
    kept.next = Some(Node(value=6, next=None))
    _ = churn(20)
    return next_value(kept) == 6


# spec-case: ARENA-ESCAPE-VALUE-1
public def test_escape_into_an_enclosing_arena_copies_the_record_there() -> bool:
    total = 0
    with arena() as outer:
        middle = Node(value=0, next=None)
        with arena() as inner:
            middle = inner.escape(Node(value=2, next=Some(Node(value=3, next=None))))
        _ = churn(5)
        total = middle.value * 10 + next_value(middle)
    return total == 23


# spec-case: ARENA-ESCAPE-VALUE-1
public def test_escape_copies_a_record_with_no_fields() -> bool:
    kept: list[Empty] = []
    with arena() as scratch:
        made = Empty()
        kept = scratch.escape([made, made])
    return len(kept) == 2
