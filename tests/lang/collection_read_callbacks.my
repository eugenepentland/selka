func change_index(mut values: int[]) -> int:
    values.clear()
    values.append(91)
    return 0


# spec: COW-READ-RECEIVER-1
public func test_read_receiver_is_captured_before_a_mutating_index() -> bool:
    mut values = [7, 8]
    const receiver = values.copy()
    mut selected = receiver[change_index(mut values)]
    return selected == 7 and values == [91]


func change_negative(mut values: int[]) -> int:
    values.clear()
    values.append(91)
    return -1


# spec-case: COW-READ-RECEIVER-1
public func test_negative_index_uses_the_captured_receiver_length() -> bool:
    mut values = [7, 8]
    const receiver = values.copy()
    mut selected = receiver[change_negative(mut values)]
    return selected == 8 and values == [91]


func select_pinned(mut values: int[]) -> int:
    const receiver = values.copy()
    return receiver[change_index(mut values)]


# spec-case: COW-READ-RECEIVER-1
public func test_read_capture_copies_an_already_pinned_parameter() -> bool:
    mut values = [7, 8]
    mut selected = select_pinned(mut values)
    return selected == 7 and values == [91]


func swap_row(mut rows: int[][]) -> int:
    rows[0] = [91]
    return 0


# spec-case: COW-READ-RECEIVER-1
public func test_nested_read_keeps_the_row_selected_before_replacement() -> bool:
    mut rows = [[7, 8]]
    const receiver = rows[0].copy()
    mut selected = receiver[swap_row(mut rows)]
    return selected == 7 and rows == [[91]]


func change_key(mut values: dict[int, int]) -> int:
    values[0] = 91
    return 0


# spec-case: COW-READ-RECEIVER-1
public func test_dictionary_read_captures_before_key_mutation() -> bool:
    mut values = {0: 7}
    const receiver = values.copy()
    mut selected = receiver[change_key(mut values)]
    return selected == 7 and values[0] == 91


func select_pinned_mapping(mut values: dict[int, int]) -> int:
    const receiver = values.copy()
    return receiver[change_key(mut values)]


# spec-case: COW-READ-RECEIVER-1
public func test_dictionary_read_copies_a_pinned_receiver() -> bool:
    mut values = {0: 7}
    mut selected = select_pinned_mapping(mut values)
    return selected == 7 and values[0] == 91


record Payload:
    mapping: dict[int, int]


func change_field(mut value: Payload) -> int:
    value.mapping[0] = 91
    return 0


# spec-case: COW-READ-RECEIVER-1
public func test_dictionary_read_captures_a_record_field_before_key_mutation() -> bool:
    mut value = Payload(mapping={0: 7})
    const receiver = value.mapping.copy()
    mut selected = receiver[change_field(mut value)]
    return selected == 7 and value.mapping[0] == 91


func change_nested_key(mut values: dict[int, int[]]) -> int:
    values[0] = [91]
    return 0


# spec-case: COW-READ-RECEIVER-1
public func test_dictionary_read_captures_a_managed_result_before_replacement() -> bool:
    mut values = {0: [7, 8]}
    const receiver = values.copy()
    mut selected = receiver[change_nested_key(mut values)].copy()
    return selected == [7, 8] and values[0] == [91]


func snapshot_pinned(mut values: int[]) -> int:
    mut snapshot = values.copy()
    values[0] = 92
    return snapshot[0]


# spec-case: COW-READ-RECEIVER-1
public func test_pinned_named_snapshot_takes_the_slow_copy_path() -> bool:
    mut values = [7, 8]
    mut selected = snapshot_pinned(mut values)
    return selected == 7 and values == [92, 8]


func snapshot_after_call(mut values: int[]) -> int:
    mut ignored = change_index(mut values)
    mut snapshot = values.copy()
    values[0] = 92
    return snapshot[0] + ignored


# spec-case: COW-READ-RECEIVER-1
public func test_nested_call_preserves_the_outer_pin_for_a_later_snapshot() -> bool:
    mut values = [7, 8]
    mut selected = snapshot_after_call(mut values)
    return selected == 91 and values == [92]


func main() -> int:
    assert test_read_receiver_is_captured_before_a_mutating_index()
    assert test_negative_index_uses_the_captured_receiver_length()
    assert test_read_capture_copies_an_already_pinned_parameter()
    assert test_nested_read_keeps_the_row_selected_before_replacement()
    assert test_dictionary_read_captures_before_key_mutation()
    assert test_dictionary_read_copies_a_pinned_receiver()
    assert test_dictionary_read_captures_a_record_field_before_key_mutation()
    assert test_dictionary_read_captures_a_managed_result_before_replacement()
    assert test_pinned_named_snapshot_takes_the_slow_copy_path()
    assert test_nested_call_preserves_the_outer_pin_for_a_later_snapshot()
    return 0
