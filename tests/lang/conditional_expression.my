module conditional_expression

# `value_if_true if condition else value_if_false` is one expression: the
# condition is bool, both arms share one type (the expected type when the
# context supplies one), only the chosen arm is evaluated, and nesting is
# allowed. These cases pin the value, the laziness and the positions the
# expression is usable in.


public record Point:
    x: int
    y: int


def fails() -> int:
    zero = 0
    return 1 // zero


def scaled(value: int, double: bool) -> int:
    return value * (2 if double else 1)


def describe(value: int) -> int:
    return value + 1


# spec-case: CONDITIONAL-EXPR-3
public def test_only_the_chosen_arm_is_evaluated() -> bool:
    return (42 if True else fails()) == 42


# spec-case: CONDITIONAL-EXPR-3
public def test_the_else_arm_runs_when_the_condition_is_false() -> bool:
    return (1 if False else 42) == 42


# spec-case: CONDITIONAL-EXPR-4
public def test_a_conditional_takes_its_arm_type_from_the_expected_type() -> bool:
    small: u8 = 1 if True else 2
    return int(small) == 1


# spec-case: CONDITIONAL-EXPR-4
public def test_a_conditional_nests_in_its_else_arm() -> bool:
    return (1 if False else 2 if False else 3) == 3


# spec-case: CONDITIONAL-EXPR-4
public def test_a_conditional_value_passes_as_a_call_argument() -> bool:
    return describe(1 if True else 2) == 2


# spec-case: CONDITIONAL-EXPR-4
public def test_a_conditional_value_fills_an_fstring_hole() -> bool:
    count = 1
    label = f"{count} {'item' if count == 1 else 'items'}"
    return label == "1 item"


# spec-case: CONDITIONAL-EXPR-4
public def test_a_conditional_selects_between_record_values() -> bool:
    point = Point(x=532, y=0) if True else Point(x=352, y=0)
    return point.x == 532


# spec-case: CONDITIONAL-EXPR-4
public def test_a_conditional_selects_by_an_expected_option_type() -> bool:
    found = Some(7) if True else None
    match found:
        case Some(index):
            return index == 7
        case None:
            return False


# spec-case: CONDITIONAL-EXPR-3
public def test_a_conditional_expression_forwards_its_condition_to_a_helper() -> bool:
    return scaled(21, True) == 42
