import dicts

record RenderEntry:
    number: int
    text: str


record RenderWide:
    title: str
    words: str[]
    payload: bytes
    ratio: float
    count: int
    empty: Unit


record RenderLink:
    label: str
    next: RenderLink?


enum RenderChoice:
    small(value: u8)
    empty(value: Unit)
    words(value: str[])


func render_wide(value: RenderWide) -> str:
    return f"{value}"


func render_pair(value: RenderEntry) -> str:
    return f"{value}"


func render_links(value: RenderLink?) -> str:
    return f"{value}"


func render_owned_links(own value: RenderLink?) -> str:
    return f"{value}"


func render_optional_text(value: str??) -> str:
    return f"{value}"


func render_owned_optional_text(own value: str??) -> str:
    return f"{value}"


func render_optional_bytes(value: bytes?) -> str:
    return f"{value}"


func render_owned_optional_bytes(own value: bytes?) -> str:
    return f"{value}"


func render_optional_list(value: int[]?) -> str:
    return f"{value}"


func render_owned_optional_list(own value: int[]?) -> str:
    return f"{value}"


func owned_wrapper_rendering() -> str:
    const links: RenderLink? = Some(RenderLink(label="head-" + str(1), next=None))
    const text: str?? = Some(Some("line-\n" + str(2)))
    const octets: bytes? = Some(b"\x00" + b"\xff")
    const rows: int[]? = Some([3, 4])
    return render_owned_links(own links) + "|" + render_owned_optional_text(own text) + "|" + render_owned_optional_bytes(own octets) + "|" + render_owned_optional_list(own rows)


func borrowed_wrapper_rendering() -> str:
    mut links: RenderLink? = Some(RenderLink(label="head-" + str(1), next=None))
    mut text: str?? = Some(Some("line-\n" + str(2)))
    mut octets: bytes? = Some(b"\x00" + b"\xff")
    mut rows: int[]? = Some([3, 4])
    const rendered = render_links(links) + "|" + render_optional_text(text) + "|" + render_optional_bytes(octets) + "|" + render_optional_list(rows)
    links = None
    text = None
    octets = None
    rows = None
    return rendered


func wrappers_rendered_as_expected(first: str, second: str) -> bool:
    if first != "Some(RenderLink(label='head-1', next=None))|Some(Some('line-\\n2'))|Some(b'\\x00\\xff')|Some([3, 4])":
        return False
    return second == first and render_optional_text(None) == "None" and render_optional_text(Some(None)) == "Some(None)" and render_optional_bytes(None) == "None" and render_optional_list(None) == "None"


func loan_render_entry(value: RenderEntry) -> RenderEntry from value:
    return value


func loan_render_mapping(value: dict[str, str]) -> dict[str, str] from value:
    return value


func whole_roots_rendered_as_expected(first: str, second: str) -> bool:
    return first == "RenderEntry(number=9, text='entry-1')|{'key': 'value-2'}" and second == first


# spec-case: NEW-CORE-S3-VALUES-1
public func test_rendering_borrows_wide_values_and_returns_independent_text() -> bool:
    mut value = RenderWide(title="item-" + str(1), words=["a" + str(2), "é"], payload=b"\xff\x00", ratio=1.5, count=-7, empty=())
    const first = render_wide(value)
    const second = render_wide(value)
    if value.title != "item-1" or value.words != ["a2", "é"] or value.payload != b"\xff\x00":
        return False
    value = RenderWide(title="replacement", words=[], payload=b"", ratio=0.0, count=0, empty=())
    return first == "RenderWide(title='item-1', words=['a2', 'é'], payload=b'\\xff\\x00', ratio=1.5, count=-7, empty=None)" and second == first


# spec-case: NEW-CORE-S3-VALUES-1
public func test_rendering_preserves_canonical_union_and_tuple_layouts() -> bool:
    const pair: RenderEntry = RenderEntry(number=9, text="n" + str(2))
    const pair_text = render_pair(pair)
    const small = RenderChoice.small(value=255u8)
    const empty = RenderChoice.empty(value=())
    mut words = RenderChoice.words(value=["x" + str(3)])
    const word_text = f"{words}"
    words = RenderChoice.words(value=[])
    return pair_text == "RenderEntry(number=9, text='n2')" and render_pair(pair) == pair_text and f"{small}" == "RenderChoice.small(value=255)" and f"{empty}" == "RenderChoice.empty(value=None)" and word_text == "RenderChoice.words(value=['x3'])"


# spec-case: NEW-CORE-S3-VALUES-1
public func test_rendering_recursive_boxes_and_ordered_containers_borrows_children() -> bool:
    mut links: RenderLink? = Some(RenderLink(label="head-" + str(1), next=Some(RenderLink(label="tail-" + str(2), next=None))))
    const rendered = render_links(links)
    if render_links(links) != rendered:
        return False
    links = None
    mut mapping = {"b" + str(2): ["second"], "a" + str(1): ["first"]}
    const ordered = f"{mapping}"
    dicts.clear(mut mapping)
    const rows: RenderEntry[] = [RenderEntry(number=1, text="x"), RenderEntry(number=2, text="y")]
    return rendered == "Some(RenderLink(label='head-1', next=Some(RenderLink(label='tail-2', next=None))))" and ordered == "{'b2': ['second'], 'a1': ['first']}" and f"{rows}" == "[RenderEntry(number=1, text='x'), RenderEntry(number=2, text='y')]" and len(rows) == 2


# spec-case: NEW-CORE-S3-VALUES-1
public func test_rendering_owned_wrappers_before_borrowed_wrappers_keeps_each_layout() -> bool:
    const first = owned_wrapper_rendering()
    const second = borrowed_wrapper_rendering()
    return wrappers_rendered_as_expected(first, second)


# spec-case: NEW-CORE-S3-VALUES-1
public func test_rendering_borrowed_wrappers_before_owned_wrappers_keeps_each_layout() -> bool:
    const first = borrowed_wrapper_rendering()
    const second = owned_wrapper_rendering()
    return wrappers_rendered_as_expected(first, second)


# spec-case: NEW-CORE-S3-VALUES-1
public func test_rendering_owned_roots_before_declared_borrowed_roots_shares_storage_layout() -> bool:
    mut entry = RenderEntry(number=9, text="entry-" + str(1))
    mut mapping = {"key": "value-" + str(2)}
    const first = f"{entry}|{mapping}"
    const second = f"{loan_render_entry(entry)}|{loan_render_mapping(mapping)}"
    entry.text = "changed"
    dicts.clear(mut mapping)
    return whole_roots_rendered_as_expected(first, second)


# spec-case: NEW-CORE-S3-VALUES-1
public func test_rendering_declared_borrowed_roots_before_owned_roots_shares_storage_layout() -> bool:
    mut entry = RenderEntry(number=9, text="entry-" + str(1))
    mut mapping = {"key": "value-" + str(2)}
    const first = f"{loan_render_entry(entry)}|{loan_render_mapping(mapping)}"
    const second = f"{entry}|{mapping}"
    entry.text = "changed"
    dicts.clear(mut mapping)
    return whole_roots_rendered_as_expected(first, second)


func main() -> int:
    assert test_rendering_borrows_wide_values_and_returns_independent_text()
    assert test_rendering_preserves_canonical_union_and_tuple_layouts()
    assert test_rendering_recursive_boxes_and_ordered_containers_borrows_children()
    assert test_rendering_owned_wrappers_before_borrowed_wrappers_keeps_each_layout()
    assert test_rendering_borrowed_wrappers_before_owned_wrappers_keeps_each_layout()
    assert test_rendering_owned_roots_before_declared_borrowed_roots_shares_storage_layout()
    assert test_rendering_declared_borrowed_roots_before_owned_roots_shares_storage_layout()
    return 0
