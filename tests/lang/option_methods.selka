func head[T: copy + storable](values: T[]) -> T?:
    if len(values) == 0:
        return None
    return Some(values[0])


func default_of[T: copy + storable](value: T?, fallback: T) -> T:
    return value.unwrap_or(fallback)


func presence[T: copy + storable](value: T?) -> bool:
    return value.is_some() and not value.is_none()


func absence[T: copy + storable](value: T?) -> bool:
    return value.is_none() and not value.is_some()


func narrowed_default(value: int?) -> int:
    if value is None:
        return 9
    return value.unwrap_or(9)


func bounded(value: int?, fallback: int) -> int noalloc:
    if value.is_none():
        return fallback
    return value.unwrap_or(fallback)


func bounded_default(value: int?, fallback: int) -> int noalloc:
    return value.unwrap_or(fallback)


func measured(value: int?) -> int:
    _ = value.is_none()
    _ = value.is_some()
    _ = value.unwrap_or(4)
    if value.is_some():
        return bounded_default(value, 5) + 1
    return bounded_default(value, 5)


# spec-case: OPTION-METHODS-1
public func test_option_methods_default_on_some_and_none() -> bool:
    mut present: int? = Some(42)
    mut absent: int? = None
    return present.unwrap_or(7) == 42 and absent.unwrap_or(7) == 7


# spec-case: OPTION-METHODS-1
public func test_option_methods_presence_tests() -> bool:
    mut present: int? = Some(1)
    mut absent: int? = None
    return present.is_some() and not present.is_none() and absent.is_none() and not absent.is_some()


# spec-case: OPTION-METHODS-2
public func test_option_methods_generic_bodies() -> bool:
    mut values = [3, 4]
    mut empty: int[] = []
    return default_of(head(values), 0) == 3 and default_of(head(empty), 9) == 9 and presence(head(values)) and absence(head(empty))


# spec-case: OPTION-METHODS-1
public func test_option_methods_literal_default_adopts_payload_type() -> bool:
    mut narrow: u8[] = [u8(5)]
    mut missing: u8[] = []
    mut adopted: u8 = head(narrow).unwrap_or(7)
    mut fallback: u8 = head(missing).unwrap_or(7)
    return adopted == u8(5) and fallback == u8(7)


# spec-case: OPTION-METHODS-2
public func test_option_methods_under_noalloc() -> bool:
    return bounded(Some(3), 8) == 3 and bounded(None, 8) == 8 and bounded_default(None, 5) == 5 and bounded_default(Some(2), 5) == 2


# spec-case: OPTION-METHODS-1
public func test_option_methods_presence_after_narrowing() -> bool:
    return narrowed_default(Some(4)) == 4 and narrowed_default(None) == 9


# spec-case: OPTION-METHODS-2
public func test_option_methods_as_statements_and_arguments() -> bool:
    return measured(Some(3)) == 4 and measured(None) == 5
