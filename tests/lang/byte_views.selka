func span_of(data: bytes, start: int, end: int) -> bytes:
    return data.view(start, end)


func heap_span(text: bytes) -> bytes:
    mut owned = text + b"-tail"
    return owned.view(0, len(text))


func churn(count: int) -> int:
    mut total = 0
    mut index = 0
    while index < count:
        mut scratch: int[] = []
        scratch.append(index)
        total += len(scratch)
        index += 1
    return total


# A view answers every read of the range it names: length, indexing, iteration,
# comparison, search and decode, all against the source's own octets.
# spec: PY-BYTES-7
public func test_a_view_reads_its_range_with_every_byte_string_operation() -> bool:
    mut source = b"content-length: 42\r\n"
    mut value = source.view(16, 18)
    if value != b"42" or len(value) != 2:
        return False
    if value[0] != 52 or value[1] != 50:
        return False
    if value.find(b"2") != 1 or value.find_any(b"0123456789", 0) != 0:
        return False
    if not value.startswith(b"4") or not value.endswith(b"2"):
        return False
    mut total = 0
    for octet in value:
        total += octet
    if total != 102:
        return False
    match value.decode():
        case Ok(text):
            if text != "42":
                return False
        case Err(_):
            return False
    mut name = source.view(0, 14)
    if name != b"content-length" or b"length" not in name:
        return False
    return source.view(14, 16) == b": "


# A view's endpoints clamp exactly like the slice that would have copied them, so
# a negative start counts from the end and a reversed range is empty.
# spec-case: PY-BYTES-7
public func test_view_endpoints_clamp_like_a_slice() -> bool:
    mut source = b"0123456789"
    if source.view(2, 5) != b"234":
        return False
    if source.view(0 - 3, 10) != b"789":
        return False
    if source.view(0 - 99, 3) != b"012":
        return False
    if source.view(7, 99) != b"789":
        return False
    if source.view(5, 5) != b"" or len(source.view(5, 5)) != 0:
        return False
    if source.view(6, 2) != b"" or len(source.view(6, 2)) != 0:
        return False
    if span_of(source, 99, 99) != b"" or len(span_of(source, 4, 4)) != 0:
        return False
    if source.view(0, 10) != source or source.view(0, len(source)) != b"0123456789":
        return False
    return b"".view(0, 0) == b"" and len(b"abc".view(1, 2)) == 1


# A view keeps the octets it names reachable: the source may be a local that has
# already returned, and collection between construction and reading changes
# nothing. A copy taken before an append to the source is a different value.
# spec-case: PY-BYTES-7
public func test_views_retain_their_source_across_collection() -> bool:
    mut retained = heap_span(b"alpha-bravo")
    if retained != b"alpha-bravo" or len(retained) != 11:
        return False
    if churn(5000) != 5000:
        return False
    if retained != b"alpha-bravo" or retained[0] != 97 or retained[10] != 111:
        return False
    mut inner = retained.view(6, 11)
    if inner != b"bravo":
        return False
    if churn(5000) != 5000:
        return False
    if inner != b"bravo" or retained != b"alpha-bravo":
        return False
    if inner.copy() != b"bravo" or inner.copy() == b"brav":
        return False
    return inner.decode() == retained.view(6, 11).decode()


# Slicing a view copies the range it names, and a view of a view keeps reading the
# same source, so nesting neither widens nor loses octets.
# spec-case: PY-BYTES-7
public func test_views_nest_and_slices_copy_their_range() -> bool:
    mut source = b"the quick brown fox"
    mut words = source.view(4, 19)
    if words != b"quick brown fox":
        return False
    mut inner = words.view(6, 11)
    if inner != b"brown":
        return False
    mut copied = inner[1:4]
    if copied != b"row" or len(copied) != 3:
        return False
    if inner.view(0, len(inner)) != b"brown" or inner.copy() != b"brown":
        return False
    mut owned = inner.copy()
    if owned != b"brown" or owned == b"brow":
        return False
    if source.view(4, 9) != b"quick" or words.view(0, 5) != b"quick":
        return False
    return words.view(12, 15) == b"fox" and len(words.view(12, 15)) == 3


# `scalar_count()` validates the range's UTF-8 in the pass that counts it, so a
# width measurement needs no decoded text and a malformed range reports a reason.
# spec: PY-BYTES-8
public func test_scalar_count_counts_scalars_and_rejects_malformed_utf8() -> bool:
    mut ascii = b"hello"
    match ascii.scalar_count():
        case Ok(width):
            if width != 5:
                return False
        case Err(_):
            return False
    mut mixed = b"a\xce\xbbb\xf0\x9f\x98\x80c"
    match mixed.scalar_count():
        case Ok(width):
            if width != 5:
                return False
        case Err(_):
            return False
    match b"".scalar_count():
        case Ok(width):
            if width != 0:
                return False
        case Err(_):
            return False
    match b"\xff".scalar_count():
        case Ok(_):
            return False
        case Err(message):
            if len(message) == 0:
                return False
    match b"\xc0\xaf".scalar_count():
        case Ok(_):
            return False
        case Err(_):
            pass
    match b"\xed\xa0\x80".scalar_count():
        case Ok(_):
            return False
        case Err(_):
            pass
    match b"\xf0\x9f\x98".scalar_count():
        case Ok(_):
            return False
        case Err(_):
            pass
    match b"\xce".scalar_count():
        case Ok(_):
            return False
        case Err(_):
            pass
    match b"a\xce\xbbb".view(1, 3).scalar_count():
        case Ok(width):
            if width != 1:
                return False
        case Err(_):
            return False
    match ascii.view(1, 4).copy().scalar_count():
        case Ok(width):
            return width == 3
        case Err(_):
            return False


# A byte string parses numbers through the one pinned grammar, reading its own
# octets, so a numeric leaf needs no decoded temporary and no allocation.
# spec: PY-BYTES-9
public func test_byte_strings_parse_numbers_without_decoding() -> bool:
    match b"42".parse_int():
        case Some(value):
            if value != 42:
                return False
        case None:
            return False
    match b"  -12  ".parse_int():
        case Some(value):
            if value != 0 - 12:
                return False
        case None:
            return False
    match b"1_000_000".parse_int():
        case Some(value):
            if value != 1000000:
                return False
        case None:
            return False
    match b"-9223372036854775808".parse_int():
        case Some(value):
            if value != -9223372036854775808:
                return False
        case None:
            return False
    match b"9223372036854775808".parse_int():
        case Some(_):
            return False
        case None:
            pass
    match b"12a".parse_int():
        case Some(_):
            return False
        case None:
            pass
    match b"".parse_int():
        case Some(_):
            return False
        case None:
            pass
    match b"1.5".parse_float():
        case Some(value):
            if value != 1.5:
                return False
        case None:
            return False
    match b"1e3".parse_float():
        case Some(value):
            if value != 1000.0:
                return False
        case None:
            return False
    match b"inf".parse_float():
        case Some(value):
            if value < 1000000.0:
                return False
        case None:
            return False
    match b"nan".parse_float():
        case Some(value):
            if value == value:
                return False
        case None:
            return False
    match b"1.5x".parse_float():
        case Some(_):
            return False
        case None:
            pass
    mut token = b"size=2.5mm".view(5, 8)
    match token.parse_float():
        case Some(value):
            return value == 2.5
        case None:
            return False
