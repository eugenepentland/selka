# Legacy retained ranges now use slices: a read-only slice borrows its source,
# and every assertion below still holds for the octets. No sharing savings are
# assumed.
import bytes
import strings

func span_of(data: bytes, start: int, end: int) -> bytes:
    return copy(data[start:end])


func heap_span(text: bytes) -> bytes:
    mut owned = text + b"-tail"
    return copy((owned[0:len(text)]))


func churn(count: int) -> int:
    mut total = 0
    mut index = 0
    while index < count:
        mut scratch: int[] = []
        append(mut scratch, index)
        total += len(scratch)
        index += 1
    return total


# An independent byte range supports length, indexing, iteration, comparison,
# search and decoding with the same values as the original range.
# spec-case: PY-BYTES-1
public func test_an_owned_slice_supports_every_byte_string_operation() -> bool:
    mut source = b"content-length: 42\r\n"
    mut value = copy(source[16:18])
    if value != b"42" or len(value) != 2:
        return False
    if value[0] != 52 or value[1] != 50:
        return False
    if bytes.find(value, b"2") != 1 or bytes.find_any(value, b"0123456789", 0) != 0:
        return False
    if not bytes.starts_with(value, b"4") or not bytes.ends_with(value, b"2"):
        return False
    mut total = 0
    for octet in value:
        total += octet
    if total != 102:
        return False
    match strings.decode(value):
        case Ok(text):
            if text != "42":
                return False
        case Err(_):
            return False
    mut name = copy(source[0:14])
    if name != b"content-length" or b"length" not in name:
        return False
    return source[14:16] == b": "


# Owned ranges clamp nonnegative endpoints. Relative-from-end positions are
# computed explicitly, and a reversed range is empty.
# spec-case: NEW-CORE-ZERO-RC-LIBRARY-1
public func test_owned_slice_endpoints_clamp() -> bool:
    mut source = b"0123456789"
    if source[2:5] != b"234":
        return False
    if source[max(len(source) - 3, 0):10] != b"789":
        return False
    if source[max(len(source) - 99, 0):3] != b"012":
        return False
    if source[7:99] != b"789":
        return False
    if source[5:5] != b"" or len(source[5:5]) != 0:
        return False
    if source[6:2] != b"" or len(source[6:2]) != 0:
        return False
    if span_of(source, 99, 99) != b"" or len(span_of(source, 4, 4)) != 0:
        return False
    if source[0:10] != source or source[0:len(source)] != b"0123456789":
        return False
    return b""[0:0] == b"" and len(b"abc"[1:2]) == 1


# An owned range survives destruction of a local source and allocation churn.
# spec-case: NEW-CORE-ZERO-RC-LIBRARY-1
public func test_owned_slices_survive_source_destruction_and_allocation() -> bool:
    mut retained = heap_span(b"alpha-bravo")
    if retained != b"alpha-bravo" or len(retained) != 11:
        return False
    if churn(5000) != 5000:
        return False
    if retained != b"alpha-bravo" or retained[0] != 97 or retained[10] != 111:
        return False
    mut inner = copy(retained[6:11])
    if inner != b"bravo":
        return False
    if churn(5000) != 5000:
        return False
    if inner != b"bravo" or retained != b"alpha-bravo":
        return False
    if copy(inner) != b"bravo" or copy(inner) == b"brav":
        return False
    return strings.decode(inner) == strings.decode(retained[6:11])


# Nested owned ranges keep the selected octets; further slices are independent.
# spec-case: NEW-CORE-ZERO-RC-LIBRARY-1
public func test_nested_owned_slices_preserve_their_range() -> bool:
    mut source = b"the quick brown fox"
    mut words = copy(source[4:19])
    if words != b"quick brown fox":
        return False
    mut inner = copy(words[6:11])
    if inner != b"brown":
        return False
    mut copied = copy(inner[1:4])
    if copied != b"row" or len(copied) != 3:
        return False
    if inner[0:len(inner)] != b"brown" or copy(inner) != b"brown":
        return False
    mut owned = own inner
    if owned != b"brown" or owned == b"brow":
        return False
    if source[4:9] != b"quick" or words[0:5] != b"quick":
        return False
    return words[12:15] == b"fox" and len(words[12:15]) == 3


# `scalar_count()` validates the range's UTF-8 in the pass that counts it, so a
# width measurement needs no decoded text and a malformed range reports a reason.
# spec: PY-BYTES-8
public func test_scalar_count_counts_scalars_and_rejects_malformed_utf8() -> bool:
    mut ascii = b"hello"
    match bytes.scalar_count(ascii):
        case Ok(width):
            if width != 5:
                return False
        case Err(_):
            return False
    mut mixed = b"a\xce\xbbb\xf0\x9f\x98\x80c"
    match bytes.scalar_count(mixed):
        case Ok(width):
            if width != 5:
                return False
        case Err(_):
            return False
    match bytes.scalar_count(b""):
        case Ok(width):
            if width != 0:
                return False
        case Err(_):
            return False
    match bytes.scalar_count(b"\xff"):
        case Ok(_):
            return False
        case Err(message):
            if strings.char_count(message) == 0:
                return False
    match bytes.scalar_count(b"\xc0\xaf"):
        case Ok(_):
            return False
        case Err(_):
            pass
    match bytes.scalar_count(b"\xed\xa0\x80"):
        case Ok(_):
            return False
        case Err(_):
            pass
    match bytes.scalar_count(b"\xf0\x9f\x98"):
        case Ok(_):
            return False
        case Err(_):
            pass
    match bytes.scalar_count(b"\xce"):
        case Ok(_):
            return False
        case Err(_):
            pass
    match bytes.scalar_count(b"a\xce\xbbb"[1:3]):
        case Ok(width):
            if width != 1:
                return False
        case Err(_):
            return False
    match bytes.scalar_count(copy(ascii[1:4])):
        case Ok(width):
            return width == 3
        case Err(_):
            return False


# A byte string parses numbers through the one pinned grammar, reading its own
# octets, so a numeric leaf needs no decoded temporary and no allocation.
# spec: PY-BYTES-9
public func test_byte_strings_parse_numbers_without_decoding() -> bool:
    match bytes.parse_int(b"42"):
        case Some(value):
            if value != 42:
                return False
        case None:
            return False
    match bytes.parse_int(b"  -12  "):
        case Some(value):
            if value != 0 - 12:
                return False
        case None:
            return False
    match bytes.parse_int(b"1_000_000"):
        case Some(value):
            if value != 1000000:
                return False
        case None:
            return False
    match bytes.parse_int(b"-9223372036854775808"):
        case Some(value):
            if value != -9223372036854775808:
                return False
        case None:
            return False
    match bytes.parse_int(b"9223372036854775808"):
        case Some(_):
            return False
        case None:
            pass
    match bytes.parse_int(b"12a"):
        case Some(_):
            return False
        case None:
            pass
    match bytes.parse_int(b""):
        case Some(_):
            return False
        case None:
            pass
    match bytes.parse_float(b"1.5"):
        case Some(value):
            if value != 1.5:
                return False
        case None:
            return False
    match bytes.parse_float(b"1e3"):
        case Some(value):
            if value != 1000.0:
                return False
        case None:
            return False
    match bytes.parse_float(b"inf"):
        case Some(value):
            if value < 1000000.0:
                return False
        case None:
            return False
    match bytes.parse_float(b"nan"):
        case Some(value):
            if value == value:
                return False
        case None:
            return False
    match bytes.parse_float(b"1.5x"):
        case Some(_):
            return False
        case None:
            pass
    mut token = copy(b"size=2.5mm"[5:8])
    match bytes.parse_float(token):
        case Some(value):
            return value == 2.5
        case None:
            return False
