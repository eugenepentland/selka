import memo

func number(key: memo.Key) -> int effects():
    match key:
        case memo.Key.Number(value=value):
            return value
        case memo.Key.Text(value=value):
            return len(value)
        case memo.Key.Data(value=value):
            return len(value)


func shifted(key: memo.Key) -> int effects():
    return number(key) + 100


# spec-case: STANDARD-MEMO-1
public func test_completed_values_reuse_and_clear() -> bool:
    match memo.create(2, number):
        case Ok(initial):
            mut cache = initial
            mut first = memo.call(mut cache, memo.Key.Number(value=42))
            mut second = memo.call(mut cache, memo.Key.Number(value=42))
            if first.reused or not second.reused or first.value != 42 or second.value != 42:
                return False
            memo.clear(mut cache)
            if memo.count(cache) != 0 or memo.capacity(cache) != 2:
                return False
            return not memo.call(mut cache, memo.Key.Number(value=42)).reused
        case Err(_):
            return False


enum Completed:
    Failed(message: str)
    Value(value: int)


func classified(key: memo.Key) -> Completed:
    if number(key) < 0:
        return Completed.Failed(message="negative input")
    return Completed.Value(value=number(key))


# spec-case: STANDARD-MEMO-1
public func test_completed_error_categories_are_ordinary_values() -> bool:
    match memo.create(1, classified):
        case Ok(initial):
            mut cache = initial
            mut first = memo.call(mut cache, memo.Key.Number(value=-1))
            mut again = memo.call(mut cache, memo.Key.Number(value=-1))
            if first.reused or not again.reused:
                return False
            match again.value:
                case Completed.Failed(message=message):
                    return message == "negative input"
                case Completed.Value(value=_):
                    return False
        case Err(_):
            return False


# spec-case: STANDARD-MEMO-1
public func test_argument_tags_and_function_identity_separate_entries() -> bool:
    match memo.create(8, number):
        case Ok(initial):
            mut cache = initial
            mut a = memo.call(mut cache, memo.Key.Number(value=1))
            mut b = memo.call(mut cache, memo.Key.Text(value="1"))
            mut c = memo.call(mut cache, memo.Key.Data(value=b"1"))
            if not memo.call(mut cache, memo.Key.Text(value="1")).reused or not memo.call(mut cache, memo.Key.Data(value=b"1")).reused:
                return False
            cache.compute = shifted
            mut d = memo.call(mut cache, memo.Key.Number(value=1))
            if a.reused or b.reused or c.reused or d.reused or d.value != 101:
                return False
            if memo.count(cache) != 4:
                return False
            if not memo.call(mut cache, memo.Key.Number(value=1)).reused:
                return False
            cache.compute = number
            return memo.call(mut cache, memo.Key.Number(value=1)).reused
        case Err(_):
            return False


# spec-case: STANDARD-MEMO-1
public func test_hit_leaves_fifo_eviction_order_unchanged() -> bool:
    match memo.create(2, number):
        case Ok(initial):
            mut cache = initial
            _ = memo.call(mut cache, memo.Key.Number(value=1))
            _ = memo.call(mut cache, memo.Key.Number(value=2))
            if not memo.call(mut cache, memo.Key.Number(value=1)).reused:
                return False
            _ = memo.call(mut cache, memo.Key.Number(value=3))
            if not memo.call(mut cache, memo.Key.Number(value=2)).reused:
                return False
            if memo.call(mut cache, memo.Key.Number(value=1)).reused:
                return False
            return memo.count(cache) == 2 and not memo.call(mut cache, memo.Key.Number(value=2)).reused
        case Err(_):
            return False


# spec-case: STANDARD-MEMO-1
public func test_zero_capacity_executes_without_retention() -> bool:
    match memo.create(0, number):
        case Ok(initial):
            mut cache = initial
            mut first = memo.call(mut cache, memo.Key.Number(value=4))
            mut second = memo.call(mut cache, memo.Key.Number(value=4))
            return not first.reused and not second.reused and first.value == 4 and second.value == 4 and memo.count(cache) == 0
        case Err(_):
            return False


# spec-case: STANDARD-MEMO-1
public func test_one_entry_and_repeated_evictions_keep_bounded_slots() -> bool:
    match memo.create(1, number):
        case Ok(initial):
            mut cache = initial
            for value in range(300):
                mut fresh = memo.call(mut cache, memo.Key.Number(value=value))
                mut again = memo.call(mut cache, memo.Key.Number(value=value))
                if fresh.reused or not again.reused or again.value != value:
                    return False
                if memo.count(cache) != 1 or len(cache.entries) != 1:
                    return False
            memo.clear(mut cache)
            return memo.capacity(cache) == 1 and memo.count(cache) == 0
        case Err(_):
            return False


record Nested:
    rows: dict[str, int[]]


func nested(key: memo.Key) -> Nested:
    return Nested(rows={"kept": [number(key), 9]})


func alternate_nested(key: memo.Key) -> Nested:
    return Nested(rows={"kept": [number(key) + 100, 9]})


# spec-case: STANDARD-MEMO-1
public func test_returned_nested_values_are_independent_snapshots() -> bool:
    match memo.create(2, nested):
        case Ok(initial):
            mut cache = initial
            mut result = memo.call(mut cache, memo.Key.Number(value=42))
            result.value.rows["kept"].append(10)
            result.value.rows["kept"][0] = 0
            mut again = memo.call(mut cache, memo.Key.Number(value=42))
            return again.reused and again.value.rows["kept"] == [42, 9] and result.value.rows["kept"] == [0, 9, 10]
        case Err(_):
            return False


# spec-case: STANDARD-MEMO-1
public func test_cache_copy_has_independent_entries_and_clear() -> bool:
    match memo.create(1, nested):
        case Ok(initial):
            mut cache = initial
            _ = memo.call(mut cache, memo.Key.Number(value=42))
            mut copy = cache.copy()
            copy.compute = alternate_nested
            _ = memo.call(mut copy, memo.Key.Number(value=42))
            mut original = memo.call(mut cache, memo.Key.Number(value=42))
            mut replacement = memo.call(mut copy, memo.Key.Number(value=42))
            if not original.reused or not replacement.reused or original.value.rows["kept"] != [42, 9]:
                return False
            memo.clear(mut copy)
            return memo.count(copy) == 0 and memo.count(cache) == 1 and memo.call(mut cache, memo.Key.Number(value=42)).reused
        case Err(_):
            return False


# spec-case: STANDARD-MEMO-1
public func test_byte_key_owns_the_original_byte_value() -> bool:
    match memo.create(2, number):
        case Ok(initial):
            mut cache = initial
            mut source = [65, 66]
            mut key = memo.Key.Data(value=bytes(source))
            mut first = memo.call(mut cache, key)
            source[0] = 90
            source.append(67)
            key = memo.Key.Data(value=bytes(source))
            mut changed = memo.call(mut cache, key)
            mut old = memo.call(mut cache, memo.Key.Data(value=b"AB"))
            return not first.reused and not changed.reused and changed.value == 3 and old.reused and old.value == 2
        case Err(_):
            return False


# spec-case: STANDARD-MEMO-1
public func test_capacity_validation_and_upper_boundary() -> bool:
    match memo.create(-1, number):
        case Ok(_):
            return False
        case Err(error):
            if len(memo.message(error)) == 0:
                return False
    match memo.create(65537, number):
        case Ok(_):
            return False
        case Err(_):
            _ = 0
    match memo.create(65536, number):
        case Ok(cache):
            return memo.capacity(cache) == 65536 and memo.count(cache) == 0
        case Err(_):
            return False


func main() -> int:
    assert test_completed_values_reuse_and_clear()
    assert test_completed_error_categories_are_ordinary_values()
    assert test_argument_tags_and_function_identity_separate_entries()
    assert test_hit_leaves_fifo_eviction_order_unchanged()
    assert test_zero_capacity_executes_without_retention()
    assert test_one_entry_and_repeated_evictions_keep_bounded_slots()
    assert test_returned_nested_values_are_independent_snapshots()
    assert test_cache_copy_has_independent_entries_and_clear()
    assert test_byte_key_owns_the_original_byte_value()
    assert test_capacity_validation_and_upper_boundary()
    return 42
