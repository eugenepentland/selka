# Fresh recursive constructors keep every child owned through a complete handoff.
record Node:
    value: int
    left: Option[Node]
    right: Option[Node]


def tree(depth: int) -> Node:
    if depth == 0:
        return Node(1, None, None)
    return Node(depth, Some(tree(depth - 1)), Some(tree(depth - 1)))


def reordered(depth: int) -> Node:
    if depth == 0:
        return Node(right=None, value=1, left=None)
    return Node(right=Some(reordered(depth - 1)), value=depth, left=Some(reordered(depth - 1)))


def weight(node: Node) -> int:
    result = node.value
    match node.left:
        case Some(child):
            result += weight(child)
        case None:
            pass
    match node.right:
        case Some(child):
            result += weight(child)
        case None:
            pass
    return result


union Chain:
    empty,
    link(value: int, rest: Chain)


def chain(depth: int) -> Chain:
    if depth == 0:
        return Chain.empty
    return Chain.link(depth, chain(depth - 1))


def chain_sum(value: Chain) -> int:
    match value:
        case Chain.empty:
            return 0
        case Chain.link(number, rest):
            return number + chain_sum(rest)


def in_arena() -> Node:
    with arena() as scratch:
        value = tree(5)
        assert weight(value) == 89
        return scratch.escape(value)


def aliased(depth: int) -> Node:
    child: Option[Node] = Some(tree(depth))
    return Node(0, child, child)


# spec-case: RC-FRESH-CONSTRUCTOR-1
public def test_recursive_fresh_record_children_have_independent_owners() -> bool:
    value = tree(5)
    value.left = None
    return weight(value) == 47 and weight(tree(5)) == 89


# spec-case: RC-FRESH-CONSTRUCTOR-1
public def test_named_constructor_order_preserves_the_result() -> bool:
    return weight(reordered(5)) == 89


# spec-case: RC-FRESH-CONSTRUCTOR-1
public def test_recursive_variant_payloads_retain_every_child() -> bool:
    return chain_sum(chain(20)) == 210 and chain_sum(chain(0)) == 0


# spec-case: RC-FRESH-CONSTRUCTOR-1
public def test_aliased_immutable_boxes_keep_the_generic_transfer_path() -> bool:
    value = aliased(4)
    before = value
    value.left = None
    return weight(before) == 84 and weight(value) == 42


def main() -> int:
    assert test_recursive_fresh_record_children_have_independent_owners()
    assert test_named_constructor_order_preserves_the_result()
    assert test_recursive_variant_payloads_retain_every_child()
    assert test_aliased_immutable_boxes_keep_the_generic_transfer_path()
    return 0
