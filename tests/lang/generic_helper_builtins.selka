# A generic function that calls an ordinary helper (F-S1a-3). The abstract check of a template does not walk the
# helpers it calls, so a helper may write any prelude builtin the concrete checker knows: `set()`, `dict()`, `list(...)`,
# `sum`, `min`, `max`, `abs`, `any`, `all`, `reversed`, `zip`, `ord` and `print`. Each helper is built, used through
# the generic, and checked for its value, so a helper that only checked was not enough.
import sets

func new_set() -> set[str]:
    mut result: set[str] = set()
    sets.add(mut result, "a")
    sets.add(mut result, "b")
    return result


func set_of(values: int[]) -> set[int]:
    return set(values)


func new_dict() -> dict[str, int]:
    mut result: dict[str, int] = dict()
    result["a"] = 1
    result["b"] = 2
    return result


func copied_dict(source: dict[str, int]) -> dict[str, int]:
    return dict(source)


func copied_list(values: int[]) -> int[]:
    return list(values)


func counted_list(n: int) -> int[]:
    return list(range(n))


func folds(values: int[]) -> int:
    return sum(values) + min(values) + max(values) + abs(-2)


func truths(values: bool[]) -> int:
    mut score = 0
    if any(values):
        score += 1
    if all(values):
        score += 10
    return score


func backwards(values: int[]) -> int:
    mut first = -1
    for value in reversed(values):
        first = value
        break
    return first


func pairs(left: int[], right: int[]) -> int:
    mut total = 0
    for a, b in zip(left, right):
        total += a * b
    return total


func code_of(text: str) -> int:
    return ord(text)


func print_through(out: Stream, value: int):
    print(out, value)


func through_set[C](value: C) -> int:
    return len(new_set())


func through_dict[C](value: C) -> int:
    return len(new_dict()) + len(copied_dict(new_dict()))


func through_lists[C](value: C) -> int:
    return len(copied_list([1, 2, 3])) + len(counted_list(4)) + len(set_of([1, 1, 2]))


func through_folds[C](value: C) -> int:
    return folds([1, 2, 3]) + truths([True, False]) + backwards([4, 5, 6]) + pairs([1, 2], [3, 4]) + code_of("a")


func through_print[C](out: Stream, value: C) -> int:
    print_through(out, 7)
    return 1


public func test_a_generic_function_reaches_a_helper_that_builds_a_set() -> bool:
    return through_set[int](1) == 2


public func test_a_generic_function_reaches_helpers_that_build_dictionaries() -> bool:
    return through_dict[int](1) == 4


public func test_a_generic_function_reaches_helpers_that_build_lists() -> bool:
    return through_lists[str]("x") == 9


public func test_a_generic_function_reaches_helpers_that_fold_and_zip() -> bool:
    # folds: 6 + 1 + 3 + 2 = 12; truths: 1; backwards: 6; pairs: 3 + 8 = 11; ord("a") = 97.
    return through_folds[float](1.5) == 127


public func test_a_generic_function_reaches_a_helper_that_prints(out: Stream) -> bool:
    return through_print[int](out, 1) == 1
