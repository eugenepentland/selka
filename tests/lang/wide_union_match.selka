        case w49(value):
            return value * 100 + 49
        case w50(value):
            return value * 100 + 50
        case w51(value):
            return value * 100 + 51
        case w52(value):
            return value * 100 + 52
        case w53(value):
            return value * 100 + 53
        case w54(value):
            return value * 100 + 54
        case w55(value):
            return value * 100 + 55
        case w56(value):
            return value * 100 + 56
        case w57(value):
            return value * 100 + 57
        case w58(value):
            return value * 100 + 58
        case w59(value):
            return value * 100 + 59
        case w60(value):
            return value * 100 + 60
        case w61(value):
            return value * 100 + 61
        case w62(value):
            return value * 100 + 62
        case w63(value):
            return value * 100 + 63
        case w64(value):
            return value * 100 + 64
        case w65(value):
            return value * 100 + 65
        case w66(value):
            return value * 100 + 66
        case w67(value):
            return value * 100 + 67
        case w68(value):
            return value * 100 + 68
        case w69(value):
            return value * 100 + 69
        case named(text):
            return len(text)


func make(index: int) -> Wide:
    if index == 0:
        return Wide.w0(value=index + 1)
    if index == 63:
        return Wide.w63(value=index + 1)
    if index == 64:
        return Wide.w64(value=index + 1)
    if index == 69:
        return Wide.w69(value=index + 1)
    return Wide.named(text="index " + str(index))


func take_text(own item: Wide) -> str:
    match own item:
        case named(text):
            return text
        case _:
            return ""


public func test_a_match_over_seventy_cases_reads_the_payload_of_the_case_it_tests() -> bool:
    return weigh(make(0)) == 100 and weigh(make(63)) == 6463 and weigh(make(64)) == 6564 and weigh(make(69)) == 7069


public func test_match_own_takes_the_payload_past_the_sixty_fourth_case() -> bool:
    return take_text(make(5)) == "index 5" and take_text(make(64)) == "" and weigh(make(7)) == 7
