    w39(value: int)
    w40(value: int)
    w41(value: int)
    w42(value: int)
    w43(value: int)
    w44(value: int)
    w45(value: int)
    w46(value: int)
    w47(value: int)
    w48(value: int)
    w49(value: int)
    w50(value: int)
    w51(value: int)
    w52(value: int)
    w53(value: int)
    w54(value: int)
    w55(value: int)
    w56(value: int)
    w57(value: int)
    w58(value: int)
    w59(value: int)
    w60(value: int)
    w61(value: int)
    w62(value: int)
    w63(value: int)
    w64(value: int)
    w65(value: int)
    w66(value: int)
    w67(value: int)
    w68(value: int)
    w69(value: int)
    named(text: str)


func weigh(item: Wide) -> int:
    match item:
        case w0(value):
            return value * 100 + 0
        case w1(value):
            return value * 100 + 1
        case w2(value):
            return value * 100 + 2
        case w3(value):
            return value * 100 + 3
        case w4(value):
            return value * 100 + 4
        case w5(value):
            return value * 100 + 5
        case w6(value):
            return value * 100 + 6
        case w7(value):
            return value * 100 + 7
        case w8(value):
            return value * 100 + 8
        case w9(value):
            return value * 100 + 9
        case w10(value):
            return value * 100 + 10
        case w11(value):
            return value * 100 + 11
        case w12(value):
            return value * 100 + 12
        case w13(value):
            return value * 100 + 13
        case w14(value):
            return value * 100 + 14
        case w15(value):
            return value * 100 + 15
        case w16(value):
            return value * 100 + 16
        case w17(value):
            return value * 100 + 17
        case w18(value):
            return value * 100 + 18
        case w19(value):
            return value * 100 + 19
        case w20(value):
            return value * 100 + 20
        case w21(value):
            return value * 100 + 21
        case w22(value):
            return value * 100 + 22
        case w23(value):
            return value * 100 + 23
        case w24(value):
            return value * 100 + 24
        case w25(value):
            return value * 100 + 25
        case w26(value):
            return value * 100 + 26
        case w27(value):
            return value * 100 + 27
        case w28(value):
            return value * 100 + 28
        case w29(value):
            return value * 100 + 29
        case w30(value):
            return value * 100 + 30
        case w31(value):
            return value * 100 + 31
        case w32(value):
            return value * 100 + 32
        case w33(value):
            return value * 100 + 33
        case w34(value):
            return value * 100 + 34
        case w35(value):
            return value * 100 + 35
        case w36(value):
            return value * 100 + 36
        case w37(value):
            return value * 100 + 37
        case w38(value):
            return value * 100 + 38
        case w39(value):
            return value * 100 + 39
        case w40(value):
            return value * 100 + 40
        case w41(value):
            return value * 100 + 41
        case w42(value):
            return value * 100 + 42
        case w43(value):
