# An enum of more than 64 cases with payloads: the IR verifier's union-tag rule keeps a set of cases of any width, so a
# `match` on it is checked like a small one (lane VL, F-VL-10), and `match own` takes the payload of the case it tests.
enum Wide:
    w0(value: int)
    w1(value: int)
    w2(value: int)
    w3(value: int)
    w4(value: int)
    w5(value: int)
    w6(value: int)
    w7(value: int)
    w8(value: int)
    w9(value: int)
    w10(value: int)
    w11(value: int)
    w12(value: int)
    w13(value: int)
    w14(value: int)
    w15(value: int)
    w16(value: int)
    w17(value: int)
    w18(value: int)
    w19(value: int)
    w20(value: int)
    w21(value: int)
    w22(value: int)
    w23(value: int)
    w24(value: int)
    w25(value: int)
    w26(value: int)
    w27(value: int)
    w28(value: int)
    w29(value: int)
    w30(value: int)
    w31(value: int)
    w32(value: int)
    w33(value: int)
    w34(value: int)
    w35(value: int)
    w36(value: int)
    w37(value: int)
