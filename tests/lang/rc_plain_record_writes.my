record State:
    values: int[]
    count: int
    ready: bool


func add(mut state: State, amount: int):
    state.count = state.count + amount


func observe_then_change(mut state: State) -> int:
    mut before = state.count
    state.values.append(before)
    state.count = before + 10
    return before + 2


func from_callback(mut state: State):
    mut next_count = observe_then_change(mut state)
    state.count = next_count


func toggled(mut state: State):
    state.ready = False
    state.ready = True
    state.ready = False


func loop(mut state: State, times: int):
    mut i = 0
    while i < times:
        state.count = state.count + 1
        i += 1


public func test_saved_record_and_child_snapshots_survive_scalar_publication() -> bool:
    mut state = State(values=[7], count=3, ready=True)
    mut saved = state
    mut children = state.values
    add(mut state, 4)
    add(mut state, 2)
    state.values.append(9)
    return state.count == 9 and saved.count == 3 and saved.values == [7] and children == [7]


public func test_rhs_observation_and_mutation_complete_before_final_store() -> bool:
    mut state = State(values=[1], count=5, ready=True)
    from_callback(mut state)
    return state.count == 7 and state.values == [1, 5]


public func test_loop_reuse_and_boolean_width_preserve_siblings() -> bool:
    mut state = State(values=[2, 4], count=0, ready=True)
    loop(mut state, 50)
    toggled(mut state)
    return state.count == 50 and not state.ready and state.values == [2, 4]


func count_for_append(mut state: State) -> int:
    state.count = state.count + 1
    return state.count


func with_snapshot(mut state: State, snapshot: State) -> bool:
    state.count = state.count + 1
    return snapshot.count + 1 == state.count


public func test_same_call_snapshot_and_pinned_parent_keep_distinct_scalar_bits() -> bool:
    mut state = State(values=[5], count=2, ready=True)
    mut first = with_snapshot(mut state, state)
    mut states = [state]
    mut saved = states
    mut mutation_result_88 = count_for_append(mut state)
    state.values.append(mutation_result_88)
    mut changed = states[0]
    add(mut changed, 4)
    states[0] = changed
    return first and state.count == 4 and state.values == [5, 4] and states[0].count == 7 and saved[0].count == 3


func main(out: Stream) -> int:
    out.print(test_saved_record_and_child_snapshots_survive_scalar_publication())
    out.print(test_rhs_observation_and_mutation_complete_before_final_store())
    out.print(test_loop_reuse_and_boolean_width_preserve_siblings())
    out.print(test_same_call_snapshot_and_pinned_parent_keep_distinct_scalar_bits())
    return 0
