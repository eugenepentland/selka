module bounded_loop_ranges

def calculate(count: int, seed: int) -> int:
    total = seed
    for at in range(count):
        total = (total + at * 7) % 1000003
    return total

def replaced(count: int, seed: int) -> int:
    total = seed
    for at in range(count):
        total = remtrunc(total + at * 7, -1009)
    return total

def skipped(count: int, seed: int) -> int:
    total = seed
    for at in range(count):
        if at % 3 != 0:
            total = (total + at) % 1009
        if at == 23:
            break
    return total

def continued(count: int, seed: int) -> int:
    total = seed
    for at in range(count):
        if at % 3 == 0:
            continue
        total = (total + at) % 1009
    return total

def domains(count: int) -> int:
    value = 0.0
    checksum = 0
    for at in range(count):
        value += float(at) * 0.5
        checksum += at
    return int(value) + checksum

# spec-case: QBE-LOOP-BOUNDED-WRITE-1
public def test_modular_replacements_keep_seed_and_loop_boundaries() -> bool:
    return calculate(64, 0) == 14112 and calculate(4, 0) == 42 and calculate(0, 17) == 17 and calculate(-3, 19) == 19

# spec-case: QBE-LOOP-BOUNDED-WRITE-1
public def test_negative_truncating_replacements_keep_their_sign() -> bool:
    return replaced(32, -100000) == 336 and replaced(64, -31) == 964 and replaced(0, -31) == -31

# spec-case: QBE-LOOP-BOUNDED-WRITE-1
public def test_conditional_replacements_break_and_continue_keep_carried_values() -> bool:
    return skipped(64, 17) == 209 and skipped(0, 19) == 19 and continued(32, -31) == 300

# spec-case: RC-SCALAR-LOOP-COMPOSE-1
public def test_float_domains_keep_ordered_exact_dyadic_arithmetic() -> bool:
    return domains(32) == 744 and domains(4) == 9 and domains(0) == 0

def affine(at: int) -> int:
    return at * 7

def inlined(count: int, seed: int) -> int:
    total = seed
    for at in range(count):
        total = (total + affine(at)) % 1000003
    return total

def convert_loop(count: int, value: float) -> int:
    checksum = 0
    for at in range(count):
        checksum = int(i8(value))
    return checksum

# spec-case: QBE-LOOP-BOUNDED-WRITE-1
public def test_extreme_and_short_seeds_keep_their_modular_totals() -> bool:
    return calculate(32, -9223372036854775807 - 1) == 328130 and calculate(32, -31) == 3441 and calculate(0, 9223372036854775807) == 9223372036854775807 and calculate(4, 17) == 59

# spec-case: RC-SCALAR-LOOP-COMPOSE-1
public def test_a_helper_call_in_a_modular_loop_keeps_the_same_totals() -> bool:
    return inlined(32, 17) == 3489 and inlined(32, 17) + domains(32) == 4233 and inlined(0, 5) == 5

# spec-case: RC-SCALAR-LOOP-COMPOSE-1
public def test_a_float_to_i8_conversion_in_a_loop_truncates_toward_zero() -> bool:
    return convert_loop(32, 1.5) == 1 and convert_loop(32, -1.5) == -1 and convert_loop(32, 127.9) == 127 and convert_loop(0, 128.0) == 0

def main() -> int:
    return 0
