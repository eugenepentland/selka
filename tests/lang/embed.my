
import embed_support

const NUL: bytes = embed_bytes("embed_fixtures/nul.bin")

const BINARY: bytes = embed_bytes("embed_fixtures/binary.bin")

const MULTI: str = embed_str("embed_fixtures/multi.txt")

const EMPTY: bytes = embed_bytes("embed_fixtures/empty.bin")

func inline_bytes() -> bytes:
    return embed_bytes("embed_fixtures/nul.bin")


func pure_length() -> int noalloc:
    return len(NUL) + len(BINARY) + len(embed_bytes("embed_fixtures/support.txt"))


func generic_length[T](value: T) -> int noalloc:
    return len(embed_bytes("embed_fixtures/binary.bin"))


# spec-case: EMBED-1
public func test_embed_bytes_keeps_every_byte_including_nul() -> bool:
    if len(NUL) != 5:
        return False
    if NUL[0] != 97 or NUL[2] != 0 or NUL[4] != 100:
        return False
    return NUL == b"ab\x00cd" and NUL[1:4] == b"b\x00c"


# spec-case: EMBED-1
public func test_embed_bytes_carries_bytes_that_are_not_utf8() -> bool:
    if len(BINARY) != 5:
        return False
    if BINARY[0] != 255 or BINARY[1] != 254 or BINARY[2] != 128:
        return False
    if BINARY[3] != 0 or BINARY[4] != 127:
        return False
    mut raw = BINARY
    match raw.decode():
        case Ok(_):
            return False
        case Err(_):
            return True


# spec-case: EMBED-1
public func test_embed_str_reads_multibyte_text_as_scalars() -> bool:
    if MULTI != "héllo 🙂 日本":
        return False
    if len(MULTI) != 10:
        return False
    mut text = MULTI
    return len(text.encode()) == 18 and text[1] == "é"


# spec-case: EMBED-1
public func test_embed_of_an_empty_file_is_empty() -> bool:
    if len(EMPTY) != 0 or EMPTY != b"":
        return False
    return len(embed_str("embed_fixtures/empty.bin")) == 0


# spec-case: EMBED-1
public func test_embed_call_and_constant_read_the_same_bytes() -> bool:
    return inline_bytes() == NUL and embed_bytes("embed_fixtures/nul.bin") == NUL


# spec-case: EMBED-1
public func test_embed_is_allowed_where_allocation_is_not() -> bool:
    return pure_length() == 25 and generic_length(3) == 5 and generic_length(NUL) == 5


# spec-case: EMBED-1
public func test_embedded_constants_are_readable_from_another_module() -> bool:
    if embed_support.SUPPORT != b"shared fixture\n":
        return False
    if embed_support.support_length() != 15:
        return False
    return embed_support.GREETING == MULTI and embed_support.SUPPORT == embed_bytes("embed_fixtures/support.txt")


# spec-case: EMBED-1
public func test_one_file_embeds_as_bytes_and_as_text() -> bool:
    mut raw = embed_bytes("embed_fixtures/multi.txt")
    mut text = embed_str("embed_fixtures/multi.txt")
    if len(raw) != 18 or len(text) != 10:
        return False
    return text.encode() == raw and embed_support.GREETING == text
