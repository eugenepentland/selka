import lists
import strings
import testing

"""Contract clauses that hold: every test runs its clauses and returns True
only when the program carried on past them. Violations and diagnostics are
Zig tests in `src/contracts_test.zig`."""


@invariant(self.low <= self.high, "a range never runs backwards")
record Range:
    low: int
    high: int = 100


record Window:
    span: Range
    label: int


@invariant(self.value <= 1000u32)
record Millimeters:
    value: u32


@requires(value <= 1000u32, "a distance fits the representable range")
func from(value: u32) -> Millimeters:
    return Millimeters(value=value)


@requires(amount > 0, "amount must be positive")
@requires(len(accounts) > 0)
@ensures(result <= amount)
@ensures(len(log) == old(len(log)) + 1)
func withdraw(accounts: int[], mut log: str[], amount: int) -> int:
    append(mut log, "withdraw")
    if accounts[0] < amount:
        return accounts[0]
    return amount


@ensures(result >= 0, "a length is never negative")
func parse(text: str) -> int fails str:
    if text == "":
        fail "empty"
    return strings.char_count(text)


func doubled(text: str) -> int fails str:
    mut n = try parse(text)
    return n * 2


@ensures(result > 0)
func skip_on_error(text: str) -> int fails str:
    if text == "bad":
        fail "rejected"
    return 1


@ensures(len(items) == old(len(items)) + 2)
func push_twice(mut items: int[], value: int):
    append(mut items, value)
    append(mut items, value)


@ensures(result == old(first) + old(second))
func sum_then_forget(first: int, second: int) -> int:
    mut total = first + second
    mut forgotten_first = 0
    mut forgotten_second = 0
    return total + forgotten_first + forgotten_second


@requires(len(values) > 0)
@ensures(result >= values[0])
func biggest[T](values: int[], tag: T) -> int:
    mut best = values[0]
    for value in values:
        if value > best:
            best = value
    return best


func positive(value: int) -> bool:
    debug(value)
    return value > 0


@requires(positive(value))
@ensures(result == old(copy([value, value]))[0] * 2)
func twice(value: int) -> int:
    return value * 2


public func test_withdraw_holds_every_clause_on_both_returns() -> bool:
    mut log: str[] = []
    mut small = withdraw([3], mut log, 5)
    mut large = withdraw([30], mut log, 5)
    return small == 3 and large == 5 and len(log) == 2


func value_or(outcome: Result[int, str], fallback: int) -> int:
    match outcome:
        case Ok(value):
            return value
        case Err(_):
            return fallback


public func test_ensures_checks_only_ok_results() -> bool:
    mut good = value_or(parse("abc"), -1)
    mut empty = value_or(parse(""), -1)
    mut rejected = value_or(skip_on_error("bad"), -1)
    return good == 3 and empty == -1 and rejected == -1


public func test_propagated_error_skips_the_postcondition() -> bool:
    return value_or(doubled("ab"), -1) == 4 and value_or(doubled(""), -1) == -1


public func test_procedure_postcondition_runs_at_its_implicit_end() -> bool:
    mut items = [1]
    push_twice(mut items, 7)
    return len(items) == 3 and items[2] == 7


public func test_old_captures_parameters_at_entry() -> bool:
    return sum_then_forget(2, 3) == 5


public func test_generic_function_checks_its_clauses() -> bool:
    return biggest([3, 9, 2], "tag") == 9 and biggest([4], 1) == 4


public func test_contracts_may_call_helpers_and_allocate() -> bool:
    return twice(21) == 42


public func test_invariant_holds_through_construction_and_defaults() -> bool:
    mut positional = Range(low=1, high=5)
    mut named = Range(low=2, high=3)
    mut defaulted = Range(low=50)
    return positional.high == 5 and named.low == 2 and defaulted.high == 100


public func test_invariant_holds_through_replace_and_field_writes() -> bool:
    mut span = Range(low=1, high=5)
    span.high = 9
    span.low += 3
    mut moved = replace(span, low=8)
    mut window = Window(span=moved, label=1)
    window.span.high = 20
    return span.low == 4 and moved.low == 8 and window.span.high == 20


public func test_invariant_holds_through_destructuring_targets() -> bool:
    mut span = Range(low=1, high=5)
    const next_low = 2
    const next_high = 6
    span.low = next_low
    span.high = next_high
    return span.low == 2 and span.high == 6


public func test_record_invariant_holds_through_factory() -> bool:
    mut distance = from(700u32)
    return distance.value == 700u32


enum Shortage:
    Truncated


@ensures(count >= 0)
func need(count: int) -> Unit fails Shortage:
    if count < 0:
        fail Shortage.Truncated
    return ()


@ensures(count >= old(count))
func need_quietly(count: int) -> Unit fails Shortage:
    if count < 0:
        fail Shortage.Truncated


public func test_ensures_on_a_unit_result_checks_the_success_return() -> bool:
    mut held = 0
    match need(2):
        case Ok(value):
            # Binding the `Unit` payload is the shape that once crashed the build.
            _ = value
            held = 1
        case Err(_):
            held = -1
    mut failed = 0
    match need(-1):
        case Ok(_):
            failed = -1
        case Err(_):
            failed = 1
    mut quiet = 0
    match need_quietly(3):
        case Ok(_):
            quiet = 1
        case Err(_):
            quiet = -1
    return held == 1 and failed == 1 and quiet == 1


@invariant(self.line >= 1, "lines count from one")
record Cursor:
    source: bytes
    pos: int
    line: int


@invariant(self.depth >= 0)
record Reader:
    cursor: Cursor
    depth: int


func advance(mut cursor: Cursor, k: int):
    cursor.pos = k
    cursor.line += 1


func descend(mut reader: Reader, k: int):
    reader.cursor.pos = k
    reader.depth += 1


func advance_first(mut cursors: Cursor[], k: int):
    cursors[0].line = k


func advance_some(mut cursor: Cursor?, k: int):
    match mut cursor:
        case Some(found):
            found.pos = k
        case None:
            return


func advance_present(mut cursor: Cursor?, k: int):
    if cursor is not None:
        cursor.line = k


func advance_named(mut cursors: dict[str, Cursor], k: int):
    cursors["a"].pos = k


func advance_pair(mut cursors: FixedArray[Cursor, 2], k: int):
    cursors[1].line = k


func fresh_cursor() -> Cursor:
    return Cursor(source=b"abc", pos=0, line=1)


public func test_invariant_on_a_managed_record_holds_through_mut_parameter_writes() -> bool:
    mut cursor = fresh_cursor()
    advance(mut cursor, 2)
    mut reader = Reader(cursor=fresh_cursor(), depth=0)
    descend(mut reader, 3)
    mut cursors = [fresh_cursor()]
    advance_first(mut cursors, 4)
    mut some: Cursor? = fresh_cursor()
    advance_some(mut some, 5)
    advance_present(mut some, 6)
    mut named: dict[str, Cursor] = {}
    named["a"] = fresh_cursor()
    advance_named(mut named, 7)
    mut pair = FixedArray[Cursor, 2]([fresh_cursor(), fresh_cursor()])
    advance_pair(mut pair, 8)
    mut moved = 0
    match some:
        case Some(found):
            moved = found.pos + found.line
        case None:
            moved = -1
    const kept = cursor.line == 2 and cursor.pos == 2 and len(cursor.source) == 3
    const nested = reader.cursor.pos == 3 and reader.depth == 1
    return kept and nested and cursors[0].line == 4 and moved == 11 and named["a"].pos == 7 and pair[1].line == 8


func cursor_writes(n: int) -> int:
    mut cursor = fresh_cursor()
    mut reader = Reader(cursor=fresh_cursor(), depth=0)
    for i in range(n):
        advance(mut cursor, i)
        descend(mut reader, i)
    return cursor.line + reader.depth


public func test_checking_an_invariant_after_a_field_write_copies_nothing() -> bool:
    return testing.allocations(cursor_writes, 200) - testing.allocations(cursor_writes, 100) == 0


@ensures(position > old(position))
func count_up(mut position: int) -> int:
    mut result = 0
    while True:
        result += 1
        if result > 3:
            position += 1
            return result
    return result


@ensures(result >= 10, "the clause reads the returned value, not the local")
func offset(k: int) -> int:
    mut result = 1
    if k > 5:
        return result + 20
    for i in range(k):
        result += 1
        if result > 3:
            return result + 10
    return result + 9


public func test_a_body_local_named_result_resolves_at_every_return() -> bool:
    mut position = 0
    const counted = count_up(mut position)
    return counted == 4 and position == 1 and offset(9) == 21 and offset(9 - 8) == 11 and offset(5) == 14


@invariant(len(self.items) >= 1, "a bag is never empty")
record Bag:
    items: int[]
    label: str
    count: int


func bag_of(k: int) -> Bag:
    return Bag(items=[k], label="b", count=0)


func refill(mut bag: Bag, k: int) -> int:
    const old = exchange(mut bag.items, [k, k])
    append(mut bag.items, k)
    return len(old)


func double_last(mut items: int[]):
    append(mut items, items[len(items) - 1] * 2)


func through_hook(hook: func(mut items: int[]) -> Unit, mut bag: Bag):
    hook(mut bag.items)


func refill_first(mut bags: Bag[], k: int) -> int:
    const old = exchange(mut bags[0].items, [k])
    return len(old)


public func test_invariant_holds_through_take_exchange_and_in_place_field_updates() -> bool:
    mut bag = bag_of(1)
    const first = refill(mut bag, 2)
    lists.reverse(mut bag.items)
    bag.items[0] = 5
    through_hook(double_last, mut bag)
    const label = take(mut bag.label)
    const count = exchange(mut bag.count, 3)
    mut bags = [bag_of(3)]
    const second = refill_first(mut bags, 4)
    mut held: Bag? = bag_of(6)
    mut grown = 0
    match mut held:
        case Some(found):
            append(mut found.items, 7)
            found.count = 2
            grown = len(found.items) + found.count
        case None:
            grown = -1
    const updated = first == 1 and len(bag.items) == 4 and bag.items[0] == 5 and bag.items[3] == 4 and bag.count == 3 and count == 0
    return updated and label == "b" and bag.label == "" and second == 1 and bags[0].items[0] == 4 and grown == 4


public func test_a_store_into_a_local_of_an_inner_block_checks_its_invariant() -> bool:
    mut total = 0
    if total == 0:
        mut inner = bag_of(1)
        inner.count = 2
        append(mut inner.items, 3)
        total = inner.count + len(inner.items)
    return total == 4


func bag_updates(n: int) -> int:
    mut bag = Bag(items=[1, 2], label="b", count=0)
    mut total = 0
    for i in range(n):
        bag.items[0] = i + 1
        lists.reverse(mut bag.items)
        total += exchange(mut bag.count, i)
    return total + bag.items[0]


public func test_checking_an_invariant_after_take_or_exchange_copies_nothing() -> bool:
    return testing.allocations(bag_updates, 200) - testing.allocations(bag_updates, 100) == 0


func main() -> int:
    return 0
