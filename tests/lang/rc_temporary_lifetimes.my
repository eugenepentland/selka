# spec: RC-TEMPORARY-EDGE-1
public def test_nested_write_releases_only_finished_read_temporaries() -> bool:
    rows = [[1, 2], [3, 4]]
    snapshot = rows
    for index in range(40):
        rows[0][1] = rows[0][1] + rows[1][0]
    return rows == [[1, 122], [3, 4]] and snapshot == [[1, 2], [3, 4]]


# spec-case: RC-TEMPORARY-EDGE-1
public def test_derived_value_survives_finished_parent_temporary() -> bool:
    rows = [[[1]], [[2]]]
    selected = rows[0][0]
    rows.clear()
    selected.append(7)
    return selected == [1, 7]


def save(rows: list[list[int]], saved: mut list[list[list[int]]]) -> int:
    saved.append(rows)
    return 9


# spec-case: RC-TEMPORARY-EDGE-1
public def test_pending_receiver_holds_survive_temporary_releases() -> bool:
    rows = [[1]]
    saved: list[list[list[int]]] = []
    rows[0].append(save(rows, mut saved))
    return rows == [[1, 9]] and saved == [[[1]]]


# spec-case: RC-TEMPORARY-EDGE-1
public def test_zero_iteration_and_branch_paths_keep_snapshot_owners() -> bool:
    rows = [[1]]
    snapshot = rows
    for index in range(0):
        rows[0][0] = rows[0][0] + 1
    if len(rows) == 1:
        rows[0][0] = rows[0][0] + 2
    else:
        rows[0][0] = rows[0][0] + 4
    return rows == [[3]] and snapshot == [[1]]


def main() -> int:
    assert test_nested_write_releases_only_finished_read_temporaries()
    assert test_derived_value_survives_finished_parent_temporary()
    assert test_pending_receiver_holds_survive_temporary_releases()
    assert test_zero_iteration_and_branch_paths_keep_snapshot_owners()
    assert test_sorted_empty_receiver_survives_its_mutation_scope()
    assert test_sorted_text_receiver_survives_its_mutation_scope()
    assert test_sorted_method_result_keeps_its_physical_anchor()
    return 0


# spec-case: RC-TEMPORARY-EDGE-1
public def test_sorted_empty_receiver_survives_its_mutation_scope() -> bool:
    source: list[i32] = []
    ordered = sorted(source)
    ordered.append(7i32)
    return ordered == [7i32] and source == []


# spec-case: RC-TEMPORARY-EDGE-1
public def test_sorted_text_receiver_survives_its_mutation_scope() -> bool:
    source = ["pear", "Apple", "apple", "pear"]
    ordered = sorted(source)
    source.clear()
    ordered.append("plum")
    return ordered == ["Apple", "apple", "pear", "pear", "plum"] and source == []


# spec-case: RC-TEMPORARY-EDGE-1
public def test_sorted_method_result_keeps_its_physical_anchor() -> bool:
    source = "pear,Apple,apple,pear"
    ordered = sorted(source.split(",").copy())
    ordered.reverse()
    return ordered == ["pear", "pear", "apple", "Apple"] and source == "pear,Apple,apple,pear"
