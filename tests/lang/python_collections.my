

record Box:
    items: i64[]


func make_box() -> Box:
    return Box(items=[40])


record Point:
    x: i64


record ReceiverPoint:
    x: i64


func logged_receiver(mut log: i64[], rows: ReceiverPoint[]) -> ReceiverPoint[]:
    log.append(1)
    return rows


func log_index(mut log: i64[]) -> i64:
    log.append(2)
    return 0


func emit_value(mut log: i64[]) -> i64:
    log.append(3)
    return 42


record Cell[T]:
    value: T


func set_cell[T](mut cells: Cell[T][], value: T) effects(mutation):
    cells[0].value = value


record WritebackPoint:
    x: i64
    y: i64


func writeback(mut rows: WritebackPoint[]) -> i64 effects(mutation):
    rows[0].y = 2
    return 40


func range_total() -> i64:
    mut sum = 0
    for i in range(7):
        sum += i
    return sum


const RANGE_TOTAL: i64 = range_total()


func duplicate[T: copy + storable](value: T) -> T[]:
    mut values: T[] = [value]
    values.append(value)
    mut copy = values[:]
    for item in copy:
        _ = item
    return copy


func first_key[K, V](counts: dict[K, V], fallback: K) -> K:
    for key, value in counts.items():
        _ = value
        return key
    return fallback


# spec: PY-COLLECTIONS-1
public func test_inferred_literal_indexing_negative_indices_and_append() -> bool:
    mut items = [40, 1]
    items.append(2)
    return items[0] + items[-1] == 42


# spec: PY-COLLECTIONS-4
public func test_contextual_nested_lists_and_receiver_fields() -> bool:
    mut b = make_box()
    b.items.append(2)
    mut rows: i64[][] = [b.items, []]
    return rows[0][0] + rows[0][-1] == 42


# spec: PY-COLLECTIONS-2
public func test_slice_copies_clamps_and_length_uses_signed_index_type() -> bool:
    mut items = [1, 40, 2, 8]
    mut copy = items[-3:99]
    copy[0] = 0
    mut middle = items[1:3]
    return middle[0] + len(middle) == 42


# spec: PY-COLLECTIONS-3
public func test_foreach_enumerate_range_and_continue() -> bool:
    mut items = [10, 20, 9]
    mut sum = 0
    for i, x in enumerate(items):
        sum += i + x
    for i in range(3):
        if i == 0:
            continue
        sum += i
    return sum - 3 == 42


# spec: PY-COLLECTIONS-5
public func test_record_fields_update_values_and_list_slots_without_changing_prior_copies() -> bool:
    mut point = Point(x=1)
    point.x = 2
    mut rows = [point]
    mut before = rows[0]
    rows[0].x = 40
    return before.x + rows[0].x == 42


# spec: PY-COLLECTIONS-7
public func test_field_receiver_index_and_right_side_run_once_in_order_under_collection_stress() -> bool:
    mut log: i64[] = []
    mut rows = [ReceiverPoint(x=0)]
    mut next_value = emit_value(mut log)
    mut target = logged_receiver(mut log, rows)
    mut position = log_index(mut log)
    target[position].x = next_value
    rows = target
    if len(log) != 3:
        return False
    if log[0] != 3 or log[1] != 1 or log[2] != 2:
        return False
    return rows[0].x == 42


# spec: PY-COLLECTIONS-9
public func test_generic_record_slot_updates_and_list_aliases_remain_copyable() -> bool:
    mut cells: Cell[i64][] = [Cell[i64](value=1)]
    set_cell(mut cells, 42)
    return cells[0].value == 42


# spec: PY-COLLECTIONS-10
public func test_slice_negative_clamp_empty_and_copy_alias_semantics() -> bool:
    mut items = [40, 2, 8]
    mut copy = items[-99:-1]
    copy[0] = 1
    if len(items[99:]) != 0 or len(items[2:1]) != 0:
        return False
    return items[0] + copy[-1] == 42


# spec: PY-COLLECTIONS-14
public func test_slice_step_selects_every_nth_element_of_a_list_and_of_text_in_both_directions() -> bool:
    mut items = [1, 2, 3, 4, 5, 6]
    mut text = "abcdef"
    if len(items[0:6:2]) != 3 or items[0:6:2][1] != 3:
        return False
    if len(items[::-1]) != 6 or items[::-1][0] != 6:
        return False
    if len(items[5:0:-2]) != 3 or items[5:0:-2][1] != 4:
        return False
    if len(items[99:0:-1]) != 5 or len(items[0:6:99]) != 1:
        return False
    if text[1:5:2] != "bd" or len(text[::-2]) != 3:
        return False
    if text[4:0:-3] != "eb" or len(text[2:2:1]) != 0:
        return False
    return items[-1:0:-2][0] * 7 == 42


# spec: PY-AUGASSIGN-1
public func test_augmented_assignment_applies_each_binding_types_own_operator_rules() -> bool:
    mut n = 5
    n *= 8
    n += 2
    mut m = 17
    m //= 2
    if m != 8:
        return False
    m %= 5
    if m != 3:
        return False
    mut ratio = 1.0
    ratio += 2.5
    ratio *= 2.0
    if int(ratio) != 7:
        return False
    ratio -= 0.5
    if int(ratio) != 6:
        return False
    mut label = "a"
    label += "b"
    if label != "ab":
        return False
    return n == 42


# spec: PY-AUGASSIGN-2
public func test_augmented_assignment_writes_a_list_slot_and_a_dictionary_entry_in_place() -> bool:
    mut xs = [1, 2]
    xs[0] += 5
    xs[1] *= 3
    xs[-1] -= 6
    mut counts = {"a": 1}
    counts["a"] += 41
    mut label = {"k": "a"}
    label["k"] += "b"
    if xs[0] != 6 or xs[1] != 0:
        return False
    if label["k"] != "ab":
        return False
    return counts["a"] == 42


# spec: PY-COLLECTIONS-15
public func test_list_methods_mutate_in_place_with_python_shaped_bounds() -> bool:
    mut xs = [3, 1, 2]
    xs.sort()
    if xs[0] != 1 or xs[2] != 3:
        return False
    xs.reverse()
    if xs[0] != 3 or xs[2] != 1:
        return False
    xs.insert(0, 9)
    if xs[0] != 9 or len(xs) != 4:
        return False
    xs.remove(9)
    if xs[0] != 3 or len(xs) != 3:
        return False
    xs.extend([7, 8])
    if len(xs) != 5 or xs[4] != 8:
        return False
    mut last = xs.pop()
    if last != 8 or len(xs) != 4:
        return False
    mut middle = xs.pop(1)
    if middle != 2 or len(xs) != 3:
        return False
    xs.clear()
    if len(xs) != 0:
        return False
    return True


# spec: PY-COLLECTIONS-16
public func test_list_index_and_copy_are_read_forms_with_first_occurrence_order() -> bool:
    mut xs = [10, 20, 30, 20]
    if xs.index(20) != 1:
        return False
    mut ys = xs.copy()
    ys.append(99)
    if len(xs) != 4 or len(ys) != 5:
        return False
    return ys[4] + xs[0] - 67 == 42


# spec: PY-COLLECTIONS-17
public func test_dictionary_pop_update_and_setdefault_keep_insertion_order() -> bool:
    mut d = {"a": 1, "b": 2}
    if d.pop("a") != 1:
        return False
    if d.pop("z", 7) != 7:
        return False
    d.update({"b": 20, "c": 3})
    if d["b"] != 20 or d["c"] != 3:
        return False
    if d.setdefault("d", 4) != 4:
        return False
    if d.setdefault("d", 9) != 4:
        return False
    if len(d) != 3:
        return False
    return True


# spec: PY-COLLECTIONS-18
public func test_list_extends_in_place_and_items_binds_key_then_value_in_insertion_order() -> bool:
    mut xs = [1]
    mut alias = xs.copy()
    xs += [2, 3]
    if len(xs) != 3 or alias != [1]:
        return False
    mut d = {10: 100, 20: 200}
    mut total = 0
    for key, value in d.items():
        total += key + value
    if total != 330:
        return False
    return True


# spec-case: PY-COLLECTIONS-18
public func test_generic_bodies_bind_items_key_then_value_in_insertion_order() -> bool:
    mut counts = {10: 100, 20: 200}
    return first_key(counts, 0) == 10


# spec: PY-COLLECTIONS-11
public func test_outer_annotated_postfix_expressions_do_not_contaminate_literal_element_inference() -> bool:
    mut value: i64 = [42][0]
    mut row: i64[] = [[value]][0]
    return row[0] == 42


# spec: PY-COLLECTIONS-12
public func test_range_end_syntax_agrees_in_constant_and_runtime_evaluation() -> bool:
    return RANGE_TOTAL * 2 == 42


# spec: PY-COLLECTIONS-13
public func test_field_writeback_preserves_sibling_changes_made_by_its_right_hand_side() -> bool:
    mut rows = [WritebackPoint(x=0, y=0)]
    mut mutation_result_320 = writeback(mut rows)
    rows[0].x = mutation_result_320
    return rows[0].x + rows[0].y == 42


# spec: PY-COLLECTIONS-6
public func test_generic_lists_preserve_literal_foreach_slice_and_write_element_types() -> bool:
    mut xs = duplicate(21)
    return xs[0] + xs[1] == 42


public func test_scalar_element_reads_load_every_width_from_backing_storage() -> bool:
    mut narrow = [1i16, 2i16, 300i16]
    mut wide = [7i64, 8i64, 9i64]
    mut flags = [False, True]
    mut raw = b"abc"
    mut total = i64(narrow[-1]) + i64(narrow[1]) + wide[-2] + i64(raw[2])
    if flags[-1]:
        total = total + 100
    return total == 509


# A list that outgrows the size classes grows by extending its own reservation,
# so a long append run keeps every element it already stored, keeps the element
# identity of the list, and still reads back through the index it was built with.
# spec: LIST-GROWTH-1
public func test_append_past_the_segment_threshold_keeps_every_element() -> bool:
    mut seed = [for index in range(4096) yield index % 1009]
    mut values: int[] = []
    mut writes = 0
    while writes < 80:
        values.extend(seed)
        writes += 1
    if len(values) != 4096 * 80:
        return False
    mut check = 0
    while check < 4096 * 80:
        if values[check] != (check % 4096) % 1009:
            return False
        check += 1009
    if values[4096 * 80 - 1] != (4096 * 80 - 1) % 4096 % 1009:
        return False
    values.append(0 - 1)
    return values[4096 * 80] == 0 - 1 and len(values) == 4096 * 80 + 1


func main() -> int:
    return 0
