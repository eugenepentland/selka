# spec-case: D2-VIEW-STORAGE-1
import dicts

public func test_explicit_snapshot_preserves_prior_values() -> bool:
    mut mapping = {1: 7}
    mut saved = list(dicts.values(mapping))
    mapping[1] = 9
    mapping[2] = 11
    return saved == [7] and list(dicts.values(mapping)) == [9, 11]


# spec-case: D2-VIEW-STORAGE-1
public func test_snapshots_before_and_after_replacement_capture_each_history() -> bool:
    mut mapping = {1: 7}
    mut first = list(dicts.values(mapping))
    mapping[1] = 13
    mut second = list(dicts.values(mapping))
    mapping[1] = 17
    return first == [7] and second == [13] and list(dicts.values(mapping)) == [17]
