record Link:
    next: Option[Link]


union Wrapped:
    empty,
    leaf: list[int],
    next: Wrapped


def inline_variant(items: list[int]) -> int:
    wrapped = Wrapped.leaf(items)
    match wrapped:
        case Wrapped.leaf(values):
            return 1
        case _:
            return 0


def recursive_variant(items: list[int]) -> int:
    wrapped = Wrapped.next(Wrapped.leaf(items))
    match wrapped:
        case Wrapped.next(inner):
            match inner:
                case Wrapped.leaf(values):
                    return len(values)
                case _:
                    return 0
        case _:
            return 0


def length(node: Link) -> int:
    tail = node.next
    if tail is None:
        return 1
    return 1 + length(tail)


def list_sum(values: list[int]) -> int:
    total = 0
    for index in range(len(values)):
        total += values[index]
    return total


public def test_recursive_reader_preserves_caller_snapshot() -> bool:
    node = Link(None)
    for index in range(128):
        node = Link(Some(node))
    before = node
    total = 0
    for index in range(8):
        total += length(node)
    node = Link(None)
    return total == 1032 and length(before) == 129 and length(node) == 1


public def test_loop_reader_leaves_collection_available_for_later_mutation() -> bool:
    values = [1, 2, 3]
    before = values
    first = list_sum(values)
    values.append(4)
    return first == 6 and list_sum(values) == 10 and list_sum(before) == 6


def main() -> int:
    assert test_recursive_reader_preserves_caller_snapshot()
    assert test_loop_reader_leaves_collection_available_for_later_mutation()
    assert test_inline_and_recursive_variant_wrappers_preserve_input()
    return 0


public def test_inline_and_recursive_variant_wrappers_preserve_input() -> bool:
    items = [1, 2, 3]
    before = items
    inline_result = inline_variant(items)
    recursive_result = recursive_variant(items)
    items.clear()
    return inline_result == 1 and recursive_result == 3 and len(before) == 3 and len(items) == 0
