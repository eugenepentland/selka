module nominal_instances


record Box[T]:
    value: T


union Slot[T]:
    none,
    some: T


result Answer[T]:
    ok: T,
    err: i64


def nominal_id[T](x: T) -> T:
    return x


def nominal_pair[T](x: T) -> [2]T:
    return [x, x]


record EmptyPhantom[T]:
    pass


record GrowPhantom[T]:
    marker: EmptyPhantom[GrowPhantom[[1]T]]


def plus(input: Answer[i64]) -> Answer[i64]:
    return Answer.ok(input? + 1)


def basic_program() -> i64:
    a = Box[i64](value=7)
    b = a
    b.value = 9
    slot: Slot[Box[i64]] = Slot.some(b)
    match slot:
        case Slot.none:
            return 0
        case Slot.some(value):
            return a.value + value.value


public def test_nominal_instances_compose_with_existing_generic_functions_and_fixed_arrays() -> bool:
    boxes = nominal_pair[Box[i64]](nominal_id[Box[i64]](Box[i64](value=6)))
    if boxes[0].value + boxes[1].value != 12:
        return False
    a: [2]Box[i64] = [Box[i64](value=3), Box[i64](value=8)]
    return a[1].value == 8


public def test_nominal_instances_keep_growing_phantom_arguments_outside_runtime_storage() -> bool:
    _ = GrowPhantom[i64](marker=EmptyPhantom[GrowPhantom[[1]i64]]())
    return True


# spec: NOMINAL-INSTANCE-1
public def test_nominal_instances_construct_assign_nest_and_exhaustively_match_on_the_vm() -> bool:
    if basic_program() != 16:
        return False
    match plus(Answer.ok(4)):
        case Answer.ok(n):
            return n == 5
        case Answer.err(_):
            return False


def main() -> int:
    return 0
