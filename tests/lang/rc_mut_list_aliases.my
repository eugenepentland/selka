# A value read out of one `mut` list parameter keeps its token while another
# `mut` parameter whose type equals, holds or is held by its type is written
# (RC-INTERVAL-ANCHOR-4). MUT-EXCLUSIVE-1 now rejects a call making the two
# overlap (`replace_first(mut a, mut a)`, `contained(mut frame, mut
# frame.rows)` are E_MUTATION_OVERLAP, tested in src/mut_exclusive_test.zig),
# so these calls pass disjoint places and the reads must survive the writes.
# Answers match the collector; RC counting builds balance.
record Span:
    source: bytes
    start: int
    end: int


record Pin:
    part: int
    net: Span
    net_id: int


record Frame:
    rows: list[list[int]]
    n: int


def span(text: bytes) -> Span:
    return Span(source=text, start=0, end=len(text))


def pin(part: int, net: bytes) -> Pin:
    return Pin(part=part, net=span(net), net_id=-1)


def churn() -> int:
    junk: list[bytes] = []
    for i in range(60):
        junk.append(b"zzzzzzzzzzzzzzzzzzzzzzzzzzzzzz" + b"yyyyyyyyyyyyyyyyyyyyyyyyyy")
    return len(junk)


def replace_first(pins: mut list[Pin], other: mut list[Pin]) -> int:
    pins.append(pin(9, b"x"))
    first = pins[0]
    other[0] = pin(1, b"qq" + b"qq")
    n = churn()
    return first.part * 1000 + len(first.net.source) * 10 + int(first.net.source[0]) + n * 0


def clear_other(pins: mut list[Pin], other: mut list[Pin]) -> int:
    pins.append(pin(9, b"x"))
    first = pins[0]
    other.clear()
    n = churn()
    return first.part * 1000 + len(first.net.source) * 10 + int(first.net.source[0]) + n * 0


def wipe(rows: mut list[list[int]]) -> int:
    rows.clear()
    junk: list[list[list[int]]] = []
    for i in range(40):
        junk.append([[i], [i, i]])
    return 0


def contained(frame: mut Frame, rows: mut list[list[int]]) -> int:
    frame.n = frame.n + 1
    first = frame.rows[0]
    k = wipe(mut rows)
    return len(first) * 10 + k


# spec-case: RC-INTERVAL-ANCHOR-4
public def test_an_element_read_survives_a_store_through_another_mut_list() -> bool:
    a = [pin(3, b"abc" + b"def"), pin(4, b"de")]
    other = a
    seen = replace_first(mut a, mut other)
    return seen == 3157 and len(a) == 3 and a[0].part == 3 and other[0].part == 1 and len(other) == 2


# spec-case: RC-INTERVAL-ANCHOR-4
public def test_an_element_read_survives_a_clear_through_another_mut_list() -> bool:
    b = [pin(3, b"abc" + b"def"), pin(4, b"de")]
    other = b
    seen = clear_other(mut b, mut other)
    return seen == 3157 and len(b) == 3 and len(other) == 0


# spec-case: RC-INTERVAL-ANCHOR-4
public def test_distinct_mut_lists_still_answer_the_same() -> bool:
    a = [pin(3, b"abc" + b"def"), pin(4, b"de")]
    c = [pin(5, b"zz")]
    seen = replace_first(mut a, mut c)
    return seen == 3157 and len(a) == 3 and c[0].part == 1


# spec-case: RC-INTERVAL-ANCHOR-4
public def test_a_record_read_survives_a_wipe_through_a_held_mut_list() -> bool:
    frame = Frame([[1, 2], [3]], 0)
    rows = frame.rows
    seen = contained(mut frame, mut rows)
    return seen == 20 and frame.rows == [[1, 2], [3]] and frame.n == 1 and len(rows) == 0


def main(out: Stream) -> int:
    out.print(test_an_element_read_survives_a_store_through_another_mut_list())
    out.print(test_an_element_read_survives_a_clear_through_another_mut_list())
    out.print(test_distinct_mut_lists_still_answer_the_same())
    out.print(test_a_record_read_survives_a_wipe_through_a_held_mut_list())
    return 0
