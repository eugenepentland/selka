public func test_scalar_element_widths_and_negative_indices_preserve_snapshots() -> bool:
    mut small: u8[] = [u8(1), u8(2), u8(3)]
    mut before = small
    small[-2] = u8(255)
    mut flags = [True, False, True]
    flags[-1] = False
    mut numbers = [1.5, 2.5]
    mut saved = numbers
    numbers[-1] = numbers[0] + 2.0
    return small == [u8(1), u8(255), u8(3)] and before == [u8(1), u8(2), u8(3)] and flags == [True, False, False] and numbers == [1.5, 3.5] and saved == [1.5, 2.5]


public func test_managed_element_replacement_retains_independent_children() -> bool:
    mut row = [1]
    mut rows = [[0], [2]]
    mut before = rows
    rows[-1] = row
    row.append(3)
    rows[-1].append(4)
    return row == [1, 3] and rows == [[0], [1, 4]] and before == [[0], [2]]


func main() -> int:
    assert test_scalar_element_widths_and_negative_indices_preserve_snapshots()
    assert test_managed_element_replacement_retains_independent_children()
    return 0
