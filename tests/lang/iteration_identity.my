module iteration_identity


# spec-case: COW-ITERATION-IDENTITY-1
public def test_nonstructural_dictionary_writes_remain_visible() -> bool:
    values = {1: 10, 2: 20}
    total = 0
    for key in values:
        values[key] = values[key] + 1
        total += values[key]
    return total == 32 and values == {1: 11, 2: 21}


# spec-case: COW-ITERATION-IDENTITY-1
public def test_list_iteration_observes_later_element_writes() -> bool:
    values = [1, 2]
    total = 0
    for value in values:
        total += value
        values[1] = 9
    return total == 10 and values == [1, 9]


# spec-case: COW-ITERATION-IDENTITY-1
public def test_rebinding_source_preserves_original_iteration_storage() -> bool:
    values = [1, 2]
    total = 0
    for value in values:
        values = [7]
        total += value
    mapping = {1: 10, 2: 20}
    for key in mapping:
        mapping = {7: 70}
        total += key
    return total == 6 and values == [7] and mapping == {7: 70}


# spec-case: COW-ITERATION-IDENTITY-1
public def test_named_snapshot_remains_independent_of_iteration_writes() -> bool:
    values = [1, 2]
    snapshot = values
    total = 0
    for value in values:
        values[1] = 9
        total += value
    return total == 10 and values == [1, 9] and snapshot == [1, 2]


# spec-case: COW-ITERATION-IDENTITY-1
public def test_fresh_managed_sources_survive_without_an_owner_local() -> bool:
    total = 0
    for value in [2, 3]:
        total += value
    for key in {4: 5, 6: 7}:
        total += key
    for value in {8, 9}:
        total += value
    for byte in b"AZ":
        total += byte
    for letter in "xy":
        total += len(letter)
    return total == 189


# spec-case: COW-ITERATION-IDENTITY-1
public def test_fixed_array_iteration_reads_the_place_and_preserves_a_copy() -> bool:
    values: [2]int = [1, 2]
    snapshot = values
    total = 0
    for value in values:
        total += value
        values[1] = 9
    return total == 10 and values[1] == 9 and snapshot == [1, 2]


record Runtime:
    objects: list[int]


record Interp:
    rt: Runtime


def bump(rt: mut Runtime, at: int) -> None:
    if at < len(rt.objects):
        rt.objects[at] = rt.objects[at] + 10


# spec: RC-ITERATION-HOLD-TRANSFER-1
public def test_write_back_through_a_field_preserves_live_iteration() -> bool:
    it = Interp(rt=Runtime(objects=[1, 2, 3]))
    seen: list[int] = []
    at = 0
    for x in it.rt.objects:
        seen.append(x)
        wb = it.rt
        bump(mut wb, at + 1)
        it.rt = wb
        at += 1
    return seen == [1, 12, 13] and it.rt.objects == [1, 12, 13]


record Source:
    items: list[int]
    n: int


def source() -> Source:
    return Source([1, 2, 3], 1)


# spec: ITERATION-FIELD-SNAPSHOT-1
public def test_last_field_transfer_preserves_live_iteration() -> bool:
    state = source()
    total = 0
    for value in state.items:
        moved = state.items
        moved.append(value)
        total += len(moved)
        state = source()
    return total == 12


def main() -> int:
    assert test_nonstructural_dictionary_writes_remain_visible()
    assert test_write_back_through_a_field_preserves_live_iteration()
    assert test_last_field_transfer_preserves_live_iteration()
    assert test_list_iteration_observes_later_element_writes()
    assert test_rebinding_source_preserves_original_iteration_storage()
    assert test_named_snapshot_remains_independent_of_iteration_writes()
    assert test_fresh_managed_sources_survive_without_an_owner_local()
    assert test_fixed_array_iteration_reads_the_place_and_preserves_a_copy()
    return 0
