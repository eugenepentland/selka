module rc_plain_projection

enum Marker:
    first,
    second


record Plain:
    marker: Marker
    number: int


record Owner:
    keep: list[int]
    plain: Plain


def produce() -> Owner:
    return Owner([1], Plain(Marker.second, 42))


# spec-case: RC-PLAIN-PROJECTION-1
public def test_plain_record_projection_survives_parent_cleanup() -> bool:
    value = produce().plain
    return value.number == 42 and value.marker == Marker.second


# spec-case: RC-PLAIN-PROJECTION-1
public def test_plain_enum_projection_survives_parent_cleanup() -> bool:
    return produce().plain.marker == Marker.second


def main() -> int:
    assert test_plain_record_projection_survives_parent_cleanup()
    assert test_plain_enum_projection_survives_parent_cleanup()
    return 0
