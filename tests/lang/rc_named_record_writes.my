record State:
    values: list[int]
    code: list[int]
    links: list[int]
    count: int


def counted(times: int) -> int:
    state = State([7], [8], [9], 0)
    i = 0
    while i < times:
        state.count = state.count + 1
        i += 1
    return state.count + state.values[0] + state.code[0] + state.links[0]


def replace(state: mut State):
    state = State([11], [12], [13], 40)


def move_result(state: mut State) -> State:
    saved = state
    state.count = state.count + 2
    return saved


def forward(state: mut State) -> State:
    return move_result(mut state)


def append_child(state: mut State):
    state.values.append(15)


def rhs(state: mut State) -> int:
    replace(mut state)
    return state.count + 3


# spec-case: RC-NAMED-RECORD-WRITE-1
public def test_named_loop_keeps_three_child_owners() -> bool:
    return counted(100) == 124


# spec-case: RC-NAMED-RECORD-WRITE-1
public def test_named_rebinding_and_forwarded_mut_return_keep_ownership() -> bool:
    state = State([7], [8], [9], 0)
    saved = forward(mut state)
    state.count = state.count + 1
    replace(mut state)
    state.count = state.count + 2
    state = State([20], [21], [22], 5)
    state.count = state.count + 4
    return saved.count == 0 and saved.values == [7] and state.count == 9 and state.code == [21]


# spec-case: RC-NAMED-RECORD-WRITE-1
public def test_record_and_list_snapshots_survive_named_scalar_write() -> bool:
    state = State([7], [8], [9], 2)
    saved = state
    children = state.values
    state.count = state.count + 5
    append_child(mut state)
    state.count = state.count + 1
    return saved.count == 2 and saved.values == [7] and children == [7] and state.count == 8 and state.values == [7, 15]


# spec-case: RC-NAMED-RECORD-WRITE-1
public def test_complete_rhs_rebinding_precedes_named_scalar_commit() -> bool:
    state = State([7], [8], [9], 2)
    saved = state
    next_count = rhs(mut state)
    state.count = next_count
    return state.count == 43 and state.values == [11] and state.links == [13] and saved.count == 2 and saved.code == [8]


# spec-case: RC-NAMED-RECORD-WRITE-1
public def test_named_home_in_caller_arena_preserves_heap_children() -> bool:
    children = [31]
    answer = False
    with arena():
        state = State(children, [32], [33], 4)
        saved = state
        state.count = state.count + 2
        append_child(mut state)
        state.count = state.count + 3
        answer = saved.count == 4 and saved.values == [31] and state.values == [31, 15] and state.count == 9
    return answer and children == [31]


# spec-case: RC-NAMED-RECORD-WRITE-1
public def test_named_loop_in_caller_arena_balances_children() -> bool:
    with arena():
        return counted(17) == 41


# spec-case: RC-NAMED-RECORD-WRITE-1
public def test_inner_arena_cleanup_requires_new_named_definition() -> bool:
    with arena():
        state = State([7], [8], [9], 0)
        state.count = state.count + 1
    state = State([17], [18], [19], 4)
    state.count = state.count + 2
    return state.count == 6 and state.values == [17]


# spec-case: RC-NAMED-RECORD-WRITE-1
public def test_published_record_snapshot_keeps_original_scalar_bits() -> bool:
    state = State([7], [8], [9], 0)
    published = [state]
    next_count = rhs(mut state)
    state.count = next_count
    state.count = state.count + 1
    return published[0].count == 0 and published[0].values == [7] and state.count == 44 and state.values == [11]


def main(out: Stream) -> int:
    out.print(test_named_loop_keeps_three_child_owners())
    out.print(test_named_rebinding_and_forwarded_mut_return_keep_ownership())
    out.print(test_record_and_list_snapshots_survive_named_scalar_write())
    out.print(test_complete_rhs_rebinding_precedes_named_scalar_commit())
    out.print(test_named_home_in_caller_arena_preserves_heap_children())
    out.print(test_named_loop_in_caller_arena_balances_children())
    out.print(test_inner_arena_cleanup_requires_new_named_definition())
    out.print(test_published_record_snapshot_keeps_original_scalar_bits())
    return 0
