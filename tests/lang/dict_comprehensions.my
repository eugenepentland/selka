
# Dict comprehensions and the comprehensions that lower through their own
# loops: two iteration names, several `for` clauses and several filters. Every
# expected value below is the answer CPython 3 gives for the same program.


# spec: PY-GATHER-1
public func test_a_dict_comprehension_over_a_range() -> bool:
    mut squares = {x: x * x for x in range(4)}
    return len(squares) == 4 and squares[3] == 9 and squares[0] == 0


# spec-case: PY-GATHER-1
public func test_a_dict_comprehension_over_items_keys_and_values() -> bool:
    mut prices = {"pear": 3, "fig": 5, "kiwi": 2}
    mut doubled = {name: price * 2 for name, price in prices.items()}
    mut cheap = {name: price for name, price in prices.items() if price < 4}
    mut lengths = {name: len(name) for name in prices.keys()}
    mut flags = {price: price > 2 for price in prices.values()}
    return doubled["fig"] == 10 and len(cheap) == 2 and "fig" not in cheap and lengths["kiwi"] == 4 and flags[5] and not flags[2]


# spec-case: PY-GATHER-1
public func test_a_dict_comprehension_over_a_list_a_string_and_zip() -> bool:
    mut words = ["a", "bb", "ccc"]
    mut by_length = {len(w): w for w in words}
    mut positions = {c: i for i, c in enumerate("abc")}
    mut paired = {k: v for k, v in zip(["x", "y"], [1, 2])}
    return by_length[2] == "bb" and positions["c"] == 2 and paired["y"] == 2


# spec-case: PY-GATHER-1
public func test_a_repeated_key_keeps_its_first_position_and_last_value() -> bool:
    mut last = {w[0]: w for w in ["apple", "avocado", "banana"]}
    mut order: str[] = []
    for key in last:
        order.append(key)
    return last["a"] == "avocado" and order == ["a", "b"]


# spec-case: PY-GATHER-1
public func test_an_annotated_dict_comprehension_takes_its_value_type() -> bool:
    mut small: dict[str, u8] = {name: 0 for name in ["a", "b"]}
    small["a"] = 200
    return int(small["a"]) + int(small["b"]) == 200


# spec-case: PY-GATHER-1
public func test_explicit_nested_loops_read_left_to_right() -> bool:
    mut grid = [[1, 2], [3, 4]]
    mut flat: int[] = []
    for row in grid:
        for x in row:
            flat.append(x)
    mut pairs: int[] = []
    for x in range(3):
        for y in range(x):
            pairs.append(x * 10 + y)
    return flat == [1, 2, 3, 4] and pairs == [10, 20, 21]


# spec-case: PY-GATHER-1
public func test_destructuring_loops_and_combined_comprehension_filter() -> bool:
    mut prices = {"pear": 3, "fig": 5, "kiwi": 2}
    mut names: str[] = []
    for name, price in prices.items():
        if price > 2:
            names.append(name)
    mut odd_small = [for x in range(20) if (x % 2 == 1) and (x < 7) yield x]
    mut indexed: int[] = []
    for i, v in enumerate([5, 6, 7]):
        indexed.append(i * v)
    return names == ["pear", "fig"] and odd_small == [1, 3, 5] and indexed == [0, 6, 14]


# spec-case: PY-GATHER-1
public func test_a_stepped_range_and_reversed_are_comprehension_sources() -> bool:
    mut down = {x for x in range(10, 0, -3)}
    mut back = [for c in reversed([1, 2, 3]) yield c]
    return down == {10, 7, 4, 1} and back == [3, 2, 1]


# spec-case: PY-GATHER-1
public func test_a_filter_narrows_the_option_it_tests() -> bool:
    mut values: int?[] = [Some(1), None, Some(5)]
    mut present = [for v in values if v is not None yield v + 1]
    return present == [2, 6]


func histogram(words: str[]) -> dict[str, int]:
    return {w: len([for v in words if v == w yield v]) for w in words}


# spec-case: PY-GATHER-1
public func test_a_comprehension_nested_in_a_dict_comprehension() -> bool:
    mut counts = histogram(["a", "b", "a"])
    return counts["a"] == 2 and counts["b"] == 1 and len(counts) == 2
