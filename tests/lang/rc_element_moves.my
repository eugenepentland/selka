# A field read out of a dead record local moves its owner under RC
# (RC-DEAD-FIELD-MOVE-1), and a same-slot return arm moves its element's
# payload into the binding (RC-ELEMENT-TAKE-1), so the extracted collection is
# changed in place instead of cloned. Every test here also runs under GC and
# `--gc-stress`; the near misses must keep plain value semantics.
record Box:
    tag: int
    items: int[]


enum Slot:
    empty
    full(value: Box)


record Table:
    entries: int[]
    count: int


record Instance:
    klass: int
    fields: Table


enum Obj:
    free
    instance(value: Instance)


func fresh(n: int) -> Box:
    return Box(tag=n, items=[0, 0, 0])


func put(mut t: Table, value: int):
    t.entries.append(value)
    t.count += 1


func returned(mut objects: Obj[], ref: int, value: int):
    match objects[ref].copy():
        case Obj.instance(value=instance):
            mut klass = instance.klass
            mut fields = instance.fields.copy()
            put(mut fields, value)
            objects[ref] = Obj.instance(value=Instance(klass=klass, fields=fields))
        case _:
            assert False, "not an instance"


func observed(mut objects: Obj[], ref: int, value: int):
    match objects[ref].copy():
        case Obj.instance(value=instance):
            mut klass = instance.klass
            mut fields = instance.fields.copy()
            put(mut fields, value + len(objects))
            objects[ref] = Obj.instance(value=Instance(klass=klass, fields=fields))
        case _:
            assert False, "not an instance"


func elsewhere(mut objects: Obj[], ref: int, value: int):
    match objects[ref].copy():
        case Obj.instance(value=instance):
            mut klass = instance.klass
            mut fields = instance.fields.copy()
            put(mut fields, value)
            objects[0] = Obj.instance(value=Instance(klass=klass, fields=fields))
        case _:
            assert False, "not an instance"


func early(mut objects: Obj[], ref: int, value: int):
    match objects[ref].copy():
        case Obj.instance(value=instance):
            mut klass = instance.klass
            mut fields = instance.fields.copy()
            put(mut fields, value)
            if value < 0:
                return
            objects[ref] = Obj.instance(value=Instance(klass=klass, fields=fields))
        case _:
            assert False, "not an instance"


func make_instance(klass: int, entries: int[]) -> Obj:
    return Obj.instance(value=Instance(klass=klass, fields=Table(entries=entries.copy(), count=len(entries))))


func entries_of(obj: Obj) -> int[]:
    match obj:
        case Obj.instance(value=found):
            return found.fields.entries.copy()
        case _:
            return []


func klass_of(obj: Obj) -> int:
    match obj:
        case Obj.instance(value=found):
            return found.klass
        case _:
            return -1


public func test_field_moved_out_of_a_dead_local_changes_in_place() -> bool:
    mut box = fresh(4)
    mut items = box.items.copy()
    items[0] = 7
    items.append(8)
    return items == [7, 0, 0, 8]


public func test_snapshot_taken_before_the_move_keeps_its_values() -> bool:
    mut box = fresh(4)
    mut saved = box.items.copy()
    mut items = box.items.copy()
    items[0] = 9
    return saved == [0, 0, 0] and items == [9, 0, 0]


public func test_match_binding_field_move() -> bool:
    mut slot = Slot.full(value=fresh(3))
    mut total = 0
    match slot:
        case Slot.full(value=box):
            mut tag = box.tag
            mut items = box.items.copy()
            items[1] = 5
            total = items[1] + tag
        case _:
            total = -1
    mut after = 0
    match slot:
        case Slot.full(value=again):
            after = again.items[1]
        case _:
            after = -1
    return total == 8 and after == 0


public func test_source_read_after_the_extraction_keeps_its_field() -> bool:
    mut box = fresh(2)
    mut items = box.items.copy()
    items[0] = 6
    return box.items == [0, 0, 0] and items == [6, 0, 0]


public func test_source_reused_in_a_loop_keeps_its_field() -> bool:
    mut box = fresh(2)
    mut total = 0
    mut i = 0
    while i < 3:
        mut items = box.items.copy()
        items[0] = i + 1
        total += items[0] + box.items[0]
        i += 1
    return total == 6 and box.items == [0, 0, 0]


func rename(mut box: Box, tag: int):
    box.tag = tag


public func test_source_passed_mut_keeps_its_field() -> bool:
    mut box = fresh(2)
    rename(mut box, 5)
    mut items = box.items.copy()
    items[2] = 1
    return box.tag == 5 and items == [0, 0, 1]


public func test_same_slot_return_updates_the_element() -> bool:
    mut objects = [make_instance(1, []), make_instance(2, [5])]
    mut i = 0
    while i < 20:
        returned(mut objects, i % 2, i)
        i += 1
    mut first = entries_of(objects[0])
    mut second = entries_of(objects[1])
    return len(first) == 10 and first[9] == 18 and len(second) == 11 and second[0] == 5 and second[10] == 19 and klass_of(objects[1]) == 2


public func test_list_snapshot_before_the_return_keeps_the_old_payload() -> bool:
    mut objects = [make_instance(1, [1, 2])]
    mut before = objects.copy()
    returned(mut objects, 0, 3)
    return entries_of(before[0]) == [1, 2] and entries_of(objects[0]) == [1, 2, 3]


public func test_element_snapshot_before_the_return_keeps_the_old_payload() -> bool:
    mut objects = [make_instance(1, [1])]
    mut held = objects[0].copy()
    returned(mut objects, 0, 4)
    return entries_of(held) == [1] and entries_of(objects[0]) == [1, 4]


public func test_elements_sharing_one_table_stay_independent() -> bool:
    mut shared = Table(entries=[7], count=1)
    mut objects = [Obj.instance(value=Instance(klass=1, fields=shared.copy())), Obj.instance(value=Instance(klass=2, fields=shared.copy()))]
    returned(mut objects, 0, 8)
    return entries_of(objects[0]) == [7, 8] and entries_of(objects[1]) == [7] and shared.entries == [7]


public func test_negative_index_returns_to_the_same_element() -> bool:
    mut objects = [make_instance(1, []), make_instance(2, [])]
    returned(mut objects, -1, 6)
    returned(mut objects, -2, 5)
    return entries_of(objects[0]) == [5] and entries_of(objects[1]) == [6]


public func test_near_miss_arms_keep_value_semantics() -> bool:
    mut objects = [make_instance(1, [1]), make_instance(2, [2])]
    observed(mut objects, 1, 10)
    elsewhere(mut objects, 1, 3)
    early(mut objects, 0, -1)
    early(mut objects, 1, 4)
    return entries_of(objects[0]) == [2, 12, 3] and entries_of(objects[1]) == [2, 12, 4] and klass_of(objects[0]) == 2


record Holder:
    items: int[]
    count: int


func fill(mut h: Holder):
    mut items = [1, 2]
    items.append(3)
    h.items = items


public func test_field_store_of_a_dead_local_hands_the_value_over() -> bool:
    mut h = Holder(items=[], count=0)
    fill(mut h)
    h.items.append(4)
    return h.items == [1, 2, 3, 4]


public func test_field_store_then_a_local_read_keeps_a_copy() -> bool:
    mut h = Holder(items=[], count=0)
    mut items = [1]
    h.items = items.copy()
    items.append(2)
    return h.items == [1] and items == [1, 2]


public func test_field_store_in_a_loop_copies_each_time() -> bool:
    mut h = Holder(items=[], count=0)
    mut items = [0]
    for i in range(3):
        h.items = items.copy()
        items.append(i)
    return h.items == [0, 0, 1] and items == [0, 0, 1, 2]
