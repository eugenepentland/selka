public def test_int_divisor_0() -> bool:
    values: list[int] = [-9223372036854775808,-9223372036854775807,-1009,-8,-7,-3,-1,0,1,3,7,8,1009,9223372036854775806,9223372036854775807,6303364596307999031,453492803315921835,-8284879517704149140,-441333347376654569,5397175205333235443,-6570681700228916481,-8562806718135417965,4548035843018504995,-887588675772457145,6717981789188005535,5890651768319296771,-759111510947337642,9097055494531418407,-5570603173743356936,-1398484579662931654,-5059399092923407757,2738784208489324137,5476475365963889839,8050932207761778995,-6052990335762768093,-3219702197544917483,-5071219912657833942,-1537329542113523636,4465703778794106964,-166903533469626666,-8919864082952928603,635500006281974832,3462684256397089407,-1984577588115460870,2982319582842853662,4936144921973006430,-3261461880182769508]
    divisors: list[int] = [1,2,3,7,8,1009,-1,-2,-3,-7,-8,-1009,-9223372036854775808]
    for x in values:
        if fixed_int_0_floor(x) != dynamic_int_floor(x, divisors[0]):
            return False
        if fixed_int_0_rem(x) != dynamic_int_rem(x, divisors[0]):
            return False
        if fixed_int_0_trunc(x) != dynamic_int_trunc(x, divisors[0]):
            return False
        if fixed_int_0_trem(x) != dynamic_int_trem(x, divisors[0]):
            return False
    return True

