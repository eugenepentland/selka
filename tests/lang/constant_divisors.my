module constant_divisors

# Fixed seed 20261003 samples supplement signed/unsigned extrema and divisor boundaries.

def dynamic_int_floor(x: int, d: int) -> int:
    return x // d

def dynamic_int_rem(x: int, d: int) -> int:
    return x % d

def dynamic_int_trunc(x: int, d: int) -> int:
    return divtrunc(x, d)

def dynamic_int_trem(x: int, d: int) -> int:
    return remtrunc(x, d)

def fixed_int_0_floor(x: int) -> int:
    return x // 1

def fixed_int_0_rem(x: int) -> int:
    return x % 1

def fixed_int_0_trunc(x: int) -> int:
    return divtrunc(x, 1)

def fixed_int_0_trem(x: int) -> int:
    return remtrunc(x, 1)

