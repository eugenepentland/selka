# Dict comprehensions and the comprehensions that lower through their own
# loops: two iteration names, several `for` clauses and several filters. Every
# expected value below is the answer CPython 3 gives for the same program.
# spec: PY-GATHER-1
import dicts
import sets
import strings

public func test_a_dict_comprehension_over_a_range() -> bool:
    mut gather_result: dict[int, int] = {}
    for x in range(0, 4):
        const gather_key: int = x
        const gather_value: int = x * x
        gather_result[gather_key] = gather_value
    mut squares = own gather_result
    return len(squares) == 4 and squares[3] == 9 and squares[0] == 0


# spec-case: PY-GATHER-1
public func test_a_dict_comprehension_over_items_keys_and_values() -> bool:
    mut prices = {"pear": 3, "fig": 5, "kiwi": 2}
    mut gather_result: dict[str, int] = {}
    for name, price in dicts.items(prices):
        const gather_key: str = copy(name)
        const gather_value: int = price * 2
        gather_result[own gather_key] = gather_value
    mut doubled = own gather_result
    mut gather_result_next: dict[str, int] = {}
    for name, price in dicts.items(prices):
        if price < 4:
            const gather_key_next: str = copy(name)
            const gather_value_next: int = price
            gather_result_next[own gather_key_next] = gather_value_next
    mut cheap = own gather_result_next
    mut gather_result_next_next: dict[str, int] = {}
    for name in dicts.keys(prices):
        const gather_key_next_next: str = copy(name)
        const gather_value_next_next: int = strings.char_count(name)
        gather_result_next_next[own gather_key_next_next] = gather_value_next_next
    mut lengths = own gather_result_next_next
    mut gather_result_next_next_next: dict[int, bool] = {}
    for price in dicts.values(prices):
        const gather_key_next_next_next: int = price
        const gather_value_next_next_next: bool = price > 2
        gather_result_next_next_next[gather_key_next_next_next] = gather_value_next_next_next
    mut flags = own gather_result_next_next_next
    return doubled["fig"] == 10 and len(cheap) == 2 and "fig" not in cheap and lengths["kiwi"] == 4 and flags[5] and not flags[2]


# spec-case: PY-GATHER-1
public func test_a_dict_comprehension_over_a_list_a_string_and_zip() -> bool:
    mut words = ["a", "bb", "ccc"]
    mut gather_result: dict[int, str] = {}
    for w in words:
        const gather_key: int = strings.char_count(w)
        const gather_value: str = copy(w)
        gather_result[gather_key] = own gather_value
    mut by_length = own gather_result
    mut gather_result_next: dict[str, int] = {}
    for i, c in enumerate(strings.chars("abc")):
        const gather_key_next: str = copy(c)
        const gather_value_next: int = i
        gather_result_next[own gather_key_next] = gather_value_next
    mut positions = own gather_result_next
    mut gather_result_next_next: dict[str, int] = {}
    for k, v in zip(["x", "y"], [1, 2]):
        const gather_key_next_next: str = copy(k)
        const gather_value_next_next: int = v
        gather_result_next_next[own gather_key_next_next] = gather_value_next_next
    mut paired = own gather_result_next_next
    return by_length[2] == "bb" and positions["c"] == 2 and paired["y"] == 2


# spec-case: PY-GATHER-1
public func test_a_repeated_key_keeps_its_first_position_and_last_value() -> bool:
    mut gather_result: dict[str, str] = {}
    for w in ["apple", "avocado", "banana"]:
        const gather_key: str = strings.char_at(w, 0)
        const gather_value: str = copy(w)
        gather_result[own gather_key] = own gather_value
    mut last = own gather_result
    mut order: str[] = []
    for key in last:
        append(mut order, copy(key))
    return last["a"] == "avocado" and order == ["a", "b"]


# spec-case: PY-GATHER-1
public func test_an_annotated_dict_comprehension_takes_its_value_type() -> bool:
    mut gather_result: dict[str, u8] = {}
    for name in ["a", "b"]:
        const gather_key: str = copy(name)
        const gather_value: u8 = 0
        gather_result[own gather_key] = gather_value
    mut small: dict[str, u8] = own gather_result
    small["a"] = 200
    return int(small["a"]) + int(small["b"]) == 200


# spec-case: PY-GATHER-1
public func test_explicit_nested_loops_read_left_to_right() -> bool:
    mut grid = [[1, 2], [3, 4]]
    mut flat: int[] = []
    for row in grid:
        for x in row:
            append(mut flat, x)
    mut pairs: int[] = []
    for x in range(3):
        for y in range(x):
            append(mut pairs, x * 10 + y)
    return flat == [1, 2, 3, 4] and pairs == [10, 20, 21]


# spec-case: PY-GATHER-1
public func test_destructuring_loops_and_combined_comprehension_filter() -> bool:
    mut prices = {"pear": 3, "fig": 5, "kiwi": 2}
    mut names: str[] = []
    for name, price in dicts.items(prices):
        if price > 2:
            append(mut names, copy(name))
    mut odd_small: int[] = []
    for x in range(0, 20):
        if (x % 2 == 1) and (x < 7):
            append(mut odd_small, x)
    mut indexed: int[] = []
    for i, v in enumerate([5, 6, 7]):
        append(mut indexed, i * v)
    return names == ["pear", "fig"] and odd_small == [1, 3, 5] and indexed == [0, 6, 14]


# spec-case: PY-GATHER-1
public func test_a_stepped_range_and_reversed_are_comprehension_sources() -> bool:
    mut gather_result: set[int] = set()
    for x in range(10, 0, -3):
        const gather_value: int = x
        sets.add(mut gather_result, gather_value)
    mut down = own gather_result
    mut back: int[] = []
    for c in reversed([1, 2, 3]):
        append(mut back, c)
    return down == {10, 7, 4, 1} and back == [3, 2, 1]


# spec-case: PY-GATHER-1
public func test_a_filter_narrows_the_option_it_tests() -> bool:
    mut values: int?[] = [Some(1), None, Some(5)]
    mut present: int[] = []
    for v in values:
        if v is not None:
            append(mut present, v + 1)
    return present == [2, 6]


func histogram(words: str[]) -> dict[str, int]:
    mut gather_result: dict[str, int] = {}
    for w in words:
        const gather_key: str = copy(w)
        mut gather_result_next: str[] = []
        for v in words:
            if v == w:
                const gather_value_next: str = copy(v)
                append(mut gather_result_next, own gather_value_next)
        const gather_value: int = len(gather_result_next)
        gather_result[own gather_key] = gather_value
    return gather_result


# spec-case: PY-GATHER-1
public func test_a_comprehension_nested_in_a_dict_comprehension() -> bool:
    mut counts = histogram(["a", "b", "a"])
    return counts["a"] == 2 and counts["b"] == 1 and len(counts) == 2
