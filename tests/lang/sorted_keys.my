module sorted_keys

import sort

# `sorted(xs, key=...)` shares its key type with every other callback value of
# `def(T) -> int effects()` in the program (SPEC.md PRELUDE-SORT-KEY-2). The two
# repros in experiments/perf-parity-plan-20260922/suite/repro/ passed `check`
# and then failed lowering with an internal error; every spelling below lives in
# one program on purpose, because the second failure needed a second callback
# value of the key's type anywhere in the program.


record Entry:
    rank: int
    id: int


def by_value(v: int) -> int effects():
    return v


def neg(v: int) -> int effects():
    return 0 - v


def twice(v: int) -> int effects():
    return v * 2


def by_length(s: str) -> int effects():
    return len(s)


def by_rank(e: Entry) -> int effects():
    return e.rank


def apply_key(key: def(int) -> int effects(), v: int) -> int:
    return key(v)


# spec: PRELUDE-SORT-KEY-2
public def test_identity_key_function_orders_by_the_values_themselves() -> bool:
    ordered = sorted([3, 1, 2], key=by_value)
    return ordered == [1, 2, 3]


# spec-case: PRELUDE-SORT-KEY-2
public def test_identity_lambda_key_orders_by_the_values_themselves() -> bool:
    ordered = sorted([3, 1, 2], key=lambda v: v)
    return ordered == [1, 2, 3]


# spec-case: PRELUDE-SORT-KEY-2
public def test_key_stored_in_a_local_first_is_the_same_callback_type() -> bool:
    key = by_value
    other = neg
    ascending = sorted([3, 1, 2], key=key)
    descending = sorted([3, 1, 2], key=other)
    return ascending == [1, 2, 3] and descending == [3, 2, 1]


# spec-case: PRELUDE-SORT-KEY-2
public def test_one_key_function_serves_several_sorted_calls() -> bool:
    first = sorted([5, 4, 6], key=neg)
    second = sorted([1, 3, 2], key=neg)
    return first == [6, 5, 4] and second == [3, 2, 1]


# spec-case: PRELUDE-SORT-KEY-2
public def test_a_stored_callback_of_the_key_type_coexists_with_a_sorted_key() -> bool:
    f = twice
    doubled = f(3)
    ordered = sorted([3, 1, 2], key=neg)
    return doubled == 6 and ordered == [3, 2, 1]


# spec-case: PRELUDE-SORT-KEY-2
public def test_key_functions_also_pass_to_ordinary_callback_parameters() -> bool:
    ordered = sorted([2, 9, 4], key=by_value)
    return apply_key(by_value, 7) == 7 and apply_key(twice, 7) == 14 and ordered == [2, 4, 9]


# spec-case: PRELUDE-SORT-KEY-2
public def test_sort_by_key_and_sorted_share_one_key_type() -> bool:
    values = [3, 1, 2]
    by_library = sort.sort_by_key(values, neg)
    by_builtin = sorted(values, key=neg)
    identity = sort.sort_by_key(values, by_value)
    return by_library == [3, 2, 1] and by_builtin == by_library and identity == [1, 2, 3] and values == [3, 1, 2]


# spec-case: PRELUDE-SORT-KEY-2
public def test_record_and_text_keys_mix_named_and_lambda_spellings() -> bool:
    entries = [Entry(rank=2, id=1), Entry(rank=1, id=2), Entry(rank=2, id=3)]
    named = sorted(entries, key=by_rank)
    lambda_keyed = sorted(entries, key=lambda e: e.rank)
    library = sort.sort_by_key(entries, by_rank)
    words = sorted(["ccc", "a", "bb"], key=by_length)
    return named[0].id == 2 and named[1].id == 1 and named[2].id == 3 and lambda_keyed == named and library == named and words == ["a", "bb", "ccc"]


def main() -> int:
    return 0
