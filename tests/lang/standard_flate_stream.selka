    return gives(GZIP, fixtures.pattern_gz(), repeated(fixtures.pattern(), 1024), [WHOLE], "a mebibyte of text")


public func test_a_stored_member_of_a_mebibyte_inflates_in_pieces_of_4096_bytes() -> bool:
    const plain = repeated(fixtures.pattern(), 1024)
    return gives(GZIP, stored_member(plain, 1060151433), plain, [4096], "a stored mebibyte")


