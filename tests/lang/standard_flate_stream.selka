    const plain = repeated(fixtures.pattern(), 1024)
    return gives(GZIP, stored_member(plain, 1060151433), plain, [WHOLE], "a stored mebibyte")


# The sizes of the chunks a gzip stream gives when all of `data` is fed at once and then the stream is fed nothing until it
# gives nothing more.
func chunk_sizes(data: bytes) -> int[] fails str:
    mut stream = flate.gzip_inflater(NO_LIMIT)
    mut sizes: int[] = []
    mut plain = try flate.feed(mut stream, data)
    while len(plain) > 0:
        append(mut sizes, len(plain))
        plain = try flate.feed(mut stream, b"")
    try flate.finish(stream)
    return sizes


func chunks_or_none(data: bytes) -> int[]:
    const sizes = chunk_sizes(data) else Err(_):
        return []
    return sizes


# A call returns about a mebibyte at most, and the rest of the piece comes with the empty feeds that follow.
public func test_a_call_returns_at_most_a_mebibyte_and_the_empty_feeds_return_the_rest() -> bool:
    const plain = repeated(fixtures.pattern(), 1536)
    const sizes = chunks_or_none(stored_member(plain, 9079911))
    assert len(sizes) == 2, f"{len(sizes)} chunks"
    assert sizes[0] + sizes[1] == len(plain), f"{sizes[0]} and {sizes[1]} bytes"
    assert sizes[0] <= CHUNK_LIMIT, f"a chunk of {sizes[0]} bytes"
    assert sizes[1] <= CHUNK_LIMIT, f"a chunk of {sizes[1]} bytes"
    return True


public func test_the_limit_stops_a_stream_past_it() -> bool:
    const plain = fixtures.base()
    assert outcome(GZIP, fixtures.gz_dynamic(), 7, len(plain)).message == ""
    assert outcome(GZIP, fixtures.gz_dynamic(), 7, len(plain) - 1).message == SIZE_LIMIT
    assert outcome(GZIP, fixtures.gz_stored(), 4096, len(plain) - 1).message == SIZE_LIMIT
    assert outcome(GZIP, fixtures.zeros_gz(), 65536, 100000).message == SIZE_LIMIT
    return True


# `member` cut at each byte from `first` up to `last` is a stream that has not ended, and `finish` says where it stopped.
func cuts_report_where_they_stopped(member: bytes, first: int, last: int) -> bool:
    for cut in range(first, last):
        const result = outcome(GZIP, member[0:cut], WHOLE, NO_LIMIT)
        if cut < 10:
            assert result.message == "the gzip header is cut short", f"cut at {cut}: {result.message}"
        elif cut < len(member) - 8:
            assert result.message == TRUNCATED, f"cut at {cut}: {result.message}"
        else:
            assert result.message == "the gzip member is cut short", f"cut at {cut}: {result.message}"
    return True


# A gzip member cut at any byte but 0 is a stream that has not ended.
public func test_a_gzip_member_cut_in_its_first_half_reports_where_it_stopped() -> bool:
    const member = fixtures.gz_short_stored()
    return cuts_report_where_they_stopped(member, 1, len(member) // 2)


public func test_a_gzip_member_cut_in_its_second_half_reports_where_it_stopped() -> bool:
    const member = fixtures.gz_short_stored()
    return cuts_report_where_they_stopped(member, len(member) // 2, len(member))


public func test_a_gzip_member_with_a_fixed_block_cut_in_many_places_is_refused() -> bool:
    const member = fixtures.gz_short_fixed()
    mut cut = 3
    while cut < len(member):
        const result = outcome(GZIP, member[0:cut], 5, NO_LIMIT)
        assert result.message != "", f"cut at {cut} was taken"
        cut += 9
    return True


public func test_zlib_and_raw_streams_cut_short_are_refused() -> bool:
    const packed = fixtures.zlib_short_fixed()
    assert outcome(ZLIB, packed[0:1], 1, NO_LIMIT).message == "the zlib stream is too short"
    assert outcome(ZLIB, packed[0:30], 7, NO_LIMIT).message == TRUNCATED
    assert outcome(ZLIB, packed[0:len(packed) - 2], 7, NO_LIMIT).message == "the zlib stream has the wrong length"
    const raw = fixtures.raw_short_fixed()
    assert outcome(RAW, raw[0:1], 1, NO_LIMIT).message == TRUNCATED
    assert outcome(RAW, raw[0:len(raw) - 1], 7, NO_LIMIT).message == TRUNCATED
    return True


public func test_a_wrong_gzip_checksum_is_reported_in_any_pieces() -> bool:
    const message = "the gzip checksum does not match"
    assert stops(GZIP, with_flipped(fixtures.gz_short_stored(), 5), message, [1, 7, WHOLE], "a short stored member")
    assert stops(GZIP, with_flipped(fixtures.gz_short_fixed(), 6), message, [1, 7, WHOLE], "a short fixed member")
    assert stops(GZIP, with_flipped(fixtures.gz_dynamic(), 8), message, [7, WHOLE], "a dynamic member")
    return True


public func test_a_wrong_gzip_length_is_reported_in_any_pieces() -> bool:
    const message = "the gzip size does not match"
    assert stops(GZIP, with_flipped(fixtures.gz_short_stored(), 1), message, [1, 7, WHOLE], "a short stored member")
    assert stops(GZIP, with_flipped(fixtures.gz_short_fixed(), 2), message, [1, 7, WHOLE], "a short fixed member")
    assert stops(GZIP, with_flipped(fixtures.gz_dynamic(), 4), message, [7, WHOLE], "a dynamic member")
    return True


public func test_a_wrong_zlib_checksum_is_reported_in_any_pieces() -> bool:
    const message = "the zlib checksum does not match"
    assert stops(ZLIB, with_flipped(fixtures.zlib_short_fixed(), 1), message, [1, 7, WHOLE], "a short fixed stream")
    assert stops(ZLIB, with_flipped(fixtures.zlib_dynamic(), 3), message, [7, WHOLE], "a dynamic stream")
    return True


public func test_data_after_a_gzip_member_is_reported_in_any_pieces() -> bool:
    const member = fixtures.gz_short_fixed()
    assert stops(GZIP, member + b"xyz", MAGIC, [1, 7, WHOLE], "three bytes after a member")
    assert stops(GZIP, member + b"\x00\x00xyz", MAGIC, [1, 7, WHOLE], "zero bytes and then three bytes after a member")
    assert stops(GZIP, member + member[0:5], "the gzip header is cut short", [1, 7, WHOLE], "a second member cut short")
    assert stops(GZIP, member + b"\x1f\x8b\x07", "the gzip member does not use the deflate method", [1, 7, WHOLE], "a second member of another method")
    return True


public func test_data_after_a_zlib_or_raw_stream_is_reported_in_any_pieces() -> bool:
    assert stops(ZLIB, fixtures.zlib_short_fixed() + b"x", "the zlib stream has the wrong length", [1, 7, WHOLE], "a byte after a zlib stream")
    assert stops(RAW, fixtures.raw_short_fixed() + b"x", "there is data after the end of the DEFLATE stream", [1, 7, WHOLE], "a byte after a raw stream")
    return True


# The message `feed` fails with, or "" when it does not.
func feed_message(mut stream: flate.Inflater, piece: bytes) -> str:
    const plain = flate.feed(mut stream, piece) else Err(message):
        return message
    return ""


# The message `finish` fails with, or "" when it does not.
func finish_message(stream: flate.Inflater) -> str:
    _ = flate.finish(stream) else Err(message):
        return message
    return ""


public func test_a_stream_that_failed_fails_again_with_the_same_message() -> bool:
    mut stream = flate.gzip_inflater(NO_LIMIT)
    assert feed_message(mut stream, b"not gzip at all, not gzip at all") == MAGIC
    assert feed_message(mut stream, b"") == MAGIC
    assert finish_message(stream) == MAGIC
    assert not flate.ended(stream)
    return True


public func test_a_damaged_stream_is_reported_whatever_the_pieces() -> bool:
    const member = fixtures.gz_short_fixed()
    mut position = 10
    while position < len(member):
        const damaged = with_byte(member, position, bit_xor(int(member[position]), 255))
        assert outcome(GZIP, damaged, 7, NO_LIMIT).message != "", f"byte {position} flipped was taken in pieces of 7"
        assert outcome(GZIP, damaged, WHOLE, NO_LIMIT).message != "", f"byte {position} flipped was taken whole"
        position += 9
    return True


public func test_crc_32_in_running_form_matches_the_whole_over_every_cut_of_a_kibibyte() -> bool:
    const text = copy(fixtures.base()[0:1024])
    const whole = flate.crc32(text)
    for cut in range(1025):
        assert flate.crc32_update(flate.crc32(text[0:cut]), text[cut:]) == whole, f"cut at {cut}"
    assert flate.crc32_update(0, b"") == 0
    assert flate.crc32_update(flate.crc32(b"abc"), b"") == flate.crc32(b"abc")
    assert flate.crc32(fixtures.base()) == 2283901643
    return True


public func test_adler_32_in_running_form_matches_the_whole_over_every_cut_of_a_kibibyte() -> bool:
    const text = copy(fixtures.base()[0:1024])
    const whole = flate.adler32(text)
    for cut in range(1025):
        assert flate.adler32_update(flate.adler32(text[0:cut]), text[cut:]) == whole, f"cut at {cut}"
    assert flate.adler32_update(1, b"") == 1
    assert flate.adler32(fixtures.base()) == 3010012228
    return True


public func test_the_running_checksums_fold_one_byte_at_a_time() -> bool:
    const text = fixtures.base()
    mut crc = 0
    mut adler = 1
    for at in range(len(text)):
        crc = flate.crc32_update(crc, text[at:at + 1])
        adler = flate.adler32_update(adler, text[at:at + 1])
    assert crc == 2283901643
    assert adler == 3010012228
    return True


public func test_the_running_checksums_agree_with_zlib_on_a_mebibyte_of_zeros() -> bool:
    const zeros = repeated(b"\x00", MEBIBYTE)
    assert flate.crc32(zeros) == 2805525020
    assert flate.crc32_update(flate.crc32(zeros[0:524288]), zeros[524288:]) == 2805525020
    return True
