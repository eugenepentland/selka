    return gives(GZIP, fixtures.zeros_gz(), repeated(b"\x00", MEBIBYTE), [65536], "a mebibyte of zeros")


public func test_a_mebibyte_of_zeros_inflates_whole() -> bool:
    return gives(GZIP, fixtures.zeros_gz(), repeated(b"\x00", MEBIBYTE), [WHOLE], "a mebibyte of zeros")


