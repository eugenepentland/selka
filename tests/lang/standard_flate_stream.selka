import buffers
import flate
import flate_stream_fixtures as fixtures

# `flate.feed` takes compressed bytes a piece at a time and returns the plain bytes each piece yields; `flate.finish` and
# `flate.ended` say whether the stream ended cleanly; `flate.crc32_update` and `flate.adler32_update` are the checksums in
# running form. The streams are in `flate_stream_fixtures.selka`: the two of a mebibyte were made by the system `gzip -9`, the
# small ones by `gzip` or Python's zlib (`experiments/audit-work-20261111/gzstream_gen_fixtures.py`), and every checksum
# below is Python's. A guest test has a budget of 1,000,000 executed blocks, so the inputs of a mebibyte are streams of
# repeated data that decode in a few thousand symbols, one decode to a test.
const RAW: int = 0


const ZLIB: int = 1


const GZIP: int = 2


# The size of the whole of the input, which makes one piece of any stream here.
const WHOLE: int = 100000000


# The most one call may return: a mebibyte and the last match.
const CHUNK_LIMIT: int = 1048576 + 258


const NO_LIMIT: int = 9223372036854775807


const MEBIBYTE: int = 1048576


const MAGIC: str = "the data is not gzip: the magic number is wrong"


const SIZE_LIMIT: str = "the result is past the size limit"


const TRUNCATED: str = "unexpected end of the compressed data"


# What a stream gave: the plain bytes and an empty message, or the message that stopped it.
record Outcome:
    plain: bytes
    message: str


func make(kind: int, limit: int) -> flate.Inflater:
    if kind == RAW:
        return flate.inflater(limit)
    if kind == ZLIB:
        return flate.zlib_inflater(limit)
    return flate.gzip_inflater(limit)


# Feed `data` to a stream `size` bytes at a time, take each call's output and the rest of the call's piece with empty
# feeds, and finish: all the plain bytes, or the message of the first failure.
func through(kind: int, data: bytes, size: int, limit: int) -> bytes fails str:
    mut stream = make(kind, limit)
    mut out = buffers.empty()
    mut at = 0
    while at < len(data):
        const end = min(at + size, len(data))
        mut plain = try flate.feed(mut stream, data[at:end])
        while len(plain) > 0:
            buffers.append(mut out, plain)
            plain = try flate.feed(mut stream, b"")
        at = end
    try flate.finish(stream)
    return bytes(out)


func outcome(kind: int, data: bytes, size: int, limit: int) -> Outcome:
    const plain = through(kind, data, size, limit) else Err(message):
        return Outcome(plain=b"", message=own message)
    return Outcome(plain=own plain, message="")


# The stream fed in pieces of each of `sizes` gives `expected` and no message.
func gives(kind: int, data: bytes, expected: bytes, sizes: int[], name: str) -> bool:
    for size in sizes:
        const result = outcome(kind, data, size, NO_LIMIT)
        assert result.message == "", f"{name} in pieces of {size}: {result.message}"
        assert result.plain == expected, f"{name} in pieces of {size} gave other bytes"
    return True


# The stream fed in pieces of each of `sizes` stops with `message`.
func stops(kind: int, data: bytes, message: str, sizes: int[], name: str) -> bool:
    for size in sizes:
        const result = outcome(kind, data, size, NO_LIMIT)
        assert result.message == message, f"{name} in pieces of {size}: `{result.message}`"
    return True


# `piece` repeated `times` times, by doubling.
func repeated(piece: bytes, times: int) -> bytes:
    mut out = buffers.empty()
    buffers.append(mut out, piece)
    mut count = 1
    while count < times:
        const more = min(count, times - count)
        buffers.append(mut out, bytes(out[0:more * len(piece)]))
        count += more
    return bytes(out)


func put_u32(mut out: byte_buffer, value: int):
    for part in range(4):
        _ = buffers.append_byte(mut out, bit_and(shift_right(value, part * 8), 255))


# A gzip member of `plain` in stored blocks of 65,535 bytes, with the CRC-32 `crc` Python gave for `plain`.
func stored_member(plain: bytes, crc: int) -> bytes:
    mut out = buffers.empty()
    buffers.append(mut out, b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x00\xff")
    mut at = 0
    while at < len(plain):
        const length = min(65535, len(plain) - at)
        if at + length == len(plain):
            _ = buffers.append_byte(mut out, 1)
        else:
            _ = buffers.append_byte(mut out, 0)
        _ = buffers.append_byte(mut out, bit_and(length, 255))
        _ = buffers.append_byte(mut out, shift_right(length, 8))
        _ = buffers.append_byte(mut out, bit_and(bit_xor(length, 65535), 255))
        _ = buffers.append_byte(mut out, shift_right(bit_xor(length, 65535), 8))
        _ = buffers.append_range(mut out, plain, at, at + length)
        at += length
    put_u32(mut out, crc)
    put_u32(mut out, len(plain))
    return bytes(out)


# The byte `at` of `data` replaced by `value`.
func with_byte(data: bytes, at: int, value: int) -> bytes:
    mut out = buffers.empty()
    buffers.append(mut out, data[0:at])
    _ = buffers.append_byte(mut out, value)
    buffers.append(mut out, data[at + 1:])
    return bytes(out)


# `data` with the lowest bit of the byte `back` from its end flipped.
func with_flipped(data: bytes, back: int) -> bytes:
    const at = len(data) - back
    return with_byte(data, at, bit_xor(int(data[at]), 1))


# The plain bytes of `fixtures.gz_fixed_all()`, which a stream gives in pieces of `size` bytes, are 86,040 with CRC-32 2983503818
# (Python's). Its one fixed-code block uses all 286 literal/length symbols and all 30 distance symbols, so every code of the
# fixed tables is read.
func fixed_all_in_pieces_of(size: int) -> bool:
    const result = outcome(GZIP, fixtures.gz_fixed_all(), size, NO_LIMIT)
    assert result.message == "", f"pieces of {size}: {result.message}"
    assert len(result.plain) == 86040, f"pieces of {size}: {len(result.plain)} bytes"
    assert flate.crc32(result.plain) == 2983503818, f"pieces of {size}"
    return True


public func test_a_fixed_block_that_uses_every_symbol_inflates_in_pieces_of_one_byte() -> bool:
    return fixed_all_in_pieces_of(1)


public func test_a_fixed_block_that_uses_every_symbol_inflates_in_larger_pieces_and_whole() -> bool:
    assert fixed_all_in_pieces_of(4096)
    return fixed_all_in_pieces_of(WHOLE)


public func test_a_gzip_stored_block_inflates_in_any_pieces() -> bool:
    return gives(GZIP, fixtures.gz_stored(), fixtures.base(), [1, 7, 4096, 65536, WHOLE], "gzip, stored block")


public func test_a_gzip_fixed_block_inflates_in_any_pieces() -> bool:
    return gives(GZIP, fixtures.gz_fixed(), fixtures.base(), [1, 7, 4096, 65536, WHOLE], "gzip, fixed block")


public func test_a_gzip_dynamic_block_inflates_in_any_pieces() -> bool:
    return gives(GZIP, fixtures.gz_dynamic(), fixtures.base(), [1, 7, 4096, 65536, WHOLE], "gzip, dynamic block")


public func test_a_zlib_stored_block_inflates_in_any_pieces() -> bool:
    return gives(ZLIB, fixtures.zlib_stored(), fixtures.base(), [1, 7, 4096, 65536, WHOLE], "zlib, stored block")


public func test_a_zlib_fixed_block_inflates_in_any_pieces() -> bool:
    return gives(ZLIB, fixtures.zlib_fixed(), fixtures.base(), [1, 7, 4096, 65536, WHOLE], "zlib, fixed block")


public func test_a_zlib_dynamic_block_inflates_in_any_pieces() -> bool:
    return gives(ZLIB, fixtures.zlib_dynamic(), fixtures.base(), [1, 7, 4096, 65536, WHOLE], "zlib, dynamic block")


public func test_a_raw_stored_block_inflates_in_any_pieces() -> bool:
    return gives(RAW, fixtures.raw_stored(), fixtures.base(), [1, 7, 4096, 65536, WHOLE], "raw, stored block")


public func test_a_raw_fixed_block_inflates_in_any_pieces() -> bool:
    return gives(RAW, fixtures.raw_fixed(), fixtures.base(), [1, 7, 4096, 65536, WHOLE], "raw, fixed block")


public func test_a_raw_dynamic_block_inflates_in_any_pieces() -> bool:
    return gives(RAW, fixtures.raw_dynamic(), fixtures.base(), [1, 7, 4096, 65536, WHOLE], "raw, dynamic block")


# What the one-shot function for `kind` gives for `data`.
func one_shot(kind: int, data: bytes) -> Outcome:
    if kind == RAW:
        const plain = flate.inflate(data, NO_LIMIT) else Err(message):
            return Outcome(plain=b"", message=own message)
        return Outcome(plain=own plain, message="")
    if kind == ZLIB:
        const plain = flate.zlib_decode(data, NO_LIMIT) else Err(message):
            return Outcome(plain=b"", message=own message)
        return Outcome(plain=own plain, message="")
    const plain = flate.gunzip(data, NO_LIMIT) else Err(message):
        return Outcome(plain=b"", message=own message)
    return Outcome(plain=own plain, message="")


public func test_the_streaming_form_gives_what_the_one_shot_functions_give() -> bool:
    const plain = fixtures.base()
    assert one_shot(GZIP, fixtures.gz_dynamic()).plain == plain
    assert one_shot(ZLIB, fixtures.zlib_fixed()).plain == outcome(ZLIB, fixtures.zlib_fixed(), 7, NO_LIMIT).plain
    assert one_shot(RAW, fixtures.raw_stored()).plain == outcome(RAW, fixtures.raw_stored(), 1, NO_LIMIT).plain
    const garbage = fixtures.gz_short_fixed() + b"these are not the bytes of a member"
    assert one_shot(GZIP, garbage).message == outcome(GZIP, garbage, 7, NO_LIMIT).message
    assert one_shot(ZLIB, fixtures.zlib_short_fixed() + b"x").message == outcome(ZLIB, fixtures.zlib_short_fixed() + b"x", 7, NO_LIMIT).message
    return True


public func test_several_members_and_an_empty_member_inflate_in_pieces_of_one_byte() -> bool:
    const plain = fixtures.base()
    const members = fixtures.gz_dynamic() + fixtures.gz_empty() + fixtures.gz_fixed() + fixtures.gz_stored()
    return gives(GZIP, members, plain + plain + plain, [1], "four members")


public func test_several_members_and_an_empty_member_inflate_in_larger_pieces_and_whole() -> bool:
    const plain = fixtures.base()
    const members = fixtures.gz_dynamic() + fixtures.gz_empty() + fixtures.gz_fixed() + fixtures.gz_stored()
    return gives(GZIP, members, plain + plain + plain, [7, 4096, WHOLE], "four members")


public func test_empty_members_inflate_to_nothing_in_any_pieces() -> bool:
    assert gives(GZIP, fixtures.gz_empty(), b"", [1, 7, WHOLE], "an empty member")
    assert gives(GZIP, fixtures.gz_empty() + fixtures.gz_empty(), b"", [1, 7, WHOLE], "two empty members")
    return True


public func test_zero_padding_after_the_last_member_is_ignored_in_any_pieces() -> bool:
    const padded = fixtures.gz_fixed() + fixtures.gz_empty() + b"\x00\x00\x00\x00\x00\x00\x00"
    return gives(GZIP, padded, fixtures.base(), [1, 7, WHOLE], "a member, an empty member and zero padding")


public func test_an_empty_input_is_an_empty_gzip_stream_and_not_an_empty_raw_or_zlib_stream() -> bool:
    assert flate.ended(flate.gzip_inflater(NO_LIMIT))
    assert not flate.ended(flate.inflater(NO_LIMIT))
    assert not flate.ended(flate.zlib_inflater(NO_LIMIT))
    assert outcome(GZIP, b"", 1, NO_LIMIT).message == ""
    assert outcome(RAW, b"", 1, NO_LIMIT).message == TRUNCATED
    assert outcome(ZLIB, b"", 1, NO_LIMIT).message == "the zlib stream is too short"
    return True


