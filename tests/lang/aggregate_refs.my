module aggregate_refs

# Aggregate parameters cross the native boundary by address: a callee that only
# reads one reads the caller's value where it lives, and a callee that writes one
# keeps a private copy. These cases pin the value semantics that change must not
# move: a record stays a value at every call, return, list element and
# instantiated generic body.


public record Point:
    x: i64
    y: i64


public record Box:
    label: str
    point: Point


public union Slot:
    filled(point: Point, tag: i64),
    empty


def bump(point: Point) -> i64:
    point = Point(x=point.x + 100, y=point.y + 200)
    return point.x


def bump_field(point: Point) -> i64:
    point.x = point.x + 100
    return point.x


def shifted(point: Point) -> Point:
    return Point(x=point.x + 1, y=point.y + 2)


def pack(left: Point, right: Point) -> i64:
    return left.x * 1000 + left.y + right.x * 10 + right.y


def pick_first[T](items: list[T]) -> T:
    return items[0]


def classify(slot: Slot) -> i64:
    match slot:
        case Slot.filled(point, tag):
            return point.x * 10 + tag
        case Slot.empty:
            return 0


def append_then_read(items: list[Point], first: Point) -> i64:
    items.append(Point(x=100, y=200))
    return first.x * 1000 + first.y


# spec-case: QBE-AGGREF-1
public def test_a_written_record_parameter_leaves_the_callers_value_alone() -> bool:
    original = Point(x=1, y=2)
    inside = bump(original)
    return inside == 101 and original.x == 1 and original.y == 2


# spec-case: QBE-AGGREF-1
public def test_a_field_write_inside_a_callee_leaves_the_callers_value_alone() -> bool:
    original = Point(x=5, y=6)
    inside = bump_field(original)
    return inside == 105 and original.x == 5 and original.y == 6


# spec-case: QBE-AGGREF-1
public def test_a_returned_record_stored_into_a_local_carries_its_fields() -> bool:
    base = Point(x=10, y=20)
    moved = shifted(base)
    return moved.x == 11 and moved.y == 22 and base.x == 10 and base.y == 20


# spec-case: QBE-AGGREF-1
public def test_a_returned_record_passed_straight_into_another_call() -> bool:
    return pack(shifted(Point(x=1, y=2)), shifted(Point(x=3, y=4))) == 2050


# spec-case: QBE-AGGREF-1
public def test_a_record_read_from_a_list_argument_keeps_its_value_across_a_write() -> bool:
    items: list[Point] = [Point(x=7, y=8)]
    read = append_then_read(items, items[0])
    return read == 7008 and len(items) == 2 and items[0].x == 7 and items[1].x == 100


# spec-case: QBE-AGGREF-1
public def test_a_record_returned_from_a_generic_body_keeps_its_value() -> bool:
    items: list[Point] = [Point(x=11, y=12), Point(x=13, y=14)]
    got = pick_first[Point](items)
    boxes: list[Box] = [Box(label="one", point=Point(x=21, y=22))]
    held = pick_first[Box](boxes)
    return got.x == 11 and got.y == 12 and held.point.y == 22 and len(held.label) == 3


# spec-case: QBE-AGGREF-1
public def test_a_match_payload_bound_from_a_record_local_keeps_the_local_intact() -> bool:
    point = Point(x=3, y=4)
    slot = Slot.filled(point, 5)
    score = classify(slot)
    return score == 35 and point.x == 3 and point.y == 4


# spec-case: QBE-AGGREF-1
public def test_a_returned_union_payload_reaches_the_caller_unchanged() -> bool:
    held = Slot.filled(shifted(Point(x=2, y=3)), 9)
    return classify(held) == 39


def guarded(count: i64) -> Point:
    if count < 0:
        assert count >= 0, "count must not be negative"
    return Point(x=count, y=count + 1)


# spec-case: QBE-AGGREF-1
public def test_a_returning_path_still_returns_its_record_next_to_a_trapping_one() -> bool:
    got = guarded(4)
    return got.x == 4 and got.y == 5


def main() -> int:
    return 0
