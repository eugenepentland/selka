# A caller-pinned plain receiver needs no local owner or scope publication.
record Point:
    x: int
    y: int


def advance(points: mut list[Point], index: int, delta: int) -> int:
    old = points[index]
    points[index].x = old.x + delta
    return points[index].x


def loop(points: mut list[Point], count: int) -> int:
    i = 0
    while i < count:
        old = points[0]
        points[0].x = old.x + 1
        i += 1
    return points[0].x


# spec-case: RC-EMPTY-FRAME-1
public def test_caller_snapshot_and_negative_index_survive_unlinked_callee() -> bool:
    points = [Point(3, 5), Point(7, 11)]
    before = points
    result = advance(mut points, -1, 13)
    return result == 20 and points[1].x == 20 and before[1].x == 7 and points[0].y == 5


# spec-case: RC-EMPTY-FRAME-1
public def test_inherited_arena_preserves_older_receiver_and_snapshot() -> bool:
    points = [Point(3, 5)]
    before = points
    with arena():
        assert advance(mut points, 0, 7) == 10
        assert loop(mut points, 9) == 19
    return points[0].x == 19 and before[0].x == 3


# spec-case: RC-EMPTY-FRAME-1
public def test_arena_owned_caller_keeps_pin_until_plain_loop_returns() -> bool:
    with arena():
        points = [Point(2, 3)]
        before = points
        assert loop(mut points, 20) == 22
        assert advance(mut points, 0, -1) == 21
        assert points[0].x == 21 and before[0].x == 2
    return True


def changed(points: mut list[Point]) -> int:
    points.append(Point(17, 19))
    return 0


def callback(points: mut list[Point]):
    mutation_result_57 = changed(mut points)
    points[mutation_result_57].x = 23


# spec-case: RC-EMPTY-FRAME-1
public def test_completed_callback_keeps_caller_and_snapshot_independent() -> bool:
    points = [Point(3, 5)]
    before = points
    callback(mut points)
    return points[0].x == 23 and len(points) == 2 and before[0].x == 3 and len(before) == 1


def main() -> int:
    assert test_caller_snapshot_and_negative_index_survive_unlinked_callee()
    assert test_inherited_arena_preserves_older_receiver_and_snapshot()
    assert test_arena_owned_caller_keeps_pin_until_plain_loop_returns()
    assert test_completed_callback_keeps_caller_and_snapshot_independent()
    return 0
