# spec-case: LIST-LITERAL-PAYLOAD-1
public def test_a_thousand_text_elements_keep_their_length_and_content() -> bool:
    items = thousand_text()
    return len(items) == 1000 and items[0] == "é😀" and items[999] == "é😀" and len(items[500]) == 2


# spec-case: LIST-LITERAL-PAYLOAD-1
public def test_a_thousand_byte_elements_keep_their_length_and_content() -> bool:
    items = thousand_bytes()
    return len(items) == 1000 and items[0] == b"\x00\xff" and items[999] == b"\x00\xff" and len(items[500]) == 2

