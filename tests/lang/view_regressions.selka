# The five view regressions the review of wave 3 found, as guest behaviour:
# every one of these shapes compiled before wave 3 and must print its old value.
# Refused shapes live beside `test/fix_wave3_fixes_test.zig`.
func head(t: str) -> str from t:
    return t[0:4]


func head_of(element: str) -> str from element:
    return element[0:3]


record Named:
    name: str


enum Shape:
    circle(radius: int)
    named(name: str)


func payload_first(sh: Shape) -> str:
    match sh:
        case named(name=value):
            const piece = value[0:4]
            return copy(piece)
        case circle(radius):
            return str(radius)


# spec-case: NEW-CORE-ZERO-RC-VIEWS-1
# REGRESSION-R1: a view-returning call merged at a phi is an owned value, so the
# merge is valid and prints the slice the pre-wave-3 compiler printed.
public func test_the_review_r1_a_view_result_merged_at_a_phi_keeps_its_value() -> bool:
    const a = "hello"
    mut h = "none"
    if len(a) > 3:
        h = copy(head(a))
    return h == "hell"


# spec-case: NEW-CORE-ZERO-RC-VIEWS-1
# REGRESSION-R1: the loop-carried form stores each result into a `mut` binding.
public func test_the_review_r1_a_loop_carried_view_store_keeps_its_value() -> bool:
    const words = ["alpha", "bravo", "charlie"]
    mut best = ""
    for word in words:
        best = copy(head(word))
    return best == "char"


# spec-case: NEW-CORE-ZERO-RC-VIEWS-1
# REGRESSION-R1: a deferred `const` fed by two branches.
public func test_the_review_r1_a_deferred_const_of_two_view_calls_keeps_its_value() -> bool:
    const a = "alpha"
    const b = "bravo"
    const h: str
    if len(a) > 9:
        h = copy(head(a))
    else:
        h = copy(head(b))
    return h == "brav"


# spec-case: NEW-CORE-ZERO-RC-VIEWS-1
# REGRESSION-R3: a binding that is a slice on one path and owned on another is
# an owned value, and the slice initialization copies at its store.
public func test_the_review_r3_a_mixed_deferred_const_is_owned() -> bool:
    const s = "hello"
    const h: str
    if len(s) > 3:
        h = copy(s[0:2])
    else:
        h = "zz"
    return h == "he"


# spec-case: NEW-CORE-ZERO-RC-VIEWS-1
# REGRESSION-R3: two views of one live source merge as one view.
public func test_the_review_r3_two_slices_of_one_source_merge() -> bool:
    const s = "hello"
    const h: str
    if len(s) > 3:
        h = s[0:2]
    else:
        h = s[1:3]
    return h == "he"


# spec-case: NEW-CORE-ZERO-RC-VIEWS-1
# REGRESSION-R3: the list form of a mixed initialization.
public func test_the_review_r3_a_mixed_list_initialization_is_owned() -> bool:
    const xs = ["aa", "bb", "cc"]
    const h: str[]
    if len(xs) > 2:
        h = copy(xs[0:2])
    else:
        h = ["zz"]
    return len(h) == 2 and h[0] == "aa"


# spec-case: NEW-CORE-ZERO-RC-VIEWS-1
# REGRESSION-R4: a view read before its source's loop mutation is dead by then,
# so nothing is refused and both values print.
public func test_the_review_r4_a_dead_view_before_a_loop_mutation_is_harmless() -> bool:
    mut s = "abc"
    const k = s[1:3]
    const before = copy(k)
    for _ in range(3):
        s += "x"
    return before == "bc" and s == "abcxxx"


# spec-case: NEW-CORE-ZERO-RC-VIEWS-1
# REGRESSION-R5: a slice of a `match` payload of the single borrowable parameter
# returns as a view; no copy is needed.
public func test_the_review_r5_a_match_payload_slice_returns_as_a_view() -> bool:
    return payload_first(Shape.named(name="abcdxyz")) == "abcd"


# spec-case: NEW-CORE-ZERO-RC-VIEWS-1
# REGRESSION-R1/R5: a field of the parameter and a payload both behave as the
# record field did before wave 3.
public func test_the_review_r5_a_field_slice_still_returns_as_a_view() -> bool:
    const item = Named(name="abcdef")
    const piece = item.name[0:2]
    return piece == "ab" and head_of("xyzw") == "xyz"
