import lists

"""A comparison chain used as a condition (`if`, `while`, `assert`, a clause, inside `and`, `or` and `not`) is lowered
as one branch per link (proof steps, lane C). These tests pin what that must not change: each operand is evaluated
once, in source order, and a later operand only when every earlier link held. `python_expressions.selka` pins the same
for a chain used as a value; `test/core/chain_traps.selka` pins traps raised by an operand."""


func mark(mut log: int[], value: int) -> int:
    append(mut log, value)
    return value


public func test_an_if_chain_evaluates_each_operand_once_in_order() -> bool:
    mut log: int[] = []
    mut taken = 0
    if mark(mut log, 1) < mark(mut log, 2) <= mark(mut log, 2) < mark(mut log, 4):
        taken += 1
    return taken == 1 and log == [1, 2, 2, 4]


public func test_an_if_chain_stops_at_the_first_false_link() -> bool:
    mut log: int[] = []
    mut taken = 0
    if mark(mut log, 1) < mark(mut log, 5) < mark(mut log, 3) < mark(mut log, 9):
        taken += 1
    else:
        taken -= 1
    if taken != -1 or log != [1, 5, 3]:
        return False
    lists.clear(mut log)
    if mark(mut log, 7) < mark(mut log, 2) < mark(mut log, 9):
        return False
    return log == [7, 2]


public func test_a_later_operand_that_would_trap_is_not_reached() -> bool:
    const xs: int[] = [1, 2, 3]
    mut zero = 0
    mut seen = 0
    for i in range(6):
        if 0 <= i < len(xs) and 0 < xs[i] <= 3:
            seen += 1
        if i < 0 < 10 // zero:
            return False
        if i < 0 < xs[i]:
            return False
    return seen == 3


public func test_a_while_chain_reevaluates_every_operand_each_trip() -> bool:
    mut log: int[] = []
    mut i = 0
    while mark(mut log, 0) <= mark(mut log, i) < mark(mut log, 3):
        i += 1
    return i == 3 and log == [0, 0, 3, 0, 1, 3, 0, 2, 3, 0, 3, 3]


public func test_not_and_or_around_a_chain_keep_their_meaning() -> bool:
    mut hits = 0
    for x in range(-2, 8):
        if not (0 <= x < 5):
            hits += 100
        if x == -2 or 3 < x <= 6:
            hits += 10
        if 0 < x < 3 and 1 <= x * 2 <= 4:
            hits += 1
    # outside [0, 5): -2, -1, 5, 6, 7; -2 or (3, 6]: -2, 4, 5, 6; both: 1, 2
    return hits == 5 * 100 + 4 * 10 + 2


func classify(value: int) -> int:
    if -128 <= value <= -1:
        return -1
    if 0 <= value < 128:
        return 0
    return 1


public func test_a_chain_bounds_the_value_in_its_branch() -> bool:
    const table: int[] = [5, 6, 7]
    mut total = 0
    for k in range(-4, 6):
        if 0 <= k < 3:
            total += table[k]
    return total == 18 and classify(-128) == -1 and classify(-1) == -1 and classify(0) == 0 and classify(127) == 0 and classify(128) == 1


@requires(0 <= index < 3)
@ensures(10 <= result <= 30)
func lookup(index: int) -> int:
    const xs: int[] = [10, 20, 30]
    return xs[index]


public func test_chained_clauses_and_asserts_hold_on_every_path() -> bool:
    mut total = 0
    for i in range(3):
        assert -1 < i <= 2, "the index stays in the table"
        total += lookup(i)
    return total == 60


func odd_marks(mut log: int[], value: int) -> bool:
    append(mut log, value)
    return value % 2 == 1


public func test_bool_operands_and_mixed_links_keep_order() -> bool:
    mut log: int[] = []
    mut taken = 0
    if odd_marks(mut log, 3) == odd_marks(mut log, 5) != odd_marks(mut log, 4):
        taken += 1
    return taken == 1 and log == [3, 5, 4]
