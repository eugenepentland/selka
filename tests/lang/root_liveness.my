# A safepoint publishes only the locals live across it. These cases hold a
# value across a collection in every way the frame can still read it — a named
# local, an operand, a loop's receiver, an error path, an arena scan, a callback
# and a fused decode — and let a dead one go. Under `--gc-stress` every
# allocation collects, so a value missing from a root would be read after the
# sweep freed it.
public record Ball:
    x: float
    y: float
    radius: float


func fresh(n: int) -> int[]:
    return [n, n + 1, n + 2, n + 3]


func churn(n: int) -> int:
    mut total = 0
    for i in range(40):
        mut ys = [i + 100, i + 101, i + 102, i + 103]
        total += ys[1] - ys[0]
    return total + n


public func test_a_local_read_after_many_collections_keeps_its_value() -> bool:
    mut keep = fresh(10)
    mut dead = fresh(20)
    mut total = dead[3]
    for i in range(30):
        mut scratch = fresh(i)
        total += scratch[1]
    return keep[2] == 12 and total == 23 + 30 * 31 // 2 + 0


public func test_list_writes_in_a_loop_survive_allocations_between_them() -> bool:
    mut values = fresh(0)
    for round in range(25):
        values[0] = values[0] + values[1]
        mut extra = fresh(round)
        values[1] = values[1] + extra[0] - round
        values[2] = values[0] - values[1]
    return values[0] == 25 and values[1] == 1 and values[2] == 24


func pair(left: int[], right: int[]) -> int:
    return left[0] * 10 + right[1]


public func test_an_operand_held_only_on_the_stack_survives_the_next_call() -> bool:
    return pair(fresh(1), fresh(2)) == 13 and pair(fresh(churn(0)), fresh(4)) == 405


func risky(n: int) -> Result[int, int]:
    mut scratch = fresh(n)
    if n == 0:
        return Err(scratch[3])
    return Ok(scratch[1])


func guarded(n: int) -> Result[int, int]:
    mut keep = fresh(50)
    mut got = try risky(n)
    return Ok(got + keep[3])


public func test_a_value_read_after_a_propagating_call_survives_it() -> bool:
    match guarded(4):
        case Ok(value):
            if value != 58:
                return False
        case Err(_):
            return False
    match guarded(0):
        case Ok(_):
            return False
        case Err(code):
            return code == 3


func shaped(n: int) -> int[]?:
    if n == 0:
        return None
    return Some(fresh(n))


public func test_a_match_payload_stays_live_across_an_allocation() -> bool:
    match shaped(5):
        case Some(found):
            mut extra = fresh(churn(1))
            return found[3] == 8 and extra[0] == 41
        case None:
            return False


public func test_a_fused_slice_decode_keeps_its_receiver() -> bool:
    mut raw = ("héllo" + str(churn(2))).encode()
    match raw[1:3].decode():
        case Ok(text):
            return text == "é"
        case Err(_):
            return False


func apply(f: func(int) -> int, n: int) -> int:
    mut keep = fresh(n)
    mut got = f(n)
    return got + keep[2]


public func test_a_list_survives_a_callback_that_allocates() -> bool:
    return apply(churn, 5) == 52


func reach(ball: Ball, x: float) -> float:
    mut dx = ball.x - x
    return dx * dx - ball.radius * ball.radius


public func test_a_borrowed_element_handed_to_a_plain_call_reads_its_own_values() -> bool:
    mut balls = [Ball(x=0.0, y=0.0, radius=1.0), Ball(x=3.0, y=0.0, radius=0.5), Ball(x=9.0, y=1.0, radius=2.0)]
    mut hits = 0
    mut last = -1
    for k, ball in enumerate(balls):
        if reach(ball, 3.2) < 0.0:
            hits += 1
            last = k
        balls[k] = Ball(x=ball.x + 1.0, y=ball.y, radius=ball.radius)
    return hits == 1 and last == 1 and balls[2].x == 10.0


public record Link:
    target: int
    weight: int


public func test_a_borrowed_element_indexes_another_list_at_run_time() -> bool:
    mut links = [Link(target=2, weight=1), Link(target=-3, weight=2), Link(target=0, weight=3)]
    mut weights = [10, 20, 30]
    mut total = 0
    mut i = 0
    while i < len(links):
        mut link = links[i]
        total += weights[link.target] * link.weight
        i += 1
    return total == 30 * 1 + 10 * 2 + 10 * 3


func main() -> int:
    return 0
