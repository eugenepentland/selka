# N5 (12 November 2026): every library operation that can receive a text, bytes or list view, called on a parameter, an
# inline slice and a slice binding. The build checks that no copy is hidden (E_CORE_HIDDEN_COPY); `strings.char_stride` on a
# view used to leave one. `lists.stride` on a list view (view_92) was refused E_CORE_UNSUPPORTED until lane FX.
import buffers
import bytes
import lists
import strings

func apply(f: func(str) -> str, text: str) -> str:
    return f(text)


# strings.is_digit
func view_00(s: str, t: str, b: bytes, c: bytes, xs: int[]) -> int:
    const sv = s[1:6]
    if len(t) > 0:
        _ = strings.is_digit(s)
    if len(t) > 0:
        _ = strings.is_digit(s[1:6])
    if len(t) > 0:
        _ = strings.is_digit(sv)
    # Every parameter is read, so the parameters an operation does not take raise no warning.
    return 1 + len(s) + len(t) + len(b) + len(c) + len(xs) - len(s) - len(t) - len(b) - len(c) - len(xs)


