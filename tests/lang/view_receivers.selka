# strings.append(builder)
func view_16(s: str, t: str, b: bytes, c: bytes, xs: int[]) -> int:
    const sv = s[1:6]
    if len(t) > 0:
        mut o = strings.builder()
        strings.append(mut o, s)
        _ = len(strings.finish(o))
    if len(t) > 0:
        mut o = strings.builder()
        strings.append(mut o, s[1:6])
        _ = len(strings.finish(o))
    if len(t) > 0:
        mut o = strings.builder()
        strings.append(mut o, sv)
        _ = len(strings.finish(o))
    # Every parameter is read, so the parameters an operation does not take raise no warning.
    return 1 + len(s) + len(t) + len(b) + len(c) + len(xs) - len(s) - len(t) - len(b) - len(c) - len(xs)


# strings.pad_left
func view_17(s: str, t: str, b: bytes, c: bytes, xs: int[]) -> int:
    const sv = s[1:6]
    if len(t) > 0:
        match strings.pad_left(s, 12, " "):
            case Ok(v):
                _ = len(v)
            case Err(e):
                _ = e
    if len(t) > 0:
        match strings.pad_left(s[1:6], 12, " "):
            case Ok(v):
                _ = len(v)
            case Err(e):
                _ = e
    if len(t) > 0:
        match strings.pad_left(sv, 12, " "):
            case Ok(v):
                _ = len(v)
            case Err(e):
                _ = e
    # Every parameter is read, so the parameters an operation does not take raise no warning.
    return 1 + len(s) + len(t) + len(b) + len(c) + len(xs) - len(s) - len(t) - len(b) - len(c) - len(xs)


