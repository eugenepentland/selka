# Wave 2 batch W: bound and inline slices follow one rule, and a list view of a
# mutable source behaves like a text view. The refusals live in
# `test/fix_wave2_w_test.zig`; these are the shapes that stay accepted.
import strings

# spec: SLICE-ESCAPES-1
public func test_a_read_only_bound_text_slice_reads_its_source() -> bool:
    const text = "abcd"
    const piece = text[1:3]
    return len(piece) == 2 and piece == "bc"


# spec: SLICE-ESCAPES-1
public func test_a_read_only_bound_list_slice_reads_its_source() -> bool:
    const xs = [1, 2, 3, 4]
    const head = xs[0:2]
    return len(head) == 2 and head[0] == 1 and head[1] == 2


# spec: SLICE-ESCAPES-1
public func test_a_list_view_of_a_mutable_source_is_read_before_the_change() -> bool:
    mut xs = [1, 2, 3]
    const head = copy(xs[0:2])
    const copied = head
    append(mut xs, 4)
    return len(copied) == 2 and len(xs) == 4


# spec: SLICE-ESCAPES-1
public func test_a_deferred_list_binding_of_two_slices_keeps_its_value() -> bool:
    const xs = [1, 2, 3, 4]
    const chosen: int[]
    if len(xs) > 2:
        chosen = xs[0:2]
    else:
        chosen = xs[1:3]
    return len(chosen) == 2 and chosen[0] == 1


# spec: SLICE-ESCAPES-1
public func test_a_mixed_deferred_list_binding_is_owned() -> bool:
    const xs = [1, 2, 3, 4]
    const chosen: int[]
    if len(xs) > 2:
        chosen = copy(xs[0:2])
    else:
        chosen = [9, 9]
    return len(chosen) == 2 and chosen[0] == 1


# spec: NEGATIVE-INDEX-REMOVED-1
public func test_the_repaired_scalar_helper_position_keeps_its_answer() -> bool:
    const text = "λλb"
    return strings.char_find(text, "b", max(strings.char_count(text) - 1, 0)) == 2


func main() -> int:
    return 0
