
record A:
    value: i64


record B:
    value: i64


func first[T, const N: u64](items: [N]T) -> T:
    return items[0]


func count[T, const N: u64](items: [N]T) -> u64:
    _ = items
    return N


func main() -> i64:
    mut a = first[A, 2](FixedArray[A, 2]([A(value=40), A(value=0)]))
    mut b = first[B, 1](FixedArray[B, 1]([B(value=2)]))
    return a.value + b.value + i64(count[A, 0](FixedArray[A, 0]([])))

public func test_one_helper_serves_distinct_nominal_element_t() -> bool:
    return main() == 42
