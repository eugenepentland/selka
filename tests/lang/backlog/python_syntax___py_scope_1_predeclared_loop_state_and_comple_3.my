module python_syntax___py_scope_1_predeclared_loop_state_and_comple_3

def main() -> int:
    answer = 0
    i = 0
    while i < 3:
        answer = answer + i
        i += 1
    return answer

# spec-case: PY-SCOPE-1
public def test_py_scope_1_predeclared_loop_state_and_comple_3() -> bool:
    return main() == 3
