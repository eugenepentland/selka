
func first[T, const N: u64](items: [N]T) -> T:
    return items[0]


func size[const N: u64]() -> u64:
    return N


func forward[T, const N: u64](items: [N]T) -> T:
    return first[T, N](items)


func main() -> i64:
    return forward[i64, 2](FixedArray[int, 2]([40, 0])) + i64(size[2]())

public func test_const_length_function_parameters_specialize() -> bool:
    return main() == 42
