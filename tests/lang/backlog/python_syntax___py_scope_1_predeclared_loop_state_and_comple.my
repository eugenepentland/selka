module python_syntax___py_scope_1_predeclared_loop_state_and_comple

def main() -> int:
    total = 0
    last = 0
    for row in [[1, 2], [3, 9]]:
        last = row[1]
        total = total + last
    return total + last

# spec: PY-SCOPE-1
public def test_py_scope_1_predeclared_loop_state_and_comple_1() -> bool:
    return main() == 20
