enum Choice:
    first
    second


func main() -> int:
    const answer: int
    match Choice.first:
        case first:
            answer = 42
        case second:
            answer = 0
    return answer


# spec: PY-SCOPE-3
public func test_match_merges_definite_assignment_across_cont_1() -> bool:
    return main() == 42
