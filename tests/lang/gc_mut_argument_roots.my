record Rows:
    items: list[list[int]]
    other: list[int]


def replace_first(xs: mut list[list[int]]) -> int:
    xs[0] = [42]
    return 0


public def test_snapshot_survives_mut_argument_clone() -> bool:
    rows = Rows([[1, 2], [3]], [])
    before = len(rows.items[replace_first(mut rows.items)])
    return before == 2 and rows.items == [[42], [3]]
