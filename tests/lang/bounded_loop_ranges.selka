func calculate(count: int, seed: int) -> int:
    mut total = seed
    for at in range(count):
        total = (total + at * 7) % 1000003
    return total


func replaced(count: int, seed: int) -> int:
    mut total = seed
    for at in range(count):
        total = remtrunc(total + at * 7, -1009)
    return total


func skipped(count: int, seed: int) -> int:
    mut total = seed
    for at in range(count):
        if at % 3 != 0:
            total = (total + at) % 1009
        if at == 23:
            break
    return total


func continued(count: int, seed: int) -> int:
    mut total = seed
    for at in range(count):
        if at % 3 == 0:
            continue
        total = (total + at) % 1009
    return total


func domains(count: int) -> int:
    mut value = 0.0
    mut checksum = 0
    for at in range(count):
        value += float(at) * 0.5
        checksum += at
    return int(value) + checksum


public func test_modular_replacements_keep_seed_and_loop_boundaries() -> bool:
    return calculate(64, 0) == 14112 and calculate(4, 0) == 42 and calculate(0, 17) == 17 and calculate(-3, 19) == 19


public func test_negative_truncating_replacements_keep_their_sign() -> bool:
    return replaced(32, -100000) == 336 and replaced(64, -31) == 964 and replaced(0, -31) == -31


public func test_conditional_replacements_break_and_continue_keep_carried_values() -> bool:
    return skipped(64, 17) == 209 and skipped(0, 19) == 19 and continued(32, -31) == 300


public func test_float_domains_keep_ordered_exact_dyadic_arithmetic() -> bool:
    return domains(32) == 744 and domains(4) == 9 and domains(0) == 0


func main() -> int:
    return 0
