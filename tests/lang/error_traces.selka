# Recording an error return trace (ERROR-TRACE-1) writes only to the trace: every
# `Err` construction, `?`, conversion and returned result still carries exactly
# the value it carried before, including past the ring's 32 entries. A test
# returning `Result[bool, E]` expects `Ok(True)` without a cases file.
import strings

enum AppError:
    Config(value: str)
    Usage(value: int)


func parse_port(text: str) -> int fails str:
    if strings.char_count(text) == 0:
        fail "empty port"
    return strings.char_count(text)


func read_config(text: str) -> int fails str:
    mut port = try parse_port(text)
    return port + 1


func load(text: str) -> int fails AppError:
    match read_config(text):
        case Ok(value):
            return value
        case Err(error):
            fail AppError.Config(value=own error)


func descend(depth: int) -> int fails int:
    if depth == 0:
        fail 9
    const value = try descend(depth - 1)
    return value + 1


func climb(depth: int) -> int fails int:
    if depth == 0:
        return 0
    const value = try climb(depth - 1)
    return value + 1


func pass_on(result: Result[int, int]) -> int fails int:
    return try result


func choose(value: int) -> int fails int:
    if (value > 10):
        return value
    else:
        return try (pass_on(Err(value)))


func code_of(result: Result[int, int]) -> int:
    match result:
        case Ok(value):
            return value
        case Err(code):
            return -code


# spec-case: ERROR-TRACE-1
public func test_converted_error_keeps_its_payload() -> bool:
    match load(""):
        case Ok(port):
            return False
        case Err(error):
            match error:
                case Config(value=text):
                    return text == "empty port"
                case Usage(value=code):
                    return False


enum LoadError:
    Located(message: str, line: int)
    Missing(value: str)
    Count(value: int)


func load_missing(text: str) -> int fails LoadError:
    if text == "absent":
        fail "absent"
    return try parse_port(text)


func missing_is(result: Result[int, LoadError], expected: str) -> bool:
    match result:
        case Ok(_):
            return False
        case Err(error):
            match error:
                case Missing(value=text):
                    return text == expected
                case Located(message=_, line=_):
                    return False
                case Count(value=_):
                    return False


# One case of LoadError carries a `str` (Located has two fields), so `try` and `fail` convert into it (W1).
public func test_try_and_fail_convert_into_the_one_case_that_fits() -> bool:
    return missing_is(load_missing(""), "empty port") and missing_is(load_missing("absent"), "absent")


# spec-case: ERROR-TRACE-1
public func test_returned_results_keep_their_case_and_value() -> bool:
    return code_of(choose(4)) == -4 and code_of(choose(12)) == 12 and code_of(pass_on(Ok(3))) == 3


# spec-case: ERROR-TRACE-4
public func test_propagation_deeper_than_the_ring_keeps_the_error() -> bool:
    return code_of(descend(40)) == -9 and code_of(climb(40)) == 40


# spec-case: ERROR-TRACE-3
public func test_a_result_test_passes_on_ok_true() -> bool fails str:
    mut port = try read_config("ab")
    return port == 3


# spec-case: ERROR-TRACE-3
public func test_a_result_test_takes_a_stand_in_capability(fs: Filesystem) -> bool fails str:
    _ = try fs.write_text("port.txt", "8080")
    const text = try fs.read_text("port.txt")
    return text == "8080"
