module python_values


class ValuesBox:
    values: dict[str,int]


def package[T:copy+storable](value: T) -> dict[str,T]:
    values: dict[str,T] = {}
    values["key"] = value
    for key in values:
        if key not in values:
            return {}
    return values


def label[T:integer](number: T) -> str:
    return "n=" + str(number)


# spec-case: PY-TEXT-1
public def test_python_values_unicode_literals_chained_methods_indexing_and_membership() -> bool:
    text = "hé🙂,x,"
    parts = text.split(",")
    if ",".join(parts) != text:
        return False
    if "é🙂" not in text:
        return False
    if parts[0][2] != "🙂":
        return False
    return len(text) == 6


# spec-case: PY-DICT-1
public def test_python_values_dictionary_literal_growing_aliases_and_arbitrary_method_receivers() -> bool:
    box = ValuesBox(values={"one": 1})
    alias = box.values
    box.values["two"] = 40
    if "two" not in alias:
        return False
    if box.values.keys()[0] != "one":
        return False
    return alias.get("two",0) + {"fallback": 2}.get("fallback",0) == 42


# spec-case: PY-DICT-1
public def test_python_values_dictionary_and_unicode_text_iteration_preserve_order() -> bool:
    values = {"a": 10,"b": 20}
    total = 0
    for key in values:
        total += values[key]
    for index, ch in enumerate("é🙂"):
        total += index + len(ch)
    return total == 33


# spec-case: PY-TEXT-1
public def test_python_values_unicode_slicing_clamps_endpoints_and_returns_independent_text() -> bool:
    text = "aé🙂z"
    middle = text[1:-1]
    if middle != "é🙂":
        return False
    if text[-99:99] != text:
        return False
    if text[3:1] != "":
        return False
    return len(text[:]) + len(middle) == 6


# spec-case: PY-DICT-1
public def test_python_values_generic_dictionary_preserves_symbolic_value_types() -> bool:
    return package(42)["key"] == 42


# spec-case: PY-TEXT-1
public def test_python_values_generic_str_conversion_and_unicode_escapes() -> bool:
    if label(42) != "n=42":
        return False
    if "\u00e9\U0001f642" != "é🙂":
        return False
    return True


# spec-case: PY-DICT-1
public def test_python_values_collection_float_equality_and_membership_preserve_numeric_semantics() -> bool:
    zeros = [0.0]
    negative = [-0.0]
    if zeros != negative or -0.0 not in zeros:
        return False
    nan = 0.0 / 0.0
    nans = [nan]
    if nans == nans or nan in nans:
        return False
    if {"value": 0.0} != {"value": -0.0}:
        return False
    if {"value": nan} == {"value": nan}:
        return False
    if [[0.0]] != [[-0.0]]:
        return False
    return True


def main() -> int:
    return 0
