# O3 borrowed results read their ownership contract from the written signature.
import dicts
import json

func text_part(text: str) -> str from text:
    return text[1:4]


func bytes_part(data: bytes) -> bytes from data:
    return data[1:4]


func rows_part(rows: str[][]) -> str[][] from rows:
    return rows[1:3]


public func test_declared_text_bytes_and_list_slices_retain_their_sources() -> bool:
    const text = text_part("abcde-" + str(7))
    const octets = bytes_part(b"abcde" + b"!")
    const rows = rows_part([["zero"], ["one-" + str(1)], ["two-" + str(2)], ["three"]])
    return text == "bcd" and octets == b"bcd" and len(rows) == 2 and rows[0][0] == "one-1" and rows[1][0] == "two-2"


func maybe_part(text: str, available: bool) -> str? from text:
    if available:
        return Some(text[1:4])
    return None


public func test_a_declared_slice_can_be_wrapped_in_some_or_return_none() -> bool:
    const absent = maybe_part("abcde-" + str(7), False)
    if absent is not None:
        return False
    const present = maybe_part("abcde-" + str(8), True)
    match present:
        case Some(value):
            return value == "bcd"
        case None:
            return False


func checked_part(data: bytes, failed: bool) -> bytes from data fails str:
    if failed:
        fail "failure-" + str(len(data))
    return data[1:4]


func checked_part_matches(failed: bool) -> bool:
    const result = checked_part(b"abcde", failed)
    match result:
        case Ok(value):
            return not failed and value == b"bcd"
        case Err(message):
            return failed and message == "failure-5"


public func test_declared_slice_success_and_owned_failure_destroy_their_storage() -> bool:
    for index in range(32):
        assert checked_part_matches(index % 2 == 0)
    return True


func replace_text(mut text: str) -> str from text:
    text = "fresh-" + str(42)
    return text[0:5]


func replace_bytes(mut data: bytes) -> bytes from data:
    data = b"abcde" + b"!"
    return data[1:4]


func replace_rows(mut rows: str[][]) -> str[][] from rows:
    rows = [["fresh-" + str(1)], ["kept-" + str(2)]]
    return rows[0:1]


public func test_mut_slice_results_retain_the_final_written_owner() -> bool:
    mut text = "old-" + str(1)
    mut octets = b"old" + b"!"
    mut rows = [["old-" + str(2)]]
    const text_view = replace_text(mut text)
    const bytes_view = replace_bytes(mut octets)
    const rows_view = replace_rows(mut rows)
    assert text_view == "fresh" and text == "fresh-42"
    assert bytes_view == b"bcd" and octets == b"abcde!"
    assert len(rows_view) == 1 and rows_view[0][0] == "fresh-1" and rows[1][0] == "kept-2"
    text = "after"
    octets = b"after"
    rows = [["after"]]
    return text == "after" and octets == b"after" and rows[0][0] == "after"


public func test_copy_of_a_borrowed_result_owns_the_underlying_value() -> bool:
    mut text = "abcde-" + str(1)
    mut octets = b"abcde" + b"!"
    mut rows = [["zero"], ["one-" + str(1)], ["two-" + str(2)]]
    const text_copy = copy(text_part(text))
    const bytes_copy = copy(bytes_part(octets))
    const rows_copy = copy(rows_part(rows))
    text = "changed"
    octets = b"changed"
    rows = [["changed"]]
    return text_copy == "bcd" and bytes_copy == b"bcd" and rows_copy[0][0] == "one-1" and rows_copy[1][0] == "two-2"


