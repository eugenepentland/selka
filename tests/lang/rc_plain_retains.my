record PlainSample:
    count: int
    ratio: float
    enabled: bool


public func test_plain_appends_keep_mixed_bits_after_growth() -> bool:
    mut values: PlainSample[] = []
    for i in range(40):
        values.append(PlainSample(count=i, ratio=float(i) + 0.5, enabled=i % 2 == 0))
    return values[0].count == 0 and values[39].ratio == 39.5 and values[38].enabled and not values[39].enabled


public func test_append_of_an_existing_element_survives_backing_growth() -> bool:
    mut values = [PlainSample(count=7, ratio=1.5, enabled=True)]
    for i in range(80):
        values.append(values[0])
    values[0].count = 99
    return values[80].count == 7 and values[80].ratio == 1.5 and values[80].enabled


public func test_plain_array_append_uses_the_older_receivers_region() -> bool:
    mut values: FixedArray[int, 3][] = []
    for i in range(40):
        mut row: FixedArray[int, 3] = FixedArray[int, 3]([i, i + 1, i + 2])
        values.append(row)
    return len(values) == 40 and values[39][0] == 39 and values[39][2] == 41


public func test_zero_sized_array_appends_keep_logical_length() -> bool:
    mut values: FixedArray[int, 0][] = []
    mut row: FixedArray[int, 0] = FixedArray[int, 0]([])
    for i in range(40):
        values.append(row)
    return len(values) == 40 and len(values[39]) == 0


func main() -> int:
    assert test_plain_appends_keep_mixed_bits_after_growth()
    assert test_append_of_an_existing_element_survives_backing_growth()
    assert test_plain_array_append_uses_the_older_receivers_region()
    assert test_zero_sized_array_appends_keep_logical_length()
    return 0
