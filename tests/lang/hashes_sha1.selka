# SHA-1 (`hashes.sha1` and `hashes.sha1_bytes`, lane FR7): the FIPS 180 vectors, a borrowed view, and the WebSocket
# handshake of RFC 6455 section 1.3. A million `a`, and every length from 0 to 130 against Zig's `std.crypto.hash.Sha1`,
# are checked by `src/stdlib_hashes_test.zig`, whose program has no step budget.
import base64
import hashes
import hex
import strings

public func test_the_empty_input() -> bool:
    return hashes.sha1(b"") == "da39a3ee5e6b4b0d3255bfef95601890afd80709"


public func test_abc() -> bool:
    return hashes.sha1(b"abc") == "a9993e364706816aba3e25717850c26c9cd0d89d"


public func test_the_two_block_message_of_fips_180() -> bool:
    return hashes.sha1(b"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq") == "84983e441c3bd26ebaae4aa1f95129e5e54670f1"


public func test_the_octets_are_the_digest_the_text_spells() -> bool:
    const octets = hashes.sha1_bytes(b"abc")
    return len(octets) == 20 and hex.encode(octets) == hashes.sha1(b"abc")


public func test_a_borrowed_view_hashes_its_own_octets() -> bool:
    const wide = b"xxabcxx"
    return hashes.sha1(wide[2:5]) == hashes.sha1(b"abc")


public func test_the_websocket_accept_value_of_rfc_6455() -> bool:
    const key = "dGhlIHNhbXBsZSBub25jZQ=="
    const accept = base64.b64encode(hashes.sha1_bytes(strings.encode((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"))))
    return accept == b"s3pPLMBiTxaQ9kYGzzhZRbK+xOo="
