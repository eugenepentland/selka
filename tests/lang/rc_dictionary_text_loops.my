# RC-DICTIONARY-TEXT-LOOP-1: owning slice keys keep their ordinary journals.
def frequencies(seq: str, width: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for i in range(len(seq) - width + 1):
        key = seq[i:i + width]
        counts[key] = counts.get(key, 0) + 1
    return counts

def published(seq: str) -> dict[str, int]:
    counts: dict[str, int] = {}
    before = counts
    for i in range(len(seq)):
        key = seq[i:i + 1]
        counts[key] = counts.get(key, 0) + 1
    if len(before) != 0:
        counts["bad"] = 1
    return counts

def exposed(seq: str) -> dict[str, int]:
    counts: dict[str, int] = {}
    for i in range(len(seq)):
        before = counts
        key = seq[i:i + 1]
        counts[key] = counts.get(key, 0) + 1
        if before.get(key, 0) + 1 != counts[key]:
            counts["bad"] = 1
    return counts

# spec-case: RC-DICTIONARY-TEXT-LOOP-1
public def test_owned_text_keys_preserve_growth_and_empty_loop() -> bool:
    empty = frequencies("", 1)
    counts = frequencies("abcabcabc", 2)
    return len(empty) == 0 and counts["ab"] == 3 and counts["bc"] == 3 and counts["ca"] == 2

# spec-case: RC-DICTIONARY-TEXT-LOOP-1
public def test_owned_text_keys_in_arena() -> bool:
    with arena():
        counts = frequencies("éaéaé", 2)
        return counts["éa"] == 2 and counts["aé"] == 2

# spec-case: RC-DICTIONARY-TEXT-LOOP-1
public def test_published_dictionary_keeps_copy_on_write() -> bool:
    first = published("abcabc")
    second = exposed("abcabc")
    return first["a"] == 2 and second["b"] == 2 and first.get("bad", 0) == 0 and second.get("bad", 0) == 0
