# spec-case: RC-PLAIN-LIST-WRITE-1
public def test_scalar_element_widths_and_negative_indices_preserve_snapshots() -> bool:
    small: list[u8] = [u8(1), u8(2), u8(3)]
    before = small
    small[-2] = u8(255)
    flags = [True, False, True]
    flags[-1] = False
    numbers = [1.5, 2.5]
    saved = numbers
    numbers[-1] = numbers[0] + 2.0
    return small == [u8(1), u8(255), u8(3)] and before == [u8(1), u8(2), u8(3)] and flags == [True, False, False] and numbers == [1.5, 3.5] and saved == [1.5, 2.5]


# spec-case: RC-PLAIN-LIST-WRITE-1
public def test_managed_element_replacement_retains_independent_children() -> bool:
    row = [1]
    rows = [[0], [2]]
    before = rows
    rows[-1] = row
    row.append(3)
    rows[-1].append(4)
    return row == [1, 3] and rows == [[0], [1, 4]] and before == [[0], [2]]


def main() -> int:
    assert test_scalar_element_widths_and_negative_indices_preserve_snapshots()
    assert test_managed_element_replacement_retains_independent_children()
    return 0
