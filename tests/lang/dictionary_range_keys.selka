import dicts
import strings

func former_bound(length: int, bound: int) -> int:
    if bound < 0:
        return max(length + bound, 0)
    return bound


# A slice read only as the key of a `str`-keyed dictionary is described rather
# than built (SPEC.md DICT-RANGE-KEY-1..2). None of that is observable: every
# answer below is compared with the same work done on slices that are built,
# because each one also has another reader (`built` returns it). This module
# opens no arena, so the lowering applies to every function in it. The runner
# collects at every allocation (`--gc-stress`), so each key a write inserts is
# read back after many collections of the text it was cut from.
# The slice itself, as a value with a reader other than a dictionary: the
# reference spelling every described key is checked against.
func built(text: str, start: int, stop: int) -> str from text:
    return strings.char_slice(text, former_bound(strings.char_count(text), start), former_bound(strings.char_count(text), stop))


func dna(length: int) -> str:
    mut bases = "ACGT"
    mut parts: str[] = []
    mut seed = 42
    for _ in range(length):
        seed = (seed * 3877 + 29573) % 139968
        append(mut parts, strings.char_at(bases, seed * 4 // 139968))
    return strings.join(parts, "")


func described_counts(seq: str, k: int) -> dict[str, int]:
    mut counts: dict[str, int] = {}
    for i in range(strings.char_count(seq) - k + 1):
        mut key = copy(strings.char_slice(seq, i, i + k))
        counts[own key] = dicts.get(counts, key, 0) + 1
    return counts


func built_counts(seq: str, k: int) -> dict[str, int]:
    mut counts: dict[str, int] = {}
    for i in range(strings.char_count(seq) - k + 1):
        mut key = copy(built(seq, i, i + k))
        counts[own key] = dicts.get(counts, key, 0) + 1
    return counts


func augmented_counts(seq: str, k: int) -> dict[str, int]:
    mut counts: dict[str, int] = {}
    for i in range(strings.char_count(seq) - k + 1):
        if strings.char_slice(seq, i, i + k) in counts:
            counts[copy(strings.char_slice(seq, i, i + k))] += 1
        else:
            counts[copy(strings.char_slice(seq, i, i + k))] = 1
    return counts


func same_counts(left: dict[str, int], right: dict[str, int]) -> bool:
    if len(left) != len(right):
        return False
    mut left_keys = list(dicts.keys(left))
    mut right_keys = list(dicts.keys(right))
    for index in range(len(left_keys)):
        if left_keys[index] != right_keys[index] or left[left_keys[index]] != right[right_keys[index]]:
            return False
    return True


func churn(rounds: int) -> int:
    mut total = 0
    for index in range(rounds):
        total += strings.char_count(f"garbage {index} {index * 7}")
    return total


public func test_counting_by_described_slices_matches_counting_by_built_ones() -> bool:
    mut seq = dna(600)
    mut ok = True
    for k in [1, 2, 7, 18]:
        mut reference = built_counts(seq, k)
        ok = ok and same_counts(described_counts(seq, k), reference)
        ok = ok and same_counts(augmented_counts(seq, k), reference)
    return ok


public func test_every_key_spelling_answers_as_the_built_slice() -> bool:
    mut s = "abcdef"
    mut d: dict[str, int] = {"bc": 1, "ab": 2, "cd": 3, "bcd": 4}
    mut total = d[strings.char_slice(s, 1, 3)] + dicts.get(d, strings.char_slice(s, 0, 2), 50) + dicts.get(d, strings.char_slice(s, 3, 5), 60)
    mut ok = total == 1 + 2 + 60
    ok = ok and strings.char_slice(s, 2, 4) in d and not (strings.char_slice(s, 3, 5) in d) and strings.char_slice(s, 3, 5) not in d
    d[copy(strings.char_slice(s, 0, 3))] = dicts.get(d, strings.char_slice(s, 0, 3), 0) + 1
    d[copy(strings.char_slice(s, 1, 4))] += 2
    d[copy(strings.char_slice(s, 2, 5))] = 7
    mut key = copy(strings.char_slice(s, 0, 2))
    d[key] += 10
    ok = ok and d["abc"] == 1 and d["bcd"] == 6 and d["cde"] == 7 and d["ab"] == 12
    mut order = list(dicts.keys(d))
    return ok and len(order) == 6 and order[4] == "abc" and order[5] == "cde"


public func test_described_slices_clamp_and_count_like_built_ones() -> bool:
    mut s = "héllo wörld €uro"
    mut d: dict[str, int] = {}
    mut starts: int[] = [0 - 20, 0 - 5, 0 - 1, 0, 1, 2, 5, 15, 16, 30]
    for a in starts:
        for b in starts:
            d[copy(strings.char_slice(s, former_bound(strings.char_count(s), a), former_bound(strings.char_count(s), b)))] = dicts.get(d, strings.char_slice(s, former_bound(strings.char_count(s), a), former_bound(strings.char_count(s), b)), 0) + 1
    mut reference: dict[str, int] = {}
    for a in starts:
        for b in starts:
            mut piece = copy(built(s, a, b))
            reference[own piece] = dicts.get(reference, piece, 0) + 1
    mut ok = same_counts(d, reference) and d[""] == reference[""]
    ok = ok and d[strings.char_slice(s, 1, 2)] == reference["é"] and d[strings.char_slice(s, 15, 16)] == reference["o"]
    return ok and strings.char_slice(s, 12, 13) not in d and dicts.get(d, strings.char_slice(s, 12, 13), 0) == 0 and d[strings.char_slice(s, 5, 15)] == reference[" wörld €ur"]


public func test_inserted_keys_outlive_the_text_they_were_cut_from() -> bool:
    mut counts = described_counts(dna(3000) + "ÅÅÅ", 3)
    _ = churn(2000)
    mut reference = built_counts(dna(3000) + "ÅÅÅ", 3)
    mut keys = sorted(list(dicts.keys(counts)))
    mut ok = same_counts(counts, reference) and keys[len(keys) - 1] == "ÅÅÅ"
    ok = ok and strings.char_count(keys[len(keys) - 1]) == 3 and counts["ÅÅÅ"] == 1 and dicts.get(counts, "TÅÅ", 0) + dicts.get(counts, "GÅÅ", 0) + dicts.get(counts, "CÅÅ", 0) + dicts.get(counts, "AÅÅ", 0) == 1
    mut long_keys = described_counts(dna(400), 200)
    return ok and len(long_keys) == 201 and strings.char_count(list(dicts.keys(long_keys))[0]) == 200


public func test_described_and_owned_keys_hash_and_compare_alike() -> bool:
    mut text = "the quick brown fox jumps over the lazy dog"
    mut d: dict[str, int] = {"quick": 1, "the lazy dog": 2, "": 3, "x": 4}
    mut ok = d[strings.char_slice(text, 4, 9)] == 1 and d[strings.char_slice(text, 31, 43)] == 2 and d[strings.char_slice(text, 5, 5)] == 3
    ok = ok and strings.char_slice(text, 16, 19) not in d and dicts.get(d, strings.char_slice(text, 16, 19), 9) == 9
    d[copy(strings.char_slice(text, 16, 19))] = 5
    return ok and d["fox"] == 5 and "fox" in d and d[built(text, 16, 19)] == 5


# spec: DICT-RANGE-KEY-2
public func test_a_recorded_absence_never_hides_a_key_written_since() -> bool:
    mut s = "abcabc"
    mut d: dict[str, int] = {"abcabc": 1}
    mut key = copy(strings.char_slice(s, 0, 2))
    mut missed = dicts.get(d, key, 0)
    d["ab"] = 5
    d[own key] = dicts.get(d, key, 0) + 1
    mut ok = missed == 0 and d["ab"] == 6
    mut other = copy(strings.char_slice(s, 3, 5))
    ok = ok and dicts.get(d, strings.char_slice(s, 1, 3), 0) == 0 and d[other] == 6
    mut whole = copy(strings.char_slice(s, 0, 6))
    ok = ok and dicts.get(d, strings.char_slice(s, 0, 3), 0) == 0 and s in d and d[whole] == 1
    mut gone = dicts.get(d, strings.char_slice(s, 2, 4), 0)
    _ = churn(500)
    d[copy(strings.char_slice(s, 2, 4))] = gone + 3
    return ok and d["ca"] == 3 and len(d) == 3


# spec-case: DICT-RANGE-KEY-2
public func test_an_absence_is_not_believed_across_a_pop_or_clear() -> bool:
    mut s = "xyzxyz"
    mut d: dict[str, int] = {"xy": 1, "yz": 2}
    mut miss = dicts.get(d, strings.char_slice(s, 2, 4), 0)
    mut popped = dicts.pop(mut d, "xy")
    d[copy(strings.char_slice(s, 2, 4))] = 7
    mut ok = miss == 0 and popped == 1 and d["zx"] == 7 and strings.char_slice(s, 0, 2) not in d
    dicts.clear(mut d)
    ok = ok and dicts.get(d, strings.char_slice(s, 0, 2), 0) == 0
    d[copy(strings.char_slice(s, 0, 2))] = 8
    return ok and d["xy"] == 8 and len(d) == 1


public func test_a_slice_key_beside_negative_indices_answers_as_the_built_slice() -> bool:
    # A range-keyed lookup sits in the same function as reads that count from
    # the end of a list and of a fixed array (PY-ARRAY-NEGATIVE-1).
    mut s = "gattaca"
    mut names = ["ta", "ca"]
    mut marks: FixedArray[int, 3] = FixedArray[int, 3]([4, 5, 6])
    mut d: dict[str, int] = {"ta": 1, "ca": 2}
    d[copy(strings.char_slice(s, 3, 5))] += marks[len(marks) - 1]
    mut total = d[strings.char_slice(s, max(strings.char_count(s) - 2, 0), None)] + d[names[len(names) - 2]] + marks[len(marks) - 3]
    return d["ta"] == 7 and total == 2 + 7 + 4


func main() -> int:
    return 0
