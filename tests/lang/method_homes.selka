# Generated by experiments/audit-work-20261111/W13-S1/gen.py: every function home W13's first slice gave a
# method on text, bytes, a byte buffer or a set, against the answer that method gave when both spellings
# checked (recorded at main 8a72e05ab6, the last commit where slice 1's differential ran; W13-S5 refused the
# methods). Each test compares the home's answer as text; the generic tests call the home inside a generic
# function, and the ownership tests overwrite the receiver after the call and read the result after that.
import buffers
import bytes
import hashes
import hex
import sets
import strings

func buf(data: bytes) -> byte_buffer:
    mut out = buffers.empty()
    buffers.append(mut out, data)
    return out


func after_clear_function[T: equality](values: set[T]) -> set[T]:
    mut s = copy(values)
    sets.clear(mut s)
    return s


func after_remove_function[T: equality](values: set[T], value: T) -> int:
    mut s = copy(values)
    sets.remove(mut s, value)
    return len(s)


