module effects_case_2


record Box:
    values: list[int]


def write_text(pieces: mut list[str], box: Box) -> None:
    pieces.append("x")
    _ = box


def use(pieces: mut list[str], box: Box) -> None:
    write_text(mut pieces, box)


public def program() -> int:
    pieces: list[str] = []
    box = Box(values=[1])
    use(mut pieces, box)
    return 0
