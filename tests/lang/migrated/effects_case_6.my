module effects_case_6


def write_both(x: mut list[int], y: mut list[int]) -> None effects(mutation):
    x[0] = 1
    y[0] = 2


def use(values: mut list[int]) -> None effects(mutation):
    write_both(mut values, mut values)


public def program() -> int:
    values = [0, 0]
    use(mut values)
    return values[0] + values[1] - 3
