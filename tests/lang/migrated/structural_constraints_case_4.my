

type Reader = func(int) -> int effects()
constraint A[P] = copy + op(make(p: P, callback: func(FixedArray[P, 2]) -> P[] effects()) -> func(P) -> P effects(output) effects())
constraint B[Q] = copy + op(make(p: Q, callback: func(FixedArray[Q, 2]) -> Q[] effects()) -> func(Q) -> Q effects(output) effects())
constraint C[T] = copy + op(read(p: T, reader: Reader) -> int effects())
constraint D[T] = copy + op(read(p: T, reader: func(int) -> int effects()) -> int effects())
func unused[T: A + B + op(make(p: T, callback: func(FixedArray[T, 2]) -> T[] effects()) -> func(T) -> T effects(output) effects())](p: T) -> int:
    return 0
func concrete[T: C + D](p: T) -> int:
    return 0
public func program() -> int:
    return 0
