module managed_cell_case_2


def push(cell: mut Cell[list[int]]) -> None effects(mutation, managed_allocation):
    cell.value.append(7)


public def program() -> int:
    cell = Cell[int](value=1)
    alias = cell
    alias.value = 6
    if cell.value != 6:
        return 1
    values = Cell(value=[1, 2])
    push(values)
    return values.value[2]
