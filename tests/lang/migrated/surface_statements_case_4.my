module surface_statements_case_4


result R:
    ok: i64,
    err: i64


def first() -> R:
    return Ok(41)


def next() -> R:
    n = first()?
    return Ok(n + 1)


public def program() -> i64:
    match next():
        case R.ok(n):
            return n
        case R.err(e):
            return e
