func label(count: int, items: int[]) -> str:
    return f"total {count} of {len(items)} items"


public func program() -> int:
    mut score = 0
    if label(7, [1, 2, 3]) == "total 7 of 3 items":
        score = score + 1
    if f"{1 + 1}" == "2":
        score = score + 2
    if f"{True} {()} {1.5}" == "True None 1.5":
        score = score + 4
    mut name = "x"
    if f"a\t{name.copy()}b" == "a\tx" + "b":
        score = score + 8
    if f"{f'{name}'}" == "x":
        score = score + 16
    return score
