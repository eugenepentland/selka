func mixed_text() -> str:
    return mixed_text_1() + mixed_text_2()


func parsed_rows(text: str) -> str[][]:
    match csv.parse(text):
        case Ok(rows):
            return rows
        case Err(error):
            return [["parse refused: " + csv.message(error)]]


func field_texts(text: str) -> str[][]:
    mut out: str[][] = []
    match csv.parse_fields(text):
        case Ok(rows):
            for row in rows:
                mut texts: str[] = []
                for field in row:
                    append(mut texts, copy(field.text))
                append(mut out, own texts)
        case Err(error):
            append(mut out, ["parse_fields refused: " + csv.message(error)])
    return out


func field_flags(text: str) -> str[]:
    mut out: str[] = []
    match csv.parse_fields(text):
        case Ok(rows):
            for row in rows:
                mut line = ""
                for field in row:
                    if field.quoted:
                        line += "1"
                    else:
                        line += "0"
                append(mut out, own line)
        case Err(error):
            append(mut out, "parse_fields refused: " + csv.message(error))
    return out


public func test_parse_reads_the_text_python_writes() -> bool:
    return parsed_rows(python_text()) == vector_rows()


public func test_write_renders_what_python_writes() -> bool:
    return csv.write(vector_rows()) == python_text()


public func test_parse_reads_mixed_quoting_and_line_endings() -> bool:
    return parsed_rows(mixed_text()) == vector_rows()


public func test_parse_fields_keeps_the_texts_of_both_documents() -> bool:
    return field_texts(python_text()) == vector_rows() and field_texts(mixed_text()) == vector_rows()


public func test_parse_fields_marks_the_fields_python_quotes() -> bool:
    return field_flags(python_text()) == python_quoted()


public func test_parse_fields_marks_the_fields_of_mixed_quoting() -> bool:
    return field_flags(mixed_text()) == mixed_quoted()


func count_blank(rows: str[][]) -> int:
    mut count = 0
    for row in rows:
        if len(row) == 0:
            count += 1
    return count


func count_lone_empty(rows: str[][]) -> int:
    mut count = 0
    for row in rows:
        if len(row) == 1 and row[0] == "":
            count += 1
    return count


func count_multiline(rows: str[][]) -> int:
    mut count = 0
    for row in rows:
        for field in row:
            if "\n" in field:
                count += 1
    return count


# The 200 rows are not all alike: some are blank, some a lone empty field, some hold a line break, and the two
# documents differ in which fields are quoted.
public func test_the_vectors_cover_the_cases() -> bool:
    const rows = vector_rows()
    const mixed = count_blank(rows) > 0 and count_lone_empty(rows) > 0 and count_multiline(rows) > 0
    return len(rows) == 200 and mixed and python_quoted() != mixed_quoted()
