func vector_rows() -> str[][]:
    mut all: str[][] = []
    lists.extend(mut all, vector_rows_1())
    lists.extend(mut all, vector_rows_2())
    lists.extend(mut all, vector_rows_3())
    lists.extend(mut all, vector_rows_4())
    lists.extend(mut all, vector_rows_5())
    return all


