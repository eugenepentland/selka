# A generic body checks an f-string's literal pieces as text, not as expressions.
# Before the fix, the literal `\u` was read as a type name, which failed to lex in a
# module that imports anything, and the failure left no diagnostic: `check` exited 1
# with no output.
import lists

func piece[S: copy](value: S, code: int) -> str:
    _ = value
    return f"\\u{code:04x}"


public func test_generic_fstring_literal_text_checks_as_text_in_an_importing_module() -> bool:
    return piece(0, 65) == "\\u0041" and lists.contains([1, 2], 2)
