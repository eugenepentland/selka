func ledger_compact() -> str[]:
    mut all: str[] = []
    lists.extend(mut all, ledger_compact_1())
    lists.extend(mut all, ledger_compact_2())
    lists.extend(mut all, ledger_compact_3())
    lists.extend(mut all, ledger_compact_4())
    lists.extend(mut all, ledger_compact_5())
    return all


func reading_mismatches(texts: str[]) -> int:
    const values = readings()
    mut wrong = 0
    for index in range(len(values)):
        const want = values[index]
        const got = json.decode[Reading](texts[index]) else Err(_):
            wrong += 1
            continue
        if got != want:
            wrong += 1
    return wrong


func ledger_mismatches(texts: str[]) -> int:
    const values = ledgers()
    mut wrong = 0
    for index in range(len(values)):
        const want = values[index]
        const got = json.decode[Ledger](texts[index]) else Err(_):
            wrong += 1
            continue
        if got != want:
            wrong += 1
    return wrong


public func test_decode_reads_what_python_writes() -> bool:
    return len(readings()) == 150 and reading_mismatches(reading_foreign()) == 0 and ledger_mismatches(ledger_foreign()) == 0


public func test_decode_reads_the_compact_texts_too() -> bool:
    return reading_mismatches(reading_compact()) == 0 and ledger_mismatches(ledger_compact()) == 0


func encode_mismatches() -> int:
    const values = readings()
    const texts = reading_compact()
    mut wrong = 0
    for index in range(len(values)):
        const text = json.encode(values[index]) else Err(_):
            wrong += 1
            continue
        if text != texts[index]:
            wrong += 1
    const books = ledgers()
    const book_texts = ledger_compact()
    for index in range(len(books)):
        const text = json.encode(books[index]) else Err(_):
            wrong += 1
            continue
        if text != book_texts[index]:
            wrong += 1
    return wrong


public func test_encode_writes_what_python_writes() -> bool:
    return encode_mismatches() == 0


func power_mismatches() -> int:
    const values = power_values()
    const texts = power_texts()
    mut wrong = 0
    for index in range(len(values)):
        const text = json.encode(values[index]) else Err(_):
            wrong += 1
            continue
        const back = json.decode[float](texts[index]) else Err(_):
            wrong += 1
            continue
        if text != texts[index] or back != values[index]:
            wrong += 1
    return wrong


public func test_powers_of_two_and_their_neighbours_are_spelled_as_python_spells_them() -> bool:
    return len(power_values()) > 600 and power_mismatches() == 0
