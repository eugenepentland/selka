# json.decode and json.encode against the system's Python `json` module (Python 3.14.4, seed 20261118): 150 values of each of two
# record shapes. `reading_foreign` and `ledger_foreign` are the texts Python's json.dumps writes for each value with its
# members shuffled, random indentation and separators, and ASCII escapes or raw UTF-8 at random; json.decode must read each
# to the value. `reading_compact` and `ledger_compact` are what json.dumps writes with separators (",", ":"),
# ensure_ascii=False and the members in declaration order; json.encode must write exactly that. `power_values` are powers
# of two from 2^-1074 to 2^1023 and their neighbours, with Python's `repr` in `power_texts`. Made by
# make_vectors.py in the lane's scratch folder; each function holds at most 30 values.
import json
import lists

enum Level:
    low
    mid
    high


record Reading:
    id: u32
    delta: i16
    total: i64
    big: u64
    ok: bool
    ratio: float
    name: str
    note: str?
    level: Level
    samples: int[]


enum Entry:
    credit(amount: int, memo: str)
    debit(amount: int)
    void


record Line:
    account: str
    entry: Entry
    tags: str[]
    weight: float?


record Ledger:
    title: str
    lines: Line[]
    matrix: int[][]
    flags: bool[]
    owner: str?


