func ledgers() -> Ledger[]:
    mut all: Ledger[] = []
    lists.extend(mut all, ledgers_1())
    lists.extend(mut all, ledgers_2())
    lists.extend(mut all, ledgers_3())
    lists.extend(mut all, ledgers_4())
    lists.extend(mut all, ledgers_5())
    return all


