# Static UTF-8 literal data carries precomputed, read-only position samples.
const TEXT: str = """abcdefghijklmnoé😀pqrstuvwxyz012345
abcdefghijklmnoé😀pqrstuvwxyz012345
abcdefghijklmnoé😀pqrstuvwxyz012345
abcdefghijklmnoé😀pqrstuvwxyz012345
abcdefghijklmnoé😀pqrstuvwxyz012345
abcdefghijklmnoé😀pqrstuvwxyz012345
abcdefghijklmnoé😀pqrstuvwxyz012345
abcdefghijklmnoé😀pqrstuvwxyz012345
abcdefghijklmnoé😀pqrstuvwxyz012345
abcdefghijklmnoé😀pqrstuvwxyz012345
abcdefghijklmnoé😀pqrstuvwxyz012345
abcdefghijklmnoé😀pqrstuvwxyz012345
abcdefghijklmnoé😀pqrstuvwxyz012345
abcdefghijklmnoé😀pqrstuvwxyz012345
abcdefghijklmnoé😀pqrstuvwxyz012345
abcdefghijklmnoé😀pqrstuvwxyz012345
abcdefghijklmnoé😀pqrstuvwxyz012345
abcdefghijklmnoé😀pqrstuvwxyz012345
abcdefghijklmnoé😀pqrstuvwxyz012345
abcdefghijklmnoé😀pqrstuvwxyz012345"""


# spec-case: TEXT-INDEX-4
public def test_literal_indexes_in_both_directions_and_ranges() -> bool:
    line = "abcdefghijklmnoé😀pqrstuvwxyz012345"
    ok = len(TEXT) == 699
    for index in range(len(TEXT)):
        column = index % 35
        expected = "\n"
        if column < 34:
            expected = line[column]
        ok = ok and TEXT[index] == expected and TEXT[index - len(TEXT)] == expected
    ok = ok and TEXT.find("é", 100, 300) == 120 and TEXT.rfind("é", 100, 300) == 295
    return ok and TEXT.count("é", 100, 300) == 6 and TEXT[128] == line[23]


# spec-case: TEXT-INDEX-4
# spec-case: TEXT-VIEW-5
public def test_literal_indexed_views_and_arena_escape() -> bool:
    tail = TEXT[530:]
    nested = tail[25:]
    ok = len(tail) == 169 and len(nested) == 144 and nested == TEXT[555:699]
    escaped = ""
    with arena() as scratch:
        inside = TEXT[-11:]
        escaped = scratch.escape(inside[2:])
    return ok and escaped == "xyz012345" and repr(escaped) == "'xyz012345'"


def main() -> int:
    return 0
