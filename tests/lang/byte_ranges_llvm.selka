func parse_ranges(raw: bytes) -> bool noalloc:
    match raw.parse_int_range(2, 4):
        case Some(value):
            if value != 42:
                return False
        case None:
            return False
    match raw.parse_float_range(5, 8):
        case Some(value):
            if value != 2.5:
                return False
        case None:
            return False
    match raw.parse_int_range(8, 2):
        case Some(_):
            return False
        case None:
            pass
    return True


func main() -> int:
    if not parse_ranges(b"xx42=2.5abc"):
        return 1
    match b"x-9223372036854775808y".parse_int_range(1, 21):
        case Some(value):
            if value != -9223372036854775808:
                return 6
        case None:
            return 7
    match b"x9223372036854775808y".parse_int_range(1, 20):
        case Some(_):
            return 8
        case None:
            pass
    match b"a\xce\xbbb\xf0\x9f\x98\x80c".scalar_count_range(1, 8):
        case Ok(width):
            if width != 3:
                return 2
        case Err(_):
            return 3
    match b"a\xffb".scalar_count_range(1, 2):
        case Ok(_):
            return 4
        case Err(message):
            if message != "invalid UTF-8 in byte string":
                return 5
    return 0


# spec-case: PY-BYTES-RANGE-1
public func test_native_byte_range_boundaries_and_scalar_counts() -> bool:
    return main() == 0
