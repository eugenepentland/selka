public def test_room_and_growth_preserve_every_scalar_width() -> bool:
    small: list[u8] = []
    medium: list[u16] = []
    wide: list[i32] = []
    flags: list[bool] = []
    numbers: list[float] = []
    for index in range(65):
        small.append(u8(index))
        medium.append(u16(index + 256))
        wide.append(i32(index - 256))
        flags.append(index % 2 == 0)
        numbers.append(float(index) + 0.5)
    return len(small) == 65 and small[64] == u8(64) and medium[64] == u16(320) and wide[64] == i32(-192) and flags[64] and not flags[63] and numbers[64] == 64.5


public def test_aliasing_reads_and_named_snapshots_survive_growth() -> bool:
    items = [7]
    saved = items
    for index in range(80):
        items.append(items[-1] + 1)
    return saved == [7] and len(items) == 81 and items[80] == 87


def callback(items: mut list[int]) -> int:
    items.clear()
    items.append(9)
    return 7


public def test_callback_changes_receiver_before_append_publication() -> bool:
    items = [1]
    saved = items
    mutation_result_36 = callback(mut items)
    items.append(mutation_result_36)
    return items == [9, 7] and saved == [1]


def grow(items: mut list[int]) -> unit:
    for index in range(40):
        items.append(index)


public def test_plain_and_managed_elements_preserve_snapshots() -> bool:
    row = [7]
    rows: list[list[int]] = []
    pairs: list[tuple[int, int]] = []
    for index in range(9):
        rows.append(row)
        pairs.append((index, index + 1))
    row.append(8)
    rows[0].append(9)
    return rows[0] == [7, 9] and rows[8] == [7] and row == [7, 8] and pairs[8] == (8, 9)


def main() -> int:
    assert test_room_and_growth_preserve_every_scalar_width()
    assert test_aliasing_reads_and_named_snapshots_survive_growth()
    assert test_callback_changes_receiver_before_append_publication()
    assert test_plain_and_managed_elements_preserve_snapshots()
    return 0


union PlainValue:
    integer: int,
    boolean: bool


def plain_score(value: PlainValue) -> int:
    match value:
        case PlainValue.integer(n):
            return n
        case PlainValue.boolean(flag):
            return 1 if flag else 0


public def test_plain_variant_stack_room_growth_and_shared_snapshot() -> bool:
    values: list[PlainValue] = []
    for index in range(65):
        values.append(PlainValue.integer(index))
    saved = values
    for _ in range(64):
        old = values.pop()
        values.append(PlainValue.boolean(plain_score(old) % 2 == 0))
    return len(values) == 65 and plain_score(saved[-1]) == 64 and plain_score(values[-1]) == 0


public def test_plain_tuple_append_reads_same_backing_across_growth() -> bool:
    pairs = [(3, 4)]
    saved = pairs
    for _ in range(129):
        pairs.append(pairs[0])
    return len(pairs) == 130 and pairs[-1] == (3, 4) and saved == [(3, 4)]


public def test_plain_tail_removal_clears_and_reuses_every_slot() -> bool:
    items: list[tuple[int, bool]] = []
    for index in range(129):
        items.append((index, index % 2 == 0))
    total = 0
    for index in range(129):
        value = items.pop()
        assert value == (128 - index, index % 2 == 0)
        head, _ = value
        total += head
    items.append((999, True))
    return total == 8256 and items.pop() == (999, True) and len(items) == 0
