

func float_add(x: float, y: float) -> float:
    return x + y


func operand(mut log: int[], value: int) -> float:
    log.append(value)
    return float(value)


func receiver(mut log: int[], values: int[]) -> int[]:
    log.append(2)
    return values


func log_index(mut log: int[]) -> int:
    log.append(3)
    return 0


func emit_value(mut log: int[]) -> int:
    log.append(1)
    return 42


enum Kind:
    atom
    group


func length(text: str = "é", scale: float = 2.5) -> int:
    return len(text) + int(scale)


func adjust[T](unused: T, value: float) -> float:
    _ = unused
    return value + 1.5


func present[T](value: T) -> T?:
    return Some(value)


func absent[T](value: T) -> T?:
    _ = value
    return None


func double(value: int) -> int:
    return value * 2


func apply(f: func(int) -> int, x: int) -> int:
    return f(x)


record Score:
    name: str
    points: int


func score(item: Score) -> int:
    return item.points


record Counter:
    n: int


record Pair:
    n: int


func bump(counter: Counter) -> Counter:
    mut changed = counter
    changed.n = changed.n + 1
    return changed


# spec: PYTHON-CORE-4
public func test_floating_literals_operators_and_comparisons_use_numeric_binary64_semantics() -> bool:
    mut value = float_add(1.5, 2.5) * 10.0 + 2.0
    if value != 42.0:
        return False
    mut zero = -0.0
    mut nan = divtrunc(0.0, 0.0)
    if zero != 0.0:
        return False
    if nan == nan:
        return False
    if not (nan != nan):
        return False
    return True


# spec-case: PYTHON-CORE-4
public func test_floating_comparisons_and_remainder_preserve_operand_evaluation_once_in_source_order() -> bool:
    mut log: int[] = []
    if operand(mut log, 5) > operand(mut log, 2):
        mut value = operand(mut log, 7) % operand(mut log, 3)
        if value != 1.0:
            return False
    if len(log) != 4:
        return False
    return log[0] + log[1] + log[2] + log[3] + 25 == 42


# spec-case: PY-COLLECTIONS-1
public func test_python_indexed_assignment_evaluates_rhs_before_receiver_and_index_exactly_once() -> bool:
    mut log: int[] = []
    mut values = [0]
    mut next_value = emit_value(mut log)
    mut target = receiver(mut log, values)
    mut position = log_index(mut log)
    target[position] = next_value
    values = target
    if len(log) != 3 or values[0] != 42:
        return False
    return log[0] * 100 + log[1] * 10 + log[2] == 123


# spec-case: PYTHON-3
public func test_python_payloadless_enum_values_use_ordinary_dotted_members() -> bool:
    mut kind = Kind.atom
    return kind == Kind.atom


# spec-case: PYTHON-CALL-1
public func test_python_string_and_float_defaults_remain_typed_and_independent_across_repeated_calls() -> bool:
    return length() + length() + length(scale=33.5) == 40


# spec-case: PYTHON-CORE-4
public func test_python_division_remainder_numeric_conversions_and_generic_numbers() -> bool:
    if 5 / 2 != 2.5:
        return False
    if -5 // 2 != -3 or -5 % 2 != 1:
        return False
    if 5 // -2 != -3 or 5 % -2 != -1:
        return False
    if -5.0 // 2.0 != -3.0 or -5.0 % 2.0 != 1.0:
        return False
    if int(float(-2) + 4.4e1) != 42:
        return False
    return int(adjust(0, 40.5)) == 42


# spec-case: PYTHON-CORE-1
public func test_python_contextual_option_constructors_work_in_generic_functions() -> bool:
    mut empty: int? = absent(0)
    _ = empty
    match present(42):
        case Some(value):
            return value == 42
        case None:
            return False


# spec: CALLBACK-EFFECTS-1
public func test_omitted_callback_ceilings_are_unbounded_and_unannotated_functions_fill_slots() -> bool:
    return apply(double, 21) == 42


# spec-case: CALLBACK-EFFECTS-1
public func test_unannotated_functions_fill_the_sorted_key_callback_slot() -> bool:
    mut items = [Score(name="a", points=3), Score(name="b", points=1)]
    mut ordered = sorted(items, key=score)
    return ordered[0].points * 42 == 42


# A record copy is independent of its source.
public func test_record_copies_are_independent() -> bool:
    mut a = Counter(n=1)
    mut b = a
    b.n = 7
    a = bump(a)
    mut pair = Pair(n=1)
    mut copy = pair
    copy.n = 9
    return a.n * 10 + pair.n == 21 and b.n == 7


func main() -> int:
    return 0
