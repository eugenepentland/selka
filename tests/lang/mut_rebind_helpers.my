module mut_rebind_helpers


public def replace_list(items: mut list[int]):
    items = [7]
    items.append(8)


public def replace_dict(items: mut dict[int, int]):
    items = {7: 7}
    items[8] = 8


public def replace_set(items: mut set[int]):
    items = {7}
    items.add(8)


public def append_only(items: mut list[int]):
    items.append(9)
