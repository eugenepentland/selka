module rc_counted_receivers

# Storing or appending a counted element through a list held by a stable
# owner needs no receiver scope under RC when the element type cannot reach
# the list's own type (RC-INERT-COUNTED-RECEIVER-1). Every test also runs
# under GC and `--gc-stress`; the values must be plain value semantics.
union Tree:
    leaf,
    node: list[Tree]


record Table:
    rows: list[list[int]]
    names: list[str]
    trees: list[Tree]
    count: int


def fresh_table() -> Table:
    return Table([[1], [2, 3]], ["a"], [Tree.leaf], 0)


def store(table: mut Table, index: int, row: list[int]):
    table.rows[index] = row


def add(table: mut Table, row: list[int]):
    table.rows.append(row)


def rename(table: mut Table, name: str):
    table.names[0] = name


def copy_row(table: mut Table, to: int, from: int):
    table.rows[to] = table.rows[from]


def plant(table: mut Table, tree: Tree):
    table.trees[0] = tree


def size(tree: Tree) -> int:
    match tree:
        case Tree.leaf:
            return 1
        case Tree.node(children):
            total = 1
            for child in children:
                total += size(child)
            return total


public def test_stored_row_is_an_independent_value() -> bool:
    table = fresh_table()
    row = [7, 8]
    store(mut table, 0, row)
    row.append(9)
    table.rows[0].append(10)
    return row == [7, 8, 9] and table.rows[0] == [7, 8, 10] and table.rows[1] == [2, 3]


public def test_appended_rows_and_negative_indices() -> bool:
    table = fresh_table()
    i = 0
    while i < 20:
        add(mut table, [i])
        i += 1
    store(mut table, -1, [99])
    return len(table.rows) == 22 and table.rows[21] == [99] and table.rows[20] == [18]


public def test_row_read_before_the_store_keeps_its_value() -> bool:
    table = fresh_table()
    before = table.rows[1]
    store(mut table, 1, [4])
    return before == [2, 3] and table.rows == [[1], [4]]


public def test_row_copied_within_the_same_list_stays_independent() -> bool:
    table = fresh_table()
    copy_row(mut table, 0, 1)
    table.rows[0].append(4)
    return table.rows[0] == [2, 3, 4] and table.rows[1] == [2, 3]


public def test_string_elements_replace_in_place() -> bool:
    table = fresh_table()
    rename(mut table, "b")
    rename(mut table, "c")
    return table.names == ["c"]


public def test_recursive_elements_keep_the_scoped_store() -> bool:
    table = fresh_table()
    plant(mut table, Tree.node([Tree.leaf, Tree.node([Tree.leaf])]))
    return size(table.trees[0]) == 4
