module borrowed_roots

# A safepoint publishes no root for a value a published owner already reaches
# (`QBE-BORROW-ROOT-1`). Under `--gc-stress` every allocation collects, so a
# borrowed value whose owner stopped reaching it — and whose own root was
# wrongly dropped — would be read after the sweep freed it.


public class Node:
    items: list[int]
    next: Option[Node]


def fresh(n: int) -> list[int]:
    return [n, n + 1, n + 2]


# spec-case: QBE-BORROW-ROOT-1
public def test_a_loop_variable_survives_allocations_while_its_list_does() -> bool:
    rows = [fresh(0), fresh(10), fresh(20)]
    total = 0
    for row in rows:
        for i in range(5):
            scratch = fresh(i)
            total += row[1] + scratch[0]
    return total == 1 * 5 + 11 * 5 + 21 * 5 + 3 * 10


# spec-case: QBE-BORROW-ROOT-1
public def test_an_element_removed_from_its_list_keeps_its_own_root() -> bool:
    rows = [fresh(0), fresh(10)]
    row = rows[1]
    rows.clear()
    scratch = fresh(5)
    for i in range(20):
        scratch = fresh(i + 50)
    return row[2] == 12 and scratch[0] == 69 and len(rows) == 0


def drop_all(rows: mut list[list[int]]) -> int:
    rows.clear()
    return 0


# spec-case: QBE-BORROW-ROOT-1
public def test_an_element_a_callee_removes_keeps_its_own_root() -> bool:
    rows = [fresh(0), fresh(10)]
    row = rows[0]
    status = drop_all(mut rows)
    scratch = fresh(7)
    for i in range(20):
        scratch = fresh(i + 50)
    return row[1] == 1 and status == 0 and scratch[2] == 71


# spec-case: QBE-BORROW-ROOT-1
public def test_an_element_overwritten_in_its_list_keeps_its_own_root() -> bool:
    rows = [fresh(0), fresh(10)]
    row = rows[0]
    rows[0] = fresh(100)
    scratch = fresh(1)
    return row[0] == 0 and rows[0][0] == 100 and scratch[0] == 1


# spec-case: QBE-BORROW-ROOT-1
public def test_a_field_read_survives_while_the_instance_holds_it() -> bool:
    node = Node(items=fresh(3), next=None)
    items = node.items
    total = 0
    for i in range(10):
        scratch = fresh(i)
        total += items[0] + scratch[0]
    node.items = fresh(50)
    extra = fresh(2)
    return total == 30 + 45 and items[1] == 4 and node.items[0] == 50 and extra[0] == 2


# spec-case: QBE-BORROW-ROOT-1
public def test_a_dictionary_value_survives_until_it_is_replaced() -> bool:
    table = {"a": fresh(1), "b": fresh(2)}
    held = table["a"]
    scratch = fresh(9)
    table["a"] = fresh(40)
    after = fresh(8)
    return held[0] == 1 and table["a"][0] == 40 and scratch[0] == 9 and after[0] == 8


# spec-case: QBE-BORROW-ROOT-1
public def test_a_chain_of_borrows_survives_through_dead_owners() -> bool:
    grid = [[fresh(1), fresh(2)], [fresh(3)]]
    row = grid[0]
    cell = row[1]
    total = 0
    for i in range(6):
        scratch = fresh(i)
        total += cell[0] + scratch[0]
    return total == 12 + 15 and len(grid) == 2
