func select(cubes: int[][][], i: int, j: int, k: int, mut output: int[]) -> int:
    mut value = cubes[i][j][k]
    output.append(value)
    return value


public func test_nested_read_loans_follow_negative_indices_and_loop_roots() -> bool:
    mut output: int[] = []
    mut total = 0
    for index in range(20):
        mut cubes = [[[index, index + 1]], [[index + 2, index + 3]]]
        if index % 2 == 0:
            total += select(cubes, 0, 0, 0, mut output)
        else:
            total += select(cubes, -1, -1, -1, mut output)
    return total == 220 and len(output) == 20 and output[0] == 0 and output[-1] == 22


func replace_row(mut rows: int[][]) -> int:
    rows[0] = [91]
    return 0


public func test_nested_read_loans_keep_the_row_captured_before_a_callback() -> bool:
    mut rows = [[7, 8]]
    mut selected = rows[0][replace_row(mut rows)]
    return selected == 7 and rows == [[91]]


public func test_named_row_keeps_ownership_after_root_replacement() -> bool:
    mut rows = [[7, 8]]
    mut selected = rows[0]
    rows = [[91]]
    return selected[-1] == 8 and rows[0][0] == 91


public func test_nested_reads_preserve_mutating_receiver_snapshots() -> bool:
    mut rows = [[7, 8]]
    mut snapshot = rows
    rows[0].append(rows[0][0])
    return rows == [[7, 8, 7]] and snapshot == [[7, 8]]


public func test_nested_reads_leave_dictionary_and_view_roles_owned() -> bool:
    mut mapping = {0: [[7, 8]]}
    mut view = list(mapping.values())
    mut result = mapping[0][0][-1]
    mapping[0] = [[91]]
    mut total = 0
    for rows in view:
        total += rows[0][0]
    return result == 8 and total == 7


public func test_text_index_results_remain_fresh_owned_values() -> bool:
    mut words = ["αβγ", "abcdef"]
    mut total = 0
    for index in range(20):
        total += len(words[0][1]) + len(words[1][-1])
    return total == 40 and words == ["αβγ", "abcdef"]


func main() -> int:
    assert test_nested_read_loans_follow_negative_indices_and_loop_roots()
    assert test_nested_read_loans_keep_the_row_captured_before_a_callback()
    assert test_named_row_keeps_ownership_after_root_replacement()
    assert test_nested_reads_preserve_mutating_receiver_snapshots()
    assert test_nested_reads_leave_dictionary_and_view_roles_owned()
    assert test_text_index_results_remain_fresh_owned_values()
    return 0
