# A sort-key lambda's key type is its body's ordinary type (SPEC.md
# LAMBDA-KEY-INFER-1): a method call, a call to a declared function, a
# conversion, a slice, a conditional expression. Before, any body the key
# reader did not recognise was typed `int`, so a `str` or `float` key failed
# with "expected int, found str". Keys are built under `--gc-stress`, so the
# text keys must stay rooted while the sort allocates.
record Person:
    name: str
    score: int


func label(person: Person) -> str:
    return person.name + "!"


func people() -> Person[]:
    return [Person(name="Bob", score=2), Person(name="al", score=0 - 5), Person(name="Cy", score=1)]


func names(items: Person[]) -> str[]:
    return [for item in items yield item.name]


# spec: LAMBDA-KEY-INFER-1
public func test_a_method_call_body_gives_a_str_key() -> bool:
    return names(sorted(people(), key=lambda p: p.name.lower())) == ["al", "Bob", "Cy"]


# spec-case: LAMBDA-KEY-INFER-1
public func test_a_call_to_a_declared_function_gives_its_result_as_the_key() -> bool:
    return names(sorted(people(), key=lambda p: label(p))) == ["Bob", "Cy", "al"]


# spec-case: LAMBDA-KEY-INFER-1
public func test_a_conversion_and_float_arithmetic_give_a_float_key() -> bool:
    return names(sorted(people(), key=lambda p: float(p.score) / 2.0)) == ["al", "Cy", "Bob"]


# spec-case: LAMBDA-KEY-INFER-1
public func test_a_conditional_body_keeps_its_int_key() -> bool:
    return names(sorted(people(), key=lambda p: if (p.score > 0) then (p.score) else (0 - p.score))) == ["Cy", "Bob", "al"]


# spec-case: LAMBDA-KEY-INFER-1
public func test_a_slice_body_gives_a_str_key_to_an_in_place_sort() -> bool:
    mut items = people()
    items.sort(key=lambda p: p.name[1:], reverse=True)
    return names(items) == ["Cy", "Bob", "al"]
