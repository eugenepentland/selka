# A slice of a list element, bound to a local in one expression (`const piece = names[0][0:5]`), is the view the two-step form is
# (`const line = names[0]`, `const piece = line[0:5]`): the same octets, no copy, and the same refusal of a write to the source
# while the view is read later (the refusals are in `src/accepted_shapes_test.zig`). Each case below reads the view both ways.
record Page:
    name: str
    lines: str[]
    ids: int[]


record Leaf:
    words: str[]


record Tree:
    leaves: Leaf[]


# `@noalloc` holds only if the binding allocates nothing: the slice is a view, not a copy.
@noalloc
func width_one_step(names: str[]) -> int:
    const piece = names[0][0:5]
    return len(piece)


@noalloc
func width_two_step(names: str[]) -> int:
    const line = names[0]
    const piece = line[0:5]
    return len(piece)


func plain_parameter(names: str[]) -> bool:
    const piece = names[1][6:11]
    const line = names[1]
    const same = line[6:11]
    return piece == "world" and piece == same


func through_mut_parameter(mut names: str[]) -> bool:
    const piece = names[0][0:5]
    const before = piece == "hello"
    names[0] = "changed"
    return before and names[0] == "changed"


func borrowed_length(text: str) -> int:
    return len(text)


func bytes_elements(blobs: bytes[]) -> bool:
    const piece = blobs[0][0:2]
    return len(piece) == 2 and piece[0] == 104 and piece[1] == 101


func int_rows(rows: int[][]) -> bool:
    const piece = rows[1][1:3]
    return len(piece) == 2 and piece[0] == 6 and piece[1] == 7


func dictionary_value(table: dict[str, str]) -> bool:
    const piece = table["k"][0:3]
    return piece == "hel"


# spec-case: NEW-CORE-ZERO-RC-VIEWS-1
public func test_a_slice_of_a_list_element_is_a_view_in_one_expression() -> bool:
    const names = ["hello world", "hello world"]
    const piece = names[0][0:5]
    const line = names[0]
    const two_step = line[0:5]
    return piece == "hello" and piece == two_step and len(piece) == 5


# spec-case: NEW-CORE-ZERO-RC-VIEWS-1
public func test_the_slice_of_an_element_of_a_field_binds_without_a_copy() -> bool:
    const page = Page(name="hello world", lines=["hello world"], ids=[1, 2])
    const piece = page.lines[0][0:5]
    const name_piece = page.name[0:5]
    return piece == name_piece and width_one_step(page.lines) == 5 and width_two_step(page.lines) == 5


# spec-case: NEW-CORE-ZERO-RC-VIEWS-1
public func test_a_slice_of_an_element_of_a_parameter_and_a_mut_parameter() -> bool:
    mut names = ["hello world", "hello world"]
    return plain_parameter(names) and through_mut_parameter(mut names)


# spec-case: NEW-CORE-ZERO-RC-VIEWS-1
public func test_a_slice_of_an_element_of_every_element_family() -> bool:
    const table = {"k": "hello world"}
    return bytes_elements([b"hello"]) and int_rows([[1, 2], [5, 6, 7]]) and dictionary_value(table)


# spec-case: NEW-CORE-ZERO-RC-VIEWS-1
public func test_a_slice_of_an_element_at_depth_and_after_the_last_use_of_the_view() -> bool:
    const tree = Tree(leaves=[Leaf(words=["hello world"])])
    const piece = tree.leaves[0].words[0][6:11]
    const word = tree.leaves[0].words[0]
    const two_step = word[6:11]
    mut names = ["hello world"]
    const head = names[0][0:5]
    const seen = head == "hello"
    names[0] = "x"
    append(mut names, "y")
    return piece == "world" and piece == two_step and seen and names == ["x", "y"]


# spec-case: NEW-CORE-ZERO-RC-VIEWS-1
public func test_a_slice_of_an_element_passes_to_a_function_that_borrows_it() -> bool:
    const names = ["hello world"]
    const piece = names[0][0:5]
    return borrowed_length(piece) == 5 and f"{piece}!" == "hello!"
