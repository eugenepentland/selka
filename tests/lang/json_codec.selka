# `json.encode` and `json.decode` (CODEC-1, step 1): the derived plain form of every step-1 shape, nested, and each
# refusal with its kind, field path and byte offset. The Python reference vectors are `json_codec_python_vectors.selka`; the
# check-time refusals and the invariant trap are pinned in `src/json_codec_test.zig`.
import json
import strings

enum Color:
    red
    green
    blue


enum Shape:
    circle(r: int)
    rect(w: int, h: int)
    dot


record Widths:
    a: i8
    b: i16
    c: i32
    d: i64
    e: u8
    f: u16
    g: u32
    h: u64


record Stamp:
    at: i64
    zone: str = "UTC"


record Task:
    title: str
    done: bool = False
    stamp: Stamp
    estimate: float = 0.5
    note: str?
    tags: str[] = []


record Tracker:
    tasks: Task[]
    color: Color = Color.red


record Project:
    name: str
    tracker: Tracker
    shape: Shape = Shape.dot
    corners: FixedArray[int, 4]


record Store:
    projects: Project[]
    change: u64 = 0
    grid: int[][] = []
    labels: str?[] = []


record Node:
    name: str
    children: Node[] = []


func enc[T: codec](value: T) -> str:
    const text = json.encode(value) else Err(_):
        return "refused"
    return text


func dec[T: copy + codec](text: str, fallback: T) -> T:
    const value = json.decode[T](text) else Err(_):
        return copy(fallback)
    return value


func decode_error[T: copy + codec](text: str) -> json.CodecError:
    _ = json.decode[T](text) else Err(e):
        return e
    return json.CodecError(kind=json.CodecErrorKind.syntax, path="no error", offset=-1, message="")


func encode_error[T: codec](value: T) -> json.CodecError:
    _ = json.encode(value) else Err(e):
        return e
    return json.CodecError(kind=json.CodecErrorKind.syntax, path="no error", offset=-1, message="")


func error_of(text: str) -> json.CodecError:
    return decode_error[Store](text)


func widths_error(text: str) -> json.CodecError:
    return decode_error[Widths](text)


func sample_store() -> Store:
    const first = Task(title='write "it"\n', stamp=Stamp(at=1795462868), note=None, tags=["a", "λ"])
    const second = Task(title="", done=True, stamp=Stamp(at=-1, zone="Europe/Oslo"), estimate=-0.0, note="n")
    const p1 = Project(name="site", tracker=Tracker(tasks=[own first, own second], color=Color.blue), shape=Shape.rect(w=3, h=4), corners=FixedArray[int, 4]([0, 0, 0, 0]))
    const p2 = Project(name="port", tracker=Tracker(tasks=[]), corners=FixedArray[int, 4]([1, -2, 3, 9223372036854775807]))
    return Store(projects=[own p1, own p2], change=18446744073709551615u64, grid=[[1], [], [2, 3]], labels=["x", None])


public func test_round_trip_nested() -> bool:
    const store = sample_store()
    const text = enc(store)
    const back = dec[Store](text, Store(projects=[]))
    return back == store and len(text) > 0


public func test_encoded_form() -> bool:
    const task = Task(title="t", stamp=Stamp(at=5), note=None)
    const text = enc(task)
    return text == '{"title":"t","done":false,"stamp":{"at":5,"zone":"UTC"},"estimate":0.5,"note":null,"tags":[]}'


public func test_enum_forms() -> bool:
    const a = enc(Shape.dot)
    const b = enc(Shape.circle(r=2))
    const c = enc(Color.green)
    const d = enc(Shape.rect(w=1, h=2))
    return a == '"dot"' and b == '{"case":"circle","value":{"r":2}}' and c == '"green"' and d == '{"case":"rect","value":{"w":1,"h":2}}'


public func test_scalars_at_the_top_level() -> bool:
    const n = dec[int](" -42 ", 0)
    const s = dec[str]('"a\\u00e9\\ud83d\\ude00\\n"', "")
    const f = dec[float]("1e-3", 0.0)
    const items = dec[int?[]]("[1, null, 3]", [])
    const flag = dec[bool]("true", False)
    const second = items[1]
    return n == -42 and s == "aé😀\n" and f == 0.001 and len(items) == 3 and second is None and flag


public func test_widths_round_trip_at_their_edges() -> bool:
    const low = Widths(a=-128i8, b=-32768i16, c=-2147483648i32, d=-9223372036854775808, e=0u8, f=0u16, g=0u32, h=0u64)
    const high = Widths(a=127i8, b=32767i16, c=2147483647i32, d=9223372036854775807, e=255u8, f=65535u16, g=4294967295u32, h=18446744073709551615u64)
    const low_text = enc(low)
    const high_text = enc(high)
    const low_back = dec[Widths](low_text, high)
    const high_back = dec[Widths](high_text, low)
    return low_back == low and high_back == high and high_text == '{"a":127,"b":32767,"c":2147483647,"d":9223372036854775807,"e":255,"f":65535,"g":4294967295,"h":18446744073709551615}'


public func test_u64_above_two_to_the_53() -> bool:
    const big = 9007199254740993u64
    const text = enc(big)
    const back = dec[u64](text, 0u64)
    return text == "9007199254740993" and back == big


public func test_one_past_each_edge_is_out_of_range() -> bool:
    mut ok = True
    const cases = [
        '{"a":128,"b":0,"c":0,"d":0,"e":0,"f":0,"g":0,"h":0}',
        '{"a":-129,"b":0,"c":0,"d":0,"e":0,"f":0,"g":0,"h":0}',
        '{"b":32768,"a":0,"c":0,"d":0,"e":0,"f":0,"g":0,"h":0}',
        '{"c":-2147483649,"a":0,"b":0,"d":0,"e":0,"f":0,"g":0,"h":0}',
        '{"d":9223372036854775808,"a":0,"b":0,"c":0,"e":0,"f":0,"g":0,"h":0}',
        '{"e":256,"a":0,"b":0,"c":0,"d":0,"f":0,"g":0,"h":0}',
        '{"e":-1,"a":0,"b":0,"c":0,"d":0,"f":0,"g":0,"h":0}',
        '{"f":65536,"a":0,"b":0,"c":0,"d":0,"e":0,"g":0,"h":0}',
        '{"g":4294967296,"a":0,"b":0,"c":0,"d":0,"e":0,"f":0,"h":0}',
        '{"h":18446744073709551616,"a":0,"b":0,"c":0,"d":0,"e":0,"f":0,"g":0}',
    ]
    for written in cases:
        const e = widths_error(written)
        ok = ok and e.kind == json.CodecErrorKind.out_of_range and e.offset == 5
    const d = widths_error('{"d":-9223372036854775809,"a":0,"b":0,"c":0,"e":0,"f":0,"g":0,"h":0}')
    return ok and d.path == "d" and d.kind == json.CodecErrorKind.out_of_range and d.offset == 5


public func test_an_integer_token_only() -> bool:
    const fraction = decode_error[int]("1.0")
    const exponent = decode_error[u8]("1e2")
    return fraction.kind == json.CodecErrorKind.unexpected and fraction.offset == 0 and exponent.kind == json.CodecErrorKind.unexpected


public func test_defaults_fill_missing_members() -> bool:
    const text = '{"projects":[{"name":"p","tracker":{"tasks":[{"title":"t","stamp":{"at":3}}]},"corners":[1,2,3,4]}]}'
    const store = dec[Store](text, Store(projects=[], change=9u64))
    const task = Task(title="t", stamp=Stamp(at=3), note=None)
    const project = Project(name="p", tracker=Tracker(tasks=[own task]), corners=FixedArray[int, 4]([1, 2, 3, 4]))
    return store == Store(projects=[own project])


public func test_a_required_field_is_missing() -> bool:
    const e = error_of('{"projects":[{"name":"p","tracker":{"tasks":[{"title":"t"}]}}]}')
    return e.kind == json.CodecErrorKind.missing and e.path == "projects[0].tracker.tasks[0].stamp" and e.offset == 45


public func test_an_unknown_member_is_refused() -> bool:
    const e = error_of('{"projects":[], "format":"v1"}')
    return e.kind == json.CodecErrorKind.unknown_member and e.path == "format" and e.offset == 16


public func test_a_member_twice_is_refused() -> bool:
    const e = error_of('{"projects":[], "change":1, "change":2}')
    return e.kind == json.CodecErrorKind.duplicate and e.path == "change" and e.offset == 28


public func test_an_unknown_case_is_refused() -> bool:
    const e = error_of('{"projects":[{"name":"p","tracker":{"tasks":[],"color":"pink"}}]}')
    return e.kind == json.CodecErrorKind.unknown_case and e.path == "projects[0].tracker.color" and e.offset == 55


public func test_a_case_with_fields_needs_them() -> bool:
    const e = error_of('{"projects":[{"name":"p","tracker":{"tasks":[]},"shape":"circle"}]}')
    const f = error_of('{"projects":[{"name":"p","tracker":{"tasks":[]},"shape":{"case":"circle","value":{"r":1},"x":0}}]}')
    return e.kind == json.CodecErrorKind.unexpected and e.path == "projects[0].shape" and f.kind == json.CodecErrorKind.unknown_member and f.path == "projects[0].shape.x"


public func test_a_wrong_kind_is_unexpected() -> bool:
    const e = error_of('{"projects":[{"name":7,"tracker":{"tasks":[]}}]}')
    const f = error_of('{"projects":{}}')
    const g = error_of('{"projects":[], "grid":[[1],[2,"3"]]}')
    return e.path == "projects[0].name" and e.offset == 21 and f.kind == json.CodecErrorKind.unexpected and f.path == "projects" and g.path == "grid[1][1]" and g.offset == 31


public func test_null_is_only_for_options() -> bool:
    const e = error_of('{"projects":null}')
    const s = dec[Store]('{"projects":[], "labels":[null, "a"]}', Store(projects=[]))
    return e.kind == json.CodecErrorKind.unexpected and len(s.labels) == 2


public func test_a_fixed_array_needs_its_length() -> bool:
    const e = error_of('{"projects":[{"name":"p","tracker":{"tasks":[]},"corners":[1,2,3]}]}')
    return e.kind == json.CodecErrorKind.unexpected and e.path == "projects[0].corners"


public func test_syntax_errors_say_where() -> bool:
    const a = error_of('{"projects":[1,]}')
    const b = error_of('{"projects":[]} []')
    const c = error_of("")
    const lone = decode_error[str]('"\\ud800"')
    return a.kind == json.CodecErrorKind.syntax and a.path == "projects" and a.offset == 15 and b.offset == 16 and c.offset == 0 and lone.kind == json.CodecErrorKind.syntax


public func test_the_error_reads_as_a_sentence() -> bool:
    const e = error_of('{"projects":[{"name":"p","tracker":{"tasks":[{"title":"t"}]}}]}')
    return str(e) == "`projects[0].tracker.tasks[0].stamp` at byte 45 is missing; the field has no default, so the object must give it" and e.message == str(e)


public func test_a_float_with_no_form_is_unwritable() -> bool:
    const zero = 0.0
    const task = Task(title="t", stamp=Stamp(at=1), estimate=zero / zero, note=None)
    const e = encode_error(Tracker(tasks=[copy(task), own task]))
    return e.kind == json.CodecErrorKind.unwritable and e.path == "tasks[0].estimate"


public func test_floats_round_trip() -> bool:
    const values = [0.1, -0.0, 1e300, 5e-324, 2.5, 123456789.0, 1.0 / 3.0]
    const text = enc(values)
    const back = dec[float[]](text, [])
    return back == values and text == "[0.1,-0.0,1e+300,5e-324,2.5,123456789.0,0.3333333333333333]"


public func test_a_recursive_type_through_a_list() -> bool:
    const tree = Node(name="root", children=[Node(name="a"), Node(name="b", children=[Node(name="c")])])
    const text = enc(tree)
    const back = dec[Node](text, Node(name=""))
    return back == tree and text == '{"name":"root","children":[{"name":"a","children":[]},{"name":"b","children":[{"name":"c","children":[]}]}]}'


public func test_generated_values_round_trip() -> bool:
    mut seed = 12345
    mut ok = True
    for round in range(40):
        mut tasks: Task[] = []
        for i in range(round % 5):
            seed = (seed * 1103515245 + 12345) % 2147483648
            mut note: str? = None
            if seed % 3 != 0:
                note = Some(str(seed))
            append(mut tasks, Task(title="t" + str(i), done=seed % 2 == 0, stamp=Stamp(at=seed - 1073741824), estimate=float(seed) / 7.0, note=own note))
        mut color = Color.red
        if round % 2 == 1:
            color = Color.blue
        const project = Project(name="p" + str(round), tracker=Tracker(tasks=own tasks, color=color), corners=FixedArray[int, 4]([round, 0, -round, seed]))
        const store = Store(projects=[own project], change=u64(seed) * 4294967296u64)
        const text = enc(store)
        const back = dec[Store](text, Store(projects=[]))
        ok = ok and back == store
    return ok


@invariant(self.low <= self.high, "a span never runs backwards")
record Span:
    low: int
    high: int


record Spans:
    spans: Span[]
    best: Span?


record Holder32:
    value: f32
    values: f32[]


func deep(levels: int) -> Node:
    mut node = Node(name="leaf")
    for _ in range(levels):
        node = Node(name="n", children=[own node])
    return node


func repeated(piece: str, times: int) -> str:
    mut text = ""
    for _ in range(times):
        text = text + piece
    return text


public func test_an_invariant_that_does_not_hold_is_an_error_at_the_top_level() -> bool:
    const e = decode_error[Span]('{"low": 5, "high": 1}')
    const fine = dec[Span]('{"low": 1, "high": 2}', Span(low=0, high=0))
    return e.kind == json.CodecErrorKind.invariant and e.path == "" and e.offset == 0 and str(e) == "the document at byte 0 is a `Span` whose invariant does not hold" and fine == Span(low=1, high=2)


public func test_an_invariant_that_does_not_hold_is_an_error_inside_a_list() -> bool:
    const e = decode_error[Spans]('{"spans": [{"low": 1, "high": 2}, {"low": 3, "high": 0}]}')
    return e.kind == json.CodecErrorKind.invariant and e.path == "spans[1]" and e.offset == 34


public func test_an_invariant_that_does_not_hold_is_an_error_inside_an_option() -> bool:
    const e = decode_error[Spans]('{"spans": [], "best": {"low": 9, "high": 8}}')
    const fine = dec[Spans]('{"spans": [], "best": {"low": 8, "high": 9}}', Spans(spans=[], best=None))
    return e.kind == json.CodecErrorKind.invariant and e.path == "best" and e.offset == 22 and fine.best == Some(Span(low=8, high=9))


public func test_a_long_name_is_cut_on_a_character_boundary() -> bool:
    const e = error_of('{"projects":[{"name":"p","tracker":{"tasks":[],"color":"' + repeated("é", 300) + '"}}]}')
    const shown = repeated("é", 40) + "..."
    return e.kind == json.CodecErrorKind.unknown_case and shown in e.message and strings.ends_with(e.message, "which is not a case (the cases are red, green, blue)")


public func test_names_in_paths_are_spelled_as_json_writes_them() -> bool:
    const nul = error_of('{"projects":[],"ab\\u0000cd":1}')
    const newline = error_of('{"projects":[],"a\\nb":1}')
    const escaped = error_of('{"projects":[],"gr\\u0069d":[[1],[2,"3"]]}')
    return nul.path == "ab\\u0000cd" and newline.path == "a\\nb" and "\n" not in newline.message and escaped.path == "grid[1][1]"


public func test_a_long_path_is_cut_in_the_sentence_only() -> bool:
    const text = repeated('{"name":"n","children":[', 80) + "7" + repeated("]}", 80)
    const e = decode_error[Node](text)
    return e.kind == json.CodecErrorKind.unexpected and len(e.path) == 80 * 12 - 1 and "....children" in e.message


public func test_encode_refuses_a_value_nested_deeper_than_decode_reads() -> bool:
    const e = encode_error(deep(600))
    const text = enc(deep(499))
    const back = dec[Node](text, Node(name="none"))
    return e.kind == json.CodecErrorKind.unwritable and strings.starts_with(e.path, "children[0].children[0]") and "deeper than 1000" in e.message and back == deep(499)


public func test_f32_reads_and_writes_its_shortest_digits() -> bool:
    const value = dec[Holder32]('{"value": 0.1, "values": [1.5, -0.0, 3.4028234e38, 1e-45]}', Holder32(value=0.0f32, values=[]))
    const text = enc(value)
    const too_big = decode_error[Holder32]('{"value": 3.5e38, "values": []}')
    return text == '{"value":0.1,"values":[1.5,-0.0,3.4028235e+38,1e-45]}' and too_big.kind == json.CodecErrorKind.out_of_range and too_big.path == "value"


public func test_an_extra_member_of_a_case_says_what_the_case_holds() -> bool:
    const e = decode_error[Shape]('{"case":"circle","value":{"r":1},"x":1}')
    return e.kind == json.CodecErrorKind.unknown_member and e.path == "x" and "holds only `case` and `value`" in e.message


public func test_a_lone_surrogate_points_at_its_escape() -> bool:
    const e = decode_error[str]('"x\\ud800"')
    return e.kind == json.CodecErrorKind.syntax and e.offset == 2


public func test_powers_of_two_take_their_shortest_digits() -> bool:
    const values = [1.1125369292536007e-308, 7.120236347223045e-307, 8.98846567431158e307, 5e-324, 4.0, 0.5]
    const text = enc(values)
    return text == "[1.1125369292536007e-308,7.120236347223045e-307,8.98846567431158e+307,5e-324,4.0,0.5]" and dec[float[]](text, []) == values


public func test_empty_texts_and_lists_are_written() -> bool:
    return enc(Task(title="", stamp=Stamp(at=0, zone=""), note=Some(""), tags=[""])) == '{"title":"","done":false,"stamp":{"at":0,"zone":""},"estimate":0.5,"note":"","tags":[""]}'
