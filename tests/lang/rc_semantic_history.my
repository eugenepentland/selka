module rc_semantic_history

# spec-case: D2-VIEW-STORAGE-1
public def test_explicit_snapshot_preserves_prior_values() -> bool:
    mapping = {1: 7}
    saved = list(mapping.values())
    mapping[1] = 9
    mapping[2] = 11
    return saved == [7] and list(mapping.values()) == [9, 11]

# spec-case: D2-VIEW-STORAGE-1
public def test_snapshots_before_and_after_replacement_capture_each_history() -> bool:
    mapping = {1: 7}
    first = list(mapping.values())
    mapping[1] = 13
    second = list(mapping.values())
    mapping[1] = 17
    return first == [7] and second == [13] and list(mapping.values()) == [17]
