# Two `mut` record parameters of one type keep their loans (RC-INTERVAL-ANCHOR-3)
# even though MUT-EXCLUSIVE-1 now rejects a call passing one variable to both
# (`interval(mut frame, mut frame)` is E_MUTATION_OVERLAP, tested in
# src/mut_exclusive_test.zig). These calls pass distinct variables: a write
# through one parameter must leave the other's reads untouched. Answers match
# the collector; RC counting builds balance.
record Frame:
    rows: int[][]
    n: int


func reset(mut other: Frame) -> int:
    other.rows = [[7, 7, 7]]
    mut junk: int[][][] = []
    for i in range(40):
        junk.append([[i], [i, i]])
    return 0


func count(rows: int[][], k: int) -> int:
    mut total = 0
    for row in rows:
        total = total * 10 + len(row)
    return total * 10 + k


func interval(mut frame: Frame, mut other: Frame) -> int:
    frame.n = frame.n + 1
    return len(frame.rows[reset(mut other)])


func operand(mut frame: Frame, mut other: Frame) -> int:
    frame.n = frame.n + 1
    return count(frame.rows, reset(mut other))


public func test_a_receiver_read_survives_a_write_through_another_mut_argument() -> bool:
    mut frame = Frame(rows=[[1, 2], [3]], n=0)
    mut other = Frame(rows=[[4]], n=0)
    mut seen = interval(mut frame, mut other)
    return seen == 2 and frame.rows == [[1, 2], [3]] and other.rows == [[7, 7, 7]] and frame.n == 1


public func test_an_argument_read_survives_a_write_through_another_mut_argument() -> bool:
    mut frame = Frame(rows=[[1, 2], [3]], n=0)
    mut other = Frame(rows=[[4]], n=0)
    mut seen = operand(mut frame, mut other)
    return seen == 210 and frame.rows == [[1, 2], [3]] and other.rows == [[7, 7, 7]] and frame.n == 1


func main(out: Stream) -> int:
    out.print(test_a_receiver_read_survives_a_write_through_another_mut_argument())
    out.print(test_an_argument_read_survives_a_write_through_another_mut_argument())
    return 0
