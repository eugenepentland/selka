# Scalar replacement uses the ordinary width/domain load and store.
domain Distance: u16:
    func make(value: u16) -> Distance:
        return wrap[Distance](value)
    func value(value: Distance) -> u16:
        return unwrap(value)


record Scalars:
    small: i8
    medium: u16
    enabled: bool
    number: float
    distance: Distance


record Mixed:
    scalar: int
    values: int[]
    row: FixedArray[int, 2]
    empty: Unit


func edit(mut values: Scalars[]) -> Unit:
    values[0].small = -120i8
    values[0].medium = 65000u16
    values[0].enabled = True
    values[0].number = -1.25
    values[0].distance = Distance.make(42000u16)


public func test_canonical_scalar_widths_and_domain_values_survive_replacement() -> bool:
    mut values = [Scalars(small=1i8, medium=2u16, enabled=False, number=3.5, distance=Distance.make(4u16))]
    mut snapshot = values
    edit(mut values)
    mut current = values[0]
    return current.small == -120i8 and current.medium == 65000u16 and current.enabled and current.number == -1.25 and Distance.value(current.distance) == 42000u16 and snapshot[0].small == 1i8 and not snapshot[0].enabled


public func test_plain_and_owning_fields_alternate_without_losing_pending_tokens() -> bool:
    mut row: FixedArray[int, 2] = FixedArray[int, 2]([2, 3])
    mut values = [Mixed(scalar=1, values=[4], row=row, empty=())]
    mut before = values
    values[0].scalar = 7
    values[0].values = [8, 9]
    values[0].scalar = values[0].scalar
    values[0].row = FixedArray[int, 2]([10, 11])
    values[0].empty = ()
    values[0].values = [12]
    values[0].scalar = 13
    return values[0].scalar == 13 and values[0].values == [12] and values[0].row[1] == 11 and before[0].scalar == 1 and before[0].values == [4] and before[0].row[1] == 3


func replacement(mut values: Scalars[]) -> i8:
    values[0] = Scalars(small=5i8, medium=6u16, enabled=True, number=7.5, distance=Distance.make(8u16))
    values.append(Scalars(small=9i8, medium=10u16, enabled=False, number=11.5, distance=Distance.make(12u16)))
    return -13i8


public func test_callback_replacement_refreshes_the_parent_before_scalar_store() -> bool:
    mut values = [Scalars(small=1i8, medium=2u16, enabled=False, number=3.5, distance=Distance.make(4u16))]
    mut before = values
    mut mutation_result_66 = replacement(mut values)
    values[0].small = mutation_result_66
    return values[0].small == -13i8 and values[0].medium == 6u16 and len(values) == 2 and before[0].small == 1i8


func main() -> int:
    assert test_canonical_scalar_widths_and_domain_values_survive_replacement()
    assert test_plain_and_owning_fields_alternate_without_losing_pending_tokens()
    assert test_callback_replacement_refreshes_the_parent_before_scalar_store()
    return 0
