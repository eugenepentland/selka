# FR79: a recursive function with many call sites of a large result keeps one stack slot per result
# live at one time, not one per call site. `down` has 240 call sites of a 336-byte result (`case _:`
# stands for 39 variants, each with six calls); with a slot each, its frame was 80 KB and the test's
# stack (32 KiB a frame) overflowed near depth 500. Shared, the frame is a few hundred bytes.
record Wide:
    f0: int
    f1: int
    f2: int
    f3: int
    f4: int
    f5: int
    f6: int
    f7: int
    f8: int
    f9: int
    f10: int
    f11: int
    f12: int
    f13: int
    f14: int
    f15: int
    f16: int
    f17: int
    f18: int
    f19: int
    f20: int
    f21: int
    f22: int
    f23: int
    f24: int
    f25: int
    f26: int
    f27: int
    f28: int
    f29: int
    f30: int
    f31: int
    f32: int
    f33: int
    f34: int
    f35: int
    f36: int
    f37: int
    f38: int
    f39: int


enum Step:
    s0
    s1
    s2
    s3
    s4
    s5
    s6
    s7
    s8
    s9
    s10
    s11
    s12
    s13
    s14
    s15
    s16
    s17
    s18
    s19
    s20
    s21
    s22
    s23
    s24
    s25
    s26
    s27
    s28
    s29
    s30
    s31
    s32
    s33
    s34
    s35
    s36
    s37
    s38
    s39


func leaf(n: int) -> Wide fails str:
    if n < 0:
        fail "negative"
    return Wide(f0=n, f1=n, f2=n, f3=n, f4=n, f5=n, f6=n, f7=n, f8=n, f9=n, f10=n, f11=n, f12=n, f13=n, f14=n, f15=n, f16=n, f17=n, f18=n, f19=n, f20=n, f21=n, f22=n, f23=n, f24=n, f25=n, f26=n, f27=n, f28=n, f29=n, f30=n, f31=n, f32=n, f33=n, f34=n, f35=n, f36=n, f37=n, f38=n, f39=n)


func bump(w: Wide) -> Wide:
    return Wide(f0=w.f0 + 1, f1=w.f1, f2=w.f2, f3=w.f3, f4=w.f4, f5=w.f5, f6=w.f6, f7=w.f7, f8=w.f8, f9=w.f9, f10=w.f10, f11=w.f11, f12=w.f12, f13=w.f13, f14=w.f14, f15=w.f15, f16=w.f16, f17=w.f17, f18=w.f18, f19=w.f19, f20=w.f20, f21=w.f21, f22=w.f22, f23=w.f23, f24=w.f24, f25=w.f25, f26=w.f26, f27=w.f27, f28=w.f28, f29=w.f29, f30=w.f30, f31=w.f31, f32=w.f32, f33=w.f33, f34=w.f34, f35=w.f35, f36=w.f36, f37=w.f37, f38=w.f38, f39=w.f39 + 1)


func step_of(n: int) -> Step:
    if n % 2 == 0:
        return Step.s0
    return Step.s1


func down(n: int, k: int) -> Wide fails str:
    if n == 0:
        return try leaf(0)
    match step_of(n):
        case s0:
            const w = try down(n - 1, k + 1)
            return bump(w)
        case _:
            if k % 3 == 0:
                const a = try down(n - 1, k + 1)
                return bump(a)
            if k % 3 == 1:
                const b = try down(n - 1, k + 1)
                return bump(b)
            if k < 0:
                const c = try down(n - 1, k + 1)
                return bump(c)
            if k < -1:
                const d = try down(n - 1, k + 1)
                return bump(d)
            if k < -2:
                const e = try down(n - 1, k + 1)
                return bump(e)
            const g = try down(n - 1, k + 1)
            return bump(g)


public func test_deep_recursion_of_many_large_results_fits_the_stack() -> bool:
    match down(900, 0):
        case Ok(w):
            return w.f0 == 900 and w.f1 == 0 and w.f39 == 900
        case Err(_):
            return False
