import filesystem

@ensures(len(result) == 2)
func checked(fail : bool) -> Result[str[], str]:
    if fail:
        return Err("skip the postcondition")
    return Ok([str(17), str(23)])


func forwarded(fail : bool) -> Result[str[], str]:
    mut values = try checked(fail )
    return Ok(values)


public func test_postcondition_keeps_the_managed_success_payload() -> bool:
    mut count = 0
    while count < 40:
        match forwarded(False):
            case Ok(values):
                if values != ["17", "23"]:
                    return False
            case Err(_):
                return False
        count += 1
    return True


public func test_postcondition_preserves_the_propagated_error() -> bool:
    match forwarded(True):
        case Ok(_):
            return False
        case Err(message):
            return message == "skip the postcondition"


@ensures(True)
func opened(fs: Filesystem) -> Result[TextFile, str]:
    return fs.open("data", "w")


func unique_roundtrip() -> Result[bool, str]:
    mut fs = filesystem.memory()
    with try opened(fs) as file:
        _ = file.write("hello")
    mut text = try fs.read_text("data")
    return Ok(text == "hello")


public func test_postcondition_keeps_the_unique_file_payload() -> bool:
    match unique_roundtrip():
        case Ok(correct):
            return correct
        case Err(_):
            return False


func main() -> int:
    assert test_postcondition_keeps_the_managed_success_payload()
    assert test_postcondition_preserves_the_propagated_error()
    assert test_postcondition_keeps_the_unique_file_payload()
    return 0
