# Plain aggregate stores copy bytes after the ordinary receiver/bounds checks.
record Point:
    x: int
    y: int


record Board:
    points: [2]Point


def edit(values: mut list[Point], index: int) -> None:
    values[index].x = values[index].y + 10


def replace_during(values: mut list[Point]) -> int:
    values[0] = Point(20, 30)
    values.append(Point(40, 50))
    return 7


# spec-case: RC-PLAIN-AGGREGATE-1
public def test_plain_record_update_preserves_the_earlier_snapshot() -> bool:
    values = [Point(1, 2), Point(3, 4)]
    before = values
    edit(mut values, -1)
    return values[1].x == 14 and values[1].y == 4 and before[1].x == 3


# spec-case: RC-PLAIN-AGGREGATE-1
public def test_same_and_neighbor_element_copies_preserve_independent_bytes() -> bool:
    values = [Point(1, 2), Point(3, 4)]
    values[0] = values[0]
    values[1] = values[0]
    values[0].x = 9
    return values[0].x == 9 and values[0].y == 2 and values[1].x == 1 and values[1].y == 2


# spec-case: RC-PLAIN-AGGREGATE-1
public def test_plain_nested_arrays_copy_before_a_field_update() -> bool:
    boards = [Board([Point(1, 2), Point(3, 4)]), Board([Point(5, 6), Point(7, 8)])]
    before = boards
    boards[0].points[1].y = 40
    boards[1] = boards[0]
    boards[0].points[0].x = 10
    return before[0].points[1].y == 4 and boards[1].points[1].y == 40 and boards[1].points[0].x == 1


# spec-case: RC-PLAIN-AGGREGATE-1
public def test_rhs_callback_finishes_before_the_plain_field_receiver_is_read() -> bool:
    values = [Point(1, 2)]
    before = values
    mutation_result_52 = replace_during(mut values)
    values[0].x = mutation_result_52
    return values[0].x == 7 and values[0].y == 30 and len(values) == 2 and before[0].x == 1


# spec-case: RC-PLAIN-AGGREGATE-1
public def test_fixed_array_element_store_keeps_source_and_destination_distinct() -> bool:
    values: list[[2]int] = [[1, 2], [3, 4]]
    before = values
    values[1] = values[0]
    values[0][1] = 20
    return before[0][1] == 2 and values[0][1] == 20 and values[1][1] == 2


# spec-case: RC-PLAIN-AGGREGATE-1
public def test_zero_sized_elements_keep_the_established_storage_path() -> bool:
    empty: [0]int = []
    values: list[[0]int] = [empty, empty]
    values[1] = empty
    return len(values) == 2 and len(values[1]) == 0


def main() -> int:
    assert test_plain_record_update_preserves_the_earlier_snapshot()
    assert test_same_and_neighbor_element_copies_preserve_independent_bytes()
    assert test_plain_nested_arrays_copy_before_a_field_update()
    assert test_rhs_callback_finishes_before_the_plain_field_receiver_is_read()
    assert test_fixed_array_element_store_keeps_source_and_destination_distinct()
    assert test_zero_sized_elements_keep_the_established_storage_path()
    return 0
