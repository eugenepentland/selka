import argparse
import strings

# The `argparse` module parses a command line against a declared spec: flags, options with values, positionals,
# generated help text, and every mistake as a value (`fails argparse.Error`), never an exit.
func tool() -> argparse.Spec:
    mut spec = argparse.new("shadow_summary", "Summarize a shadow log.")
    argparse.add_flag(mut spec, "json", "j", "print the report as JSON")
    argparse.add_flag(mut spec, "verbose", "v", "say more")
    argparse.add_option_default(mut spec, "examples", "n", "N", "examples per bucket", "3")
    argparse.add_option(mut spec, "label", "l", "TEXT", "a label")
    argparse.add_positional(mut spec, "LOG", "the log to read")
    return spec


func rest_tool() -> argparse.Spec:
    mut spec = argparse.new("pack", "Pack files.")
    argparse.add_flag(mut spec, "force", "", "overwrite")
    argparse.add_optional_positional(mut spec, "OUT", "output name")
    argparse.add_rest(mut spec, "FILE", "files to pack")
    return spec


func words(items: str[]) -> str[]:
    mut out: str[] = []
    for item in items:
        append(mut out, copy(item))
    return out


func parsed_or_message(spec: argparse.Spec, items: str[]) -> str:
    match argparse.parse(spec, items):
        case Ok(parsed):
            return "ok"
        case Err(error):
            return argparse.message(error)


func expect_error(spec: argparse.Spec, items: str[], expected: str) -> bool:
    return parsed_or_message(spec, items) == expected


func value_of(parsed: argparse.Parsed, name: str) -> str:
    match argparse.get(parsed, name):
        case Some(text):
            return copy(text)
        case None:
            return "<none>"


public func test_flags_options_and_positionals_in_any_order() -> bool:
    match argparse.parse(tool(), ["--json", "run.jsonl", "--examples", "5"]):
        case Ok(parsed):
            if not argparse.has(parsed, "json"):
                return False
            if argparse.has(parsed, "verbose"):
                return False
            if value_of(parsed, "examples") != "5":
                return False
            return len(parsed.positionals) == 1 and parsed.positionals[0] == "run.jsonl" and not parsed.help
        case Err(_):
            return False


public func test_equals_and_short_forms_give_the_same_value() -> bool:
    mut forms: str[][] = [["--examples=7", "x"], ["-n", "7", "x"], ["-n7", "x"], ["x", "-n=7"]]
    for form in forms:
        match argparse.parse(tool(), form):
            case Ok(parsed):
                if value_of(parsed, "examples") != "7":
                    return False
            case Err(_):
                return False
    return True


public func test_short_flags_cluster_and_an_option_takes_the_rest_of_the_cluster() -> bool:
    match argparse.parse(tool(), ["-jv", "x"]):
        case Ok(parsed):
            if not (argparse.has(parsed, "json") and argparse.has(parsed, "verbose")):
                return False
        case Err(_):
            return False
    match argparse.parse(tool(), ["-jn9", "x"]):
        case Ok(parsed):
            return argparse.has(parsed, "json") and value_of(parsed, "examples") == "9"
        case Err(_):
            return False


public func test_defaults_apply_and_an_absent_option_is_none() -> bool:
    match argparse.parse(tool(), ["x"]):
        case Ok(parsed):
            return value_of(parsed, "examples") == "3" and value_of(parsed, "label") == "<none>"
        case Err(_):
            return False


public func test_the_last_value_wins_and_values_keeps_them_all() -> bool:
    match argparse.parse(tool(), ["-l", "a", "--label=b", "-lc", "x"]):
        case Ok(parsed):
            const all = argparse.get_all(parsed, "label")
            return value_of(parsed, "label") == "c" and len(all) == 3 and all[0] == "a" and all[1] == "b" and all[2] == "c"
        case Err(_):
            return False


public func test_a_double_dash_ends_options_and_a_lone_dash_is_a_positional() -> bool:
    match argparse.parse(tool(), ["--", "--json"]):
        case Ok(parsed):
            if argparse.has(parsed, "json") or len(parsed.positionals) != 1 or parsed.positionals[0] != "--json":
                return False
        case Err(_):
            return False
    match argparse.parse(tool(), ["-"]):
        case Ok(parsed):
            return len(parsed.positionals) == 1 and parsed.positionals[0] == "-"
        case Err(_):
            return False


public func test_an_option_takes_the_next_word_even_when_it_looks_like_a_flag() -> bool:
    match argparse.parse(tool(), ["--label", "--json", "x"]):
        case Ok(parsed):
            return value_of(parsed, "label") == "--json" and not argparse.has(parsed, "json")
        case Err(_):
            return False


public func test_mistakes_are_values_with_a_message() -> bool:
    const spec = tool()
    if not expect_error(spec, ["--nope", "x"], "unknown option --nope"):
        return False
    if not expect_error(spec, ["-q", "x"], "unknown option -q"):
        return False
    if not expect_error(spec, ["x", "--examples"], "option --examples needs a value"):
        return False
    if not expect_error(spec, ["x", "-n"], "option -n needs a value"):
        return False
    if not expect_error(spec, ["--json=1", "x"], "flag --json takes no value"):
        return False
    if not expect_error(spec, [], "missing LOG"):
        return False
    if not expect_error(spec, ["a", "b"], "unexpected argument b"):
        return False
    return True


public func test_numbers_come_back_as_integers_or_an_error() -> bool:
    match argparse.parse(tool(), ["--examples", "12", "x"]):
        case Ok(parsed):
            match argparse.get_int(parsed, "examples"):
                case Ok(count):
                    if count != 12:
                        return False
                case Err(_):
                    return False
        case Err(_):
            return False
    match argparse.parse(tool(), ["--examples", "many", "x"]):
        case Ok(parsed):
            match argparse.get_int(parsed, "examples"):
                case Ok(_):
                    return False
                case Err(error):
                    return argparse.message(error) == "option --examples wants an integer, got many"
        case Err(_):
            return False


public func test_help_is_a_parsed_fact_and_skips_the_required_checks() -> bool:
    match argparse.parse(tool(), ["--help"]):
        case Ok(parsed):
            if not parsed.help:
                return False
        case Err(_):
            return False
    match argparse.parse(tool(), ["-h"]):
        case Ok(parsed):
            return parsed.help
        case Err(_):
            return False


public func test_the_usage_line_and_help_text_are_generated() -> bool:
    const spec = tool()
    if argparse.usage(spec) != "usage: shadow_summary [-h] [-j] [-v] [-n N] [-l TEXT] LOG":
        return False
    const expected = strings.join(
        [
            "usage: shadow_summary [-h] [-j] [-v] [-n N] [-l TEXT] LOG",
            "",
            "Summarize a shadow log.",
            "",
            "positional arguments:",
            "  LOG               the log to read",
            "",
            "options:",
            "  -h, --help        show this help text and exit",
            "  -j, --json        print the report as JSON",
            "  -v, --verbose     say more",
            "  -n, --examples N  examples per bucket (default: 3)",
            "  -l, --label TEXT  a label",
            "",
        ],
        "\n",
    )
    return argparse.help_text(spec) == expected


public func test_optional_and_repeated_positionals() -> bool:
    const spec = rest_tool()
    if argparse.usage(spec) != "usage: pack [-h] [--force] [OUT] [FILE ...]":
        return False
    match argparse.parse(spec, []):
        case Ok(parsed):
            if len(parsed.positionals) != 0:
                return False
        case Err(_):
            return False
    match argparse.parse(spec, ["out", "a", "b", "--force", "c"]):
        case Ok(parsed):
            return argparse.has(parsed, "force") and len(parsed.positionals) == 4 and parsed.positionals[3] == "c"
        case Err(_):
            return False


# Commands: `tasks [--db PATH] COMMAND [ARGS]`. The options before the command word belong to the program, the rest to
# the command, and every mistake names the command it was found in.
func tasks_program() -> argparse.Commands:
    mut program = argparse.new_commands("tasks", "A task tracker.")
    argparse.add_option_default(mut program.global, "db", "", "PATH", "the database file", "tasks.db")
    argparse.add_flag(mut program.global, "quiet", "q", "print less")
    mut add = argparse.new("add", "Add a task.")
    argparse.add_option(mut add, "prio", "", "N", "priority 1 to 5")
    argparse.add_option(mut add, "tag", "t", "TAG", "a tag, repeatable")
    argparse.add_positional(mut add, "TITLE", "the title")
    argparse.add_command(mut program, "add", add)
    mut listing = argparse.new("list", "List tasks.")
    argparse.add_flag(mut listing, "all", "a", "include done tasks")
    argparse.add_rest(mut listing, "TAG", "only tasks with these tags")
    argparse.add_command(mut program, "list", listing)
    return program


func command_message_of(program: argparse.Commands, items: str[]) -> str:
    _ = argparse.parse_command(program, items) else Err(error):
        return argparse.command_message(error)
    return "ok"


func command_usage_of(program: argparse.Commands, items: str[]) -> str:
    _ = argparse.parse_command(program, items) else Err(error):
        return argparse.command_usage(program, argparse.command_of(error))
    return "ok"


# The facts of one parsed command line in one line, so a test that differs shows both lines.
func facts_of(program: argparse.Commands, items: str[]) -> str:
    const invocation = argparse.parse_command(program, items) else Err(error):
        return "error: " + argparse.command_message(error)
    const globals = f"db={value_of(invocation.global, 'db')} quiet={argparse.has(invocation.global, 'quiet')}"
    const locals = f"prio={value_of(invocation.local, 'prio')} tags={argparse.get_all(invocation.local, 'tag')} all={argparse.has(invocation.local, 'all')}"
    const helps = f"help={invocation.global.help}/{invocation.local.help}"
    return f"{invocation.command}: {globals} {locals} positionals={invocation.local.positionals} {helps}"


public func test_a_command_line_splits_into_global_options_the_command_and_its_arguments() -> bool:
    const items = ["--db", "t.db", "add", "Buy milk", "--prio", "2", "-t", "home", "--tag=x"]
    assert facts_of(tasks_program(), items) == "add: db=t.db quiet=False prio=2 tags=['home', 'x'] all=False positionals=['Buy milk'] help=False/False"
    return True


public func test_the_global_options_may_be_left_out_and_keep_their_defaults() -> bool:
    assert facts_of(tasks_program(), ["list", "-a", "home", "work"]) == "list: db=tasks.db quiet=False prio=<none> tags=[] all=True positionals=['home', 'work'] help=False/False"
    return True


public func test_a_global_flag_and_a_double_dash_before_the_command_word() -> bool:
    assert facts_of(tasks_program(), ["-q", "--", "add", "--", "-x"]) == "add: db=tasks.db quiet=True prio=<none> tags=[] all=False positionals=['-x'] help=False/False"
    return True


public func test_an_option_of_another_command_is_unknown_and_names_the_command() -> bool:
    const program = tasks_program()
    assert command_message_of(program, ["list", "--prio", "2"]) == "unknown option --prio for command list"
    assert command_message_of(program, ["add", "x", "-a"]) == "unknown option -a for command add"
    assert command_usage_of(program, ["list", "--prio", "2"]) == "usage: tasks list [-h] [-a] [TAG ...]"
    return True


public func test_a_global_option_after_the_command_word_is_unknown_to_the_command() -> bool:
    const program = tasks_program()
    assert command_message_of(program, ["add", "--db", "t.db", "x"]) == "unknown option --db for command add"
    assert command_usage_of(program, ["add", "--db", "t.db", "x"]) == "usage: tasks add [-h] [--prio N] [-t TAG] TITLE"
    return True


public func test_a_command_names_the_other_mistakes_of_its_arguments_too() -> bool:
    const program = tasks_program()
    assert command_message_of(program, ["add"]) == "missing TITLE for command add"
    assert command_message_of(program, ["add", "a", "b"]) == "unexpected argument b for command add"
    assert command_message_of(program, ["add", "x", "--prio"]) == "option --prio needs a value for command add"
    assert command_message_of(program, ["list", "--all=1"]) == "flag --all takes no value for command list"
    return True


public func test_a_missing_or_unknown_command_lists_the_commands_and_shows_the_program_usage() -> bool:
    const program = tasks_program()
    assert command_message_of(program, []) == "missing command (one of: add, list)"
    assert command_message_of(program, ["--db", "t.db"]) == "missing command (one of: add, list)"
    assert command_message_of(program, ["remove", "1"]) == "unknown command remove (one of: add, list)"
    assert command_usage_of(program, ["remove"]) == "usage: tasks [-h] [-q] [--db PATH] COMMAND ..."
    return True


public func test_a_mistake_before_the_command_word_names_no_command() -> bool:
    const program = tasks_program()
    assert command_message_of(program, ["--nope", "add", "x"]) == "unknown option --nope"
    assert command_message_of(program, ["--db"]) == "option --db needs a value"
    assert command_usage_of(program, ["--nope", "add", "x"]) == "usage: tasks [-h] [-q] [--db PATH] COMMAND ..."
    return True


public func test_help_before_the_command_word_is_the_programs_and_after_it_the_commands() -> bool:
    assert facts_of(tasks_program(), ["--help"]) == ": db=tasks.db quiet=False prio=<none> tags=[] all=False positionals=[] help=True/False"
    assert facts_of(tasks_program(), ["add", "-h"]) == "add: db=tasks.db quiet=False prio=<none> tags=[] all=False positionals=[] help=False/True"
    return True


public func test_the_help_text_of_a_program_lists_its_commands() -> bool:
    const expected = strings.join(
        [
            "usage: tasks [-h] [-q] [--db PATH] COMMAND ...",
            "",
            "A task tracker.",
            "",
            "commands:",
            "  add            Add a task.",
            "  list           List tasks.",
            "",
            "options:",
            "  -h, --help     show this help text and exit",
            "  -q, --quiet    print less",
            "      --db PATH  the database file (default: tasks.db)",
            "",
        ],
        "\n",
    )
    assert argparse.command_help(tasks_program(), "") == expected
    return True


public func test_the_help_text_of_a_command_is_its_own() -> bool:
    const expected = strings.join(
        [
            "usage: tasks add [-h] [--prio N] [-t TAG] TITLE",
            "",
            "Add a task.",
            "",
            "positional arguments:",
            "  TITLE          the title",
            "",
            "options:",
            "  -h, --help     show this help text and exit",
            "      --prio N   priority 1 to 5",
            "  -t, --tag TAG  a tag, repeatable",
            "",
        ],
        "\n",
    )
    assert argparse.command_help(tasks_program(), "add") == expected
    return True
