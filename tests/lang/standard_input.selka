# Standard input: an `Input` parameter reads the process's standard input, and streams.input_from builds an in-memory
# input for tests. `read(max)` answers up to `max` octets (empty at the end), `read_exact(n)` exactly `n` or None when
# the input ends first, and `read_line()` a line with its newline, the final unterminated line, or None at the end.
import buffers
import streams

# The octets of an optional answer, or `-1` for None.
func size(data: bytes?) -> int:
    match data:
        case Some(octets):
            return len(octets)
        case None:
            return -1


# The next line of an input, or the empty string at its end.
func next_line(stdin: Input) -> bytes:
    match stdin.read_line():
        case Some(line):
            return line
        case None:
            return b""


public func test_read_answers_up_to_max_and_then_nothing() -> bool:
    const stdin = streams.input_from(b"abcdef")
    return stdin.read(4) == b"abcd" and stdin.read(4) == b"ef" and stdin.read(4) == b"" and stdin.read(4) == b""


public func test_read_of_zero_octets_answers_nothing_and_takes_nothing() -> bool:
    const stdin = streams.input_from(b"xy")
    return stdin.read(0) == b"" and stdin.read(5) == b"xy"


public func test_read_exact_answers_the_whole_count_or_none_at_a_truncated_end() -> bool:
    const stdin = streams.input_from(b"12345678")
    return size(stdin.read_exact(3)) == 3 and size(stdin.read_exact(3)) == 3 and size(stdin.read_exact(3)) == -1 and size(stdin.read_exact(1)) == -1


public func test_a_truncated_read_exact_consumes_what_was_left() -> bool:
    const stdin = streams.input_from(b"abc")
    return size(stdin.read_exact(5)) == -1 and stdin.read(5) == b""


public func test_read_exact_of_zero_is_an_empty_answer_even_at_the_end() -> bool:
    const stdin = streams.input_from(b"")
    return size(stdin.read_exact(0)) == 0 and size(stdin.read_exact(1)) == -1


public func test_read_line_keeps_the_newline_and_ends_with_none() -> bool:
    const stdin = streams.input_from(b"one\ntwo\n\nlast")
    return next_line(stdin) == b"one\n" and next_line(stdin) == b"two\n" and next_line(stdin) == b"\n" and next_line(stdin) == b"last" and size(stdin.read_line()) == -1


public func test_read_line_leaves_a_carriage_return_to_the_caller() -> bool:
    const stdin = streams.input_from(b"a\r\nb\r\n")
    return next_line(stdin) == b"a\r\n" and next_line(stdin) == b"b\r\n" and size(stdin.read_line()) == -1


public func test_read_line_on_an_empty_input_is_none() -> bool:
    const stdin = streams.input_from(b"")
    return size(stdin.read_line()) == -1 and stdin.read(1) == b""


public func test_reads_of_every_kind_share_one_position() -> bool:
    const stdin = streams.input_from(b"head\nbody-bytes\ntail")
    return next_line(stdin) == b"head\n" and stdin.read(5) == b"body-" and size(stdin.read_exact(5)) == 5 and next_line(stdin) == b"\n" and next_line(stdin) == b"tail"


public func test_two_inputs_do_not_share_a_position() -> bool:
    const first = streams.input_from(b"first")
    const second = streams.input_from(b"second")
    return first.read(3) == b"fir" and second.read(3) == b"sec" and first.read(9) == b"st" and second.read(9) == b"ond"


public func test_an_input_can_be_handed_to_a_helper() -> bool:
    const stdin = streams.input_from(b"x=1\ny=2\n")
    return len(next_line(stdin)) == 4 and len(next_line(stdin)) == 4 and len(next_line(stdin)) == 0


public func test_binary_octets_pass_through_unchanged() -> bool:
    const stdin = streams.input_from(b"\x00\xff\n\x80")
    return next_line(stdin) == b"\x00\xff\n" and stdin.read(4) == b"\x80"


public func test_a_long_input_reads_back_in_pieces() -> bool:
    mut parts: bytes[] = []
    for _ in range(3000):
        append(mut parts, b"0123456789")
    mut whole = b""
    for part in parts:
        whole = whole + part
    const stdin = streams.input_from(whole)
    const head = stdin.read(10000)
    const rest = stdin.read(100000)
    return len(head) == 10000 and len(rest) == 20000 and stdin.read(1) == b""


public func test_a_test_that_takes_an_input_is_given_an_empty_one(stdin: Input) -> bool:
    return stdin.read(8) == b"" and size(stdin.read_line()) == -1 and size(stdin.read_exact(1)) == -1


public func test_read_into_appends_what_one_read_answers_and_counts_it() -> bool:
    const stdin = streams.input_from(b"abcdef")
    mut buffer = buffers.empty()
    const first = stdin.read_into(mut buffer, 4)
    const second = stdin.read_into(mut buffer, 4)
    const third = stdin.read_into(mut buffer, 4)
    return first == 4 and second == 2 and third == 0 and bytes(buffer) == b"abcdef"


public func test_read_into_keeps_what_the_buffer_already_holds() -> bool:
    const stdin = streams.input_from(b"tail")
    mut buffer = buffers.empty()
    buffers.append(mut buffer, b"head-")
    const count = stdin.read_into(mut buffer, 100)
    return count == 4 and bytes(buffer) == b"head-tail"


public func test_read_into_shares_the_input_position_with_the_other_reads() -> bool:
    const stdin = streams.input_from(b"one\ntwo\nthree")
    mut buffer = buffers.empty()
    const line = next_line(stdin)
    const count = stdin.read_into(mut buffer, 3)
    return line == b"one\n" and count == 3 and bytes(buffer) == b"two" and next_line(stdin) == b"\n" and stdin.read(10) == b"three"


public func test_read_into_of_zero_octets_changes_nothing() -> bool:
    const stdin = streams.input_from(b"abc")
    mut buffer = buffers.empty()
    return stdin.read_into(mut buffer, 0) == 0 and len(buffer) == 0 and stdin.read(5) == b"abc"
