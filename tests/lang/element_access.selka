# Element reads and writes on a managed list are lowered against the receiver's
# own storage: a write stores one element in place, a read projects the field
# the consumer asked for, and a record-returning helper writes its caller's
# destination once. These cases pin the value semantics all of that must keep —
# an element is a value, a copy taken before a write still holds what it held,
# and a mutated receiver is visible through every later read.
public record Cell:
    name: str
    count: i64


public record Inner:
    tag: i64
    depth: i64


public record Outer:
    label: str
    inner: Inner


func bump(mut cells: Cell[], at: i64, by: i64):
    cells[at] = Cell(name=cells[at].name, count=cells[at].count + by)


func relabel(mut cells: Cell[], at: i64, name: str):
    cells[at] = Cell(name=name, count=cells[at].count)


func count_at(cells: Cell[], at: i64) -> i64:
    return cells[at].count


func pick(cells: Cell[], at: i64) -> Cell:
    return cells[at]


func find(cells: Cell[], name: str) -> Cell:
    mut i = 0
    while i < len(cells):
        mut cell = cells[i]
        if cell.name == name:
            return cell
        i += 1
    return Cell(name="", count=-1)


func depth_of(outers: Outer[], at: i64) -> i64:
    return outers[at].inner.depth


func walk(cells: Cell[], at: i64) -> Cell:
    mut head = cells[at]
    if at + 1 >= len(cells):
        return Cell(name=head.name, count=head.count)
    mut rest = walk(cells, at + 1)
    return Cell(name=head.name, count=head.count + rest.count)


func total(cells: Cell[]) -> i64:
    mut sum = 0
    for cell in cells:
        sum += cell.count
    return sum


public func test_scalar_element_write_lands_in_place() -> bool:
    mut values = [1, 2, 3]
    values[1] = 30
    values[-1] = 40
    return values[0] == 1 and values[1] == 30 and values[2] == 40 and len(values) == 3


public func test_record_element_write_replaces_the_whole_element() -> bool:
    mut cells = [Cell(name="a", count=1), Cell(name="b", count=2)]
    bump(mut cells, 1, 5)
    relabel(mut cells, 0, "z")
    return cells[0].name == "z" and cells[0].count == 1 and cells[1].name == "b" and cells[1].count == 7


public func test_element_copy_taken_before_a_write_keeps_its_value() -> bool:
    mut cells = [Cell(name="a", count=1)]
    mut taken = cells[0]
    cells[0] = Cell(name="b", count=2)
    return taken.name == "a" and taken.count == 1 and cells[0].name == "b" and cells[0].count == 2


public func test_managed_field_survives_an_element_write() -> bool:
    mut cells = [Cell(name="first", count=1), Cell(name="second", count=2)]
    mut i = 0
    while i < 200:
        cells[0] = Cell(name="live " + str(i), count=i)
        i += 1
    return cells[0].name == "live 199" and cells[0].count == 199 and cells[1].name == "second"


public func test_field_read_through_an_element_sees_the_current_value() -> bool:
    mut cells = [Cell(name="a", count=1), Cell(name="b", count=2)]
    mut before = count_at(cells, 1)
    cells[1] = Cell(name="b", count=20)
    return before == 2 and count_at(cells, 1) == 20 and cells[-1].count == 20


public func test_nested_field_read_through_an_element() -> bool:
    mut outers = [Outer(label="a", inner=Inner(tag=1, depth=7)), Outer(label="b", inner=Inner(tag=2, depth=9))]
    return depth_of(outers, 0) == 7 and depth_of(outers, 1) == 9 and outers[1].inner.tag == 2


public func test_returned_element_is_an_independent_value() -> bool:
    mut cells = [Cell(name="a", count=1)]
    mut taken = pick(cells, 0)
    cells[0] = Cell(name="b", count=2)
    mut again = pick(cells, 0)
    return taken.name == "a" and taken.count == 1 and again.name == "b" and again.count == 2


public func test_element_local_survives_the_branch_that_returns_it() -> bool:
    mut cells = [Cell(name="a", count=1), Cell(name="b", count=2), Cell(name="c", count=3)]
    mut found = find(cells, "b")
    mut missing = find(cells, "zz")
    return found.name == "b" and found.count == 2 and missing.count == -1


public func test_loop_variable_reads_every_element() -> bool:
    mut cells = [Cell(name="a", count=1), Cell(name="b", count=2), Cell(name="c", count=3)]
    mut before = total(cells)
    cells[2] = Cell(name="c", count=30)
    return before == 6 and total(cells) == 33


public func test_call_result_local_is_a_value_of_its_own() -> bool:
    mut cells = [Cell(name="a", count=1), Cell(name="b", count=2)]
    mut first = pick(cells, 0)
    mut second = pick(cells, 1)
    cells[0] = Cell(name="z", count=99)
    return first.name == "a" and second.name == "b" and first.count == 1 and second.count == 2


public func test_call_result_field_read_keeps_the_returned_value() -> bool:
    mut cells = [Cell(name="alpha", count=4)]
    mut inner = pick(cells, 0).name
    cells[0] = Cell(name="beta", count=5)
    return inner == "alpha" and pick(cells, 0).name == "beta"


public func test_recursive_helper_returns_independent_records() -> bool:
    mut cells = [Cell(name="a", count=1), Cell(name="b", count=2), Cell(name="c", count=3)]
    mut first = walk(cells, 0)
    mut second = walk(cells, 1)
    return first.count == 6 and first.name == "a" and second.count == 5 and cells[0].count == 1


public func test_borrow_ends_when_the_receiver_is_written() -> bool:
    mut cells = [Cell(name="a", count=1), Cell(name="b", count=2)]
    mut taken = cells[0]
    mut i = 0
    while i < 60:
        cells[0] = Cell(name="live", count=i)
        i += 1
    return taken.name == "a" and taken.count == 1 and cells[0].count == 59


func main() -> int:
    return 0
