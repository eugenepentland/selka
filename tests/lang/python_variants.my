

record ShapePoint:
    x: i64
    y: i64


enum Shape:
    point(value: ShapePoint)
    radius(value: i64)
    empty


func score(shape: Shape) -> i64:
    match shape:
        case Shape.empty:
            return 0
        case Shape.radius(value=r):
            return r * r
        case Shape.point(value=p):
            return p.x + p.y


enum Link:
    some(value: i64)
    none


record VariantNode:
    next: Link


func step(node: VariantNode) -> i64:
    match node.next:
        case Link.some(value=id):
            return id
        case Link.none:
            return 0


record VariantBox[T]:
    value: T


enum VariantSlot[T]:
    none
    some(value: T)


func hold[T](value: T) -> VariantSlot[T]:
    return VariantSlot.some(value=value)


func choose_slot[T](slot: VariantSlot[T], fallback: T) -> T:
    match slot:
        case VariantSlot.none:
            return fallback
        case VariantSlot.some(value=value):
            return value


# spec: PY-VARIANT-1
public func test_python_payload_variant_construction_names_the_union_case_like_a_call() -> bool:
    mut total = score(Shape.point(value=ShapePoint(x=2, y=3)))
    total = total + score(Shape.radius(value=6))
    return total + score(Shape.empty) == 41


# spec-case: PY-VARIANT-1
public func test_python_payload_variants_nest_flow_through_locals_and_reach_record_fields() -> bool:
    mut held = Link.some(value=42)
    mut filled = VariantNode(next=held)
    mut empty = VariantNode(next=Link.none)
    return step(filled) + step(empty) == 42


# spec: PY-VARIANT-3
public func test_a_generic_variant_infers_its_type_arguments_from_the_expected_type() -> bool:
    mut held: VariantSlot[VariantBox[i64]] = VariantSlot.some(value=VariantBox[i64](value=42))
    mut empty: VariantSlot[i64] = VariantSlot.none
    return choose_slot(held, VariantBox[i64](value=0)).value + choose_slot(hold[i64](0), 0) + choose_slot(empty, 0) == 42


record VariantSpan:
    start: i64
    end: i64


enum VariantSyntax:
    form(items: VariantSyntax[], span: VariantSpan)
    atom(text: str, span: VariantSpan, literal: str? = None)
    blank


func variant_syntax_size(node: VariantSyntax) -> i64:
    match node:
        case VariantSyntax.blank:
            return 0
        case VariantSyntax.atom(text=text, span=span, literal=literal):
            mut width = span.end - span.start + len(text)
            match literal:
                case None:
                    return width
                case Some(_found):
                    return width + 1
        case VariantSyntax.form(items=items, span=span):
            mut total = span.end - span.start
            for item in items:
                total = total + variant_syntax_size(item)
            return total


func variant_atom_text(node: VariantSyntax) -> str:
    match node:
        case VariantSyntax.blank:
            return ""
        case VariantSyntax.form(items=_, span=_):
            return ""
        case VariantSyntax.atom(text=text, span=_, literal=_):
            return text


enum VariantPair[T]:
    pair(left: T, right: T, label: str = "p")
    empty


func variant_pair_sum(pair: VariantPair[i64]) -> i64:
    match pair:
        case VariantPair.empty:
            return 0
        case VariantPair.pair(left=left, right=right, label=label):
            return left + right + len(label)


func variant_pair_make[T](left: T, right: T) -> VariantPair[T]:
    return VariantPair.pair(left=left, right=right)


# spec-case: PY-VARIANT-4
public func test_a_parenthesized_case_constructs_positionally_by_name_and_with_defaults() -> bool:
    mut span = VariantSpan(start=1, end=4)
    mut positional = VariantSyntax.atom(text="abc", span=span)
    mut named = VariantSyntax.atom(text="abc", span=span, literal=Some("x"))
    mut grouped = VariantSyntax.form(items=[positional, named], span=span)
    return variant_syntax_size(positional) == 6 and variant_syntax_size(named) == 7 and variant_syntax_size(grouped) == 16


# spec-case: PY-VARIANT-4
public func test_a_named_field_pattern_binds_one_name_per_field_and_discards_with_underscore() -> bool:
    mut span = VariantSpan(start=0, end=2)
    return variant_atom_text(VariantSyntax.atom(text="hi", span=span)) == "hi" and variant_atom_text(VariantSyntax.blank) == ""


# spec-case: PY-VARIANT-4
public func test_a_generic_parenthesized_case_specializes_with_the_union_arguments() -> bool:
    mut pair = variant_pair_make[i64](20, 21)
    return variant_pair_sum(pair) == 42 and variant_pair_sum(VariantPair.empty) == 0


func main() -> int:
    return 0
