import strings

func is_ord(text: str, expected: int) -> bool:
    match strings.ord(text):
        case Ok(value):
            return value == expected
        case Err(_):
            return False


func is_chr_err(result: Result[str, strings.Error]) -> bool:
    match result:
        case Ok(_):
            return False
        case Err(_):
            return True


func round_trips(code: int) -> bool:
    match strings.chr(code):
        case Ok(text):
            if len(text) != 1:
                return False
            return is_ord(text, code)
        case Err(_):
            return False


# spec: STDLIB-TEXT-SCALAR-1
public func test_ord_reads_unicode_scalar_values() -> bool:
    if not is_ord("A", 65):
        return False
    if not is_ord("é", 233):
        return False
    if not is_ord("€", 8364):
        return False
    if not is_ord("😀", 128512):
        return False
    match strings.ord(""):
        case Ok(_):
            return False
        case Err(_):
            return True


# spec-case: STDLIB-TEXT-SCALAR-1
public func test_chr_builds_one_character_and_round_trips() -> bool:
    mut codes: int[] = [0, 65, 233, 8364, 128512, 1114111]
    for code in codes:
        if not round_trips(code):
            return False
    return True


# spec-case: STDLIB-TEXT-SCALAR-1
public func test_chr_rejects_surrogates_and_out_of_range_code_points() -> bool:
    if not is_chr_err(strings.chr(55296)):
        return False
    if not is_chr_err(strings.chr(1114112)):
        return False
    return is_chr_err(strings.chr(0 - 1))


func repeated(text: str, times: int) -> str:
    match strings.repeat(text, times):
        case Ok(value):
            return value
        case Err(_):
            return "error"


func rejects_negative() -> bool:
    match strings.repeat("a", 0 - 1):
        case Ok(_):
            return False
        case Err(_):
            return True


# The copies one at a time, the reference the doubling must match.
func appended(text: str, times: int) -> str:
    mut out = ""
    for _ in range(times):
        out = out + text
    return out


# spec: STANDARD-STRINGS-2
public func test_repeat_builds_long_texts_in_linear_time() -> bool:
    # 300,000 copies: appending one copy at a time copied the growing answer
    # every time, about 135 GB for this count.
    mut long = repeated("abc", 300000)
    mut ok = len(long) == 900000 and long[:6] == "abcabc" and long[-4:] == "cabc"
    ok = ok and long.count("abc") == 300000
    mut wide = repeated("é€", 100001)
    return ok and len(wide) == 200002 and wide[-3:] == "€é€" and wide.count("é€") == 100001


# spec-case: STANDARD-STRINGS-2
public func test_repeat_answers_every_count_exactly() -> bool:
    mut ok = repeated("", 1000000000) == "" and repeated("xy", 0) == "" and rejects_negative()
    for times in range(0, 40):
        ok = ok and repeated("ab", times) == appended("ab", times)
        ok = ok and repeated("ü", times) == appended("ü", times)
    return ok and repeated("0", 4) + "7" == "00007"


func main() -> int:
    return 0
