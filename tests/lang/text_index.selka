# Scalar lookup in a long text that is not ASCII (SPEC.md TEXT-INDEX-1..3). Such
# a text finds a scalar by walking from the nearest known place instead of from
# the start of its payload, and none of that is observable: every answer below is
# the one a text with no index gives. The texts are built from the block
# "aé中😀b", whose five scalars take one, two, three, four and one octets, so
# every scalar has a known place in every text made of whole blocks, and a text of
# 30 blocks or more holds the 256 octets an index needs. The runner collects at
# every allocation (`--gc-stress`) and runs the suite under both runtimes.
import strings

const BLOCK: str = "aé中😀b"


# `times` copies of `piece` by doubling, so a long input costs a logarithmic
# number of guest steps.
func repeated(piece: str, times: int) -> str:
    mut out = ""
    mut chunk = copy(piece)
    mut remaining = times
    while remaining > 0:
        if remaining % 2 == 1:
            out = out + chunk
        remaining = remaining // 2
        if remaining > 0:
            chunk = chunk + chunk
    return out


# The scalar at position `at` of a text made of whole blocks.
func scalar_at(at: int) -> str:
    return strings.char_at(BLOCK, at % 5)


# The `[start:stop]` piece of a text made of whole blocks, one scalar at a time.
func piece_of(start: int, stop: int) -> str:
    mut out = ""
    for at in range(start, stop):
        out = out + scalar_at(at)
    return out


# Ends of the range where every lookup is checked in one order: front, middle, end.
func first_mismatch_in_order(text: str) -> int:
    for at in range(strings.char_count(text)):
        if strings.char_at(text, at) != scalar_at(at):
            return at
    return -1


func first_mismatch_reversed(text: str) -> int:
    for step in range(strings.char_count(text)):
        mut at = strings.char_count(text) - 1 - step
        if strings.char_at(text, at) != scalar_at(at):
            return at
        if strings.char_at(text, strings.char_count(text) - 1 - step) != scalar_at(at):
            return at
    return -1


# A stride coprime to the length visits every place once in an order with no
# locality, so nearly every lookup is far from the last one.
func first_mismatch_scattered(text: str) -> int:
    mut length = strings.char_count(text)
    mut place = 0
    for _ in range(length):
        if strings.char_at(text, place) != scalar_at(place):
            return place
        place = (place + 1237) % length
    return -1


# Two positions moving toward each other, so consecutive lookups are far apart
# and the last one is never near the next.
func first_mismatch_from_both_ends(text: str) -> int:
    mut low = 0
    mut high = strings.char_count(text) - 1
    while low <= high:
        if strings.char_at(text, low) != scalar_at(low):
            return low
        if strings.char_at(text, high) != scalar_at(high):
            return high
        low += 1
        high -= 1
    return -1


# spec: TEXT-INDEX-1
public func test_every_scalar_of_a_long_text_is_found_in_every_order() -> bool:
    mut text = repeated(BLOCK, 400)
    mut ok = strings.char_count(text) == 2000
    ok = ok and first_mismatch_in_order(text) == -1
    ok = ok and first_mismatch_reversed(text) == -1
    ok = ok and first_mismatch_scattered(text) == -1
    return ok and first_mismatch_from_both_ends(text) == -1


# spec-case: TEXT-INDEX-1
public func test_iteration_visits_each_scalar_once_in_order() -> bool:
    mut text = repeated(BLOCK, 300)
    mut at = 0
    mut wide = 0
    for ch in strings.chars(text):
        if ch != scalar_at(at):
            return False
        if ord(ch) > 65535:
            wide += 1
        at += 1
    mut ok = at == 1500 and wide == 300
    for position, ch in enumerate(strings.chars(text)):
        if ch != scalar_at(position):
            return False
    mut total = 0
    for ch in strings.chars(text):
        total += ord(ch)
    return ok and total == 300 * (97 + 233 + 20013 + 128512 + 98)


# The sizes an index is built for and just below them: 255 octets of text hold no
# index and 256 do, and a text of one non-ASCII scalar among ASCII ones is the
# smallest shape that needs it.
# spec-case: TEXT-INDEX-1
public func test_lookups_agree_on_both_sides_of_the_index_threshold() -> bool:
    mut ok = True
    for blocks in [1, 2, 29, 30, 31, 64, 65, 90, 250]:
        mut text = repeated(BLOCK, blocks)
        ok = ok and strings.char_count(text) == blocks * 5
        ok = ok and first_mismatch_in_order(text) == -1
        ok = ok and first_mismatch_reversed(text) == -1
        ok = ok and first_mismatch_from_both_ends(text) == -1
    mut padded = repeated("x", 253) + "é"
    ok = ok and strings.char_count(padded) == 254 and strings.char_at(padded, 253) == "é" and strings.char_at(padded, 252) == "x" and strings.char_at(padded, strings.char_count(padded) - 1) == "é"
    mut exact = padded + "y"
    ok = ok and strings.char_count(exact) == 255 and strings.char_at(exact, 253) == "é" and strings.char_at(exact, 254) == "y" and strings.char_at(exact, strings.char_count(exact) - 2) == "é"
    return ok


# One non-ASCII scalar at the front, in the middle and at the end of a long ASCII
# text, the shape of a source file with a single accented name.
# spec-case: TEXT-INDEX-1
public func test_one_non_ascii_scalar_in_ascii_text() -> bool:
    mut plain = repeated("(pin 12 ", 1000)
    for cut in [0, 1, 4000, 7998, 7999, 8000]:
        mut text = strings.char_slice(plain, None, cut) + "é" + strings.char_slice(plain, cut, None)
        if strings.char_count(text) != 8001 or strings.char_at(text, cut) != "é" or strings.char_find(text, "é") != cut:
            return False
        if cut > 0 and (strings.char_at(text, 0) != "(" or strings.char_at(text, cut - 1) != strings.char_at(plain, cut - 1)):
            return False
        if cut < 8000 and (strings.char_at(text, strings.char_count(text) - 1) != " " or strings.char_at(text, cut + 1) != strings.char_at(plain, cut)):
            return False
        mut count = 0
        for at in range(strings.char_count(text)):
            if strings.char_at(text, at) == "(":
                count += 1
        if count != 1000 or strings.count(text, "(") != 1000:
            return False
    return True


# 4-byte scalars only, so scalar and octet positions differ by a factor of four.
# spec-case: TEXT-INDEX-1
public func test_a_text_of_four_octet_scalars() -> bool:
    mut text = repeated("😀", 3000)
    mut ok = strings.char_count(text) == 3000 and strings.char_at(text, 0) == "😀" and strings.char_at(text, 2999) == "😀" and strings.char_at(text, strings.char_count(text) - 1500) == "😀"
    for at in range(strings.char_count(text)):
        if strings.char_at(text, at) != "😀":
            return False
    mut mixed = repeated("😀é", 1500)
    ok = ok and strings.char_count(mixed) == 3000 and strings.char_at(mixed, 2999) == "é" and strings.char_at(mixed, 2998) == "😀" and strings.char_at(mixed, 1501) == "é"
    return ok and strings.char_slice(mixed, 1000, 1004) == "😀é😀é" and strings.char_slice(text, 10, 2990) == repeated("😀", 2980)


# spec: TEXT-INDEX-2
public func test_slices_of_a_long_text_read_the_scalars_they_name() -> bool:
    mut text = repeated(BLOCK, 400)
    mut ok = True
    for start in [0, 1, 2, 3, 4, 5, 127, 128, 129, 255, 256, 257, 999, 1000, 1500, 1995, 1999]:
        for width in [0, 1, 2, 7, 8, 9, 100, 128, 129, 500, 1000]:
            mut stop = start + width
            if stop > 2000:
                stop = 2000
            ok = ok and strings.char_slice(text, start, stop) == piece_of(start, stop)
            ok = ok and strings.char_count(strings.char_slice(text, start, stop)) == stop - start
    return ok


# Endpoints past the ends clamp, a reversed interval is empty, and negative
# endpoints count from the end, exactly as on a short text.
# spec-case: TEXT-INDEX-2
public func test_slice_endpoints_clamp_and_count_from_the_end() -> bool:
    mut text = repeated(BLOCK, 100)
    mut ok = strings.char_count(text) == 500
    ok = ok and strings.char_slice(text, None, None) == text and strings.char_slice(text, 0, 500) == text and strings.char_slice(text, 0, 9999) == text
    ok = ok and strings.char_slice(text, max(strings.char_count(text) - 9999, 0), 3) == "aé中" and strings.char_slice(text, 498, 9999) == "😀b" and strings.char_slice(text, 500, 600) == ""
    ok = ok and strings.char_slice(text, 300, 100) == "" and strings.char_slice(text, 250, 250) == "" and strings.char_slice(text, max(strings.char_count(text) - 1, 0), None) == "b"
    ok = ok and strings.char_slice(text, max(strings.char_count(text) - 2, 0), None) == "😀b" and strings.char_slice(text, max(strings.char_count(text) - 3, 0), max(strings.char_count(text) - 1, 0)) == "中😀" and strings.char_slice(text, None, max(strings.char_count(text) - 499, 0)) == "a"
    ok = ok and strings.char_slice(text, max(strings.char_count(text) - 500, 0), max(strings.char_count(text) - 499, 0)) == "a" and strings.char_slice(text, max(strings.char_count(text) - 100, 0), None) == piece_of(400, 500)
    ok = ok and strings.char_slice(text, 123, max(strings.char_count(text) - 77, 0)) == piece_of(123, 423) and strings.char_slice(text, max(strings.char_count(text) - 77, 0), 123) == ""
    return ok and strings.char_slice(text, 499, 500) == "b" and strings.char_slice(text, 499, 499) == "" and strings.char_slice(text, None, 0) == ""


# A parser that keeps the rest of its input and cuts pieces off the front: each
# step's slice and each lookup in it read the right scalar.
# spec-case: TEXT-INDEX-2
public func test_the_rest_of_a_text_after_each_cut() -> bool:
    mut text = repeated(BLOCK, 400)
    mut pos = 0
    mut step = 0
    while pos < 1900:
        mut rest = copy(strings.char_slice(text, pos, None))
        if strings.char_count(rest) != 2000 - pos:
            return False
        if strings.char_at(rest, 0) != scalar_at(pos) or strings.char_at(rest, strings.char_count(rest) - 1) != "b" or strings.char_at(rest, strings.char_count(rest) // 2) != scalar_at(pos + strings.char_count(rest) // 2):
            return False
        if strings.char_slice(rest, 3, 9) != piece_of(pos + 3, pos + 9):
            return False
        pos += 37 + step % 5
        step += 1
    return True


# A text cut in two halves, each of them a view of the whole or a copy, read from
# both ends inward: the positions of a view are the view's own.
# spec-case: TEXT-INDEX-2
public func test_views_of_a_long_text_have_positions_of_their_own() -> bool:
    mut text = repeated(BLOCK, 600)
    mut left = copy(strings.char_slice(text, None, 2000))
    mut right = copy(strings.char_slice(text, 1000, None))
    mut inner = copy(strings.char_slice(right, 700, 1800))
    mut ok = strings.char_count(left) == 2000 and strings.char_count(right) == 2000 and strings.char_count(inner) == 1100
    ok = ok and first_mismatch_from_both_ends(left) == -1
    for at in range(strings.char_count(inner)):
        if strings.char_at(inner, at) != scalar_at(1700 + at):
            return False
    for at in range(strings.char_count(right)):
        if strings.char_at(right, at) != scalar_at(1000 + at):
            return False
    mut scattered = 0
    mut place = 0
    for _ in range(strings.char_count(right)):
        if strings.char_at(right, place) != scalar_at(1000 + place):
            scattered += 1
        place = (place + 611) % strings.char_count(right)
    return ok and scattered == 0 and strings.char_at(right, strings.char_count(right) - 1) == scalar_at(2999) and strings.char_at(inner, strings.char_count(inner) - 1) == scalar_at(2799)


# The scalar `find` reports is a scalar position, whatever octets precede it, and
# `count`, `split` and the prefix and suffix tests read the same text.
# spec: TEXT-INDEX-3
public func test_search_reports_scalar_positions_in_a_long_text() -> bool:
    mut text = repeated(BLOCK, 400) + "TAIL"
    mut ok = strings.char_find(text, "TAIL") == 2000 and strings.char_find(text, "😀b") == 3 and strings.char_find(text, "b") == 4
    ok = ok and strings.char_find(text, "aé中😀bTAIL") == 1995 and strings.char_find(text, "missing") == -1
    ok = ok and strings.count(text, "😀") == 400 and strings.count(text, "aé") == 400 and strings.count(text, "TAIL") == 1
    mut tail = copy(strings.char_slice(text, 1000, None))
    ok = ok and strings.char_find(tail, "TAIL") == 1000 and strings.char_find(tail, "é") == 1 and strings.char_find(tail, "é中😀bTAIL") == 996
    mut parts = strings.split(text, "b")
    ok = ok and len(parts) == 401 and parts[0] == "aé中😀" and parts[399] == "aé中😀" and parts[400] == "TAIL"
    ok = ok and strings.char_at(parts[200], 2) == "中" and strings.char_at(parts[200], strings.char_count(parts[200]) - 1) == "😀" and strings.starts_with(text, "aé中") and strings.ends_with(text, "bTAIL")
    return ok


# strip, replace, join, case mapping and padding produce texts that are indexed
# as well: each answer is read at scalar positions after the operation.
# spec-case: TEXT-INDEX-3
public func test_texts_built_by_methods_are_indexed_correctly() -> bool:
    mut text = repeated(BLOCK, 200)
    mut padded = "   " + text + "\n\t "
    mut stripped = copy(strings.strip(padded))
    mut ok = stripped == text and strings.char_count(stripped) == 1000 and strings.char_at(stripped, strings.char_count(stripped) - 1) == "b" and strings.char_at(stripped, 500) == "a"
    ok = ok and strings.char_at(strings.lstrip(padded), 0) == "a" and last_scalar(strings.rstrip(padded)) == "b" and strings.char_at(strings.rstrip(padded), 3) == "a"
    mut replaced = strings.replace(text, "中", "ZZ")
    ok = ok and strings.char_count(replaced) == 1200 and strings.char_at(replaced, 2) == "Z" and strings.char_at(replaced, 3) == "Z" and strings.char_at(replaced, 4) == "😀"
    ok = ok and strings.char_at(replaced, strings.char_count(replaced) - 1) == "b" and strings.char_at(replaced, strings.char_count(replaced) - 2) == "😀" and strings.count(replaced, "ZZ") == 200
    mut flat = strings.replace(strings.replace(strings.replace(text, "é", "e"), "中", "c"), "😀", "d")
    ok = ok and strings.char_count(flat) == 1000 and strings.char_at(flat, 3) == "d" and strings.char_at(flat, 1) == "e" and strings.char_at(flat, strings.char_count(flat) - 1) == "b" and strings.is_alpha(flat)
    mut joined = strings.join([copy(strings.char_slice(text, None, 100)), copy(strings.char_slice(text, 100, 200)), copy(strings.char_slice(text, 200, None))], "-")
    ok = ok and strings.char_count(joined) == 1002 and strings.char_at(joined, 100) == "-" and strings.char_at(joined, 201) == "-" and strings.char_at(joined, strings.char_count(joined) - 1) == "b"
    ok = ok and strings.char_at(joined, 101) == scalar_at(100) and strings.char_at(joined, 202) == scalar_at(200)
    mut upper = strings.upper(text)
    ok = ok and strings.char_count(upper) == 1000 and strings.char_at(upper, 0) == "A" and strings.char_at(upper, 1) == "é" and strings.char_at(upper, 4) == "B" and strings.char_at(upper, strings.char_count(upper) - 1) == "B"
    mut lower = strings.lower(("B" + text))
    ok = ok and strings.char_at(lower, 0) == "b" and strings.char_at(lower, 1) == "a" and strings.char_at(lower, strings.char_count(lower) - 1) == "b"
    mut zero = strings.zfill(("é" + text), 1100)
    ok = ok and strings.char_count(zero) == 1100 and strings.char_at(zero, 0) == "0" and strings.char_at(zero, 98) == "0" and strings.char_at(zero, 99) == "é" and strings.char_at(zero, 100) == "a" and strings.char_at(zero, strings.char_count(zero) - 1) == "b"
    mut both = text + text
    return ok and strings.char_count(both) == 2000 and strings.char_at(both, 1000) == "a" and strings.char_at(both, 999) == "b" and strings.char_at(both, 1999) == "b"


# A text made of ASCII and mixed pieces answers the same at every place, and an
# empty text, a one-scalar text and the last valid index behave as before.
# spec-case: TEXT-INDEX-3
public func test_short_empty_and_ascii_texts_are_unchanged() -> bool:
    mut empty = ""
    mut ok = strings.char_count(empty) == 0 and strings.char_slice(empty, 0, 0) == "" and strings.char_slice(empty, None, None) == "" and strings.char_find(empty, "a") == -1
    mut one = "😀"
    ok = ok and strings.char_count(one) == 1 and strings.char_at(one, 0) == "😀" and strings.char_at(one, strings.char_count(one) - 1) == "😀" and strings.char_slice(one, 0, 1) == one and strings.char_slice(one, 1, None) == ""
    mut ascii_text = repeated("abcdefghij", 500)
    ok = ok and strings.char_at(ascii_text, 4999) == "j" and strings.char_at(ascii_text, strings.char_count(ascii_text) - 5000) == "a" and strings.char_slice(ascii_text, 123, 127) == "defg"
    mut small = "héllo wörld — ✓"
    ok = ok and strings.char_count(small) == 15 and strings.char_at(small, 1) == "é" and strings.char_at(small, 7) == "ö" and strings.char_at(small, strings.char_count(small) - 1) == "✓" and strings.char_at(small, strings.char_count(small) - 3) == "—"
    return ok and strings.char_slice(small, 6, 11) == "wörld" and strings.char_find(small, "—") == 12 and strings.char_find(small, "wörld") == 6


# Values do not share the position a lookup recorded: copies and aliases of a
# text read independently, and a text is unchanged by being read.
# spec-case: TEXT-INDEX-1
public func test_aliases_and_copies_read_independently() -> bool:
    mut text = repeated(BLOCK, 300)
    mut alias = copy(text)
    mut saved = text + ""
    mut other = repeated(BLOCK, 300)
    mut ok = strings.char_at(text, 1400) == scalar_at(1400) and strings.char_at(alias, 3) == scalar_at(3) and strings.char_at(saved, 1499) == "b" and strings.char_at(other, 0) == "a"
    ok = ok and strings.char_at(alias, 1400) == scalar_at(1400) and strings.char_at(other, 1400) == scalar_at(1400) and strings.char_at(text, 3) == scalar_at(3)
    mut reversed_walk = ""
    for step in range(10):
        reversed_walk = reversed_walk + strings.char_at(saved, strings.char_count(saved) - 1 - step)
    ok = ok and reversed_walk == "b😀中éab😀中éa"
    return ok and text == alias and text == saved and text == other and strings.char_count(text) == 1500


func last_scalar(text: str) -> str:
    return strings.char_at(text, strings.char_count(text) - 1)
