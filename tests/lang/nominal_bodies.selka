record Box[T]:
    value: T


enum Slot[T]:
    none
    some(value: T)


func pack[T](x: T) -> Box[T]:
    return Box[T](value=x)


func extract[T](box: Box[T]) -> T:
    return box.value


func alter[T](box: Box[T], x: T) -> Box[T]:
    mut y = box
    y.value = x
    return y


func slot_of[T](x: T) -> Slot[T]:
    return Slot.some(value=x)


func choose[T](x: Slot[T], fallback: T) -> T:
    match x:
        case Slot.none:
            return fallback
        case Slot.some(value=value):
            return value


func pairs[T](x: T) -> FixedArray[T, 2]:
    return FixedArray[T, 2]([x, x])


func boxed[T](x: T) -> Box[FixedArray[T, 2]]:
    return Box[FixedArray[T, 2]](value=pairs[T](x))


# spec: NOMINAL-BODY-1
public func test_nominal_bodies_construct_project_update_match_and_forward_symbolic_arguments() -> bool:
    mut boxed_value = pack[i64](3)
    return extract[i64](alter[i64](boxed_value, choose[i64](slot_of[i64](7), 0))) == 7


public func test_nominal_bodies_reuse_concrete_array_identities_created_by_earlier_function_specialization() -> bool:
    mut a = pairs[i64](1)
    mut b = boxed[i64](8)
    return a[0] + b.value[1] == 9


func main() -> int:
    return 0
