
func closed(value: int, index: int) -> int:
    mut values = [value, value + 1, value + 2]
    mut alias = values
    return alias[index] + values[1] + alias[-1] + len(values)


func overlapping(value: int) -> int:
    mut first = [value, value + 1, value + 2]
    mut second = [value + 3, value + 4, value + 5, value + 6]
    return first[-1] + second[0]


func escaped(value: int) -> int[]:
    return [value, value + 1, value + 2]


func changed(value: int) -> int:
    mut values = [value, value + 1, value + 2]
    mut before = values
    values[0] = value + 10
    return before[0] + values[0]


func unsigned(value: u8, index: int) -> u8:
    mut values = [value, value]
    return values[index]


func same_class(value: int) -> int:
    mut values = [value, value, value, value, value, value, value, value, value, value]
    return values[-1] + len(values)


func narrow(value: i16) -> i16:
    mut values = [value, value]
    return values[-1]


func flags(value: bool, index: int) -> bool:
    mut values = [value, not value]
    return values[index]


func units(value: Unit) -> int:
    mut values = [value, value]
    return len(values)


public func test_local_lists_keep_values_aliases_and_cold_then_warm_results() -> bool:
    assert closed(12, 0) == 42
    assert closed(12, -3) == 42
    assert closed(12, 2) == 44
    assert closed(12, -1) == 44
    assert closed(-13, 0) == -33
    assert overlapping(12) == 29
    assert escaped(12) == [12, 13, 14]
    assert changed(12) == 34
    assert unsigned(u8(255), 1) == u8(255)
    assert unsigned(u8(254), -2) == u8(254)
    assert same_class(12) == 22
    assert same_class(13) == 23
    assert narrow(i16(-32768)) == i16(-32768)
    assert narrow(i16(32767)) == i16(32767)
    assert flags(True, 0)
    assert flags(False, -1)
    assert units(()) == 2
    for i in range(40):
        assert closed(i, 0) == i * 3 + 6
    return True
