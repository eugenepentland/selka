module local_stack_list

def closed(value: int, index: int) -> int:
    values = [value, value + 1, value + 2]
    alias = values
    return alias[index] + values[1] + alias[-1] + len(values)


def overlapping(value: int) -> int:
    first = [value, value + 1, value + 2]
    second = [value + 3, value + 4, value + 5, value + 6]
    return first[-1] + second[0]


def escaped(value: int) -> list[int]:
    return [value, value + 1, value + 2]


def changed(value: int) -> int:
    values = [value, value + 1, value + 2]
    before = values
    values[0] = value + 10
    return before[0] + values[0]


def unsigned(value: u8) -> u8:
    values = [value, value]
    return values[1]


def same_class(value: int) -> int:
    values = [value, value, value, value, value, value, value, value, value, value]
    return values[-1] + len(values)


def narrow(value: i16) -> i16:
    values = [value, value]
    return values[-1]


def flags(value: bool) -> bool:
    values = [value, not value]
    return values[0] and not values[1]


def units(value: None) -> int:
    values = [value, value]
    return len(values)


public def test_local_lists_keep_values_aliases_and_cold_then_warm_results() -> bool:
    assert closed(12, 0) == 42
    assert closed(12, -3) == 42
    assert closed(12, 2) == 44
    assert closed(12, -1) == 44
    assert closed(-13, 0) == -33
    assert overlapping(12) == 29
    assert escaped(12) == [12, 13, 14]
    assert changed(12) == 34
    assert unsigned(u8(255)) == u8(255)
    assert same_class(12) == 22
    assert same_class(13) == 23
    assert narrow(i16(-32768)) == i16(-32768)
    assert narrow(i16(32767)) == i16(32767)
    assert flags(True)
    assert not flags(False)
    assert units(None) == 2
    for i in range(40):
        assert closed(i, 0) == i * 3 + 6
    return True
