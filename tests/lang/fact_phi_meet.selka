# A loop phi whose stated interval neither the hull of its operands nor the counted-loop growth bound gives alone, only
# their meet: an accumulator that grows by a constant and wraps at a modulus. Each bound is sound, so the values lie in
# both; the fact validator accepts the meet (F3). Before it did, `--verify-facts` (the lang run) and a `--release` build
# rejected these functions with E_FACT_VALIDATION. `decode` is the protobuf library's base64 accumulator.
func decode(t: str) -> int:
    mut accumulated = 0
    mut bits = 0
    for i in range(len(t)):
        accumulated = accumulated * 64 + 1
        bits += 6
        if bits >= 8:
            bits -= 8
            accumulated = accumulated % 16
    return accumulated


func phase_of(t: str) -> int:
    mut phase = 0
    for i in range(len(t)):
        phase += 3
        if phase >= 5:
            phase -= 5
    return phase


func bits_left(t: str) -> int:
    mut bits = 0
    for i in range(len(t)):
        bits += 6
        if bits >= 8:
            bits -= 8
    return bits


public func test_the_base64_accumulator_keeps_the_low_bits() -> bool:
    return decode("aGVsbG8") == 1 and decode("") == 0


public func test_a_phase_that_wraps_at_five_stays_below_five() -> bool:
    return phase_of("abcdefg") == 1 and phase_of("ab") == 1 and phase_of("") == 0


public func test_the_bits_left_over_after_whole_octets() -> bool:
    return bits_left("abcd") == 0 and bits_left("abc") == 2 and bits_left("a") == 6
