module move_elision

# Aggregate copies the ownership analysis proves unobserved are not emitted
# (`QBE-MOVE-ELIDE-1`). Every case here writes a record where the old value
# could still be observed if a skipped copy were not in fact dead, and checks
# that every name keeps the value it would have had with the copies.


public record Point:
    x: int
    y: int
    tag: str
    marks: list[int]


def point(x: int) -> Point:
    return Point(x=x, y=x + 1, tag=f"p{x}", marks=[x])


public def test_a_field_write_updates_only_its_own_record() -> bool:
    p = point(1)
    q = p
    q.x = 10
    q.tag = "q"
    return p.x == 1 and p.tag == "p1" and q.x == 10 and q.y == 2 and q.tag == "q"


public def test_field_writes_in_a_loop_accumulate_in_place() -> bool:
    p = point(0)
    for i in range(50):
        p.x = p.x + i
        p.tag = f"t{i}"
        spare = point(i)
        p.y = p.y + spare.y
    return p.x == 1225 and p.tag == "t49" and p.y == 1 + 1275


public def test_a_record_read_after_a_copy_is_written_keeps_its_value() -> bool:
    p = point(3)
    q = p
    r = q
    r.x = 99
    return q.x == 3 and r.x == 99 and p.x == 3


def bumped(p: Point) -> Point:
    q = p
    q.x = q.x + 1
    return q


public def test_a_parameter_the_callee_updates_is_the_callers_value_still() -> bool:
    p = point(5)
    q = bumped(p)
    return p.x == 5 and q.x == 6 and q.tag == "p5"


public def test_a_list_element_field_write_lands_in_that_element_only() -> bool:
    ps = [point(0), point(1), point(2)]
    kept = ps[1]
    for round in range(20):
        for i in range(len(ps)):
            ps[i].x = ps[i].x + i
            ps[i].tag = f"r{round}"
            _ = point(round)
    return ps[0].x == 0 and ps[1].x == 21 and ps[2].x == 42 and ps[2].tag == "r19" and kept.x == 1 and kept.tag == "p1"


public def test_a_negative_index_element_write_lands_in_the_same_element() -> bool:
    ps = [point(0), point(1)]
    ps[-1].x = ps[-1].x + 7
    ps[-2].y = 40
    return ps[1].x == 8 and ps[0].y == 40 and ps[0].x == 0


def both(a: Point, b: Point) -> int:
    return a.x * 100 + b.x


public def test_an_argument_that_names_the_record_keeps_the_old_value() -> bool:
    p = point(1)
    return both(p, replace(p, x=2)) == 102
