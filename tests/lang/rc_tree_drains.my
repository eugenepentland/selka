# Trees of two-edge nodes that die in one drain (RC-DRAIN-PAIR-1). Each answer
# is the same under the collector and RC; RC counting builds balance.
record Node:
    left: Node?
    right: Node?


func make(depth: int) -> Node:
    if depth == 0:
        return Node(left=None, right=None)
    return Node(left=Some(make(depth - 1)), right=Some(make(depth - 1)))


func check(node: Node) -> int:
    mut left = node.left.copy()
    mut right = node.right.copy()
    if left is None or right is None:
        return 1
    return 1 + check(left) + check(right)


public func test_short_lived_trees_die_and_reuse_their_slots() -> bool:
    mut total = 0
    for _ in range(40):
        total = total + check(make(6))
    return total == 40 * 127


public func test_shared_subtrees_outlive_their_first_parent() -> bool:
    mut shared = make(3)
    mut kept: Node[] = []
    for index in range(10):
        mut pair = Node(left=Some(shared.copy()), right=Some(make(2)))
        if index % 3 == 0:
            kept.append(pair)
    return check(shared) == 15 and len(kept) == 4 and check(kept[3]) == 1 + 15 + 7


record Labelled:
    name: str
    next: Labelled?


func chain(count: int) -> Labelled:
    mut head = Labelled(name="end", next=None)
    for index in range(count):
        head = Labelled(name="n" + str(index), next=Some(head))
    return head


func length(item: Labelled) -> int:
    mut total = 1
    mut current = item.next.copy()
    while current is not None:
        if len(current.name) > 0:
            total = total + 1
        current = current.next.copy()
    return total


public func test_text_and_node_edges_die_together() -> bool:
    mut total = 0
    for count in range(30):
        total = total + length(chain(count))
    mut labelled = chain(5)
    mut names = labelled.name.copy()
    return total == 30 * 31 // 2 and names == "n4" and length(labelled) == 6


func main() -> int:
    assert test_short_lived_trees_die_and_reuse_their_slots()
    assert test_shared_subtrees_outlive_their_first_parent()
    assert test_text_and_node_edges_die_together()
    return 0
