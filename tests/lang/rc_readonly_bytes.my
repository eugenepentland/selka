func returned(values: bytes[], index: int) -> bytes:
    return values[index]

func octet(values: bytes[], index: int) -> int:
    mut saved = returned(values, 0)
    return int(saved[index])

public func test_readonly_octets_preserve_positive_and_negative_boundaries() -> bool:
    mut values = [bytes([97, 98, 99])]
    return octet(values, 0) == 97 and octet(values, 2) == 99 and octet(values, -1) == 99 and octet(values, -3) == 97

public func test_readonly_octets_keep_view_backing_anchored() -> bool:
    mut data = bytes([97, 98, 99, 100])
    mut values = [data[1:3]]
    return octet(values, 0) == 98 and octet(values, -1) == 99

func main(out: Stream) -> int:
    out.print(test_readonly_octets_preserve_positive_and_negative_boundaries())
    out.print(test_readonly_octets_keep_view_backing_anchored())
    return 0
