def returned(values: list[bytes], index: int) -> bytes:
    return values[index]

def octet(values: list[bytes], index: int) -> int:
    saved = returned(values, 0)
    return int(saved[index])

# spec-case: RC-READONLY-MANAGED-CALLS-1
public def test_readonly_octets_preserve_positive_and_negative_boundaries() -> bool:
    values = [bytes([97, 98, 99])]
    return octet(values, 0) == 97 and octet(values, 2) == 99 and octet(values, -1) == 99 and octet(values, -3) == 97

# spec-case: RC-READONLY-MANAGED-CALLS-1
public def test_readonly_octets_keep_view_backing_anchored() -> bool:
    data = bytes([97, 98, 99, 100])
    values = [data[1:3]]
    return octet(values, 0) == 98 and octet(values, -1) == 99

def main(out: Stream) -> int:
    out.print(test_readonly_octets_preserve_positive_and_negative_boundaries())
    out.print(test_readonly_octets_keep_view_backing_anchored())
    return 0
