# Aggregates own their initialized managed fields across construction and matching.
record Pair:
    left: int[]
    right: int[]


enum Choice:
    both(value: Pair)
    single(value: int[])
    empty


func pair(items: int[]) -> Pair:
    return Pair(left=items.copy(), right=items.copy())


func selected(value: Choice) -> int[]:
    match value:
        case Choice.both(value=fields):
            return fields.right.copy()
        case Choice.single(value=items):
            return items.copy()
        case Choice.empty:
            return []


public func test_record_fields_survive_original_and_sibling_replacement() -> bool:
    mut original = [1, 2]
    mut value = pair(original)
    original = [9]
    value.left = [4]
    return value.right[1] == 2 and value.left[0] == 4 and original[0] == 9


public func test_record_update_preserves_prior_aggregate_snapshot() -> bool:
    mut value = Pair(left=[1], right=[2])
    mut before = value.copy()
    value.right = [3, 4]
    return before.right[0] == 2 and len(value.right) == 2


public func test_variant_payload_binding_owns_values_after_scrutinee_replacement() -> bool:
    mut original = Choice.both(value=Pair(left=[5], right=[6, 7]))
    mut result = selected(original)
    original = Choice.empty
    return len(result) == 2 and result[1] == 7


public func test_repeated_variants_replace_prior_payload_owners() -> bool:
    mut choice = Choice.empty
    mut index = 0
    while index < 100:
        if index % 2 == 0:
            choice = Choice.both(value=Pair(left=[index], right=[index + 1]))
        else:
            choice = Choice.single(value=[index])
        index += 1
    return selected(choice)[0] == 99


public func test_fixed_array_constructor_owns_its_managed_elements() -> bool:
    mut first = [11]
    mut values: FixedArray[int[], 2] = FixedArray[int[], 2]([first, [22]])
    first = [33]
    return values[0][0] == 11 and values[1][0] == 22


public func test_fixed_array_replace_retires_only_the_replaced_snapshot() -> bool:
    mut values: FixedArray[int[], 2] = FixedArray[int[], 2]([[1], [2]])
    mut before = values.copy()
    values[0] = [3]
    return before[0][0] == 1 and values[0][0] == 3 and values[1][0] == 2


func unwrapped(candidate: int[]?) -> int[]?:
    mut items = try candidate.copy()
    return Some(items)


func propagated(candidate: Result[int[], int[]]) -> Result[int[], int[]]:
    mut items = try candidate.copy()
    return Ok(items)


enum Failure:
    details(value: int[])
    unavailable


func wrapped(candidate: Result[int[], int[]]) -> Result[bool, Failure]:
    match candidate:
        case Ok(items):
            return Ok(len(items) > 0)
        case Err(error):
            return Err(Failure.details(value=error.copy()))


public func test_option_propagation_owns_success_and_releases_none() -> bool:
    mut original: int[]? = Some([8, 9])
    mut kept = unwrapped(original)
    original = None
    match kept:
        case Some(items):
            return items[1] == 9 and unwrapped(None) is None
        case None:
            return False


public func test_result_propagation_owns_success_and_error_payloads() -> bool:
    mut successful = 0
    mut failed = 0
    match propagated(Ok([4])):
        case Ok(items):
            successful = items[0]
        case Err(_):
            pass
    match propagated(Err([7])):
        case Ok(_):
            pass
        case Err(items):
            failed = items[0]
    return successful == 4 and failed == 7


public func test_propagation_wraps_an_owned_error_in_the_enclosing_union() -> bool:
    match wrapped(Err([21, 22])):
        case Ok(_):
            return False
        case Err(failure):
            match failure:
                case Failure.details(value=items):
                    return items[1] == 22
                case Failure.unavailable:
                    return False


record Node:
    values: int[]
    next: Node?


public func test_boxed_record_update_preserves_an_earlier_snapshot() -> bool:
    mut node = Node(values=[1], next=None)
    mut before = node.copy()
    node.values = [2, 3]
    return before.values[0] == 1 and len(node.values) == 2


func error_after_prior_operand() -> Result[Pair, int[]]:
    const left = [41]
    const right = try propagated(Err([19]))
    return Ok(Pair(left=left, right=right))


func none_after_prior_operand() -> Pair?:
    const left = [41]
    const right = try unwrapped(None)
    return Some(Pair(left=left, right=right))


public func test_propagating_error_releases_preceding_constructor_operands() -> bool:
    match error_after_prior_operand():
        case Ok(_):
            return False
        case Err(items):
            return items[0] == 19


public func test_propagating_none_releases_preceding_constructor_operands() -> bool:
    return none_after_prior_operand() is None


public func test_reordered_constructor_fields_preserve_aliased_input_snapshots() -> bool:
    mut source = [17, 23]
    mut result = Pair(right=source.copy(), left=source.copy())
    source.append(99)
    result.left.append(31)
    return result.right == [17, 23] and result.left == [17, 23, 31] and source == [17, 23, 99]


record HeldFields:
    live: int[]
    snapshot: dict[int, int]


public func test_constructor_publishes_nested_holds_and_converts_held_mapping_inputs() -> bool:
    mut mapping = {1: 7}
    mut live = list(mapping.values())
    mapping[1] = 13
    mut prior = mapping.copy()
    mut result = HeldFields(live=live, snapshot=mapping)
    result.snapshot[1] = 11
    return list(result.live) == [7] and result.snapshot[1] == 11 and prior[1] == 13


func pinned_pair(mut items: int[]) -> Pair:
    mut result = Pair(left=items.copy(), right=items.copy())
    items.append(29)
    return result


func arena_pinned_pair() -> Pair:
    mut items = [17, 23]
    mut result = pinned_pair(mut items)
    assert items == [17, 23, 29]
    return result


func main() -> int:
    assert test_record_fields_survive_original_and_sibling_replacement()
    assert test_record_update_preserves_prior_aggregate_snapshot()
    assert test_variant_payload_binding_owns_values_after_scrutinee_replacement()
    assert test_repeated_variants_replace_prior_payload_owners()
    assert test_fixed_array_constructor_owns_its_managed_elements()
    assert test_fixed_array_replace_retires_only_the_replaced_snapshot()
    assert test_option_propagation_owns_success_and_releases_none()
    assert test_result_propagation_owns_success_and_error_payloads()
    assert test_propagation_wraps_an_owned_error_in_the_enclosing_union()
    assert test_boxed_record_update_preserves_an_earlier_snapshot()
    assert test_propagating_error_releases_preceding_constructor_operands()
    assert test_propagating_none_releases_preceding_constructor_operands()
    assert test_reordered_constructor_fields_preserve_aliased_input_snapshots()
    assert test_constructor_publishes_nested_holds_and_converts_held_mapping_inputs()
    return 0
