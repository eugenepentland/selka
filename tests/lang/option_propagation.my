module option_propagation

# `?` on an `Option[T]` propagates `None` out of any function returning an
# `Option[U]`: `None` carries no payload, so `T` and `U` need not agree. The
# class cases run under `--gc-stress`, where every allocation collects, so the
# unwrapped reference must stay alive across the allocation that follows it.


class Node:
    value: int
    left: Option[Node]


def left_value(node: Node) -> Option[int]:
    child = node.left?
    return Some(child.value)


def grandchild(node: Node) -> Option[Node]:
    child = node.left?
    return child.left


def label(value: Option[int]) -> Option[str]:
    number = value?
    return Some(f"n={number}")


def first_value[T](items: Option[list[T]]) -> Option[int]:
    present = items?
    return Some(len(present))


def or_minus_one(value: Option[int]) -> int:
    match value:
        case Some(number):
            return number
        case None:
            return 0 - 1


# spec: OPTION-TRY-3
public def test_option_propagation_unwraps_a_class_payload_in_a_function_returning_option_int() -> bool:
    leaf = Node(value=4, left=None)
    root = Node(value=1, left=Some(leaf))
    return or_minus_one(left_value(root)) == 4 and or_minus_one(left_value(leaf)) == 0 - 1


# spec-case: OPTION-TRY-3
public def test_option_propagation_into_a_different_class_option_forwards_none() -> bool:
    leaf = Node(value=4, left=None)
    middle = Node(value=2, left=Some(leaf))
    root = Node(value=1, left=Some(middle))
    found = 0
    match grandchild(root):
        case Some(node):
            found = node.value
        case None:
            pass
    return found == 4 and grandchild(leaf) is None and grandchild(middle) is None


# spec-case: OPTION-TRY-3
public def test_option_propagation_converts_between_scalar_and_managed_elements() -> bool:
    text = ""
    match label(Some(7)):
        case Some(value):
            text = value
        case None:
            pass
    return text == "n=7" and label(None) is None


# spec-case: OPTION-TRY-3
public def test_generic_option_propagation_accepts_a_different_enclosing_element() -> bool:
    return or_minus_one(first_value[int](Some([1, 2, 3]))) == 3 and or_minus_one(first_value[int](None)) == 0 - 1
