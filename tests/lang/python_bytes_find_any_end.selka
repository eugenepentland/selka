# `bytes.find_any(data, octets, start, end)` (R3-FINDEND): the search reads the octets in `[start, end)` only, so a
# scanner's search for a delimiter inside one line of a large buffer stops at the line's end. One test for each edge of the
# window (an empty range, an end before the start, an end past the length, a match at `end - 1`, a match at `end`), then the
# set sizes that take their own search, a slice and a byte buffer as the receiver, and a scan that is linear only if the search
# stops at `end`. `raw` is `ab cd,ef gh`: spaces at 2 and 8, a comma at 5.
import buffers
import bytes

# `times` copies of `piece` by doubling.
func doubled(piece: bytes, times: int) -> bytes:
    mut out = b""
    mut chunk = copy(piece)
    mut remaining = times
    while remaining > 0:
        if remaining % 2 == 1:
            out = out + chunk
        remaining = remaining // 2
        if remaining > 0:
            chunk = chunk + chunk
    return out


# How many lines of `raw` (each 200 octets: 199 and a newline) hold a space before the newline, and how many end at the newline.
func scan_lines(raw: bytes) -> int[]:
    mut spaces = 0
    mut newlines = 0
    mut start = 0
    while start < len(raw):
        if bytes.find_any(raw, b" \t\r", start, start + 199) >= 0:
            spaces += 1
        if bytes.find_any(raw, b" \n\r", start, start + 200) == start + 199:
            newlines += 1
        start += 200
    return [spaces, newlines]


public func test_find_any_end_an_empty_range_finds_nothing() -> bool:
    mut raw = b"ab cd,ef gh"
    assert bytes.find_any(raw, b" ", 0, 0) == -1
    assert bytes.find_any(raw, b" ", 2, 2) == -1
    assert bytes.find_any(raw, b" ", len(raw), len(raw)) == -1
    assert bytes.find_any(raw, b"", 0, 5) == -1
    assert bytes.find_any(b"", b"a", 0, 5) == -1
    return True


public func test_find_any_end_before_start_finds_nothing() -> bool:
    mut raw = b"ab cd,ef gh"
    assert bytes.find_any(raw, b" ", 3, 2) == -1
    assert bytes.find_any(raw, b" ", 9, 3) == -1
    assert bytes.find_any(raw, b" ", 2, 0) == -1
    mut start = 8
    mut end = 2
    assert bytes.find_any(raw, b" ", start, end) == -1
    return True


public func test_find_any_end_past_the_length_is_the_length() -> bool:
    mut raw = b"ab cd,ef gh"
    assert bytes.find_any(raw, b"h", 0, len(raw)) == 10
    assert bytes.find_any(raw, b"h", 0, len(raw) + 1) == 10
    assert bytes.find_any(raw, b"h", 0, 9223372036854775807) == 10
    assert bytes.find_any(raw, b"h", 20, 30) == -1
    assert bytes.find_any(raw, b"h", len(raw), len(raw) + 5) == -1
    assert bytes.find_any(raw, b",", 0) == bytes.find_any(raw, b",", 0, len(raw))
    assert bytes.find_any(raw, b"z", 4) == bytes.find_any(raw, b"z", 4, len(raw))
    return True


public func test_find_any_end_finds_a_match_at_the_last_octet_before_end() -> bool:
    mut raw = b"ab cd,ef gh"
    assert bytes.find_any(raw, b" ", 0, 3) == 2
    assert bytes.find_any(raw, b" ", 2, 3) == 2
    assert bytes.find_any(raw, b" ", 3, 9) == 8
    assert bytes.find_any(raw, b"h", 0, len(raw)) == 10
    assert bytes.find_any(raw, b"a", 0, 1) == 0
    mut start = 3
    mut end = 6
    assert bytes.find_any(raw, b" ,", start, end) == 5
    return True


public func test_find_any_end_does_not_find_a_match_at_end() -> bool:
    mut raw = b"ab cd,ef gh"
    assert bytes.find_any(raw, b" ", 0, 2) == -1
    assert bytes.find_any(raw, b" ", 3, 8) == -1
    assert bytes.find_any(raw, b"h", 0, len(raw) - 1) == -1
    assert bytes.find_any(raw, b"a", 1, 1) == -1
    mut start = 3
    mut end = 5
    assert bytes.find_any(raw, b" ,", start, end) == -1
    return True


# A one-octet set, a two-octet set and a larger set each take their own search; each stops at `end`.
public func test_find_any_end_bounds_a_set_of_one_two_and_three_octets() -> bool:
    mut raw = b"abc,def;ghi:jkl"
    assert bytes.find_any(raw, b",", 0, 3) == -1
    assert bytes.find_any(raw, b",", 0, 4) == 3
    assert bytes.find_any(raw, b",;", 4, 7) == -1
    assert bytes.find_any(raw, b",;", 4, 8) == 7
    assert bytes.find_any(raw, b";,", 0, 3) == -1
    assert bytes.find_any(raw, b";,", 0, 4) == 3
    assert bytes.find_any(raw, b",;:", 8, 11) == -1
    assert bytes.find_any(raw, b",;:", 8, 12) == 11
    assert bytes.find_any(raw, b":;,", 0, 3) == -1
    assert bytes.find_any(raw, b":;,", 0, 4) == 3
    assert bytes.find_any(raw, b"xx", 0, 99) == -1
    assert bytes.find_any(raw, b"jj", 0, 99) == 12
    return True


# The two-octet search works a window at a time (64, 128 octets): `end` falls inside one, on its edge and beyond it.
public func test_find_any_end_inside_and_across_the_two_octet_windows() -> bool:
    mut plain = doubled(b"x", 1000)
    mut raw = plain[:200] + b"\n" + plain[:10]
    assert bytes.find_any(raw, b"\n,", 0, 200) == -1
    assert bytes.find_any(raw, b",\n", 0, 201) == 200
    assert bytes.find_any(raw, b"\n,", 0, 64) == -1
    assert bytes.find_any(raw, b"\n,", 100, 201) == 200
    assert bytes.find_any(raw, b"\n,", 63, 64) == -1
    assert bytes.find_any(raw, b"\n,", 190, 205) == 200
    mut mixed = plain[:100] + b"," + plain[:50] + b"\n"
    assert bytes.find_any(mixed, b"\n,", 0, 100) == -1
    assert bytes.find_any(mixed, b"\n,", 0, 101) == 100
    assert bytes.find_any(mixed, b"\n,", 101, 151) == -1
    assert bytes.find_any(mixed, b",\n", 101, 152) == 151
    assert bytes.find_any(plain, b"\n,", 0, 1000) == -1
    return True


# A slice read in place and a byte buffer take `end` as an owned byte string does.
public func test_find_any_end_on_a_slice_and_on_a_buffer() -> bool:
    mut raw = b"ab cd,ef gh"
    assert bytes.find_any(raw[3:9], b",", 0, 2) == -1
    assert bytes.find_any(raw[3:9], b",", 0, 3) == 2
    assert bytes.find_any(raw[3:9], b" ,", 1, 99) == 2
    mut octets: int[] = []
    mut buffer = byte_buffer(octets)
    assert buffers.append_range(mut buffer, raw, 0, len(raw))
    assert bytes.find_any(buffer, b" ", 0, 2) == -1
    assert bytes.find_any(buffer, b" ", 0, 3) == 2
    assert bytes.find_any(buffer, b" ", 3, 99) == 8
    return True


# A scanner that asks for the next space before the end of each line reads each line once: 20,000 lines of 199 octets and a
# newline hold no space, so a search that read past `end` would read the rest of the 4 MB each time.
public func test_find_any_end_keeps_a_line_scan_linear() -> bool:
    mut line = doubled(b"0123456789", 20)
    mut raw = doubled(line[:199] + b"\n", 20000)
    mut counts = scan_lines(raw)
    assert counts[0] == 0
    assert counts[1] == 20000
    return True
