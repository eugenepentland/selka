public func test_the_table_converts_to_civil_and_back() -> bool:
    const rows = table()
    mut at = 0
    while at < len(rows):
        const nanoseconds = ns_of(rows[at])
        const instant = time.Instant(unix_nanoseconds=nanoseconds)
        const civil = time.to_civil(instant)
        if civil_text(civil) != rows[at + 4]:
            return False
        if time.weekday(civil) != ns_of(rows[at + 3]):
            return False
        match time.from_civil(civil):
            case Ok(back):
                if back.unix_nanoseconds != nanoseconds:
                    return False
            case Err(_):
                return False
        at += 5
    return True


public func test_the_table_formats_rfc_3339_and_http_dates() -> bool:
    const rows = table()
    mut at = 0
    while at < len(rows):
        const instant = time.Instant(unix_nanoseconds=ns_of(rows[at]))
        if time.format_rfc3339(instant) != rows[at + 1]:
            return False
        if time.format_http_date(instant) != rows[at + 2]:
            return False
        at += 5
    return True


public func test_the_table_parses_what_it_formats() -> bool:
    const rows = table()
    mut at = 0
    while at < len(rows):
        const nanoseconds = ns_of(rows[at])
        if rfc_instant(rows[at + 1]) != nanoseconds:
            return False
        if nanoseconds > 0 - 9223372036000000000:
            if http_instant(rows[at + 2]) != whole_second(nanoseconds):
                return False
        at += 5
    return True


public func test_rfc_3339_offsets_fractions_and_case() -> bool:
    if rfc_instant("2001-09-09T03:46:40+02:00") != 1000000000000000000:
        return False
    if rfc_instant("2001-09-08T20:16:40-05:30") != 1000000000000000000:
        return False
    if rfc_instant("2001-09-09t01:46:40z") != 1000000000000000000:
        return False
    if rfc_instant("2001-09-09T01:46:40.5Z") != 1000000000500000000:
        return False
    if rfc_instant("2001-09-09T01:46:40.123456789Z") != 1000000000123456789:
        return False
    if rfc_instant("2001-09-09T01:46:40.000Z") != 1000000000000000000:
        return False
    return rfc_instant("1969-12-31T23:59:59.999999999Z") == 0 - 1


public func test_rfc_3339_refuses_what_is_not_a_timestamp() -> bool:
    mut bad: str[] = ["", "2001-09-09", "2001-09-09T01:46:40", "2001-09-09 01:46:40Z", "2001-09-09T01:46:40ZZ", "2001-09-09T01:46:40Z ", " 2001-09-09T01:46:40Z"]
    append(mut bad, "2001-9-9T01:46:40Z")
    append(mut bad, "2001-13-09T01:46:40Z")
    append(mut bad, "2001-00-09T01:46:40Z")
    append(mut bad, "2001-09-00T01:46:40Z")
    append(mut bad, "2001-02-29T01:46:40Z")
    append(mut bad, "2001-04-31T01:46:40Z")
    append(mut bad, "2001-09-09T24:46:40Z")
    append(mut bad, "2001-09-09T01:60:40Z")
    append(mut bad, "2001-09-09T01:46:60Z")
    append(mut bad, "2001-09-09T01:46:40+24:00")
    append(mut bad, "2001-09-09T01:46:40+01:60")
    append(mut bad, "2001-09-09T01:46:40+0100")
    append(mut bad, "2001-09-09T01:46:40.Z")
    append(mut bad, "2001-09-09T01:46:40.1234567890Z")
    append(mut bad, "0000-01-01T00:00:00Z")
    append(mut bad, "3000-01-01T00:00:00Z")
    append(mut bad, "1000-01-01T00:00:00Z")
    append(mut bad, "2001-09-09T01:46:4xZ")
    for text in bad:
        if not rfc_fails(text):
            return False
    return True


public func test_the_http_date_formats_of_rfc_9110_are_parsed() -> bool:
    if http_instant("Sun, 06 Nov 1994 08:49:37 GMT") != 784111777000000000:
        return False
    if http_instant("Sunday, 06-Nov-94 08:49:37 GMT") != 784111777000000000:
        return False
    if http_instant("Sun Nov  6 08:49:37 1994") != 784111777000000000:
        return False
    if http_instant("Sunday, 06-Nov-1994 08:49:37 GMT") != 784111777000000000:
        return False
    # Two-digit years: 70 to 99 are 19xx and 00 to 69 are 20xx.
    if http_instant("Monday, 01-Jan-70 00:00:00 GMT") != 0:
        return False
    return http_instant("Friday, 02-Feb-24 12:00:00 GMT") == 1706875200000000000


public func test_the_http_date_refuses_what_is_not_one() -> bool:
    mut bad: str[] = ["", "Sun, 06 Nov 1994 08:49:37", "Sun, 06 Nov 1994 08:49:37 UTC", "Sun, 6 Nov 1994 08:49:37 GMT", "Sun, 06 nov 1994 08:49:37 GMT"]
    append(mut bad, "Sun, 06 Foo 1994 08:49:37 GMT")
    append(mut bad, "Xxx, 06 Nov 1994 08:49:37 GMT")
    append(mut bad, "Sun, 32 Nov 1994 08:49:37 GMT")
    append(mut bad, "Sun, 31 Apr 1994 08:49:37 GMT")
    append(mut bad, "Sun, 06 Nov 1994 24:49:37 GMT")
    append(mut bad, "Sun, 06 Nov 1994 08:60:37 GMT")
    append(mut bad, "Sun, 06 Nov 1994 08:49:61 GMT")
    append(mut bad, "Sun, 06 Nov 1994 08:49:37 GMT extra")
    append(mut bad, "Sun Nov 6 08:49:37 1994")
    append(mut bad, "Sun Nov  6 08:49:37 94")
    append(mut bad, "Sun, 06 Nov 1000 08:49:37 GMT")
    for text in bad:
        if not http_fails(text):
            return False
    return True


public func test_civil_fields_are_validated() -> bool:
    if not valid(2024, 2, 29, 23, 59, 59, 999999999):
        return False
    if valid(2023, 2, 29, 0, 0, 0, 0) or valid(1900, 2, 29, 0, 0, 0, 0):
        return False
    if valid(2024, 0, 1, 0, 0, 0, 0) or valid(2024, 13, 1, 0, 0, 0, 0):
        return False
    if valid(2024, 4, 0, 0, 0, 0, 0) or valid(2024, 4, 31, 0, 0, 0, 0):
        return False
    if valid(2024, 4, 1, 24, 0, 0, 0) or valid(2024, 4, 1, 0, 60, 0, 0) or valid(2024, 4, 1, 0, 0, 60, 0):
        return False
    if valid(2024, 4, 1, 0, 0, 0, 1000000000) or valid(2024, 4, 1, 0, 0, 0, 0 - 1):
        return False
    # The nanosecond clock reaches only 1677-09-21T00:12:43.145224192Z to 2262-04-11T23:47:16.854775807Z.
    if valid(1677, 9, 21, 0, 12, 43, 145224191) or not valid(1677, 9, 21, 0, 12, 43, 145224192):
        return False
    if valid(2262, 4, 11, 23, 47, 16, 854775808) or not valid(2262, 4, 11, 23, 47, 16, 854775807):
        return False
    return not valid(3000, 1, 1, 0, 0, 0, 0)


public func test_leap_years_and_month_lengths() -> bool:
    if time.is_leap_year(1900) or not time.is_leap_year(2000) or not time.is_leap_year(2024) or time.is_leap_year(2100) or time.is_leap_year(2023):
        return False
    if time.days_in_month(2024, 2) != 29 or time.days_in_month(2023, 2) != 28 or time.days_in_month(2023, 4) != 30 or time.days_in_month(2023, 12) != 31:
        return False
    return time.days_in_month(2023, 0) == 0 and time.days_in_month(2023, 13) == 0


func next(state: int) -> int:
    return (state * 1103515245 + 12345) % 2147483648


public func test_conversions_round_trip_over_many_instants() -> bool:
    mut state = 123456789
    mut count = 0
    while count < 400:
        state = next(state)
        const high = state
        state = next(state)
        const low = state
        state = next(state)
        const seconds = (high * 2147483648 + low) % 18446744072 - 9223372036
        const nanoseconds = seconds * 1000000000 + state % 1000000000
        const instant = time.Instant(unix_nanoseconds=nanoseconds)
        match time.from_civil(time.to_civil(instant)):
            case Ok(back):
                if back.unix_nanoseconds != nanoseconds:
                    return False
            case Err(_):
                return False
        if rfc_instant(time.format_rfc3339(instant)) != nanoseconds:
            return False
        if http_instant(time.format_http_date(instant)) != whole_second(nanoseconds):
            return False
        count += 1
    return True
