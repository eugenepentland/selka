import strings
import time

# Calendar conversion in `time`: civil date and time from Unix nanoseconds and back (UTC), RFC 3339 and HTTP date
# formatting and parsing. The table of instants was produced by Python's datetime (experiments/real-work-20261030/LT/
# gen_time_cases.py): Unix nanoseconds, RFC 3339, HTTP date, ISO weekday (Monday 1), then the civil fields.
func civil_text(civil: time.Civil) -> str:
    return f"{civil.year} {civil.month} {civil.day} {civil.hour} {civil.minute} {civil.second} {civil.nanosecond}"


func ns_of(text: str) -> int:
    match parse_int(text):
        case Some(value):
            return value
        case None:
            return 0


# The instant truncated to its whole second, as an HTTP date carries it.
func whole_second(nanoseconds: int) -> int:
    return nanoseconds // 1000000000 * 1000000000


func rfc_instant(text: str) -> int:
    match time.parse_rfc3339(text):
        case Ok(instant):
            return instant.unix_nanoseconds
        case Err(_):
            return 0 - 7


func rfc_fails(text: str) -> bool:
    match time.parse_rfc3339(text):
        case Ok(_):
            return False
        case Err(_):
            return True


func http_instant(text: str) -> int:
    match time.parse_http_date(text):
        case Ok(instant):
            return instant.unix_nanoseconds
        case Err(_):
            return 0 - 7


func http_fails(text: str) -> bool:
    match time.parse_http_date(text):
        case Ok(_):
            return False
        case Err(_):
            return True


func valid(year: int, month: int, day: int, hour: int, minute: int, second: int, nanosecond: int) -> bool:
    const civil = time.Civil(year=year, month=month, day=day, hour=hour, minute=minute, second=second, nanosecond=nanosecond)
    match time.from_civil(civil):
        case Ok(_):
            return True
        case Err(_):
            return False


