module option_narrowing

record Widget:
    width: int

record Counter:
    value: int

def append_one[T: copy + storable](candidate: mut Option[list[T]], item: T) -> int:
    if candidate is None:
        return 0
    candidate.append(item)
    return len(candidate)

def observe(counter: mut list[int]) -> Option[int]:
    counter[0] = counter[0] + 1
    return Some(counter[0])

def inferred_identity[T: copy + storable](value: T) -> T:
    return value

def width(candidate: Option[Widget]) -> int:
    if candidate is None:
        return 0
    return candidate.width

def positive(candidate: Option[int]) -> bool:
    return candidate is not None and candidate > 0

def absent_or_positive(candidate: Option[int]) -> bool:
    return candidate is None or candidate > 0

def fallback[T: copy + storable](candidate: Option[T], other: T) -> T:
    if candidate is None:
        return other
    return candidate

def generic_positive[T: integer](candidate: Option[T]) -> bool:
    return candidate is not None and candidate > T(0)

# spec: OPTION-FLOW-1
public def test_option_narrowing_early_return_and_fields() -> bool:
    return width(Some(Widget(width=42))) == 42 and width(None) == 0

# spec: OPTION-FLOW-2
public def test_option_narrowing_short_circuit_conditions() -> bool:
    return positive(Some(42)) and not positive(None) and absent_or_positive(None) and not absent_or_positive(Some(-1))

# spec-case: OPTION-FLOW-1
public def test_option_narrowing_generic_payload_and_guard() -> bool:
    present: Option[int] = Some(42)
    missing: Option[int] = None
    return fallback(present, 0) == 42 and fallback(missing, 7) == 7 and generic_positive(present)

# spec: OPTION-FLOW-3
public def test_option_narrowing_reassignment_and_loop_guard() -> bool:
    candidate: Option[int] = Some(42)
    total = 0
    while candidate is not None:
        total += candidate
        candidate = None
    return total == 42 and candidate is None

# spec-case: OPTION-FLOW-3
public def test_option_narrowing_survives_unrelated_loop_writes() -> bool:
    candidate: Option[int] = Some(40)
    if candidate is None:
        return False
    total = 0
    for index in range(2):
        total += index
    return candidate + total == 41

# spec-case: OPTION-FLOW-1
public def test_option_narrowing_else_negation_and_original_context() -> bool:
    candidate: Option[int] = Some(42)
    if candidate is None:
        return False
    else:
        copied: Option[int] = candidate
        if copied is None:
            return False
        return copied == candidate

# spec-case: OPTION-FLOW-2
public def test_option_narrowing_two_guard_conjunction() -> bool:
    first: Option[int] = Some(40)
    second: Option[int] = Some(2)
    if first is not None and second is not None:
        return first + second == 42
    return False

# spec-case: OPTION-FLOW-1
public def test_option_narrowing_negated_guard() -> bool:
    candidate: Option[int] = Some(42)
    if not (candidate is None):
        return candidate == 42
    return False

# spec-case: OPTION-FLOW-1
public def test_option_narrowing_record_write_preserves_wrapper() -> bool:
    candidate: Option[Widget] = Some(Widget(width=40))
    if candidate is None:
        return False
    candidate.width = candidate.width + 2
    copied: Option[Widget] = candidate
    return candidate.width == 42 and width(copied) == 42

# spec-case: OPTION-FLOW-1
public def test_option_narrowing_record_write_preserves_independent_value() -> bool:
    counter = Counter(value=40)
    candidate: Option[Counter] = Some(counter)
    if candidate is None:
        return False
    candidate.value = candidate.value + 2
    return candidate.value == 42 and counter.value == 40

# spec-case: OPTION-FLOW-1
public def test_option_narrowing_collection_methods_and_index_writes() -> bool:
    items: list[int] = [40]
    candidate: Option[list[int]] = Some(items)
    count = append_one(mut candidate, 2)
    if candidate is None:
        return False
    candidate[0] = candidate[0] + candidate[1]
    return count == 2 and items[0] == 42

# spec-case: OPTION-FLOW-2
public def test_option_narrowing_false_disjunction_and_repeated_guard() -> bool:
    first: Option[int] = Some(40)
    second: Option[int] = Some(2)
    if first is None or second is None:
        return False
    if first is None:
        return False
    return first + second == 42

# spec-case: OPTION-FLOW-4
# spec-case: GENERIC-EXPECTED-1
public def test_option_narrowing_tests_and_contextual_calls_evaluate_once() -> bool:
    counter: list[int] = [0]
    if observe(mut counter) is None:
        return False
    value: Option[int] = inferred_identity(observe(mut counter))
    if value is None or observe(mut counter) is None:
        return False
    return value == 2 and counter[0] == 3
