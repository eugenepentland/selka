module field_augmented


record FieldCounter:
    n: int
    total: float
    label: str
    items: list[int]


record FieldPoint:
    x: int
    y: int


record FieldHolder:
    inner: FieldCounter
    point: FieldPoint


def bump(counter: FieldCounter) -> FieldCounter:
    updated = counter
    updated.n += 1
    updated.n *= 3
    updated.n -= 1
    updated.n //= 2
    updated.n %= 5
    updated.total += 0.5
    updated.total /= 2.0
    updated.label += "!"
    return updated


def reset(counter: mut FieldCounter) -> int:
    counter.items.append(100)
    return 1


def new_counter() -> FieldCounter:
    return FieldCounter(n=1, total=1.0, label="a", items=[1])


# An augmented assignment to a class field reads the field, applies the
# operator's ordinary rules and stores the result, like a binding does.
# spec: AUGMENTED-FIELD-1
public def test_augmented_assignment_updates_a_record_value() -> bool:
    c = new_counter()
    c = bump(c)
    return c.n == 2 and c.total == 0.75 and c.label == "a!"


# Record fields, nested field paths and fields of list elements take the same
# operators, each evaluating its owner once.
# spec-case: AUGMENTED-FIELD-1
public def test_augmented_assignment_reaches_records_nested_paths_and_list_slots() -> bool:
    p = FieldPoint(x=1, y=2)
    p.x += 10
    p.y -= 5
    h = FieldHolder(inner=new_counter(), point=FieldPoint(x=0, y=0))
    h.inner.n += 4
    h.point.y += 7
    points = [FieldPoint(x=1, y=1)]
    points[0].x += 5
    return p.x == 11 and p.y == -3 and h.inner.n == 5 and h.point.y == 7 and points[0].x == 6


# `+=` updates the field while an explicit copy keeps its earlier contents.
# spec-case: AUGMENTED-FIELD-1
public def test_augmented_addition_to_a_list_field_extends_in_place() -> bool:
    c = new_counter()
    before = c.items.copy()
    c.items += [9, 8]
    return len(c.items) == 3 and c.items[2] == 8 and before == [1]


# Python reads the field before it evaluates the right-hand side.
# spec-case: AUGMENTED-FIELD-1
public def test_augmented_field_reads_the_field_before_the_right_side() -> bool:
    c = new_counter()
    c.n += reset(mut c)
    return c.n == 2


def main() -> int:
    return 0
