# Deterministic stand-in capabilities (SPEC.md TEST-CAPS-1, TEST-CAPS-3,
# TEST-CAPS-4). The helpers below take a capability the way application code
# does; the tests hand them stand-ins built in place, or the ones `mylang test`
# supplies to a test that declares a capability parameter.
import environment
import filesystem
import network
import random
import time

# Unix nanoseconds the clock reads, or -1 when it cannot be read.
func stamp(clock: Clock) -> int:
    match time.now(clock):
        case Ok(instant):
            return instant.unix_nanoseconds
        case Err(_):
            return -1


# The first word of a generator seeded from `entropy`, or 0 when it fails.
func first_word(entropy: Entropy) -> u64:
    match random.from_entropy(entropy):
        case Ok(sampled):
            mut generator = sampled
            return random.next_word(mut generator)
        case Err(_):
            return 0u64


# Seconds from `start` to the clock's reading, as a caller of `now` sees them.
func seconds_since(clock: Clock, start: time.Instant) -> int:
    match time.now(clock):
        case Ok(current):
            match time.elapsed(start, current):
                case Ok(span):
                    return time.to_milliseconds(span) // 1000
                case Err(_):
                    return -1
        case Err(_):
            return -1


# Append one line to a log file through whatever filesystem it is given.
func log(fs: Filesystem, line: str) -> bool:
    with fs.open("log.txt", "a") as f:
        _ = f.write(line + "\n")
    return fs.exists("log.txt")


# A text result's value, or its message behind an `error: ` prefix.
func text(result: Result[str, str]) -> str:
    match result:
        case Ok(value):
            return value.copy()
        case Err(message):
            return "error: " + message


# Whether a unit result succeeded.
func done(result: Result[Unit, str]) -> bool:
    match result:
        case Ok(_):
            return True
        case Err(_):
            return False


# A byte result's value, or no bytes.
func data(result: Result[bytes, str]) -> bytes:
    match result:
        case Ok(value):
            return value.copy()
        case Err(_):
            return b""


# A listing's names, or one `error` entry.
func names(result: Result[str[], str]) -> str[]:
    match result:
        case Ok(value):
            return value.copy()
        case Err(_):
            return ["error"]


# The `HOME` an application would read, with a fallback.
func home(env: Environment) -> str:
    match env.get("HOME"):
        case Some(value):
            return value.copy()
        case None:
            return "/"


# spec: TEST-CAPS-1
public func test_simulated_clock_reads_its_start_until_advanced() -> bool:
    mut clock = time.simulated_clock(time.from_unix_nanoseconds(1000))
    mut before = stamp(clock)
    mut again = stamp(clock)
    match time.seconds(90):
        case Ok(step):
            match time.advance(clock, step):
                case Ok(_):
                    return before == 1000 and again == 1000 and stamp(clock) == 90000001000
                case Err(_):
                    return False
        case Err(_):
            return False


# Borrowed parameters name the same provider without copying its owner.
func advance_borrowed_clock(alias: Clock, step: time.Duration) -> Result[Unit, str]:
    return time.advance(alias, step)


# spec-case: TEST-CAPS-1
public func test_borrowed_simulated_clock_shares_one_reading() -> bool:
    mut clock = time.simulated_clock(time.from_unix_nanoseconds(0))
    mut start = time.from_unix_nanoseconds(0)
    match time.seconds(3):
        case Ok(step):
            _ = advance_borrowed_clock(clock, step)
        case Err(_):
            return False
    return seconds_since(clock, start) == 3


# spec-case: TEST-CAPS-1
public func test_a_simulated_clock_rejects_leaving_the_nanosecond_range() -> bool:
    mut clock = time.simulated_clock(time.from_unix_nanoseconds(9223372036854775807))
    match time.advance(clock, time.nanoseconds(1)):
        case Ok(_):
            return False
        case Err(message):
            return message == "the simulated clock would leave the 64-bit nanosecond range" and stamp(clock) == 9223372036854775807


# spec-case: TEST-CAPS-1
public func test_seeded_entropy_is_a_reproducible_stream() -> bool:
    mut first = first_word(random.seeded_entropy(7))
    mut again = first_word(random.seeded_entropy(7))
    mut other = first_word(random.seeded_entropy(8))
    mut entropy = random.seeded_entropy(7)
    mut advanced = first_word(entropy)
    mut moved = first_word(entropy)
    return first == again and first != other and advanced == first and moved != first


# spec-case: TEST-CAPS-1
public func test_memory_filesystem_supports_the_whole_path_helpers() -> bool:
    mut fs = filesystem.memory()
    mut written = done(fs.write_text("notes.txt", "hello"))
    mut read = text(fs.read_text("notes.txt"))
    mut made = done(fs.mkdir("data"))
    mut nested = done(fs.write_file("data/raw.bin", b"\x00\x01"))
    mut raw = data(fs.read_file("data/raw.bin"))
    mut listing = names(fs.listdir(""))
    mut removed = done(fs.remove("notes.txt"))
    mut gone = not fs.exists("notes.txt")
    return written and read == "hello" and made and nested and raw == b"\x00\x01" and listing == ["data", "notes.txt"] and removed and gone


# spec-case: TEST-CAPS-1
public func test_memory_filesystem_reports_errors_like_a_restricted_root() -> bool:
    mut fs = filesystem.memory()
    mut missing = text(fs.read_text("absent.txt"))
    mut escape = text(fs.read_text("../escape"))
    mut absolute = text(fs.read_text("/etc/hostname"))
    mut orphan = done(fs.write_text("no/such/dir.txt", "x"))
    _ = fs.mkdir("full")
    _ = fs.write_text("full/child", "x")
    mut busy = done(fs.remove("full"))
    mut denied = "denied: outside the granted directories, or the mode needs a write grant"
    return missing == "error: read 'absent.txt': failed: the path does not exist or could not be used" and escape == "error: read '../escape': " + denied and absolute == "error: read '/etc/hostname': " + denied and not orphan and not busy


# spec-case: TEST-CAPS-1
public func test_memory_filesystem_opens_files_with_python_modes() -> bool:
    mut fs = filesystem.memory()
    with fs.open("lines.txt", "w") as f:
        _ = f.write("one\n")
        _ = f.write("two\n")
    mut first = log(fs, "a")
    mut second = log(fs, "b")
    mut lines: str[] = []
    with fs.open("lines.txt", "r") as g:
        lines = g.readlines()
    with fs.open("lines.txt", "w") as h:
        _ = h.write("over")
    return first and second and lines == ["one\n", "two\n"] and text(fs.read_text("log.txt")) == "a\nb\n" and text(fs.read_text("lines.txt")) == "over"


# spec-case: TEST-CAPS-1
public func test_memory_filesystem_narrowing_stays_in_memory() -> bool:
    mut fs = filesystem.memory()
    _ = fs.mkdir("data")
    with fs.dir("data") as scoped:
        with fs.read_only() as frozen:
            mut inside = done(scoped.write_text("x.txt", "1"))
            mut outside = text(fs.read_text("data/x.txt"))
            mut refused = done(frozen.write_text("y.txt", "2"))
            mut readable = text(frozen.read_text("data/x.txt"))
            mut escape = text(scoped.read_text("../notes.txt"))
            return inside and outside == "1" and not refused and readable == "1" and not fs.exists("y.txt") and escape.startswith("error: ")


# spec-case: TEST-CAPS-1
public func test_fixed_environment_answers_only_its_pairs() -> bool:
    mut env = environment.fixed({"LANG": "C", "HOME": "/home/test"})
    with env.only("HOME") as narrowed:
        return home(env) == "/home/test" and env.get("PATH") is None and env.names() == ["HOME", "LANG"] and home(narrowed) == "/home/test" and narrowed.names() == ["HOME"]


# spec-case: TEST-CAPS-1
public func test_empty_fixed_environment_has_no_names() -> bool:
    mut env = environment.fixed({})
    return home(env) == "/" and len(env.names()) == 0


# spec-case: TEST-CAPS-1
public func test_denied_network_refuses_every_connection() -> bool:
    mut net = network.denied()
    with net.host("127.0.0.1:8000") as scoped:
        match network.connect(scoped):
            case network.Connected.ok(_):
                return False
            case network.Connected.err(code):
                return code == network.denied_here() and network.describe(code) == "network access is denied in this context: this Network is a deterministic stand-in"


# spec-case: TEST-CAPS-3
public func test_runner_clock_starts_at_the_documented_instant(clock: Clock) -> bool:
    mut start = time.from_unix_nanoseconds(946684800000000000)
    match time.seconds(60):
        case Ok(step):
            _ = time.advance(clock, step)
        case Err(_):
            return False
    return seconds_since(clock, start) == 60


# spec-case: TEST-CAPS-3
public func test_runner_capabilities_are_empty_and_deterministic(fs: Filesystem, env: Environment, net: Network, entropy: Entropy) -> bool:
    mut empty = len(names(fs.listdir(""))) == 0 and len(env.names()) == 0
    mut logged = log(fs, "first")
    with net.host("127.0.0.1:80") as scoped:
        match network.connect(scoped):
            case network.Connected.ok(_):
                return False
            case network.Connected.err(code):
                return empty and logged and code == network.denied_here() and first_word(entropy) != first_word(entropy)
