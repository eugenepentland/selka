record Label:
    text: bytes
    number: int


record Row:
    label: Label
    other: int


record HeldRow:
    view: list[int]
    number: int


def selected(rows: list[Row], at: int, output: mut list[int]) -> int:
    number = rows[at].label.number
    output.append(number)
    return number


def total(rows: list[Row]) -> int:
    i = 0
    answer = 0
    while i < len(rows):
        row = rows[i]
        answer += row.label.number
        i += 1
    return answer


def replace(rows: mut list[Row]) -> int:
    rows[0] = Row(Label(b"new", 9), 11)
    return 0


def callback(rows: mut list[Row]) -> int:
    return rows[replace(mut rows)].label.number


def materialize(rows: list[Row], at: int, output: mut list[int]) -> Row:
    row = rows[at]
    output.append(row.other)
    return row


def held(rows: list[HeldRow], output: mut list[int]) -> int:
    number = rows[0].number
    output.append(number)
    return number


# spec-case: RC-PLAIN-FIELD-LOAN-1
public def test_nested_fields_keep_bounds_and_copy_the_scalar() -> bool:
    rows = [Row(Label(b"a" + bytes([49]), 3), 7), Row(Label(b"b" + bytes([50]), 5), 11)]
    output: list[int] = []
    first = selected(rows, 0, mut output)
    last = selected(rows, -1, mut output)
    rows[0] = Row(Label(b"changed", 99), 101)
    return first == 3 and last == 5 and output == [3, 5]


# spec-case: RC-SCALAR-LENGTH-BODY-1
public def test_readonly_length_loop_keeps_managed_local_bits_borrowed() -> bool:
    rows = [Row(Label(b"a" + bytes([49]), 3), 7), Row(Label(b"b" + bytes([50]), 5), 11)]
    return total(rows) == 8 and total([]) == 0 and rows[0].label.text == b"a1"


# spec-case: RC-PLAIN-FIELD-LOAN-1
public def test_callback_keeps_the_receiver_snapshot() -> bool:
    rows = [Row(Label(b"old" + bytes([49]), 3), 7)]
    value = callback(mut rows)
    return value == 3 and rows[0].label.number == 9


# spec-case: RC-PLAIN-FIELD-LOAN-1
public def test_escaped_record_keeps_ordinary_ownership() -> bool:
    rows = [Row(Label(b"old" + bytes([49]), 3), 7)]
    output: list[int] = []
    row = materialize(rows, 0, mut output)
    rows.clear()
    return row.label.text == b"old1" and row.label.number == 3 and output == [7]


# spec-case: RC-PLAIN-FIELD-LOAN-1
public def test_snapshot_sibling_stays_independent() -> bool:
    mapping = {1: 7}
    rows = [HeldRow(list(mapping.values()), 3)]
    output: list[int] = []
    value = held(rows, mut output)
    mapping[1] = 9
    return value == 3 and output == [3] and list(rows[0].view) == [7]


# spec-case: RC-PLAIN-FIELD-LOAN-1
public def test_caller_arena_keeps_the_root_until_field_read() -> bool:
    output: list[int] = []
    value = 0
    with arena():
        rows = [Row(Label(b"arena" + bytes([49]), 3), 7)]
        value = selected(rows, -1, mut output)
    return value == 3 and output == [3]


def main(out: Stream) -> int:
    out.print(test_nested_fields_keep_bounds_and_copy_the_scalar())
    out.print(test_readonly_length_loop_keeps_managed_local_bits_borrowed())
    out.print(test_callback_keeps_the_receiver_snapshot())
    out.print(test_escaped_record_keeps_ordinary_ownership())
    out.print(test_snapshot_sibling_stays_independent())
    out.print(test_caller_arena_keeps_the_root_until_field_read())
    return 0
