# Arguments evaluate left to right, and a read-only argument is a value of its
# own: a record field read before a later argument's `mut` call keeps the
# value it had when it was read (QBE-AGGREF-10). Both runtimes agree.
record Point:
    x: int
    y: int


record Pair:
    a: Point
    b: Point
    items: list[int]


record Shape:
    corner: Pair
    count: int


def move(shape: mut Shape) -> int:
    shape.corner.a.x = 100
    shape.corner.b = Point(7, 7)
    shape.count = 50
    return 5


def weigh(point: Point, extra: int) -> int:
    return point.x * 1000 + point.y * 10 + extra


def span(pair: Pair, extra: int) -> int:
    return pair.a.x * 10000 + pair.b.y * 100 + extra


def moved_corner(shape: mut Shape) -> int:
    return weigh(shape.corner.a, move(mut shape))


# spec: QBE-AGGREF-10
public def test_a_field_argument_keeps_its_value_across_a_later_mut_call() -> bool:
    shape = Shape(Pair(Point(1, 2), Point(3, 4), [1]), 0)
    first = weigh(shape.corner.a, move(mut shape))
    return first == 1025 and shape.corner.a.x == 100 and shape.count == 50


# spec-case: QBE-AGGREF-10
public def test_a_nested_record_argument_keeps_its_value_across_a_later_mut_call() -> bool:
    shape = Shape(Pair(Point(1, 2), Point(3, 4), [1]), 0)
    seen = span(shape.corner, move(mut shape))
    return seen == 10405 and shape.corner.b.y == 7


# spec-case: QBE-AGGREF-10
public def test_a_mut_parameter_field_argument_keeps_its_value() -> bool:
    shape = Shape(Pair(Point(1, 2), Point(3, 4), [1]), 0)
    seen = moved_corner(mut shape)
    return seen == 1025 and shape.corner.a.x == 100


def main(out: Stream) -> int:
    out.print(test_a_field_argument_keeps_its_value_across_a_later_mut_call())
    out.print(test_a_nested_record_argument_keeps_its_value_across_a_later_mut_call())
    out.print(test_a_mut_parameter_field_argument_keeps_its_value())
    return 0
