# Arguments evaluate left to right, and a read-only argument is a value of its
# own: a record field read before a later argument's `mut` call keeps the
# value it had when it was read (QBE-AGGREF-10). Both runtimes agree.
record Point:
    x: int
    y: int


record Pair:
    a: Point
    b: Point
    items: int[]


record Shape:
    corner: Pair
    count: int


func move(mut shape: Shape) -> int:
    shape.corner.a.x = 100
    shape.corner.b = Point(x=7, y=7)
    shape.count = 50
    return 5


func weigh(point: Point, extra: int) -> int:
    return point.x * 1000 + point.y * 10 + extra


func span(pair: Pair, extra: int) -> int:
    return pair.a.x * 10000 + pair.b.y * 100 + extra


func moved_corner(mut shape: Shape) -> int:
    return weigh(shape.corner.a, move(mut shape))


public func test_a_field_argument_keeps_its_value_across_a_later_mut_call() -> bool:
    mut shape = Shape(corner=Pair(a=Point(x=1, y=2), b=Point(x=3, y=4), items=[1]), count=0)
    mut first = weigh(shape.corner.a, move(mut shape))
    return first == 1025 and shape.corner.a.x == 100 and shape.count == 50


public func test_a_nested_record_argument_keeps_its_value_across_a_later_mut_call() -> bool:
    mut shape = Shape(corner=Pair(a=Point(x=1, y=2), b=Point(x=3, y=4), items=[1]), count=0)
    mut seen = span(shape.corner, move(mut shape))
    return seen == 10405 and shape.corner.b.y == 7


public func test_a_mut_parameter_field_argument_keeps_its_value() -> bool:
    mut shape = Shape(corner=Pair(a=Point(x=1, y=2), b=Point(x=3, y=4), items=[1]), count=0)
    mut seen = moved_corner(mut shape)
    return seen == 1025 and shape.corner.a.x == 100


func main(out: Stream) -> int:
    out.print(test_a_field_argument_keeps_its_value_across_a_later_mut_call())
    out.print(test_a_nested_record_argument_keeps_its_value_across_a_later_mut_call())
    out.print(test_a_mut_parameter_field_argument_keeps_its_value())
    return 0
