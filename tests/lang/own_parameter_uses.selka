func union_read(own p: Slot, flag: bool) -> int:
    mut r = 0
    match p:
        case empty:
            r = 1
        case pair(..) | one(..):
            r = 2
    return r


public func test_own_union_read() -> bool:
    const v = make_union(1)
    const w = make_union(2)
    return union_read(own v, True) + union_read(own w, False) == 4


func union_part_read(own p: Slot, flag: bool) -> int:
    mut r = 0
    match p:
        case pair(left, right):
            r = r + len(left) + len(right)
        case one(value):
            r = r + value.n
        case empty:
            r = r + 0
    return r


