func make_union(n: int) -> Slot:
    if n == 0:
        return Slot.empty
    return Slot.pair(left=["a" + str(n)], right=["b"])


func borrow_kind_union(x: Slot) -> int:
    match x:
        case empty:
            return 0
        case pair(..) | one(..):
            return 1


func sink_kind_union(own x: Slot) -> int:
    mut keep: Slot[] = []
    append(mut keep, own x)
    return len(keep)


func union_unused(own p: Slot, flag: bool) -> int:
    mut r = 0
    r = 0
    return r


