# An `own` parameter of each managed kind, used each way: unused, read, a part read, lent to a borrowing call, a part
# or the whole moved out, read in a loop, and read on one branch while moved on the other (lane G, D-G-1). The gate's
# Debug compiler validates the ownership certificate of every function it builds; before D-G-1 an `own` record whose
# managed fields were each read once (the record, record2 and inlined borrow cells) was lowered as an emptied record,
# a parameter state the certificate cannot state (E_OWNERSHIP_VALIDATION, J1).
import sets

record Holder:
    refs: str[]
    n: int


record Holder2:
    refs: str[]
    name: str


record Outer:
    inner: Holder
    tag: str


enum Slot:
    empty
    pair(left: str[], right: str[])
    one(value: Holder)


func sink_list(own xs: str[]) -> int:
    mut keep: str[][] = []
    append(mut keep, own xs)
    return len(keep)


func sink_h(own h: Holder) -> int:
    mut keep: Holder[] = []
    append(mut keep, own h)
    return len(keep)


func make_list(n: int) -> int[]:
    return [n, n + 1]


func borrow_kind_list(x: int[]) -> int:
    return len(x)


func sink_kind_list(own x: int[]) -> int:
    mut keep: int[][] = []
    append(mut keep, own x)
    return len(keep)


func list_unused(own p: int[], flag: bool) -> int:
    mut r = 0
    r = 0
    return r


public func test_own_list_unused() -> bool:
    const v = make_list(1)
    const w = make_list(2)
    return list_unused(own v, True) + list_unused(own w, False) == 0


func list_read(own p: int[], flag: bool) -> int:
    mut r = 0
    r = len(p)
    return r


public func test_own_list_read() -> bool:
    const v = make_list(1)
    const w = make_list(2)
    return list_read(own v, True) + list_read(own w, False) == 4


func list_part_read(own p: int[], flag: bool) -> int:
    mut r = 0
    r = r + p[0]
    return r


public func test_own_list_part_read() -> bool:
    const v = make_list(1)
    const w = make_list(2)
    return list_part_read(own v, True) + list_part_read(own w, False) == 3


func list_borrow_call(own p: int[], flag: bool) -> int:
    mut r = 0
    r = r + borrow_kind_list(p)
    return r


public func test_own_list_borrow_call() -> bool:
    const v = make_list(1)
    const w = make_list(2)
    return list_borrow_call(own v, True) + list_borrow_call(own w, False) == 4


func list_move_whole(own p: int[], flag: bool) -> int:
    mut r = 0
    r = r + sink_kind_list(own p)
    return r


public func test_own_list_move_whole() -> bool:
    const v = make_list(1)
    const w = make_list(2)
    return list_move_whole(own v, True) + list_move_whole(own w, False) == 2


func list_loop_read(own p: int[], flag: bool) -> int:
    mut r = 0
    for _ in range(3):
        r = r + p[0]
    return r


public func test_own_list_loop_read() -> bool:
    const v = make_list(1)
    const w = make_list(2)
    return list_loop_read(own v, True) + list_loop_read(own w, False) == 9


func list_branch(own p: int[], flag: bool) -> int:
    mut r = 0
    if flag:
        r = r + p[0]
    else:
        r = r + sink_kind_list(own p)
    return r


public func test_own_list_branch() -> bool:
    const v = make_list(1)
    const w = make_list(2)
    return list_branch(own v, True) + list_branch(own w, False) == 2


func list_branch_whole(own p: int[], flag: bool) -> int:
    mut r = 0
