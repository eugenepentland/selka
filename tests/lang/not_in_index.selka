# `not in` after an index, a slice, a field, a call and a literal. `selka fmt` once wrote `names[i]not in seen`, so the file
# is the formatter's regression too: the `my_format` gate checks that it is already canonical.
record Holder:
    name: str


func first_new(names: str[], seen: dict[str, int]) -> int:
    for i in range(len(names)):
        if names[i] not in seen:
            return i
    return -1


public func test_not_in_after_an_index() -> bool:
    const seen: dict[str, int] = {"a": 1, "b": 2}
    return first_new(["a", "b", "c"], seen) == 2 and first_new(["a", "b"], seen) == -1


public func test_in_after_an_index() -> bool:
    const seen: dict[str, int] = {"a": 1}
    const names: str[] = ["a", "z"]
    return names[0] in seen and names[1] not in seen


public func test_not_in_after_a_field_a_call_and_a_literal() -> bool:
    const seen: dict[str, int] = {"a": 1}
    const holder = Holder(name="b")
    const names: str[] = ["a"]
    return holder.name not in seen and str(len(names)) not in seen and "b" not in seen


public func test_not_in_after_a_slice() -> bool:
    const text = "abcd"
    const seen: dict[str, int] = {"ab": 1}
    return text[0:2] in seen and text[1:3] not in seen


public func test_is_none_and_not_after_an_index() -> bool:
    const items: int?[] = [None, 3]
    return items[0] is None and not (items[1] is None)
