    "def main(fs: Filesystem, out: Stream) -> int:\n    out.print(write_text(fs, \"out.txt\", \"first\\nsecond\\n\"))\n    with open(fs, \"out.txt\", \"a\") as f:\n        out.print(f.write(\"third\\n\"))\n    out.print(read_text(fs, \"out.txt\"))\n    with open(fs, \"out.txt\", \"r\") as f:\n        out.print(f.readline(), f.read(3), f.read())\n        f.flush()\n        f.close()\n    out.print(write_file(fs, \"raw.bin\", b\"\\x00\\x01\\xff\"))\n    out.print(read_file(fs, \"raw.bin\"))\n    out.print(mkdir(fs, \"nested\"), write_text(fs, \"nested/inner.txt\", \"x\"))\n    out.print(read_text(fs, \"nested/inner.txt\"), exists(fs, \"nested\"))\n    out.print(remove(fs, \"nested/inner.txt\"), remove(fs, \"nested\"), exists(fs, \"nested\"))\n    out.print(remove(fs, \"missing.txt\"))\n    out.print(write_text(fs, \"out.txt\", \"again\\n\"), read_text(fs, \"out.txt\"))\n    return 0\n",
