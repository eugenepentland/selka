  "056759b64efd53a7f4c0a29288290f3b": {
   "case": [
    "def first(fs: Filesystem, path: str) -> Result[int, str]:\n    with open(fs, path, \"r\")? as f:\n        return Ok(len(f.readline()))\n\ndef main(fs: Filesystem, out: Stream) -> int:\n    total = 0\n    for round in range(4):\n        with open(fs, \"lines.txt\", \"r\") as f:\n            if round == 1:\n                continue\n            if round == 3:\n                break\n            total = total + len(f.readline())\n    match first(fs, \"greeting.txt\"):\n        case Ok(value):\n            total = total + value\n        case Err(message):\n            total = total - len(message)\n    match first(fs, \"absent.txt\"):\n        case Ok(value):\n            out.print(value)\n        case Err(message):\n            out.print(message)\n    out.print(total)\n    return 0\n",
