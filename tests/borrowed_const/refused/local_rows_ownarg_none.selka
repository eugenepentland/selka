record Holder:
    items: int[]
    tag: int


func measure(xs: int[]) -> int:
    return len(xs)


func bump(mut xs: int[]):
    append(mut xs, 1)


func keep_own(own xs: int[]) -> int:
    return len(xs)


func cell_local_rows_ownarg_none() -> int:
    mut o: int[][] = [[1, 2, 3], [4, 5]]
    mut total = 0
    const e = o[1]
    total += keep_own(own e)
    return total


func main(out: Stream) -> int:
    print(out, 0)
    return 0
