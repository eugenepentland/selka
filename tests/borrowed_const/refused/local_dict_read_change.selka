record Holder:
    items: int[]
    tag: int


func measure(xs: int[]) -> int:
    return len(xs)


func bump(mut xs: int[]):
    append(mut xs, 1)


func keep_own(own xs: int[]) -> int:
    return len(xs)


func cell_local_dict_read_change() -> int:
    mut o: dict[str, int[]] = {"a": [4, 5]}
    mut total = 0
    const e = o["a"]
    o["z"] = [7]
    total += len(e)
    return total


func main(out: Stream) -> int:
    print(out, 0)
    return 0
