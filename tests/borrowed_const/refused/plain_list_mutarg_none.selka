record Holder:
    items: int[]
    tag: int


func measure(xs: int[]) -> int:
    return len(xs)


func bump(mut xs: int[]):
    append(mut xs, 1)


func keep_own(own xs: int[]) -> int:
    return len(xs)


func cell_plain_list_mutarg_none(o: int[]) -> int:
    mut total = 0
    const e = o
    bump(mut e)
    total += len(e)
    return total


func main(out: Stream) -> int:
    print(out, 0)
    return 0
