# Runtime stress for COW-SHARED-1. A non-borrowed copy of 1,100
# collection-bearing recursive boxes transfers their immutable pointers
# without a depth trap. Projecting each box remains safe and a later write
# leaves the copy's outer list unchanged.


record Node:
    items: list[int]
    next: Option[Node]


def main(out: Stream) -> int:
    node = Node(items=[0], next=None)
    i = 0
    while i < 1100:
        node = Node(items=[i], next=Some(node))
        i += 1
    copied = node
    node.items.append(-1)
    if len(copied.items) != 1 or len(node.items) != 2:
        return 1
    cursor: Option[Node] = Some(copied)
    seen = 0
    while cursor is not None:
        if len(cursor.items) != 1:
            return 2
        cursor = cursor.next
        seen += 1
    if seen != 1101:
        return 3
    out.print(copied.items[0])
    return 0
