# Runtime stress for RECURSIVE-VALUES-3. A guest test's step budget rejects this
# much construction, so build and run the native binary directly on each backend.


record Node:
    value: int
    left: Option[Node]


def chain(length: int) -> Option[Node]:
    head: Option[Node] = None
    for index in range(length):
        head = Some(Node(value=index, left=head))
    return head


def main() -> int:
    first = chain(1000000)
    second = chain(1000000)
    if first != second:
        return 1
    keys: set[Option[Node]] = set()
    keys.add(first)
    keys.add(second)
    if len(keys) != 1:
        return 2
    return 0
