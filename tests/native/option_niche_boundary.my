module option_niche_boundary

# An `Option` of a managed reference is one nullable word inside the program
# (QBE-NICHE-1), but the copied-value boundary still carries it as the case
# node and payload every other optional crosses as. Each case below reads or
# writes such an optional through the `--cases` channel, which shares the
# checked-schema codec with `mylang invoke`, so an adapter that read a tag word
# where there is none would change the case's value instead of passing.


public def test_optional_text_argument(word: Option[str]) -> i64 effects():
    if word is None:
        return -1
    return len(word)


public def test_optional_text_result(flag: bool) -> Option[str] effects(managed_allocation):
    if flag:
        return Some("n" + "iche")
    return None


public def test_optional_list_argument(values: Option[list[i64]]) -> i64 effects():
    if values is None:
        return -1
    total = 0
    for value in values:
        total += value
    return total


public def test_optional_list_result(count: i64) -> Option[list[i64]] effects(managed_allocation):
    if count < 0:
        return None
    return Some([index for index in range(count)])


public def test_optional_optional_text(value: Option[Option[str]]) -> i64 effects():
    match value:
        case Some(inner):
            if inner is None:
                return 0
            return len(inner)
        case None:
            return -1


public def test_list_of_optional_text(words: list[Option[str]]) -> list[Option[str]] effects(managed_allocation):
    result: list[Option[str]] = []
    for word in words:
        flipped: Option[str] = None
        if word is None:
            flipped = Some("-")
        result.append(flipped)
    return result


def main() -> int:
    return 0
