module aggref_arguments

# The native copied-value adapter passes one argument of a copyable aggregate
# type as the address of the argument buffer, the same crossing the QBE emitter
# spells (QBE-AGGREF-1). A record, an array and a nested record each cross that
# boundary here, so a regression to a by-value C parameter corrupts the case
# instead of silently passing. A zero-length aggregate and one past the
# 4096-byte by-value budget keep the same crossing, and the aggregate *result*
# and the scalar argument stay as they were and assert the other half of the
# same boundary.


public record Span:
    low: i64
    high: i64


public record Sample:
    label: i64
    span: Span
    weights: [3]i64


public record Empty:
    nothing: [0]i64


public record Large:
    values: [520]i64


public def test_record_argument(p: Span) -> i64:
    return p.low * 1000 + p.high


public def test_array_argument(values: [3]i64) -> i64:
    return values[0] * 100 + values[1] * 10 + values[2]


public def test_nested_record_argument(sample: Sample) -> i64:
    return sample.label + sample.span.low + sample.span.high + sample.weights[0] + sample.weights[1] + sample.weights[2]


public def test_zero_length_argument(empty: Empty) -> i64:
    return 7


public def test_large_argument(large: Large) -> i64:
    return large.values[0] + large.values[519]


public def test_scalar_argument(value: i64) -> i64:
    return value + 1


public def test_aggregate_result(seed: i64) -> Span:
    return Span(low=seed, high=seed + 1)


def main() -> int:
    return 0
