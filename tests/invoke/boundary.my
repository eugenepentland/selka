module boundary

# The copied-value boundary matrix's `mylang invoke` entry. Every shape the
# native copied-value adapter can carry is callable here by name, and
# `tests/native_boundary_matrix.py` drives each one through `--describe` and
# `--input` on both the QBE and the LLVM backend, so one shape list covers the
# matrix's invoke channel.
#
# The `Positive` domain keeps the codec-callback boundary in the matrix: its
# codec's wire record is a 16-byte copyable aggregate, so the implicit decoder
# and encoder receive that record by address (`methodArgument` reads the
# recorded `by_address` fact). It is the exact shape the pre-fix
# `size > 4096` adapter test got wrong. `codec_round_trip` runs both callbacks
# in one call — decode on the way in, encode on the way out — so a backend that
# disagreed about the wire record would be caught in either direction.
#
# The fixture must check: an earlier draft returned a `[520]i64` field built
# from a comprehension and called a domain member that was still `private`, and
# neither is expressible, so nothing here ran at all until both were fixed.


public record Span:
    low: i64
    high: i64


public record Sample:
    label: i64
    span: Span
    weights: [3]i64


public record Empty:
    nothing: [0]i64


public record Large:
    values: [520]i64


public record Packed:
    values: [260]i64


public union Choice:
    none,
    number: i64,
    span: Span


public record Wire:
    n: i64
    m: i64


public result Decoded:
    ok: Positive,
    err: i64


public domain Positive: i64:
    codec Wire:
        decode: from_wire,
        encode: to_wire

    def raw(x: i64) -> Positive:
        return wrap[Positive](x)

    def from_wire(x: Wire) -> Decoded effects():
        if x.n <= 0:
            return Err(-1)
        return Ok(Positive.raw(x.n + x.m))

    def to_wire(x: Positive) -> Wire effects():
        return Wire(n=unwrap(x), m=1)


public def scalar_argument(value: i64) -> i64 effects():
    return value + 1


public def record_argument(p: Span) -> i64 effects():
    return p.low * 1000 + p.high


public def nested_record_argument(sample: Sample) -> i64 effects():
    return sample.label + sample.span.low + sample.span.high + sample.weights[0] + sample.weights[1] + sample.weights[2]


public def array_argument(values: [3]i64) -> i64 effects():
    return values[0] * 100 + values[1] * 10 + values[2]


public def empty_argument(empty: Empty) -> i64 effects():
    return 7


public def large_argument(large: Large) -> i64 effects():
    return large.values[0] + large.values[519]


public def packed_arguments(first: Packed, second: Packed) -> i64 effects():
    return first.values[0] + first.values[259] + second.values[0] + second.values[259]


public def variant_argument(choice: Choice) -> i64 effects():
    match choice:
        case Choice.none:
            return 0
        case Choice.number(n):
            return n
        case Choice.span(s):
            return s.low + s.high


public def record_result(seed: i64) -> Span effects():
    return Span(low=seed, high=seed + 1)


public def empty_result(seed: i64) -> Empty effects():
    return Empty(nothing=[])


public def text_argument(text: str) -> i64 effects():
    return len(text)


public def text_result(seed: i64) -> str effects(managed_allocation):
    return "seed=" + str(seed)


public def text_round_trip(text: str) -> str effects(managed_allocation):
    return "[" + text + "]"


public def codec_round_trip(x: Positive) -> Positive effects():
    return x


public def codec_result(seed: i64) -> Positive effects():
    return Positive.raw(seed + 1)


def main() -> int:
    return 0
