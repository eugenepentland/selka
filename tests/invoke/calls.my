module calls

# The minimal shape a selective build has to lower: an export whose body calls
# another function. Naming only the target leaves the callee unemitted and the
# build fails, so this fixture is the sharpest guard for that selection and says
# nothing about lists, text or the codec. `quad` calls `twice` twice in one
# expression and `shifted` reaches `twice` through `quad`, so the closure has to
# be transitive and not one level deep.


public def twice(value: i64) -> i64 effects():
    return value * 2


public def quad(value: i64) -> i64 effects():
    return twice(twice(value))


public def shifted(value: i64) -> i64 effects():
    return quad(value) + 1
