module lists

# A callable library with no `main`: `mylang invoke` checks a private copy with
# the same stub entry the native guest-test runner uses, so a tool can be called
# without editing it or adding a dummy program entry.
#
# Every export here exercises one shape of the copied-value boundary: a list of
# scalars either way, a list of text, a nested list, and a text/list
# transformation returning a typed report. A record that merely *contains* a text
# or a list is still refused, and recorded as the next step rather than smuggled
# in through the rule that fits lists.


public def sum_numbers(values: list[i64]) -> i64 effects():
    total = 0
    for value in values:
        total += value
    return total


public def make_numbers(count: i64) -> list[i64] effects(managed_allocation):
    return [index for index in range(count)]


public def join_text(pieces: list[str]) -> str effects(managed_allocation):
    total = ""
    for piece in pieces:
        total = total + piece
    return total


public def bracket_all(text: str) -> list[str] effects(managed_allocation):
    return ["[" + text + "]", text]


public def lengths(pieces: list[str]) -> list[i64] effects(managed_allocation):
    return [len(piece) for piece in pieces]


public def row_totals(rows: list[list[i64]]) -> list[i64] effects(managed_allocation):
    return [sum(row) for row in rows]


public def scale_rows(rows: list[list[i64]], factor: i64) -> list[list[i64]] effects(managed_allocation):
    return [[value * factor for value in row] for row in rows]
