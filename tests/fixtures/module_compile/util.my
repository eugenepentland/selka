module util

# Declarations other modules' units read facts about: a template two modules
# instantiate with the same argument, a small leaf the inliner splices into
# callers, a pure function that writes its aggregate parameter, and function
# values handed to another module's indirect call.


public record Pair:
    left: int
    right: int


public def largest[T: integer](values: list[T]) -> T:
    best = values[0]
    for value in values:
        if value > best:
            best = value
    return best


public def twice(value: int) -> int effects():
    return value * 2


public def swapped(pair: Pair) -> int effects():
    pair = Pair(left=pair.right, right=pair.left)
    return pair.left * 10 + pair.right


public def plus_one(value: int) -> int effects():
    return value + 1


public def minus_one(value: int) -> int effects():
    return value - 1


public def pick(first: bool) -> def(int) -> int effects():
    if first:
        return plus_one
    return minus_one
