module dom


public domain Meters: u32:
    private def raw(value: u32) -> Meters:
        return wrap[Meters](value)

    def from(value: u32) -> Meters:
        if value > 1000u32:
            return Meters.raw(1000u32)
        return Meters.raw(value + 1u32)

    def number(value: Meters) -> u32:
        return unwrap(value)
