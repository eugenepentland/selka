import api
import dom
import lib
import reach
import shapes

func main() -> int:
    mut h = reach.holder()
    mut values: int[] = [1, 2, 3]
    lib.grow(mut values, 4)
    mut found = reach.firsts(h)[0].x + reach.table(h)["a"].y
    match reach.maybe(h):
        case Some(inner):
            found += inner.x
        case None:
            found += 0
    # The payloads other than `to` are bound but unread, so the harness can
    # retype them without breaking this module.
    match reach.event():
        case moved(to, steps):
            found += to.x
        case tagged(value=inner):
            found += 1
        case idle:
            found += 0
    mut point: api.Inner = shapes.origin()
    mut meters = dom.from(5u32)
    found += lib.total(h) + lib.double(point.x) + lib.pick(values, 0) + lib.STEPS + lib.old_total(h)
    found += i64(dom.number(meters)) + len(values)
    return found % 256
