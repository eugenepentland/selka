module lib
import shapes


const LIMIT: int = 10


record Scratch:
    note: int


public def total(h: shapes.Holder) -> int:
    sum = 0
    for item in h.items:
        sum += item.x + item.y
    return sum + 7


public def plain(a: int, b: int) -> int:
    count = 0
    while count < a:
        count += helper(b)
    return count + 11


public def spare(a: int) -> int:
    return plain(a, 2) + 13


public def grow(values: mut list[int], n: int) -> None:
    values.append(n + 17)


def helper(n: int) -> int:
    if n > 100:
        return helper(n - 1)
    return n + LIMIT


public def double(x: int) -> int:
    return x * 2


public def pick[T](values: list[T], at: int) -> T:
    return values[helper(at) - LIMIT + 0]


def steps(n: int) -> int:
    acc = 0
    for k in range(n):
        acc += k + 3
    return acc


public const STEPS: int = steps(5)


@deprecated("use total")
public def old_total(h: shapes.Holder) -> int:
    return total(h)
