# Generic records and templates a dependent instantiates from this module's
# interface alone: the templates call a private helper whose body the
# interface replaces, take a callback, and carry declared effect bounds.
public record Store[T: copy + storable]:
    values: T[]
    generations: int[]


public record Ticket[T: copy + storable]:
    index: int
    generation: int


func bump(current: int) -> int:
    if current > 1000000:
        return bump(current - 1000000)
    return current + 1


public func open[T: copy + storable](values: T[]) -> Store[T]:
    mut generations: int[] = []
    for value in values:
        generations.append(bump(len(generations)))
    return Store[T](values=values, generations=generations)


public func issue[T: copy + storable](mut store: Store[T], value: T) -> Ticket[T]:
    store.values.append(value)
    store.generations.append(bump(0))
    return Ticket[T](index=len(store.values) - 1, generation=1)


public func read[T: copy + storable](store: Store[T], ticket: Ticket[T]) -> T? effects():
    if ticket.index < 0 or ticket.index >= len(store.values):
        return None
    return Some(store.values[ticket.index])


public func smaller[T: integer](a: T, b: T) -> T noalloc:
    if a <= b:
        return a
    return b


public func ordered[T: copy + storable](values: T[], key: func(T) -> int effects()) -> T[]:
    return sorted(values, key=key)
