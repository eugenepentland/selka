module core.stats
import core.shapes


public def total_area(boxes: list[core.shapes.Box]) -> int:
    total = 0
    for box in boxes:
        total += core.shapes.area(box)
    return total


public def widest(boxes: list[core.shapes.Box]) -> int:
    widths: list[int] = []
    for box in boxes:
        widths.append(box.width)
    return core.shapes.largest(widths)
