# A project with a `mylang.json` (MODULE-PROJECT-1): source budgets, an
# import policy that keeps `core` below `app`, and a lint section. Its build
# takes the per-module path and makes the whole-program build's executable.
public record Box:
    width: int
    height: int


public func area(box: Box) -> int:
    return box.width * box.height


public func largest[T: integer](values: T[]) -> T:
    mut best = values[0]
    for value in values:
        if value > best:
            best = value
    return best


public func test_area() -> bool:
    return area(Box(width=3, height=4)) == 12
