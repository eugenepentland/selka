import model
import make
import measure

func main() -> int:
    mut s = make.scene()
    mut nodes: model.Node[] = []
    make.grow(mut nodes, 3)
    mut total = measure.indexed_x(s) + measure.first_child(s) + measure.radius_sum(s) + measure.pair_y(s) + measure.chained()
    total += measure.through_api(make.point(1, 1)) + measure.deepest(make.leaf(2)) + len(nodes)
    if measure.tinted(s):
        return total
    return 0
