

record Box[T]:
    value: T


record Reading:
    value: int


record TaggedReading:
    tag: bool
    value: int


func identity[T](value: T) -> T:
    return value


func head[T](values: T[]) -> Result[T, str]:
    if len(values) == 0:
        return Err("empty")
    return Ok(values[0])


func total[T: integer](value: T) -> T:
    if value == T(0):
        return value
    return value + total[T](value - T(1))


func contains[T: equality](items: T[], needle: T) -> bool:
    for item in items:
        if item == needle:
            return True
    return False


func field_value[T: copy + field(value: int)](item: T) -> int:
    return item.value


public func test_generic_functions() -> bool effects(managed_allocation):
    if identity[int](7) != 7 or identity[str]("ay") != "ay":
        return False
    if total[u8](4u8) != 10u8 or total[int](5) != 15:
        return False
    return contains[int]([1, 2, 3], 2) and not contains[int]([1, 2, 3], 9)


public func test_generic_records() -> bool effects(managed_allocation):
    mut box = Box[int](value=9)
    mut changed = box
    changed.value = 11
    mut words = Box[str](value="hello")
    return box.value == 9 and changed.value == 11 and words.value == "hello"


public func test_structural_contracts() -> bool effects():
    if field_value[Reading](Reading(value=2)) != 2:
        return False
    return field_value[TaggedReading](TaggedReading(tag=True, value=3)) == 3


public func test_generic_results() -> bool effects(managed_allocation):
    mut numbers: int[] = [4, 5, 6]
    mut empty: int[] = []
    match head[int](numbers):
        case Ok(value):
            if value != 4:
                return False
        case Err(_):
            return False
    match head[int](empty):
        case Ok(_):
            return False
        case Err(message):
            return message == "empty"


func main() -> int:
    return 0
