# lint: allow dead-private reason="This declaration is exercised during constant evaluation or through a callback value, outside direct runtime call edges."
func build(n: int) -> int effects():
    return n * 2


func apply(callback: func(int) -> int effects(), n: int) -> int effects():
    return callback(n)


func identity(callback: func(int) -> int effects()) -> func(int) -> int effects():
    return callback


func double_apply(callback: func(int) -> int effects(), n: int) -> int effects():
    return apply(callback, apply(callback, n))


func add(a: int, b: int) -> int noalloc:
    return a + b


func scale(value: int) -> int noalloc:
    return add(value, value) * 3


@allow("test-conditional", reason="This language regression intentionally exercises conditional failure paths.")
public func test_callbacks() -> bool effects():
    mut callback = identity(build)
    if apply(callback, 7) != 14:
        return False
    return double_apply(callback, 3) == 12


@allow("test-conditional", reason="This language regression intentionally exercises conditional failure paths.")
public func test_effect_ceilings() -> bool effects():
    if scale(7) != 42:
        return False
    return add(20, 22) == 42


func main() -> int:
    return 0
