module text
export test_indexing_and_slicing
export test_methods
export test_interpolation_and_conversion


def test_indexing_and_slicing() -> bool:
    greeting = "héllo"
    if len(greeting) != 5 or greeting[1] != "é" or greeting[-1] != "o":
        return False
    if greeting[1:3] != "él" or len(greeting[2:99]) != 3 or len(greeting[3:1]) != 0:
        return False
    joined = greeting + " " + "world"
    parts = joined.split(" ")
    return len(parts) == 2 and "-".join(parts) == "héllo-world"


def test_methods() -> bool:
    padded = "  ready  "
    if padded.strip() != "ready" or padded.lstrip() != "ready  " or padded.rstrip() != "  ready":
        return False
    if "Mylang".upper() != "MYLANG" or "Mylang".lower() != "mylang":
        return False
    if "7".zfill(3) != "007" or "-7".zfill(4) != "-007":
        return False
    if "banana".replace("na", "NA") != "baNANA":
        return False
    if "banana".find("na") != 2 or "banana".find("zz") != -1 or "banana".count("na") != 2:
        return False
    if not "banana".startswith("ban") or not "banana".endswith("ana"):
        return False
    if not "42".isdigit() or "".isdigit() or not "abc".isalpha() or not " \t".isspace():
        return False
    lines = "a\nb\r\nc".splitlines()
    if len(lines) != 3 or padded != "  ready  ":
        return False
    return "ell" in "hello" and "z" not in "hello"


def test_interpolation_and_conversion() -> bool:
    name = "ada"
    count = 3
    label = f"{name} has {count} items"
    if label != "ada has 3 items":
        return False
    if str(7) != "7" or str(True) != "True" or str(2.5) != "2.5":
        return False
    return len(f"") == 0 and f"{{literal}}" == "{literal}"


def main() -> int:
    return 0
