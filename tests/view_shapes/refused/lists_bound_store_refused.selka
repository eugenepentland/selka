record Bag:
    items: int[]


enum Slot:
    full(items: int[])
    empty


func payload_len(s: Slot) -> int:
    match s:
        case full(items=value):
            const piece = value[1:3]
            return len(piece)
        case empty:
            return 0


func run_cell(out: Stream) -> int:
    const xs = [1, 2, 3, 4]
    mut parts: int[][] = []
    const piece = xs[1:3]
    append(mut parts, piece)
    print(out, len(parts[0]))
    return 0


func main(out: Stream) -> int:
    return run_cell(out)
