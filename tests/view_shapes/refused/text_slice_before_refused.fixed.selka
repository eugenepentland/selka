func head(t: str) -> str from t:
    return t[0:2]


func middle(t: str) -> str from t:
    return t[1:3]


func bump(mut s: str):
    s += "-x"


record Item:
    name: str


enum Choice:
    named(name: str)
    none


func payload_piece(sh: Choice) -> str:
    match sh:
        case named(name=value):
            const piece = value[1:3]
            return copy(piece)
        case none:
            return "zz"


