
# Variant values keep their payload when the stored element is replaced after a
# copy was taken, when a held list payload is appended to through a binding, and
# when a `Result` carries an error record with bytes. This is the executed
# program of the retired QBE native variant snapshot test
# (`qbe_rc_native_variant_test.zig`, `RC-NATIVE-VARIANT-1`), which also read the
# emitted IL and the layout proofs of the native tag helpers.


record Fault:
    message: bytes


enum Choice:
    empty
    number(value: int)
    items(value: int[])


func forwarded(value: Choice) -> Choice:
    return value


func result(flag: bool) -> Result[int, Fault]:
    if flag:
        return Ok(17)
    return Err(Fault(message=bytes([65, 66])))


func retained(items: Choice[]) -> Choice:
    return items[0]


func snapshots() -> int:
    mut items = [Choice.items(value=[4]), Choice.empty]
    mut prior = retained(items)
    mut copied = forwarded(prior)
    items[0] = Choice.number(value=99)
    mut total = 0
    match copied:
        case Choice.items(value=values):
            mut changed = values
            changed.append(5)
            total += changed[0] + changed[1]
        case _:
            return -1
    match prior:
        case Choice.items(value=values):
            total += len(values)
        case _:
            return -2
    match result(True):
        case Ok(value):
            total += value
        case _:
            return -3
    match result(False):
        case Err(fault):
            total += len(fault.message)
        case _:
            return -4
    return total


public func test_native_snapshots_retained_loans_mutations_and_error_tags_survive() -> bool:
    return snapshots() == 29
