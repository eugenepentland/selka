# Fields read through a list element: a snapshot of an element keeps its value
# across a later element write, growth and many allocations; bytes fields and
# nested records are read through negative indices; an in-bounds read of either
# end answers; and a recursion whose every frame builds sixty records unwinds
# to the right total. These are the executed programs of the retired QBE
# aggregate projection tests (`qbe_test.zig`: `QBE-AGGREGATE-READ-1`,
# `QBE-BLOCKS-1` and the large-frame recursion of `QBE-FLOOR-GUARD-1`). The
# traps those tests also pinned (R_LIST_BOUNDS at index -2 and 1 of a
# one-element list, and the R_FRAME_LIMIT of the recursion under a four-frame
# ceiling) cannot be expected from a guest test. The `with arena():` block of
# the original is retired (S5-D3) and runs as an ordinary block, so its body is
# dedented here.
record Inner:
    value: int
    other: int


record Item:
    inner: Inner
    label: bytes


func projected(items: Item[], index: int) -> int:
    return items[index].inner.value


func label(items: Item[], index: int) -> bytes:
    return items[index].label


func snapshot(items: Item[], index: int) -> Item:
    return items[index]


func projection_answer() -> int:
    mut items = [Item(inner=Inner(value=7, other=8), label=b"old")]
    mut saved = snapshot(items, 0)
    mut name = label(items, -1)
    items[0] = Item(inner=Inner(value=9, other=10), label=b"new")
    mut i = 0
    while i < 40:
        items.append(Item(inner=Inner(value=i, other=0), label=b"grown" + b"!"))
        i += 1
    if saved.inner.value != 7 or saved.label != b"old" or name != b"old":
        return 1
    if projected(items, 0) != 9 or projected(items, -1) != 39:
        return 2
    return 42


public func test_a_snapshot_and_a_bytes_field_survive_element_writes_and_growth() -> bool:
    return projection_answer() == 42


record Pair:
    left: int
    right: int


func read(items: Pair[], index: int) -> int:
    return items[index].left


public func test_a_field_of_the_only_element_reads_from_either_end() -> bool:
    mut items = [Pair(left=3, right=4)]
    return read(items, 0) == 3 and read(items, -1) == 3


func stack_join() -> int:
    mut x: i64 = 0
    while x < 4:
        x = x + 1
    if x == 4:
        return twice(x)
    return 0


func twice(x: i64) -> i64:
    return x * 2


func branch_total() -> int:
    mut total = 0
    mut index = 0
    while index < 4:
        total = total + index
        index = index + 1
    return total


public func test_a_loop_and_a_call_join_to_the_right_value() -> bool:
    return stack_join() == 8


public func test_a_loop_accumulates_through_every_branch_label() -> bool:
    return branch_total() == 6


func descend(depth: i64, input: Pair) -> i64:
    mut value = input
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    value = Pair(left=value.left + 1, right=value.right)
    if depth == 0:
        return value.left
    return descend(depth - 1, value)


public func test_a_recursion_with_a_large_frame_adds_sixty_per_level() -> bool:
    return descend(20, Pair(left=0, right=1)) == 1260 and descend(0, Pair(left=5, right=1)) == 65
