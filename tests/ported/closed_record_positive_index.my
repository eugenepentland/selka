# Ported from the retired QBE field-inout tests: a closed carrier written at a
# positive index keeps its snapshots and detached aliases.
record Runtime:
    data: int[]
    top: int


record Interpreter:
    rt: Runtime
    tag: int


func update(mut rt: Runtime, index: int, value: int):
    rt.data[index] = value
    rt.top += 1


func carrier(mut it: Interpreter, index: int, value: int):
    mut rt = it.rt
    update(mut rt, index, value)
    it.rt = rt


func replace(mut rt: Runtime, value: int):
    if value < 0:
        return
    rt = Runtime(data=[value], top=2)


func replacement(mut it: Interpreter, value: int):
    mut rt = it.rt
    replace(mut rt, value)
    it.rt = rt


public func test_closed_carrier_at_a_positive_index_keeps_the_same_snapshots() -> bool:
    mut it = Interpreter(rt=Runtime(data=[1, 2], top=0), tag=9)
    mut saved = it
    mut alias = it.rt.data
    carrier(mut it, 0, 7)
    assert it.rt.data == [7, 2] and it.rt.top == 1
    assert saved.rt.data == [1, 2] and saved.rt.top == 0
    assert alias == [1, 2]
    replacement(mut it, -1)
    assert it.rt.data == [7, 2]
    replacement(mut it, 11)
    assert it.rt.data == [11] and it.rt.top == 2
    return saved.rt.data == [1, 2] and alias == [1, 2]


func main() -> int:
    assert test_closed_carrier_at_a_positive_index_keeps_the_same_snapshots()
    return 0
