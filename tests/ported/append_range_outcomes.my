module append_range_outcomes

# Appending `(seed + i * 13) % 1009` to an empty list in a loop: the length and
# the first and last elements after zero, negative, short, boundary, growing and
# long runs and for extreme seeds. These are the executed programs of the
# retired QBE `RC-APPEND-RANGE-1` outcome tests (`qbe_rc_append_version_test.zig`).
# The traps those tests also pinned (R_OVERFLOW at the integer limit and
# R_MEMORY_BUDGET under a 1 MiB ceiling) cannot be expected from a guest test.


def grown(n: int, seed: int) -> int:
    values: list[int] = []
    for i in range(n):
        values.append((seed + i * 13) % 1009)
    if n <= 0:
        return len(values)
    return len(values) + values[0] + values[-1]


public def test_zero_negative_short_boundary_growing_and_long_runs_keep_their_ends() -> bool:
    assert grown(-1, 17) == 0
    assert grown(0, 17) == 0
    assert grown(3, 17) == 63
    assert grown(16, 17) == 245
    assert grown(32, 17) == 469
    assert grown(65, 17) == 931
    return True


public def test_negative_and_minimum_seeds_take_the_floor_remainder() -> bool:
    assert grown(32, -31) == 1382
    assert grown(32, -9223372036854775807 - 1) == 1060
    assert grown(0, 9223372036854775807) == 0
    return True
