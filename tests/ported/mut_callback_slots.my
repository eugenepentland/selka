
# A function value called with `mut` arguments that name interior slots of a
# list or a record: two slots of one list, a replaced slot next to a read-only
# snapshot of the whole list, and a replaced field next to a snapshot of the
# whole record, each called directly and through a function value. These are the
# executed programs of the retired mut callback adapter tests
# (`mut_callback_abi_test.zig`, `MUT-REBIND-CALLER-1`); the RC and tracing
# collector variants of each ran the same source and are one test here.


func change(mut first: int[], mut second: int[], replacement: int[]) -> int[][]:
    first.append(8)
    second = replacement
    second.append(9)
    return [first, second]


func nested() -> int:
    mut rows = [[1], [2]]
    mut saved = rows
    mut action = change
    mut result = action(mut rows[0], mut rows[1], [3])
    rows[0].append(10)
    return if (rows == [[1, 8, 10], [3, 9]] and saved == [[1], [2]] and result == [[1, 8], [3, 9]]) then (1) else (0)


# spec-case: MUT-REBIND-CALLER-1
public func test_two_interior_slots_and_managed_returns_stay_independent() -> bool:
    return nested() == 1


func replace_row(mut target: int[], snapshot: int[][]) -> int[]:
    target = [9]
    return snapshot[0]


func rows_snapshot() -> int:
    mut rows = [[1]]
    mut saved = rows
    mut prior = replace_row(mut rows[0], rows)
    rows[0].append(10)
    mut other = [[2]]
    mut other_saved = other
    mut action = replace_row
    mut other_prior = action(mut other[0], other)
    other[0].append(11)
    return if (rows == [[9, 10]] and saved == [[1]] and prior == [1] and other == [[9, 11]] and other_saved == [[2]] and other_prior == [2]) then (1) else (0)


# spec-case: MUT-REBIND-CALLER-1
public func test_a_later_readonly_rows_argument_keeps_the_captured_leaf_and_snapshots() -> bool:
    return rows_snapshot() == 1


record Box:
    items: int[]


func replace_items(mut target: int[], snapshot: Box) -> int[]:
    target = [9]
    return snapshot.items


func field_snapshot() -> int:
    mut box = Box(items=[1])
    mut saved = box
    mut prior = replace_items(mut box.items, box)
    box.items.append(10)
    mut other = Box(items=[2])
    mut other_saved = other
    mut action = replace_items
    mut other_prior = action(mut other.items, other)
    other.items.append(11)
    return if (box.items == [9, 10] and saved.items == [1] and prior == [1] and other.items == [9, 11] and other_saved.items == [2] and other_prior == [2]) then (1) else (0)


# spec-case: MUT-REBIND-CALLER-1
public func test_a_later_readonly_record_argument_keeps_the_captured_field_and_snapshots() -> bool:
    return field_snapshot() == 1
