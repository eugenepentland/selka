public func test_a_long_str_literal_reaches_the_program_intact() -> bool:
    # 2000 runs of 9 scalars each (`ab (é→😀)` plus the newline escape).
    return text_length() == 2000 * 9


public func test_a_long_bytes_literal_reaches_the_program_intact() -> bool:
    return bytes_length() == 1000 * 3


public func test_a_long_ascii_bytes_literal_keeps_every_octet() -> bool:
    # 5400 runs of 10 decoded octets: 54 000 octets, under the 65 536 literal limit.
    return ascii_bytes_length() == 5400 * 10
