# Frozen `str` and `bytes` literals: a short pair keeps content, type and
# length, and long literals reach the program intact (2000 runs of nine
# scalars, 1000 runs of three octets, and 5400 runs of ten octets). These are
# the executed programs of the retired QBE literal tests
# (`qbe_literals_test.zig`: `QBE-LITERAL-1`, `LITERAL-PAYLOAD-1`), which also
# read the emitted IL, the payload instruction and the static image metadata.
# The original ran 5000 runs of three octets; 1000 keep this file smaller.
func frozen_pair() -> int:
    mut text = "abc"
    mut data = b"xy"
    assert text == "a" + "b" + "c", "content"
    assert len(text) == 3, "length"
    assert len(data) == 2, "bytes"
    assert text[0] == "a", "index"
    return 5


public func test_a_frozen_literal_keeps_its_content_type_and_length() -> bool:
    return frozen_pair() == 5


func text_length() -> int:
