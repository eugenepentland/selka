# Small helper functions called from other functions, where a compiler may
# splice the callee into the caller: the answer is the same whether or not it
# does. These are the value-returning programs of the retired bytecode inlining
# tests (`bytecode_inline_test.zig`, `BYTECODE-INLINE-1` to `-5`), which also
# counted the calls left in the lowered bytecode. The traps and frame traces those
# tests also pinned (a bounds trap through two spliced helpers, an overflow
# inside a spliced callee, a float conversion trap, the R_FRAME_LIMIT of a
# four-frame ceiling, and the exact error return trace text) cannot be expected
# from a guest test, so each trapping program keeps its nearest non-trapping
# input and the value it reaches at the edge.
func helper(x: i64) -> bool:
    return x > 0


func use(x: i64) -> bool:
    return helper(x)


func pure_answer() -> i64:
    if use(41):
        return 7
    return 0


public func test_a_leaf_helper_returns_its_comparison_through_a_caller() -> bool:
    return pure_answer() == 7 and not use(-1) and not use(0)


record Cell:
    value: i64


func risky(x: i64) -> i64:
    return x + 1


func make_cell(x: i64) -> Cell:
    return Cell(value=x)


func use_cell(x: i64) -> i64:
    mut cell = make_cell(x)
    return risky(cell.value)


public func test_a_checked_add_in_a_helper_returns_its_sum_up_to_the_limit() -> bool:
    return use_cell(41) == 42 and use_cell(9223372036854775806) == 9223372036854775807


func make_list(x: i64) -> int[]:
    return [x]


func use_list(x: i64) -> i64:
    return make_list(x)[0]


public func test_a_helper_that_builds_a_list_returns_its_element() -> bool:
    return use_list(5) == 5


record Buffer:
    data: bytes


func peek(buf: Buffer, i: i64) -> i64:
    return buf.data[i]


func use_peek(buf: Buffer, i: i64) -> i64:
    return peek(buf, i)


public func test_a_bytes_read_through_two_helpers_returns_each_in_range_byte() -> bool:
    mut buf = Buffer(data=b"abc")
    return use_peek(buf, 0) == 97 and use_peek(buf, 2) == 99 and use_peek(buf, -1) == 99


func first_step(x: i64) -> i64:
    return x + 1


func second_step(x: i64) -> i64:
    return first_step(x)


func resweep(x: i64) -> i64:
    mut first = second_step(0)
    return first + first_step(x)


public func test_nested_helpers_called_before_their_definitions_add_up_to_the_limit() -> bool:
    return resweep(9223372036854775805) == 9223372036854775807 and resweep(0) == 2


func scaled(x: i64, factor: float) -> i64:
    return int(float(x) * factor)


func use_scaled(x: i64, factor: float) -> i64:
    return scaled(x, factor)


public func test_a_helper_converting_between_integers_and_floats_truncates_toward_zero() -> bool:
    return use_scaled(3, 2.5) == 7 and use_scaled(1, 2.0) == 2 and use_scaled(-3, 2.5) == -7 and use_scaled(1, 1e18) == 1000000000000000000


func big(x: i64) -> i64:
    mut v0 = x + 1
    mut v1 = v0 + 1
    mut v2 = v1 + 1
    mut v3 = v2 + 1
    mut v4 = v3 + 1
    mut v5 = v4 + 1
    mut v6 = v5 + 1
    mut v7 = v6 + 1
    mut v8 = v7 + 1
    mut v9 = v8 + 1
    mut v10 = v9 + 1
    mut v11 = v10 + 1
    mut v12 = v11 + 1
    mut v13 = v12 + 1
    return v13


func cold(x: i64) -> i64:
    return big(x)


func hot(x: i64) -> i64:
    mut total = 0
    mut index = 0
    while index < 4:
        total = total + big(x)
        index = index + 1
    return total


public func test_a_large_callee_returns_its_value_from_a_straight_line_and_a_loop_call() -> bool:
    return cold(0) + hot(0) == 70 and cold(0) == 14 and hot(0) == 56


func leaf() -> i64:
    return 7


func middle() -> i64:
    return leaf()


func zero_argument_answer() -> i64:
    mut first = middle()
    return first + middle()


public func test_zero_argument_helpers_called_twice_add_up() -> bool:
    return zero_argument_answer() == 14


record Pair:
    left: int
    right: int


func make_pair(value: int) -> Pair:
    return Pair(left=value, right=value + 1)


func score(pair: Pair) -> int:
    return pair.left + pair.right


func changed(input: Pair) -> int:
    mut pair = input
    pair.left += 1
    return score(pair)


func pair_answer() -> int:
    mut pair = make_pair(7)
    mut alias = pair
    return changed(pair) + score(alias)


public func test_a_constructor_helper_returns_a_record_whose_alias_keeps_its_fields() -> bool:
    return pair_answer() == 31


func checked(value: int) -> Result[int, int]:
    if value < 0:
        return Err(3)
    return Ok(value)


func forwarded(value: int) -> Result[int, int]:
    mut result = try checked(value)
    return Ok(result + 1)


func result_answer() -> int:
    match forwarded(-1):
        case Ok(value):
            return value
        case Err(code):
            return code


func forwarded_ok_answer() -> int:
    match forwarded(4):
        case Ok(value):
            return value
        case Err(code):
            return code


public func test_a_propagated_error_reaches_a_caller_that_returns_another_type() -> bool:
    return result_answer() == 3 and forwarded_ok_answer() == 5


func through(value: Result[int, int]) -> Result[int, int]:
    const extracted = try value
    return Ok(extracted)


func operands_answer() -> int:
    const first, result = 7, through(Err(3))
    match result:
        case Ok(value):
            return first + value
        case Err(code):
            return first + code


public func test_a_propagation_with_an_unfinished_caller_operand_keeps_that_operand() -> bool:
    return operands_answer() == 10


record Owner:
    values: int[]


func make_owner(values: int[]) -> Owner:
    return Owner(values=values)


func owner_answer() -> int:
    mut values = [7]
    mut owner = make_owner(values)
    values[0] = 9
    return owner.values[0]


public func test_a_construction_helper_keeps_the_payload_it_was_given() -> bool:
    return owner_answer() == 7


func optional(value: int) -> int?:
    if value < 0:
        return None
    return Some(value)


func optional_answer() -> int:
    match optional(-1):
        case Some(value):
            return value
        case None:
            match optional(7):
                case Some(value):
                    return value
                case None:
                    return 0


public func test_an_option_helper_keeps_both_its_some_and_none_branches() -> bool:
    return optional_answer() == 7
