public func test_primitive_widths_signed_bits_boolean_and_float_domains_remain_exact() -> bool:
    mut i8_items = sixty_four_i8()
    mut i8_want: i8 = -1
    assert len(i8_items) == 64 and i8_items[0] == i8_want and i8_items[63] == i8_want
    mut u8_items = sixty_four_u8()
    mut u8_want: u8 = 255
    assert len(u8_items) == 64 and u8_items[0] == u8_want and u8_items[63] == u8_want
    mut i16_items = sixty_four_i16()
    mut i16_want: i16 = -32768
    assert len(i16_items) == 64 and i16_items[0] == i16_want and i16_items[63] == i16_want
    mut u16_items = sixty_four_u16()
    mut u16_want: u16 = 65535
    assert len(u16_items) == 64 and u16_items[0] == u16_want and u16_items[63] == u16_want
    mut i32_items = sixty_four_i32()
    mut i32_want: i32 = -2147483648
    assert len(i32_items) == 64 and i32_items[0] == i32_want and i32_items[63] == i32_want
    mut u32_items = sixty_four_u32()
    mut u32_want: u32 = 4294967295
    assert len(u32_items) == 64 and u32_items[0] == u32_want and u32_items[63] == u32_want
    mut int_items = sixty_four_int()
    mut int_want: int = -9223372036854775808
    assert len(int_items) == 64 and int_items[0] == int_want and int_items[63] == int_want
    mut u64_items = sixty_four_u64()
    mut u64_want: u64 = 18446744073709551615
    assert len(u64_items) == 64 and u64_items[0] == u64_want and u64_items[63] == u64_want
    mut bool_items = sixty_four_bool()
    mut bool_want: bool = True
    assert len(bool_items) == 64 and bool_items[0] == bool_want and bool_items[63] == bool_want
    mut float_items = sixty_four_float()
    mut float_want: float = 1.5
    assert len(float_items) == 64 and float_items[0] == float_want and float_items[63] == float_want
