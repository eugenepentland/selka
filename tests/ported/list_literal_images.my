public func test_a_thousand_primitive_elements_keep_their_length_and_values() -> bool:
    mut items = thousand_primitives()
    mut total = 0
    for item in items:
        total += item
    return len(items) == 1000 and items[0] == 17 and items[999] == 17 and total == 17000


