module copy_scratch

record Box:
    items: list[int]
    number: int


union Item:
    box: Box,
    empty


def take(items: list[Item]) -> Box:
    match items[0]:
        case Item.box(payload):
            return payload
        case Item.empty:
            return Box([], 0)


# spec-case: QBE-VALUECOPY-BORROW-1
public def test_returned_payload_is_independent_on_both_sides() -> bool:
    original = Box([1], 7)
    items = [Item.box(original)]
    copied = take(items)
    copied.items.append(2)
    original.items.append(3)
    return copied.items == [1, 2] and original.items == [1, 3] and take(items).items == [1]


# spec-case: QBE-VALUECOPY-BORROW-1
public def test_payload_return_remains_a_snapshot_after_parent_replacement() -> bool:
    items = [Item.box(Box([1], 7))]
    copied = take(items)
    items[0] = Item.box(Box([9], 8))
    copied.items.append(2)
    return copied.items == [1, 2] and copied.number == 7 and take(items).items == [9]
