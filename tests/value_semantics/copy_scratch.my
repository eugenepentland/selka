record Box:
    items: int[]
    number: int


enum Item:
    box(value: Box)
    empty


func take(items: Item[]) -> Box:
    match items[0]:
        case Item.box(value=payload):
            return payload.copy()
        case Item.empty:
            return Box(items=[], number=0)


public func test_returned_payload_is_independent_on_both_sides() -> bool:
    mut original = Box(items=[1], number=7)
    mut items = [Item.box(value=original.copy())]
    mut copied = take(items)
    copied.items.append(2)
    original.items.append(3)
    return copied.items == [1, 2] and original.items == [1, 3] and take(items).items == [1]


public func test_payload_return_remains_a_snapshot_after_parent_replacement() -> bool:
    mut items = [Item.box(value=Box(items=[1], number=7))]
    mut copied = take(items)
    items[0] = Item.box(value=Box(items=[9], number=8))
    copied.items.append(2)
    return copied.items == [1, 2] and copied.number == 7 and take(items).items == [9]
