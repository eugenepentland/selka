

func snapshot(xs: int[]) -> int[]:
    return xs


func keep_then_grow(mut xs: int[], survivor: int[]) -> int[]:
    mut saved = snapshot(xs)
    xs.append(survivor[0])
    return saved


public func test_pinned_transfer_keeps_original_and_other_live_values() -> bool:
    mut xs = [1, 2]
    mut survivor = [9]
    mut saved = keep_then_grow(mut xs, survivor)
    saved.append(3)
    return saved == [1, 2, 3] and xs == [1, 2, 9] and survivor == [9]


public func test_fast_transfer_keeps_independent_snapshots() -> bool:
    mut xs = [1, 2]
    mut saved = snapshot(xs)
    xs.append(9)
    saved.append(3)
    return saved == [1, 2, 3] and xs == [1, 2, 9]
