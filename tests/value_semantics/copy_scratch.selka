record Box:
    items: int[]
    number: int


enum Item:
    box(value: Box)
    empty


func copy_scratch_take(items: Item[]) -> Box:
    match items[0]:
        case box(value=payload):
            return copy(payload)
        case empty:
            return Box(items=[], number=0)


public func test_returned_payload_is_independent_on_both_sides() -> bool:
    mut original = Box(items=[1], number=7)
    mut items = [Item.box(value=copy(original))]
    mut copied = copy_scratch_take(items)
    append(mut copied.items, 2)
    append(mut original.items, 3)
    return copied.items == [1, 2] and original.items == [1, 3] and copy_scratch_take(items).items == [1]


public func test_payload_return_remains_a_snapshot_after_parent_replacement() -> bool:
    mut items = [Item.box(value=Box(items=[1], number=7))]
    mut copied = copy_scratch_take(items)
    items[0] = Item.box(value=Box(items=[9], number=8))
    append(mut copied.items, 2)
    return copied.items == [1, 2] and copied.number == 7 and copy_scratch_take(items).items == [9]
