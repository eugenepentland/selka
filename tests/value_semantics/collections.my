# Every collection type is an independent value under `--value-semantics`
# (VALUE-SEMANTICS-2): assignment, argument passing, returns and stores never
# make two names reach the same list, dict, set or byte_buffer.
func with_item(xs: int[], value: int) -> int[]:
    mut copy = xs
    copy.append(value)
    return copy


func with_entry(d: dict[str, int], key: str, value: int) -> dict[str, int]:
    mut copy = d
    copy[key] = value
    return copy


func with_member(s: set[int], value: int) -> set[int]:
    mut copy = s
    copy.add(value)
    return copy


func with_byte(b: byte_buffer, value: int) -> byte_buffer:
    mut copy = b
    _ = copy.append_byte(value)
    return copy


func total(xs: int[]) -> int:
    mut sum = 0
    for x in xs:
        sum += x
    return sum


# spec-case: VALUE-SEMANTICS-2
public func test_a_list_assignment_is_a_copy() -> bool:
    mut a = [1, 2]
    mut b = a
    b.append(3)
    a[0] = 9
    return a == [9, 2] and b == [1, 2, 3]


# spec-case: VALUE-SEMANTICS-2
public func test_a_dict_assignment_is_a_copy() -> bool:
    mut a = {"x": 1}
    mut b = a
    b["y"] = 2
    a["x"] = 5
    return len(a) == 1 and a["x"] == 5 and len(b) == 2 and b["x"] == 1


# spec-case: VALUE-SEMANTICS-2
public func test_a_set_assignment_is_a_copy() -> bool:
    mut a = {1, 2}
    mut b = a
    b.add(3)
    a.discard(1)
    return len(a) == 1 and 2 in a and len(b) == 3 and 1 in b


# spec-case: VALUE-SEMANTICS-2
public func test_a_byte_buffer_assignment_is_a_copy() -> bool:
    mut empty: int[] = []
    mut a = byte_buffer(empty)
    _ = a.append_byte(1)
    mut b = a
    _ = b.append_byte(2)
    return len(a) == 1 and len(b) == 2 and b[1] == 2


# spec-case: VALUE-SEMANTICS-2
public func test_a_returned_copy_of_each_collection_leaves_the_argument_alone() -> bool:
    mut xs = [1]
    mut d = {"a": 1}
    mut s = {1}
    mut empty: int[] = []
    mut buffer = byte_buffer(empty)
    mut grown = with_item(xs, 2)
    mut keyed = with_entry(d, "b", 2)
    mut member = with_member(s, 2)
    mut longer = with_byte(buffer, 7)
    mut unchanged = len(xs) == 1 and len(d) == 1 and len(s) == 1 and len(buffer) == 0
    return unchanged and grown == [1, 2] and len(keyed) == 2 and 2 in member and len(longer) == 1


# A read-only argument is lent: the callee reads the caller's own list.
# spec-case: VALUE-SEMANTICS-2
public func test_a_read_only_argument_is_read_in_place() -> bool:
    mut xs = [1, 2, 3]
    mut first = total(xs)
    xs.append(4)
    return first == 6 and total(xs) == 10


# spec-case: VALUE-SEMANTICS-2
public func test_nested_collections_copy_all_the_way_down() -> bool:
    mut grid = [[1], [2]]
    mut other = grid
    other[0].append(5)
    mut table = {"k": [1]}
    mut copy = table
    copy["k"].append(2)
    return grid == [[1], [2]] and other == [[1, 5], [2]] and table["k"] == [1] and copy["k"] == [1, 2]
