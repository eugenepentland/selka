record ArrayField:
    entries: FixedArray[dict[str, int[]], 1]


record DictionaryField:
    entries: dict[str, int[]]


record Key:
    number: int


enum Position:
    first
    second


func last_index() -> int:
    return -1


func replace_entry(mut value: dict[str, FixedArray[int[], 1]]) -> int:
    value["k"] = FixedArray[int[], 1]([[9]])
    return 0


func remove_entries(mut value: dict[str, FixedArray[int[], 1]]) -> int:
    value.clear()
    return 0


func grow_entries(mut value: dict[str, FixedArray[int[], 1]]) -> int:
    for i in range(40):
        value[f"extra{i}"] = FixedArray[int[], 1]([[i]])
    return 0


func clear_rows(mut value: FixedArray[int[], 1][]) -> int:
    value.clear()
    return 0


func change_key(mut value: Key) -> int:
    value.number = 2
    return 0


public func test_fixed_array_list() -> bool:
    mut original: FixedArray[int[], 1] = FixedArray[int[], 1]([[1]])
    mut changed = original.copy()
    changed[0].append(2)
    return original[0] == [1] and changed[0] == [1, 2]


public func test_fixed_array_dictionary() -> bool:
    mut original: FixedArray[dict[str, int[]], 1] = FixedArray[dict[str, int[]], 1]([{"k": [1]}])
    mut changed = original.copy()
    changed[0]["k"].append(2)
    return original[0]["k"] == [1] and changed[0]["k"] == [1, 2]


public func test_repeated_fixed_array_wrappers() -> bool:
    mut original: FixedArray[FixedArray[dict[str, int[]], 1], 1] = FixedArray[FixedArray[dict[str, int[]], 1], 1]([FixedArray[dict[str, int[]], 1]([{"k": [1]}])])
    mut changed = original.copy()
    changed[0][0]["k"].append(2)
    return original[0][0]["k"] == [1] and changed[0][0]["k"] == [1, 2]


public func test_fixed_array_list_dictionary() -> bool:
    mut original: FixedArray[dict[str, int[]][], 1] = FixedArray[dict[str, int[]][], 1]([[{"k": [1]}]])
    mut changed = original.copy()
    changed[0][0]["k"].append(2)
    return original[0][0]["k"] == [1] and changed[0][0]["k"] == [1, 2]


public func test_list_fixed_array_dictionary() -> bool:
    mut original: FixedArray[dict[str, int[]], 1][] = [FixedArray[dict[str, int[]], 1]([{"k": [1]}])]
    mut changed = original.copy()
    changed[0][0]["k"].append(2)
    return original[0][0]["k"] == [1] and changed[0][0]["k"] == [1, 2]


public func test_dictionary_fixed_array_list() -> bool:
    mut original: dict[str, FixedArray[int[], 1]] = {"k": FixedArray[int[], 1]([[1]])}
    mut changed = original.copy()
    changed["k"][0].append(2)
    return original["k"][0] == [1] and changed["k"][0] == [1, 2]


public func test_dictionary_fixed_array_field_dictionary() -> bool:
    mut original: dict[str, FixedArray[DictionaryField, 1]] = {"outer": FixedArray[DictionaryField, 1]([DictionaryField(entries={"k": [1]})])}
    mut changed = original.copy()
    changed["outer"][0].entries["k"].append(2)
    return original["outer"][0].entries["k"] == [1] and changed["outer"][0].entries["k"] == [1, 2]


public func test_list_record_fixed_array_field() -> bool:
    mut original = [ArrayField(entries=FixedArray[dict[str, int[]], 1]([{"k": [1]}]))]
    mut changed = original.copy()
    changed[0].entries[0]["k"].append(2)
    return original[0].entries[0]["k"] == [1] and changed[0].entries[0]["k"] == [1, 2]


public func test_dynamic_negative_fixed_array_index() -> bool:
    mut original: FixedArray[dict[str, int[]], 2] = FixedArray[dict[str, int[]], 2]([{"k": [0]}, {"k": [1]}])
    mut changed = original.copy()
    changed[last_index()]["k"].append(2)
    return original[1]["k"] == [1] and changed[1]["k"] == [1, 2] and changed[0]["k"] == [0]


public func test_enum_table_collection_element() -> bool:
    mut original: [Position]int[] = {Position.first: [0], Position.second: [1]}
    mut changed = original.copy()
    changed[Position.second].append(2)
    return original[Position.second] == [1] and changed[Position.second] == [1, 2] and changed[Position.first] == [0]


public func test_list_array_path_inside_a_loop() -> bool:
    mut original: FixedArray[dict[str, int[]], 1][] = [FixedArray[dict[str, int[]], 1]([{"k": [1]}])]
    mut changed = original.copy()
    for i in range(3):
        changed[0][0]["k"].append(i + 2)
    return original[0][0]["k"] == [1] and changed[0][0]["k"] == [1, 2, 3, 4]


public func test_replacement_call_finishes_before_dictionary_receiver_selection() -> bool:
    mut original: dict[str, FixedArray[int[], 1]] = {"k": FixedArray[int[], 1]([[1]])}
    mut changed = original.copy()
    mut selected = replace_entry(mut changed)
    changed["k"][selected].append(2)
    return original["k"][0] == [1] and changed["k"][0] == [9, 2]


public func test_removed_entry_can_be_reinserted_before_receiver_selection() -> bool:
    mut original: dict[str, FixedArray[int[], 1]] = {"k": FixedArray[int[], 1]([[1]])}
    mut changed = original.copy()
    mut selected = remove_entries(mut changed)
    mut removed = len(changed) == 0
    changed["k"] = FixedArray[int[], 1]([[9]])
    changed["k"][selected].append(2)
    return original["k"][0] == [1] and removed and changed["k"][0] == [9, 2]


public func test_rehash_call_finishes_before_dictionary_receiver_selection() -> bool:
    mut original: dict[str, FixedArray[int[], 1]] = {"k": FixedArray[int[], 1]([[1]])}
    mut changed = original.copy()
    mut selected = grow_entries(mut changed)
    changed["k"][selected].append(2)
    return original["k"][0] == [1] and changed["k"][0] == [1, 2] and len(changed) == 41


public func test_cleared_outer_list_can_be_repopulated_before_receiver_selection() -> bool:
    mut original: FixedArray[int[], 1][] = [FixedArray[int[], 1]([[1]])]
    mut changed = original.copy()
    mut selected = clear_rows(mut changed)
    mut cleared = len(changed) == 0
    changed.append(FixedArray[int[], 1]([[9]]))
    changed[0][selected].append(2)
    return original[0][0] == [1] and cleared and changed[0][0] == [9, 2]


public func test_later_index_changes_the_original_key_variable() -> bool:
    mut original: dict[Key, FixedArray[int[], 1]] = {Key(number=1): FixedArray[int[], 1]([[1]])}
    mut changed = original.copy()
    mut key = Key(number=1)
    changed[key][change_key(mut key)].append(2)
    return original[Key(number=1)][0] == [1] and changed[Key(number=1)][0] == [1, 2] and key.number == 2


public func test_dictionary_array_sliced_key_is_retained() -> bool:
    mut original: dict[str, FixedArray[int[], 1]] = {"k": FixedArray[int[], 1]([[1]])}
    mut changed = original.copy()
    mut key = "_key"
    changed[key[1:2]][last_index()].append(2)
    return original["k"][0] == [1] and changed["k"][0] == [1, 2]
