module nested_arrays

record ArrayField:
    entries: [1]dict[str, list[int]]


record DictionaryField:
    entries: dict[str, list[int]]


record Key:
    number: int


enum Position:
    first,
    second


def last_index() -> int:
    return -1


def replace_entry(value: mut dict[str, [1]list[int]]) -> int:
    value["k"] = [[9]]
    return 0


def remove_entries(value: mut dict[str, [1]list[int]]) -> int:
    value.clear()
    return 0


def grow_entries(value: mut dict[str, [1]list[int]]) -> int:
    for i in range(40):
        value[f"extra{i}"] = [[i]]
    return 0


def clear_rows(value: mut list[[1]list[int]]) -> int:
    value.clear()
    return 0


def change_key(value: mut Key) -> int:
    value.number = 2
    return 0


# spec-case: COW-NESTED-1
public def test_fixed_array_list() -> bool:
    original: [1]list[int] = [[1]]
    changed = original
    changed[0].append(2)
    return original[0] == [1] and changed[0] == [1, 2]


# spec-case: COW-NESTED-1
public def test_fixed_array_dictionary() -> bool:
    original: [1]dict[str, list[int]] = [{"k": [1]}]
    changed = original
    changed[0]["k"].append(2)
    return original[0]["k"] == [1] and changed[0]["k"] == [1, 2]


# spec-case: COW-NESTED-1
public def test_repeated_fixed_array_wrappers() -> bool:
    original: [1][1] dict[str, list[int]] = [[{"k": [1]}]]
    changed = original
    changed[0][0]["k"].append(2)
    return original[0][0]["k"] == [1] and changed[0][0]["k"] == [1, 2]


# spec-case: COW-NESTED-1
public def test_fixed_array_list_dictionary() -> bool:
    original: [1]list[dict[str, list[int]]] = [[{"k": [1]}]]
    changed = original
    changed[0][0]["k"].append(2)
    return original[0][0]["k"] == [1] and changed[0][0]["k"] == [1, 2]


# spec-case: COW-NESTED-1
public def test_list_fixed_array_dictionary() -> bool:
    original: list[[1]dict[str, list[int]]] = [[{"k": [1]}]]
    changed = original
    changed[0][0]["k"].append(2)
    return original[0][0]["k"] == [1] and changed[0][0]["k"] == [1, 2]


# spec-case: COW-NESTED-1
public def test_dictionary_fixed_array_list() -> bool:
    original: dict[str, [1]list[int]] = {"k": [[1]]}
    changed = original
    changed["k"][0].append(2)
    return original["k"][0] == [1] and changed["k"][0] == [1, 2]


# spec-case: COW-NESTED-1
public def test_dictionary_fixed_array_field_dictionary() -> bool:
    original: dict[str, [1]DictionaryField] = {"outer": [DictionaryField(entries={"k": [1]})]}
    changed = original
    changed["outer"][0].entries["k"].append(2)
    return original["outer"][0].entries["k"] == [1] and changed["outer"][0].entries["k"] == [1, 2]


# spec-case: COW-NESTED-1
public def test_list_record_fixed_array_field() -> bool:
    original = [ArrayField(entries=[{"k": [1]}])]
    changed = original
    changed[0].entries[0]["k"].append(2)
    return original[0].entries[0]["k"] == [1] and changed[0].entries[0]["k"] == [1, 2]


# spec-case: COW-NESTED-1
public def test_dynamic_negative_fixed_array_index() -> bool:
    original: [2]dict[str, list[int]] = [{"k": [0]}, {"k": [1]}]
    changed = original
    changed[last_index()]["k"].append(2)
    return original[1]["k"] == [1] and changed[1]["k"] == [1, 2] and changed[0]["k"] == [0]


# spec-case: ARENA-ESCAPE-VALUE-1
public def test_fixed_array_nested_copies_escape_an_arena() -> bool:
    original: [1]dict[str, list[int]] = [{"k": [1]}]
    kept = original
    with arena() as scratch:
        changed = original
        changed[0]["k"].append(2)
        kept = scratch.escape(changed)
    return original[0]["k"] == [1] and kept[0]["k"] == [1, 2]


# spec-case: COW-NESTED-1
public def test_enum_table_collection_element() -> bool:
    original: [Position]list[int] = {Position.first: [0], Position.second: [1]}
    changed = original
    changed[Position.second].append(2)
    return original[Position.second] == [1] and changed[Position.second] == [1, 2] and changed[Position.first] == [0]


# spec-case: COW-NESTED-1
public def test_list_array_path_inside_a_loop() -> bool:
    original: list[[1]dict[str, list[int]]] = [[{"k": [1]}]]
    changed = original
    for i in range(3):
        changed[0][0]["k"].append(i + 2)
    return original[0][0]["k"] == [1] and changed[0][0]["k"] == [1, 2, 3, 4]


# spec-case: COW-NESTED-1
public def test_later_index_replaces_the_dictionary_entry() -> bool:
    original: dict[str, [1]list[int]] = {"k": [[1]]}
    changed = original
    changed["k"][replace_entry(mut changed)].append(2)
    return original["k"][0] == [1] and changed["k"][0] == [9]


# spec-case: COW-NESTED-1
public def test_later_index_removes_the_dictionary_entry() -> bool:
    original: dict[str, [1]list[int]] = {"k": [[1]]}
    changed = original
    changed["k"][remove_entries(mut changed)].append(2)
    return original["k"][0] == [1] and len(changed) == 0


# spec-case: COW-NESTED-1
public def test_later_index_rehashes_the_dictionary() -> bool:
    original: dict[str, [1]list[int]] = {"k": [[1]]}
    changed = original
    changed["k"][grow_entries(mut changed)].append(2)
    return original["k"][0] == [1] and changed["k"][0] == [1, 2] and len(changed) == 41


# spec-case: COW-NESTED-1
public def test_later_index_clears_the_outer_list() -> bool:
    original: list[[1]list[int]] = [[[1]]]
    changed = original
    changed[0][clear_rows(mut changed)].append(2)
    return original[0][0] == [1] and len(changed) == 0


# spec-case: COW-NESTED-1
public def test_later_index_changes_the_original_key_variable() -> bool:
    original: dict[Key, [1]list[int]] = {Key(number=1): [[1]]}
    changed = original
    key = Key(number=1)
    changed[key][change_key(mut key)].append(2)
    return original[Key(number=1)][0] == [1] and changed[Key(number=1)][0] == [1, 2] and key.number == 2


# spec-case: COW-NESTED-1
public def test_dictionary_array_sliced_key_is_retained() -> bool:
    original: dict[str, [1]list[int]] = {"k": [[1]]}
    changed = original
    key = "_key"
    changed[key[1:2]][last_index()].append(2)
    return original["k"][0] == [1] and changed["k"][0] == [1, 2]
