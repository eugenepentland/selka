module interactions

# How value semantics meets the rest of the language: `class` stays a shared
# reference in this stage, a copy made inside an arena lives in that arena and
# leaves it through `escape`, and `old(...)` may capture a collection.


class Box:
    items: list[int]


record Owner:
    box: Box
    tags: list[int]


def fill(target: mut list[int], count: int) -> None:
    for i in range(count):
        target.append(i)


@ensures(len(xs) == len(old(xs)) + 1)
def push_one(xs: mut list[int]) -> None:
    xs.append(1)


# spec-case: VALUE-SEMANTICS-2
public def test_a_class_stays_a_shared_reference() -> bool:
    box = Box(items=[1])
    alias = box
    alias.items.append(2)
    owner = Owner(box=box, tags=[1])
    copy = owner
    copy.box.items.append(3)
    copy.tags.append(2)
    return box.items == [1, 2, 3] and owner.tags == [1] and copy.tags == [1, 2]


# spec-case: VALUE-SEMANTICS-2
public def test_a_list_read_out_of_a_class_is_a_copy() -> bool:
    box = Box(items=[1])
    taken = box.items
    taken.append(2)
    box.items.append(3)
    return taken == [1, 2] and box.items == [1, 3]


# spec-case: VALUE-SEMANTICS-2
public def test_a_copy_made_in_an_arena_leaves_through_escape() -> bool:
    source = [1, 2]
    kept: list[int] = []
    with arena() as scratch:
        local = source
        local.append(3)
        fill(mut local, 2)
        kept = scratch.escape(local)
    source.append(9)
    return kept == [1, 2, 3, 0, 1] and source == [1, 2, 9]


# spec: VALUE-SEMANTICS-7
public def test_old_captures_a_collection_by_value() -> bool:
    xs = [5]
    push_one(mut xs)
    push_one(mut xs)
    return xs == [5, 1, 1]
