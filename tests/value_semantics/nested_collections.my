
record DictionaryField:
    entries: dict[str, int[]]


record ListField:
    items: dict[str, int[]][]


func first_index(mut log: int[]) -> int:
    log.append(1)
    return 0


func next_key(mut log: int[]) -> str:
    log.append(2)
    return "k"


# Check both values together: dropping either alias before the write could
# turn the transfer into a move and hide a missing parent write-back.
public func test_list_dictionary_list_path() -> bool:
    mut original: dict[str, int[]][] = [{"k": [1]}]
    mut changed = original
    changed[0]["k"].append(2)
    return original[0]["k"] == [1] and changed[0]["k"] == [1, 2]


public func test_dictionary_list_dictionary_path() -> bool:
    mut original: dict[str, dict[str, int][]] = {"k": [{"n": 1}]}
    mut changed = original
    changed["k"][0]["n"] = 2
    return original["k"][0]["n"] == 1 and changed["k"][0]["n"] == 2


public func test_repeated_dictionary_wrappers() -> bool:
    mut original: dict[str, dict[str, dict[str, int[]]]] = {"a": {"b": {"c": [1]}}}
    mut changed = original
    changed["a"]["b"]["c"].append(2)
    return original["a"]["b"]["c"] == [1] and changed["a"]["b"]["c"] == [1, 2]


public func test_repeated_list_dictionary_wrappers() -> bool:
    mut original: dict[str, dict[str, int[]][]][] = [{"a": [{"b": [1]}]}]
    mut changed = original
    changed[0]["a"][0]["b"].append(2)
    return original[0]["a"][0]["b"] == [1] and changed[0]["a"][0]["b"] == [1, 2]


public func test_dictionary_field_in_list() -> bool:
    mut original = [DictionaryField(entries={"k": [1]})]
    mut changed = original
    changed[0].entries["k"].append(2)
    return original[0].entries["k"] == [1] and changed[0].entries["k"] == [1, 2]


public func test_list_field_in_dictionary() -> bool:
    mut original = {"outer": ListField(items=[{"k": [1]}])}
    mut changed = original
    changed["outer"].items[0]["k"].append(2)
    return original["outer"].items[0]["k"] == [1] and changed["outer"].items[0]["k"] == [1, 2]


public func test_named_alias_of_nested_dictionary() -> bool:
    mut original: dict[str, int[]][] = [{"k": [1]}]
    mut changed = original[0]
    changed["k"].append(2)
    return original[0]["k"] == [1] and changed["k"] == [1, 2]


public func test_both_aliases_can_change_different_nested_values() -> bool:
    mut original: dict[str, int[]][] = [{"k": [1]}]
    mut changed = original
    changed[0]["k"].append(2)
    original[0]["k"].append(3)
    return original[0]["k"] == [1, 3] and changed[0]["k"] == [1, 2]


public func test_nested_writes_inside_a_loop() -> bool:
    mut original: dict[str, int[]][] = [{"k": [1]}]
    mut changed = original
    for i in range(3):
        changed[0]["k"].append(i + 2)
    return original[0]["k"] == [1] and changed[0]["k"] == [1, 2, 3, 4]


public func test_receivers_and_keys_evaluate_once_in_source_order() -> bool:
    mut original: dict[str, int[]][] = [{"k": [1]}]
    mut changed = original
    mut log: int[] = []
    changed[first_index(mut log)][next_key(mut log)].append(2)
    return original[0]["k"] == [1] and changed[0]["k"] == [1, 2] and log == [1, 2]


public func test_nested_integer_keys() -> bool:
    mut original: dict[int, dict[int, int[]]][] = [{1: {2: [1]}}]
    mut changed = original
    changed[0][1][2].append(2)
    return original[0][1][2] == [1] and changed[0][1][2] == [1, 2]


public func test_nested_sliced_string_keys() -> bool:
    mut original: dict[str, int[]][] = [{"k": [1]}]
    mut changed = original
    mut key = "_key"
    changed[0][key[1:2]].append(2)
    return original[0]["k"] == [1] and changed[0]["k"] == [1, 2]


public func test_nested_set_leaf() -> bool:
    mut original: dict[str, set[int]][] = [{"k": {1}}]
    mut changed = original
    changed[0]["k"].add(2)
    return original[0]["k"] == {1} and changed[0]["k"] == {1, 2}


public func test_nested_byte_buffer_leaf() -> bool:
    mut original: dict[str, byte_buffer][] = [{"k": byte_buffer([1])}]
    mut changed = original
    _ = changed[0]["k"].append_byte(2)
    return len(original[0]["k"]) == 1 and len(changed[0]["k"]) == 2 and changed[0]["k"][1] == 2


func grow_key(mut value: dict[str, int[]][]) -> str:
    value[0]["k"].append(7)
    return "k"


func replace_key(mut value: dict[str, int[]][]) -> str:
    value[0] = {"k": [9]}
    return "k"


public func test_key_mutates_original() -> bool:
    mut original: dict[str, int[]][] = [{"k": [1]}]
    mut changed = original
    changed[0][grow_key(mut original)].append(2)
    return original[0]["k"] == [1, 7] and changed[0]["k"] == [1, 2]


public func test_key_replacement_finishes_before_receiver_selection() -> bool:
    mut original: dict[str, int[]][] = [{"k": [1]}]
    mut changed = original
    mut selected = replace_key(mut changed)
    changed[0][selected].append(2)
    return original[0]["k"] == [1] and changed[0]["k"] == [9, 2]


public func test_key_growth_finishes_before_receiver_selection() -> bool:
    mut original: dict[str, int[]][] = [{"k": [1]}]
    mut changed = original
    mut selected = grow_key(mut changed)
    changed[0][selected].append(2)
    return original[0]["k"] == [1] and changed[0]["k"] == [1, 7, 2]
