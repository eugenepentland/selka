module nested_collections

record DictionaryField:
    entries: dict[str, list[int]]


record ListField:
    items: list[dict[str, list[int]]]


def first_index(log: mut list[int]) -> int:
    log.append(1)
    return 0


def next_key(log: mut list[int]) -> str:
    log.append(2)
    return "k"


# Check both values together: dropping either alias before the write could
# turn the transfer into a move and hide a missing parent write-back.
# spec-case: COW-NESTED-1
public def test_list_dictionary_list_path() -> bool:
    original: list[dict[str, list[int]]] = [{"k": [1]}]
    changed = original
    changed[0]["k"].append(2)
    return original[0]["k"] == [1] and changed[0]["k"] == [1, 2]


# spec-case: COW-NESTED-1
public def test_dictionary_list_dictionary_path() -> bool:
    original: dict[str, list[dict[str, int]]] = {"k": [{"n": 1}]}
    changed = original
    changed["k"][0]["n"] = 2
    return original["k"][0]["n"] == 1 and changed["k"][0]["n"] == 2


# spec-case: COW-NESTED-1
public def test_repeated_dictionary_wrappers() -> bool:
    original: dict[str, dict[str, dict[str, list[int]]]] = {"a": {"b": {"c": [1]}}}
    changed = original
    changed["a"]["b"]["c"].append(2)
    return original["a"]["b"]["c"] == [1] and changed["a"]["b"]["c"] == [1, 2]


# spec-case: COW-NESTED-1
public def test_repeated_list_dictionary_wrappers() -> bool:
    original: list[dict[str, list[dict[str, list[int]]]]] = [{"a": [{"b": [1]}]}]
    changed = original
    changed[0]["a"][0]["b"].append(2)
    return original[0]["a"][0]["b"] == [1] and changed[0]["a"][0]["b"] == [1, 2]


# spec-case: COW-NESTED-1
public def test_dictionary_field_in_list() -> bool:
    original = [DictionaryField(entries={"k": [1]})]
    changed = original
    changed[0].entries["k"].append(2)
    return original[0].entries["k"] == [1] and changed[0].entries["k"] == [1, 2]


# spec-case: COW-NESTED-1
public def test_list_field_in_dictionary() -> bool:
    original = {"outer": ListField(items=[{"k": [1]}])}
    changed = original
    changed["outer"].items[0]["k"].append(2)
    return original["outer"].items[0]["k"] == [1] and changed["outer"].items[0]["k"] == [1, 2]


# spec-case: COW-NESTED-1
public def test_named_alias_of_nested_dictionary() -> bool:
    original: list[dict[str, list[int]]] = [{"k": [1]}]
    changed = original[0]
    changed["k"].append(2)
    return original[0]["k"] == [1] and changed["k"] == [1, 2]


# spec-case: COW-NESTED-1
public def test_both_aliases_can_change_different_nested_values() -> bool:
    original: list[dict[str, list[int]]] = [{"k": [1]}]
    changed = original
    changed[0]["k"].append(2)
    original[0]["k"].append(3)
    return original[0]["k"] == [1, 3] and changed[0]["k"] == [1, 2]


# spec-case: COW-NESTED-1
public def test_nested_writes_inside_a_loop() -> bool:
    original: list[dict[str, list[int]]] = [{"k": [1]}]
    changed = original
    for i in range(3):
        changed[0]["k"].append(i + 2)
    return original[0]["k"] == [1] and changed[0]["k"] == [1, 2, 3, 4]


# spec-case: ARENA-ESCAPE-VALUE-1
public def test_nested_dictionary_copies_survive_arena_escape() -> bool:
    original: list[dict[str, list[int]]] = [{"k": [1]}]
    kept = original
    with arena() as scratch:
        changed = original
        changed[0]["k"].append(2)
        kept = scratch.escape(changed)
    return original[0]["k"] == [1] and kept[0]["k"] == [1, 2]


# spec-case: COW-NESTED-1
public def test_receivers_and_keys_evaluate_once_in_source_order() -> bool:
    original: list[dict[str, list[int]]] = [{"k": [1]}]
    changed = original
    log: list[int] = []
    changed[first_index(mut log)][next_key(mut log)].append(2)
    return original[0]["k"] == [1] and changed[0]["k"] == [1, 2] and log == [1, 2]


# spec-case: COW-NESTED-1
public def test_nested_integer_keys() -> bool:
    original: list[dict[int, dict[int, list[int]]]] = [{1: {2: [1]}}]
    changed = original
    changed[0][1][2].append(2)
    return original[0][1][2] == [1] and changed[0][1][2] == [1, 2]


# spec-case: COW-NESTED-1
public def test_nested_sliced_string_keys() -> bool:
    original: list[dict[str, list[int]]] = [{"k": [1]}]
    changed = original
    key = "_key"
    changed[0][key[1:2]].append(2)
    return original[0]["k"] == [1] and changed[0]["k"] == [1, 2]


# spec-case: COW-NESTED-1
public def test_nested_set_leaf() -> bool:
    original: list[dict[str, set[int]]] = [{"k": {1}}]
    changed = original
    changed[0]["k"].add(2)
    return original[0]["k"] == {1} and changed[0]["k"] == {1, 2}


# spec-case: COW-NESTED-1
public def test_nested_byte_buffer_leaf() -> bool:
    original: list[dict[str, byte_buffer]] = [{"k": byte_buffer([1])}]
    changed = original
    _ = changed[0]["k"].append_byte(2)
    return len(original[0]["k"]) == 1 and len(changed[0]["k"]) == 2 and changed[0]["k"][1] == 2
