
func replace_alias(mut value: dict[str, FixedArray[int[], 1]]) -> int:
    mut copied = value["k"]
    value["k"] = copied
    return 0


func replace_fresh(mut value: dict[str, FixedArray[int[], 1]]) -> int:
    value["k"] = FixedArray[int[], 1]([[1]])
    return 0


func replace_self(mut value: dict[str, FixedArray[int[], 1]]) -> int:
    value["k"] = value["k"]
    return 0


func remove_and_reinsert(mut value: dict[str, FixedArray[int[], 1]]) -> int:
    _ = value.pop("k")
    value["k"] = FixedArray[int[], 1]([[1]])
    return 0


func write_other(mut value: dict[str, FixedArray[int[], 1]]) -> int:
    value["other"] = FixedArray[int[], 1]([[8]])
    return 0


func grow_leaf(mut value: dict[str, FixedArray[int[], 1]]) -> int:
    value["k"][0].append(7)
    return 0


func capture_parent(mut value: dict[str, FixedArray[int[], 1]], mut saved: dict[str, FixedArray[int[], 1]][]) -> int:
    saved.append(value)
    value["other"] = FixedArray[int[], 1]([[8]])
    return 0


func capture_outer(mut value: dict[str, FixedArray[int[], 1]][], mut saved: dict[str, FixedArray[int[], 1]][][]) -> int:
    saved.append(value)
    value[0]["other"] = FixedArray[int[], 1]([[8]])
    return 0


func replace_row_alias(mut value: FixedArray[int[], 1][]) -> int:
    mut copied = value[0]
    value[0] = copied
    return 0


func reverse_rows(mut value: FixedArray[int[], 1][]) -> int:
    value.reverse()
    return 0


func remove_first(mut value: FixedArray[int[], 1][]) -> int:
    _ = value.pop(0)
    return 0


func nested_index(mut value: dict[str, FixedArray[int[], 1]]) -> int:
    mut selected = write_other(mut value)
    value["k"][selected].append(7)
    return 0


func absent_index() -> int?:
    return None


func stop_early(mut value: dict[str, FixedArray[int[], 1]]) -> int?:
    const captured_array = value["k"]
    const index = try absent_index()
    value["k"][index].append(2)
    return Some(1)


public func test_equal_replacements_before_update_have_equal_results() -> bool:
    mut original: dict[str, FixedArray[int[], 1]] = {"k": FixedArray[int[], 1]([[1]])}
    mut first = original
    mut second = original
    mut selected = replace_alias(mut first)
    first["k"][selected].append(2)
    selected = replace_fresh(mut second)
    second["k"][selected].append(2)
    return original["k"][0] == [1] and first["k"][0] == [1, 2] and second["k"][0] == [1, 2]


public func test_reinserted_equal_entry_is_updated_after_the_call() -> bool:
    mut original: dict[str, FixedArray[int[], 1]] = {"k": FixedArray[int[], 1]([[1]])}
    mut changed = original
    mut selected = replace_self(mut changed)
    changed["k"][selected].append(2)
    return original["k"][0] == [1] and changed["k"][0] == [1, 2]


public func test_deleted_and_reinserted_entry_is_updated_after_the_call() -> bool:
    mut original: dict[str, FixedArray[int[], 1]] = {"k": FixedArray[int[], 1]([[1]])}
    mut changed = original
    mut selected = remove_and_reinsert(mut changed)
    changed["k"][selected].append(2)
    return original["k"][0] == [1] and changed["k"][0] == [1, 2]


public func test_other_entry_write_finishes_before_the_current_update() -> bool:
    mut original: dict[str, FixedArray[int[], 1]] = {"k": FixedArray[int[], 1]([[1]]), "other": FixedArray[int[], 1]([[0]])}
    mut changed = original
    mut selected = write_other(mut changed)
    changed["k"][selected].append(2)
    return original["k"][0] == [1] and original["other"][0] == [0] and changed["k"][0] == [1, 2] and changed["other"][0] == [8]


public func test_leaf_call_and_later_update_keep_both_writes() -> bool:
    mut original: dict[str, FixedArray[int[], 1]] = {"k": FixedArray[int[], 1]([[1]])}
    mut changed = original
    mut selected = grow_leaf(mut changed)
    changed["k"][selected].append(2)
    return original["k"][0] == [1] and changed["k"][0] == [1, 7, 2]


public func test_a_callback_can_snapshot_the_whole_parent() -> bool:
    mut original: dict[str, FixedArray[int[], 1]] = {"k": FixedArray[int[], 1]([[1]])}
    mut changed = original
    mut saved: dict[str, FixedArray[int[], 1]][] = []
    mut selected = capture_parent(mut changed, mut saved)
    changed["k"][selected].append(2)
    return original["k"][0] == [1] and changed["k"][0] == [1, 2] and saved[0]["k"][0] == [1] and len(saved[0]) == 1


public func test_a_callback_can_snapshot_an_outer_ancestor() -> bool:
    mut original: dict[str, FixedArray[int[], 1]][] = [{"k": FixedArray[int[], 1]([[1]])}]
    mut changed = original
    mut saved: dict[str, FixedArray[int[], 1]][][] = []
    mut selected = capture_outer(mut changed, mut saved)
    changed[0]["k"][selected].append(2)
    return original[0]["k"][0] == [1] and changed[0]["k"][0] == [1, 2] and saved[0][0]["k"][0] == [1] and len(saved[0][0]) == 1


public func test_equal_list_element_replacement_is_updated_after_the_call() -> bool:
    mut original: FixedArray[int[], 1][] = [FixedArray[int[], 1]([[1]])]
    mut changed = original
    mut selected = replace_row_alias(mut changed)
    changed[0][selected].append(2)
    return original[0][0] == [1] and changed[0][0] == [1, 2]


public func test_reordering_finishes_before_selecting_the_current_receiver() -> bool:
    mut original: FixedArray[int[], 1][] = [FixedArray[int[], 1]([[1]]), FixedArray[int[], 1]([[8]])]
    mut changed = original
    mut selected = reverse_rows(mut changed)
    changed[0][selected].append(2)
    return original[0][0] == [1] and changed[0][0] == [8, 2] and changed[1][0] == [1]


public func test_removing_an_element_finishes_before_selecting_the_shifted_receiver() -> bool:
    mut original: FixedArray[int[], 1][] = [FixedArray[int[], 1]([[8]]), FixedArray[int[], 1]([[1]])]
    mut changed = original
    mut selected = remove_first(mut changed)
    changed[0][selected].append(2)
    return original[1][0] == [1] and changed[0][0] == [1, 2] and len(changed) == 1


public func test_nested_calls_finish_before_each_receiver_is_selected() -> bool:
    mut original: dict[str, FixedArray[int[], 1]] = {"k": FixedArray[int[], 1]([[1]])}
    mut changed = original
    mut selected = nested_index(mut changed)
    changed["k"][selected].append(2)
    mut copied = changed
    changed["k"][0].append(3)
    return original["k"][0] == [1] and copied["k"][0] == [1, 7, 2] and changed["k"][0] == [1, 7, 2, 3]


public func test_option_propagation_releases_a_pending_receiver() -> bool:
    mut original: dict[str, FixedArray[int[], 1]] = {"k": FixedArray[int[], 1]([[1]])}
    mut changed = original
    mut result = stop_early(mut changed)
    mut copied = changed
    changed["k"][0].append(3)
    return result == None and original["k"][0] == [1] and copied["k"][0] == [1] and changed["k"][0] == [1, 3]


# These two keys collide in the native dictionary's 32-bit scalar hash.
func overwrite_collision(mut value: dict[int, FixedArray[int[], 1]]) -> int:
    value[137867] = FixedArray[int[], 1]([[8]])
    return 0


public func test_colliding_keys_do_not_invalidate_the_other_receiver() -> bool:
    mut original: dict[int, FixedArray[int[], 1]] = {73358: FixedArray[int[], 1]([[1]]), 137867: FixedArray[int[], 1]([[0]])}
    mut changed = original
    mut selected = overwrite_collision(mut changed)
    changed[73358][selected].append(2)
    return original[73358][0] == [1] and changed[73358][0] == [1, 2] and changed[137867][0] == [8]


record A:
    child: B


record B:
    items: FixedArray[int[], 1]
    tail: FixedArray[A, 0]


func capture_box(value: FixedArray[A, 1], mut saved: FixedArray[A, 1][]) -> int:
    saved.append(value)
    return 0


public func test_a_callback_can_snapshot_a_box_on_the_pending_path() -> bool:
    mut original: FixedArray[A, 1] = FixedArray[A, 1]([A(child=B(items=FixedArray[int[], 1]([[1]]), tail=FixedArray[A, 0]([])))])
    mut changed = original
    mut saved: FixedArray[A, 1][] = []
    changed[0].child.items[capture_box(changed, mut saved)].append(2)
    return original[0].child.items[0] == [1] and changed[0].child.items[0] == [1, 2] and saved[0][0].child.items[0] == [1]


record Branch:
    items: int[]
    next: Branch?


func capture_branch(value: FixedArray[Branch, 1], mut saved: FixedArray[Branch, 1][]) -> int:
    saved.append(value)
    return 0


public func test_deep_recursive_siblings_are_outside_the_pending_path() -> bool:
    mut branch = Branch(items=[1], next=None)
    for i in range(1200):
        branch = Branch(items=[1], next=Some(branch))
    mut original: FixedArray[Branch, 1] = FixedArray[Branch, 1]([branch])
    mut changed = original
    mut saved: FixedArray[Branch, 1][] = []
    changed[capture_branch(changed, mut saved)].items.append(2)
    return original[0].items == [1] and changed[0].items == [1, 2] and saved[0][0].items == [1]


record OuterA:
    child: OuterB


record OuterB:
    entries: dict[str, FixedArray[int[], 1]]
    tail: FixedArray[OuterA, 0]


func capture_outer_box(value: FixedArray[OuterA, 1], mut saved: FixedArray[OuterA, 1][]) -> int:
    saved.append(value)
    return 0


public func test_a_callback_can_snapshot_a_box_above_the_dictionary_owner() -> bool:
    mut original: FixedArray[OuterA, 1] = FixedArray[OuterA, 1]([OuterA(child=OuterB(entries={"k": FixedArray[int[], 1]([[1]])}, tail=FixedArray[OuterA, 0]([])))])
    mut changed = original
    mut saved: FixedArray[OuterA, 1][] = []
    changed[0].child.entries["k"][capture_outer_box(changed, mut saved)].append(2)
    return original[0].child.entries["k"][0] == [1] and changed[0].child.entries["k"][0] == [1, 2] and saved[0][0].child.entries["k"][0] == [1]


func capture_rows(value: FixedArray[int[], 1][], mut saved: FixedArray[int[], 1][][]) -> int:
    saved.append(value)
    return 0


public func test_a_negative_list_index_retains_its_pending_array() -> bool:
    mut original: FixedArray[int[], 1][] = [FixedArray[int[], 1]([[1]])]
    mut changed = original
    mut saved: FixedArray[int[], 1][][] = []
    changed[-1][capture_rows(changed, mut saved)].append(2)
    return original[0][0] == [1] and changed[0][0] == [1, 2] and saved[0][0][0] == [1]


record LookupKey:
    label: str
    number: int


func discard_keys(mut keys: LookupKey[]) -> int:
    keys.clear()
    return 0


public func test_a_last_use_key_borrow_survives_its_list_being_cleared() -> bool:
    mut key = LookupKey(label="target", number=1)
    mut original: dict[LookupKey, FixedArray[int[], 1]] = {key: FixedArray[int[], 1]([[1]])}
    mut changed = original
    mut keys = [key]
    mut selected = keys[0]
    changed[selected][discard_keys(mut keys)].append(2)
    return original[key][0] == [1] and changed[key][0] == [1, 2] and len(keys) == 0
