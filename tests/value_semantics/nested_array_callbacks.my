module nested_array_callbacks

def replace_alias(value: mut dict[str, [1]list[int]]) -> int:
    copied = value["k"]
    value["k"] = copied
    return 0


def replace_fresh(value: mut dict[str, [1]list[int]]) -> int:
    value["k"] = [[1]]
    return 0


def replace_self(value: mut dict[str, [1]list[int]]) -> int:
    value["k"] = value["k"]
    return 0


def remove_and_reinsert(value: mut dict[str, [1]list[int]]) -> int:
    _ = value.pop("k")
    value["k"] = [[1]]
    return 0


def write_other(value: mut dict[str, [1]list[int]]) -> int:
    value["other"] = [[8]]
    return 0


def grow_leaf(value: mut dict[str, [1]list[int]]) -> int:
    value["k"][0].append(7)
    return 0


def capture_parent(value: mut dict[str, [1]list[int]], saved: mut list[dict[str, [1]list[int]]]) -> int:
    saved.append(value)
    value["other"] = [[8]]
    return 0


def capture_outer(value: mut list[dict[str, [1]list[int]]], saved: mut list[list[dict[str, [1]list[int]]]]) -> int:
    saved.append(value)
    value[0]["other"] = [[8]]
    return 0


def replace_row_alias(value: mut list[[1]list[int]]) -> int:
    copied = value[0]
    value[0] = copied
    return 0


def reverse_rows(value: mut list[[1]list[int]]) -> int:
    value.reverse()
    return 0


def remove_first(value: mut list[[1]list[int]]) -> int:
    _ = value.pop(0)
    return 0


def nested_index(value: mut dict[str, [1]list[int]]) -> int:
    value["k"][write_other(mut value)].append(7)
    return 0


def absent_index() -> Option[int]:
    return None


def stop_early(value: mut dict[str, [1]list[int]]) -> Option[int]:
    value["k"][absent_index()?].append(2)
    return Some(1)


# spec-case: COW-NESTED-1
public def test_equal_replacements_are_indistinguishable() -> bool:
    original: dict[str, [1]list[int]] = {"k": [[1]]}
    first = original
    second = original
    first["k"][replace_alias(mut first)].append(2)
    second["k"][replace_fresh(mut second)].append(2)
    return original["k"][0] == [1] and first["k"][0] == [1] and second["k"][0] == [1]


# spec-case: COW-NESTED-1
public def test_reinserting_the_same_value_replaces_the_pending_entry() -> bool:
    original: dict[str, [1]list[int]] = {"k": [[1]]}
    changed = original
    changed["k"][replace_self(mut changed)].append(2)
    return original["k"][0] == [1] and changed["k"][0] == [1]


# spec-case: COW-NESTED-1
public def test_deletion_and_equal_reinsertion_replaces_the_pending_entry() -> bool:
    original: dict[str, [1]list[int]] = {"k": [[1]]}
    changed = original
    changed["k"][remove_and_reinsert(mut changed)].append(2)
    return original["k"][0] == [1] and changed["k"][0] == [1]


# spec-case: COW-NESTED-1
public def test_replacing_another_entry_keeps_the_pending_write() -> bool:
    original: dict[str, [1]list[int]] = {"k": [[1]], "other": [[0]]}
    changed = original
    changed["k"][write_other(mut changed)].append(2)
    return original["k"][0] == [1] and original["other"][0] == [0] and changed["k"][0] == [1, 2] and changed["other"][0] == [8]


# spec-case: COW-NESTED-1
public def test_mutating_the_pending_leaf_keeps_both_writes() -> bool:
    original: dict[str, [1]list[int]] = {"k": [[1]]}
    changed = original
    changed["k"][grow_leaf(mut changed)].append(2)
    return original["k"][0] == [1] and changed["k"][0] == [1, 7, 2]


# spec-case: COW-NESTED-1
public def test_a_callback_can_snapshot_the_whole_parent() -> bool:
    original: dict[str, [1]list[int]] = {"k": [[1]]}
    changed = original
    saved: list[dict[str, [1]list[int]]] = []
    changed["k"][capture_parent(mut changed, mut saved)].append(2)
    return original["k"][0] == [1] and changed["k"][0] == [1, 2] and saved[0]["k"][0] == [1] and len(saved[0]) == 1


# spec-case: COW-NESTED-1
public def test_a_callback_can_snapshot_an_outer_ancestor() -> bool:
    original: list[dict[str, [1]list[int]]] = [{"k": [[1]]}]
    changed = original
    saved: list[list[dict[str, [1]list[int]]]] = []
    changed[0]["k"][capture_outer(mut changed, mut saved)].append(2)
    return original[0]["k"][0] == [1] and changed[0]["k"][0] == [1, 2] and saved[0][0]["k"][0] == [1] and len(saved[0][0]) == 1


# spec-case: COW-NESTED-1
public def test_equal_list_element_replacement_detaches_the_receiver() -> bool:
    original: list[[1]list[int]] = [[[1]]]
    changed = original
    changed[0][replace_row_alias(mut changed)].append(2)
    return original[0][0] == [1] and changed[0][0] == [1]


# spec-case: COW-NESTED-1
public def test_reordering_list_elements_preserves_the_selected_receiver() -> bool:
    original: list[[1]list[int]] = [[[1]], [[8]]]
    changed = original
    changed[0][reverse_rows(mut changed)].append(2)
    return original[0][0] == [1] and changed[0][0] == [8] and changed[1][0] == [1, 2]


# spec-case: COW-NESTED-1
public def test_removing_an_earlier_element_preserves_the_selected_receiver() -> bool:
    original: list[[1]list[int]] = [[[8]], [[1]]]
    changed = original
    changed[1][remove_first(mut changed)].append(2)
    return original[1][0] == [1] and changed[0][0] == [1, 2] and len(changed) == 1


# spec-case: COW-NESTED-1
public def test_nested_pending_receivers_restore_outer_pins() -> bool:
    original: dict[str, [1]list[int]] = {"k": [[1]]}
    changed = original
    changed["k"][nested_index(mut changed)].append(2)
    copied = changed
    changed["k"][0].append(3)
    return original["k"][0] == [1] and copied["k"][0] == [1, 7, 2] and changed["k"][0] == [1, 7, 2, 3]


# spec-case: COW-NESTED-1
public def test_option_propagation_releases_a_pending_receiver() -> bool:
    original: dict[str, [1]list[int]] = {"k": [[1]]}
    changed = original
    result = stop_early(mut changed)
    copied = changed
    changed["k"][0].append(3)
    return result == None and original["k"][0] == [1] and copied["k"][0] == [1] and changed["k"][0] == [1, 3]


# These two keys collide in the native dictionary's 32-bit scalar hash.
def overwrite_collision(value: mut dict[int, [1]list[int]]) -> int:
    value[137867] = [[8]]
    return 0


# spec-case: COW-NESTED-1
public def test_colliding_keys_do_not_invalidate_the_other_receiver() -> bool:
    original: dict[int, [1]list[int]] = {73358: [[1]], 137867: [[0]]}
    changed = original
    changed[73358][overwrite_collision(mut changed)].append(2)
    return original[73358][0] == [1] and changed[73358][0] == [1, 2] and changed[137867][0] == [8]


record A:
    child: B


record B:
    items: [1]list[int]
    tail: [0]A


def capture_box(value: [1]A, saved: mut list[[1]A]) -> int:
    saved.append(value)
    return 0


# spec-case: COW-NESTED-1
public def test_a_callback_can_snapshot_a_box_on_the_pending_path() -> bool:
    original: [1]A = [A(child=B(items=[[1]], tail=[]))]
    changed = original
    saved: list[[1]A] = []
    changed[0].child.items[capture_box(changed, mut saved)].append(2)
    return original[0].child.items[0] == [1] and changed[0].child.items[0] == [1, 2] and saved[0][0].child.items[0] == [1]


record Branch:
    items: list[int]
    next: Option[Branch]


def capture_branch(value: [1]Branch, saved: mut list[[1]Branch]) -> int:
    saved.append(value)
    return 0


# spec-case: COW-NESTED-1
public def test_deep_recursive_siblings_are_outside_the_pending_path() -> bool:
    branch = Branch(items=[1], next=None)
    for i in range(1200):
        branch = Branch(items=[1], next=Some(branch))
    original: [1]Branch = [branch]
    changed = original
    saved: list[[1]Branch] = []
    changed[capture_branch(changed, mut saved)].items.append(2)
    return original[0].items == [1] and changed[0].items == [1, 2] and saved[0][0].items == [1]


# spec-case: ARENA-ESCAPE-VALUE-1
public def test_a_pending_receiver_inside_an_arena_can_escape_afterward() -> bool:
    original: dict[str, [1]list[int]] = {"k": [[1]]}
    kept = original
    untouched = True
    with arena() as scratch:
        inside: dict[str, [1]list[int]] = {"k": [[1]]}
        changed = inside
        changed["k"][write_other(mut changed)].append(2)
        untouched = inside["k"][0] == [1]
        kept = scratch.escape(changed)
    return untouched and original["k"][0] == [1] and kept["k"][0] == [1, 2] and kept["other"][0] == [8]


record OuterA:
    child: OuterB


record OuterB:
    entries: dict[str, [1]list[int]]
    tail: [0]OuterA


def capture_outer_box(value: [1]OuterA, saved: mut list[[1]OuterA]) -> int:
    saved.append(value)
    return 0


# spec-case: COW-NESTED-1
public def test_a_callback_can_snapshot_a_box_above_the_dictionary_owner() -> bool:
    original: [1]OuterA = [OuterA(child=OuterB(entries={"k": [[1]]}, tail=[]))]
    changed = original
    saved: list[[1]OuterA] = []
    changed[0].child.entries["k"][capture_outer_box(changed, mut saved)].append(2)
    return original[0].child.entries["k"][0] == [1] and changed[0].child.entries["k"][0] == [1, 2] and saved[0][0].child.entries["k"][0] == [1]


def capture_rows(value: list[[1]list[int]], saved: mut list[list[[1]list[int]]]) -> int:
    saved.append(value)
    return 0


# spec-case: COW-NESTED-1
public def test_a_negative_list_index_retains_its_pending_array() -> bool:
    original: list[[1]list[int]] = [[[1]]]
    changed = original
    saved: list[list[[1]list[int]]] = []
    changed[-1][capture_rows(changed, mut saved)].append(2)
    return original[0][0] == [1] and changed[0][0] == [1, 2] and saved[0][0][0] == [1]


record LookupKey:
    label: str
    number: int


def discard_keys(keys: mut list[LookupKey]) -> int:
    keys.clear()
    return 0


# spec-case: COW-NESTED-1
public def test_a_last_use_key_borrow_survives_its_list_being_cleared() -> bool:
    key = LookupKey(label="target", number=1)
    original: dict[LookupKey, [1]list[int]] = {key: [[1]]}
    changed = original
    keys = [key]
    selected = keys[0]
    changed[selected][discard_keys(mut keys)].append(2)
    return original[key][0] == [1] and changed[key][0] == [1, 2] and len(keys) == 0
