module field_return

record Box:
    items: list[int]


record Owner:
    box: Box
    other: Box


record CountOwner:
    box: Box
    count: int


record IndexedOwner:
    box: Box
    others: list[Box]


def push(box: mut Box):
    box.items.append(2)


def change(owner: mut Owner):
    work = owner.box
    push(mut work)
    owner.box = work


def observe(owner: mut Owner) -> int:
    work = owner.box
    push(mut work)
    seen = len(owner.box.items)
    owner.box = work
    return seen


def conditional(owner: mut Owner, stop: bool):
    work = owner.box
    push(mut work)
    if stop:
        return
    owner.box = work


def retain(owner: mut Owner) -> int:
    work = owner.box
    push(mut work)
    owner.box = work
    push(mut work)
    return len(work.items)


def other_field(owner: mut Owner):
    work = owner.box
    push(mut work)
    owner.other = work


def observe_alias(first: mut Owner, second: mut Owner) -> int:
    work = first.box
    push(mut work)
    seen = len(second.box.items)
    second.other = Box([9])
    first.box = work
    return seen


def observe_sibling(owner: mut CountOwner) -> int:
    work = owner.box
    push(mut work)
    seen = owner.count
    owner.box = work
    return seen


def indexed_sibling(owner: mut IndexedOwner, index: int) -> int:
    work = owner.box
    push(mut work)
    seen = owner.others[index].items[-1]
    owner.box = work
    return seen


def looped(owner: mut Owner, count: Option[int], stop: bool):
    work = owner.box
    match count:
        case Some(n):
            for i in range(n):
                push(mut work)
                if stop:
                    return
        case None:
            push(mut work)
    owner.box = work


def closed_loop(owner: mut Owner, count: Option[int]):
    work = owner.box
    match count:
        case Some(n):
            for i in range(n):
                push(mut work)
        case None:
            push(mut work)
    owner.box = work


def loop_observation(owner: mut Owner, stop: bool) -> int:
    work = owner.box
    seen = 0
    for i in range(3):
        push(mut work)
        seen += len(owner.box.items)
        if stop:
            break
    owner.box = work
    return seen


def joined_extraction(owner: mut Owner, choose: bool):
    if choose:
        work = owner.box
        push(mut work)
    else:
        work = owner.other
    owner.box = work


# spec-case: COW-FIELD-RETURN-1
public def test_field_return_preserves_existing_copies_and_sibling_values() -> bool:
    box = Box([1])
    owner = Owner(box, box)
    saved = owner
    change(mut owner)
    change(mut owner)
    return owner.box.items == [1, 2, 2] and owner.other.items == [1] and saved.box.items == [1] and box.items == [1]


# spec-case: COW-FIELD-RETURN-1
public def test_observation_before_store_back_sees_original_value() -> bool:
    owner = Owner(Box([1]), Box([]))
    seen = observe(mut owner)
    return seen == 1 and owner.box.items == [1, 2]


# spec-case: COW-FIELD-RETURN-1
public def test_early_return_does_not_write_the_original_field() -> bool:
    owner = Owner(Box([1]), Box([]))
    conditional(mut owner, True)
    untouched = owner.box.items == [1]
    conditional(mut owner, False)
    return untouched and owner.box.items == [1, 2]


# spec-case: COW-FIELD-RETURN-1
public def test_retained_temporary_and_other_destination_stay_independent() -> bool:
    owner = Owner(Box([1]), Box([]))
    size = retain(mut owner)
    other_field(mut owner)
    return size == 3 and owner.box.items == [1, 2] and owner.other.items == [1, 2, 2]


# spec-case: COW-FIELD-RETURN-1
public def test_two_mut_parameters_can_observe_the_same_original_field() -> bool:
    owner = Owner(Box([1]), Box([]))
    seen = observe_alias(mut owner, mut owner)
    return seen == 1 and owner.box.items == [1, 2] and owner.other.items == [9]


# spec-case: COW-FIELD-RETURN-1
public def test_a_sibling_scalar_field_stays_readable_during_mutation() -> bool:
    owner = CountOwner(Box([1]), 7)
    seen = observe_sibling(mut owner)
    return seen == 7 and owner.box.items == [1, 2]


# spec-case: COW-FIELD-RETURN-1
public def test_sibling_index_normalization_keeps_shared_snapshots_independent() -> bool:
    original = Box([7])
    owner = IndexedOwner(original, [original])
    seen = indexed_sibling(mut owner, -1)
    return seen == 7 and owner.box.items == [7, 2] and owner.others[0].items == [7] and original.items == [7]


# spec-case: COW-FIELD-RETURN-1
public def test_closed_loop_and_match_store_back_preserve_copies() -> bool:
    original = Box([1])
    owner = Owner(original, original)
    saved = owner
    closed_loop(mut owner, Some(3))
    closed_loop(mut owner, None)
    return owner.box.items == [1, 2, 2, 2, 2] and owner.other.items == [1] and saved.box.items == [1] and original.items == [1]


# spec-case: COW-FIELD-RETURN-1
public def test_loop_exit_does_not_commit_a_partial_field_update() -> bool:
    owner = Owner(Box([1]), Box([]))
    looped(mut owner, Some(3), True)
    unchanged = owner.box.items == [1]
    looped(mut owner, Some(3), False)
    return unchanged and owner.box.items == [1, 2, 2, 2]


# spec-case: COW-FIELD-RETURN-1
public def test_loop_observations_read_the_original_field_until_store_back() -> bool:
    owner = Owner(Box([1]), Box([]))
    seen = loop_observation(mut owner, False)
    return seen == 3 and owner.box.items == [1, 2, 2, 2]


# spec-case: COW-FIELD-RETURN-1
public def test_external_join_preserves_preexisting_values() -> bool:
    owner = Owner(Box([1]), Box([3]))
    saved = owner
    joined_extraction(mut owner, True)
    changed = owner.box.items == [1, 2]
    joined_extraction(mut owner, False)
    change(mut owner)
    return changed and owner.box.items == [3, 2] and owner.other.items == [3] and saved.box.items == [1]
