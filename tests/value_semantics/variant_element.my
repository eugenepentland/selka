record Payload:
    items: int[]
    number: int


enum Item:
    payload(value: Payload)
    empty


func replace_after_match(mut items: Item[], index: int) -> int[]:
    match items[index].copy():
        case Item.payload(value=old):
            items[index] = Item.empty
            mut i = 0
            while i < 80:
                items.append(Item.payload(value=Payload(items=[i], number=i)))
                i += 1
            mut saved = old.items.copy()
            saved.append(old.number)
            return saved
        case Item.empty:
            return []


public func test_payload_survives_parent_replacement_growth_and_collection() -> bool:
    mut items = [Item.payload(value=Payload(items=[1, 2], number=9))]
    mut saved = replace_after_match(mut items, -1)
    return saved == [1, 2, 9] and len(items) == 81 and items[0] == Item.empty


func read_saved_after_replacement(mut items: Item[]) -> int:
    mut saved = items[0].copy()
    items[0] = Item.empty
    match saved:
        case Item.payload(value=old):
            return old.number
        case Item.empty:
            return -1


public func test_nonadjacent_dispatch_keeps_its_original_snapshot() -> bool:
    mut items = [Item.payload(value=Payload(items=[1], number=7))]
    return read_saved_after_replacement(mut items) == 7 and items[0] == Item.empty


public func test_empty_arm_copies_no_payload() -> bool:
    mut items = [Item.empty]
    return len(replace_after_match(mut items, 0)) == 0 and len(items) == 1
