module variant_element


record Payload:
    items: list[int]
    number: int


union Item:
    payload: Payload,
    empty


def replace_after_match(items: mut list[Item], index: int) -> list[int]:
    match items[index]:
        case Item.payload(old):
            items[index] = Item.empty
            i = 0
            while i < 80:
                items.append(Item.payload(Payload([i], i)))
                i += 1
            saved = old.items
            saved.append(old.number)
            return saved
        case Item.empty:
            return []


# spec-case: QBE-VARIANT-ELEMENT-1
public def test_payload_survives_parent_replacement_growth_and_collection() -> bool:
    items = [Item.payload(Payload([1, 2], 9))]
    saved = replace_after_match(mut items, -1)
    return saved == [1, 2, 9] and len(items) == 81 and items[0] == Item.empty


def read_saved_after_replacement(items: mut list[Item]) -> int:
    saved = items[0]
    items[0] = Item.empty
    match saved:
        case Item.payload(old):
            return old.number
        case Item.empty:
            return -1


# spec-case: QBE-VARIANT-ELEMENT-1
public def test_nonadjacent_dispatch_keeps_its_original_snapshot() -> bool:
    items = [Item.payload(Payload([1], 7))]
    return read_saved_after_replacement(mut items) == 7 and items[0] == Item.empty


# spec-case: QBE-VARIANT-ELEMENT-1
public def test_empty_arm_copies_no_payload() -> bool:
    items = [Item.empty]
    return len(replace_after_match(mut items, 0)) == 0 and len(items) == 1
