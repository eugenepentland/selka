module recursive

record Branch:
    items: list[int]
    next: Option[Branch]


def leaf(value: int) -> Branch:
    return Branch(items=[value], next=None)


public def test_a_copied_recursive_box_shares_and_separates_nested_lists() -> bool:
    original = Branch(items=[0], next=Some(leaf(1)))
    changed = original
    child = changed.next
    if child is not None:
        child.items.append(2)
    changed.next = child
    old_child = original.next
    new_child = changed.next
    if old_child is None or new_child is None:
        return False
    return original.items == [0] and changed.items == [0] and old_child.items == [1] and new_child.items == [1, 2]


public def test_repeated_write_through_a_boxed_child() -> bool:
    original = Branch(items=[0], next=Some(leaf(1)))
    changed = original
    child = changed.next
    if child is not None:
        for i in range(3):
            child.items.append(i + 2)
    changed.next = child
    old_child = original.next
    new_child = changed.next
    if old_child is None or new_child is None:
        return False
    return old_child.items == [1] and new_child.items == [1, 2, 3, 4]


def child_of(root: Branch) -> Branch:
    child = root.next
    if child is None:
        return leaf(-1)
    return child


public def test_a_projected_child_is_protected_before_a_later_box_copy() -> bool:
    original = Branch(items=[0], next=Some(leaf(1)))
    exposed = child_of(original)
    copied = original
    exposed.items.append(2)
    old = child_of(copied)
    assert old.items == [1]
    assert exposed.items == [1, 2]
    return child_of(original).items == [1]


def read_child_while_pinned(items: mut list[int], root: Branch) -> Branch:
    snapshot = child_of(root)
    items[0] = 7
    return snapshot


public def test_a_box_projection_copies_a_pinned_child() -> bool:
    original = Branch(items=[0], next=Some(leaf(1)))
    child = child_of(original)
    snapshot = read_child_while_pinned(mut child.items, Branch(items=[0], next=Some(child)))
    assert snapshot.items == [1]
    assert child.items == [7]
    return child_of(original).items == [1]
