# How value semantics meets records, arenas and contract captures.
record Box:
    items: int[]


record Owner:
    box: Box
    tags: int[]


func fill(mut target: int[], count: int) -> Unit:
    for i in range(count):
        target.append(i)


@ensures(len(xs) == len(old(xs)) + 1)
func push_one(mut xs: int[]) -> Unit:
    xs.append(1)


# spec-case: VALUE-SEMANTICS-2
public func test_a_record_has_independent_nested_values() -> bool:
    mut box = Box(items=[1])
    mut alias = box
    alias.items.append(2)
    mut owner = Owner(box=box, tags=[1])
    mut copy = owner
    copy.box.items.append(3)
    copy.tags.append(2)
    return box.items == [1] and alias.items == [1, 2] and owner.box.items == [1] and copy.box.items == [1, 3] and owner.tags == [1] and copy.tags == [1, 2]


# spec-case: VALUE-SEMANTICS-2
public func test_a_list_read_out_of_a_record_is_a_copy() -> bool:
    mut box = Box(items=[1])
    mut taken = box.items
    taken.append(2)
    box.items.append(3)
    return taken == [1, 2] and box.items == [1, 3]


# spec: VALUE-SEMANTICS-7
public func test_old_captures_a_collection_by_value() -> bool:
    mut xs = [5]
    push_one(mut xs)
    push_one(mut xs)
    return xs == [5, 1, 1]
