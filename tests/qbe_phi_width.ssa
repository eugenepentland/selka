export function l $cross_phi(w %choice,l %out) {
@start
 jnz %choice,@yes,@no
@yes
 storew 17,%out
 jmp @join
@no
 storew 23,%out
 jmp @join
@join
 %first =w phi @yes -1,@no 0
 %second =l phi @yes -1,@no 0
 %at =l add %out,8
 storew %first,%at
 ret %second
}

