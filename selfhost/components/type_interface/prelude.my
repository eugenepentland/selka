public func builtin(name: bytes) -> bool:
    if name == b"Unit" or name == b"None" or name == b"int" or len(name) == 0:
        return True
    if len(name) >= 2 and name[0] == 40 and name[len(name) - 1] == 41:
        mut empty = True
        for i in range(1, len(name) - 1):
            if name[i] != 32 and name[i] != 9 and name[i] != 13 and name[i] != 10:
                empty = False
        if empty:
            return True
    for item in [b"i64", b"bool", b"i8", b"i16", b"i32", b"u8", b"u16", b"u32", b"u64", b"clock_cap", b"random_cap", b"filesystem_cap", b"network_cap", b"environment_cap", b"host_cap", b"unit", b"file", b"text_file", b"stream_cap"]:
        if name == item:
            return True
    return False


public func scalar(name: bytes) -> bool:
    for item in [b"str", b"bytes", b"float", b"byte_buffer", b"Filesystem", b"Network", b"Clock", b"Entropy", b"Environment", b"Host", b"Stream", b"File", b"TextFile"]:
        if name == item:
            return True
    return False


public func arity(name: bytes) -> int:
    for item in [b"list", b"set", b"Option", b"Cell"]:
        if item == name:
            return 1
    for item in [b"dict", b"Result", b"DictItem", b"DictKeys", b"DictValues", b"DictItems"]:
        if item == name:
            return 2
    return -1
