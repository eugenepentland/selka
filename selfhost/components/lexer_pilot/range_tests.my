import lexer
import source

public func test_range_absolute_and_no_layout() -> bool:
    match lexer.lex_range(source.make(b"xx  a:\n    b\n yy"), 4, 12):
        case Ok(tokens):
            return len(tokens) == 4 and tokens[0].kind == "ident" and tokens[0].start == 4 and tokens[1].kind == "colon" and tokens[2].kind == "ident" and tokens[2].start == 11 and tokens[3].kind == "eof" and tokens[3].start == 12
        case Err(item):
            return False


public func test_range_empty_at_offset() -> bool:
    match lexer.lex_range(source.make(b"abc"), 2, 2):
        case Ok(tokens):
            return len(tokens) == 1 and tokens[0].kind == "eof" and tokens[0].start == 2
        case Err(item):
            return False


public func test_range_full_source_number_extent() -> bool:
    match lexer.lex_range(source.make(b"x 12345 y"), 2, 4):
        case Ok(tokens):
            return len(tokens) == 2 and tokens[0].kind == "integer" and tokens[0].start == 2 and tokens[0].end == 7 and tokens[1].start == 7
        case Err(item):
            return False


public func test_range_error_absolute_location() -> bool:
    match lexer.lex_range(source.make(b"a\n  $\n"), 4, 5):
        case Ok(tokens):
            return False
        case Err(item):
            return item.code == "E_TOKEN" and item.start == 4 and item.end == 5 and item.line == 2 and item.column == 3
