# Current-profile pilot scanner and layout lowering; spans refer to immutable raw bytes.
# Call lex only with source.make(raw); the source record invariants are required.
import source
import token
import diagnostic

const TAB: int = 9


const LF: int = 10


const CR: int = 13


const SPACE: int = 32


const HASH: int = 35


const SINGLE_QUOTE: int = 39


const DOUBLE_QUOTE: int = 34


const BACKSLASH: int = 92


const LETTER_B: int = 98


const LETTER_F: int = 102


# ASCII letter (no underscore), the stage-0 alphabetic test.
func is_letter(byte: int) -> bool:
    if byte >= 65 and byte <= 90:
        return True
    return byte >= 97 and byte <= 122


# ASCII identifier start: letters and underscore.
func is_alpha(byte: int) -> bool:
    if is_letter(byte):
        return True
    return byte == 95


# ASCII identifier continuation: letters, digits and underscore.
func is_alnum(byte: int) -> bool:
    if is_alpha(byte):
        return True
    return byte >= 48 and byte <= 57


# std.ascii.isAlphanumeric: letters and digits only, no underscore. Numeric
# scanning retains letters and digits; number_word_end also retains underscores.
func is_number_alnum(byte: int) -> bool:
    if is_letter(byte):
        return True
    return byte >= 48 and byte <= 57


func is_digit(byte: int) -> bool:
    return byte >= 48 and byte <= 57


# std.ascii.isWhitespace: space and bytes 9 through 13.
func is_space(byte: int) -> bool:
    if byte == SPACE:
        return True
    return byte >= 9 and byte <= 13


# Metadata for one located lexical failure.
func make_diag(src: source.Source, code: str, start: int, end: int, message: str) -> diagnostic.Diagnostic:
    mut at = source.locate(src, start)
    return diagnostic.Diagnostic(code=code, line=at.line, column=at.column, start=start, end=end, message=message)


# Find the extent of a quoted byte/format literal under stage-0 termination rules.
func byte_literal_end(src: source.Source, quote_index: int) -> int fails diagnostic.Diagnostic:
    mut raw = src.raw
    mut limit = len(raw)
    mut index = quote_index + 1
    while index < limit:
        if raw[index] == raw[quote_index]:
            return index + 1
        if raw[index] == LF or raw[index] == CR:
            break
        if raw[index] == BACKSLASH:
            index += 1
            if index == limit or raw[index] == LF or raw[index] == CR:
                break
        index += 1
    fail make_diag(src, diagnostic.E_BYTE_LITERAL, quote_index, index, "unterminated byte literal; escape newlines with \\n")


# Numeric token extent matches number_literal.end in the shipped stage-0.
# Prefix digits, underscores and malformed suffixes stay in one number token.
func number_word_end(raw: bytes, start: int) -> int:
    mut at = start
    while at < len(raw) and (is_number_alnum(raw[at]) or raw[at] == 95):
        at += 1
    return at


func number_digits_end(raw: bytes, start: int) -> int:
    mut at = start
    while at < len(raw) and (is_digit(raw[at]) or raw[at] == 95):
        at += 1
    return at


func exponent_ahead(raw: bytes, start: int) -> bool:
    if start >= len(raw) or (raw[start] != 101 and raw[start] != 69):
        return False
    mut at = start + 1
    if at < len(raw) and (raw[at] == 43 or raw[at] == 45):
        at += 1
    return at < len(raw) and is_digit(raw[at])


func dot_belongs(raw: bytes, dot: int) -> bool:
    mut following = dot + 1
    if following >= len(raw):
        return True
    if is_digit(raw[following]):
        return True
    if is_alnum(raw[following]):
        return exponent_ahead(raw, following)
    return True


func float_end(src: source.Source, start: int) -> int:
    mut raw = src.raw
    mut limit = len(raw)
    if raw[start] == 48 and start + 1 < limit:
        mut base = raw[start + 1]
        if base == 120 or base == 88 or base == 111 or base == 79 or base == 98 or base == 66:
            return number_word_end(raw, start + 2)
    mut at = number_digits_end(raw, start)
    if at < limit and raw[at] == 46 and dot_belongs(raw, at):
        at = number_digits_end(raw, at + 1)
    if at < limit and (raw[at] == 101 or raw[at] == 69):
        at += 1
        if at < limit and (raw[at] == 43 or raw[at] == 45):
            at += 1
    return number_word_end(raw, at)


# A directly adjacent operand keeps its dot as field-access punctuation.
func follows_operand(tokens: token.Token[], start: int) -> bool:
    if len(tokens) == 0:
        return False
    mut previous = tokens[len(tokens) - 1]
    if previous.end != start:
        return False
    mut kind = previous.kind
    return kind == "ident" or kind == "integer" or kind == "bytes" or kind == "format" or kind == "rparen" or kind == "rbracket" or kind == "rbrace" or kind == "kw_true" or kind == "kw_false" or kind == "kw_none"


# Current baseline keyword and alias inventory; removed words fail lexically.
func classify_word(src: source.Source, word: bytes, start: int, end: int) -> str fails diagnostic.Diagnostic:
    if word == b"filesystem_cap":
        fail make_diag(src, diagnostic.E_REMOVED_SPELLING, start, end, "removed spelling")
    if word == b"network_cap":
        fail make_diag(src, diagnostic.E_REMOVED_SPELLING, start, end, "removed spelling")
    if word == b"clock_cap":
        fail make_diag(src, diagnostic.E_REMOVED_SPELLING, start, end, "removed spelling")
    if word == b"random_cap":
        fail make_diag(src, diagnostic.E_REMOVED_SPELLING, start, end, "removed spelling")
    if word == b"environment_cap":
        fail make_diag(src, diagnostic.E_REMOVED_SPELLING, start, end, "removed spelling")
    if word == b"codec_encode":
        fail make_diag(src, diagnostic.E_REMOVED_SPELLING, start, end, "removed spelling")
    if word == b"codec_decode":
        fail make_diag(src, diagnostic.E_REMOVED_SPELLING, start, end, "removed spelling")
    if word == b"f64_add":
        fail make_diag(src, diagnostic.E_REMOVED_SPELLING, start, end, "removed spelling")
    if word == b"f64_sub":
        fail make_diag(src, diagnostic.E_REMOVED_SPELLING, start, end, "removed spelling")
    if word == b"f64_mul":
        fail make_diag(src, diagnostic.E_REMOVED_SPELLING, start, end, "removed spelling")
    if word == b"f64_div":
        fail make_diag(src, diagnostic.E_REMOVED_SPELLING, start, end, "removed spelling")
    if word == b"f64_eq":
        fail make_diag(src, diagnostic.E_REMOVED_SPELLING, start, end, "removed spelling")
    if word == b"f64_lt":
        fail make_diag(src, diagnostic.E_REMOVED_SPELLING, start, end, "removed spelling")
    if word == b"f64_le":
        fail make_diag(src, diagnostic.E_REMOVED_SPELLING, start, end, "removed spelling")
    if word == b"f64_sqrt":
        fail make_diag(src, diagnostic.E_REMOVED_SPELLING, start, end, "removed spelling")
    if word == b"f64_floor":
        fail make_diag(src, diagnostic.E_REMOVED_SPELLING, start, end, "removed spelling")
    if word == b"f64_ceil":
        fail make_diag(src, diagnostic.E_REMOVED_SPELLING, start, end, "removed spelling")
    if word == b"f64_trunc":
        fail make_diag(src, diagnostic.E_REMOVED_SPELLING, start, end, "removed spelling")
    if word == b"f64_abs":
        fail make_diag(src, diagnostic.E_REMOVED_SPELLING, start, end, "removed spelling")
    if word == b"f64_neg":
        fail make_diag(src, diagnostic.E_REMOVED_SPELLING, start, end, "removed spelling")
    if word == b"f64_from_u64":
        fail make_diag(src, diagnostic.E_REMOVED_SPELLING, start, end, "removed spelling")
    if word == b"f64_to_u64":
        fail make_diag(src, diagnostic.E_REMOVED_SPELLING, start, end, "removed spelling")
    if word == b"bit_and":
        return "kw_bit_and"
    if word == b"bit_or":
        return "kw_bit_or"
    if word == b"bit_xor":
        return "kw_bit_xor"
    if word == b"shift_left":
        return "kw_shift_left"
    if word == b"shift_right":
        return "kw_shift_right"
    if word == b"wrapping_add":
        return "kw_wrapping_add"
    if word == b"wrapping_sub":
        return "kw_wrapping_sub"
    if word == b"wrapping_mul":
        return "kw_wrapping_mul"
    if word == b"saturating_add":
        return "kw_saturating_add"
    if word == b"saturating_sub":
        return "kw_saturating_sub"
    if word == b"saturating_mul":
        return "kw_saturating_mul"
    if word == b"return":
        return "kw_return"
    if word == b"i64":
        return "kw_i64"
    if word == b"bool":
        return "kw_bool"
    if word == b"if":
