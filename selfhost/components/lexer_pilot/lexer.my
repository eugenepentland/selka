    if word == b"wrap":
        return "kw_wrap"
    if word == b"todo":
        return "kw_todo"
    if word == b"unwrap":
        return "kw_unwrap"
    if word == b"enum":
        return "kw_enum"
    if word == b"union":
        return "kw_union"
    if word == b"match":
        return "kw_match"
    if word == b"arena":
