    if word == b"case":
        return "kw_case"
    if word == b"with":
        return "kw_with"
    if word == b"assert":
        return "kw_assert"
    if word == b"func":
        return "kw_def"
    if word == b"def":
        return "kw_def"
    if word == b"class":
        return "kw_class"
    if word == b"True":
        return "kw_true"
    if word == b"False":
        return "kw_false"
    if word == b"None":
        return "kw_none"
    if word == b"and":
        return "and_and"
    if word == b"or":
        return "or_or"
    if word == b"not":
        return "bang"
    if word == b"__float_sqrt":
        return "kw_f64_sqrt"
    if word == b"__float_sin":
        return "kw_f64_sin"
    if word == b"__float_cos":
        return "kw_f64_cos"
    if word == b"__stand_in":
        return "kw_stand_in"
    if word == b"__clock_advance":
        return "kw_clock_advance"
    return "ident"


# '=>' was removed with no replacement and fails at tokenization.
func reject_removed_punctuation(src: source.Source, ch: int, following: int, start: int, end: int) -> int fails diagnostic.Diagnostic:
    if ch == 61 and following == 62:
        fail make_diag(src, diagnostic.E_REMOVED_SPELLING, start, end + 1, "`=>` was removed and has no replacement")
    return 0


# Raw tokenization without indentation lowering.
func tokenize(src: source.Source) -> token.Token[] fails diagnostic.Diagnostic:
    mut raw = src.raw
    mut limit = len(raw)
    mut tokens: token.Token[] = []
    mut index = 0
    mut kind = "ident"
    while index < limit:
        mut start = index
        mut ch = raw[index]
        if ch == SPACE or (ch >= 9 and ch <= 13):
            index += 1
            continue
        if ch == HASH:
            while index < limit and raw[index] != LF:
                index += 1
            continue
        if ch == LETTER_F and index + 1 < limit and (raw[index + 1] == DOUBLE_QUOTE or raw[index + 1] == SINGLE_QUOTE):
            index = try byte_literal_end(src, start + 1)
            tokens.append(token.Token(kind="format", start=start, end=index))
            continue
        if ch == DOUBLE_QUOTE or ch == SINGLE_QUOTE or (ch == LETTER_B and index + 1 < limit and (raw[index + 1] == DOUBLE_QUOTE or raw[index + 1] == SINGLE_QUOTE)):
            mut quote = start
            if ch == LETTER_B:
                quote = start + 1
            if ch != LETTER_B and quote + 2 < limit and raw[quote + 1] == ch and raw[quote + 2] == ch:
                index = try triple_literal_end(src, quote)
            else:
                index = try byte_literal_end(src, quote)
            tokens.append(token.Token(kind="bytes", start=start, end=index))
            continue
        if (ch >= 65 and ch <= 90) or (ch >= 97 and ch <= 122) or ch == 95:
            index += 1
            while index < limit:
                mut byte = raw[index]
                if (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or (byte >= 48 and byte <= 57) or byte == 95:
                    index += 1
                    continue
                break
            mut word = raw[start:index]
            kind = try classify_word(src, word, start, index)
            tokens.append(token.Token(kind=kind, start=start, end=index))
            continue
        if is_digit(ch) or (ch == 46 and index + 1 < limit and is_digit(raw[index + 1]) and not follows_operand(tokens, start)):
            index = float_end(src, start)
            tokens.append(token.Token(kind="integer", start=start, end=index))
            continue
        index += 1
        mut following = 0
        if index < limit:
            following = raw[index]
        _ = try reject_removed_punctuation(src, ch, following, start, index)
        kind = "ident"
        if ch == 46:
            kind = "dot"
        elif ch == 40:
            kind = "lparen"
        elif ch == 41:
            kind = "rparen"
        elif ch == 44:
            kind = "comma"
        elif ch == 61:
            if following == 61:
                index += 1
                kind = "eq_eq"
            else:
                kind = "equal"
        elif ch == 58:
            kind = "colon"
        elif ch == 47:
            if following == 47:
                if index + 1 < limit and raw[index + 1] == 61:
                    index += 2
                    kind = "slash_slash_equal"
                else:
                    index += 1
                    kind = "slash_slash"
            elif following == 61:
                index += 1
                kind = "slash_equal"
            else:
                kind = "slash"
        elif ch == 45:
            if following == 62:
                index += 1
                kind = "arrow"
            elif following == 61:
                index += 1
                kind = "minus_equal"
            else:
                kind = "minus"
        elif ch == 43:
            if following == 61:
                index += 1
                kind = "plus_equal"
            else:
                kind = "plus"
        elif ch == 42:
            if following == 61:
                index += 1
                kind = "star_equal"
            else:
                kind = "star"
        elif ch == 37:
            if following == 61:
                index += 1
                kind = "percent_equal"
            else:
                kind = "percent"
        elif ch == 33:
            if following == 61:
                index += 1
                kind = "bang_eq"
            else:
                fail make_diag(src, diagnostic.E_TOKEN, start, index, "unexpected character in source")
        elif ch == 60:
            if following == 61:
                index += 1
                kind = "le"
            else:
                kind = "lt"
        elif ch == 62:
            if following == 61:
                index += 1
                kind = "ge"
            else:
                kind = "gt"
        elif ch == 91:
            kind = "lbracket"
        elif ch == 93:
            kind = "rbracket"
        elif ch == 123:
            kind = "lbrace"
        elif ch == 125:
            kind = "rbrace"
        elif ch == 59:
            kind = "semicolon"
        elif ch == 63:
            kind = "question"
        elif ch == 64:
            kind = "at"
        elif ch == 124:
            kind = "pipe"
        elif ch == 94:
            kind = "caret"
        elif ch == 38:
            kind = "ampersand"
        else:
            fail make_diag(src, diagnostic.E_TOKEN, start, index, "unexpected character in source")
        tokens.append(token.Token(kind=kind, start=start, end=index))
    tokens.append(token.Token(kind="eof", start=index, end=index))
    return tokens


# Python-layout lowering: a colon at end of a logical line opens a suite, and
# dedents close it with zero-width spans at the next significant token.
func lower(raw_tokens: token.Token[], src: source.Source) -> token.Token[] fails diagnostic.Diagnostic:
    mut out: token.Token[] = []
    mut levels: int[] = [0]
    while len(levels) < 257:
        levels.append(0)
    mut level = 0
    mut delimiters = 0
    mut previous_line = 0 - 1
    mut pending = False
    mut index = 0
    mut count = len(raw_tokens)
    # Raw tokens are in source order, so the line pointer only moves forward.
    # One amortized O(1) walk replaces two binary searches per token.
    mut starts = src.line_starts
    mut line_count = len(starts)
    mut line_ptr = 0
    while index < count:
        mut original = raw_tokens[index]
        mut kind = original.kind
        mut token_start = original.start
        mut token_end = original.end
        while line_ptr + 1 < line_count and starts[line_ptr + 1] <= token_start:
            line_ptr += 1
        mut line = starts[line_ptr]
        if kind == "eof" or (previous_line != line and delimiters == 0):
            mut indent = 0
            if kind != "eof":
                mut at = line
                while at < token_start:
                    mut ch = src.raw[at]
                    if ch == TAB:
                        fail make_diag(src, diagnostic.E_INDENTATION, token_start, token_end, "indentation uses spaces; tabs are not permitted")
                    if ch != SPACE and ch != CR:
                        break
                    indent += 1
                    at += 1
            if pending:
                if kind == "eof" or indent <= levels[level]:
                    fail make_diag(src, diagnostic.E_INDENTATION, token_start, token_end, "expected an indented block after ':'")
                if level + 1 == len(levels):
                    fail make_diag(src, diagnostic.E_NESTING_LIMIT, token_start, token_end, "indentation exceeds 256 levels")
                level += 1
                levels[level] = indent
                pending = False
            else:
                while indent < levels[level]:
                    level -= 1
                    out.append(token.Token(kind="dedent", start=token_start, end=token_start))
                if indent != levels[level]:
                    fail make_diag(src, diagnostic.E_INDENTATION, token_start, token_end, "unexpected indentation or dedent does not match an enclosing block")
        previous_line = line
        mut next_line = False
        if index + 1 < count:
            if raw_tokens[index + 1].kind == "eof":
                next_line = True
            else:
                mut next_start = raw_tokens[index + 1].start
                mut look = line_ptr
                while look + 1 < line_count and starts[look + 1] <= next_start:
                    look += 1
                if starts[look] != line:
                    next_line = True
        if kind == "colon" and delimiters == 0 and next_line:
            kind = "indent"
            pending = True
        else:
            if kind == "lparen" or kind == "lbracket" or kind == "lbrace":
                delimiters += 1
            if kind == "rparen" or kind == "rbracket" or kind == "rbrace":
                delimiters -= 1
                if delimiters < 0:
                    delimiters = 0
        out.append(token.Token(kind=kind, start=token_start, end=token_end))
        index += 1
    return out


# Full current token stream: raw tokenization followed by layout lowering.
public func lex(src: source.Source) -> token.Token[] fails diagnostic.Diagnostic:
    mut raw = try tokenize(src)
    return try lower(raw, src)


# Triple quoted text permits newlines; escapes protect the next byte.
func triple_literal_end(src: source.Source, start: int) -> int fails diagnostic.Diagnostic:
    const raw = src.raw
    mut index = start + 3
    while index < len(raw):
        if raw[index] == BACKSLASH:
            index += 2
            continue
        if raw[index] == raw[start] and index + 2 < len(raw) and raw[index + 1] == raw[start] and raw[index + 2] == raw[start]:
            return index + 3
        index += 1
    fail make_diag(src, diagnostic.E_BYTE_LITERAL, start, len(raw), "unterminated triple-quoted literal; close it with three matching quotes")
