import token
import diagnostic

public func read_u32(data: bytes, at: int) -> int:
    return data[at] + data[at + 1] * 256 + data[at + 2] * 65536 + data[at + 3] * 16777216


public func decode(data: bytes) -> bytes fails str:
    if len(data) < 64 or len(data) > 1048640:
        fail "invalid lexer request size"
    if data[:8] != b"SLKLEX01" or read_u32(data, 8) != 1 or read_u32(data, 12) != 2 or read_u32(data, 16) != 0 or read_u32(data, 20) != len(data) - 64:
        fail "invalid lexer request envelope"
    return data[64:]


func put_u32(mut buffer: byte_buffer, value: int):
    mut rest = value
    for octet in range(4):
        _ = buffer.append_byte(rest % 256)
        rest = rest // 256


