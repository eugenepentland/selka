func error_id(name: str) -> int fails str:
    if name == "E_TOKEN":
        return 0
    if name == "E_INDENTATION":
        return 1
    if name == "E_BYTE_LITERAL":
        return 2
    if name == "E_NESTING_LIMIT":
        return 3
    if name == "E_REMOVED_SPELLING":
        return 4
    fail "unknown lexer wire name"


func header(request: bytes, size: int) -> byte_buffer:
    const empty: int[] = []
    mut buffer = byte_buffer(empty)
    _ = buffer.reserve(size + 64)
    _ = buffer.append_range(b"SLKLEX01", 0, 8)
    put_u32(mut buffer, 1)
    put_u32(mut buffer, 2)
    put_u32(mut buffer, 1)
    put_u32(mut buffer, size)
    _ = buffer.append_range(request, 24, 64)
    return buffer


public func tokens(request: bytes, items: token.Token[]) -> bytes fails str:
    const size = len(request) - 64
    if len(items) == 0 or len(items) > 1048833:
        fail "invalid lexer token count"
    mut buffer = header(request, 8 + len(items) * 12)
    put_u32(mut buffer, 0)
    put_u32(mut buffer, len(items))
    mut previous = 0
    for item in items:
        if item.start < previous or item.end < item.start or item.end > size:
            fail "invalid lexer token span"
        if (item.kind == "eof" or item.kind == "dedent") and item.start != item.end:
            fail "invalid lexer virtual span"
        previous = item.start
        const kind = try kind_id(item.kind)
        put_u32(mut buffer, kind)
        put_u32(mut buffer, item.start)
        put_u32(mut buffer, item.end)
    const last = items[len(items) - 1]
    if last.kind != "eof" or last.start != size:
        fail "invalid lexer eof"
    return bytes(buffer)


public func lexical_error(request: bytes, item: diagnostic.Diagnostic) -> bytes fails str:
    if item.start < 0 or item.end < item.start or item.end > len(request) - 64 or item.line < 1 or item.column < 1:
        fail "invalid lexer error span"
    mut buffer = header(request, 28)
    put_u32(mut buffer, 1)
    put_u32(mut buffer, 0)
    const code = try error_id(item.code)
    put_u32(mut buffer, code)
    put_u32(mut buffer, item.line)
    put_u32(mut buffer, item.column)
    put_u32(mut buffer, item.start)
    put_u32(mut buffer, item.end)
    return bytes(buffer)
