import full_model
import syntax_value
import syntax_problem
import syntax_diagnostics
import syntax_recovery
import full_header

func state(data: bytes, tokens: full_model.Token[]) -> full_model.State:
    const cursor = full_model.Cursor(pos=0, depth=0, delimiters=0, module_syntax=False, trusted_intrinsics=False, path=b"diagnostic_tests.my")
    return full_model.State(tokens=tokens, source=data, cursor=cursor, pool=syntax_value.empty(), exprs=[], stmts=[], catalog=full_model.empty_catalog())


func field(pool: syntax_value.Pool, id: int, name: str) -> int:
    for i in range(len(pool.values[id].names)):
        if pool.values[id].names[i] == name:
            return pool.values[id].children[i]
    return -1


public func test_diagnostic_preserves_notes_fix_and_recovery_order() -> bool fails syntax_value.Problem:
    const problem = syntax_value.Problem(code="E_SYNTAX", start=1, end=3, message="unexpected `token`\n")
    mut diagnostic = syntax_problem.alternative(problem, "use func()")
    diagnostic.notes.edits = [syntax_problem.Edit(start=1, end=3, text=b"func"), syntax_problem.Edit(start=3, end=3, text=b"\n")]
    const second = syntax_problem.plain(syntax_value.Problem(code="E_EXPRESSION", start=3, end=3, message="expected an expression"))
    const pool = try syntax_diagnostics.report([diagnostic, second])
    const values = pool.values[field(pool, len(pool.values) - 1, "diagnostics")].children
    const first = values[0]
    const provenance = field(pool, first, "provenance")
    const fix = field(pool, provenance, "fix")
    const note = field(pool, first, "related")
    return len(values) == 2 and pool.values[field(pool, first, "message")].data == b"unexpected `token`\n" and pool.values[field(pool, note, "role")].data == b"alternative" and len(pool.values[field(pool, fix, "more")].children) == 1 and pool.values[field(pool, values[1], "code")].data == b"E_EXPRESSION"


public func test_diagnostic_refuses_unqualified_unicode_encoding() -> bool:
    const problem = syntax_value.Problem(code="E_SYNTAX", start=0, end=0, message="é")
    match syntax_diagnostics.report([syntax_problem.plain(problem)]):
        case Ok(pool):
            return False
        case Err(failure):
            return failure.code == "P_DIAGNOSTIC"


public func test_recovery_stops_at_same_depth_newline_and_unwinds_depth() -> bool:
    const tokens = [full_model.Token(kind="ident", start=0, end=3), full_model.Token(kind="ident", start=4, end=5), full_model.Token(kind="ident", start=6, end=10), full_model.Token(kind="eof", start=10, end=10)]
    mut p = state(b"bad x\nnext", tokens)
    p.cursor.pos = 1
    p.cursor.depth = 9
    p.cursor.delimiters = 2
    syntax_recovery.recover(mut p, 0, 1)
    return p.cursor.pos == 2 and p.cursor.depth == 1 and p.cursor.delimiters == 0


public func test_recovery_counts_already_consumed_suites() -> bool:
    const tokens = [full_model.Token(kind="kw_if", start=0, end=2), full_model.Token(kind="ident", start=3, end=4), full_model.Token(kind="indent", start=4, end=5), full_model.Token(kind="ident", start=10, end=13), full_model.Token(kind="dedent", start=14, end=14), full_model.Token(kind="ident", start=14, end=18), full_model.Token(kind="eof", start=18, end=18)]
    mut p = state(b"if x:\n    bad\nnext", tokens)
    p.cursor.pos = 3
    syntax_recovery.recover(mut p, 0, 0)
    return p.cursor.pos == 5


public func test_recovery_leaves_enclosing_dedent_to_caller() -> bool:
    const tokens = [full_model.Token(kind="ident", start=0, end=3), full_model.Token(kind="dedent", start=4, end=4), full_model.Token(kind="ident", start=4, end=8), full_model.Token(kind="eof", start=8, end=8)]
    mut p = state(b"bad\nnext", tokens)
    p.cursor.pos = 1
    syntax_recovery.recover(mut p, 0, 1)
    return p.cursor.pos == 1


public func test_recovery_retains_enriched_diagnostic_once() -> bool fails syntax_value.Problem:
    mut p = state(b"bad", [full_model.Token(kind="ident", start=0, end=3), full_model.Token(kind="eof", start=3, end=3)])
    const problem = syntax_value.Problem(code="E_SYNTAX", start=0, end=3, message="bad form")
    _ = try syntax_recovery.annotated(mut p, syntax_problem.alternative(problem, "accepted form"))
    try syntax_recovery.record(mut p, problem)
    return len(p.catalog.problems) == 1 and p.catalog.problems[0].notes.related[0].message == "accepted form"


public func test_expected_token_uses_source_spelling() -> bool:
    mut p = state(b"x", [full_model.Token(kind="ident", start=0, end=1), full_model.Token(kind="eof", start=1, end=1)])
    match full_model.expect(mut p, "rparen"):
        case Ok(token):
            return False
        case Err(problem):
            return problem.code == "E_SYNTAX" and problem.message == "unexpected token; expected )" and full_model.token_spelling("kw_def") == "func" and full_model.token_spelling("semicolon") == "a newline"


public func test_trailing_comma_closes_once_and_saturates_delimiters() -> bool fails syntax_value.Problem:
    mut p = state(b",)", [full_model.Token(kind="comma", start=0, end=1), full_model.Token(kind="rparen", start=1, end=2), full_model.Token(kind="eof", start=2, end=2)])
    const close = try full_model.expect(mut p, "rparen")
    return close.start == 1 and close.end == 2 and p.cursor.pos == 2 and p.cursor.delimiters == 0


public func test_dedent_is_an_implicit_terminator_before_same_offset_token() -> bool fails syntax_value.Problem:
    mut p = state(b"x", [full_model.Token(kind="dedent", start=0, end=0), full_model.Token(kind="ident", start=0, end=1), full_model.Token(kind="eof", start=1, end=1)])
    p.cursor.pos = 1
    const end = try full_model.expect(mut p, "semicolon")
    return end.start == 0 and end.end == 0 and p.cursor.pos == 1


public func test_declared_names_include_intrinsic_collisions_and_internal_spelling() -> bool fails syntax_value.Problem:
    mut p = state(b"len __mine", [full_model.Token(kind="kw_len", start=0, end=3), full_model.Token(kind="ident", start=4, end=10), full_model.Token(kind="eof", start=10, end=10)])
    const first = try full_model.declared_name(mut p)
    const second = try full_model.declared_name(mut p)
    return first.start == 0 and second.start == 4 and second.end == 10


public func test_removed_module_header_preserves_complete_deletion_fix() -> bool:
    mut p = state(b"module demo\n", [full_model.Token(kind="ident", start=0, end=6), full_model.Token(kind="ident", start=7, end=11), full_model.Token(kind="eof", start=12, end=12)])
    p.cursor.module_syntax = True
    match full_header.leading(mut p):
        case Ok(unit):
            return False
        case Err(problem):
            if problem.code != "E_MODULE_HEADER" or problem.start != 0 or problem.end != 11 or len(p.catalog.problems) != 1:
                return False
            const fixes = p.catalog.problems[0].notes.edits
            return len(fixes) == 1 and fixes[0].start == 0 and fixes[0].end == 11 and fixes[0].text == b""


public func test_removed_bare_export_reports_name_span() -> bool:
    mut p = state(b"export item", [full_model.Token(kind="ident", start=0, end=6), full_model.Token(kind="ident", start=7, end=11), full_model.Token(kind="eof", start=11, end=11)])
    p.cursor.module_syntax = True
    match full_header.reexport(mut p):
        case Ok(consumed):
            return False
        case Err(problem):
            return problem.code == "E_EXPORT_REMOVED" and problem.start == 7 and problem.end == 11


public func test_diagnostic_repairs_preserve_arbitrary_source_bytes() -> bool fails syntax_value.Problem:
    const problem = syntax_value.Problem(code="E_FRONTEND_SYNTAX", start=0, end=3, message="rewrite value")
    const raw = b"\xc3\xa9\xff"
    const diagnostic = syntax_problem.repaired(problem, [syntax_problem.Edit(start=0, end=3, text=raw)])
    const pool = try syntax_diagnostics.report([diagnostic])
    const report = pool.values[field(pool, len(pool.values) - 1, "diagnostics")].children[0]
    const provenance = field(pool, report, "provenance")
    const fix = field(pool, provenance, "fix")
    const edit = field(pool, fix, "edit")
    return pool.values[field(pool, edit, "text")].data == raw
