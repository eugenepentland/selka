    const tokens: full_model.Token[] = [full_model.Token(kind="kw_def", start=0, end=4), full_model.Token(kind="ident", start=5, end=9), full_model.Token(kind="lparen", start=9, end=10), full_model.Token(kind="rparen", start=10, end=11), full_model.Token(kind="arrow", start=12, end=14), full_model.Token(kind="ident", start=15, end=18), full_model.Token(kind="indent", start=18, end=19), full_model.Token(kind="ident", start=24, end=29), full_model.Token(kind="lparen", start=29, end=30), full_model.Token(kind="ident", start=30, end=36), full_model.Token(kind="rparen", start=36, end=37), full_model.Token(kind="ident", start=42, end=48), full_model.Token(kind="equal", start=49, end=50), full_model.Token(kind="integer", start=51, end=52), full_model.Token(kind="kw_return", start=57, end=63), full_model.Token(kind="ident", start=64, end=70), full_model.Token(kind="dedent", start=71, end=71), full_model.Token(kind="eof", start=71, end=71)]
