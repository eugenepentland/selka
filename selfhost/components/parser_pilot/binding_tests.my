d="kw_return", start=149, end=155), full_model.Token(kind="kw_len", start=156, end=159), full_model.Token(kind="lparen", start=159, end=160), full_model.Token(kind="ident", start=160, end=165), full_model.Token(kind="rparen", start=165, end=166), full_model.Token(kind="dedent", start=167, end=167), full_model.Token(kind="eof", start=167, end=167)]
