func fixture_callback() -> full_parser.Outcome fails syntax_value.Problem:
    const tokens: full_model.Token[] = [full_model.Token(kind="kw_def", start=0, end=4), full_model.Token(kind="ident", start=5, end=9), full_model.Token(kind="lparen", start=9, end=10), full_model.Token(kind="ident", start=10, end=14), full_model.Token(kind="colon", start=14, end=15), full_model.Token(kind="kw_bool", start=16, end=20), full_model.Token(kind="rparen", start=20, end=21), full_model.Token(kind="arrow", start=22, end=24), full_model.Token(kind="ident", start=25, end=28), full_model.Token(kind="indent", start=28, end=29), full_model.Token(kind="kw_if", start=34, end=36), full_model.Token(kind="ident", start=37, end=41), full_model.Token(kind="indent", start=41, end=42), full_model.Token(kind="ident", start=51, end=57), full_model.Token(kind="equal", start=58, end=59), full_model.Token(kind="integer", start=60, end=61), full_model.Token(kind="dedent", start=66, end=66), full_model.Token(kind="kw_const", start=66, end=71), full_model.Token(kind="ident", start=72, end=80), full_model.Token(kind="equal", start=81, end=82), full_model.Token(kind="ident", start=83, end=89), full_model.Token(kind="ident", start=90, end=96), full_model.Token(kind="colon", start=96, end=97), full_model.Token(kind="ident", start=98, end=104), full_model.Token(kind="plus", start=105, end=106), full_model.Token(kind="integer", start=107, end=108), full_model.Token(kind="kw_return", start=113, end=119), full_model.Token(kind="ident", start=120, end=128), full_model.Token(kind="lparen", start=128, end=129), full_model.Token(kind="integer", start=129, end=130), full_model.Token(kind="rparen", start=130, end=131), full_model.Token(kind="dedent", start=132, end=132), full_model.Token(kind="eof", start=132, end=132)]
    return try full_parser.parse(tokens, b"func main(flag: bool) -> int:\n    if flag:\n        answer = 1\n    const callback = lambda answer: answer + 1\n    return callback(1)\n", False, False, b"binding_tests.my")


func fixture_destructured() -> full_parser.Outcome fails syntax_value.Problem:
    const tokens: full_model.Token[] = [full_model.Token(kind="kw_def", start=0, end=4), full_model.Token(kind="ident", start=5, end=9), full_model.Token(kind="lparen", start=9, end=10), full_model.Token(kind="rparen", start=10, end=11), full_model.Token(kind="arrow", start=12, end=14), full_model.Token(kind="ident", start=15, end=18), full_model.Token(kind="indent", start=18, end=19), full_model.Token(kind="ident", start=24, end=27), full_model.Token(kind="ident", start=28, end=32), full_model.Token(kind="comma", start=32, end=33), full_model.Token(kind="ident", start=34, end=39), full_model.Token(kind="equal", start=40, end=41), full_model.Token(kind="lparen", start=42, end=43), full_model.Token(kind="integer", start=43, end=44), full_model.Token(kind="comma", start=44, end=45), full_model.Token(kind="integer", start=46, end=47), full_model.Token(kind="rparen", start=47, end=48), full_model.Token(kind="ident", start=53, end=57), full_model.Token(kind="equal", start=58, end=59), full_model.Token(kind="integer", start=60, end=61), full_model.Token(kind="kw_return", start=66, end=72), full_model.Token(kind="ident", start=73, end=77), full_model.Token(kind="plus", start=78, end=79), full_model.Token(kind="ident", start=80, end=85), full_model.Token(kind="dedent", start=86, end=86), full_model.Token(kind="eof", start=86, end=86)]
    return try full_parser.parse(tokens, b"func main() -> int:\n    mut left, right = (1, 2)\n    left = 3\n    return left + right\n", False, False, b"binding_tests.my")


public func test_local_insertion_exact_bytes() -> bool fails syntax_value.Problem:
    const result = try fixture_safe()
    return len(result.problems) == 1 and result.problems[0].problem.code == "E_BINDING_DECLARATION" and len(result.problems[0].notes.edits) == 1 and result.problems[0].notes.edits[0].start == 24 and result.problems[0].notes.edits[0].end == 24 and result.problems[0].notes.edits[0].text == b"mut "


public func test_escape_has_no_automatic_edit() -> bool fails syntax_value.Problem:
    const result = try fixture_escape()
    return len(result.problems) == 1 and result.problems[0].problem.code == "E_BINDING_SCOPE_MIGRATION" and len(result.problems[0].notes.edits) == 0


public func test_read_before_initialization_is_escape() -> bool fails syntax_value.Problem:
    const result = try fixture_before()
    return len(result.problems) == 1 and result.problems[0].problem.code == "E_BINDING_SCOPE_MIGRATION"


public func test_sibling_bindings_have_distinct_scopes() -> bool fails syntax_value.Problem:
    const result = try fixture_siblings()
    return len(result.problems) == 2 and result.problems[0].problem.code == "E_BINDING_DECLARATION" and result.problems[1].problem.code == "E_BINDING_DECLARATION" and result.problems[0].notes.edits[0].start < result.problems[1].notes.edits[0].start


public func test_comprehension_binder_does_not_escape() -> bool fails syntax_value.Problem:
    const result = try fixture_comprehension()
    return len(result.problems) == 1 and result.problems[0].problem.code == "E_BINDING_DECLARATION"


public func test_callback_binder_does_not_escape() -> bool fails syntax_value.Problem:
    const result = try fixture_callback()
    return len(result.problems) == 1 and result.problems[0].problem.code == "E_BINDING_DECLARATION"


public func test_destructured_declarations_are_active() -> bool fails syntax_value.Problem:
    const result = try fixture_destructured()
    return len(result.problems) == 0
