import full_model
import full_parser
import syntax_value

func fixture_safe() -> full_parser.Outcome fails syntax_value.Problem:
    const tokens: full_model.Token[] = [full_model.Token(kind="kw_def", start=0, end=4), full_model.Token(kind="ident", start=5, end=9), full_model.Token(kind="lparen", start=9, end=10), full_model.Token(kind="rparen", start=10, end=11), full_model.Token(kind="arrow", start=12, end=14), full_model.Token(kind="ident", start=15, end=18), full_model.Token(kind="indent", start=18, end=19), full_model.Token(kind="ident", start=24, end=30), full_model.Token(kind="equal", start=31, end=32), full_model.Token(kind="integer", start=33, end=34), full_model.Token(kind="kw_return", start=39, end=45), full_model.Token(kind="ident", start=46, end=52), full_model.Token(kind="dedent", start=53, end=53), full_model.Token(kind="eof", start=53, end=53)]
    return try full_parser.parse(tokens, b"func main() -> int:\n    answer = 1\n    return answer\n", False, False, b"binding_tests.my")


func fixture_escape() -> full_parser.Outcome fails syntax_value.Problem:
    const tokens: full_model.Token[] = [full_model.Token(kind="kw_def", start=0, end=4), full_model.Token(kind="ident", start=5, end=9), full_model.Token(kind="lparen", start=9, end=10), full_model.Token(kind="ident", start=10, end=14), full_model.Token(kind="colon", start=14, end=15), full_model.Token(kind="kw_bool", start=16, end=20), full_model.Token(kind="rparen", start=20, end=21), full_model.Token(kind="arrow", start=22, end=24), full_model.Token(kind="ident", start=25, end=28), full_model.Token(kind="indent", start=28, end=29), full_model.Token(kind="kw_if", start=34, end=36), full_model.Token(kind="ident", start=37, end=41), full_model.Token(kind="indent", start=41, end=42), full_model.Token(kind="ident", start=51, end=57), full_model.Token(kind="equal", start=58, end=59), full_model.Token(kind="integer", start=60, end=61), full_model.Token(kind="dedent", start=66, end=66), full_model.Token(kind="kw_return", start=66, end=72), full_model.Token(kind="ident", start=73, end=79), full_model.Token(kind="dedent", start=80, end=80), full_model.Token(kind="eof", start=80, end=80)]
