import syntax_value
import syntax_problem

func ascii(value: str) -> bytes fails syntax_value.Problem:
    const alphabet = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    mut buffer = byte_buffer([])
    for ch in value:
        mut byte = -1
        if ch == "\n":
            byte = 10
        elif ch == "\r":
            byte = 13
        elif ch == "\t":
            byte = 9
        else:
            for i in range(len(alphabet)):
                if alphabet[i] == ch:
                    byte = i + 32
                    break
        if byte < 0:
            fail syntax_value.Problem(code="P_DIAGNOSTIC", start=0, end=0, message="diagnostic text requires an unqualified encoding operation")
        _ = buffer.append_byte(byte)
    return bytes(buffer)


func text(mut pool: syntax_value.Pool, value: str) -> int fails syntax_value.Problem:
    const data = try ascii(value)
    return try syntax_value.octets(mut pool, data)


func related(mut pool: syntax_value.Pool, notes: syntax_problem.Related[]) -> int fails syntax_value.Problem:
    if len(notes) == 0:
        return try syntax_value.absent(mut pool)
    if len(notes) != 1:
        fail syntax_value.Problem(code="P_DIAGNOSTIC", start=0, end=0, message="a diagnostic has at most one note per role")
    const note = notes[0]
    const span = try syntax_value.span(mut pool, note.start, note.end)
    const message = try text(mut pool, note.message)
    const role_text = try ascii(note.role)
    const role = try syntax_value.enumeration(mut pool, role_text)
    return try syntax_value.object(mut pool, ["span", "message", "role"], [span, message, role])


func edit(mut pool: syntax_value.Pool, value: syntax_problem.Edit) -> int fails syntax_value.Problem:
    const span = try syntax_value.span(mut pool, value.start, value.end)
    const replacement = try syntax_value.octets(mut pool, value.text)
    return try syntax_value.object(mut pool, ["span", "text"], [span, replacement])


func fix(mut pool: syntax_value.Pool, edits: syntax_problem.Edit[]) -> int fails syntax_value.Problem:
    if len(edits) == 0:
        return try syntax_value.absent(mut pool)
    const first = try edit(mut pool, edits[0])
    mut rest: int[] = []
    for value in edits[1:]:
        const encoded = try edit(mut pool, value)
        rest.append(encoded)
    const more = try syntax_value.sequence(mut pool, rest)
    return try syntax_value.object(mut pool, ["edit", "more"], [first, more])


func diagnostic(mut pool: syntax_value.Pool, value: syntax_problem.Diagnostic) -> int fails syntax_value.Problem:
    const code = try text(mut pool, value.problem.code)
    const severity_text = try ascii(value.severity)
    const severity = try syntax_value.enumeration(mut pool, severity_text)
    const span = try syntax_value.span(mut pool, value.problem.start, value.problem.end)
    const message = try text(mut pool, value.problem.message)
    const note = try related(mut pool, value.notes.related)
    const origin = try related(mut pool, value.notes.origin)
    const requirement = try related(mut pool, value.notes.requirement)
    const repair = try fix(mut pool, value.notes.edits)
    const provenance = try syntax_value.object(mut pool, ["origin", "requirement", "fix"], [origin, requirement, repair])
    return try syntax_value.object(mut pool, ["code", "severity", "span", "message", "related", "provenance"], [code, severity, span, message, note, provenance])


public func report(problems: syntax_problem.Diagnostic[]) -> syntax_value.Pool fails syntax_value.Problem:
    if len(problems) == 0 or len(problems) > 1024:
        fail syntax_value.Problem(code="P_DIAGNOSTIC", start=0, end=0, message="invalid diagnostic count")
    mut pool = syntax_value.empty()
    mut values: int[] = []
    for problem in problems:
        const value = try diagnostic(mut pool, problem)
        values.append(value)
    const items = try syntax_value.sequence(mut pool, values)
    _ = try syntax_value.object(mut pool, ["diagnostics"], [items])
    return pool
