import syntax_value

public func test_exact_value_fields_and_ids() -> bool fails syntax_value.Problem:
    mut pool = syntax_value.empty()
    const first = try syntax_value.integer(mut pool, 2)
    const last = try syntax_value.integer(mut pool, 8)
    const span = try syntax_value.object(mut pool, ["start", "end"], [first, last])
    const tag = try syntax_value.tagged(mut pool, b"integer", span)
    const node = try syntax_value.object(mut pool, ["span", "data"], [span, tag])
    return pool.values[node].names == ["span", "data"] and pool.values[tag].data == b"integer" and pool.values[node].children == [span, tag]


public func test_optional_and_binary_data() -> bool fails syntax_value.Problem:
    mut pool = syntax_value.empty()
    const missing = try syntax_value.absent(mut pool)
    const data = try syntax_value.octets(mut pool, b"\0\xff\xfe")
    const values = try syntax_value.sequence(mut pool, [missing, data])
    return pool.values[missing].kind == 0 and pool.values[data].data == b"\0\xff\xfe" and pool.values[values].children == [0, 1]


public func test_forward_index_rejected() -> bool:
    mut pool = syntax_value.empty()
    match syntax_value.sequence(mut pool, [0]):
        case Ok(value):
            return False
        case Err(message):
            return message.code == "P_SYNTAX_INDEX"


public func test_duplicate_fields_rejected() -> bool fails syntax_value.Problem:
    mut pool = syntax_value.empty()
    const value = try syntax_value.integer(mut pool, 0)
    match syntax_value.object(mut pool, ["start", "start"], [value, value]):
        case Ok(result):
            return False
        case Err(message):
            return message.code == "P_SYNTAX_FIELDS"
