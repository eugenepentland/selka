import codec
import checking
import syntax_value

func exchange(fs: Filesystem, path: str, framed: bool) -> bytes fails syntax_value.Problem:
    mut data = b""
    match fs.open(path, "rb"):
        case Ok(file):
            with file as input:
                data = input.read(67108865)
        case Err(message):
            fail syntax_value.Problem(code="P_IO", start=0, end=0, message=message)
    mut payload = data
    if framed:
        payload = try codec.request_payload(data)
    const request = try codec.decode(payload)
    const outcome = try checking.check(request.pool, request.root)
    const reply = try codec.encode(outcome)
    if framed:
        return try codec.framed_reply(data, reply)
    return reply


func main(args: str[], fs: Filesystem, out: Stream, err: Stream) -> int:
    if len(args) != 2 or (args[0] != "--exchange" and args[0] != "--request"):
        err.print("body-check: expected --exchange FILE or --request FILE")
        return 2
    match exchange(fs, args[1], args[0] == "--exchange"):
        case Ok(reply):
            _ = out.write(reply)
            return 0
        case Err(problem):
            err.print(problem.code, problem.message)
            return 2
