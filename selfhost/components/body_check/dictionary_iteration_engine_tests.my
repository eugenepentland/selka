import syntax_value
import graph
import engine
import collection_types
import list_types
import locals

func node(mut pool: syntax_value.Pool, span: int, tag: bytes, payload: int) -> int fails syntax_value.Problem:
    const data = try syntax_value.tagged(mut pool, tag, payload)
    return try syntax_value.object(mut pool, ["span", "data"], [span, data])


func fresh() -> engine.State fails syntax_value.Problem:
    mut pool = syntax_value.empty()
    const yes = try syntax_value.boolean(mut pool, True)
    const no = try syntax_value.boolean(mut pool, False)
    const first = try syntax_value.span(mut pool, 0, 4)
    const second = try syntax_value.span(mut pool, 4, 5)
    const third = try syntax_value.span(mut pool, 5, 10)
    const fourth = try syntax_value.span(mut pool, 10, 11)
    const span = try syntax_value.span(mut pool, 0, 11)
    const a = try node(mut pool, first, b"boolean", yes)
    const b = try node(mut pool, second, b"integer", second)
    const c = try node(mut pool, third, b"boolean", no)
    const d = try node(mut pool, fourth, b"integer", fourth)
    mut indices: int[] = []
    for index in range(4):
        const id = try syntax_value.integer(mut pool, index)
        indices.append(id)
    const entries = try syntax_value.sequence(mut pool, indices)
    const literal = try node(mut pool, span, b"dictionary_literal", entries)
    const nodes = try syntax_value.sequence(mut pool, [a, b, c, d, literal])
    const empty = try syntax_value.sequence(mut pool, [])
    const expressions = try syntax_value.object(mut pool, ["applications", "aliases", "suffixes"], [empty, empty, empty])
    const types = try syntax_value.object(mut pool, ["records", "domains", "resources", "variants", "constraints", "expressions"], [empty, empty, empty, empty, empty, expressions])
    const program = try syntax_value.object(mut pool, ["nodes", "statements", "functions", "types"], [nodes, empty, empty, types])
    mut state = try engine.make(pool, b"True7False8", program)
    state.batch.facts.lists.types.collections.bases = [0, 1, 2, 3, 4, 5]
    return state


func call(mut state: engine.State, method: bytes, arguments: int[], writable: bool) -> int fails syntax_value.Problem:
    const dictionary = try engine.expression(mut state, 4)
    state.syntax.source = b"d." + method
    const owner = try syntax_value.span(mut state.syntax.pool, 0, 1)
    const name = try syntax_value.span(mut state.syntax.pool, 2, len(state.syntax.source))
    const span = try syntax_value.span(mut state.syntax.pool, 0, len(state.syntax.source))
    const slot = try locals.add(mut state.scope, b"d", owner, dictionary.ty, writable, b"local")
    mut inputs: int[] = []
    for argument in arguments:
        const value = try syntax_value.integer(mut state.syntax.pool, argument)
        inputs.append(value)
    const values = try syntax_value.sequence(mut state.syntax.pool, inputs)
    const empty = try syntax_value.sequence(mut state.syntax.pool, [])
    const payload = try syntax_value.object(mut state.syntax.pool, ["name", "owner", "arguments", "argument_names", "type_arguments"], [name, owner, values, empty, empty])
    const raw = try node(mut state.syntax.pool, span, b"call", payload)
    state.syntax.nodes.append(raw)
    return slot


func walk(mut state: engine.State, iterable: int, name: int, second: int) -> engine.Statement fails syntax_value.Problem:
    const span = try syntax_value.span(mut state.syntax.pool, 0, len(state.syntax.source))
    const empty = try syntax_value.sequence(mut state.syntax.pool, [])
    const block_data = try syntax_value.tagged(mut state.syntax.pool, b"block", empty)
    const body = try syntax_value.object(mut state.syntax.pool, ["span", "data"], [span, block_data])
    state.syntax.statements.append(body)
    const body_id = try syntax_value.integer(mut state.syntax.pool, len(state.syntax.statements) - 1)
    const source_id = try syntax_value.integer(mut state.syntax.pool, iterable)
    const no = try syntax_value.boolean(mut state.syntax.pool, False)
    const absent = try syntax_value.absent(mut state.syntax.pool)
    const second_value = if second < 0 then absent else second
    const payload = try syntax_value.object(mut state.syntax.pool, ["name", "index_name", "enumerated", "iterable", "body"], [name, second_value, no, source_id, body_id])
    const data = try syntax_value.tagged(mut state.syntax.pool, b"for_each", payload)
    const statement = try syntax_value.object(mut state.syntax.pool, ["span", "data"], [span, data])
    state.syntax.statements.append(statement)
    return try engine.statement(mut state, len(state.syntax.statements) - 1)


public func test_dictionary_iteration_projects_keys_and_restores_visibility() -> bool fails syntax_value.Problem:
    mut state = try fresh()
    const key = try syntax_value.span(mut state.syntax.pool, 0, 4)
    const result = try walk(mut state, 4, key, -1)
    const row = try graph.field(state.batch.pool, state.batch.statements[result.id], "data")
    const data = try graph.get(state.batch.pool, row)
    return (not result.terminates) and (len(state.scope.active) == 0) and (len(state.scope.locals) == 4) and (state.scope.locals[3].ty == 1) and (state.scope.locals[3].origin == b"iteration") and (state.control.next == 1) and (data.data == b"block")


public func test_items_iteration_unpacks_key_and_value_with_one_item_recipe() -> bool fails syntax_value.Problem:
    mut state = try fresh()
    _ = try call(mut state, b"items", [], True)
    const iterable = len(state.syntax.nodes) - 1
    state.syntax.source = b"d.items kv"
    const key = try syntax_value.span(mut state.syntax.pool, 8, 9)
    const value = try syntax_value.span(mut state.syntax.pool, 9, 10)
    const result = try walk(mut state, iterable, value, key)
    return (not result.terminates) and (len(state.scope.active) == 1) and (len(state.scope.locals) == 7) and (state.scope.locals[4].ty == 1) and (state.scope.locals[5].ty == 0) and (state.scope.locals[4].name == b"k") and (state.scope.locals[5].name == b"v") and (len(state.batch.facts.lists.recipes) == 3) and (state.batch.facts.lists.recipes[2].kind == "dict_item")
