import syntax_value
import syntax_problem
import graph
import names
import suggestions
import record_qualified

public record Resolution:
    key: bytes
    from: int
    import_index: int


public record Request:
    span: int
    owner: int
    name: int


public func resolve(mut problems: syntax_problem.Diagnostic[], pool: syntax_value.Pool, source: bytes, modules: int[], request: Request) -> Resolution fails syntax_value.Problem:
    const call_span = request.span
    const owner = request.owner
    const name = request.name
    const raw_name = try graph.spelling(pool, source, name)
    const qualified = try record_qualified.parse(raw_name)
    const spelling = qualified.name
    const raw_alias = qualified.alias
    mut owner_value = syntax_value.Value(kind=0, integer=0, data=b"", children=[], names=[])
    if owner >= 0:
        owner_value = try graph.get(pool, owner)
    mut diagnostic_span = name
    if owner_value.kind != 0:
        diagnostic_span = owner
    const diagnostic_start_id = try graph.field(pool, diagnostic_span, "start")
    const diagnostic_end_id = try graph.field(pool, diagnostic_span, "end")
    const diagnostic_start = try graph.number(pool, diagnostic_start_id)
    const diagnostic_end = try graph.number(pool, diagnostic_end_id)
    if len(modules) == 0:
        if owner_value.kind != 0:
            const owner_text = try graph.spelling(pool, source, owner)
            return Resolution(key=owner_text + b"." + spelling, from=-1, import_index=-1)
        const original = try graph.spelling(pool, source, name)
        return Resolution(key=original, from=-1, import_index=-1)
    const start_id = try graph.field(pool, call_span, "start")
    const start = try graph.number(pool, start_id)
    const from = try names.module_at(pool, modules, start)
    if from < 0:
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="call has no source module")
    mut selected = from
    mut used_import = -1
    if owner_value.kind != 0 or len(raw_alias) != 0:
        mut qualifier = raw_alias
        if owner_value.kind != 0:
            qualifier = try graph.spelling(pool, source, owner)
        const imports_id = try graph.field(pool, modules[from], "imports")
        const imports = try graph.items(pool, imports_id)
        selected = -1
        mut import_index = 0
        for imported in imports:
            const alias_id = try graph.field(pool, imported, "alias")
            const alias = try graph.get(pool, alias_id)
            const import_name_id = try graph.field(pool, imported, "name")
            const import_name = try graph.get(pool, import_name_id)
            if alias.data == qualifier or import_name.data == qualifier:
                const target_id = try graph.field(pool, imported, "target")
                selected = try graph.number(pool, target_id)
                used_import = import_index
                break
            import_index = import_index + 1
        if selected < 0:
            fail syntax_value.Problem(code="E_UNKNOWN_IMPORT", start=diagnostic_start, end=diagnostic_end, message="name does not identify a direct import alias")
    if selected >= len(modules):
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid import target")
    const symbols_id = try graph.field(pool, modules[selected], "symbols")
    const symbols = try graph.items(pool, symbols_id)
    mut canonical_name = spelling
    mut matched = False
    for symbol in symbols:
        const symbol_name_id = try graph.field(pool, symbol, "name")
        const symbol_name = try graph.get(pool, symbol_name_id)
        if symbol_name.data != spelling:
            continue
        matched = True
        const exported_id = try graph.field(pool, symbol, "exported")
        const exported = try graph.get(pool, exported_id)
        if selected != from and exported.integer == 0:
            const from_context = try graph.field(pool, modules[from], "context")
            const from_name_id = try graph.field(pool, from_context, "name")
            const from_name = try graph.get(pool, from_name_id)
            const target_context = try graph.field(pool, modules[selected], "context")
            const target_name_id = try graph.field(pool, target_context, "name")
            const target_name = try graph.get(pool, target_name_id)
            const imported_id = try graph.field(pool, from_context, "is_imported")
            const imported = try graph.get(pool, imported_id)
            const tester = imported.integer == 0 and from_name.data == target_name.data + b"_test"
            if not tester:
                const rejection = syntax_value.Problem(code="E_PRIVATE_SYMBOL", start=diagnostic_start, end=diagnostic_end, message="declaration is private to its module")
                const declaration = try graph.field(pool, symbol, "span")
                const related_start_id = try graph.field(pool, declaration, "start")
                const related_end_id = try graph.field(pool, declaration, "end")
                const relative_start = try graph.number(pool, related_start_id)
                const relative_end = try graph.number(pool, related_end_id)
                const offset_id = try graph.field(pool, modules[selected], "offset")
                const offset = try graph.number(pool, offset_id)
                const related = syntax_problem.Related(start=offset + relative_start, end=offset + relative_end, message="declaration is here", role="related")
                problems.append(syntax_problem.Diagnostic(problem=rejection, severity="err", notes=syntax_problem.Notes(related=[related], origin=[], requirement=[], edits=[])))
                fail rejection
        const kind_id = try graph.field(pool, symbol, "kind")
        const kind = try graph.get(pool, kind_id)
        if kind.data != b"type":
            const rejection = syntax_value.Problem(code="E_SYMBOL_KIND", start=diagnostic_start, end=diagnostic_end, message="declaration has the wrong kind for this reference")
            const declaration = try graph.field(pool, symbol, "span")
            const related_start_id = try graph.field(pool, declaration, "start")
            const related_end_id = try graph.field(pool, declaration, "end")
            const relative_start = try graph.number(pool, related_start_id)
            const relative_end = try graph.number(pool, related_end_id)
            const offset_id = try graph.field(pool, modules[selected], "offset")
            const offset = try graph.number(pool, offset_id)
            const related = syntax_problem.Related(start=offset + relative_start, end=offset + relative_end, message="declaration is here", role="related")
            problems.append(syntax_problem.Diagnostic(problem=rejection, severity="err", notes=syntax_problem.Notes(related=[related], origin=[], requirement=[], edits=[])))
            fail rejection
        const reexport_id = try graph.field(pool, symbol, "re_export")
        const reexport = try graph.get(pool, reexport_id)
        if reexport.kind != 0:
            const module_id = try graph.field(pool, reexport_id, "module")
            const symbol_id = try graph.field(pool, reexport_id, "symbol")
            selected = try graph.number(pool, module_id)
            const position = try graph.number(pool, symbol_id)
            if selected < 0 or selected >= len(modules):
                fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid canonical module")
            const canonical_symbols_id = try graph.field(pool, modules[selected], "symbols")
            const canonical_symbols = try graph.items(pool, canonical_symbols_id)
            if position < 0 or position >= len(canonical_symbols):
                fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid canonical symbol")
            const canonical_name_id = try graph.field(pool, canonical_symbols[position], "name")
            const canonical = try graph.get(pool, canonical_name_id)
            canonical_name = canonical.data
        break
    if not matched:
        mut candidates: bytes[] = []
        for symbol in symbols:
            const kind_id = try graph.field(pool, symbol, "kind")
            const kind = try graph.get(pool, kind_id)
            const name_id = try graph.field(pool, symbol, "name")
            const candidate = try graph.get(pool, name_id)
            const exported_id = try graph.field(pool, symbol, "exported")
            const exported = try graph.get(pool, exported_id)
            if kind.data == b"type" and (selected == from or exported.integer != 0):
                candidates.append(candidate.data)
        const clause = try suggestions.clause(candidates, spelling)
        fail syntax_value.Problem(code="E_UNKNOWN_SYMBOL", start=diagnostic_start, end=diagnostic_end, message="declaration is not present in the resolved module" + clause)
    const context = try graph.field(pool, modules[selected], "context")
    const module_name_id = try graph.field(pool, context, "name")
    const module_name = try graph.get(pool, module_name_id)
    return Resolution(key=module_name.data + b"::" + canonical_name, from=from, import_index=used_import)


# Native symbolKind is a probe: missing names do not diagnose or mark imports.
public func is_type(pool: syntax_value.Pool, source: bytes, modules: int[], request: Request) -> bool fails syntax_value.Problem:
    const call_span = request.span
    const owner = request.owner
    const name = request.name
    const raw_name = try graph.spelling(pool, source, name)
    const qualified = try record_qualified.parse(raw_name)
    const spelling = qualified.name
    const raw_alias = qualified.alias
    mut owner_value = syntax_value.Value(kind=0, integer=0, data=b"", children=[], names=[])
    if owner >= 0:
        owner_value = try graph.get(pool, owner)
    mut diagnostic_span = name
    if owner_value.kind != 0:
        diagnostic_span = owner
    const diagnostic_start_id = try graph.field(pool, diagnostic_span, "start")
    const diagnostic_end_id = try graph.field(pool, diagnostic_span, "end")
    const diagnostic_start = try graph.number(pool, diagnostic_start_id)
    const diagnostic_end = try graph.number(pool, diagnostic_end_id)
    if len(modules) == 0:
        if owner_value.kind != 0:
            const owner_text = try graph.spelling(pool, source, owner)
            return False
        const original = try graph.spelling(pool, source, name)
        return False
    const start_id = try graph.field(pool, call_span, "start")
    const start = try graph.number(pool, start_id)
    const from = try names.module_at(pool, modules, start)
    if from < 0:
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="call has no source module")
    mut selected = from
    mut used_import = -1
    if owner_value.kind != 0 or len(raw_alias) != 0:
        mut qualifier = raw_alias
        if owner_value.kind != 0:
            qualifier = try graph.spelling(pool, source, owner)
        const imports_id = try graph.field(pool, modules[from], "imports")
        const imports = try graph.items(pool, imports_id)
        selected = -1
        mut import_index = 0
        for imported in imports:
            const alias_id = try graph.field(pool, imported, "alias")
            const alias = try graph.get(pool, alias_id)
            const import_name_id = try graph.field(pool, imported, "name")
            const import_name = try graph.get(pool, import_name_id)
            if alias.data == qualifier or import_name.data == qualifier:
                const target_id = try graph.field(pool, imported, "target")
                selected = try graph.number(pool, target_id)
                used_import = import_index
                break
            import_index = import_index + 1
        if selected < 0:
            return False
    if selected >= len(modules):
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid import target")
    const symbols_id = try graph.field(pool, modules[selected], "symbols")
    const symbols = try graph.items(pool, symbols_id)
    mut canonical_name = spelling
    mut matched = False
    for symbol in symbols:
        const symbol_name_id = try graph.field(pool, symbol, "name")
        const symbol_name = try graph.get(pool, symbol_name_id)
        if symbol_name.data != spelling:
            continue
        const kind_id = try graph.field(pool, symbol, "kind")
        const kind = try graph.get(pool, kind_id)
        return kind.data == b"type"
    return False
