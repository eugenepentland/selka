import syntax_value
import graph
import emission
import locals
import list_lower
import list_iteration

record Fixture:
    batch: emission.Batch
    scope: locals.Scope
    input: syntax_value.Pool
    request: list_iteration.Input
    nodes: int[]
    statements: int[]


func raw(mut input: syntax_value.Pool, span: int, tag: bytes, payload: int) -> int fails syntax_value.Problem:
    const data = try syntax_value.tagged(mut input, tag, payload)
    return try syntax_value.object(mut input, ["span", "data"], [span, data])


func fresh(kind: int) -> Fixture fails syntax_value.Problem:
    mut input = syntax_value.empty()
    const root_span = try syntax_value.span(mut input, 0, 2)
    const name_span = try syntax_value.span(mut input, 3, 7)
    const span = try syntax_value.span(mut input, 0, 7)
    const root = try raw(mut input, root_span, b"name", root_span)
    mut nodes = [root]
    const zero_id = try syntax_value.integer(mut input, 0)
    mut payload = try syntax_value.sequence(mut input, [])
    mut tag = b"block"
    if kind == 1:
        const argument = try raw(mut input, span, b"mut_argument", zero_id)
        nodes.append(argument)
        payload = try syntax_value.integer(mut input, 1)
        tag = b"discard"
    elif kind == 2:
        const operation = try syntax_value.enumeration(mut input, b"set")
        payload = try syntax_value.object(mut input, ["name", "value", "op"], [root_span, zero_id, operation])
        tag = b"assignment"
    const statement = try raw(mut input, span, tag, payload)
    mut scope = locals.empty()
    const slot = try locals.add(mut scope, b"xs", root_span, 40, True, b"local")
    scope.locals[slot].usage.reads = 1
    mut batch = emission.empty()
    const context = list_lower.Context(input=input, span=root_span)
    const source = try list_lower.read(mut batch, context, slot, 40)
    const request = list_iteration.Input(source=b"xs item", name=name_span, span=span, iterable=source, owner_type=40, element=0, loop_id=9)
    return Fixture(batch=batch, scope=scope, input=input, request=request, nodes=nodes, statements=[statement])


func lower(mut fixture: Fixture) -> list_lower.Lowered fails syntax_value.Problem:
    const plan = try list_iteration.prepare(mut fixture.batch, mut fixture.scope, fixture.input, fixture.request)
    const children = try emission.ids(mut fixture.batch, [])
    const body = try emission.statement(mut fixture.batch, fixture.input, fixture.request.span, False, b"block", children)
    const finish = list_iteration.Finish(raw_statements=fixture.statements, raw_nodes=fixture.nodes, body_raw=0, body=body)
    return try list_iteration.finish(mut fixture.batch, mut fixture.scope, fixture.input, plan, finish)


func slots(pool: syntax_value.Pool, lowered: list_lower.Lowered) -> int[] fails syntax_value.Problem:
    const children = try graph.items(pool, lowered.payload)
    mut result: int[] = []
    for child in children:
        const id = try graph.number(pool, child)
        result.append(id)
    return result


public func test_inert_list_walk_native_hidden_local_metadata_and_orphan_order() -> bool fails syntax_value.Problem:
    mut fixture = try fresh(0)
    const lowered = try lower(mut fixture)
    const parts = try slots(fixture.batch.pool, lowered)
    const binding = fixture.scope.locals[4]
    return lowered.tag == b"block" and parts == [1, 9, 10, 11] and len(fixture.batch.nodes) == 12 and len(fixture.batch.statements) == 12 and len(fixture.scope.locals) == 5 and fixture.scope.active == [0, 4] and binding.name == b"item" and not binding.mutable and binding.origin == b"iteration" and binding.initialized and binding.usage.temporary and binding.usage.reads == 1


public func test_live_mut_argument_refresh_growth_guard_and_root_read_count() -> bool fails syntax_value.Problem:
    mut fixture = try fresh(1)
    const lowered = try lower(mut fixture)
    const parts = try slots(fixture.batch.pool, lowered)
    return parts == [1, 12, 13, 14] and len(fixture.batch.nodes) == 17 and len(fixture.batch.statements) == 15 and fixture.scope.locals[0].usage.reads == 2 and len(fixture.scope.locals) == 5


public func test_root_reassignment_copies_entry_and_retains_original_bound() -> bool fails syntax_value.Problem:
    mut fixture = try fresh(2)
    const lowered = try lower(mut fixture)
    const parts = try slots(fixture.batch.pool, lowered)
    return parts == [3, 11, 12, 13] and len(fixture.batch.nodes) == 14 and len(fixture.batch.statements) == 14 and len(fixture.scope.locals) == 6 and fixture.scope.locals[0].usage.reads == 1 and fixture.scope.locals[5].usage.temporary


public func test_discard_iteration_name_does_not_bind_or_change_hidden_metadata() -> bool fails syntax_value.Problem:
    mut fixture = try fresh(0)
    fixture.request.source = b"xs _   "
    const name = try syntax_value.span(mut fixture.input, 3, 4)
    fixture.request.name = name
    const plan = try list_iteration.prepare(mut fixture.batch, mut fixture.scope, fixture.input, fixture.request)
    const binding = fixture.scope.locals[plan.binding]
    return plan.before_active == [0] and fixture.scope.active == [0] and binding.name == b"<collection>" and binding.mutable and binding.origin == b"local" and not binding.initialized and binding.usage.temporary


public func test_nested_list_place_refreshes_ancestor_and_spills_index_once() -> bool fails syntax_value.Problem:
    mut fixture = try fresh(1)
    fixture.scope.locals[0].ty = 41
    const context = list_lower.Context(input=fixture.input, span=fixture.request.span)
    const parent = try list_lower.read(mut fixture.batch, context, 0, 41)
    const index = try list_lower.integer(mut fixture.batch, context, -1, 0)
    const child = try list_lower.access(mut fixture.batch, mut fixture.scope, context, list_lower.Access(base=parent, owner_type=41, kind=b"read", arguments=[index], result_type=40, signed_length=False))
    const iterable = try list_lower.append(mut fixture.batch, context, child)
    fixture.request.iterable = iterable
    const lowered = try lower(mut fixture)
    mut checks = 0
    for node in fixture.batch.nodes:
        const data_id = try graph.field(fixture.batch.pool, node, "data")
        const data = try graph.get(fixture.batch.pool, data_id)
        if data.data == b"buffer_operation":
            const kind_id = try graph.field(fixture.batch.pool, data.children[0], "kind")
            const kind = try graph.get(fixture.batch.pool, kind_id)
            if kind.data == b"iteration_check":
                checks = checks + 1
    return lowered.tag == b"block" and checks == 2 and fixture.scope.locals[0].usage.reads == 2 and len(fixture.scope.locals) == 9


public func test_readonly_copy_method_does_not_add_live_refresh() -> bool fails syntax_value.Problem:
    mut fixture = try fresh(0)
    fixture.request.source = b"xs item copy"
    const method_name = try syntax_value.span(mut fixture.input, 8, 12)
    const base = try syntax_value.integer(mut fixture.input, 0)
    const arguments = try syntax_value.sequence(mut fixture.input, [])
    const payload = try syntax_value.object(mut fixture.input, ["base", "name", "arguments"], [base, method_name, arguments])
    const call = try raw(mut fixture.input, fixture.request.span, b"method_call", payload)
    fixture.nodes.append(call)
    const node = try syntax_value.integer(mut fixture.input, 1)
    const statement = try raw(mut fixture.input, fixture.request.span, b"discard", node)
    fixture.statements = [statement]
    const lowered = try lower(mut fixture)
    const parts = try slots(fixture.batch.pool, lowered)
    return parts == [1, 9, 10, 11] and fixture.scope.locals[0].usage.reads == 1


public func test_index_assignment_below_root_selects_live_growth_guard() -> bool fails syntax_value.Problem:
    mut fixture = try fresh(0)
    const item = try raw(mut fixture.input, fixture.request.name, b"name", fixture.request.name)
    fixture.nodes.append(item)
    const base = try syntax_value.integer(mut fixture.input, 0)
    const index = try syntax_value.integer(mut fixture.input, 1)
    const place = try syntax_value.object(mut fixture.input, ["base", "index"], [base, index])
    const indexed = try raw(mut fixture.input, fixture.request.span, b"index", place)
    fixture.nodes.append(indexed)
    const target = try syntax_value.integer(mut fixture.input, 2)
    const operation = try syntax_value.enumeration(mut fixture.input, b"set")
    const payload = try syntax_value.object(mut fixture.input, ["target", "value", "op"], [target, index, operation])
    const assign = try raw(mut fixture.input, fixture.request.span, b"index_assignment", payload)
    fixture.nodes.append(assign)
    const assigned = try syntax_value.integer(mut fixture.input, 3)
    const statement = try raw(mut fixture.input, fixture.request.span, b"discard", assigned)
    fixture.statements = [statement]
    const lowered = try lower(mut fixture)
    const parts = try slots(fixture.batch.pool, lowered)
    return parts == [1, 12, 13, 14] and fixture.scope.locals[0].usage.reads == 2


public func test_guard_discard_encodes_node_reference_in_pool() -> bool fails syntax_value.Problem:
    for kind in [0, 1, 2]:
        mut fixture = try fresh(kind)
        _ = try lower(mut fixture)
        mut guards = 0
        for statement in fixture.batch.statements:
            const data_id = try graph.field(fixture.batch.pool, statement, "data")
            const data = try graph.get(fixture.batch.pool, data_id)
            if data.data == b"discard":
                const node = try graph.number(fixture.batch.pool, data.children[0])
                if node < 0 or node >= len(fixture.batch.nodes):
                    return False
                const node_data_id = try graph.field(fixture.batch.pool, fixture.batch.nodes[node], "data")
                const node_data = try graph.get(fixture.batch.pool, node_data_id)
                if node_data.data != b"buffer_operation":
                    return False
                const operation_id = try graph.field(fixture.batch.pool, node_data.children[0], "kind")
                const operation = try graph.get(fixture.batch.pool, operation_id)
                if operation.data != b"iteration_check":
                    return False
                guards = guards + 1
        if guards != 1:
            return False
    return True
