import syntax_value
import graph
import record_types
import variants
import recipe_index
import buffer_types

public record Schema:
    id: int
    element: int


public record Recipe:
    id: int
    element: int
    span: int
    kind: str = "list"
    failure: int = -1
    depth: int = 2


public record TypeTables:
    suffixes: int[]
    records: record_types.Catalog
    variants: variants.Catalog
    buffer: buffer_types.Basis


public record Catalog:
    base_count: int
    available: bool
    known: Schema[]
    recipes: Recipe[]
    types: TypeTables
    by_element: int[]
    elements: int[]


public func empty() -> Catalog:
    return Catalog(base_count=0, available=False, known=[], recipes=[], types=TypeTables(suffixes=[], records=record_types.empty(), variants=variants.empty(), buffer=buffer_types.empty()), by_element=[], elements=[])


func bad() -> syntax_value.Problem:
    return syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid list catalog")


public func prepare(pool: syntax_value.Pool, id: int, suffixes: int[], managed: int[]) -> Catalog fails syntax_value.Problem:
    return try prepare_records(pool, id, suffixes, managed, record_types.empty())


public func prepare_records(pool: syntax_value.Pool, id: int, suffixes: int[], managed: int[], records: record_types.Catalog) -> Catalog fails syntax_value.Problem:
    const count_id = try graph.field(pool, id, "base_count")
    const count = try graph.number(pool, count_id)
    const available_id = try graph.field(pool, id, "list_available")
    const available = try graph.get(pool, available_id)
    if count < 0 or count > 65536 or available.kind != 2:
        fail bad()
    mut catalog = empty()
    catalog.base_count = count
    catalog.available = available.integer != 0
    catalog.types.suffixes = suffixes
    catalog.types.records = records
    const prepared_buffer = try buffer_types.prepare(pool, id)
    catalog.types.buffer = prepared_buffer
    for unused in range(19 + count):
        catalog.by_element.append(-1)
        catalog.elements.append(-1)
    const list_id = try graph.field(pool, id, "lists")
    const values = try graph.items(pool, list_id)
    mut previous = 18
    for value in values:
        const schema_id = try graph.field(pool, value, "id")
        const element_id = try graph.field(pool, value, "element")
        const schema = try graph.number(pool, schema_id)
        const element = try graph.number(pool, element_id)
        if schema <= previous or schema >= 19 + count or element < 0 or element >= 19 + count or catalog.by_element[element] >= 0:
            fail bad()
        catalog.known.append(Schema(id=schema, element=element))
        catalog.by_element[element] = schema
        catalog.elements[schema] = element
        previous = schema
    mut depths: int[] = []
    for unused in catalog.elements:
        depths.append(0)
    depths[0] = 1
    depths[1] = 1
    depths[15] = 1
    for leaf in managed:
        if leaf >= 0:
            if leaf < 19 or leaf >= len(depths):
                fail bad()
            depths[leaf] = 1
    for ty in range(19, len(records.admitted)):
        if records.admitted[ty]:
            depths[ty] = 1
    if catalog.types.buffer.id >= 0:
        depths[catalog.types.buffer.id] = 1
    for schema in catalog.known:
        if depths[schema.id] == 1:
            fail bad()
        mut current = schema.id
        mut path: int[] = []
        while depths[current] == 0:
            if len(path) >= 256 or catalog.elements[current] < 0:
                fail bad()
            for prior in path:
                if prior == current:
                    fail bad()
            path.append(current)
            current = catalog.elements[current]
        mut depth = depths[current]
        mut position = len(path)
        while position > 0:
            position = position - 1
            depth = depth + 1
            if depth > 256:
                fail bad()
            depths[path[position]] = depth
    return catalog


public func element_type(catalog: Catalog, id: int) -> int:
    if id < 0 or id >= len(catalog.elements):
        return -1
    return catalog.elements[id]


public func lookup(catalog: Catalog, element: int) -> int:
    if element < 0 or element >= len(catalog.by_element):
        return -1
    return catalog.by_element[element]


func refusal(pool: syntax_value.Pool, span: int, message: str) -> syntax_value.Problem fails syntax_value.Problem:
    const start_id = try graph.field(pool, span, "start")
    const end_id = try graph.field(pool, span, "end")
    const start = try graph.number(pool, start_id)
    const end = try graph.number(pool, end_id)
    return syntax_value.Problem(code="P_BODY_PROFILE", start=start, end=end, message=message)


func recipe_depth(catalog: Catalog, element: int) -> int fails syntax_value.Problem:
    const ordinal = element - 19 - catalog.base_count
    if ordinal < 0:
        return 1
    if ordinal >= len(catalog.recipes):
        fail bad()
    return catalog.recipes[ordinal].depth


public func intern(mut catalog: Catalog, pool: syntax_value.Pool, request: Recipe, managed: int[]) -> int fails syntax_value.Problem:
    if not catalog.available:
        const problem = try refusal(pool, request.span, "builtin List is unavailable")
        fail problem
    mut current = request.element
    mut depth = 2
    mut slow = current
    mut steps = 0
    while current >= 19:
        mut leaf = current == catalog.types.buffer.id
        for id in managed:
            if current == id:
                leaf = True
        if current < len(catalog.types.records.admitted) and catalog.types.records.admitted[current]:
            leaf = True
        if leaf:
            break
        current = element_type(catalog, current)
        steps = steps + 1
        if steps % 2 == 0:
            slow = element_type(catalog, slow)
        if current >= 19 and current == slow:
            fail bad()
        if current < 0:
            const problem = try refusal(pool, request.span, "list element type is outside the admitted body profile")
            fail problem
        depth = depth + 1
        if depth > 256:
            const problem = try refusal(pool, request.span, "list type depth limit exceeded")
            fail problem
    if current != 0 and current != 1 and current != 15 and current < 19:
        const problem = try refusal(pool, request.span, "list element type is outside the admitted body profile")
        fail problem
    const existing = lookup(catalog, request.element)
    if existing >= 0:
        return existing
    if catalog.base_count + len(catalog.recipes) >= 65536:
        const problem = try refusal(pool, request.span, "list schema limit exceeded")
        fail problem
    const id = 19 + catalog.base_count + len(catalog.recipes)
    if request.element < 0 or request.element >= id:
        fail bad()
    const parent_depth = try recipe_depth(catalog, request.element)
    const admitted_depth = parent_depth + 1
    if admitted_depth > 256:
        const rejection = try refusal(pool, request.span, "catalog recipe depth limit exceeded")
        fail rejection
    catalog.recipes.append(Recipe(id=id, element=request.element, span=request.span, depth=admitted_depth))
    catalog.by_element[request.element] = id
    catalog.by_element.append(-1)
    catalog.elements.append(request.element)
    return id


public func encode(mut pool: syntax_value.Pool, input: syntax_value.Pool, recipes: Recipe[]) -> int fails syntax_value.Problem:
    mut values: int[] = []
    for recipe in recipes:
        const id = try syntax_value.integer(mut pool, recipe.id)
        const element = try syntax_value.integer(mut pool, recipe.element)
        const span = try graph.clone(mut pool, input, recipe.span, 0)
        mut value = -1
        if recipe.kind == "result":
            const failure = try syntax_value.integer(mut pool, recipe.failure)
            value = try syntax_value.object(mut pool, ["id", "success", "failure", "span"], [id, element, failure, span])
        elif recipe.kind == "byte_buffer":
            value = try syntax_value.object(mut pool, ["id", "span"], [id, span])
        elif recipe.kind == "list" or recipe.kind == "option":
            value = try syntax_value.object(mut pool, ["id", "element", "span"], [id, element, span])
        else:
            fail bad()
        mut tag = b"list"
        if recipe.kind == "result":
            tag = b"result"
        elif recipe.kind == "option":
            tag = b"option"
        elif recipe.kind == "byte_buffer":
            tag = b"byte_buffer"
        const tagged = try syntax_value.tagged(mut pool, tag, value)
        values.append(tagged)
    return try syntax_value.sequence(mut pool, values)


public func seed_variants(mut catalog: Catalog, pool: syntax_value.Pool) -> bool fails syntax_value.Problem:
    for position in range(len(catalog.types.records.rows)):
        const row = catalog.types.records.rows[position]
        const ty = 19 + position
        const name_id = try graph.field(pool, row, "name")
        const name = try graph.get(pool, name_id)
        if catalog.types.variants.result.id >= 0 and len(name.data) >= 7 and name.data[:7] == b"Result<":
            const shape = try variants.result_shape(pool, catalog.types.records.rows, ty)
            if shape.valid:
                _ = try recipe_index.insert(mut catalog.types.variants.index, recipe_index.Key(kind=1, first=shape.success, second=shape.failure, id=ty))
        if catalog.types.variants.option.id >= 0 and len(name.data) >= 7 and name.data[:7] == b"Option<":
            const shape = try variants.option_shape(pool, catalog.types.records.rows, ty)
            if shape.valid:
                _ = try recipe_index.insert(mut catalog.types.variants.index, recipe_index.Key(kind=2, first=shape.element, second=-1, id=ty))
    return True


public func union_intern(mut catalog: Catalog, mut pool: syntax_value.Pool, first: int, second: int, span: int, result: bool) -> int fails syntax_value.Problem:
    mut kind = 2
    mut tag = "option"
    mut template = catalog.types.variants.option
    if result:
        kind = 1
        tag = "result"
        template = catalog.types.variants.result
    if template.id < 0:
        const rejection = try refusal(pool, span, "builtin variant template is unavailable")
        fail rejection
    const existing = recipe_index.lookup(catalog.types.variants.index, kind, first, second)
    if existing >= 0:
        return existing
    const id = 19 + catalog.base_count + len(catalog.recipes)
    if id >= 65555:
        const rejection = try refusal(pool, span, "variant schema limit exceeded")
        fail rejection
    if first < 0 or first >= id or (result and (second < 0 or second >= id)):
        fail bad()
    mut admitted_depth = try recipe_depth(catalog, first)
    if result:
        const failure_depth = try recipe_depth(catalog, second)
        if failure_depth > admitted_depth:
            admitted_depth = failure_depth
    admitted_depth = admitted_depth + 1
    if admitted_depth > 256:
        const rejection = try refusal(pool, span, "catalog recipe depth limit exceeded")
        fail rejection
    while len(catalog.types.records.rows) < id - 19:
        const missing = 19 + len(catalog.types.records.rows)
        const ordinal = missing - 19 - catalog.base_count
        if ordinal < 0 or ordinal >= len(catalog.recipes) or (catalog.recipes[ordinal].kind != "list" and catalog.recipes[ordinal].kind != "byte_buffer"):
            fail bad()
        const recipe = catalog.recipes[ordinal]
        mut semantic = -1
        if recipe.kind == "byte_buffer":
            semantic = try variants.buffer_semantic(mut pool, missing, recipe.span)
        else:
            semantic = try variants.list_semantic(mut pool, catalog.types.records.rows, missing, recipe.element, recipe.span)
        catalog.types.records.rows.append(semantic)
    if len(catalog.types.records.rows) != id - 19:
        fail bad()
    const row = try variants.materialize(mut pool, catalog.types.records.rows, template, id, first, second, result)
    catalog.types.records.rows.append(row)
    while len(catalog.types.records.by_type) < id:
        catalog.types.records.by_type.append(-1)
        catalog.types.records.admitted.append(False)
    catalog.types.records.by_type.append(-2)
    catalog.types.records.admitted.append(True)
    catalog.recipes.append(Recipe(id=id, element=first, span=span, kind=tag, failure=second, depth=admitted_depth))
    catalog.by_element.append(-1)
    catalog.elements.append(-1)
    _ = try recipe_index.insert(mut catalog.types.variants.index, recipe_index.Key(kind=kind, first=first, second=second, id=id))
    return id


public func buffer_intern(mut catalog: Catalog, mut pool: syntax_value.Pool, span: int) -> int fails syntax_value.Problem:
    if catalog.types.buffer.id >= 0:
        return catalog.types.buffer.id
    if not catalog.types.buffer.available:
        const rejection = try refusal(pool, span, "builtin byte_buffer is unavailable")
        fail rejection
    const id = 19 + catalog.base_count + len(catalog.recipes)
    if id >= 65555:
        const rejection = try refusal(pool, span, "byte buffer schema limit exceeded")
        fail rejection
    while len(catalog.types.records.rows) < id - 19:
        const missing = 19 + len(catalog.types.records.rows)
        const ordinal = missing - 19 - catalog.base_count
        if ordinal < 0 or ordinal >= len(catalog.recipes) or catalog.recipes[ordinal].kind != "list":
            fail bad()
        const recipe = catalog.recipes[ordinal]
        const semantic = try variants.list_semantic(mut pool, catalog.types.records.rows, missing, recipe.element, recipe.span)
        catalog.types.records.rows.append(semantic)
    const row = try variants.buffer_semantic(mut pool, id, span)
    catalog.types.records.rows.append(row)
    catalog.types.buffer.id = id
    catalog.recipes.append(Recipe(id=id, element=5, span=span, kind="byte_buffer", depth=1))
    catalog.by_element.append(-1)
    catalog.elements.append(-1)
    return id
