import syntax_value
import graph
import engine
import collection_types
import list_types
import locals

func node(mut pool: syntax_value.Pool, span: int, tag: bytes, payload: int) -> int fails syntax_value.Problem:
    const data = try syntax_value.tagged(mut pool, tag, payload)
    return try syntax_value.object(mut pool, ["span", "data"], [span, data])


func fresh() -> engine.State fails syntax_value.Problem:
    mut pool = syntax_value.empty()
    const yes = try syntax_value.boolean(mut pool, True)
    const no = try syntax_value.boolean(mut pool, False)
    const first = try syntax_value.span(mut pool, 0, 4)
    const second = try syntax_value.span(mut pool, 4, 5)
    const third = try syntax_value.span(mut pool, 5, 10)
    const fourth = try syntax_value.span(mut pool, 10, 11)
    const span = try syntax_value.span(mut pool, 0, 11)
    const a = try node(mut pool, first, b"boolean", yes)
    const b = try node(mut pool, second, b"integer", second)
    const c = try node(mut pool, third, b"boolean", no)
    const d = try node(mut pool, fourth, b"integer", fourth)
    mut indices: int[] = []
    for index in range(4):
        const id = try syntax_value.integer(mut pool, index)
        indices.append(id)
    const entries = try syntax_value.sequence(mut pool, indices)
    const literal = try node(mut pool, span, b"dictionary_literal", entries)
    const nodes = try syntax_value.sequence(mut pool, [a, b, c, d, literal])
    const empty = try syntax_value.sequence(mut pool, [])
    const expressions = try syntax_value.object(mut pool, ["applications", "aliases", "suffixes"], [empty, empty, empty])
    const types = try syntax_value.object(mut pool, ["records", "domains", "resources", "variants", "constraints", "expressions"], [empty, empty, empty, empty, empty, expressions])
    const program = try syntax_value.object(mut pool, ["nodes", "statements", "functions", "types"], [nodes, empty, empty, types])
    mut state = try engine.make(pool, b"True7False8", program)
    state.batch.facts.lists.types.collections.bases = [0, 1, 2, 3, 4, 5]
    return state


func call(mut state: engine.State, method: bytes, arguments: int[], writable: bool) -> int fails syntax_value.Problem:
    const dictionary = try engine.expression(mut state, 4)
    state.syntax.source = b"d." + method
    const owner = try syntax_value.span(mut state.syntax.pool, 0, 1)
    const name = try syntax_value.span(mut state.syntax.pool, 2, len(state.syntax.source))
    const span = try syntax_value.span(mut state.syntax.pool, 0, len(state.syntax.source))
    const slot = try locals.add(mut state.scope, b"d", owner, dictionary.ty, writable, b"local")
    mut inputs: int[] = []
    for argument in arguments:
        const value = try syntax_value.integer(mut state.syntax.pool, argument)
        inputs.append(value)
    const values = try syntax_value.sequence(mut state.syntax.pool, inputs)
    const empty = try syntax_value.sequence(mut state.syntax.pool, [])
    const payload = try syntax_value.object(mut state.syntax.pool, ["name", "owner", "arguments", "argument_names", "type_arguments"], [name, owner, values, empty, empty])
    const raw = try node(mut state.syntax.pool, span, b"call", payload)
    state.syntax.nodes.append(raw)
    return slot


public func test_dictionary_get_emits_direct_slot_operation_and_exact_usage() -> bool fails syntax_value.Problem:
    mut state = try fresh()
    const slot = try call(mut state, b"get", [0, 1], False)
    const result = try engine.expression(mut state, 5)
    const data_id = try graph.field(state.batch.pool, state.batch.nodes[result.id], "data")
    const data = try graph.get(state.batch.pool, data_id)
    const payload = try graph.payload(state.batch.pool, data_id)
    const owner_id = try graph.field(state.batch.pool, payload, "owner")
    const owner = try graph.number(state.batch.pool, owner_id)
    const kind_id = try graph.field(state.batch.pool, payload, "kind")
    const kind = try graph.get(state.batch.pool, kind_id)
    return result.id == 5 and result.ty == 0 and data.data == b"buffer_operation" and kind.data == b"get" and owner == slot and len(state.scope.locals) == 1 and state.scope.locals[slot].usage.reads == 1 and state.scope.locals[slot].usage.writes == 0


public func test_dictionary_items_interns_view_after_mapping_and_retains_receiver_read() -> bool fails syntax_value.Problem:
    mut state = try fresh()
    const slot = try call(mut state, b"items", [], False)
    const result = try engine.expression(mut state, 5)
    const data_id = try graph.field(state.batch.pool, state.batch.nodes[result.id], "data")
    const data = try graph.get(state.batch.pool, data_id)
    return result.ty == 20 and result.id == 7 and data.data == b"block_value" and len(state.batch.facts.lists.recipes) == 2 and state.batch.facts.lists.recipes[1].kind == "dict_items" and state.scope.locals[slot].usage.reads == 1 and len(state.scope.locals) == 1


public func test_dictionary_clear_readonly_diagnostic_uses_owner_site() -> bool fails syntax_value.Problem:
    mut state = try fresh()
    _ = try call(mut state, b"clear", [], False)
    match engine.expression(mut state, 5):
        case Ok(unused):
            return False
        case Err(error):
            return error.code == "E_IMMUTABLE" and error.start == 0 and error.end == 1 and error.message == "collection update requires a writable binding"


public func test_dictionary_get_arity_precedes_unresolved_operand() -> bool fails syntax_value.Problem:
    mut state = try fresh()
    _ = try call(mut state, b"get", [999], False)
    match engine.expression(mut state, 5):
        case Ok(unused):
            return False
        case Err(error):
            return error.code == "E_ARITY" and error.start == 0 and error.end == 5 and len(state.problems) == 1 and len(state.problems[0].notes.related) == 1


public func test_dictionary_and_set_bindings_use_managed_copy_authority() -> bool fails syntax_value.Problem:
    mut state = try fresh()
    const dictionary = try engine.expression(mut state, 4)
    const span = try graph.field(state.syntax.pool, state.syntax.nodes[4], "span")
    const set = try list_types.collection_intern(mut state.batch.facts.lists, mut state.syntax.pool, collection_types.Schema(id=-1, kind=1, key=1, value=15, owner=-1), span)
    const item = try list_types.collection_intern(mut state.batch.facts.lists, mut state.syntax.pool, collection_types.Schema(id=-1, kind=2, key=1, value=0, owner=-1), span)
    return engine.managed(state, dictionary.ty) and engine.managed(state, set) and not engine.managed(state, item)
