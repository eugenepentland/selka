import syntax_value
import graph
import record_index
import record_name_index
import names
import suggestions
import variants

public record Bindings:
    table: record_name_index.Index
    types: int[]
    aliases: int[]
    display: str[]
    record_count: int = 0


public record Catalog:
    rows: int[]
    declarations: int[]
    index: record_index.Index
    by_type: int[]
    admitted: bool[]
    ids: int[]
    bindings: Bindings


public func empty() -> Catalog:
    return Catalog(rows=[], declarations=[], index=record_index.empty(), by_type=[], admitted=[], ids=[], bindings=Bindings(table=record_name_index.Index(names=[], order=[], comparisons=0, octets=0, writes=0), types=[], aliases=[], display=[]))


func refusal(pool: syntax_value.Pool, span: int, message: str) -> syntax_value.Problem fails syntax_value.Problem:
    const start_id = try graph.field(pool, span, "start")
    const end_id = try graph.field(pool, span, "end")
    const start = try graph.number(pool, start_id)
    const end = try graph.number(pool, end_id)
    return syntax_value.Problem(code="P_BODY_PROFILE", start=start, end=end, message=message)


func flag(pool: syntax_value.Pool, row: int, name: str) -> bool fails syntax_value.Problem:
    const value_id = try graph.field(pool, row, name)
    const value = try graph.get(pool, value_id)
    if value.kind != 2:
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid record catalog flag")
    return value.integer != 0


public func prepare(pool: syntax_value.Pool, rows: int[], declarations: int[]) -> Catalog fails syntax_value.Problem:
    if len(rows) > 65536 or len(declarations) > 65536:
        fail syntax_value.Problem(code="P_BODY_LIMIT", start=0, end=0, message="record catalog limit exceeded")
    mut spans: int[] = []
    for declaration in declarations:
        const span = try graph.field(pool, declaration, "name")
        const parameters_id = try graph.field(pool, declaration, "type_parameters")
        const parameters = try graph.items(pool, parameters_id)
        const managed = try flag(pool, declaration, "managed")
        if len(parameters) != 0 or managed:
            const problem = try refusal(pool, span, "generic or managed record is outside the body profile")
            fail problem
        spans.append(span)
    const index = try record_index.make(pool, spans)
    mut catalog = Catalog(rows=rows, declarations=declarations, index=index, by_type=[], admitted=[], ids=[], bindings=Bindings(table=record_name_index.Index(names=[], order=[], comparisons=0, octets=0, writes=0), types=[], aliases=[], display=[]))
    for unused in declarations:
        catalog.ids.append(-1)
    for unused in range(19):
        catalog.by_type.append(-1)
        catalog.admitted.append(False)
    for position in range(len(rows)):
        const row = rows[position]
        const id_id = try graph.field(pool, row, "id")
        const id = try graph.number(pool, id_id)
        if id != 19 + position:
            fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="record catalog IDs are not dense")
        const span = try graph.field(pool, row, "declaration")
        const declaration = try record_index.lookup(index, pool, span)
        catalog.by_type.append(declaration)
        if declaration >= 0:
            catalog.ids[declaration] = id
        catalog.admitted.append(declaration >= 0)
        if declaration < 0:
            continue
        const managed = try flag(pool, row, "managed")
        if managed:
            const problem = try refusal(pool, span, "reference-identity record is outside the body profile")
            fail problem
        const shape = try graph.field(pool, row, "shape")
        for name in ["array", "domain", "variants", "buffer", "resource"]:
            const value_id = try graph.field(pool, shape, name)
            const value = try graph.get(pool, value_id)
            if value.kind != 0:
                const problem = try refusal(pool, span, "specialized record representation is outside the body profile")
                fail problem
        const builtin_id = try graph.field(pool, shape, "builtin")
        const builtin = try graph.get(pool, builtin_id)
        const tuple = try flag(pool, shape, "tuple")
        if builtin.data != b"none" or tuple:
            const problem = try refusal(pool, span, "specialized record representation is outside the body profile")
            fail problem
        const contract = try graph.field(pool, row, "contract")
        for name in ["move_only"]:
            const refused = try flag(pool, contract, name)
            if refused:
                const problem = try refusal(pool, span, "owned or result-bearing record is outside the body profile")
                fail problem
        const callback_id = try graph.field(pool, contract, "callback")
        const callback = try graph.get(pool, callback_id)
        const storable = try flag(pool, contract, "storable")
        const pending = try flag(pool, contract, "requires_handling")
        if callback.kind != 0 or (not storable and not pending):
            const problem = try refusal(pool, span, "record storage contract is outside the body profile")
            fail problem
        const fields_id = try graph.field(pool, row, "fields")
        const fields = try graph.items(pool, fields_id)
        for field in fields:
            const boxed = try flag(pool, field, "boxed")
            if boxed:
                const problem = try refusal(pool, span, "boxed record field is outside the body profile")
                fail problem
    # Every raw ordinary declaration must have one retained nominal schema.
    mut seen: bool[] = []
    for unused in declarations:
        seen.append(False)
    for declaration in catalog.by_type:
        if declaration >= 0:
            if seen[declaration]:
                fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="duplicate retained nominal declaration")
            seen[declaration] = True
    for present in seen:
        if not present:
            fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="missing retained nominal declaration")
    catalog.bindings.record_count = len(declarations)
    return catalog


public func type_for(catalog: Catalog, pool: syntax_value.Pool, span: int) -> int fails syntax_value.Problem:
    const declaration = try record_index.lookup(catalog.index, pool, span)
    if declaration < 0:
        return -1
    return catalog.ids[declaration]


public func schema(catalog: Catalog, ty: int) -> int:
    if ty < 19 or ty >= len(catalog.by_type) or not catalog.admitted[ty]:
        return -1
    if catalog.by_type[ty] == -2 or catalog.by_type[ty] >= catalog.bindings.record_count:
        return -1
    return catalog.rows[ty - 19]


# Greatest fixed point: value records may recur through managed lists.
# Reverse edges propagate an unsupported leaf once, without recursive scans.
public func closure(mut catalog: Catalog, pool: syntax_value.Pool, elements: int[], managed: int[]) -> bool fails syntax_value.Problem:
    const count = len(catalog.by_type)
    if len(elements) != count:
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="record and list catalog counts differ")
    mut allowed: bool[] = []
    mut parents: int[][] = []
    for ty in range(count):
        allowed.append(catalog.admitted[ty] or elements[ty] >= 0 or ty == 0 or ty == 1 or ty == 15 or (ty >= 2 and ty <= 8))
        parents.append([])
    for ty in managed:
        if ty >= 0:
            if ty >= count:
                fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="managed catalog type exceeds retained prefix")
            allowed[ty] = True
    mut edges = 0
    for ty in range(19, count):
        mut children: int[] = []
        if elements[ty] >= 0:
            children.append(elements[ty])
        if catalog.admitted[ty]:
            const members = try children_of(pool, catalog.rows, ty)
            for child in members:
                children.append(child)
        for child in children:
            if child < 0 or child >= count:
                fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="record field type exceeds retained prefix")
            if edges >= 4194304:
                fail syntax_value.Problem(code="P_BODY_LIMIT", start=0, end=0, message="record type edge limit exceeded")
            parents[child].append(ty)
            edges = edges + 1
    # Managed storage cuts layout edges. Only direct value-record edges must be acyclic.
    mut remaining: int[] = []
    mut layout_parents: int[][] = []
    for unused in range(count):
        remaining.append(0)
        layout_parents.append([])
    for ty in range(19, count):
        if catalog.admitted[ty]:
            const managed_owner = try flag(pool, catalog.rows[ty - 19], "managed")
            if managed_owner:
                continue
            const members = try children_of(pool, catalog.rows, ty)
            for child in members:
                const managed_child = try try_managed(pool, catalog.rows, child)
                if catalog.admitted[child] and not managed_child:
                    remaining[ty] = remaining[ty] + 1
                    layout_parents[child].append(ty)
    mut ready: int[] = []
    mut nominal_count = 0
    for ty in range(19, count):
        if catalog.admitted[ty]:
            nominal_count = nominal_count + 1
            if remaining[ty] == 0:
                ready.append(ty)
    mut layout_cursor = 0
    while layout_cursor < len(ready):
        const ty = ready[layout_cursor]
        layout_cursor = layout_cursor + 1
        for parent in layout_parents[ty]:
            remaining[parent] = remaining[parent] - 1
            if remaining[parent] == 0:
                ready.append(parent)
    if len(ready) != nominal_count:
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="cyclic value-record layout")
    mut queue: int[] = []
    for ty in range(count):
        if not allowed[ty]:
            queue.append(ty)
    mut cursor = 0
    while cursor < len(queue):
        const rejected = queue[cursor]
        cursor = cursor + 1
        for parent in parents[rejected]:
            if allowed[parent]:
                allowed[parent] = False
                queue.append(parent)
    for ty in range(19, count):
        if catalog.admitted[ty] and not allowed[ty]:
            const span = try graph.field(pool, catalog.rows[ty - 19], "declaration")
            const problem = try refusal(pool, span, "record field type is outside the admitted body closure")
            fail problem
    return True


public func bind_names(mut catalog: Catalog, pool: syntax_value.Pool, source: bytes, modules: int[], aliases: int[]) -> bool fails syntax_value.Problem:
    mut keys: bytes[] = []
    mut types: int[] = []
    mut total = 0
    mut display: str[] = []
    for position in range(len(catalog.declarations) + len(aliases)):
        mut declaration = 0
        mut ty = 0
        if position < len(catalog.declarations):
            declaration = catalog.declarations[position]
            ty = catalog.ids[position]
        else:
            const alias = position - len(catalog.declarations)
            declaration = aliases[alias]
            ty = -2 - alias
        const span = try graph.field(pool, declaration, "name")
        const text = try graph.spelling(pool, source, span)
        mut length = len(text)
        if len(modules) != 0:
            const start_id = try graph.field(pool, span, "start")
            const start = try graph.number(pool, start_id)
            const module = try names.module_at(pool, modules, start)
            if module < 0:
                fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="nominal declaration has no source module")
            const context = try graph.field(pool, modules[module], "context")
            const name_id = try graph.field(pool, context, "name")
            const name = try graph.get(pool, name_id)
            length = length + len(name.data) + 2
        if length > 67108864 - total:
            fail syntax_value.Problem(code="P_BODY_LIMIT", start=0, end=0, message="nominal index key bytes exceed body wire profile")
        total = total + length
        const key = try names.qualified(pool, source, modules, span)
        keys.append(key)
        types.append(ty)
        if ty >= 19:
            const name_id = try graph.field(pool, catalog.rows[ty - 19], "name")
            const name = try graph.get(pool, name_id)
            mut buffer = byte_buffer([])
            mut cursor = 0
            while cursor < len(name.data):
                if name.data[cursor] == 58 and cursor + 1 < len(name.data) and name.data[cursor + 1] == 58:
                    _ = buffer.append_byte(46)
                    cursor = cursor + 2
                else:
                    _ = buffer.append_byte(name.data[cursor])
                    cursor = cursor + 1
            const surface = try suggestions.text(bytes(buffer))
            display.append(surface)
    match record_name_index.make(keys):
        case Ok(table):
            catalog.bindings = Bindings(table=table, types=types, aliases=aliases, display=display, record_count=catalog.bindings.record_count)
        case Err(problem):
            fail syntax_value.Problem(code="P_BODY_LIMIT", start=0, end=0, message=problem.message)
    return True


public func named(catalog: Catalog, key: bytes) -> int fails syntax_value.Problem:
    match record_name_index.lookup(catalog.bindings.table, key):
        case Ok(found):
            if found.id < 0:
                return -1
            return catalog.bindings.types[found.id]
        case Err(problem):
            fail syntax_value.Problem(code="P_BODY_LIMIT", start=0, end=0, message=problem.message)


public func equality(pool: syntax_value.Pool, catalog: Catalog, elements: int[], ty: int, managed: int[], visited: int[]) -> bool fails syntax_value.Problem:
    if ty == 0 or ty == 1:
        return True
    if ty < 19:
        return False
    for prior in visited:
        if prior == ty:
            return True
    if len(visited) >= 64:
        return False
    for sequence in managed:
        if sequence >= 0 and ty == sequence:
            return True
    mut path = visited
    path.append(ty)
    if ty < len(elements) and elements[ty] >= 0:
        return try equality(pool, catalog, elements, elements[ty], managed, path)
    if ty >= len(catalog.admitted) or not catalog.admitted[ty]:
        return False
    const row = catalog.rows[ty - 19]
    const collection = try graph.field(pool, row, "collection")
    const kind_id = try graph.field(pool, collection, "kind")
    const kind = try graph.get(pool, kind_id)
    if kind.data == b"dictionary":
        const set_id = try graph.field(pool, collection, "set")
        const set = try graph.get(pool, set_id)
        if set.integer != 0:
            const key_id = try graph.field(pool, collection, "key")
            const key = try graph.number(pool, key_id)
            return try equality(pool, catalog, elements, key, managed, path)
    const children = try children_of(pool, catalog.rows, ty)
    for child in children:
        const supported = try equality(pool, catalog, elements, child, managed, path)
        if not supported:
            return False
    return True


# Lists cut layout recursion; ordinary variant payloads retain value edges.
public func children_of(pool: syntax_value.Pool, rows: int[], ty: int) -> int[] fails syntax_value.Problem:
    mut children: int[] = []
    const fields_id = try graph.field(pool, rows[ty - 19], "fields")
    const fields = try graph.items(pool, fields_id)
    for field in fields:
        const child_id = try graph.field(pool, field, "ty")
        const child = try graph.number(pool, child_id)
        children.append(child)
    const collection_id = try graph.field(pool, rows[ty - 19], "collection")
    const kind_id = try graph.field(pool, collection_id, "kind")
    const kind = try graph.get(pool, kind_id)
    if kind.data == b"dictionary":
        const key_id = try graph.field(pool, collection_id, "key")
        const key = try graph.number(pool, key_id)
        const shape_id = try graph.field(pool, rows[ty - 19], "shape")
        const buffer_id = try graph.field(pool, shape_id, "buffer")
        const element = try graph.number(pool, buffer_id)
        children.append(key)
        children.append(element)
    const value = try variants.shape(pool, rows, ty)
    for member in value.cases:
        if member.boxed:
            const rejection = try refusal(pool, member.declaration, "boxed variant payload is outside the body profile")
            fail rejection
        if member.payload >= 0:
            children.append(member.payload)
    return children


public func extend_variants(mut catalog: Catalog, pool: syntax_value.Pool, declarations: int[], template_spans: int[]) -> bool fails syntax_value.Problem:
    mut spans: int[] = []
    for declaration in catalog.declarations:
        const span = try graph.field(pool, declaration, "name")
        spans.append(span)
    const template_index = try record_index.make(pool, template_spans)
    mut added = 0
    for declaration in declarations:
        const span = try graph.field(pool, declaration, "name")
        const parameters_id = try graph.field(pool, declaration, "type_parameters")
        const parameters = try graph.items(pool, parameters_id)
        const template = try record_index.lookup(template_index, pool, span)
        if template >= 0:
            continue
        if len(parameters) != 0:
            const rejection = try refusal(pool, span, "generic variant is outside the body profile")
            fail rejection
        if len(catalog.declarations) >= 65536:
            fail syntax_value.Problem(code="P_BODY_LIMIT", start=0, end=0, message="nominal declaration count exceeded")
        catalog.declarations.append(declaration)
        catalog.ids.append(-1)
        spans.append(span)
        added = added + 1
    const combined_index = try record_index.make(pool, spans)
    catalog.index = combined_index
    for position in range(len(catalog.rows)):
        const ty = 19 + position
        const value = try variants.shape(pool, catalog.rows, ty)
        if not value.valid:
            continue
        const span = try graph.field(pool, catalog.rows[position], "declaration")
        const declaration = try record_index.lookup(catalog.index, pool, span)
        const template = try record_index.lookup(template_index, pool, span)
        if declaration < 0 and template < 0:
            continue
        if declaration >= 0:
            if declaration < catalog.bindings.record_count or catalog.ids[declaration] >= 0:
                fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="duplicate retained variant declaration")
            catalog.ids[declaration] = ty
            catalog.by_type[ty] = declaration
        if declaration < 0:
            catalog.by_type[ty] = -2
        catalog.admitted[ty] = True
        for member in value.cases:
            if member.boxed:
                const rejection = try refusal(pool, member.declaration, "boxed variant payload is outside the body profile")
                fail rejection
            if member.fielded:
                if member.payload < 19 or member.payload >= len(catalog.by_type):
                    fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid fielded variant payload schema")
                catalog.admitted[member.payload] = True
                const fields_id = try graph.field(pool, catalog.rows[member.payload - 19], "fields")
                const fields = try graph.items(pool, fields_id)
                for field in fields:
                    const boxed = try flag(pool, field, "boxed")
                    if boxed:
                        const rejection = try refusal(pool, member.declaration, "boxed variant field is outside the body profile")
                        fail rejection
    for position in range(catalog.bindings.record_count, len(catalog.declarations)):
        if catalog.ids[position] < 0:
            fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="missing retained variant declaration")
    return added >= 0


func try_managed(pool: syntax_value.Pool, rows: int[], ty: int) -> bool fails syntax_value.Problem:
    if ty < 19:
        return False
    return try flag(pool, rows[ty - 19], "managed")
