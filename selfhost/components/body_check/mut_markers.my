import syntax_value
import syntax_problem
import graph
import locals
import suggestions
import list_places
import mutation_places

public record Request:
    call_name: int
    arguments: int[]
    mut_positions: int[]


func problem(pool: syntax_value.Pool, location: int, code: str, message: str) -> syntax_value.Problem fails syntax_value.Problem:
    const begin = try graph.field(pool, location, "start")
    const finish = try graph.field(pool, location, "end")
    const start = try graph.number(pool, begin)
    const end = try graph.number(pool, finish)
    return syntax_value.Problem(code=code, start=start, end=end, message=message)


func marked(pool: syntax_value.Pool, nodes: int[], argument: int) -> bool fails syntax_value.Problem:
    const data = try graph.field(pool, nodes[argument], "data")
    const value = try graph.get(pool, data)
    return value.data == b"mut_argument"


func target(pool: syntax_value.Pool, nodes: int[], argument: int) -> int fails syntax_value.Problem:
    const data = try graph.field(pool, nodes[argument], "data")
    const payload = try graph.payload(pool, data)
    return try graph.number(pool, payload)


func span(pool: syntax_value.Pool, nodes: int[], argument: int) -> int fails syntax_value.Problem:
    return try graph.field(pool, nodes[argument], "span")


func call_text(pool: syntax_value.Pool, source: bytes, nodes: int[], arguments: int[], position: int, remove: bool) -> str fails syntax_value.Problem:
    mut text = "("
    for index in range(len(arguments)):
        if index > 0:
            text = text + ", "
        mut argument = arguments[index]
        if index == position:
            if remove:
                argument = try target(pool, nodes, argument)
            else:
                text = text + "mut "
        const location = try span(pool, nodes, argument)
        const raw = try graph.spelling(pool, source, location)
        const spelling = try suggestions.text(raw)
        text = text + spelling
    return text + ")"


public func check(pool: syntax_value.Pool, source: bytes, nodes: int[], mut scope: locals.Scope, request: Request) -> syntax_problem.Diagnostic[] fails syntax_value.Problem:
    const context = mutation_places.Context(pool=pool, source=source, nodes=nodes, typed_pool=syntax_value.empty(), typed_nodes=[], resolved=[])
    return try check_places(context, mut scope, request)


public func check_places(context: mutation_places.Context, mut scope: locals.Scope, request: Request) -> syntax_problem.Diagnostic[] fails syntax_value.Problem:
    const pool = context.pool
    const source = context.source
    const nodes = context.nodes
    mut result: syntax_problem.Diagnostic[] = []
    mut markers: int[] = []
    const raw_callee = try graph.spelling(pool, source, request.call_name)
    const callee = try suggestions.text(raw_callee)
    for position in range(len(request.arguments)):
        const argument = request.arguments[position]
        mut declared = False
        for writable in request.mut_positions:
            if writable == position:
                declared = True
        const has_marker = try marked(pool, nodes, argument)
        const location = try span(pool, nodes, argument)
        if declared != has_marker:
            mut operand = argument
            if has_marker:
                operand = try target(pool, nodes, argument)
            const operand_span = try span(pool, nodes, operand)
            const raw = try graph.spelling(pool, source, operand_span)
            const operand_text = try suggestions.text(raw)
            const replacement = try call_text(pool, source, nodes, request.arguments, position, has_marker)
            mut message = "`" + callee + "` writes `" + operand_text + "`; write `" + replacement + "`"
            if has_marker:
                message = "`" + callee + "` does not write `" + operand_text + "`; remove `mut`: `" + replacement + "`"
            const rejection = try problem(pool, location, "E_MUTATION_MARKER", message)
            mut edit_end = rejection.start
            mut edit_text = b"mut "
            if has_marker:
                const begin = try graph.field(pool, operand_span, "start")
                edit_end = try graph.number(pool, begin)
                edit_text = b""
            result.append(syntax_problem.repaired(rejection, [syntax_problem.Edit(start=rejection.start, end=edit_end, text=edit_text)]))
            continue
        if not has_marker:
            continue
        const operand = try target(pool, nodes, argument)
        const data = try graph.field(pool, nodes[operand], "data")
        const value = try graph.get(pool, data)
        if value.data != b"name" and value.data != b"field" and value.data != b"index":
            fail try problem(pool, location, "E_MUTATION_MARKER", "`mut` requires an assignable argument (a variable, field or list slot); assign it to a local first")
        _ = try list_places.writable(pool, source, nodes, mut scope, operand)
        markers.append(argument)
    if len(result) > 0:
        return result
    return try mutation_places.check(context, request.call_name, markers)
