public func test_proper_superset_preserves_operand_initializers_and_running_short_circuit() -> bool fails syntax_value.Problem:
    mut fixture = try fresh()
    const left = try empty_node(mut fixture)
    const right = try empty_node(mut fixture)
    const result = try set_lower.relation(mut fixture.batch, mut fixture.scope, fixture.context, set_lower.Binary(ty=40, element=0, left=left, right=right, kind=b"proper_superset", loop_id=31))
    const body_id = try number(fixture.batch.pool, result.value.payload, "body")
    const block_data = try graph.field(fixture.batch.pool, fixture.batch.statements[body_id], "data")
    const block = try graph.payload(fixture.batch.pool, block_data)
    const statements = try graph.items(fixture.batch.pool, block)
    const first_id = try graph.number(fixture.batch.pool, statements[0])
    const second_id = try graph.number(fixture.batch.pool, statements[1])
    const first_data = try graph.field(fixture.batch.pool, fixture.batch.statements[first_id], "data")
    const first = try graph.payload(fixture.batch.pool, first_data)
    const second_data = try graph.field(fixture.batch.pool, fixture.batch.statements[second_id], "data")
    const second = try graph.payload(fixture.batch.pool, second_data)
    const extracted_10 = try number(fixture.batch.pool, first, "value")
    const extracted_11 = try number(fixture.batch.pool, second, "value")
    const extracted_12 = try tag(fixture.batch.pool, fixture.batch.nodes[len(fixture.batch.nodes) - 1])
    return result.next_loop == 32 and result.value.ty == 1 and len(statements) == 6 and extracted_10 == left and extracted_11 == right and len(fixture.scope.locals) == 6 and extracted_12 == b"binary"


