public func test_disjoint_starts_true_and_guards_walk_with_running_flag() -> bool fails syntax_value.Problem:
    mut fixture = try fresh()
    const left = try empty_node(mut fixture)
    const right = try empty_node(mut fixture)
    const result = try set_lower.relation(mut fixture.batch, mut fixture.scope, fixture.context, set_lower.Binary(ty=40, element=0, left=left, right=right, kind=b"disjoint", loop_id=50))
    const initial_data = try graph.field(fixture.batch.pool, fixture.batch.nodes[2], "data")
    const initial_id = try graph.payload(fixture.batch.pool, initial_data)
    const initial = try graph.get(fixture.batch.pool, initial_id)
    const body_id = try number(fixture.batch.pool, result.value.payload, "body")
    const body_data = try graph.field(fixture.batch.pool, fixture.batch.statements[body_id], "data")
    const body = try graph.payload(fixture.batch.pool, body_data)
    const rows = try graph.items(fixture.batch.pool, body)
    const loop_id = try graph.number(fixture.batch.pool, rows[5])
    const loop_data = try graph.field(fixture.batch.pool, fixture.batch.statements[loop_id], "data")
    const loop = try graph.payload(fixture.batch.pool, loop_data)
    const condition_id = try number(fixture.batch.pool, loop, "condition")
    const condition_data = try graph.field(fixture.batch.pool, fixture.batch.nodes[condition_id], "data")
    const condition = try graph.payload(fixture.batch.pool, condition_data)
    const op_id = try graph.field(fixture.batch.pool, condition, "op")
    const op = try graph.get(fixture.batch.pool, op_id)
    return result.next_loop == 51 and initial.kind == 2 and initial.integer == 1 and op.data == b"logical_and" and len(rows) == 6
