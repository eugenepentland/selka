import syntax_value
import graph
import engine
import collection_types
import list_types
import locals

func node(mut pool: syntax_value.Pool, span: int, tag: bytes, payload: int) -> int fails syntax_value.Problem:
    const data = try syntax_value.tagged(mut pool, tag, payload)
    return try syntax_value.object(mut pool, ["span", "data"], [span, data])


func fresh() -> engine.State fails syntax_value.Problem:
    mut pool = syntax_value.empty()
    const yes = try syntax_value.boolean(mut pool, True)
    const no = try syntax_value.boolean(mut pool, False)
    const first = try syntax_value.span(mut pool, 0, 4)
    const second = try syntax_value.span(mut pool, 4, 5)
    const third = try syntax_value.span(mut pool, 5, 10)
    const fourth = try syntax_value.span(mut pool, 10, 11)
    const span = try syntax_value.span(mut pool, 0, 11)
    const a = try node(mut pool, first, b"boolean", yes)
    const b = try node(mut pool, second, b"integer", second)
    const c = try node(mut pool, third, b"boolean", no)
    const d = try node(mut pool, fourth, b"integer", fourth)
    mut indices: int[] = []
    for index in range(4):
        const id = try syntax_value.integer(mut pool, index)
        indices.append(id)
    const entries = try syntax_value.sequence(mut pool, indices)
    const literal = try node(mut pool, span, b"dictionary_literal", entries)
    const nodes = try syntax_value.sequence(mut pool, [a, b, c, d, literal])
    const empty = try syntax_value.sequence(mut pool, [])
    const expressions = try syntax_value.object(mut pool, ["applications", "aliases", "suffixes"], [empty, empty, empty])
    const types = try syntax_value.object(mut pool, ["records", "domains", "resources", "variants", "constraints", "expressions"], [empty, empty, empty, empty, empty, expressions])
    const program = try syntax_value.object(mut pool, ["nodes", "statements", "functions", "types"], [nodes, empty, empty, types])
    mut state = try engine.make(pool, b"True7False8", program)
    state.batch.facts.lists.types.collections.bases = [0, 1, 2, 3, 4, 5]
    return state


public func test_inferred_dictionary_preserves_flat_source_order_and_first_recipe() -> bool fails syntax_value.Problem:
    mut state = try fresh()
    const result = try engine.expression(mut state, 4)
    const data_id = try graph.field(state.batch.pool, state.batch.nodes[result.id], "data")
    const data = try graph.get(state.batch.pool, data_id)
    const array = try graph.payload(state.batch.pool, data_id)
    const values = try graph.items(state.batch.pool, array)
    mut actual: int[] = []
    for value in values:
        const id = try graph.number(state.batch.pool, value)
        actual.append(id)
    return result.ty == 19 and result.id == 4 and data.data == b"array" and actual == [0, 1, 2, 3] and len(state.batch.facts.lists.recipes) == 1 and state.batch.facts.lists.recipes[0].kind == "dict" and state.batch.facts.lists.recipes[0].element == 1 and state.batch.facts.lists.recipes[0].failure == 0


public func test_contextual_dictionary_literals_adopt_u8_without_extra_casts() -> bool fails syntax_value.Problem:
    mut state = try fresh()
    const span = try graph.field(state.syntax.pool, state.syntax.nodes[4], "span")
    const ty = try list_types.collection_intern(mut state.batch.facts.lists, mut state.syntax.pool, collection_types.Schema(id=-1, kind=0, key=1, value=5, owner=-1), span)
    const result = try engine.expression_expected(mut state, 4, ty)
    const left_ty = try graph.field(state.batch.pool, state.batch.nodes[1], "ty")
    const right_ty = try graph.field(state.batch.pool, state.batch.nodes[3], "ty")
    const left = try graph.number(state.batch.pool, left_ty)
    const right = try graph.number(state.batch.pool, right_ty)
    return result.ty == ty and left == 5 and right == 5 and len(state.batch.nodes) == 5 and len(state.batch.facts.lists.recipes) == 1


public func test_empty_dictionary_requires_context_and_reports_full_literal_span() -> bool fails syntax_value.Problem:
    mut state = try fresh()
    const span = try graph.field(state.syntax.pool, state.syntax.nodes[4], "span")
    const empty = try syntax_value.sequence(mut state.syntax.pool, [])
    const literal = try node(mut state.syntax.pool, span, b"dictionary_literal", empty)
    state.syntax.nodes[4] = literal
    match engine.expression(mut state, 4):
        case Ok(unused):
            return False
        case Err(error):
            return error.code == "E_DICT_INFERENCE" and error.start == 0 and error.end == 11 and len(state.batch.nodes) == 0


public func test_contextual_u8_range_error_uses_literal_site_before_dictionary_finalization() -> bool fails syntax_value.Problem:
    mut state = try fresh()
    state.syntax.source = b"True7False999"
    const value_span = try syntax_value.span(mut state.syntax.pool, 10, 13)
    const literal = try node(mut state.syntax.pool, value_span, b"integer", value_span)
    state.syntax.nodes[3] = literal
    const span = try graph.field(state.syntax.pool, state.syntax.nodes[4], "span")
    const ty = try list_types.collection_intern(mut state.batch.facts.lists, mut state.syntax.pool, collection_types.Schema(id=-1, kind=0, key=1, value=5, owner=-1), span)
    match engine.expression_expected(mut state, 4, ty):
        case Ok(unused):
            return False
        case Err(error):
            return error.code == "E_INTEGER_RANGE" and error.start == 10 and error.end == 13 and len(state.batch.nodes) == 3


public func test_dictionary_index_preserves_direct_typed_index_without_hidden_receiver() -> bool fails syntax_value.Problem:
    mut state = try fresh()
    const span = try graph.field(state.syntax.pool, state.syntax.nodes[4], "span")
    const base = try syntax_value.integer(mut state.syntax.pool, 4)
    const key = try syntax_value.integer(mut state.syntax.pool, 0)
    const access = try syntax_value.object(mut state.syntax.pool, ["base", "index"], [base, key])
    const raw = try node(mut state.syntax.pool, span, b"index", access)
    state.syntax.nodes.append(raw)
    state.batch.resolved.append(-1)
    state.batch.facts.expected.append(-1)
    const result = try engine.expression(mut state, 5)
    const data_id = try graph.field(state.batch.pool, state.batch.nodes[result.id], "data")
    const data = try graph.get(state.batch.pool, data_id)
    const payload = try graph.payload(state.batch.pool, data_id)
    const base_id = try graph.field(state.batch.pool, payload, "base")
    const index_id = try graph.field(state.batch.pool, payload, "index")
    const actual_base = try graph.number(state.batch.pool, base_id)
    const actual_index = try graph.number(state.batch.pool, index_id)
    return result.ty == 0 and result.id == 5 and data.data == b"index" and actual_base == 4 and actual_index == 0 and len(state.scope.locals) == 0 and len(state.batch.statements) == 0


public func test_dictionary_length_keeps_single_length_node_without_collection_temporaries() -> bool fails syntax_value.Problem:
    mut state = try fresh()
    const span = try graph.field(state.syntax.pool, state.syntax.nodes[4], "span")
    const input = try syntax_value.integer(mut state.syntax.pool, 4)
    const raw = try node(mut state.syntax.pool, span, b"length", input)
    state.syntax.nodes.append(raw)
    const result = try engine.expression(mut state, 5)
    const data_id = try graph.field(state.batch.pool, state.batch.nodes[result.id], "data")
    const data = try graph.get(state.batch.pool, data_id)
    const payload = try graph.payload(state.batch.pool, data_id)
    const actual = try graph.number(state.batch.pool, payload)
    return result.ty == 0 and result.id == 5 and data.data == b"length" and actual == 4 and len(state.scope.locals) == 0 and len(state.batch.statements) == 0


public func test_plain_dictionary_write_preserves_key_and_snapshots_value_before_owner() -> bool fails syntax_value.Problem:
    mut state = try fresh()
    const dictionary = try engine.expression(mut state, 4)
    const span = try graph.field(state.syntax.pool, state.syntax.nodes[4], "span")
    const name = try syntax_value.span(mut state.syntax.pool, 0, 4)
    _ = try locals.add(mut state.scope, b"True", name, dictionary.ty, True, b"local")
    const base = try node(mut state.syntax.pool, name, b"name", name)
    state.syntax.nodes.append(base)
    const base_id = try syntax_value.integer(mut state.syntax.pool, 5)
    const key = try syntax_value.integer(mut state.syntax.pool, 0)
    const value = try syntax_value.integer(mut state.syntax.pool, 1)
    const arguments = try syntax_value.sequence(mut state.syntax.pool, [key, value])
    const kind = try syntax_value.enumeration(mut state.syntax.pool, b"write")
    const payload = try syntax_value.object(mut state.syntax.pool, ["base", "kind", "arguments"], [base_id, kind, arguments])
    const write = try node(mut state.syntax.pool, span, b"list_operation", payload)
    state.syntax.nodes.append(write)
    const result = try engine.expression(mut state, 6)
    const block_id = try graph.field(state.batch.pool, state.batch.nodes[result.id], "data")
    const block = try graph.payload(state.batch.pool, block_id)
    const operation_id = try graph.field(state.batch.pool, block, "value")
    const operation = try graph.number(state.batch.pool, operation_id)
    const operation_data = try graph.field(state.batch.pool, state.batch.nodes[operation], "data")
    const access = try graph.payload(state.batch.pool, operation_data)
    const inputs_id = try graph.field(state.batch.pool, access, "arguments")
    const inputs = try graph.items(state.batch.pool, inputs_id)
    const actual_key = try graph.number(state.batch.pool, inputs[0])
    return result.ty == 15 and actual_key == 0 and state.scope.locals[0].usage.writes == 1 and state.scope.locals[0].usage.reads == 1 and len(state.scope.locals) == 3


func membership(mut state: engine.State, needle: int, negate: bool) -> int fails syntax_value.Problem:
    const span = try graph.field(state.syntax.pool, state.syntax.nodes[4], "span")
    const needle_id = try syntax_value.integer(mut state.syntax.pool, needle)
    const container = try syntax_value.integer(mut state.syntax.pool, 4)
    const inverse = try syntax_value.boolean(mut state.syntax.pool, negate)
    const payload = try syntax_value.object(mut state.syntax.pool, ["needle", "container", "negate"], [needle_id, container, inverse])
    const raw = try node(mut state.syntax.pool, span, b"membership", payload)
    const index = len(state.syntax.nodes)
    state.syntax.nodes.append(raw)
    return index


public func test_dictionary_membership_dispatch_roots_written_operands_once() -> bool fails syntax_value.Problem:
    mut state = try fresh()
    const raw = try membership(mut state, 0, False)
    const result = try engine.expression(mut state, raw)
    const data_id = try graph.field(state.batch.pool, state.batch.nodes[result.id], "data")
    const data = try graph.get(state.batch.pool, data_id)
    return result.ty == 1 and result.id == 7 and data.data == b"block_value" and len(state.scope.locals) == 2 and state.scope.locals[0].name == b"<membership>" and state.scope.locals[0].ty == 1 and state.scope.locals[1].ty == 19 and not state.scope.locals[0].flags.initialized and len(state.scope.active) == 0


public func test_dictionary_membership_wrong_key_reports_full_membership_site() -> bool fails syntax_value.Problem:
    mut state = try fresh()
    const raw = try membership(mut state, 1, True)
    match engine.expression(mut state, raw):
        case Ok(unused):
            return False
        case Err(problem):
            return problem.code == "E_TYPE" and problem.message == "expected bool, found int" and problem.start == 0 and problem.end == 11 and len(state.scope.locals) == 0
