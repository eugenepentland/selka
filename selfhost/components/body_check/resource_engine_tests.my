func scoped(discard_name: bool = False) -> engine.State fails syntax_value.Problem:
    mut state = try fresh()
    const path = try syntax_value.octets(mut state.syntax.pool, b"blob.bin")
    const mode = try syntax_value.octets(mut state.syntax.pool, b"rb")
    const path_id = try node(mut state, b"text", path, 3, 7)
    const mode_id = try node(mut state, b"text", mode, 3, 7)
    const owner = try syntax_value.span(mut state.syntax.pool, 0, 2)
    const open_name = try syntax_value.span(mut state.syntax.pool, 3, 7)
    const open_call = try call(mut state, owner, open_name, [path_id, mode_id])
    const open_id = try node(mut state, b"call", open_call, 0, 7)
    mut binding_end = 12
    if discard_name:
        state.syntax.source = b"fs open _    read Stream Filesystem"
        binding_end = 9
        const previous = try syntax_value.span(mut state.syntax.pool, 8, 9)
        _ = try locals.add(mut state.scope, b"_", previous, 0, False, b"local")
    const file_name = try syntax_value.span(mut state.syntax.pool, 8, binding_end)
    const read_name = try syntax_value.span(mut state.syntax.pool, 13, 17)
    const read_call = try call(mut state, file_name, read_name, [])
    const read_id = try node(mut state, b"call", read_call, 8, 17)
    const discard_value = try syntax_value.integer(mut state.syntax.pool, read_id)
    const discard = try statement(mut state, b"discard", discard_value, 8, 17)
    const resource = try syntax_value.integer(mut state.syntax.pool, open_id)
    const body = try syntax_value.integer(mut state.syntax.pool, discard)
    const scope = try syntax_value.object(mut state.syntax.pool, ["name", "resource", "body"], [file_name, resource, body])
    const scope_id = try statement(mut state, b"with_scope", scope, 0, 17)
    _ = try engine.statement(mut state, scope_id)
    return state


public func test_binary_scope_owns_read_and_preserves_operands_and_recipe_order() -> bool fails syntax_value.Problem:
    const state = try scoped()
    const data_id = try graph.field(state.batch.pool, state.batch.nodes[13], "data")
    const data = try graph.get(state.batch.pool, data_id)
    const payload = try graph.payload(state.batch.pool, data_id)
    const args_id = try graph.field(state.batch.pool, payload, "arguments")
    const args = try graph.items(state.batch.pool, args_id)
    const first = try graph.number(state.batch.pool, args[0])
    const path = try graph.number(state.batch.pool, args[1])
    const mode = try graph.number(state.batch.pool, args[2])
    const read_data_id = try graph.field(state.batch.pool, state.batch.nodes[14], "data")
    const read_data = try graph.get(state.batch.pool, read_data_id)
    const read_payload = try graph.payload(state.batch.pool, read_data_id)
    const read_owner_id = try graph.field(state.batch.pool, read_payload, "owner")
    const read_owner = try graph.number(state.batch.pool, read_owner_id)
    const read_argument_id = try graph.field(state.batch.pool, read_payload, "argument")
    const read_argument = try graph.get(state.batch.pool, read_argument_id)
    return data.data == b"file_access" and [first, path, mode] == [12, 8, 11] and read_data.data == b"file_method" and read_owner == 1 and read_argument.kind == 0 and len(state.batch.facts.lists.recipes) == 1 and state.batch.facts.lists.recipes[0].element == 19 and state.scope.active == [0] and state.scope.locals[0].usage.reads == 1 and state.scope.locals[1].flags.scoped_file and state.scope.locals[1].flags.initialized and not state.scope.locals[1].mutable and state.scope.locals[1].usage.reads == 1


public func test_scoped_file_name_cannot_escape_as_value() -> bool fails syntax_value.Problem:
    mut state = try fresh()
    const declaration = try syntax_value.span(mut state.syntax.pool, 8, 12)
    const slot = try locals.add(mut state.scope, b"file", declaration, 16, False, b"local")
    state.scope.locals[slot].flags.scoped_file = True
    const raw = try node(mut state, b"name", declaration, 8, 12)
    match engine.expression(mut state, raw):
        case Ok(value):
            return False
        case Err(problem):
            return problem.code == "E_WITH_RESOURCE" and problem.start == 8 and problem.end == 12 and state.scope.locals[slot].usage.reads == 0


public func test_reserved_capabilities_have_distinct_primitive_identity() -> bool fails syntax_value.Problem:
    mut state = try fresh()
    const stream_span = try syntax_value.span(mut state.syntax.pool, 18, 24)
    const fs_span = try syntax_value.span(mut state.syntax.pool, 25, 35)
    const stream = try engine.type_at(mut state, stream_span)
    const fs = try engine.type_at(mut state, fs_span)
    return stream == 18 and fs == 11


func token_module(mut pool: syntax_value.Pool, name: bytes, offset: int) -> int fails syntax_value.Problem:
    const module_name = try syntax_value.octets(mut pool, name)
    const source = try syntax_value.octets(mut pool, b"Token[]")
    const context = try syntax_value.object(mut pool, ["name", "source"], [module_name, source])
    const token = try syntax_value.octets(mut pool, b"Token")
    const span = try syntax_value.span(mut pool, 0, 5)
    const kind = try syntax_value.enumeration(mut pool, b"type")
    const yes = try syntax_value.boolean(mut pool, True)
    const absent = try syntax_value.absent(mut pool)
    const symbol = try syntax_value.object(mut pool, ["name", "span", "kind", "exported", "re_export"], [token, span, kind, yes, absent])
    const symbols = try syntax_value.sequence(mut pool, [symbol])
    const imports = try syntax_value.sequence(mut pool, [])
    const start = try syntax_value.integer(mut pool, offset)
    return try syntax_value.object(mut pool, ["context", "offset", "symbols", "imports"], [context, start, symbols, imports])


public func test_identically_spelled_module_local_suffixes_keep_nominal_identity() -> bool fails syntax_value.Problem:
    mut state = try fresh()
    state.syntax.source = b"Token[] Token[]"
    const first_module = try token_module(mut state.syntax.pool, b"first", 0)
    const second_module = try token_module(mut state.syntax.pool, b"second", 8)
    state.syntax.modules = [first_module, second_module]
    state.syntax.usage = [[], []]
    match record_name_index.make([b"first::Token", b"second::Token"]):
        case Ok(table):
            state.batch.facts.lists.types.records.bindings.table = table
        case Err(problem):
            fail syntax_value.Problem(code="P_BODY_LIMIT", start=0, end=0, message=problem.message)
    state.batch.facts.lists.types.records.bindings.types = [19, 20]
    state.batch.facts.lists.by_element[19] = 21
    state.batch.facts.lists.by_element[20] = 22
    const growable = try syntax_value.enumeration(mut state.syntax.pool, b"growable")
    const first_span = try syntax_value.span(mut state.syntax.pool, 0, 7)
    const first_base = try syntax_value.span(mut state.syntax.pool, 0, 5)
    const first = try syntax_value.object(mut state.syntax.pool, ["span", "base", "kind"], [first_span, first_base, growable])
    const second_span = try syntax_value.span(mut state.syntax.pool, 8, 15)
    const second_base = try syntax_value.span(mut state.syntax.pool, 8, 13)
    const second = try syntax_value.object(mut state.syntax.pool, ["span", "base", "kind"], [second_span, second_base, growable])
    state.batch.facts.lists.types.suffixes = [first, second]
    const first_type = try engine.type_at(mut state, first_span)
    const second_type = try engine.type_at(mut state, second_span)
    return first_type == 21 and second_type == 22


