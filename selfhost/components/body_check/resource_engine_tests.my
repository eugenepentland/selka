func node(mut state: engine.State, tag: bytes, payload: int, start: int, end: int) -> int fails syntax_value.Problem:
    const span = try syntax_value.span(mut state.syntax.pool, start, end)
    const data = try syntax_value.tagged(mut state.syntax.pool, tag, payload)
    const row = try syntax_value.object(mut state.syntax.pool, ["span", "data"], [span, data])
    const id = len(state.syntax.nodes)
    state.syntax.nodes.append(row)
    return id


func call(mut state: engine.State, owner: int, name: int, arguments: int[]) -> int fails syntax_value.Problem:
