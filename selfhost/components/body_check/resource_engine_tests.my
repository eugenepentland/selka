        const id = try syntax_value.integer(mut state.syntax.pool, argument)
        ids.append(id)
    const args = try syntax_value.sequence(mut state.syntax.pool, ids)
    const empty = try syntax_value.sequence(mut state.syntax.pool, [])
    return try syntax_value.object(mut state.syntax.pool, ["name", "owner", "arguments", "argument_names", "type_arguments"], [name, owner, args, empty, empty])


