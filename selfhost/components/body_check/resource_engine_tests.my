    const method = try open_rejection(True, True, True)
    return free.code == "E_CALL_ARGUMENT" and free.start == 3 and free.end == 7 and method.code == "E_UNKNOWN_NAME" and method.start == 8 and method.end == 15


public func test_method_open_known_operands_then_rejects_keyword_at_call_name() -> bool fails syntax_value.Problem:
    const method = try open_rejection(True, True, False)
    return method.code == "E_CALL_ARGUMENT" and method.start == 3 and method.end == 7 and method.message == "keyword arguments require a declared function or record constructor"
