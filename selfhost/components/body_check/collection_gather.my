import syntax_value
import emission
import locals
import list_lower
import buffer_lower
import list_iteration
import dictionary_view_lower
import comprehension_lower

public record Input:
    iterable: int
    owner_type: int
    element: int
    output_type: int
    projection: dictionary_view_lower.Shape
    kind: bytes
    loop_id: int


public record Gathered:
    value: list_lower.Lowered
    next_loop: int


func discard(mut batch: emission.Batch, context: list_lower.Context, value: int) -> int fails syntax_value.Problem:
    const payload = try syntax_value.integer(mut batch.pool, value)
    return try emission.statement(mut batch, context.input, context.span, False, b"discard", payload)


func element(mut batch: emission.Batch, context: list_lower.Context, request: Input, owner: int, index: int) -> int fails syntax_value.Problem:
    if request.kind == b"keys" or request.kind == b"values" or request.kind == b"items":
        return try dictionary_view_lower.at(mut batch, context, owner, index, request.projection)
    if request.kind == b"dict" or request.kind == b"set":
        return try list_lower.operation(mut batch, context, list_lower.Operation(owner=owner, kind=b"key_at", arguments=[index], ty=request.element))
    mut ty = request.element
    if request.kind == b"bytes":
        ty = 5
    const value = try list_lower.operation(mut batch, context, list_lower.Operation(owner=owner, kind=b"read", arguments=[index], ty=ty))
    if request.kind == b"bytes":
        return try buffer_lower.cast(mut batch, context, value, 0)
    return value


public func set_from(mut batch: emission.Batch, mut scope: locals.Scope, context: list_lower.Context, request: Input) -> Gathered fails syntax_value.Problem:
    if request.kind != b"list" and request.kind != b"text" and request.kind != b"bytes" and request.kind != b"dict" and request.kind != b"set" and request.kind != b"keys" and request.kind != b"values" and request.kind != b"items":
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid set gather source kind")
    mut iterable = request.iterable
    if request.kind == b"keys" or request.kind == b"values" or request.kind == b"items":
        const mapping = try dictionary_view_lower.owner(mut batch, context, iterable, request.owner_type)
        iterable = mapping
    const active = scope.active
    const owner = try list_lower.temporary(mut scope, context, request.owner_type)
    const index = try list_lower.temporary(mut scope, context, 0)
    const limit = try list_lower.temporary(mut scope, context, 0)
    const slot = try list_lower.temporary(mut scope, context, request.element)
    const output = try list_lower.temporary(mut scope, context, request.output_type)
    const value = try list_lower.read(mut batch, context, slot, request.element)
    const absent = try syntax_value.absent(mut batch.pool)
    const unit = try emission.node(mut batch, context.input, context.span, 15, b"unit", absent)
    const write = try list_lower.operation(mut batch, context, list_lower.Operation(owner=output, kind=b"write", arguments=[value, unit], ty=15))
    const added = try discard(mut batch, context, write)
    const setup_owner = try list_lower.store(mut batch, context, owner, iterable, True)
    const position = try list_lower.read(mut batch, context, index, 0)
    const selected = try element(mut batch, context, request, owner, position)
    const initialize = try list_lower.store(mut batch, context, slot, selected, True)
    const one = try list_lower.integer(mut batch, context, 1, 0)
    const next = try list_lower.binary(mut batch, context, b"add", position, one, 0)
    const advance = try list_lower.store(mut batch, context, index, next, False)
    const iteration = list_iteration.Input(source=b"", name=context.span, span=context.span, iterable=iterable, owner_type=request.owner_type, element=request.element, loop_id=request.loop_id)
    const plan = list_iteration.Plan(request=iteration, owner=owner, index=index, limit=limit, binding=slot, before_active=active)
    const guard = try list_iteration.guard(mut batch, context, plan, [], False)
    const body = try comprehension_lower.block_statement(mut batch, context, [guard, initialize, added])
    const step = try comprehension_lower.block_statement(mut batch, context, [guard, advance])
    # Native comprehensionLoop emits its zero capacity even for a set output.
    _ = try list_lower.integer(mut batch, context, 0, 0)
    const empty = try emission.ids(mut batch, [])
    const fresh = try emission.node(mut batch, context.input, context.span, request.output_type, b"array", empty)
    const zero = try list_lower.integer(mut batch, context, 0, 0)
    const setup_index = try list_lower.store(mut batch, context, index, zero, True)
    mut length = -1
    if request.kind == b"list":
        const count = try list_lower.length(mut batch, context, owner)
        length = count
    else:
        const count = try buffer_lower.length(mut batch, context, owner)
        length = count
    const setup_limit = try list_lower.store(mut batch, context, limit, length, True)
    const setup_output = try list_lower.store(mut batch, context, output, fresh, True)
    const bound = try list_lower.read(mut batch, context, limit, 0)
    const condition = try list_lower.binary(mut batch, context, b"lt", position, bound, 1)
    const loop = try comprehension_lower.loop_statement(mut batch, context, request.loop_id, condition, body, step)
    const result = try list_lower.read(mut batch, context, output, request.output_type)
    const lowered = try list_lower.block(mut batch, context, [setup_owner, setup_index, setup_limit, setup_output, loop], result, request.output_type)
    return Gathered(value=lowered, next_loop=request.loop_id + 1)
