import recipe_index
import syntax_value

public func test_kind_and_argument_order_are_distinct() -> bool fails syntax_value.Problem:
    mut index = recipe_index.empty()
    _ = try recipe_index.insert(mut index, recipe_index.Key(kind=0, first=0, second=-1, id=19))
    _ = try recipe_index.insert(mut index, recipe_index.Key(kind=2, first=0, second=-1, id=20))
    _ = try recipe_index.insert(mut index, recipe_index.Key(kind=1, first=0, second=1, id=21))
    _ = try recipe_index.insert(mut index, recipe_index.Key(kind=1, first=1, second=0, id=22))
    return recipe_index.lookup(index, 0, 0, -1) == 19 and recipe_index.lookup(index, 2, 0, -1) == 20 and recipe_index.lookup(index, 1, 0, 1) == 21 and recipe_index.lookup(index, 1, 1, 0) == 22


public func test_growth_preserves_first_demand_ids_and_missing_lookup() -> bool fails syntax_value.Problem:
    mut index = recipe_index.empty()
    for position in range(300):
        _ = try recipe_index.insert(mut index, recipe_index.Key(kind=1, first=position, second=position + 1, id=19 + position))
    for position in range(300):
        if recipe_index.lookup(index, 1, position, position + 1) != 19 + position:
            return False
    return recipe_index.lookup(index, 1, 300, 301) == -1 and len(index.keys) == 300


public func test_duplicate_id_conflict_is_transport_not_reinterning() -> bool fails syntax_value.Problem:
    mut index = recipe_index.empty()
    const key = recipe_index.Key(kind=1, first=0, second=1, id=19)
    _ = try recipe_index.insert(mut index, key)
    const again = try recipe_index.insert(mut index, key)
    if again or len(index.keys) != 1:
        return False
    match recipe_index.insert(mut index, recipe_index.Key(kind=1, first=0, second=1, id=20)):
        case Ok(value):
            return False
        case Err(problem):
            return problem.code == "P_BODY_TRANSPORT"
