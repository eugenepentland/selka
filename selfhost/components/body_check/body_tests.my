import syntax_value
import graph
import checking
import engine
import locals

func input(value_tag: bytes, return_text: bytes) -> syntax_value.Pool fails syntax_value.Problem:
    mut pool = syntax_value.empty()
    const absent = try syntax_value.absent(mut pool)
    const empty = try syntax_value.sequence(mut pool, [])
    const name = try syntax_value.span(mut pool, 0, 1)
    const ty = try syntax_value.span(mut pool, 2, 2 + len(return_text))
    const literal = try syntax_value.span(mut pool, 2 + len(return_text) + 1, 2 + len(return_text) + 3)
    mut payload = literal
    if value_tag == b"boolean":
        payload = try syntax_value.boolean(mut pool, True)
    const node_data = try syntax_value.tagged(mut pool, value_tag, payload)
    const node = try syntax_value.object(mut pool, ["span", "data"], [literal, node_data])
    const nodes = try syntax_value.sequence(mut pool, [node])
    const zero = try syntax_value.integer(mut pool, 0)
    const ret_data = try syntax_value.tagged(mut pool, b"ret", zero)
    const statement = try syntax_value.object(mut pool, ["span", "data"], [literal, ret_data])
    const statements = try syntax_value.sequence(mut pool, [statement])
    const signature = try syntax_value.object(mut pool, ["type_parameters", "parameters", "return_type", "failure_type", "mut_positions"], [empty, empty, ty, absent, empty])
    const no = try syntax_value.boolean(mut pool, False)
    const policy = try syntax_value.object(mut pool, ["constant", "c_abi", "restricted", "conversion", "host", "owner", "effect_bound"], [no, no, no, no, absent, absent, absent])
    const function = try syntax_value.object(mut pool, ["name", "signature", "body", "policy"], [name, signature, zero, policy])
    const functions = try syntax_value.sequence(mut pool, [function])
    const type_expressions = try syntax_value.object(mut pool, ["applications", "aliases", "suffixes"], [empty, empty, empty])
    const types = try syntax_value.object(mut pool, ["records", "domains", "resources", "variants", "constraints", "expressions"], [empty, empty, empty, empty, empty, type_expressions])
    const program = try syntax_value.object(mut pool, ["nodes", "statements", "functions", "lambdas", "attributes", "types"], [nodes, statements, functions, empty, empty, types])
    const path = try syntax_value.octets(mut pool, b"input.my")
    mut source_text = b"f " + return_text + b" 42"
    const source = try syntax_value.octets(mut pool, source_text)
    const context = try syntax_value.object(mut pool, ["path", "source"], [path, source])
    const record_count = try syntax_value.integer(mut pool, 0)
    const templates = try syntax_value.object(mut pool, ["result", "option"], [absent, absent])
    const catalog = try syntax_value.object(mut pool, ["string", "bytes", "base_count", "lists", "list_available", "records", "templates"], [absent, absent, record_count, empty, no, empty, templates])
    _ = try syntax_value.object(mut pool, ["context", "program", "modules", "catalog"], [context, program, empty, catalog])
    return pool


public func test_integer_return_full_typed_batch() -> bool fails syntax_value.Problem:
    const request = try input(b"integer", b"int")
    const response = try checking.check(request, len(request.values) - 1)
    const outcome = try graph.get(response, len(response.values) - 1)
    if outcome.data != b"success":
        return False
    const output = try graph.payload(response, len(response.values) - 1)
    const batch = try graph.field(response, output, "batch")
    const nodes_id = try graph.field(response, batch, "nodes")
    const nodes = try graph.items(response, nodes_id)
    const node_type = try graph.field(response, nodes[0], "ty")
    const ty = try graph.number(response, node_type)
    const ranges_id = try graph.field(response, batch, "ranges")
    const ranges = try graph.items(response, ranges_id)
    return ty == 0 and len(nodes) == 1 and len(ranges) == 1


public func test_boolean_return_type_rejected() -> bool fails syntax_value.Problem:
    const request = try input(b"boolean", b"int")
    const response = try checking.check(request, len(request.values) - 1)
    const outcome = try graph.get(response, len(response.values) - 1)
    if outcome.data != b"failure":
        return False
    const failures_id = try graph.payload(response, len(response.values) - 1)
    const failures = try graph.items(response, failures_id)
    const message_id = try graph.field(response, failures[0], "message")
    const message = try graph.get(response, message_id)
    return len(failures) == 1 and message.data == b"expected int, found bool"


public func test_managed_signature_profile_refusal() -> bool fails syntax_value.Problem:
    const request = try input(b"integer", b"bytes")
    const response = try checking.check(request, len(request.values) - 1)
    const outcome = try graph.get(response, len(response.values) - 1)
    return outcome.data == b"profile"


public func test_malformed_body_reference_is_transport_failure() -> bool fails syntax_value.Problem:
    mut request = try input(b"integer", b"int")
    const root = len(request.values) - 1
    const program = try graph.field(request, root, "program")
    const functions_id = try graph.field(request, program, "functions")
    const functions = try graph.items(request, functions_id)
    const body = try graph.field(request, functions[0], "body")
    request.values[body].integer = 999
    match checking.check(request, root):
        case Ok(reply):
            return False
        case Err(problem):
            return problem.code == "P_BODY_TRANSPORT"


public func test_semantic_depth_limit_is_deliberate_profile_refusal() -> bool fails syntax_value.Problem:
    mut request = try input(b"integer", b"int")
    const root = len(request.values) - 1
    const program = try graph.field(request, root, "program")
    const original_id = try graph.field(request, program, "statements")
    const original = try graph.items(request, original_id)
    mut statements = original
    const span = try graph.field(request, original[0], "span")
    for index in range(256):
        const child = try syntax_value.integer(mut request, index)
        const children = try syntax_value.sequence(mut request, [child])
        const data = try syntax_value.tagged(mut request, b"block", children)
        const statement = try syntax_value.object(mut request, ["span", "data"], [span, data])
        statements.append(statement)
    request.values[original_id].children = statements
    const functions_id = try graph.field(request, program, "functions")
    const functions = try graph.items(request, functions_id)
    const body = try graph.field(request, functions[0], "body")
    request.values[body].integer = 256
    const response = try checking.check(request, root)
    const outcome = try graph.get(response, len(response.values) - 1)
    const payload = try graph.payload(response, len(response.values) - 1)
    const code_id = try graph.field(response, payload, "code")
    const code = try graph.get(response, code_id)
    return outcome.data == b"profile" and code.data == b"P_BODY_PROFILE"


public func test_range_variable_assignment_is_native_immutable_error() -> bool fails syntax_value.Problem:
    mut request = try input(b"integer", b"int")
    const root = len(request.values) - 1
    const program = try graph.field(request, root, "program")
    const context = try graph.field(request, root, "context")
    const source_id = try graph.field(request, context, "source")
    const source = try graph.get(request, source_id)
    const name = try syntax_value.span(mut request, 0, 1)
    const set = try syntax_value.enumeration(mut request, b"set")
    const payload = try syntax_value.object(mut request, ["name", "op"], [name, set])
    const data = try syntax_value.tagged(mut request, b"assignment", payload)
    const statement = try syntax_value.object(mut request, ["span", "data"], [name, data])
    mut state = try engine.make(request, source.data, program)
    state.syntax.statements = [statement]
    _ = try locals.add(mut state.scope, b"f", name, 0, False, b"local")
    match engine.statement(mut state, 0):
        case Ok(value):
            _ = value
            return False
        case Err(problem):
            return problem.code == "E_IMMUTABLE" and problem.message == "this binding cannot be assigned" and problem.start == 0 and problem.end == 1


func assignment_state(op: bytes, present: bool) -> engine.State fails syntax_value.Problem:
    mut request = try input(b"integer", b"int")
    const root = len(request.values) - 1
    const program = try graph.field(request, root, "program")
    const context = try graph.field(request, root, "context")
    const source_id = try graph.field(request, context, "source")
    const source = try graph.get(request, source_id)
    const name = try syntax_value.span(mut request, 0, 1)
    const op_span = try syntax_value.span(mut request, 2, 3)
    const whole = try syntax_value.span(mut request, 0, 8)
    const zero = try syntax_value.integer(mut request, 0)
    const operator = try syntax_value.enumeration(mut request, op)
    const payload = try syntax_value.object(mut request, ["name", "op", "op_span", "value"], [name, operator, op_span, zero])
    const data = try syntax_value.tagged(mut request, b"assignment", payload)
    const statement = try syntax_value.object(mut request, ["span", "data"], [whole, data])
    mut state = try engine.make(request, source.data, program)
    state.syntax.statements = [statement]
    if present:
        _ = try locals.add(mut state.scope, b"f", name, 0, True, b"parameter")
    return state


public func test_augmented_remainder_preserves_origin_and_operator_span() -> bool fails syntax_value.Problem:
    mut state = try assignment_state(b"rem", True)
    _ = try engine.statement(mut state, 0)
    const node = state.batch.nodes[2]
    const span_id = try graph.field(state.batch.pool, node, "span")
    const start_id = try graph.field(state.batch.pool, span_id, "start")
    const end_id = try graph.field(state.batch.pool, span_id, "end")
    const start = try graph.number(state.batch.pool, start_id)
    const end = try graph.number(state.batch.pool, end_id)
    const data_id = try graph.field(state.batch.pool, node, "data")
    const payload = try graph.payload(state.batch.pool, data_id)
    const op_id = try graph.field(state.batch.pool, payload, "op")
    const op = try graph.get(state.batch.pool, op_id)
    return state.scope.locals[0].origin == b"parameter" and state.scope.locals[0].usage.reads == 1 and state.scope.locals[0].usage.writes == 1 and start == 2 and end == 3 and op.data == b"floor_rem"


public func test_augmented_float_division_has_exact_source_error() -> bool fails syntax_value.Problem:
    mut state = try assignment_state(b"div", True)
    match engine.statement(mut state, 0):
        case Ok(value):
            _ = value
            return False
        case Err(problem):
            return problem.code == "E_TYPE" and problem.start == 2 and problem.end == 3 and problem.message == "augmented `/=` produces a float; declare the binding as float or use `//=`"


public func test_augmented_missing_name_is_unknown_name() -> bool fails syntax_value.Problem:
    mut state = try assignment_state(b"add", False)
    match engine.statement(mut state, 0):
        case Ok(value):
            _ = value
            return False
        case Err(problem):
            return problem.code == "E_UNKNOWN_NAME" and problem.message == "name is not defined in this scope" and problem.start == 0 and problem.end == 1


public func test_augmented_unbound_after_rhs_before_operator_with_related_site() -> bool fails syntax_value.Problem:
    mut state = try assignment_state(b"div", True)
    const declaration = try syntax_value.span(mut state.syntax.pool, 2, 3)
    state.scope.locals[0].declaration = declaration
    state.scope.locals[0].initialized = False
    match engine.statement(mut state, 0):
        case Ok(value):
            _ = value
            return False
        case Err(problem):
            if len(state.problems) != 1 or len(state.batch.nodes) != 1:
                return False
            const related = state.problems[0].notes.related
            if len(related) != 1:
                return False
            return problem.code == "E_UNBOUND" and problem.start == 0 and problem.end == 1 and problem.message == "name may be read before it is assigned; some control-flow path reaching here leaves it unbound" and related[0].start == 2 and related[0].end == 3 and related[0].message == "binding first assigned here" and state.scope.locals[0].usage.reads == 0


public func test_mut_marker_retains_inner_probe_and_emits_wrapper_span() -> bool fails syntax_value.Problem:
    mut state = try assignment_state(b"add", True)
    const inner_span = try syntax_value.span(mut state.syntax.pool, 0, 1)
    const outer_span = try syntax_value.span(mut state.syntax.pool, 0, 5)
    const name_data = try syntax_value.tagged(mut state.syntax.pool, b"name", inner_span)
    const inner = try syntax_value.object(mut state.syntax.pool, ["span", "data"], [inner_span, name_data])
    const zero = try syntax_value.integer(mut state.syntax.pool, 0)
    const marker_data = try syntax_value.tagged(mut state.syntax.pool, b"mut_argument", zero)
    const marker = try syntax_value.object(mut state.syntax.pool, ["span", "data"], [outer_span, marker_data])
    state.syntax.nodes = [inner, marker]
    const result = try engine.expression(mut state, 1)
    const reused = try engine.expression(mut state, 1)
    const node = state.batch.nodes[1]
    const span_id = try graph.field(state.batch.pool, node, "span")
    const end_id = try graph.field(state.batch.pool, span_id, "end")
    const end = try graph.number(state.batch.pool, end_id)
    const data_id = try graph.field(state.batch.pool, node, "data")
    const data = try graph.get(state.batch.pool, data_id)
    const slot_id = try graph.payload(state.batch.pool, data_id)
    const slot = try graph.number(state.batch.pool, slot_id)
    return result.id == 1 and reused.id == 1 and len(state.batch.nodes) == 2 and end == 5 and data.data == b"local" and slot == 0 and state.scope.locals[0].usage.reads == 1
