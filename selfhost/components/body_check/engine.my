                const expected = state.batch.facts.expected[raw_id]
                mut literal = integer_literals.Literal(ty=0, value=0, upper=False, minimum=False)
                if not floating_literals.spelling(text):
                    literal = try integer_literals.parse(text, True, expected, location.start, location.end)
                if not floating_literals.spelling(text) and (literal.minimum or expected >= 0):
                    if literal.upper or (literal.ty >= 5 and literal.value != 0):
                        const rejection = try problem(state, span, "E_INTEGER_RANGE", "negative integer literal does not fit its expected type")
                        fail rejection
                    mut negative = literal.value
                    if not (literal.ty == 0 and literal.minimum):
                        negative = -negative
                    const minimum_payload = try syntax_value.integer(mut state.batch.pool, negative)
                    const minimum_id = try emission.node(mut state.batch, state.syntax.pool, span, literal.ty, b"integer", minimum_payload)
                    state.batch.resolved[raw_id] = minimum_id
                    state.depth = state.depth - 1
                    return Expression(id=minimum_id, ty=literal.ty)
        if op.data == b"is_none":
            try hint_option_operand(mut state, operand_raw)
        if state.batch.facts.float_type >= 0 and state.batch.facts.expected[raw_id] == state.batch.facts.float_type:
            state.batch.facts.expected[operand_raw] = state.batch.facts.float_type
        const operand = try expression(mut state, operand_raw)
        ty = operand.ty
        if op.data == b"is_none":
            const shape = try variants.option_shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, operand.ty)
            if not shape.valid:
                const rejection = try problem(state, operator_span, "E_OPTION_TEST", "is None requires an Option value")
                fail rejection
            const pending = try variants.requires_handling(state.syntax.pool, state.batch.facts.lists.types.records.rows, operand.ty)
            if pending:
                const rejection = try problem(state, operator_span, "E_OPTION_TEST", "use match for an Option carrying an owned value or checked Result")
                fail rejection
            const lowered = try option_lower.presence_value(mut state.batch, mut state.scope, list_lower.Context(input=state.syntax.pool, span=span), operand.id, option_lower.Shape(owner_type=operand.ty, element=shape.element, some=shape.some, none=shape.none))
            const id = try list_lower.append(mut state.batch, list_lower.Context(input=state.syntax.pool, span=span), lowered)
            state.batch.resolved[raw_id] = id
            state.depth = state.depth - 1
            return Expression(id=id, ty=1)
        if op.data == b"neg" and state.batch.facts.float_type >= 0 and operand.ty == state.batch.facts.float_type:
            const context = list_lower.Context(input=state.syntax.pool, span=span)
            const lowered = try numeric_lower.floating_unary(mut state.batch, context, b"f64_neg", operand.id)
            const id = try list_lower.append(mut state.batch, context, lowered)
            state.batch.resolved[raw_id] = id
            state.depth = state.depth - 1
            return Expression(id=id, ty=operand.ty)
        if op.data == b"not":
            _ = try require(state, operand.ty, 1, operator_span)
            ty = 1
        elif not scalars.is_integer(operand.ty):
            const rejection = try problem(state, operator_span, "E_TYPE", "operation requires an integer type")
            fail rejection
        const typed_op = try syntax_value.enumeration(mut state.batch.pool, op.data)
        const typed_operand = try syntax_value.integer(mut state.batch.pool, operand.id)
        const typed_span = try graph.clone(mut state.batch.pool, state.syntax.pool, operator_span, 0)
        result_payload = try syntax_value.object(mut state.batch.pool, ["op", "operand", "op_span"], [typed_op, typed_operand, typed_span])
    elif data.data == b"call":
        mut call_name = try graph.field(state.syntax.pool, payload, "name")
        const constructor_owner_id = try graph.field(state.syntax.pool, payload, "owner")
        const constructor_owner = try graph.get(state.syntax.pool, constructor_owner_id)
        if constructor_owner.kind == 0:
            for application in state.batch.facts.applications:
                const application_span = try graph.field(state.syntax.pool, application, "span")
                const matches = try same_span(state.syntax.pool, application_span, call_name)
                const name_span = try graph.field(state.syntax.pool, application, "name")
                const name = try graph.spelling(state.syntax.pool, state.syntax.source, name_span)
                if matches and name == b"FixedArray":
                    _ = try io_arguments.positional(state.syntax.pool, payload)
                    const arguments_id = try graph.field(state.syntax.pool, payload, "arguments")
                    const arguments = try graph.items(state.syntax.pool, arguments_id)
                    if len(arguments) != 1:
                        const rejection = try problem(state, span, "E_ARITY", "FixedArray construction takes one array literal")
                        fail rejection
                    const constructor_raw = try graph.number(state.syntax.pool, arguments[0])
                    const raw_data_id = try graph.field(state.syntax.pool, state.syntax.nodes[constructor_raw], "data")
                    const raw_data = try graph.get(state.syntax.pool, raw_data_id)
                    if raw_data.data != b"list_literal":
                        const value = try expression(mut state, constructor_raw)
                        _ = try type_at(mut state, application_span)
                        if list_types.element_type(state.batch.facts.lists, value.ty) < 0:
                            const rejection = try problem(state, span, "E_TYPE", "runtime FixedArray conversion requires a growable array")
                            fail rejection
                        const rejection = try problem(state, span, "P_BODY_PROFILE", "runtime FixedArray conversion requires a checked length-error schema")
                        fail rejection
                    const constructor_type = try type_at(mut state, application_span)
                    const fixed = array_types.schema(state.batch.facts.lists.types.arrays, constructor_type)
                    const inputs = try graph.payload(state.syntax.pool, raw_data_id)
                    const result = try array_literal(mut state, inputs, span, fixed)
                    state.batch.resolved[raw_id] = result.id
                    state.depth = state.depth - 1
                    return result
        const type_arguments_id = try graph.field(state.syntax.pool, payload, "type_arguments")
        const type_arguments = try graph.items(state.syntax.pool, type_arguments_id)
        mut explicit_count = len(type_arguments)
        for application in state.batch.facts.applications:
            const application_span = try graph.field(state.syntax.pool, application, "span")
            const application_text = try graph.spelling(state.syntax.pool, state.syntax.source, application_span)
            const call_text = try graph.spelling(state.syntax.pool, state.syntax.source, call_name)
            if application_text == call_text:
                call_name = try graph.field(state.syntax.pool, application, "name")
                const arguments_id = try graph.field(state.syntax.pool, application, "arguments")
                const application_arguments = try graph.items(state.syntax.pool, arguments_id)
                explicit_count = len(application_arguments)
                break
        const owner = try graph.field(state.syntax.pool, payload, "owner")
        const raw_callee = try graph.spelling(state.syntax.pool, state.syntax.source, call_name)
        const owner_value = try graph.get(state.syntax.pool, owner)
        if owner_value.kind != 0:
            const owner_name = try graph.spelling(state.syntax.pool, state.syntax.source, owner)
            const owner_slot = locals.find(state.scope, owner_name)
            if owner_slot >= 0:
                const tuple = tuple_types.schema(state.batch.facts.lists.types.tuples, state.scope.locals[owner_slot].ty)
                if tuple.id >= 0:
                    const rejection = try problem(state, call_name, "E_TYPE", "a tuple has no methods; take it apart with `head, rest = value`")
                    fail rejection
                const option = try variants.option_shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, state.scope.locals[owner_slot].ty)
                if option.valid and (raw_callee == b"unwrap_or" or raw_callee == b"is_none" or raw_callee == b"is_some" or not option_flow.has(state.control.options, owner_slot)):
                    _ = try io_arguments.positional(state.syntax.pool, payload)
                    const base = try option_local(mut state, owner_slot, owner)
                    const arguments_id = try graph.field(state.syntax.pool, payload, "arguments")
                    const inputs = try graph.items(state.syntax.pool, arguments_id)
                    const result = try option_method(mut state, span, call_name, base, inputs)
                    state.batch.resolved[raw_id] = result.id
                    state.depth = state.depth - 1
                    return result
            if owner_slot >= 0 and option_flow.has(state.control.options, owner_slot):
                const shape = try variants.option_shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, state.scope.locals[owner_slot].ty)
                const collection = collection_types.schema(state.batch.facts.lists.types.collections, shape.element)
                if shape.valid and collection.id >= 0 and collection.kind <= 1:
                    _ = try io_arguments.positional(state.syntax.pool, payload)
                    if explicit_count != 0:
                        const rejection = try problem(state, span, "E_ARITY", "collection methods do not take explicit type arguments")
                        fail rejection
                    const arguments_id = try graph.field(state.syntax.pool, payload, "arguments")
                    const inputs = try graph.items(state.syntax.pool, arguments_id)
                    const base = try option_local(mut state, owner_slot, owner)
                    const result = try list_value_access(mut state, span, base, raw_callee, inputs)
                    state.batch.resolved[raw_id] = result.id
                    state.depth = state.depth - 1
                    return result
                if shape.valid and list_types.element_type(state.batch.facts.lists, shape.element) >= 0:
                    _ = try io_arguments.positional(state.syntax.pool, payload)
                    if explicit_count != 0:
                        const rejection = try problem(state, span, "E_ARITY", "collection methods do not take explicit type arguments")
                        fail rejection
                    mut kind = raw_callee
                    const arguments_id = try graph.field(state.syntax.pool, payload, "arguments")
                    const inputs = try graph.items(state.syntax.pool, arguments_id)
                    if kind == b"index":
                        kind = b"index_of"
                    if kind == b"pop" and len(inputs) == 1:
                        kind = b"pop_at"
                    if list_arity(kind) < 0:
                        const rejection = try problem(state, call_name, "E_COLLECTION_METHOD", "unknown method for a " + type_name(state, shape.element) + " receiver; accepted methods: append, clear, copy, extend, index, insert, pop, remove, reverse, sort")
                        fail rejection
                    const base = try option_local(mut state, owner_slot, owner)
                    const result = try list_value_access(mut state, span, base, kind, inputs)
                    state.batch.resolved[raw_id] = result.id
                    state.depth = state.depth - 1
                    return result
            if owner_slot >= 0 and collection_types.schema(state.batch.facts.lists.types.collections, state.scope.locals[owner_slot].ty).kind == 0:
                const result = try dictionary_method(mut state, payload, span, owner_slot)
                state.batch.resolved[raw_id] = result.id
                state.depth = state.depth - 1
                return result
            if owner_slot >= 0 and collection_types.schema(state.batch.facts.lists.types.collections, state.scope.locals[owner_slot].ty).kind == 1:
                const result = try set_method(mut state, payload, span, owner_slot)
                state.batch.resolved[raw_id] = result.id
                state.depth = state.depth - 1
                return result
            if owner_slot >= 0 and (state.scope.locals[owner_slot].ty == 11 or state.scope.locals[owner_slot].ty == 18 or state.scope.locals[owner_slot].ty == 16 or state.scope.locals[owner_slot].ty == 17):
                const result = try resource_call(mut state, raw_id, span, payload, owner_slot)
                state.batch.resolved[raw_id] = result.id
                state.depth = state.depth - 1
                return result
            if owner_slot >= 0 and list_types.element_type(state.batch.facts.lists, state.scope.locals[owner_slot].ty) >= 0:
                const result = try list_method(mut state, payload, span, owner_slot)
                state.batch.resolved[raw_id] = result.id
                state.depth = state.depth - 1
                return result
            if owner_slot >= 0 and sequence_type(state, state.scope.locals[owner_slot].ty) and not numeric_parse_name(raw_callee):
                const labels_id = try graph.field(state.syntax.pool, payload, "argument_names")
                const labels = try graph.items(state.syntax.pool, labels_id)
                if len(labels) != 0:
                    const rejection = try problem(state, call_name, "E_CALL_ARGUMENT", "keyword arguments require a declared function or record constructor")
                    fail rejection
                if explicit_count != 0:
                    const rejection = try problem(state, span, "P_BODY_PROFILE", "specialized sequence methods are outside the body profile")
                    fail rejection
                const arguments_id = try graph.field(state.syntax.pool, payload, "arguments")
                const arguments = try graph.items(state.syntax.pool, arguments_id)
                const result = try sequence_method(mut state, span, call_name, owner, owner_slot, Expression(id=-1, ty=state.scope.locals[owner_slot].ty), raw_callee, arguments)
                state.batch.resolved[raw_id] = result.id
                state.depth = state.depth - 1
                return result
            if owner_slot >= 0 and numeric_parse_name(raw_callee) and (state.scope.locals[owner_slot].ty == state.batch.facts.string_type or state.scope.locals[owner_slot].ty == state.batch.facts.bytes_type):
                const labels_id = try graph.field(state.syntax.pool, payload, "argument_names")
                const labels = try graph.items(state.syntax.pool, labels_id)
                if len(labels) != 0:
                    const rejection = try problem(state, call_name, "E_CALL_ARGUMENT", "keyword arguments require a declared function or record constructor")
                    fail rejection
                if explicit_count != 0:
                    const rejection = try problem(state, span, "P_BODY_PROFILE", "managed parse type arguments are outside the body profile")
                    fail rejection
                const arguments_id = try graph.field(state.syntax.pool, payload, "arguments")
                const arguments = try graph.items(state.syntax.pool, arguments_id)
                const base = Expression(id=-1, ty=state.scope.locals[owner_slot].ty)
                const result = try parse_numeric_access(mut state, span, base, owner_slot, owner, raw_callee, arguments)
                state.batch.resolved[raw_id] = result.id
                state.depth = state.depth - 1
                return result
            if owner_slot >= 0:
                const rejection = try problem(state, span, "P_BODY_PROFILE", "non-list managed methods are outside the admitted body closure")
                fail rejection
            if owner_name == b"file" or owner_name == b"text_file" or owner_name == b"Filesystem" or owner_name == b"Stream":
                const declared_owner = try declared_symbol(state, owner)
                if not declared_owner:
                    const rejection = try problem(state, owner, "E_TYPE", "operation requires a nominal scalar domain")
                    fail rejection
        if owner_value.kind == 0 and explicit_count == 0 and (raw_callee == b"print" or raw_callee == b"eprint"):
            const declared = try top_level(state, call_name)
            if locals.find(state.scope, raw_callee) < 0 and not declared:
                const diagnostic = try io_arguments.ambient(state.syntax.pool, payload)
                state.problems.append(diagnostic)
                fail diagnostic.problem
        if owner_value.kind == 0 and raw_callee == b"open":
            const declared = try top_level(state, call_name)
            if locals.find(state.scope, raw_callee) < 0 and not declared:
                const result = try resource_call(mut state, raw_id, span, payload, -1)
                state.batch.resolved[raw_id] = result.id
                state.depth = state.depth - 1
                return result
        if owner_value.kind != 0 and explicit_count == 0:
            const owner_name = try graph.spelling(state.syntax.pool, state.syntax.source, owner)
            if locals.find(state.scope, owner_name) < 0:
                const variant_type = try variant_owner(mut state, owner, state.batch.facts.expected[raw_id])
                if variant_type >= 0:
                    const shape = try variants.shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, variant_type)
                    const case_index = variants.case_tag(shape, raw_callee)
                    if case_index >= 0:
                        if shape.cases[case_index].fielded:
                            const arguments_id = try graph.field(state.syntax.pool, payload, "arguments")
                            const arguments = try graph.items(state.syntax.pool, arguments_id)
                            mut raw_arguments: int[] = []
                            for argument in arguments:
                                const value = try graph.number(state.syntax.pool, argument)
                                raw_arguments.append(value)
                            const labels_id = try graph.field(state.syntax.pool, payload, "argument_names")
                            const labels = try graph.items(state.syntax.pool, labels_id)
                            const result = try fielded_variant(mut state, variant_type, case_index, span, call_name, raw_arguments, labels)
                            state.batch.resolved[raw_id] = result.id
                            state.depth = state.depth - 1
                            return result
                        const labels_id = try graph.field(state.syntax.pool, payload, "argument_names")
                        const labels = try graph.items(state.syntax.pool, labels_id)
                        if len(labels) != 0:
                            const rejection = try problem(state, call_name, "E_CALL_ARGUMENT", "keyword arguments require a declared function or record constructor")
                            fail rejection
                        const arguments_id = try graph.field(state.syntax.pool, payload, "arguments")
                        const arguments = try graph.items(state.syntax.pool, arguments_id)
                        if len(arguments) != 1:
                            const rejection = try problem(state, call_name, "E_ARITY", "variant construction takes exactly one payload; an empty case is written without parentheses")
                            fail rejection
                        const argument = try graph.number(state.syntax.pool, arguments[0])
                        const result = try variant_value(mut state, variant_type, case_index, span, argument)
                        state.batch.resolved[raw_id] = result.id
                        state.depth = state.depth - 1
                        return result
        mut nominal = -1
        if len(state.syntax.modules) == 0:
            nominal = try nominal_key(mut state, raw_callee, call_name)
        else:
            const type_call = try record_names.is_type(state.syntax.pool, state.syntax.source, state.syntax.modules, record_names.Request(span=span, owner=owner, name=call_name))
            if type_call:
                const resolution = try record_names.resolve(mut state.problems, state.syntax.pool, state.syntax.source, state.syntax.modules, record_names.Request(span=span, owner=owner, name=call_name))
                nominal = try nominal_key(mut state, resolution.key, call_name)
                if resolution.from >= 0 and resolution.import_index >= 0:
                    state.syntax.usage[resolution.from][resolution.import_index] = True
        if record_types.schema(state.batch.facts.lists.types.records, nominal) >= 0:
            if explicit_count != 0:
                const rejection = try problem(state, span, "E_GENERIC_ARITY", "explicit type argument count does not match generic parameters")
                fail rejection
            const record_catalog = state.batch.facts.lists.types.records
            const declaration = record_catalog.declarations[record_catalog.by_type[nominal]]
            const fields_id = try graph.field(state.syntax.pool, declaration, "fields")
            const fields = try graph.items(state.syntax.pool, fields_id)
            const arguments_id = try graph.field(state.syntax.pool, payload, "arguments")
            const arguments = try graph.items(state.syntax.pool, arguments_id)
            mut raw_arguments: int[] = []
            for argument in arguments:
                const value = try graph.number(state.syntax.pool, argument)
                raw_arguments.append(value)
            const labels_id = try graph.field(state.syntax.pool, payload, "argument_names")
            const labels = try graph.items(state.syntax.pool, labels_id)
            const initializers = try record_construct.bind(state.syntax.pool, state.syntax.nodes, fields, record_construct.Input(source=state.syntax.source, name=call_name, span=span, arguments=raw_arguments, argument_names=labels), mut state.problems)
            const initialized = try record_initializers(mut state, nominal, span, initializers)
            const id = try emission.node(mut state.batch, state.syntax.pool, span, nominal, b"record", initialized)
            state.batch.resolved[raw_id] = id
            state.depth = state.depth - 1
            return Expression(id=id, ty=nominal)
        if nominal >= 0:
            const rejection = try problem(state, span, "P_BODY_PROFILE", "nonrecord nominal construction is outside the record body profile")
            fail rejection
        if owner_value.kind == 0 and prelude_call(raw_callee):
            const expected_name = try names.qualified(state.syntax.pool, state.syntax.source, state.syntax.modules, call_name)
            mut declared = False
            for function in state.syntax.functions:
                const name_span = try graph.field(state.syntax.pool, function, "name")
                const candidate = try names.qualified(state.syntax.pool, state.syntax.source, state.syntax.modules, name_span)
                if candidate == expected_name:
                    declared = True
            # Native byte conversion probes unqualified function keys. Project
            # functions have module-qualified keys and do not shadow this probe.
            if len(state.syntax.modules) != 0 and (raw_callee == b"bytes" or raw_callee == b"byte_buffer"):
                declared = False
            if not declared:
                if raw_callee == b"list" or raw_callee == b"set" or raw_callee == b"dict":
                    _ = try io_arguments.positional(state.syntax.pool, payload)
                    const generator_inputs_id = try graph.field(state.syntax.pool, payload, "arguments")
                    const generator_inputs = try graph.items(state.syntax.pool, generator_inputs_id)
                    if len(generator_inputs) == 1:
                        const generator_raw = try graph.number(state.syntax.pool, generator_inputs[0])
                        const generator_data_id = try graph.field(state.syntax.pool, state.syntax.nodes[generator_raw], "data")
                        const generator_data = try graph.get(state.syntax.pool, generator_data_id)
                        if generator_data.data == b"gather":
                            const generator_payload = try graph.payload(state.syntax.pool, generator_data_id)
                            const generator_shape_id = try graph.field(state.syntax.pool, generator_payload, "shape")
                            const generator_shape = try graph.get(state.syntax.pool, generator_shape_id)
                            if generator_shape.data == b"generator":
                                const generator_span = try graph.field(state.syntax.pool, state.syntax.nodes[generator_raw], "span")
                                const gathered = try gather_value_as(mut state, generator_payload, generator_span, state.batch.facts.expected[generator_raw], raw_callee)
                                state.batch.resolved[generator_raw] = gathered.id
                                const gathered_data_id = try graph.field(state.batch.pool, state.batch.nodes[gathered.id], "data")
                                const gathered_data = try graph.get(state.batch.pool, gathered_data_id)
                                const gathered_payload = try graph.payload(state.batch.pool, gathered_data_id)
                                const id = try emission.node(mut state.batch, state.syntax.pool, span, gathered.ty, gathered_data.data, gathered_payload)
                                state.batch.resolved[raw_id] = id
                                state.depth = state.depth - 1
                                return Expression(id=id, ty=gathered.ty)
                if raw_callee == b"dict":
                    const constructor_inputs_id = try graph.field(state.syntax.pool, payload, "arguments")
                    const constructor_inputs = try graph.items(state.syntax.pool, constructor_inputs_id)
                    mut checked_arguments: int[] = []
                    for input in constructor_inputs:
                        const argument_raw = try graph.number(state.syntax.pool, input)
                        const checked = try expression(mut state, argument_raw)
                        checked_arguments.append(checked.id)
                    const context = list_lower.Context(input=state.syntax.pool, span=span)
                    const lowered = try dictionary_construct.build(mut state.batch, mut state.scope, context, dictionary_construct.Input(arguments=checked_arguments, expected=state.batch.facts.expected[raw_id]), mut state.problems)
                    const id = try list_lower.append(mut state.batch, context, lowered)
                    const ty_id = try graph.field(state.batch.pool, state.batch.nodes[id], "ty")
                    const constructed_type = try graph.number(state.batch.pool, ty_id)
                    state.batch.resolved[raw_id] = id
                    state.depth = state.depth - 1
                    return Expression(id=id, ty=constructed_type)
                if raw_callee == b"list":
                    const inputs_id = try graph.field(state.syntax.pool, payload, "arguments")
                    const inputs = try graph.items(state.syntax.pool, inputs_id)
                    if len(inputs) == 1:
                        const list_input_raw = try graph.number(state.syntax.pool, inputs[0])
                        const value = try expression(mut state, list_input_raw)
                        const labels_id = try graph.field(state.syntax.pool, payload, "argument_names")
                        const labels = try graph.items(state.syntax.pool, labels_id)
                        for label in labels:
                            const label_value = try graph.get(state.syntax.pool, label)
                            if label_value.kind != 0:
                                const rejection = try problem(state, call_name, "E_CALL_ARGUMENT", "keyword arguments require a declared function or record constructor")
                                fail rejection
                        const result = try list_conversion(mut state, span, value)
                        state.batch.resolved[raw_id] = result.id
                        state.depth = state.depth - 1
                        return result
                if raw_callee == b"set":
                    _ = try io_arguments.positional(state.syntax.pool, payload)
                    const arguments_id = try graph.field(state.syntax.pool, payload, "arguments")
                    const inputs = try graph.items(state.syntax.pool, arguments_id)
                    if len(inputs) == 0:
                        const result = try empty_set(mut state, span, state.batch.facts.expected[raw_id])
                        state.batch.resolved[raw_id] = result.id
                        state.depth = state.depth - 1
                        return result
                    mut source = Expression(id=-1, ty=-1)
                    for input in inputs:
                        const argument_raw = try graph.number(state.syntax.pool, input)
                        const checked = try expression(mut state, argument_raw)
                        source = checked
                    if len(inputs) != 1:
                        const rejection = try problem(state, span, "E_ARITY", "set takes at most one argument: `set()` or `set(iterable)`")
                        fail rejection
                    const result = try set_conversion(mut state, span, source)
                    state.batch.resolved[raw_id] = result.id
                    state.depth = state.depth - 1
                    return result
                if raw_callee == b"ord" and locals.find(state.scope, raw_callee) < 0:
                    const shadowed = try top_level(state, call_name)
                    if shadowed or explicit_count != 0:
                        const rejection = try problem(state, span, "P_BODY_PROFILE", "shadowed or specialized ord conversion is outside the body profile")
                        fail rejection
                    const labels_id = try graph.field(state.syntax.pool, payload, "argument_names")
