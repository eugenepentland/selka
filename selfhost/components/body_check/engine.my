            const ty_id = try graph.field(state.batch.pool, state.batch.nodes[argument], "ty")
            const ty = try graph.number(state.batch.pool, ty_id)
            _ = try require(state, ty, 0, span)
        mut ty = shapes.bytes
        if owner_type == 17:
            ty = shapes.text
        const id = try resource_lower.read(mut state.batch, list_lower.Context(input=state.syntax.pool, span=span), resource_lower.Read(owner=slot, text=owner_type == 17, argument=argument, shapes=shapes, ty=ty))
        return Expression(id=id, ty=ty)
    if owner_type == 18:
        return try stream_call(mut state, span, call, slot)
    if name != b"open":
        const rejection = try problem(state, name_span, "P_BODY_PROFILE", "filesystem operation is outside the bounded open profile")
        fail rejection
    if slot < 0:
        _ = try io_arguments.positional(state.syntax.pool, call)
