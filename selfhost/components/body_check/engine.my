public record Syntax:
    pool: syntax_value.Pool
    source: bytes
    nodes: int[]
    statements: int[]
    functions: int[]
    modules: int[]
    usage: bool[][]


public record State:
    syntax: Syntax
    batch: emission.Batch
    scope: locals.Scope
    return_type: int
    depth: int
    control: Control
    problems: syntax_problem.Diagnostic[]


public record Expression:
    id: int
    ty: int


public record Values:
    yield_type: int
    yield_slot: int
    depth: int
    temporaries: int[]


public record Control:
    next: int
    active: int[]
    exited: bool[]
    values: Values
    success_type: int = 15
    failure_type: int = -1


public record Statement:
    id: int
    terminates: bool
    looping: bool = False


public func make(pool: syntax_value.Pool, source: bytes, program: int) -> State fails syntax_value.Problem:
    const node_list = try graph.field(pool, program, "nodes")
    const statement_list = try graph.field(pool, program, "statements")
    const function_list = try graph.field(pool, program, "functions")
    const nodes = try graph.items(pool, node_list)
    const statements = try graph.items(pool, statement_list)
    const functions = try graph.items(pool, function_list)
    mut batch = emission.empty()
    for function in functions:
        const span = try graph.field(pool, function, "name")
        const name = try graph.spelling(pool, source, span)
        batch.facts.top_names.append(name)
    const types = try graph.field(pool, program, "types")
    for field_name in ["records", "domains", "resources", "variants", "constraints"]:
        const list_id = try graph.field(pool, types, field_name)
        const declarations = try graph.items(pool, list_id)
        for declaration in declarations:
            const span = try graph.field(pool, declaration, "name")
            const name = try graph.spelling(pool, source, span)
            batch.facts.top_names.append(name)
    const expressions = try graph.field(pool, types, "expressions")
    const applications_id = try graph.field(pool, expressions, "applications")
    const applications = try graph.items(pool, applications_id)
    batch.facts.applications = applications
    const aliases_id = try graph.field(pool, expressions, "aliases")
    const aliases = try graph.items(pool, aliases_id)
    for alias in aliases:
        const span = try graph.field(pool, alias, "name")
        const name = try graph.spelling(pool, source, span)
        batch.facts.top_names.append(name)
    return State(syntax=Syntax(pool=pool, source=source, nodes=nodes, statements=statements, functions=functions, modules=[], usage=[]), batch=batch, scope=locals.empty(), return_type=15, depth=0, control=fresh_control(), problems=[])


public func problem(state: State, span: int, code: str, message: str) -> syntax_value.Problem fails syntax_value.Problem:
    const begin = try graph.field(state.syntax.pool, span, "start")
    const finish = try graph.field(state.syntax.pool, span, "end")
    const start = try graph.number(state.syntax.pool, begin)
    const end = try graph.number(state.syntax.pool, finish)
    return syntax_value.Problem(code=code, start=start, end=end, message=message)


public func require(state: State, actual: int, expected: int, span: int) -> bool fails syntax_value.Problem:
    if actual != expected:
        const rejection = try problem(state, span, "E_TYPE", "expected " + type_name(state, expected) + ", found " + type_name(state, actual))
        fail rejection
    return True


public func top_level(state: State, span: int) -> bool fails syntax_value.Problem:
    const name = try graph.spelling(state.syntax.pool, state.syntax.source, span)
    if len(state.syntax.modules) == 0:
        for candidate in state.batch.facts.top_names:
            if candidate == name:
                return True
        for builtin in [b"int", b"i64", b"bool", b"Unit", b"i8", b"i16", b"i32", b"u8", b"u16", b"u32", b"u64", b"str", b"bytes", b"float"]:
            if builtin == name:
                return True
        return False
    const start_id = try graph.field(state.syntax.pool, span, "start")
    const start = try graph.number(state.syntax.pool, start_id)
    const module = try names.module_at(state.syntax.pool, state.syntax.modules, start)
    if module < 0:
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="binding has no source module")
    const symbols_id = try graph.field(state.syntax.pool, state.syntax.modules[module], "symbols")
    const symbols = try graph.items(state.syntax.pool, symbols_id)
    for symbol in symbols:
        const name_id = try graph.field(state.syntax.pool, symbol, "name")
        const candidate = try graph.get(state.syntax.pool, name_id)
        if candidate.data == name:
            return True
    const imports_id = try graph.field(state.syntax.pool, state.syntax.modules[module], "imports")
    const imports = try graph.items(state.syntax.pool, imports_id)
    for imported in imports:
        const name_id = try graph.field(state.syntax.pool, imported, "name")
        const candidate = try graph.get(state.syntax.pool, name_id)
        const alias_id = try graph.field(state.syntax.pool, imported, "alias")
        const alias = try graph.get(state.syntax.pool, alias_id)
        if candidate.data == name or alias.data == name:
            return True
    return False


func prelude_call(name: bytes) -> bool:
    for builtin in [b"len", b"range", b"int", b"i64", b"bool", b"str", b"bytes", b"byte_buffer", b"list", b"set", b"dict", b"tuple", b"print", b"sorted", b"min", b"max", b"abs", b"sum", b"all", b"any", b"enumerate", b"reversed", b"zip", b"Some", b"Ok", b"Err", b"parse_int", b"parse_float"]:
        if name == builtin:
            return True
    return False


public func expression(mut state: State, raw_id: int) -> Expression fails syntax_value.Problem:
    if state.control.values.depth == 0:
        state.control.values.temporaries = []
    const first = len(state.control.values.temporaries)
    state.control.values.depth = state.control.values.depth + 1
    mut value = try checked_expression(mut state, raw_id)
    const expected = state.batch.facts.expected[raw_id]
    if expected >= 0 and expected != value.ty:
        const span = try graph.field(state.syntax.pool, state.syntax.nodes[raw_id], "span")
        const context = failure_lower.Context(pool=state.syntax.pool, records=state.batch.facts.lists.types.records.rows, span=span)
        const injected = try failure_lower.inject_optional(mut state.batch, context, expected, value.id)
        if injected != value.id:
            const ty = try failure_lower.type_of(state.batch, injected)
            state.batch.resolved[raw_id] = injected
            value = Expression(id=injected, ty=ty)
    state.control.values.temporaries = state.control.values.temporaries[:first]
    state.control.values.temporaries.append(value.ty)
    state.control.values.depth = state.control.values.depth - 1
    return value


func checked_expression(mut state: State, raw_id: int) -> Expression fails syntax_value.Problem:
    if raw_id < 0 or raw_id >= len(state.syntax.nodes):
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid expression index")
    if len(state.batch.resolved) > len(state.syntax.nodes) or len(state.batch.facts.expected) > len(state.syntax.nodes):
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="expression cache exceeds raw node table")
    while len(state.batch.resolved) < len(state.syntax.nodes):
        state.batch.resolved.append(-1)
    while len(state.batch.facts.expected) < len(state.syntax.nodes):
        state.batch.facts.expected.append(-1)
    const cached = state.batch.resolved[raw_id]
    if cached >= 0:
        const node = state.batch.nodes[cached]
        const type_id = try graph.field(state.batch.pool, node, "ty")
        const ty = try graph.number(state.batch.pool, type_id)
        return Expression(id=cached, ty=ty)
    if state.depth >= 256:
        fail syntax_value.Problem(code="P_BODY_LIMIT", start=0, end=0, message="body expression depth exceeded")
    state.depth = state.depth + 1
    const raw = state.syntax.nodes[raw_id]
    const span = try graph.field(state.syntax.pool, raw, "span")
    const data_id = try graph.field(state.syntax.pool, raw, "data")
    const data = try graph.get(state.syntax.pool, data_id)
    const payload = try graph.payload(state.syntax.pool, data_id)
    mut ty = 15
    mut result_payload = -1
    if data.data == b"integer":
        const spelling = try graph.spelling(state.syntax.pool, state.syntax.source, payload)
        const location = try problem(state, span, "", "")
        const number = try scalars.integer(spelling, False, location.start, location.end)
        result_payload = try syntax_value.integer(mut state.batch.pool, number)
        ty = 0
    elif data.data == b"boolean":
        const value = try graph.get(state.syntax.pool, payload)
        if value.kind != 2:
            fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid Boolean payload")
        result_payload = try syntax_value.boolean(mut state.batch.pool, value.integer != 0)
        ty = 1
    elif data.data == b"unit":
        const spelling = try graph.spelling(state.syntax.pool, state.syntax.source, span)
        if spelling == b"None":
            const expected = state.batch.facts.expected[raw_id]
            const shape = try variants.option_shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, expected)
            if shape.valid:
                const tag = try syntax_value.integer(mut state.batch.pool, shape.none)
                const value = try syntax_value.absent(mut state.batch.pool)
                const wrapped = try syntax_value.object(mut state.batch.pool, ["tag", "value"], [tag, value])
                const id = try emission.node(mut state.batch, state.syntax.pool, span, expected, b"variant", wrapped)
                state.batch.resolved[raw_id] = id
                state.depth = state.depth - 1
                return Expression(id=id, ty=expected)
            if expected == 15:
                const rejection = try problem(state, span, "E_NONE_UNIT", "None means optional absence; write () for the Unit value")
                state.problems.append(syntax_problem.repaired(rejection, [syntax_problem.Edit(start=rejection.start, end=rejection.end, text=b"()")]))
                fail rejection
            const rejection = try problem(state, span, "E_NONE_CONTEXT", "None requires an expected optional type")
            fail rejection
        result_payload = try syntax_value.absent(mut state.batch.pool)
    elif data.data == b"text" or data.data == b"bytes":
        const value = try graph.get(state.syntax.pool, payload)
        if value.kind != 3:
            fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid sequence literal payload")
        ty = state.batch.facts.bytes_type
        if data.data == b"bytes" and state.batch.facts.expected[raw_id] >= 0 and state.batch.facts.expected[raw_id] < 19:
            const rejection = try problem(state, span, "P_BODY_PROFILE", "byte literals in scalar contexts require an additional fixed-array catalog schema")
            fail rejection
        mut text_literal = data.data == b"text"
        if data.data == b"bytes" and state.batch.facts.expected[raw_id] >= 19:
            ty = state.batch.facts.expected[raw_id]
            text_literal = ty == state.batch.facts.string_type
        if text_literal:
            ty = state.batch.facts.string_type
        if ty < 0:
            const rejection = try problem(state, span, "P_BODY_PROFILE", "managed sequence builtin is unavailable")
            fail rejection
        result_payload = try sequences.literal(mut state.batch, state.syntax.pool, span, value.data, text_literal)
        const id = try emission.node(mut state.batch, state.syntax.pool, span, ty, b"array", result_payload)
        state.batch.resolved[raw_id] = id
        state.depth = state.depth - 1
        return Expression(id=id, ty=ty)
    elif data.data == b"list_literal":
        const inputs = try graph.items(state.syntax.pool, payload)
        mut element = list_types.element_type(state.batch.facts.lists, state.batch.facts.expected[raw_id])
        if state.batch.facts.expected[raw_id] >= 0 and element < 0:
            const rejection = try problem(state, span, "E_LIST_TYPE", "operation requires a managed list")
            fail rejection
        if len(inputs) == 0 and element < 0:
            const rejection = try problem(state, span, "E_LIST_INFERENCE", "empty list requires an expected List type")
            fail rejection
        mut values: int[] = []
        for input in inputs:
            const child = try graph.number(state.syntax.pool, input)
            if child < 0 or child >= len(state.syntax.nodes):
                fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid list element node")
            state.batch.facts.expected[child] = element
            const value = try expression(mut state, child)
            if element < 0:
                element = value.ty
            else:
                const child_span = try graph.field(state.syntax.pool, state.syntax.nodes[child], "span")
                _ = try require(state, value.ty, element, child_span)
            values.append(value.id)
        const list_type = try list_types.intern(mut state.batch.facts.lists, state.syntax.pool, list_types.Recipe(id=0, element=element, span=span), [state.batch.facts.string_type, state.batch.facts.bytes_type])
        ty = list_type
        const pending_element = try variants.requires_handling(state.syntax.pool, state.batch.facts.lists.types.records.rows, element)
        if pending_element:
            if state.batch.facts.expected[raw_id] < 0:
                fail syntax_value.Problem(code="E_LIST_ELEMENT", start=0, end=0, message="managed list elements must be copyable values without resources or result obligations")
            const rejection = try problem(state, span, "E_LIST_TYPE", "list elements require copyable storable values without pending results")
            fail rejection
        const lowered = try list_lower.literal(mut state.batch, mut state.scope, list_lower.Context(input=state.syntax.pool, span=span), list_lower.Literal(ty=ty, element=element, values=values))
        const id = try list_lower.append(mut state.batch, list_lower.Context(input=state.syntax.pool, span=span), lowered)
        state.batch.resolved[raw_id] = id
        state.depth = state.depth - 1
        return Expression(id=id, ty=ty)
    elif data.data == b"field_assignment":
        const result = try record_assignment(mut state, payload, span)
        state.batch.resolved[raw_id] = result.id
        state.depth = state.depth - 1
        return result
    elif data.data == b"index_assignment":
        const target_id = try graph.field(state.syntax.pool, payload, "target")
        const target_raw = try graph.number(state.syntax.pool, target_id)
        _ = try list_places.writable(state.syntax.pool, state.syntax.source, state.syntax.nodes, mut state.scope, target_raw)
        const target_span = try graph.field(state.syntax.pool, state.syntax.nodes[target_raw], "span")
        const target_data_id = try graph.field(state.syntax.pool, state.syntax.nodes[target_raw], "data")
        const target_data = try graph.get(state.syntax.pool, target_data_id)
        const indexed = try graph.payload(state.syntax.pool, target_data_id)
        if target_data.data != b"index":
            const rejection = try problem(state, span, "P_BODY_PROFILE", "augmented destination is outside the admitted list closure")
            fail rejection
        const base_id = try graph.field(state.syntax.pool, indexed, "base")
        const index_id = try graph.field(state.syntax.pool, indexed, "index")
        const base_raw = try graph.number(state.syntax.pool, base_id)
        const index_raw = try graph.number(state.syntax.pool, index_id)
        const base = try expression(mut state, base_raw)
        const index = try expression(mut state, index_raw)
        const element = list_types.element_type(state.batch.facts.lists, base.ty)
        if element < 0:
            const rejection = try problem(state, span, "P_BODY_PROFILE", "augmented destination requires an admitted list")
            fail rejection
        _ = try require(state, index.ty, 0, target_span)
        const plan = try list_places.prepare(mut state.batch, mut state.scope, list_lower.Context(input=state.syntax.pool, span=target_span), list_places.Indexed(base=base.id, owner_type=base.ty, index=index.id, element=element))
        const value_id = try graph.field(state.syntax.pool, payload, "value")
        const value_raw = try graph.number(state.syntax.pool, value_id)
        const value = try expression_expected(mut state, value_raw, element)
        _ = try require(state, value.ty, element, span)
        const op_id = try graph.field(state.syntax.pool, payload, "op")
        const op = try graph.get(state.syntax.pool, op_id)
        if managed(state, element):
            if op.data != b"add":
                const rejection = try problem(state, span, "E_TEXT_OPERATOR", "a managed collection augments with `+=` only, and str, bytes and list are the types that support it")
                fail rejection
        elif element != 0:
            const rejection = try problem(state, span, "E_TYPE", "operation requires an integer type")
            fail rejection
        elif op.data == b"div":
            const rejection = try problem(state, span, "E_TYPE", "augmented `/=` produces a float; declare the binding as float or use `//=`")
            fail rejection
        mut operator = op.data
        if operator == b"rem":
            operator = b"floor_rem"
        const context = list_lower.Context(input=state.syntax.pool, span=span)
        const combined = try list_lower.binary(mut state.batch, context, operator, plan.current, value.id, element)
        const lowered = try list_places.finish(mut state.batch, mut state.scope, context, plan, combined)
        const id = try list_lower.append(mut state.batch, context, lowered)
        state.batch.resolved[raw_id] = id
        state.depth = state.depth - 1
        return Expression(id=id, ty=15)
    elif data.data == b"list_operation" or data.data == b"method_call":
        const base_id = try graph.field(state.syntax.pool, payload, "base")
        const base_raw = try graph.number(state.syntax.pool, base_id)
        mut kind_name = b""
        if data.data == b"method_call":
            const name_span = try graph.field(state.syntax.pool, payload, "name")
            kind_name = try graph.spelling(state.syntax.pool, state.syntax.source, name_span)
            const labels_id = try graph.field(state.syntax.pool, payload, "argument_names")
            const labels = try graph.items(state.syntax.pool, labels_id)
            if len(labels) != 0:
                const rejection = try problem(state, span, "P_BODY_PROFILE", "named list method operands are outside the body profile")
                fail rejection
            if kind_name == b"index":
                kind_name = b"index_of"
        else:
            const kind_id = try graph.field(state.syntax.pool, payload, "kind")
            const kind = try graph.get(state.syntax.pool, kind_id)
            kind_name = kind.data
        const arguments_id = try graph.field(state.syntax.pool, payload, "arguments")
        const inputs = try graph.items(state.syntax.pool, arguments_id)
        if kind_name == b"parse_int":
            const base = try expression(mut state, base_raw)
            const result = try parse_integer_access(mut state, span, base, -1, span, len(inputs))
            state.batch.resolved[raw_id] = result.id
            state.depth = state.depth - 1
            return result
        if data.data == b"method_call":
            const sequence_base = try expression(mut state, base_raw)
            if sequence_type(state, sequence_base.ty):
                const name_span = try graph.field(state.syntax.pool, payload, "name")
                const result = try sequence_method(mut state, span, name_span, span, -1, sequence_base, kind_name, inputs)
                state.batch.resolved[raw_id] = result.id
                state.depth = state.depth - 1
                return result
        if kind_name == b"pop" and len(inputs) == 1:
            kind_name = b"pop_at"
        mut base = Expression(id=-1, ty=15)
        if data.data == b"method_call":
            base = try expression(mut state, base_raw)
        if kind_name == b"write" or kind_name == b"append" or kind_name == b"extend" or kind_name == b"insert" or kind_name == b"pop" or kind_name == b"pop_at" or kind_name == b"remove" or kind_name == b"reverse" or kind_name == b"sort" or kind_name == b"clear":
            _ = try list_places.writable(state.syntax.pool, state.syntax.source, state.syntax.nodes, mut state.scope, base_raw)
        if base.id < 0:
            base = try expression(mut state, base_raw)
        const element = list_types.element_type(state.batch.facts.lists, base.ty)
        if element < 0 and sequence_type(state, base.ty) and kind_name == b"write":
            const rejection = try problem(state, span, "E_COLLECTION_METHOD", "str and bytes are immutable")
            fail rejection
        if element < 0:
            const rejection = try problem(state, span, "P_BODY_PROFILE", "list operation receiver is outside the admitted list closure")
            fail rejection
        const arity = list_arity(kind_name)
        if arity < 0:
            const rejection = try problem(state, span, "P_BODY_PROFILE", "list method is outside the admitted list closure")
            fail rejection
        if arity != len(inputs):
            const signature = try list_signature(state, base.ty, kind_name)
            mut plural = "s"
            if arity == 1:
                plural = ""
            const rejection = try problem(state, span, "E_ARITY", "`" + signature + "` takes " + str(arity) + " argument" + plural + ", but this call passes " + str(len(inputs)))
            fail rejection
        if kind_name == b"sort" and element != 0 and element != state.batch.facts.string_type and element != state.batch.facts.bytes_type:
            const rejection = try problem(state, span, "E_COLLECTION_METHOD", "sort requires an integer, float, str or bytes element type")
            fail rejection
        mut values: int[] = []
        mut position = 0
        for input in inputs:
            const child_raw = try graph.number(state.syntax.pool, input)
            mut expected = 0
            if kind_name == b"append" or kind_name == b"contains" or kind_name == b"remove" or kind_name == b"index_of" or ((kind_name == b"write" or kind_name == b"insert") and position == 1):
                expected = element
            elif kind_name == b"extend":
                expected = base.ty
            const value = try expression_expected(mut state, child_raw, expected)
            _ = try require(state, value.ty, expected, span)
            values.append(value.id)
            position = position + 1
        mut result_type = 15
        if kind_name == b"read" or kind_name == b"pop" or kind_name == b"pop_at":
            result_type = element
        elif kind_name == b"contains":
            result_type = 1
        elif kind_name == b"length" or kind_name == b"capacity":
            result_type = 8
        elif kind_name == b"copy":
            result_type = base.ty
        elif kind_name == b"index_of":
            result_type = 0
        elif kind_name != b"write" and kind_name != b"append" and kind_name != b"extend" and kind_name != b"insert" and kind_name != b"remove" and kind_name != b"reverse" and kind_name != b"sort" and kind_name != b"clear":
            const rejection = try problem(state, span, "P_BODY_PROFILE", "list operation kind is outside the admitted list closure")
            fail rejection
        const context = list_lower.Context(input=state.syntax.pool, span=span)
        const lowered = try list_lower.access(mut state.batch, mut state.scope, context, list_lower.Access(base=base.id, owner_type=base.ty, kind=kind_name, arguments=values, result_type=result_type, signed_length=False))
        const id = try list_lower.append(mut state.batch, context, lowered)
        state.batch.resolved[raw_id] = id
        state.depth = state.depth - 1
        return Expression(id=id, ty=result_type)
    elif data.data == b"length":
        const input = try graph.number(state.syntax.pool, payload)
        const base = try expression(mut state, input)
        if list_types.element_type(state.batch.facts.lists, base.ty) >= 0:
            const context = list_lower.Context(input=state.syntax.pool, span=span)
            const lowered = try list_lower.access(mut state.batch, mut state.scope, context, list_lower.Access(base=base.id, owner_type=base.ty, kind=b"length", arguments=[], result_type=0, signed_length=True))
            const id = try list_lower.append(mut state.batch, context, lowered)
            state.batch.resolved[raw_id] = id
            state.depth = state.depth - 1
            return Expression(id=id, ty=0)
        if not managed(state, base.ty):
            const rejection = try problem(state, span, "P_BODY_PROFILE", "length receiver is outside the managed sequence profile")
            fail rejection
        ty = 0
        result_payload = try syntax_value.integer(mut state.batch.pool, base.id)
    elif data.data == b"slice":
        const base_id = try graph.field(state.syntax.pool, payload, "base")
        const base_raw = try graph.number(state.syntax.pool, base_id)
        const base = try expression(mut state, base_raw)
        if not sequence_type(state, base.ty):
            const rejection = try problem(state, span, "P_BODY_PROFILE", "slice receiver is outside the admitted byte and text closure")
            fail rejection
        const first_id = try graph.field(state.syntax.pool, payload, "start")
        const last_id = try graph.field(state.syntax.pool, payload, "end")
        const first = try graph.get(state.syntax.pool, first_id)
        const last = try graph.get(state.syntax.pool, last_id)
        mut start = -1
        mut end = -1
        mut start_type = 0
        mut end_type = 0
        if first.kind != 0:
            const first_raw = try graph.number(state.syntax.pool, first_id)
            const value = try expression(mut state, first_raw)
            start = value.id
            start_type = value.ty
        if last.kind != 0:
            const last_raw = try graph.number(state.syntax.pool, last_id)
            const value = try expression(mut state, last_raw)
            end = value.id
            end_type = value.ty
        if start_type != 0 or end_type != 0:
            const rejection = try problem(state, span, "E_TYPE", "operation requires an integer type")
            fail rejection
        const step_id = try graph.field(state.syntax.pool, payload, "step")
        const step = try graph.get(state.syntax.pool, step_id)
        if step.kind != 0:
            if base.ty != state.batch.facts.string_type:
                const rejection = try problem(state, span, "E_COLLECTION_METHOD", "byte strings do not support a slice step")
                fail rejection
            const rejection = try problem(state, span, "P_BODY_PROFILE", "stepped text slices are outside the admitted byte closure")
            fail rejection
        const context = list_lower.Context(input=state.syntax.pool, span=span)
        const lowered = try buffer_lower.slice(mut state.batch, mut state.scope, context, buffer_lower.Slice(base=base.id, owner_type=base.ty, start=start, end=end, string=base.ty == state.batch.facts.string_type))
        const id = try list_lower.append(mut state.batch, context, lowered)
        state.batch.resolved[raw_id] = id
        state.depth = state.depth - 1
        return Expression(id=id, ty=base.ty)
    elif data.data == b"index":
        const base_id = try graph.field(state.syntax.pool, payload, "base")
        const index_id = try graph.field(state.syntax.pool, payload, "index")
        const base_raw = try graph.number(state.syntax.pool, base_id)
        const index_raw = try graph.number(state.syntax.pool, index_id)
        const base = try expression(mut state, base_raw)
        const index = try expression(mut state, index_raw)
        const list_element = list_types.element_type(state.batch.facts.lists, base.ty)
        if list_element >= 0:
            if index.ty != 0:
                const rejection = try problem(state, span, "E_TYPE", "collection index requires an integer")
                fail rejection
            const context = list_lower.Context(input=state.syntax.pool, span=span)
            const lowered = try list_lower.access(mut state.batch, mut state.scope, context, list_lower.Access(base=base.id, owner_type=base.ty, kind=b"read", arguments=[index.id], result_type=list_element, signed_length=False))
            const id = try list_lower.append(mut state.batch, context, lowered)
            state.batch.resolved[raw_id] = id
            state.depth = state.depth - 1
            return Expression(id=id, ty=list_element)
        if not managed(state, base.ty):
            const rejection = try problem(state, span, "P_BODY_PROFILE", "indexed receiver is outside the managed sequence profile")
            fail rejection
        if index.ty != 0:
            const rejection = try problem(state, span, "E_TYPE", "operation requires an integer type")
            fail rejection
        const typed_base = try syntax_value.integer(mut state.batch.pool, base.id)
        const typed_index = try syntax_value.integer(mut state.batch.pool, index.id)
        const no = try syntax_value.boolean(mut state.batch.pool, False)
        result_payload = try syntax_value.object(mut state.batch.pool, ["base", "index", "from_end"], [typed_base, typed_index, no])
        ty = base.ty
        if base.ty == state.batch.facts.bytes_type or base.ty == state.batch.facts.lists.types.buffer.id:
            const narrow = try emission.node(mut state.batch, state.syntax.pool, span, 5, b"index", result_payload)
            result_payload = try syntax_value.integer(mut state.batch.pool, narrow)
            const id = try emission.node(mut state.batch, state.syntax.pool, span, 0, b"cast", result_payload)
            state.batch.resolved[raw_id] = id
            state.depth = state.depth - 1
            return Expression(id=id, ty=0)
    elif data.data == b"field":
        const base_id = try graph.field(state.syntax.pool, payload, "base")
        const base_raw = try graph.number(state.syntax.pool, base_id)
        const name = try graph.field(state.syntax.pool, payload, "name")
        const base_data_id = try graph.field(state.syntax.pool, state.syntax.nodes[base_raw], "data")
        const base_data = try graph.get(state.syntax.pool, base_data_id)
        if base_data.data == b"name":
            const base_name = try graph.payload(state.syntax.pool, base_data_id)
            const spelling = try graph.spelling(state.syntax.pool, state.syntax.source, base_name)
            if locals.find(state.scope, spelling) < 0:
                const variant_type = try variant_owner(mut state, base_name, state.batch.facts.expected[raw_id])
                if variant_type >= 0:
                    const variant_index = try variant_tag(state, variant_type, name)
                    const result = try variant_value(mut state, variant_type, variant_index, span, -1)
                    state.batch.resolved[raw_id] = result.id
                    state.depth = state.depth - 1
                    return result
        const base = try expression(mut state, base_raw)
        const index = try record_field(state, base.ty, name)
        const row = record_types.schema(state.batch.facts.lists.types.records, base.ty)
        const fields_id = try graph.field(state.syntax.pool, row, "fields")
        const fields = try graph.items(state.syntax.pool, fields_id)
        const type_id = try graph.field(state.syntax.pool, fields[index], "ty")
        ty = try graph.number(state.syntax.pool, type_id)
        const typed_base = try syntax_value.integer(mut state.batch.pool, base.id)
        const typed_index = try syntax_value.integer(mut state.batch.pool, index)
        result_payload = try syntax_value.object(mut state.batch.pool, ["base", "index"], [typed_base, typed_index])
    elif data.data == b"name" or data.data == b"synthetic_name":
        mut name = b""
        if data.data == b"synthetic_name":
            const value = try graph.get(state.syntax.pool, payload)
            name = value.data
        else:
            name = try graph.spelling(state.syntax.pool, state.syntax.source, payload)
        const slot = locals.find(state.scope, name)
        if slot < 0:
            mut candidates: bytes[] = []
            for active_slot in state.scope.active:
                candidates.append(state.scope.locals[active_slot].name)
            const clause = try suggestions.clause(candidates, name)
            const rejection = try problem(state, payload, "E_UNKNOWN_NAME", "name is not defined in this scope" + clause)
            fail rejection
        mut read_span = payload
        if data.data == b"synthetic_name":
            read_span = span
        _ = try require_readable(mut state, slot, read_span)
        const pending = try variants.requires_handling(state.syntax.pool, state.batch.facts.lists.types.records.rows, state.scope.locals[slot].ty)
        if pending:
            _ = try obligations.consume(state.syntax.pool, mut state.scope, slot, read_span, data.data == b"synthetic_name", mut state.problems)
        state.scope.locals[slot].usage.reads = state.scope.locals[slot].usage.reads + 1
        ty = state.scope.locals[slot].ty
        result_payload = try syntax_value.integer(mut state.batch.pool, slot)
        const id = try emission.node(mut state.batch, state.syntax.pool, span, ty, b"local", result_payload)
        state.batch.resolved[raw_id] = id
        state.depth = state.depth - 1
        return Expression(id=id, ty=ty)
    elif data.data == b"mut_argument":
        const target = try graph.number(state.syntax.pool, payload)
        const checked = try expression(mut state, target)
        const child_node = state.batch.nodes[checked.id]
        const child_data_id = try graph.field(state.batch.pool, child_node, "data")
        const child_data = try graph.get(state.batch.pool, child_data_id)
        const child_payload = try graph.payload(state.batch.pool, child_data_id)
        const id = try emission.node(mut state.batch, state.syntax.pool, span, checked.ty, child_data.data, child_payload)
        state.batch.resolved[raw_id] = id
        state.depth = state.depth - 1
        return Expression(id=id, ty=checked.ty)
    elif data.data == b"unary":
        const op_id = try graph.field(state.syntax.pool, payload, "op")
        const op = try graph.get(state.syntax.pool, op_id)
        const operand_id = try graph.field(state.syntax.pool, payload, "operand")
        const operand_raw = try graph.number(state.syntax.pool, operand_id)
        const operator_span = try graph.field(state.syntax.pool, payload, "op_span")
        if op.data != b"neg" and op.data != b"not":
            const rejection = try problem(state, span, "P_BODY_PROFILE", "unary operation is outside the B1 scalar profile")
            fail rejection
        if op.data == b"neg" and operand_raw >= 0 and operand_raw < len(state.syntax.nodes):
            const operand_node = state.syntax.nodes[operand_raw]
            const operand_data_id = try graph.field(state.syntax.pool, operand_node, "data")
            const operand_data = try graph.get(state.syntax.pool, operand_data_id)
            if operand_data.data == b"integer":
                const literal_span = try graph.payload(state.syntax.pool, operand_data_id)
                const text = try graph.spelling(state.syntax.pool, state.syntax.source, literal_span)
                const location = try problem(state, literal_span, "", "")
                const negative = try scalars.integer(text, True, location.start, location.end)
                if negative == -9223372036854775807 - 1 or state.batch.facts.expected[raw_id] == 0:
                    const minimum_payload = try syntax_value.integer(mut state.batch.pool, negative)
                    const minimum_id = try emission.node(mut state.batch, state.syntax.pool, span, 0, b"integer", minimum_payload)
                    state.batch.resolved[raw_id] = minimum_id
                    state.depth = state.depth - 1
                    return Expression(id=minimum_id, ty=0)
        const operand = try expression(mut state, operand_raw)
        ty = operand.ty
        if op.data == b"not":
            _ = try require(state, operand.ty, 1, operator_span)
            ty = 1
        elif operand.ty != 0:
            const rejection = try problem(state, operator_span, "E_TYPE", "operation requires an integer type")
            fail rejection
        const typed_op = try syntax_value.enumeration(mut state.batch.pool, op.data)
        const typed_operand = try syntax_value.integer(mut state.batch.pool, operand.id)
        const typed_span = try graph.clone(mut state.batch.pool, state.syntax.pool, operator_span, 0)
        result_payload = try syntax_value.object(mut state.batch.pool, ["op", "operand", "op_span"], [typed_op, typed_operand, typed_span])
    elif data.data == b"call":
        mut call_name = try graph.field(state.syntax.pool, payload, "name")
        const type_arguments_id = try graph.field(state.syntax.pool, payload, "type_arguments")
        const type_arguments = try graph.items(state.syntax.pool, type_arguments_id)
        mut explicit_count = len(type_arguments)
        for application in state.batch.facts.applications:
            const application_span = try graph.field(state.syntax.pool, application, "span")
            const application_text = try graph.spelling(state.syntax.pool, state.syntax.source, application_span)
            const call_text = try graph.spelling(state.syntax.pool, state.syntax.source, call_name)
            if application_text == call_text:
                call_name = try graph.field(state.syntax.pool, application, "name")
                const arguments_id = try graph.field(state.syntax.pool, application, "arguments")
                const application_arguments = try graph.items(state.syntax.pool, arguments_id)
                explicit_count = len(application_arguments)
                break
        const owner = try graph.field(state.syntax.pool, payload, "owner")
        const raw_callee = try graph.spelling(state.syntax.pool, state.syntax.source, call_name)
        const owner_value = try graph.get(state.syntax.pool, owner)
        if owner_value.kind != 0:
            const owner_name = try graph.spelling(state.syntax.pool, state.syntax.source, owner)
            const owner_slot = locals.find(state.scope, owner_name)
            if owner_slot >= 0 and list_types.element_type(state.batch.facts.lists, state.scope.locals[owner_slot].ty) >= 0:
                const result = try list_method(mut state, payload, span, owner_slot)
                state.batch.resolved[raw_id] = result.id
                state.depth = state.depth - 1
                return result
            if owner_slot >= 0 and sequence_type(state, state.scope.locals[owner_slot].ty) and raw_callee != b"parse_int":
                const labels_id = try graph.field(state.syntax.pool, payload, "argument_names")
                const labels = try graph.items(state.syntax.pool, labels_id)
                if len(labels) != 0:
                    const rejection = try problem(state, call_name, "E_CALL_ARGUMENT", "keyword arguments require a declared function or record constructor")
                    fail rejection
                if explicit_count != 0:
                    const rejection = try problem(state, span, "P_BODY_PROFILE", "specialized sequence methods are outside the body profile")
                    fail rejection
                const arguments_id = try graph.field(state.syntax.pool, payload, "arguments")
                const arguments = try graph.items(state.syntax.pool, arguments_id)
                const result = try sequence_method(mut state, span, call_name, owner, owner_slot, Expression(id=-1, ty=state.scope.locals[owner_slot].ty), raw_callee, arguments)
                state.batch.resolved[raw_id] = result.id
                state.depth = state.depth - 1
                return result
            if owner_slot >= 0 and raw_callee == b"parse_int" and (state.scope.locals[owner_slot].ty == state.batch.facts.string_type or state.scope.locals[owner_slot].ty == state.batch.facts.bytes_type):
                const labels_id = try graph.field(state.syntax.pool, payload, "argument_names")
                const labels = try graph.items(state.syntax.pool, labels_id)
                if len(labels) != 0:
                    const rejection = try problem(state, call_name, "E_CALL_ARGUMENT", "keyword arguments require a declared function or record constructor")
                    fail rejection
                if explicit_count != 0:
                    const rejection = try problem(state, span, "P_BODY_PROFILE", "managed parse type arguments are outside the body profile")
                    fail rejection
                const arguments_id = try graph.field(state.syntax.pool, payload, "arguments")
                const arguments = try graph.items(state.syntax.pool, arguments_id)
                const base = Expression(id=-1, ty=state.scope.locals[owner_slot].ty)
                const result = try parse_integer_access(mut state, span, base, owner_slot, owner, len(arguments))
                state.batch.resolved[raw_id] = result.id
                state.depth = state.depth - 1
                return result
            if owner_slot >= 0:
                const rejection = try problem(state, span, "P_BODY_PROFILE", "non-list managed methods are outside the admitted body closure")
                fail rejection
        if owner_value.kind != 0 and explicit_count == 0:
            const owner_name = try graph.spelling(state.syntax.pool, state.syntax.source, owner)
            if locals.find(state.scope, owner_name) < 0:
                const variant_type = try variant_owner(mut state, owner, state.batch.facts.expected[raw_id])
                if variant_type >= 0:
                    const shape = try variants.shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, variant_type)
                    const case_index = variants.case_tag(shape, raw_callee)
                    if case_index >= 0:
                        if shape.cases[case_index].fielded:
                            const arguments_id = try graph.field(state.syntax.pool, payload, "arguments")
                            const arguments = try graph.items(state.syntax.pool, arguments_id)
                            mut raw_arguments: int[] = []
                            for argument in arguments:
                                const value = try graph.number(state.syntax.pool, argument)
                                raw_arguments.append(value)
                            const labels_id = try graph.field(state.syntax.pool, payload, "argument_names")
                            const labels = try graph.items(state.syntax.pool, labels_id)
                            const result = try fielded_variant(mut state, variant_type, case_index, span, call_name, raw_arguments, labels)
                            state.batch.resolved[raw_id] = result.id
                            state.depth = state.depth - 1
                            return result
                        const labels_id = try graph.field(state.syntax.pool, payload, "argument_names")
                        const labels = try graph.items(state.syntax.pool, labels_id)
                        if len(labels) != 0:
                            const rejection = try problem(state, call_name, "E_CALL_ARGUMENT", "keyword arguments require a declared function or record constructor")
                            fail rejection
                        const arguments_id = try graph.field(state.syntax.pool, payload, "arguments")
                        const arguments = try graph.items(state.syntax.pool, arguments_id)
                        if len(arguments) != 1:
                            const rejection = try problem(state, call_name, "E_ARITY", "variant construction takes exactly one payload; an empty case is written without parentheses")
                            fail rejection
                        const argument = try graph.number(state.syntax.pool, arguments[0])
                        const result = try variant_value(mut state, variant_type, case_index, span, argument)
                        state.batch.resolved[raw_id] = result.id
                        state.depth = state.depth - 1
                        return result
        mut nominal = -1
        if len(state.syntax.modules) == 0:
            nominal = try nominal_key(mut state, raw_callee, call_name)
        else:
            const type_call = try record_names.is_type(state.syntax.pool, state.syntax.source, state.syntax.modules, record_names.Request(span=span, owner=owner, name=call_name))
            if type_call:
                const resolution = try record_names.resolve(mut state.problems, state.syntax.pool, state.syntax.source, state.syntax.modules, record_names.Request(span=span, owner=owner, name=call_name))
                nominal = try nominal_key(mut state, resolution.key, call_name)
                if resolution.from >= 0 and resolution.import_index >= 0:
                    state.syntax.usage[resolution.from][resolution.import_index] = True
        if record_types.schema(state.batch.facts.lists.types.records, nominal) >= 0:
            if explicit_count != 0:
                const rejection = try problem(state, span, "E_GENERIC_ARITY", "explicit type argument count does not match generic parameters")
                fail rejection
            const record_catalog = state.batch.facts.lists.types.records
            const declaration = record_catalog.declarations[record_catalog.by_type[nominal]]
            const fields_id = try graph.field(state.syntax.pool, declaration, "fields")
            const fields = try graph.items(state.syntax.pool, fields_id)
            const arguments_id = try graph.field(state.syntax.pool, payload, "arguments")
            const arguments = try graph.items(state.syntax.pool, arguments_id)
            mut raw_arguments: int[] = []
            for argument in arguments:
                const value = try graph.number(state.syntax.pool, argument)
                raw_arguments.append(value)
            const labels_id = try graph.field(state.syntax.pool, payload, "argument_names")
            const labels = try graph.items(state.syntax.pool, labels_id)
            const initializers = try record_construct.bind(state.syntax.pool, state.syntax.nodes, fields, record_construct.Input(source=state.syntax.source, name=call_name, span=span, arguments=raw_arguments, argument_names=labels), mut state.problems)
            const initialized = try record_initializers(mut state, nominal, span, initializers)
            const id = try emission.node(mut state.batch, state.syntax.pool, span, nominal, b"record", initialized)
            state.batch.resolved[raw_id] = id
            state.depth = state.depth - 1
            return Expression(id=id, ty=nominal)
        if nominal >= 0:
            const rejection = try problem(state, span, "P_BODY_PROFILE", "nonrecord nominal construction is outside the record body profile")
            fail rejection
        if owner_value.kind == 0 and prelude_call(raw_callee):
            const expected_name = try names.qualified(state.syntax.pool, state.syntax.source, state.syntax.modules, call_name)
            mut declared = False
            for function in state.syntax.functions:
                const name_span = try graph.field(state.syntax.pool, function, "name")
                const candidate = try names.qualified(state.syntax.pool, state.syntax.source, state.syntax.modules, name_span)
                if candidate == expected_name:
                    declared = True
            # Native byte conversion probes unqualified function keys. Project
            # functions have module-qualified keys and do not shadow this probe.
            if len(state.syntax.modules) != 0 and (raw_callee == b"bytes" or raw_callee == b"byte_buffer"):
                declared = False
            if not declared:
                if (raw_callee == b"bytes" and state.batch.facts.bytes_type >= 0) or raw_callee == b"byte_buffer":
                    if locals.find(state.scope, raw_callee) >= 0 or explicit_count != 0:
                        const rejection = try problem(state, span, "P_BODY_PROFILE", "shadowed or specialized byte conversion is outside the body profile")
                        fail rejection
                    const labels_id = try graph.field(state.syntax.pool, payload, "argument_names")
                    const labels = try graph.items(state.syntax.pool, labels_id)
                    if len(labels) != 0:
                        const rejection = try problem(state, call_name, "E_CALL_ARGUMENT", "keyword arguments require a declared function or record constructor")
                        fail rejection
                    const arguments_id = try graph.field(state.syntax.pool, payload, "arguments")
                    const arguments = try graph.items(state.syntax.pool, arguments_id)
                    if len(arguments) != 1:
                        const rejection = try problem(state, span, "E_ARITY", "byte conversions require one argument")
                        fail rejection
                    const argument_raw = try graph.number(state.syntax.pool, arguments[0])
                    const raw_data_id = try graph.field(state.syntax.pool, state.syntax.nodes[argument_raw], "data")
                    const raw_data = try graph.get(state.syntax.pool, raw_data_id)
                    if raw_data.data == b"list_literal":
                        const items = try graph.items(state.syntax.pool, raw_data.children[0])
                        if len(items) == 0:
                            const literal_span = try graph.field(state.syntax.pool, state.syntax.nodes[argument_raw], "span")
                            const hinted = try list_types.intern(mut state.batch.facts.lists, state.syntax.pool, list_types.Recipe(id=0, element=0, span=literal_span), [state.batch.facts.string_type, state.batch.facts.bytes_type, state.batch.facts.lists.types.buffer.id])
                            state.batch.facts.expected[argument_raw] = hinted
                    const argument = try expression(mut state, argument_raw)
                    const integer_list = list_types.element_type(state.batch.facts.lists, argument.ty) == 0
                    mut result_type = state.batch.facts.bytes_type
                    if raw_callee == b"byte_buffer":
                        if not integer_list:
                            const rejection = try problem(state, span, "E_BYTES_CONVERSION", "byte_buffer() requires an int[] argument")
                            fail rejection
                        result_type = try list_types.buffer_intern(mut state.batch.facts.lists, mut state.syntax.pool, span)
                    elif not integer_list and (argument.ty < 19 or argument.ty != state.batch.facts.lists.types.buffer.id):
                        const rejection = try problem(state, span, "E_BYTES_CONVERSION", "bytes() requires an int[] or byte_buffer argument")
                        fail rejection
                    const operand = try syntax_value.integer(mut state.batch.pool, argument.id)
                    const id = try emission.node(mut state.batch, state.syntax.pool, span, result_type, b"cast", operand)
                    state.batch.resolved[raw_id] = id
                    state.depth = state.depth - 1
                    return Expression(id=id, ty=result_type)
                if raw_callee == b"parse_int":
                    if locals.find(state.scope, raw_callee) >= 0 or explicit_count != 0:
                        const rejection = try problem(state, span, "P_BODY_PROFILE", "shadowed or specialized numeric parsing is outside the body profile")
                        fail rejection
                    const labels_id = try graph.field(state.syntax.pool, payload, "argument_names")
                    const labels = try graph.items(state.syntax.pool, labels_id)
                    if len(labels) != 0:
                        const rejection = try problem(state, call_name, "E_CALL_ARGUMENT", "keyword arguments require a declared function or record constructor")
                        fail rejection
                    const arguments_id = try graph.field(state.syntax.pool, payload, "arguments")
                    const arguments = try graph.items(state.syntax.pool, arguments_id)
                    if len(arguments) != 1:
                        const rejection = try problem(state, span, "E_ARITY", "numeric conversions require one argument")
                        fail rejection
                    const argument_raw = try graph.number(state.syntax.pool, arguments[0])
                    const argument = try expression(mut state, argument_raw)
                    if argument.ty != state.batch.facts.string_type:
                        const rejection = try problem(state, span, "E_TYPE", "parse_int and parse_float require a str argument")
                        fail rejection
                    const result = try parse_integer_access(mut state, span, argument, -1, span, 0)
                    state.batch.resolved[raw_id] = result.id
                    state.depth = state.depth - 1
                    return result
                if raw_callee == b"Some" or raw_callee == b"Ok" or raw_callee == b"Err":
                    const labels_id = try graph.field(state.syntax.pool, payload, "argument_names")
                    const labels = try graph.items(state.syntax.pool, labels_id)
                    if len(labels) != 0:
                        const rejection = try problem(state, call_name, "E_CALL_ARGUMENT", "keyword arguments require a declared function or record constructor")
                        fail rejection
                    const arguments_id = try graph.field(state.syntax.pool, payload, "arguments")
                    const arguments = try graph.items(state.syntax.pool, arguments_id)
                    if len(arguments) != 1:
                        mut message = "Ok and Err require one payload"
                        if raw_callee == b"Some":
                            message = "Some requires one payload"
                        const rejection = try problem(state, span, "E_ARITY", message)
                        fail rejection
                    const expected = state.batch.facts.expected[raw_id]
                    mut variant_index = -1
                    mut expected_payload = -1
                    if raw_callee == b"Some":
                        const shape = try variants.option_shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, expected)
                        if not shape.valid:
                            mut code = "E_TYPE"
                            if expected < 0:
                                code = "E_OPTION_INFERENCE"
                            const rejection = try problem(state, span, code, "Some requires an expected Option type")
                            fail rejection
                        variant_index = shape.some
                        expected_payload = shape.element
                    else:
                        const shape = try variants.result_shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, expected)
                        if not shape.valid:
                            mut code = "E_TYPE"
                            mut message = "Ok and Err require an expected Result type"
                            if expected < 0:
                                code = "E_RESULT_INFERENCE"
                                message = "Ok and Err require a Result type from a binding, return, argument, or field"
                            const rejection = try problem(state, span, code, message)
                            fail rejection
                        variant_index = shape.ok
                        expected_payload = shape.success
                        if raw_callee == b"Err":
                            variant_index = shape.err
                            expected_payload = shape.failure
                    const argument = try graph.number(state.syntax.pool, arguments[0])
                    const checked = try expression_expected(mut state, argument, expected_payload)
                    _ = try require(state, checked.ty, expected_payload, span)
                    const tag = try syntax_value.integer(mut state.batch.pool, variant_index)
                    const value = try syntax_value.integer(mut state.batch.pool, checked.id)
                    const wrapped = try syntax_value.object(mut state.batch.pool, ["tag", "value"], [tag, value])
                    const id = try emission.node(mut state.batch, state.syntax.pool, span, expected, b"variant", wrapped)
                    state.batch.resolved[raw_id] = id
                    state.depth = state.depth - 1
                    return Expression(id=id, ty=expected)
                if raw_callee == b"int" or raw_callee == b"i64":
                    const arguments_id = try graph.field(state.syntax.pool, payload, "arguments")
                    const inputs = try graph.items(state.syntax.pool, arguments_id)
                    const names_id = try graph.field(state.syntax.pool, payload, "argument_names")
                    const labels = try graph.items(state.syntax.pool, names_id)
                    const types_id = try graph.field(state.syntax.pool, payload, "type_arguments")
                    const explicit_types = try graph.items(state.syntax.pool, types_id)
                    if len(inputs) != 1 or len(labels) != 0 or len(explicit_types) != 0:
                        const rejection = try problem(state, span, "P_BODY_PROFILE", "integer conversion requires one plain admitted integer argument")
                        fail rejection
                    const argument_raw = try graph.number(state.syntax.pool, inputs[0])
                    const argument = try expression(mut state, argument_raw)
                    if managed(state, argument.ty):
                        const rejection = try problem(state, span, "P_BODY_PROFILE", "managed integer conversion is outside the admitted body closure")
                        fail rejection
                    if argument.ty != 0:
                        const rejection = try problem(state, span, "E_TYPE", "operation requires an integer type")
                        fail rejection
                    const operand = try syntax_value.integer(mut state.batch.pool, argument.id)
                    const id = try emission.node(mut state.batch, state.syntax.pool, span, 0, b"cast", operand)
                    state.batch.resolved[raw_id] = id
                    state.depth = state.depth - 1
                    return Expression(id=id, ty=0)
                const rejection = try problem(state, span, "P_BODY_PROFILE", "prelude call is outside the B1 ordinary-call profile")
                fail rejection
        const resolution = try names.target(mut state.problems, state.syntax.pool, state.syntax.source, state.syntax.modules, span, owner, call_name)
        const spelling = resolution.key
        if resolution.from >= 0 and resolution.import_index >= 0:
            state.syntax.usage[resolution.from][resolution.import_index] = True
        mut target = -1
        mut target_index = 0
        for function in state.syntax.functions:
            const name_span = try graph.field(state.syntax.pool, function, "name")
            const candidate = try names.qualified(state.syntax.pool, state.syntax.source, state.syntax.modules, name_span)
            if candidate == spelling:
                target = target_index
                break
            target_index = target_index + 1
        if target < 0:
            const raw_spelling = try graph.spelling(state.syntax.pool, state.syntax.source, call_name)
            for builtin in [b"len", b"range", b"int", b"i64", b"bool", b"str", b"bytes", b"byte_buffer", b"list", b"set", b"dict", b"tuple", b"print", b"sorted", b"min", b"max", b"abs", b"sum", b"all", b"any", b"enumerate", b"reversed", b"zip", b"Some", b"Ok", b"Err"]:
                if raw_spelling == builtin:
                    const rejection = try problem(state, span, "P_BODY_PROFILE", "prelude call is outside the B1 ordinary-call profile")
                    fail rejection
            mut candidates: bytes[] = []
            for function in state.syntax.functions:
                const name_span = try graph.field(state.syntax.pool, function, "name")
                const candidate = try names.qualified(state.syntax.pool, state.syntax.source, state.syntax.modules, name_span)
                candidates.append(candidate)
            const clause = try suggestions.clause(candidates, spelling)
            const rejection = try problem(state, call_name, "E_UNKNOWN_FUNCTION", "no function has this qualified name" + clause)
            fail rejection
        const target_signature = try graph.field(state.syntax.pool, state.syntax.functions[target], "signature")
        if explicit_count != 0:
            const rejection = try problem(state, span, "E_GENERIC_ARITY", "explicit type argument count does not match generic parameters")
            fail rejection
        const mutation_positions_id = try graph.field(state.syntax.pool, target_signature, "mut_positions")
        const mutation_positions = try graph.items(state.syntax.pool, mutation_positions_id)
        const keyword_boundary_id = try graph.field(state.syntax.pool, target_signature, "keyword_only_from")
        const keyword_boundary = try graph.get(state.syntax.pool, keyword_boundary_id)
        const parameter_list = try graph.field(state.syntax.pool, target_signature, "parameters")
        const parameters = try graph.items(state.syntax.pool, parameter_list)
        const argument_list = try graph.field(state.syntax.pool, payload, "arguments")
        const arguments = try graph.items(state.syntax.pool, argument_list)
        const argument_name_list = try graph.field(state.syntax.pool, payload, "argument_names")
        const argument_names = try graph.items(state.syntax.pool, argument_name_list)
        if len(arguments) > len(parameters):
            const rejection = try problem(state, call_name, "E_ARITY", "too many arguments for this function: expected " + str(len(parameters)) + ", given " + str(len(arguments)))
            fail rejection
        mut slots: int[] = []
        mut raw_slots: int[] = []
        for parameter in parameters:
            slots.append(-1)
            raw_slots.append(-1)
        mut order: int[] = []
        mut supplied = 0
        mut positional = 0
        for argument in arguments:
            mut position = positional
            mut is_named = False
            if len(argument_names) != 0:
                if len(argument_names) != len(arguments):
                    fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="argument name count mismatch")
                const keyword = try graph.get(state.syntax.pool, argument_names[supplied])
                if keyword.kind != 0:
                    is_named = True
                    const keyword_text = try graph.spelling(state.syntax.pool, state.syntax.source, argument_names[supplied])
                    position = -1
                    mut parameter_index = 0
                    for parameter in parameters:
                        const parameter_name = try graph.field(state.syntax.pool, parameter, "name")
                        const parameter_text = try graph.spelling(state.syntax.pool, state.syntax.source, parameter_name)
                        if parameter_text == keyword_text:
                            position = parameter_index
                            break
                        parameter_index = parameter_index + 1
                    if position < 0:
                        const rejection = try problem(state, argument_names[supplied], "E_CALL_ARGUMENT", "keyword names no parameter of this function")
                        fail rejection
            if not is_named and keyword_boundary.kind != 0 and position >= keyword_boundary.integer:
                const diagnostic = try call_repairs.keyword_only(state.syntax.pool, state.syntax.source, state.syntax.nodes, payload, parameters, keyword_boundary.integer, supplied)
                state.problems.append(diagnostic)
                fail diagnostic.problem
            if slots[position] != -1:
                const rejection = try problem(state, call_name, "E_CALL_ARGUMENT", "parameter receives more than one argument")
                fail rejection
            const argument_raw = try graph.number(state.syntax.pool, argument)
            const type_span = try graph.field(state.syntax.pool, parameters[position], "ty")
            const expected = try type_at(mut state, type_span)
            const checked = try expression_expected(mut state, argument_raw, expected)
            const argument_span = try graph.field(state.syntax.pool, state.syntax.nodes[argument_raw], "span")
            _ = try require(state, checked.ty, expected, argument_span)
            slots[position] = checked.id
            raw_slots[position] = argument_raw
            order.append(position)
            supplied = supplied + 1
            if not is_named:
                positional = positional + 1
        for position in range(len(parameters)):
            if slots[position] == -1:
                const default_id = try graph.field(state.syntax.pool, parameters[position], "default_value")
                const default_value = try graph.get(state.syntax.pool, default_id)
                if default_value.kind == 0:
                    const rejection = try problem(state, call_name, "E_ARITY", "missing required argument: expected " + str(len(parameters)) + ", given " + str(len(arguments)))
                    fail rejection
                const default_raw = try graph.number(state.syntax.pool, default_id)
                const checked = try expression(mut state, default_raw)
                slots[position] = checked.id
                raw_slots[position] = default_raw
                order.append(position)
        mut mutation_indices: int[] = []
        for position_id in mutation_positions:
            const position = try graph.number(state.syntax.pool, position_id)
            mutation_indices.append(position)
        const mutation_context = mutation_places.Context(pool=state.syntax.pool, source=state.syntax.source, nodes=state.syntax.nodes, typed_pool=state.batch.pool, typed_nodes=state.batch.nodes, resolved=state.batch.resolved)
        const mutation_diagnostics = try mut_markers.check_places(mutation_context, mut state.scope, mut_markers.Request(call_name=call_name, arguments=raw_slots, mut_positions=mutation_indices))
        for diagnostic in mutation_diagnostics:
            state.problems.append(diagnostic)
        if len(arguments) == len(parameters) and len(argument_names) == 0:
            order = []
        const result_span = try graph.field(state.syntax.pool, target_signature, "return_type")
        ty = try type_at(mut state, result_span)
        const failure_span = try graph.field(state.syntax.pool, target_signature, "failure_type")
        const failure_value = try graph.get(state.syntax.pool, failure_span)
        if failure_value.kind != 0:
            const failure_type = try type_at(mut state, failure_span)
            const declaration = try graph.field(state.syntax.pool, state.syntax.functions[target], "name")
            ty = try list_types.union_intern(mut state.batch.facts.lists, mut state.syntax.pool, ty, failure_type, declaration, True)
        const argument_values = try emission.ids(mut state.batch, slots)
        const evaluation_order = try emission.ids(mut state.batch, order)
        const evaluation = try syntax_value.absent(mut state.batch.pool)
        const function = try syntax_value.integer(mut state.batch.pool, target)
        result_payload = try syntax_value.object(mut state.batch.pool, ["evaluation_order", "evaluation", "function", "arguments"], [evaluation_order, evaluation, function, argument_values])
    elif data.data == b"variant":
        const type_span = try graph.field(state.syntax.pool, payload, "ty")
        const name = try graph.field(state.syntax.pool, payload, "name")
        const variant_type = try variant_owner(mut state, type_span, state.batch.facts.expected[raw_id])
        if variant_type < 0:
            const rejection = try problem(state, type_span, "E_TYPE", "operation requires an enum or tagged union")
            fail rejection
        const variant_index = try variant_tag(state, variant_type, name)
        const fielded_id = try graph.field(state.syntax.pool, payload, "fielded")
        const fielded = try graph.get(state.syntax.pool, fielded_id)
        mut result = Expression(id=-1, ty=variant_type)
        if fielded.integer != 0:
            const arguments_id = try graph.field(state.syntax.pool, payload, "values")
            const arguments = try graph.items(state.syntax.pool, arguments_id)
            mut raw_arguments: int[] = []
            for argument in arguments:
                const value = try graph.number(state.syntax.pool, argument)
                raw_arguments.append(value)
            const labels_id = try graph.field(state.syntax.pool, payload, "value_names")
            const labels = try graph.items(state.syntax.pool, labels_id)
            result = try fielded_variant(mut state, variant_type, variant_index, span, name, raw_arguments, labels)
        else:
            const value_id = try graph.field(state.syntax.pool, payload, "value")
            const value = try graph.get(state.syntax.pool, value_id)
            mut value_raw = -1
            if value.kind != 0:
                value_raw = try graph.number(state.syntax.pool, value_id)
            result = try variant_value(mut state, variant_type, variant_index, span, value_raw)
        state.batch.resolved[raw_id] = result.id
        state.depth = state.depth - 1
        return result
    elif data.data == b"match_expression":
        const arms_id = try graph.field(state.syntax.pool, payload, "arms")
        const arms = try graph.items(state.syntax.pool, arms_id)
        for arm in arms:
            const body_id = try graph.field(state.syntax.pool, arm, "body")
            const body = try graph.number(state.syntax.pool, body_id)
            const yields = try yields_every_path(state, body, 0)
            if not yields:
                const name = try graph.field(state.syntax.pool, arm, "name")
                const rejection = try problem(state, name, "E_MATCH_YIELD", "every continuing path of a match expression arm must end with yield")
                fail rejection
        const saved = state.control.values
        const expected = state.batch.facts.expected[raw_id]
        mut initial_type = expected
        if initial_type < 0:
            initial_type = 15
        const slot = try locals.add(mut state.scope, b"", span, initial_type, True, b"local")
        state.scope.active = state.scope.active[:len(state.scope.active) - 1]
        state.scope.locals[slot].initialized = False
        state.scope.locals[slot].usage.temporary = True
        state.scope.locals[slot].usage.reads = 1
        state.control.values = Values(yield_type=expected, yield_slot=slot, depth=0, temporaries=[])
        const body = try match_payload(mut state, payload, span)
        const result_type = state.control.values.yield_type
        if result_type < 0:
            const rejection = try problem(state, span, "E_MATCH_YIELD", "match expression requires at least one yielded value")
            fail rejection
        const slot_value = try syntax_value.integer(mut state.batch.pool, slot)
        const local = try emission.node(mut state.batch, state.syntax.pool, span, result_type, b"local", slot_value)
        state.scope.locals[slot].usage.transfer_available = False
        state.control.values = saved
        const body_value = try syntax_value.integer(mut state.batch.pool, body.id)
        const local_value = try syntax_value.integer(mut state.batch.pool, local)
        result_payload = try syntax_value.object(mut state.batch.pool, ["body", "value"], [body_value, local_value])
        const id = try emission.node(mut state.batch, state.syntax.pool, span, result_type, b"block_value", result_payload)
        state.batch.resolved[raw_id] = id
        state.depth = state.depth - 1
        return Expression(id=id, ty=result_type)
    elif data.data == b"propagate":
        const operand = try graph.number(state.syntax.pool, payload)
        const value = try expression(mut state, operand)
        const input_result = try variants.result_shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, value.ty)
        if input_result.valid:
            const output_result = try variants.result_shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, state.return_type)
            if not output_result.valid:
                const rejection = try problem(state, span, "E_TRY_RETURN", "try requires a function returning a declared result type")
                fail rejection
            if input_result.failure != output_result.failure:
                const wrapper = try error_case(state, output_result.failure, input_result.failure)
                if wrapper < 0:
                    _ = try require(state, input_result.failure, output_result.failure, span)
            ty = input_result.success
        else:
            const input_option = try variants.option_shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, value.ty)
            if not input_option.valid:
                const rejection = try problem(state, span, "E_TRY_TYPE", "try requires a Result or optional value")
                fail rejection
            const output_option = try variants.option_shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, state.return_type)
            if not output_option.valid:
                const rejection = try problem(state, span, "E_TRY_RETURN", "optional try requires an optional return type")
                fail rejection
            ty = input_option.element
        _ = try obligations.handled(state.syntax.pool, state.batch.facts.lists.types.records.rows, state.scope, 0, span, mut state.problems)
        for position in range(len(state.control.values.temporaries) - 1):
            const pending = try variants.requires_handling(state.syntax.pool, state.batch.facts.lists.types.records.rows, state.control.values.temporaries[position])
            if pending:
                const rejection = try problem(state, span, "E_RESULT_PROPAGATION", "propagation could drop a pending result temporary; handle or transfer it before this expression")
                fail rejection
        const checked_value = try syntax_value.integer(mut state.batch.pool, value.id)
        const output = try syntax_value.integer(mut state.batch.pool, state.return_type)
        result_payload = try syntax_value.object(mut state.batch.pool, ["value", "output"], [checked_value, output])
    elif data.data == b"binary":
        const op_id = try graph.field(state.syntax.pool, payload, "op")
        const op = try graph.get(state.syntax.pool, op_id)
        const left_id = try graph.field(state.syntax.pool, payload, "left")
        const right_id = try graph.field(state.syntax.pool, payload, "right")
        const left_raw = try graph.number(state.syntax.pool, left_id)
        const right_raw = try graph.number(state.syntax.pool, right_id)
        const operator_span = try graph.field(state.syntax.pool, payload, "op_span")
        const chained_id = try graph.field(state.syntax.pool, payload, "chained")
        const chained = try graph.get(state.syntax.pool, chained_id)
        if chained.integer != 0 or op.data == b"python_div" or (len(op.data) >= 3 and op.data[:3] == b"f64"):
            const rejection = try problem(state, span, "P_BODY_PROFILE", "binary operation is outside the B1 scalar profile")
            fail rejection
        if state.batch.facts.expected[raw_id] == 0:
            state.batch.facts.expected[left_raw] = 0
            state.batch.facts.expected[right_raw] = 0
        const left = try expression(mut state, left_raw)
        const pending_checkpoint = try pending_flow.snapshot(state.scope, len(state.scope.locals))
        const right = try expression(mut state, right_raw)
        if op.data == b"logical_and" or op.data == b"logical_or":
            const difference = try pending_flow.mismatch(state.scope, pending_checkpoint)
            const right_span = try graph.field(state.syntax.pool, state.syntax.nodes[right_raw], "span")
            _ = try obligations.consistent(state.syntax.pool, state.scope, difference, right_span, False, mut state.problems)
        if op.data == b"mul" and ((managed(state, left.ty) and list_types.element_type(state.batch.facts.lists, left.ty) < 0 and right.ty == 0) or (left.ty == 0 and managed(state, right.ty) and list_types.element_type(state.batch.facts.lists, right.ty) < 0)):
            const rejection = try problem(state, span, "P_BODY_PROFILE", "text repetition is outside the admitted list body closure")
            fail rejection
        if op.data == b"mul" and ((list_types.element_type(state.batch.facts.lists, left.ty) >= 0 and right.ty == 0) or (left.ty == 0 and list_types.element_type(state.batch.facts.lists, right.ty) >= 0)):
            mut sequence = left
            mut count = right
            mut count_first = False
            if left.ty == 0:
                sequence = right
                count = left
                count_first = True
            const lowered = try list_repeat.build(mut state.batch, mut state.scope, list_lower.Context(input=state.syntax.pool, span=span), list_repeat.Input(sequence=sequence.id, count=count.id, ty=sequence.ty, count_first=count_first, loop_id=state.control.next))
            state.control.next = state.control.next + 1
            const id = try list_lower.append(mut state.batch, list_lower.Context(input=state.syntax.pool, span=span), lowered)
            state.batch.resolved[raw_id] = id
            state.depth = state.depth - 1
            return Expression(id=id, ty=sequence.ty)
        if managed(state, left.ty):
            const spelling = try graph.spelling(state.syntax.pool, state.syntax.source, operator_span)
            mut builtin = ""
            mut operator = ""
            if spelling == b"|":
                builtin = "bit_or"
                operator = "|"
            elif spelling == b"&":
                builtin = "bit_and"
                operator = "&"
            elif spelling == b"^":
                builtin = "bit_xor"
                operator = "^"
            if len(builtin) != 0:
                const rejection = try problem(state, operator_span, "E_SET_OPERATOR", "`" + operator + "` combines two sets or two integers (`" + builtin + "(a, b)`)")
                fail rejection
        _ = try require(state, right.ty, left.ty, operator_span)
        if op.data == b"eq" or op.data == b"ne":
            const supported = try record_types.equality(state.syntax.pool, state.batch.facts.lists.types.records, state.batch.facts.lists.elements, left.ty, [state.batch.facts.string_type, state.batch.facts.bytes_type, state.batch.facts.lists.types.buffer.id], [])
            if not supported:
                const rejection = try problem(state, operator_span, "E_TYPE", "aggregate equality is not defined; compare the relevant elements explicitly")
                fail rejection
        ty = left.ty
        if managed(state, left.ty):
            if list_types.element_type(state.batch.facts.lists, left.ty) >= 0 and op.data != b"eq" and op.data != b"ne":
                const rejection = try problem(state, operator_span, "E_TEXT_OPERATOR", "managed collections support equality; str and bytes also support `+` and `<`, `<=`, `>`, `>=`")
                fail rejection
            if op.data == b"add":
                ty = left.ty
            elif op.data == b"eq" or op.data == b"ne" or op.data == b"lt" or op.data == b"le" or op.data == b"gt" or op.data == b"ge":
                ty = 1
            else:
                const rejection = try problem(state, operator_span, "E_TEXT_OPERATOR", "managed collections support equality; str and bytes also support `+` and `<`, `<=`, `>`, `>=`")
                fail rejection
        elif op.data == b"logical_and" or op.data == b"logical_or":
            _ = try require(state, left.ty, 1, operator_span)
            ty = 1
        elif op.data == b"eq" or op.data == b"ne":
            ty = 1
        else:
            if left.ty != 0:
                const rejection = try problem(state, operator_span, "E_TYPE", "operation requires an integer type")
                fail rejection
            if op.data == b"lt" or op.data == b"le" or op.data == b"gt" or op.data == b"ge":
                ty = 1
        const typed_op = try syntax_value.enumeration(mut state.batch.pool, op.data)
        const typed_left = try syntax_value.integer(mut state.batch.pool, left.id)
        const typed_right = try syntax_value.integer(mut state.batch.pool, right.id)
        const typed_span = try graph.clone(mut state.batch.pool, state.syntax.pool, operator_span, 0)
        result_payload = try syntax_value.object(mut state.batch.pool, ["op", "left", "right", "op_span"], [typed_op, typed_left, typed_right, typed_span])
    else:
        const rejection = try problem(state, span, "P_BODY_PROFILE", "body expression is outside the B1 scalar profile")
        fail rejection
    const id = try emission.node(mut state.batch, state.syntax.pool, span, ty, data.data, result_payload)
    state.batch.resolved[raw_id] = id
    state.depth = state.depth - 1
    return Expression(id=id, ty=ty)


public func expression_expected(mut state: State, raw_id: int, expected: int) -> Expression fails syntax_value.Problem:
    if raw_id < 0 or raw_id >= len(state.syntax.nodes):
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid expected expression index")
    if len(state.batch.facts.expected) != len(state.syntax.nodes):
        state.batch.facts.expected = []
        for node in state.syntax.nodes:
            state.batch.facts.expected.append(-1)
    state.batch.facts.expected[raw_id] = expected
    return try expression(mut state, raw_id)


public func statement(mut state: State, raw_id: int) -> Statement fails syntax_value.Problem:
    const checked = try checked_statement(mut state, raw_id)
    const context = mutation_places.Context(pool=state.syntax.pool, source=state.syntax.source, nodes=state.syntax.nodes, typed_pool=state.batch.pool, typed_nodes=state.batch.nodes, resolved=state.batch.resolved)
    const diagnostics = try receiver_overlap.check(context, state.syntax.statements[raw_id], state.scope)
    if len(diagnostics) != 0:
        for diagnostic in diagnostics:
            state.problems.append(diagnostic)
        fail diagnostics[0].problem
    return checked


func checked_statement(mut state: State, raw_id: int) -> Statement fails syntax_value.Problem:
    if raw_id < 0 or raw_id >= len(state.syntax.statements):
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid statement index")
    if state.depth >= 256:
        fail syntax_value.Problem(code="P_BODY_LIMIT", start=0, end=0, message="body statement depth exceeded")
    state.depth = state.depth + 1
    const raw = state.syntax.statements[raw_id]
    const span = try graph.field(state.syntax.pool, raw, "span")
    const data_id = try graph.field(state.syntax.pool, raw, "data")
    const data = try graph.get(state.syntax.pool, data_id)
    const payload = try graph.payload(state.syntax.pool, data_id)
    mut terminates = False
    mut looping = False
    mut result_payload = -1
    mut tag = data.data
    if tag == b"block":
        const first_local = len(state.scope.locals)
        const active = state.scope.active
        const children = try graph.items(state.syntax.pool, payload)
        mut checked: int[] = []
        for child in children:
            const child_id = try graph.number(state.syntax.pool, child)
            if terminates and not looping:
                const child_raw = state.syntax.statements[child_id]
                const child_span = try graph.field(state.syntax.pool, child_raw, "span")
                const rejection = try problem(state, child_span, "E_UNREACHABLE", "statement follows a structurally terminating statement")
                fail rejection
            const result = try statement(mut state, child_id)
            checked.append(result.id)
            terminates = result.terminates
            looping = result.looping
        if not terminates:
            _ = try obligations.handled(state.syntax.pool, state.batch.facts.lists.types.records.rows, state.scope, first_local, span, mut state.problems)
        state.scope.active = active
        result_payload = try emission.ids(mut state.batch, checked)
    elif tag == b"ret" or tag == b"discard" or tag == b"fail":
        const expression_id = try graph.number(state.syntax.pool, payload)
        mut result = Expression(id=-1, ty=15)
        mut expected = state.return_type
        if state.control.failure_type >= 0:
            expected = state.control.success_type
        if tag == b"fail":
            if state.control.failure_type < 0:
                const rejection = try problem(state, span, "E_FAIL_CONTEXT", "fail requires an enclosing function with a fails clause")
                fail rejection
            expected = state.control.failure_type
        if tag == b"ret" or tag == b"fail":
            result = try expression_expected(mut state, expression_id, expected)
            const context = failure_lower.Context(pool=state.syntax.pool, records=state.batch.facts.lists.types.records.rows, span=span)
            if tag == b"fail":
                const injected = try failure_lower.inject_error(mut state.batch, context, expected, result.id)
                const injected_type = try failure_lower.type_of(state.batch, injected)
                result = Expression(id=injected, ty=injected_type)
            _ = try require(state, result.ty, expected, span)
            if state.control.failure_type >= 0:
                mut wrapped = result.id
                if tag == b"fail":
                    wrapped = try failure_lower.wrap_err(mut state.batch, context, state.return_type, result.id)
                else:
                    wrapped = try failure_lower.wrap_success(mut state.batch, context, state.return_type, result.id)
                result = Expression(id=wrapped, ty=state.return_type)
            _ = try obligations.handled(state.syntax.pool, state.batch.facts.lists.types.records.rows, state.scope, 0, span, mut state.problems)
            terminates = True
            tag = b"ret"
        else:
            result = try expression(mut state, expression_id)
            const discard_problem = try discard_policy.check(state.syntax.pool, state.batch.facts.lists.types.records.rows, state.syntax.statements[raw_id], result.ty)
            match discard_problem:
                case Some(diagnostic):
                    state.problems.append(diagnostic)
                    fail diagnostic.problem
                case None:
                    pass
        result_payload = try syntax_value.integer(mut state.batch.pool, result.id)
    elif tag == b"yield_value":
        const slot = state.control.values.yield_slot
        if slot < 0:
            const rejection = try problem(state, span, "E_YIELD_CONTEXT", "yield requires a match expression arm")
            fail rejection
        const expression_id = try graph.number(state.syntax.pool, payload)
        mut value = Expression(id=-1, ty=15)
        if state.control.values.yield_type >= 0:
            value = try expression_expected(mut state, expression_id, state.control.values.yield_type)
            _ = try require(state, value.ty, state.control.values.yield_type, span)
        else:
            value = try expression(mut state, expression_id)
        state.control.values.yield_type = value.ty
        state.scope.locals[slot].ty = value.ty
        state.scope.locals[slot].initialized = True
        const pending = try variants.requires_handling(state.syntax.pool, state.batch.facts.lists.types.records.rows, value.ty)
        state.scope.locals[slot].usage.transfer_available = pending
        result_payload = try emission.store(mut state.batch, slot, value.id)
        tag = b"initialize"
    elif tag == b"binding":
        const name_span = try graph.field(state.syntax.pool, payload, "name")
        const name = try graph.spelling(state.syntax.pool, state.syntax.source, name_span)
        const top_level_name = try top_level(state, name_span)
        if locals.find(state.scope, name) >= 0 or top_level_name:
            const rejection = try problem(state, name_span, "E_SHADOWING", "binding shadows an active local or top-level function")
            fail rejection
        const value_id = try graph.field(state.syntax.pool, payload, "value")
        const value_raw = try graph.number(state.syntax.pool, value_id)
        const annotation_id = try graph.field(state.syntax.pool, payload, "annotation")
        const annotation = try graph.get(state.syntax.pool, annotation_id)
        mut value = Expression(id=-1, ty=15)
        if annotation.kind != 0:
            const ty = try type_at(mut state, annotation_id)
            value = try expression_expected(mut state, value_raw, ty)
            _ = try require(state, value.ty, ty, annotation_id)
        else:
            value = try expression(mut state, value_raw)
        const mutable_id = try graph.field(state.syntax.pool, payload, "mutable")
        const mutable = try graph.get(state.syntax.pool, mutable_id)
        const slot = try locals.add(mut state.scope, name, name_span, value.ty, mutable.integer != 0, b"local")
        const pending = try variants.requires_handling(state.syntax.pool, state.batch.facts.lists.types.records.rows, value.ty)
        state.scope.locals[slot].usage.transfer_available = pending
        const raw_data_id = try graph.field(state.syntax.pool, state.syntax.nodes[value_raw], "data")
        const raw_data = try graph.get(state.syntax.pool, raw_data_id)
        if raw_data.data == b"index":
            state.scope.locals[slot].origin = b"collection_copy"
        result_payload = try emission.store(mut state.batch, slot, value.id)
        tag = b"initialize"
    elif tag == b"branch":
        const condition_id = try graph.field(state.syntax.pool, payload, "condition")
        const condition_raw = try graph.number(state.syntax.pool, condition_id)
        const condition = try expression(mut state, condition_raw)
        const condition_span = try graph.field(state.syntax.pool, state.syntax.nodes[condition_raw], "span")
        _ = try require(state, condition.ty, 1, condition_span)
        const then_id = try graph.field(state.syntax.pool, payload, "then_body")
        const then_raw = try graph.number(state.syntax.pool, then_id)
        const before = locals_flow.snapshot(state.scope)
        const pending_before = try pending_flow.snapshot(state.scope, len(state.scope.locals))
        const then_body = try statement(mut state, then_raw)
        const then_state = locals_flow.snapshot(state.scope)
        const pending_then = try pending_flow.snapshot(state.scope, len(pending_before))
        locals_flow.restore(mut state.scope, before)
        try pending_flow.restore(mut state.scope, pending_before)
        const else_id = try graph.field(state.syntax.pool, payload, "else_body")
        const else_value = try graph.get(state.syntax.pool, else_id)
        mut else_body = try syntax_value.absent(mut state.batch.pool)
        mut else_terminates = False
        if else_value.kind != 0:
            const else_raw = try graph.number(state.syntax.pool, else_id)
            const result = try statement(mut state, else_raw)
            else_body = try syntax_value.integer(mut state.batch.pool, result.id)
            else_terminates = result.terminates
            terminates = then_body.terminates and result.terminates
        if else_terminates and not then_body.terminates:
            locals_flow.restore(mut state.scope, then_state)
        elif not then_body.terminates and not else_terminates:
            locals_flow.intersect(mut state.scope, then_state)
        const pending_difference = try pending_flow.branch(mut state.scope, pending_then, then_body.terminates, else_terminates)
        _ = try obligations.consistent(state.syntax.pool, state.scope, pending_difference, span, False, mut state.problems)
        const checked_condition = try syntax_value.integer(mut state.batch.pool, condition.id)
        const checked_then = try syntax_value.integer(mut state.batch.pool, then_body.id)
        result_payload = try syntax_value.object(mut state.batch.pool, ["condition", "then_body", "else_body"], [checked_condition, checked_then, else_body])
    elif tag == b"assignment":
        const name_span = try graph.field(state.syntax.pool, payload, "name")
        const name = try graph.spelling(state.syntax.pool, state.syntax.source, name_span)
        const op_id = try graph.field(state.syntax.pool, payload, "op")
        const op = try graph.get(state.syntax.pool, op_id)
        const slot = locals.find(state.scope, name)
        if slot < 0 and op.data != b"set":
            mut candidates: bytes[] = []
            for active_slot in state.scope.active:
                candidates.append(state.scope.locals[active_slot].name)
            const clause = try suggestions.clause(candidates, name)
            const rejection = try problem(state, name_span, "E_UNKNOWN_NAME", "name is not defined in this scope" + clause)
            fail rejection
        if slot < 0:
            const rejection = try problem(state, name_span, "E_BINDING_DECLARATION", "assignment requires a declared binding; introduce a writable local with `mut`")
            state.problems.append(syntax_problem.repaired(rejection, [syntax_problem.Edit(start=rejection.start, end=rejection.start, text=b"mut ")]))
            fail rejection
        if not state.scope.locals[slot].mutable:
            const rejection = try problem(state, name_span, "E_IMMUTABLE", "this binding cannot be assigned")
            fail rejection
        const value_id = try graph.field(state.syntax.pool, payload, "value")
        const value_raw = try graph.number(state.syntax.pool, value_id)
        if op.data == b"mul" and list_types.element_type(state.batch.facts.lists, state.scope.locals[slot].ty) >= 0:
            _ = try require_readable(mut state, slot, name_span)
            const count = try expression(mut state, value_raw)
            const operator_span = try graph.field(state.syntax.pool, payload, "op_span")
            if count.ty != 0:
                const rejection = try problem(state, operator_span, "E_TYPE", "operation requires an integer type")
                fail rejection
            const owner_type = state.scope.locals[slot].ty
            state.scope.locals[slot].usage.reads = state.scope.locals[slot].usage.reads + 1
            state.scope.locals[slot].usage.writes = state.scope.locals[slot].usage.writes + 1
            const context = list_lower.Context(input=state.syntax.pool, span=operator_span)
            const sequence = try list_lower.read(mut state.batch, context, slot, owner_type)
            const lowered = try list_repeat.build(mut state.batch, mut state.scope, context, list_repeat.Input(sequence=sequence, count=count.id, ty=owner_type, count_first=False, loop_id=state.control.next))
            state.control.next = state.control.next + 1
            const product = try list_lower.append(mut state.batch, context, lowered)
            const repeated = try list_lower.temporary(mut state.scope, context, owner_type)
            const read = try list_lower.read(mut state.batch, context, repeated, owner_type)
            const initialize = try list_lower.store(mut state.batch, context, repeated, product, True)
            const cleared = try list_lower.operation(mut state.batch, context, list_lower.Operation(owner=slot, kind=b"clear", arguments=[], ty=15))
            const clear_id = try syntax_value.integer(mut state.batch.pool, cleared)
            const clear = try emission.statement(mut state.batch, state.syntax.pool, operator_span, False, b"discard", clear_id)
            const extended = try list_lower.operation(mut state.batch, context, list_lower.Operation(owner=slot, kind=b"extend", arguments=[read], ty=15))
            const extend_id = try syntax_value.integer(mut state.batch.pool, extended)
            const extend = try emission.statement(mut state.batch, state.syntax.pool, operator_span, False, b"discard", extend_id)
            const statements = try emission.ids(mut state.batch, [initialize, clear, extend])
            const id = try emission.statement(mut state.batch, state.syntax.pool, span, False, b"block", statements)
            state.depth = state.depth - 1
            return Statement(id=id, terminates=False)
        const pending_target = try variants.requires_handling(state.syntax.pool, state.batch.facts.lists.types.records.rows, state.scope.locals[slot].ty)
        if pending_target and state.scope.locals[slot].usage.transfer_available:
            const rejection = try problem(state, name_span, "E_RESULT_OVERWRITE", "assignment would overwrite an unhandled result-bearing value")
            fail rejection
        mut value = try expression_expected(mut state, value_raw, state.scope.locals[slot].ty)
        if op.data != b"set":
            _ = try require_readable(mut state, slot, name_span)
            const operator_span = try graph.field(state.syntax.pool, payload, "op_span")
            _ = try require(state, value.ty, state.scope.locals[slot].ty, operator_span)
            if op.data == b"add" and list_types.element_type(state.batch.facts.lists, value.ty) >= 0:
                state.scope.locals[slot].usage.reads = state.scope.locals[slot].usage.reads + 1
                state.scope.locals[slot].usage.writes = state.scope.locals[slot].usage.writes + 1
                const context = list_lower.Context(input=state.syntax.pool, span=operator_span)
                const extended = try list_lower.operation(mut state.batch, context, list_lower.Operation(owner=slot, kind=b"extend", arguments=[value.id], ty=15))
                const operand = try syntax_value.integer(mut state.batch.pool, extended)
                const discarded = try emission.statement(mut state.batch, state.syntax.pool, operator_span, False, b"discard", operand)
                const statements = try emission.ids(mut state.batch, [discarded])
                const id = try emission.statement(mut state.batch, state.syntax.pool, span, False, b"block", statements)
                state.depth = state.depth - 1
                return Statement(id=id, terminates=False)
            if managed(state, value.ty):
                if op.data != b"add":
                    const rejection = try problem(state, operator_span, "E_TEXT_OPERATOR", "a managed collection augments with `+=` only, and str, bytes and list are the types that support it")
                    fail rejection
            elif value.ty != 0:
                const rejection = try problem(state, operator_span, "E_TYPE", "operation requires an integer type")
                fail rejection
            state.scope.locals[slot].usage.reads = state.scope.locals[slot].usage.reads + 1
            const local_payload = try syntax_value.integer(mut state.batch.pool, slot)
            const left = try emission.node(mut state.batch, state.syntax.pool, name_span, value.ty, b"local", local_payload)
            if op.data == b"div":
                const rejection = try problem(state, operator_span, "E_TYPE", "augmented `/=` produces a float; declare the binding as float or use `//=`")
                fail rejection
            mut operator = op.data
            if operator == b"rem":
                operator = b"floor_rem"
            const typed_op = try syntax_value.enumeration(mut state.batch.pool, operator)
            const typed_left = try syntax_value.integer(mut state.batch.pool, left)
            const typed_right = try syntax_value.integer(mut state.batch.pool, value.id)
            const typed_span = try graph.clone(mut state.batch.pool, state.syntax.pool, operator_span, 0)
            const binary = try syntax_value.object(mut state.batch.pool, ["op", "left", "right", "op_span"], [typed_op, typed_left, typed_right, typed_span])
            const combined = try emission.node(mut state.batch, state.syntax.pool, operator_span, value.ty, b"binary", binary)
            value = Expression(id=combined, ty=value.ty)
        _ = try require(state, value.ty, state.scope.locals[slot].ty, span)
        state.scope.locals[slot].usage.writes = state.scope.locals[slot].usage.writes + 1
        if op.data == b"set":
            state.scope.locals[slot].origin = b"local"
        state.scope.locals[slot].initialized = True
        state.scope.locals[slot].usage.transfer_available = pending_target
        state.scope.locals[slot].usage.transfer_span = -1
        result_payload = try emission.store(mut state.batch, slot, value.id)
        tag = b"assign"
    elif tag == b"loop":
        const pending_before = try pending_flow.snapshot(state.scope, len(state.scope.locals))
        const condition_id = try graph.field(state.syntax.pool, payload, "condition")
        const condition_raw = try graph.number(state.syntax.pool, condition_id)
        const condition = try expression(mut state, condition_raw)
        const condition_span = try graph.field(state.syntax.pool, state.syntax.nodes[condition_raw], "span")
        _ = try require(state, condition.ty, 1, condition_span)
        const condition_difference = try pending_flow.mismatch(state.scope, pending_before)
        _ = try obligations.consistent(state.syntax.pool, state.scope, condition_difference, span, True, mut state.problems)
        const loop_id = state.control.next
        state.control.next = loop_id + 1
        state.control.active.append(loop_id)
        state.control.exited.append(False)
        const body_id = try graph.field(state.syntax.pool, payload, "body")
        const body_raw = try graph.number(state.syntax.pool, body_id)
        const before = locals_flow.snapshot(state.scope)
        const body = try statement(mut state, body_raw)
        if not body.terminates:
            const difference = try pending_flow.mismatch(state.scope, pending_before)
            _ = try obligations.consistent(state.syntax.pool, state.scope, difference, span, True, mut state.problems)
        try pending_flow.restore(mut state.scope, pending_before)
        locals_flow.restore(mut state.scope, before)
        const last = len(state.control.active) - 1
        const condition_node = state.batch.nodes[condition.id]
        const condition_data = try graph.field(state.batch.pool, condition_node, "data")
        const condition_tag = try graph.get(state.batch.pool, condition_data)
        if condition_tag.data == b"boolean":
            const boolean_id = try graph.payload(state.batch.pool, condition_data)
            const boolean = try graph.get(state.batch.pool, boolean_id)
            terminates = boolean.integer == 1 and not state.control.exited[last]
            looping = terminates
        state.control.active = state.control.active[:last]
        state.control.exited = state.control.exited[:last]
        const identity = try syntax_value.integer(mut state.batch.pool, loop_id)
        const checked_condition = try syntax_value.integer(mut state.batch.pool, condition.id)
        const checked_body = try syntax_value.integer(mut state.batch.pool, body.id)
        const step = try syntax_value.absent(mut state.batch.pool)
        result_payload = try syntax_value.object(mut state.batch.pool, ["id", "condition", "body", "step"], [identity, checked_condition, checked_body, step])
    elif tag == b"loop_exit":
        if len(state.control.active) == 0:
            const rejection = try problem(state, span, "E_LOOP_EXIT", "break and continue require an enclosing loop")
            fail rejection
        const last = len(state.control.active) - 1
        const continuing = try graph.get(state.syntax.pool, payload)
        if continuing.integer == 0:
            state.control.exited[last] = True
        const target = try syntax_value.integer(mut state.batch.pool, state.control.active[last])
        const flag = try syntax_value.boolean(mut state.batch.pool, continuing.integer != 0)
        result_payload = try syntax_value.object(mut state.batch.pool, ["target", "continuing"], [target, flag])
        terminates = True
    elif tag == b"assertion":
        const condition_id = try graph.field(state.syntax.pool, payload, "condition")
        const condition_raw = try graph.number(state.syntax.pool, condition_id)
        const condition = try expression(mut state, condition_raw)
        const condition_span = try graph.field(state.syntax.pool, state.syntax.nodes[condition_raw], "span")
        _ = try require(state, condition.ty, 1, condition_span)
        const message_id = try graph.field(state.syntax.pool, payload, "message")
        const message = try graph.clone(mut state.batch.pool, state.syntax.pool, message_id, 0)
        const message_value = try graph.field(state.syntax.pool, payload, "value")
        const message_expression = try graph.get(state.syntax.pool, message_value)
        if message_expression.kind != 0:
            const rejection = try problem(state, span, "P_BODY_PROFILE", "dynamic assertion messages are outside the B1 scalar profile")
            fail rejection
        const checked_condition = try syntax_value.integer(mut state.batch.pool, condition.id)
        const absent = try syntax_value.absent(mut state.batch.pool)
        const kind = try syntax_value.enumeration(mut state.batch.pool, b"statement")
        result_payload = try syntax_value.object(mut state.batch.pool, ["condition", "message", "message_value", "kind"], [checked_condition, message, absent, kind])
    elif tag == b"match":
        const result = try match_payload(mut state, payload, span)
        state.depth = state.depth - 1
        return result
    elif tag == b"for_each":
        const name_span = try graph.field(state.syntax.pool, payload, "name")
        const index_name_id = try graph.field(state.syntax.pool, payload, "index_name")
        const index_name = try graph.get(state.syntax.pool, index_name_id)
        const enumerated_id = try graph.field(state.syntax.pool, payload, "enumerated")
        const enumerated = try graph.get(state.syntax.pool, enumerated_id)
        if index_name.kind != 0 or enumerated.integer != 0:
            const rejection = try problem(state, span, "P_BODY_PROFILE", "enumerated or unpacked iteration is outside the admitted list closure")
            fail rejection
        const name = try graph.spelling(state.syntax.pool, state.syntax.source, name_span)
        const iterable_id = try graph.field(state.syntax.pool, payload, "iterable")
        const iterable_raw = try graph.number(state.syntax.pool, iterable_id)
        const iterable = try expression(mut state, iterable_raw)
        const element = list_types.element_type(state.batch.facts.lists, iterable.ty)
        if element < 0:
            const rejection = try problem(state, span, "P_BODY_PROFILE", "iteration receiver is outside the admitted list closure")
            fail rejection
        const top_level_name = try top_level(state, name_span)
        if name != b"_" and (locals.find(state.scope, name) >= 0 or top_level_name):
            const rejection = try problem(state, name_span, "E_SHADOWING", "iteration binding shadows an active declaration")
            fail rejection
        const loop_id = state.control.next
        state.control.next = loop_id + 1
        const plan = try list_iteration.prepare(mut state.batch, mut state.scope, state.syntax.pool, list_iteration.Input(source=state.syntax.source, name=name_span, span=span, iterable=iterable.id, owner_type=iterable.ty, element=element, loop_id=loop_id))
        state.control.active.append(loop_id)
        state.control.exited.append(False)
        const body_id = try graph.field(state.syntax.pool, payload, "body")
        const body_raw = try graph.number(state.syntax.pool, body_id)
        const before = locals_flow.snapshot(state.scope)
        const pending_before = try pending_flow.snapshot(state.scope, len(state.scope.locals))
        const body = try statement(mut state, body_raw)
        if not body.terminates:
            const difference = try pending_flow.mismatch(state.scope, pending_before)
            _ = try obligations.consistent(state.syntax.pool, state.scope, difference, span, True, mut state.problems)
        try pending_flow.restore(mut state.scope, pending_before)
        const lowered = try list_iteration.finish(mut state.batch, mut state.scope, state.syntax.pool, plan, list_iteration.Finish(raw_statements=state.syntax.statements, raw_nodes=state.syntax.nodes, body_raw=body_raw, body=body.id))
        locals_flow.restore(mut state.scope, before)
        state.scope.active = plan.before_active
        const last = len(state.control.active) - 1
        state.control.active = state.control.active[:last]
        state.control.exited = state.control.exited[:last]
        result_payload = lowered.payload
        tag = b"block"
    elif tag == b"for_range":
        const name_span = try graph.field(state.syntax.pool, payload, "name")
        const name = try graph.spelling(state.syntax.pool, state.syntax.source, name_span)
        const top_level_name = try top_level(state, name_span)
        if name != b"_" and (locals.find(state.scope, name) >= 0 or top_level_name):
            const rejection = try problem(state, name_span, "E_SHADOWING", "iteration binding shadows an active declaration")
            fail rejection
        const step_id = try graph.field(state.syntax.pool, payload, "step")
        const step = try graph.get(state.syntax.pool, step_id)
        if step.kind != 0:
            const rejection = try problem(state, span, "P_BODY_PROFILE", "explicit range strides are outside the initial B1 scalar profile")
            fail rejection
        const start_id = try graph.field(state.syntax.pool, payload, "start")
        const start_raw = try graph.number(state.syntax.pool, start_id)
        const end_id = try graph.field(state.syntax.pool, payload, "end")
        const end_raw = try graph.number(state.syntax.pool, end_id)
        if start_raw < 0 or start_raw >= len(state.syntax.nodes):
            fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid range start")
        const start_data_id = try graph.field(state.syntax.pool, state.syntax.nodes[start_raw], "data")
        const start_data = try graph.get(state.syntax.pool, start_data_id)
        mut start = Expression(id=-1, ty=0)
        if start_data.data == b"unit":
            const zero = try syntax_value.integer(mut state.batch.pool, 0)
            const zero_node = try emission.node(mut state.batch, state.syntax.pool, name_span, 0, b"integer", zero)
            start = Expression(id=zero_node, ty=0)
        else:
            start = try expression(mut state, start_raw)
        const end = try expression(mut state, end_raw)
        if start.ty != 0:
            const rejection = try problem(state, name_span, "E_TYPE", "operation requires an integer type")
            fail rejection
        const end_span = try graph.field(state.syntax.pool, state.syntax.nodes[end_raw], "span")
        _ = try require(state, end.ty, start.ty, end_span)
        const active = state.scope.active
        const loop_id = state.control.next
        state.control.next = loop_id + 1
        const plan = try range_lower.prepare(mut state.batch, mut state.scope, state.syntax.pool, range_lower.Input(source=state.syntax.source, name=name_span, span=span, start=start.id, end=end.id, loop_id=loop_id))
        state.control.active.append(loop_id)
        state.control.exited.append(False)
        const body_id = try graph.field(state.syntax.pool, payload, "body")
        const body_raw = try graph.number(state.syntax.pool, body_id)
        const before = locals_flow.snapshot(state.scope)
        const pending_before = try pending_flow.snapshot(state.scope, len(state.scope.locals))
        const body = try statement(mut state, body_raw)
        if not body.terminates:
            const difference = try pending_flow.mismatch(state.scope, pending_before)
            _ = try obligations.consistent(state.syntax.pool, state.scope, difference, span, True, mut state.problems)
        try pending_flow.restore(mut state.scope, pending_before)
        locals_flow.restore(mut state.scope, before)
        const last = len(state.control.active) - 1
        state.control.active = state.control.active[:last]
        state.control.exited = state.control.exited[:last]
        state.scope.active = active
        result_payload = try range_lower.finish(mut state.batch, state.syntax.pool, plan, body.id)
        tag = b"range_loop"
    else:
        const rejection = try problem(state, span, "P_BODY_PROFILE", "statement is outside the B1 scalar profile")
        fail rejection
    const id = try emission.statement(mut state.batch, state.syntax.pool, span, terminates, tag, result_payload)
    state.depth = state.depth - 1
    return Statement(id=id, terminates=terminates, looping=looping)


func require_readable(mut state: State, slot: int, span: int) -> bool fails syntax_value.Problem:
    if not state.scope.locals[slot].initialized:
        const rejection = try problem(state, span, "E_UNBOUND", "name may be read before it is assigned; some control-flow path reaching here leaves it unbound")
        const previous = try problem(state, state.scope.locals[slot].declaration, "", "")
        const related = syntax_problem.Related(start=previous.start, end=previous.end, message="binding first assigned here", role="related")
        state.problems.append(syntax_problem.Diagnostic(problem=rejection, severity="err", notes=syntax_problem.Notes(related=[related], origin=[], requirement=[], edits=[])))
        fail rejection
    return True


public func managed(state: State, ty: int) -> bool:
    return ty >= 19 and (ty == state.batch.facts.string_type or ty == state.batch.facts.bytes_type or ty == state.batch.facts.lists.types.buffer.id or list_types.element_type(state.batch.facts.lists, ty) >= 0)


func type_name(state: State, ty: int) -> str:
    const element = list_types.element_type(state.batch.facts.lists, ty)
    if element >= 0:
        return type_name(state, element) + "[]"
    if ty >= 19 and ty == state.batch.facts.string_type:
        return "str"
    if ty >= 19 and ty == state.batch.facts.bytes_type:
        return "bytes"
    if ty >= 19 and ty == state.batch.facts.lists.types.buffer.id:
        return "byte_buffer"
    const records = state.batch.facts.lists.types.records
    if ty >= 19 and ty < len(records.by_type):
        const declaration = records.by_type[ty]
        if declaration >= 0 and declaration < len(records.bindings.display):
            return records.bindings.display[declaration]
    return scalars.name(ty)


public func type_at(mut state: State, span: int) -> int fails syntax_value.Problem:
    const text = try graph.spelling(state.syntax.pool, state.syntax.source, span)
    for suffix in state.batch.facts.lists.types.suffixes:
        const suffix_span = try graph.field(state.syntax.pool, suffix, "span")
        const suffix_text = try graph.spelling(state.syntax.pool, state.syntax.source, suffix_span)
        if suffix_text == text:
            const kind_id = try graph.field(state.syntax.pool, suffix, "kind")
            const kind = try graph.get(state.syntax.pool, kind_id)
            const base = try graph.field(state.syntax.pool, suffix, "base")
            const element = try type_at(mut state, base)
            if kind.data == b"optional":
                return try list_types.union_intern(mut state.batch.facts.lists, mut state.syntax.pool, element, -1, span, False)
            if kind.data != b"growable":
                const rejection = try problem(state, span, "P_BODY_PROFILE", "type suffix is outside the body profile")
                fail rejection
            const ty = list_types.lookup(state.batch.facts.lists, element)
            if ty < 0:
                const rejection = try problem(state, span, "P_BODY_PROFILE", "annotated list type is absent from the common catalog")
                fail rejection
            return ty
    for application in state.batch.facts.applications:
        const application_span = try graph.field(state.syntax.pool, application, "span")
        const application_text = try graph.spelling(state.syntax.pool, state.syntax.source, application_span)
        if application_text == text:
            const name_span = try graph.field(state.syntax.pool, application, "name")
            const name = try graph.spelling(state.syntax.pool, state.syntax.source, name_span)
            const arguments_id = try graph.field(state.syntax.pool, application, "arguments")
            const arguments = try graph.items(state.syntax.pool, arguments_id)
            if (name == b"Result" and len(arguments) == 2) or (name == b"Option" and len(arguments) == 1):
                const first = try type_at(mut state, arguments[0])
                mut second = -1
                if len(arguments) == 2:
                    second = try type_at(mut state, arguments[1])
                return try list_types.union_intern(mut state.batch.facts.lists, mut state.syntax.pool, first, second, span, name == b"Result")
            if name == b"list" and len(arguments) == 1:
                const element = try type_at(mut state, arguments[0])
                const ty = list_types.lookup(state.batch.facts.lists, element)
                if ty >= 0:
                    return ty
            const rejection = try problem(state, span, "P_BODY_PROFILE", "qualified or user generic type application is outside the body profile")
            fail rejection
    if text == b"byte_buffer":
        return try list_types.buffer_intern(mut state.batch.facts.lists, mut state.syntax.pool, span)
    if text == b"str" or text == b"bytes":
        mut ty = state.batch.facts.string_type
        if text == b"bytes":
            ty = state.batch.facts.bytes_type
        if ty < 0:
            const rejection = try problem(state, span, "P_BODY_PROFILE", "managed sequence builtin is unavailable")
            fail rejection
        return ty
    if text != b"int" and text != b"i64" and text != b"bool" and text != b"Unit" and len(text) != 0:
        const resolution = try record_names.resolve(mut state.problems, state.syntax.pool, state.syntax.source, state.syntax.modules, record_names.Request(span=span, owner=-1, name=span))
        const ty = try nominal_key(mut state, resolution.key, span)
        if ty >= 0:
            if resolution.from >= 0 and resolution.import_index >= 0:
                state.syntax.usage[resolution.from][resolution.import_index] = True
            return ty
    const location = try problem(state, span, "", "")
    return try scalars.annotation(text, location.start, location.end)


func list_method(mut state: State, call: int, span: int, slot: int) -> Expression fails syntax_value.Problem:
    const name_span = try graph.field(state.syntax.pool, call, "name")
    const owner_span = try graph.field(state.syntax.pool, call, "owner")
    const name = try graph.spelling(state.syntax.pool, state.syntax.source, name_span)
    const arguments_id = try graph.field(state.syntax.pool, call, "arguments")
    const inputs = try graph.items(state.syntax.pool, arguments_id)
    const names_id = try graph.field(state.syntax.pool, call, "argument_names")
    const labels = try graph.items(state.syntax.pool, names_id)
    const types_id = try graph.field(state.syntax.pool, call, "type_arguments")
    const types = try graph.items(state.syntax.pool, types_id)
    if len(labels) != 0 or len(types) != 0:
        const rejection = try problem(state, span, "P_BODY_PROFILE", "named or generic list method operands are outside the body profile")
        fail rejection
    mut kind = name
    if name == b"index":
        kind = b"index_of"
    if name == b"pop" and len(inputs) == 1:
        kind = b"pop_at"
    mut arity = -1
    mut mutates = False
    mut result_type = 15
    const owner_type = state.scope.locals[slot].ty
    const element = list_types.element_type(state.batch.facts.lists, owner_type)
    if kind == b"append" or kind == b"extend" or kind == b"remove":
        arity = 1
        mutates = True
    elif kind == b"insert" or kind == b"write":
        arity = 2
        mutates = True
    elif kind == b"reverse" or kind == b"sort" or kind == b"clear":
        arity = 0
        mutates = True
    elif kind == b"pop" or kind == b"pop_at":
        arity = 0
        if kind == b"pop_at":
            arity = 1
        mutates = True
        result_type = element
    elif kind == b"read":
        arity = 1
        result_type = element
    elif kind == b"contains":
        arity = 1
        result_type = 1
    elif kind == b"index_of":
        arity = 1
        result_type = 0
    elif kind == b"copy":
        arity = 0
        result_type = owner_type
    elif kind == b"length" or kind == b"capacity":
        arity = 0
        result_type = 8
    if arity < 0:
        const rejection = try problem(state, name_span, "E_LIST_METHOD", "unknown method for a " + type_name(state, owner_type) + " receiver; accepted methods: append, clear, copy, extend, index, insert, pop, remove, reverse, sort")
        fail rejection
    if arity != len(inputs):
        mut error_span = owner_span
        if kind == b"append" or kind == b"read" or kind == b"write" or kind == b"length" or kind == b"capacity" or kind == b"contains":
            error_span = span
        mut plural = "s"
        if arity == 1:
            plural = ""
        const signature = try list_signature(state, owner_type, kind)
        const rejection = try problem(state, error_span, "E_ARITY", "`" + signature + "` takes " + str(arity) + " argument" + plural + ", but this call passes " + str(len(inputs)))
        fail rejection
    _ = try require_readable(mut state, slot, owner_span)
    if kind == b"sort" and element != 0 and element != state.batch.facts.string_type and element != state.batch.facts.bytes_type:
        const rejection = try problem(state, owner_span, "E_COLLECTION_METHOD", "sort requires an integer, float, str or bytes element type")
        fail rejection
    mut values: int[] = []
    mut position = 0
    for input in inputs:
        const raw = try graph.number(state.syntax.pool, input)
        mut expected = element
        if kind == b"extend":
            expected = owner_type
        elif kind == b"read" or kind == b"pop_at" or ((kind == b"insert" or kind == b"write") and position == 0):
            expected = 0
        const value = try expression_expected(mut state, raw, expected)
        const argument_span = try graph.field(state.syntax.pool, state.syntax.nodes[raw], "span")
        match require(state, value.ty, expected, argument_span):
            case Ok(unused):
                pass
            case Err(rejection):
                if kind == b"extend" or kind == b"remove" or kind == b"index_of" or (kind == b"insert" and position == 1):
                    const signature = try list_signature(state, owner_type, kind)
                    state.problems.append(syntax_problem.alternative(rejection, signature))
                fail rejection
        values.append(value.id)
        position = position + 1
    state.scope.locals[slot].usage.reads = state.scope.locals[slot].usage.reads + 1
    if mutates:
        if not state.scope.locals[slot].mutable:
            const rejection = try problem(state, owner_span, "E_IMMUTABLE", "collection update requires a writable binding")
            fail rejection
        state.scope.locals[slot].usage.writes = state.scope.locals[slot].usage.writes + 1
    const context = list_lower.Context(input=state.syntax.pool, span=span)
    const id = try list_lower.operation(mut state.batch, context, list_lower.Operation(owner=slot, kind=kind, arguments=values, ty=result_type))
    return Expression(id=id, ty=result_type)


func list_signature(state: State, owner_type: int, kind: bytes) -> str fails syntax_value.Problem:
    const owner = type_name(state, owner_type)
    const element = type_name(state, list_types.element_type(state.batch.facts.lists, owner_type))
    const spelling = try suggestions.text(kind)
    if kind == b"append" or kind == b"remove":
        return owner + "." + spelling + "(value: " + element + ") -> None"
    if kind == b"extend":
        return owner + ".extend(other: " + owner + ") -> None"
    if kind == b"insert" or kind == b"write":
        return owner + "." + spelling + "(index: int, value: " + element + ") -> None"
    if kind == b"pop_at" or kind == b"read":
        mut method = spelling
        if kind == b"pop_at":
            method = "pop"
        return owner + "." + method + "(index: int) -> " + element
    if kind == b"pop":
        return owner + ".pop() -> " + element
    if kind == b"copy":
        return owner + ".copy() -> " + owner
    if kind == b"index_of":
        return owner + ".index(value: " + element + ") -> int"
    if kind == b"contains":
        return owner + ".contains(value: " + element + ") -> bool"
    if kind == b"length" or kind == b"capacity":
        return owner + "." + spelling + "() -> int"
    return owner + "." + spelling + "() -> None"


func list_arity(kind: bytes) -> int:
    if kind == b"write" or kind == b"insert":
        return 2
    if kind == b"append" or kind == b"read" or kind == b"contains" or kind == b"extend" or kind == b"pop_at" or kind == b"remove" or kind == b"index_of":
        return 1
    if kind == b"length" or kind == b"capacity" or kind == b"pop" or kind == b"reverse" or kind == b"sort" or kind == b"copy" or kind == b"clear":
        return 0
    return -1


public func record_field(state: State, ty: int, span: int) -> int fails syntax_value.Problem:
    const row = record_types.schema(state.batch.facts.lists.types.records, ty)
    if row < 0:
        const rejection = try problem(state, span, "E_TYPE", "operation requires a record value")
        fail rejection
    const fields_id = try graph.field(state.syntax.pool, row, "fields")
    const fields = try graph.items(state.syntax.pool, fields_id)
    const text = try graph.spelling(state.syntax.pool, state.syntax.source, span)
    mut names_list: bytes[] = []
    for index in range(len(fields)):
        const name_id = try graph.field(state.syntax.pool, fields[index], "name")
        const name = try graph.get(state.syntax.pool, name_id)
        if name.kind != 3:
            fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid record field name")
        if name.data == text:
            return index
        names_list.append(name.data)
    # Diagnostic enumeration is lexical, independent of hash/declaration order.
    match record_name_index.make(names_list):
        case Ok(table):
            mut declared = ""
            for position in table.order:
                if len(declared) != 0:
                    declared = declared + ", "
                const name = try suggestions.text(table.names[position])
                declared = declared + name
            const rejection = try problem(state, span, "E_UNKNOWN_FIELD", "field does not exist on this record type; declared fields: " + declared)
            fail rejection
        case Err(error):
            fail syntax_value.Problem(code="P_BODY_LIMIT", start=0, end=0, message=error.message)


func record_initializers(mut state: State, ty: int, span: int, initializers: record_construct.Initializer[]) -> int fails syntax_value.Problem:
    const row = record_types.schema(state.batch.facts.lists.types.records, ty)
    const fields_id = try graph.field(state.syntax.pool, row, "fields")
    const fields = try graph.items(state.syntax.pool, fields_id)
    mut seen: bool[] = []
    for field in fields:
        seen.append(False)
    mut indices: int[] = []
    for initializer in initializers:
        const index = try record_field(state, ty, initializer.name)
        indices.append(index)
        const type_id = try graph.field(state.syntax.pool, fields[index], "ty")
        const expected = try graph.number(state.syntax.pool, type_id)
        if initializer.value < 0 or initializer.value >= len(state.syntax.nodes):
            fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid record initializer node")
        state.batch.facts.expected[initializer.value] = expected
    # Native queues every child before final duplicate/type/completeness checks.
    mut values: Expression[] = []
    for initializer in initializers:
        const value = try expression(mut state, initializer.value)
        values.append(value)
    mut checked: int[] = []
    mut position = 0
    for initializer in initializers:
        const index = indices[position]
        const value = values[position]
        position = position + 1
        if seen[index]:
            const rejection = try problem(state, initializer.name, "E_DUPLICATE_FIELD", "named entry is initialized more than once")
            fail rejection
        seen[index] = True
        const type_id = try graph.field(state.syntax.pool, fields[index], "ty")
        const expected = try graph.number(state.syntax.pool, type_id)
        const value_span = try graph.field(state.syntax.pool, state.syntax.nodes[initializer.value], "span")
        _ = try require(state, value.ty, expected, value_span)
        const index_value = try syntax_value.integer(mut state.batch.pool, index)
        const value_id = try syntax_value.integer(mut state.batch.pool, value.id)
        const field = try syntax_value.object(mut state.batch.pool, ["index", "value"], [index_value, value_id])
        checked.append(field)
    for index in range(len(fields)):
        if not seen[index]:
            const name_id = try graph.field(state.syntax.pool, fields[index], "name")
            const name = try graph.get(state.syntax.pool, name_id)
            const record_name_id = try graph.field(state.syntax.pool, row, "name")
            const record_name = try graph.get(state.syntax.pool, record_name_id)
            const field_text = try suggestions.text(name.data)
            const record_text = try suggestions.text(record_name.data)
            const rejection = try problem(state, span, "E_INCOMPLETE_CONSTRUCTION", "missing initializer for field `" + field_text + "` of `" + record_text + "`")
            const declaration = try graph.field(state.syntax.pool, fields[index], "declaration")
            const site = try problem(state, declaration, "", "")
            const related = syntax_problem.Related(start=site.start, end=site.end, message="missing entry declared here", role="related")
            state.problems.append(syntax_problem.Diagnostic(problem=rejection, severity="err", notes=syntax_problem.Notes(related=[related], origin=[], requirement=[], edits=[])))
            fail rejection
    return try syntax_value.sequence(mut state.batch.pool, checked)


func nominal_key(mut state: State, key: bytes, span: int) -> int fails syntax_value.Problem:
    const ty = try record_types.named(state.batch.facts.lists.types.records, key)
    if ty >= -1:
        return ty
    const index = -2 - ty
    const aliases = state.batch.facts.lists.types.records.bindings.aliases
    if index < 0 or index >= len(aliases):
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid nominal alias index")
    if state.depth >= 256:
        const rejection = try problem(state, span, "P_BODY_PROFILE", "alias resolution depth exceeds the body profile")
        fail rejection
    state.depth = state.depth + 1
    const target = try graph.field(state.syntax.pool, aliases[index], "target")
    const resolved = try type_at(mut state, target)
    state.depth = state.depth - 1
    return resolved


func record_assignment(mut state: State, assignment: int, span: int) -> Expression fails syntax_value.Problem:
    const target_id = try graph.field(state.syntax.pool, assignment, "target")
    const target = try graph.number(state.syntax.pool, target_id)
    _ = try list_places.writable(state.syntax.pool, state.syntax.source, state.syntax.nodes, mut state.scope, target)
    mut path_names: int[] = []
    mut root = target
    while True:
        if root < 0 or root >= len(state.syntax.nodes) or len(path_names) >= 256:
            fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid record field path")
        const data_id = try graph.field(state.syntax.pool, state.syntax.nodes[root], "data")
        const data = try graph.get(state.syntax.pool, data_id)
        if data.data != b"field":
            break
        const field = try graph.payload(state.syntax.pool, data_id)
        const name = try graph.field(state.syntax.pool, field, "name")
        path_names.append(name)
        const base_id = try graph.field(state.syntax.pool, field, "base")
        root = try graph.number(state.syntax.pool, base_id)
    const root_span = try graph.field(state.syntax.pool, state.syntax.nodes[root], "span")
    const root_data_id = try graph.field(state.syntax.pool, state.syntax.nodes[root], "data")
    const root_data = try graph.get(state.syntax.pool, root_data_id)
    const root_payload = try graph.payload(state.syntax.pool, root_data_id)
    const root_context = list_lower.Context(input=state.syntax.pool, span=root_span)
    mut destination = record_places.Destination(owner=-1, index=-1, value=-1, refresh=-1, setup=[], dead_owner=-1)
    if root_data.data == b"name":
        const name = try graph.spelling(state.syntax.pool, state.syntax.source, root_payload)
        const slot = locals.find(state.scope, name)
        if slot < 0:
            fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="record mutation root disappeared")
        _ = try require_readable(mut state, slot, root_payload)
        destination = try record_places.prepare_local(mut state.batch, mut state.scope, root_context, slot)
    elif root_data.data == b"index":
        const base_id = try graph.field(state.syntax.pool, root_payload, "base")
        const base_raw = try graph.number(state.syntax.pool, base_id)
        const base = try expression(mut state, base_raw)
        const element = list_types.element_type(state.batch.facts.lists, base.ty)
        if element < 0:
            const rejection = try problem(state, root_span, "E_COLLECTION_METHOD", "indexed field assignment requires a list, dictionary or fixed array reached from a variable")
            fail rejection
        destination = try record_places.receiver(mut state.batch, mut state.scope, root_context, record_places.Receiver(base=base.id, ty=base.ty))
        const index_id = try graph.field(state.syntax.pool, root_payload, "index")
        const index_raw = try graph.number(state.syntax.pool, index_id)
        const index = try expression(mut state, index_raw)
        _ = try require(state, index.ty, 0, root_span)
        destination = try record_places.indexed(mut state.batch, mut state.scope, root_context, destination, record_places.Index(value=index.id, element=element))
    else:
        const rejection = try problem(state, root_span, "E_ASSIGNMENT_TARGET", "field assignment requires a mutable local record or list slot")
        fail rejection
    const context = list_lower.Context(input=state.syntax.pool, span=span)
    mut path = record_places.Path(bases=[], indices=[], current=destination.value, ty=15)
    mut position = len(path_names)
    while position > 0:
        position = position - 1
        const base = path.current
        const ty_id = try graph.field(state.batch.pool, state.batch.nodes[base], "ty")
        const ty = try graph.number(state.batch.pool, ty_id)
        const name = path_names[position]
        const index = try record_field(state, ty, name)
        const row = record_types.schema(state.batch.facts.lists.types.records, ty)
        const fields_id = try graph.field(state.syntax.pool, row, "fields")
        const fields = try graph.items(state.syntax.pool, fields_id)
        const field_type_id = try graph.field(state.syntax.pool, fields[index], "ty")
        const field_type = try graph.number(state.syntax.pool, field_type_id)
        path.bases.append(base)
        path.indices.append(index)
        const field_value = try record_places.field(mut state.batch, context, base, index, field_type)
        path.current = field_value
        path.ty = field_type
    if len(path.bases) == 0:
        const rejection = try problem(state, span, "P_BODY_PROFILE", "tuple assignment is outside the record body profile")
        fail rejection
    const rhs_id = try graph.field(state.syntax.pool, assignment, "value")
    const rhs_raw = try graph.number(state.syntax.pool, rhs_id)
    const rhs = try expression_expected(mut state, rhs_raw, path.ty)
    _ = try require(state, rhs.ty, path.ty, span)
    const op_id = try graph.field(state.syntax.pool, assignment, "op")
    const op = try graph.get(state.syntax.pool, op_id)
    mut mode = b"set"
    mut value = rhs.id
    if op.data != b"set":
        mode = b"augmented"
        if op.data == b"add" and list_types.element_type(state.batch.facts.lists, path.ty) >= 0:
            mode = b"extend"
        else:
            if managed(state, path.ty):
                if op.data != b"add":
                    const rejection = try problem(state, span, "E_TEXT_OPERATOR", "a managed collection augments with `+=` only, and str, bytes and list are the types that support it")
                    fail rejection
            elif path.ty != 0:
                const rejection = try problem(state, span, "E_TYPE", "operation requires an integer type")
                fail rejection
            elif op.data == b"div":
                const rejection = try problem(state, span, "E_TYPE", "augmented `/=` produces a float; declare the binding as float or use `//=`")
                fail rejection
            mut operator = op.data
            if operator == b"rem":
                operator = b"floor_rem"
            value = try list_lower.binary(mut state.batch, context, operator, path.current, rhs.id, path.ty)
    mut reference_parameter = False
    if destination.dead_owner >= 0:
        const local = state.scope.locals[destination.dead_owner]
        reference_parameter = local.origin == b"parameter" and local.mutable
    const result = try record_places.finish(mut state.batch, mut state.scope, context, record_places.Finish(destination=destination, path=path, value=value, mode=mode, reference_parameter=reference_parameter))
    const id = try list_lower.append(mut state.batch, context, result)
    return Expression(id=id, ty=15)


func variant_owner(mut state: State, span: int, expected: int) -> int fails syntax_value.Problem:
    const spelling = try graph.spelling(state.syntax.pool, state.syntax.source, span)
    if spelling == b"Result" or spelling == b"Option":
        mut available = state.batch.facts.lists.types.variants.result.id >= 0
        if spelling == b"Option":
            available = state.batch.facts.lists.types.variants.option.id >= 0
        if available:
            const shape = try variants.shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, expected)
            if shape.valid:
                const row = state.batch.facts.lists.types.records.rows[expected - 19]
                const name_id = try graph.field(state.syntax.pool, row, "name")
                const name = try graph.get(state.syntax.pool, name_id)
                if len(name.data) > len(spelling) and name.data[:len(spelling)] == spelling and name.data[len(spelling)] == 60:
                    return expected
            const rejection = try problem(state, span, "E_GENERIC_INFERENCE", "a generic variant infers its type arguments from the expected type; annotate the binding, parameter or result")
            fail rejection
    mut ty = -1
    if len(state.syntax.modules) == 0:
        ty = try nominal_key(mut state, spelling, span)
    else:
        const request = record_names.Request(span=span, owner=-1, name=span)
        const is_type = try record_names.is_type(state.syntax.pool, state.syntax.source, state.syntax.modules, request)
        if not is_type:
            return -1
        const resolution = try record_names.resolve(mut state.problems, state.syntax.pool, state.syntax.source, state.syntax.modules, request)
        ty = try nominal_key(mut state, resolution.key, span)
        if ty >= 0 and resolution.from >= 0 and resolution.import_index >= 0:
            state.syntax.usage[resolution.from][resolution.import_index] = True
    const shape = try variants.shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, ty)
    if shape.valid:
        return ty
    return -1


public func variant_tag(state: State, ty: int, span: int) -> int fails syntax_value.Problem:
    const shape = try variants.shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, ty)
    if not shape.valid:
        const rejection = try problem(state, span, "E_TYPE", "operation requires an enum or tagged union")
        fail rejection
    const name = try graph.spelling(state.syntax.pool, state.syntax.source, span)
    const tag = variants.case_tag(shape, name)
    if tag >= 0:
        return tag
    mut labels: bytes[] = []
    for member in shape.cases:
        labels.append(member.name)
    match record_name_index.make(labels):
        case Ok(table):
            mut declared = ""
            for index in table.order:
                if len(declared) != 0:
                    declared = declared + ", "
                const label = try suggestions.text(table.names[index])
                declared = declared + label
            const rejection = try problem(state, span, "E_UNKNOWN_VARIANT", "variant is not declared on this type; declared variants: " + declared)
            fail rejection
        case Err(error):
            fail syntax_value.Problem(code="P_BODY_LIMIT", start=0, end=0, message=error.message)


func variant_value(mut state: State, ty: int, tag: int, span: int, value_raw: int) -> Expression fails syntax_value.Problem:
    const shape = try variants.shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, ty)
    const member = shape.cases[tag]
    mut value = Expression(id=-1, ty=15)
    if value_raw >= 0:
        value = try expression_expected(mut state, value_raw, member.payload)
    if (member.payload >= 0) != (value_raw >= 0):
        const rejection = try problem(state, span, "E_VARIANT_PAYLOAD", "construction must supply exactly the payload declared for this variant")
        const declaration = try problem(state, member.declaration, "", "")
        const note = syntax_problem.Related(start=declaration.start, end=declaration.end, message="variant declared here", role="related")
        state.problems.append(syntax_problem.Diagnostic(problem=rejection, severity="err", notes=syntax_problem.Notes(related=[note], origin=[], requirement=[], edits=[])))
        fail rejection
    mut checked_value = try syntax_value.absent(mut state.batch.pool)
    if value.id >= 0:
        const value_span = try graph.field(state.syntax.pool, state.syntax.nodes[value_raw], "span")
        _ = try require(state, value.ty, member.payload, value_span)
        checked_value = try syntax_value.integer(mut state.batch.pool, value.id)
    const checked_tag = try syntax_value.integer(mut state.batch.pool, tag)
    const payload = try syntax_value.object(mut state.batch.pool, ["tag", "value"], [checked_tag, checked_value])
    const id = try emission.node(mut state.batch, state.syntax.pool, span, ty, b"variant", payload)
    return Expression(id=id, ty=ty)


public record ArmBinding:
    slot: int
    prologue: int[]


func fail_related(mut state: State, span: int, code: str, message: str, declaration: int, note: str) -> bool fails syntax_value.Problem:
    const rejection = try problem(state, span, code, message)
    const location = try problem(state, declaration, "", "")
    const related = syntax_problem.Related(start=location.start, end=location.end, message=note, role="related")
    state.problems.append(syntax_problem.Diagnostic(problem=rejection, severity="err", notes=syntax_problem.Notes(related=[related], origin=[], requirement=[], edits=[])))
    fail rejection


func pattern_tag(mut state: State, ty: int, arm: int) -> int fails syntax_value.Problem:
    const type_span = try graph.field(state.syntax.pool, arm, "ty")
    const spelling = try graph.spelling(state.syntax.pool, state.syntax.source, type_span)
    const name = try graph.field(state.syntax.pool, arm, "name")
    if len(spelling) != 0:
        mut expected = try variant_owner(mut state, type_span, ty)
        if expected < 0:
            expected = try type_at(mut state, type_span)
        _ = try require(state, expected, ty, type_span)
        return try variant_tag(state, ty, name)
    mut label = try graph.spelling(state.syntax.pool, state.syntax.source, name)
    if label == b"Ok":
        label = b"ok"
    elif label == b"Err":
        label = b"err"
    elif label == b"Some":
        label = b"some"
    elif label == b"None":
        label = b"none"
    const shape = try variants.shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, ty)
    const tag = variants.case_tag(shape, label)
    if tag < 0:
        const rejection = try problem(state, name, "E_UNKNOWN_VARIANT", "case is not a variant of the matched type")
        fail rejection
    return tag


func payload_local(mut state: State, arm_name: int, binding: int, internal_name: bytes, ty: int) -> int fails syntax_value.Problem:
    mut name = internal_name
    const internal = len(name) != 0
    if not internal:
        name = try graph.spelling(state.syntax.pool, state.syntax.source, binding)
        const top = try top_level(state, binding)
        if top or locals.find(state.scope, name) >= 0:
            const rejection = try problem(state, binding, "E_SHADOWING", "payload binding shadows an active binding or top-level name")
            fail rejection
    const slot = try locals.add(mut state.scope, name, binding, ty, False, b"local")
    state.scope.locals[slot].usage.temporary = internal
    const pending = try variants.requires_handling(state.syntax.pool, state.batch.facts.lists.types.records.rows, ty)
    state.scope.locals[slot].usage.transfer_available = pending
    return slot


func bind_arm(mut state: State, member: variants.Case, arm: int) -> ArmBinding fails syntax_value.Problem:
    const name = try graph.field(state.syntax.pool, arm, "name")
    const bindings_id = try graph.field(state.syntax.pool, arm, "bindings")
    const bindings = try graph.items(state.syntax.pool, bindings_id)
    const internal = try graph.field(state.syntax.pool, arm, "internal")
    const names_id = try graph.field(state.syntax.pool, internal, "names")
    const internal_names = try graph.items(state.syntax.pool, names_id)
    if not member.fielded:
        if len(bindings) > 1:
            _ = try fail_related(mut state, name, "E_PATTERN_PAYLOAD", "a single-payload case binds one name", member.declaration, "variant declared here")
        mut discard = False
        if len(bindings) == 1:
            const binding = try graph.get(state.syntax.pool, bindings[0])
            discard = binding.kind == 0
        const pending = try variants.requires_handling(state.syntax.pool, state.batch.facts.lists.types.records.rows, member.payload)
        if discard and pending:
            const rejection = try problem(state, name, "E_RESULT_DISCARD", "nested result payload requires a binding and explicit handling")
            fail rejection
        if (member.payload >= 0) != (len(bindings) == 1):
            _ = try fail_related(mut state, name, "E_PATTERN_PAYLOAD", "payload variants require a binding or (discard); empty variants take neither", member.declaration, "variant declared here")
        if len(bindings) == 0 or discard:
            return ArmBinding(slot=-1, prologue=[])
        mut key = b""
        if len(internal_names) != 0:
            const value = try graph.get(state.syntax.pool, internal_names[0])
            key = value.data
        const slot = try payload_local(mut state, name, bindings[0], key, member.payload)
        return ArmBinding(slot=slot, prologue=[])
    const row = record_types.schema(state.batch.facts.lists.types.records, member.payload)
    if row < 0:
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="fielded match payload is not an ordinary record")
    const fields_id = try graph.field(state.syntax.pool, row, "fields")
    const fields = try graph.items(state.syntax.pool, fields_id)
    const labels_id = try graph.field(state.syntax.pool, arm, "binding_names")
    const labels = try graph.items(state.syntax.pool, labels_id)
    const patterns_id = try graph.field(state.syntax.pool, arm, "payload_patterns")
    const patterns = try graph.items(state.syntax.pool, patterns_id)
    if (len(labels) != 0 and len(labels) != len(bindings)) or (len(internal_names) != 0 and len(internal_names) != len(bindings)) or (len(patterns) != 0 and len(patterns) != len(bindings)):
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid normalized field pattern cardinalities")
    mut edits: syntax_problem.Edit[] = []
    for position in range(len(bindings)):
        mut supplied = False
        if len(labels) != 0:
            const label = try graph.get(state.syntax.pool, labels[position])
            supplied = label.kind != 0
        if supplied or position >= len(fields):
            continue
        mut site = name
        const binding = try graph.get(state.syntax.pool, bindings[position])
        if binding.kind != 0:
            site = bindings[position]
        if position < len(patterns):
            const pattern = try graph.field(state.syntax.pool, patterns[position], "pattern")
            site = try graph.field(state.syntax.pool, pattern, "span")
        const location = try problem(state, site, "", "")
        const label_id = try graph.field(state.syntax.pool, fields[position], "name")
        const label = try graph.get(state.syntax.pool, label_id)
        edits.append(syntax_problem.Edit(start=location.start, end=location.start, text=label.data + b"="))
    if len(edits) != 0:
        const rejection = try problem(state, name, "E_NAMED_PATTERN", "payload fields must be supplied by name")
        state.problems.append(syntax_problem.repaired(rejection, edits))
        fail rejection
    if len(labels) == 0:
        const rejection = try problem(state, name, "E_NAMED_PATTERN", "named enum payload fields require labelled patterns")
        fail rejection
    mut ordered: int[] = []
    mut keys: bytes[] = []
    mut seen: bool[] = []
    for field in fields:
        ordered.append(-1)
        keys.append(b"")
        seen.append(False)
    for position in range(len(bindings)):
        const label = try graph.get(state.syntax.pool, labels[position])
        if label.kind == 0:
            const rejection = try problem(state, name, "E_NAMED_PATTERN", "named enum payload fields require labelled patterns")
            fail rejection
        const index = try record_field(state, member.payload, labels[position])
        if seen[index]:
            const rejection = try problem(state, labels[position], "E_DUPLICATE_FIELD", "pattern field is bound more than once")
            fail rejection
        seen[index] = True
        ordered[index] = bindings[position]
        if len(internal_names) != 0:
            const key = try graph.get(state.syntax.pool, internal_names[position])
            keys[index] = key.data
    mut all_discard = True
    for index in range(len(fields)):
        if not seen[index]:
            const rejection = try problem(state, name, "E_PATTERN_PAYLOAD", "pattern must name every enum payload field; use `_` to discard one")
            fail rejection
        const binding = try graph.get(state.syntax.pool, ordered[index])
        if binding.kind != 0:
            all_discard = False
    if all_discard:
        const pending = try variants.requires_handling(state.syntax.pool, state.batch.facts.lists.types.records.rows, member.payload)
        if pending:
            const rejection = try problem(state, name, "E_RESULT_DISCARD", "nested result payload requires a binding and explicit handling")
            fail rejection
        return ArmBinding(slot=-1, prologue=[])
    const slot = try locals.add(mut state.scope, b"", name, member.payload, False, b"local")
    state.scope.active = state.scope.active[:len(state.scope.active) - 1]
    state.scope.locals[slot].usage.temporary = True
    state.scope.locals[slot].usage.reads = 1
    mut prologue: int[] = []
    for index in range(len(fields)):
        const field_type_id = try graph.field(state.syntax.pool, fields[index], "ty")
        const field_type = try graph.number(state.syntax.pool, field_type_id)
        const binding = try graph.get(state.syntax.pool, ordered[index])
        if binding.kind == 0:
            const pending = try variants.requires_handling(state.syntax.pool, state.batch.facts.lists.types.records.rows, field_type)
            if pending:
                const declaration = try graph.field(state.syntax.pool, fields[index], "declaration")
                _ = try fail_related(mut state, name, "E_RESULT_DISCARD", "discarding this field would drop a result-bearing payload; bind it and handle the result", declaration, "result-bearing field declared here")
            continue
        const local = try payload_local(mut state, name, ordered[index], keys[index], field_type)
        const slot_value = try syntax_value.integer(mut state.batch.pool, slot)
        const base = try emission.node(mut state.batch, state.syntax.pool, name, member.payload, b"local", slot_value)
        const base_value = try syntax_value.integer(mut state.batch.pool, base)
        const index_value = try syntax_value.integer(mut state.batch.pool, index)
        const projection = try syntax_value.object(mut state.batch.pool, ["base", "index"], [base_value, index_value])
        const projected = try emission.node(mut state.batch, state.syntax.pool, ordered[index], field_type, b"field", projection)
        const initialized = try emission.store(mut state.batch, local, projected)
        const statement_id = try emission.statement(mut state.batch, state.syntax.pool, ordered[index], False, b"initialize", initialized)
        prologue.append(statement_id)
    return ArmBinding(slot=slot, prologue=prologue)


func match_payload(mut state: State, payload: int, span: int) -> Statement fails syntax_value.Problem:
    const value_id = try graph.field(state.syntax.pool, payload, "value")
    const value_raw = try graph.number(state.syntax.pool, value_id)
    const value = try expression(mut state, value_raw)
    const arms_id = try graph.field(state.syntax.pool, payload, "arms")
    const raw_arms = try graph.items(state.syntax.pool, arms_id)
    const arms = try variant_patterns.normalize(mut state.syntax.pool, mut state.syntax.nodes, mut state.syntax.statements, state.syntax.source, raw_arms)
    const shape = try variants.shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, value.ty)
    if not shape.valid:
        const rejection = try problem(state, span, "E_TYPE", "operation requires an enum or tagged union")
        fail rejection
    mut cover = try variant_patterns.coverage(len(shape.cases))
    const pending_before = try pending_flow.snapshot(state.scope, len(state.scope.locals))
    const init_before = locals_flow.snapshot(state.scope)
    mut pending_continuation: pending_flow.Pending[] = []
    mut init_continuation: bool[] = []
    mut continuation = False
    mut terminates = True
    mut checked_arms: int[] = []
    for position in range(len(arms)):
        const arm = arms[position]
        const active = state.scope.active
        try pending_flow.restore(mut state.scope, pending_before)
        locals_flow.restore(mut state.scope, init_before)
        const name = try graph.field(state.syntax.pool, arm, "name")
        const type_span = try graph.field(state.syntax.pool, arm, "ty")
        const type_text = try graph.spelling(state.syntax.pool, state.syntax.source, type_span)
        const name_text = try graph.spelling(state.syntax.pool, state.syntax.source, name)
        const bindings_id = try graph.field(state.syntax.pool, arm, "bindings")
        const bindings = try graph.items(state.syntax.pool, bindings_id)
        const internal = try graph.field(state.syntax.pool, arm, "internal")
        const wildcard_id = try graph.field(state.syntax.pool, internal, "wildcard")
        const wildcard_value = try graph.get(state.syntax.pool, wildcard_id)
        const wildcard = wildcard_value.integer != 0 or (len(type_text) == 0 and name_text == b"_" and len(bindings) == 0)
        const first_local = len(state.scope.locals)
        mut tags: int[] = []
        mut bound = ArmBinding(slot=-1, prologue=[])
        if wildcard:
            const skip = try variant_patterns.wildcard_before(state.syntax.pool, cover, name, variant_patterns.Wildcard(internal=wildcard_value.integer != 0, last=position + 1 == len(arms)))
            if skip:
                continue
        else:
            const tag = try pattern_tag(mut state, value.ty, arm)
            try variant_patterns.named(state.syntax.pool, mut cover, name, tag, mut state.problems)
            bound = try bind_arm(mut state, shape.cases[tag], arm)
            tags.append(tag)
        const body_id = try graph.field(state.syntax.pool, arm, "body")
        const body_raw = try graph.number(state.syntax.pool, body_id)
        mut body = try statement(mut state, body_raw)
        if len(bound.prologue) != 0:
            mut children = bound.prologue
            children.append(body.id)
            const block = try emission.ids(mut state.batch, children)
            const id = try emission.statement(mut state.batch, state.syntax.pool, span, body.terminates, b"block", block)
            body = Statement(id=id, terminates=body.terminates, looping=body.looping)
        if not body.terminates:
            if not wildcard:
                _ = try obligations.handled(state.syntax.pool, state.batch.facts.lists.types.records.rows, state.scope, first_local, span, mut state.problems)
            if continuation:
                const difference = try pending_flow.mismatch(state.scope, pending_continuation)
                _ = try obligations.consistent(state.syntax.pool, state.scope, difference, span, False, mut state.problems)
                locals_flow.intersect(mut state.scope, init_continuation)
                init_continuation = locals_flow.snapshot(state.scope)
            else:
                const pending = try pending_flow.snapshot(state.scope, len(pending_before))
                pending_continuation = pending
                init_continuation = locals_flow.snapshot(state.scope)
                continuation = True
        terminates = terminates and body.terminates
        if wildcard:
            mut pending_payloads: bool[] = []
            for member in shape.cases:
                const pending = try variants.requires_handling(state.syntax.pool, state.batch.facts.lists.types.records.rows, member.payload)
                pending_payloads.append(pending)
            const uncovered = try variant_patterns.wildcard_after(state.syntax.pool, mut cover, name, pending_payloads)
            tags = uncovered
        for tag in tags:
            const tag_value = try syntax_value.integer(mut state.batch.pool, tag)
            mut slot_value = try syntax_value.absent(mut state.batch.pool)
            if bound.slot >= 0:
                slot_value = try syntax_value.integer(mut state.batch.pool, bound.slot)
            const body_value = try syntax_value.integer(mut state.batch.pool, body.id)
            const checked = try syntax_value.object(mut state.batch.pool, ["tag", "slot", "body"], [tag_value, slot_value, body_value])
            checked_arms.append(checked)
        state.scope.active = active
    mut cases: int[] = []
    for member in shape.cases:
        cases.append(member.row)
    try variant_patterns.complete(state.syntax.pool, cover, cases, span, mut state.problems)
    if continuation:
        try pending_flow.restore(mut state.scope, pending_continuation)
        locals_flow.restore(mut state.scope, init_continuation)
    else:
        locals_flow.restore(mut state.scope, init_before)
    const checked_value = try syntax_value.integer(mut state.batch.pool, value.id)
    const checked_cases = try syntax_value.sequence(mut state.batch.pool, checked_arms)
    const borrowed = try syntax_value.boolean(mut state.batch.pool, False)
    const output = try syntax_value.object(mut state.batch.pool, ["value", "arms", "borrowed"], [checked_value, checked_cases, borrowed])
    const id = try emission.statement(mut state.batch, state.syntax.pool, span, terminates, b"match", output)
    return Statement(id=id, terminates=terminates)


func error_case(state: State, expected: int, actual: int) -> int fails syntax_value.Problem:
    const shape = try variants.shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, expected)
    if not shape.valid or not shape.is_union:
        return -1
    for position in range(len(shape.cases)):
        const member = shape.cases[position]
        if member.payload == actual:
            return position
        if member.fielded and member.payload >= 19:
            const row = record_types.schema(state.batch.facts.lists.types.records, member.payload)
            if row >= 0:
                const fields_id = try graph.field(state.syntax.pool, row, "fields")
                const fields = try graph.items(state.syntax.pool, fields_id)
                if len(fields) == 1:
                    const type_id = try graph.field(state.syntax.pool, fields[0], "ty")
                    const ty = try graph.number(state.syntax.pool, type_id)
                    if ty == actual:
                        return position
    return -1


public func fresh_control() -> Control:
    return Control(next=0, active=[], exited=[], values=Values(yield_type=-1, yield_slot=-1, depth=0, temporaries=[]))


func yields_every_path(state: State, raw_id: int, depth: int) -> bool fails syntax_value.Problem:
    if depth > 256 or raw_id < 0 or raw_id >= len(state.syntax.statements):
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid match expression statement tree")
    const data_id = try graph.field(state.syntax.pool, state.syntax.statements[raw_id], "data")
    const data = try graph.get(state.syntax.pool, data_id)
    const payload = try graph.payload(state.syntax.pool, data_id)
    if data.data == b"yield_value" or data.data == b"ret" or data.data == b"fail":
        return True
    if data.data == b"block":
        const children = try graph.items(state.syntax.pool, payload)
        if len(children) == 0:
            return False
        for position in range(len(children) - 1):
            const child = try graph.number(state.syntax.pool, children[position])
            if child < 0 or child >= len(state.syntax.statements):
                fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid match expression child")
            const child_data_id = try graph.field(state.syntax.pool, state.syntax.statements[child], "data")
            const child_data = try graph.get(state.syntax.pool, child_data_id)
            if child_data.data == b"yield_value":
                return False
        const last = try graph.number(state.syntax.pool, children[len(children) - 1])
        return try yields_every_path(state, last, depth + 1)
    if data.data == b"branch":
        const then_id = try graph.field(state.syntax.pool, payload, "then_body")
        const then_body = try graph.number(state.syntax.pool, then_id)
        const then_yields = try yields_every_path(state, then_body, depth + 1)
        const else_id = try graph.field(state.syntax.pool, payload, "else_body")
        const else_value = try graph.get(state.syntax.pool, else_id)
        if not then_yields or else_value.kind == 0:
            return False
        const else_body = try graph.number(state.syntax.pool, else_id)
        return try yields_every_path(state, else_body, depth + 1)
    return False


func fielded_variant(mut state: State, ty: int, tag: int, span: int, name: int, arguments: int[], labels: int[]) -> Expression fails syntax_value.Problem:
    const catalog = state.batch.facts.lists.types.records
    const shape = try variants.shape(state.syntax.pool, catalog.rows, ty)
    const member = shape.cases[tag]
    if member.payload < 0:
        _ = try fail_related(mut state, span, "E_VARIANT_PAYLOAD", "this case carries no payload, so it is constructed without parentheses", member.declaration, "variant declared here")
    const declaration = catalog.by_type[ty]
    if declaration < 0:
        const rejection = try problem(state, span, "P_BODY_PROFILE", "fielded builtin variant template is outside the body profile")
        fail rejection
    const cases_id = try graph.field(state.syntax.pool, catalog.declarations[declaration], "cases")
    const cases = try graph.items(state.syntax.pool, cases_id)
    const fields_id = try graph.field(state.syntax.pool, cases[tag], "fields")
    const fields = try graph.items(state.syntax.pool, fields_id)
    const initializers = try variant_construct.bind(state.syntax.pool, state.syntax.nodes, fields, variant_construct.Input(source=state.syntax.source, name=name, span=span, arguments=arguments, argument_names=labels), mut state.problems)
    const values = try record_initializers(mut state, member.payload, span, initializers)
    const value = try emission.node(mut state.batch, state.syntax.pool, span, member.payload, b"record", values)
    const checked_tag = try syntax_value.integer(mut state.batch.pool, tag)
    const checked_value = try syntax_value.integer(mut state.batch.pool, value)
    const payload = try syntax_value.object(mut state.batch.pool, ["tag", "value"], [checked_tag, checked_value])
    const id = try emission.node(mut state.batch, state.syntax.pool, span, ty, b"variant", payload)
    return Expression(id=id, ty=ty)


func parse_integer_access(mut state: State, span: int, base: Expression, owner: int, site: int, argument_count: int) -> Expression fails syntax_value.Problem:
    if base.ty != state.batch.facts.string_type and base.ty != state.batch.facts.bytes_type:
        const rejection = try problem(state, span, "P_BODY_PROFILE", "integer parsing receiver is outside the managed sequence profile")
        fail rejection
    if owner < 0 and base.ty == state.batch.facts.bytes_type and base.id >= 0:
        const node_data_id = try graph.field(state.batch.pool, state.batch.nodes[base.id], "data")
        const node_data = try graph.get(state.batch.pool, node_data_id)
        if node_data.data == b"block_value":
            const block = try graph.payload(state.batch.pool, node_data_id)
            const value_id = try graph.field(state.batch.pool, block, "value")
            const value = try graph.number(state.batch.pool, value_id)
            const operation_id = try graph.field(state.batch.pool, state.batch.nodes[value], "data")
            const operation = try graph.get(state.batch.pool, operation_id)
            if operation.data == b"buffer_operation":
                const operation_payload = try graph.payload(state.batch.pool, operation_id)
                const kind_id = try graph.field(state.batch.pool, operation_payload, "kind")
                const kind = try graph.get(state.batch.pool, kind_id)
                if kind.data == b"slice" or kind.data == b"view":
                    const rejection = try problem(state, span, "P_BODY_PROFILE", "fused byte range parsing is outside the admitted byte closure")
                    fail rejection
    if owner >= 0:
        _ = try require_readable(mut state, owner, site)
    mut receiver = "str"
    if base.ty == state.batch.facts.bytes_type:
        receiver = "bytes"
    if argument_count != 0:
        const rejection = try problem(state, span, "E_ARITY", "`" + receiver + ".parse_int() -> Option[int]` takes 0 arguments, but this call passes " + str(argument_count))
        fail rejection
    const ty = try list_types.union_intern(mut state.batch.facts.lists, mut state.syntax.pool, 0, -1, site, False)
    const context = list_lower.Context(input=state.syntax.pool, span=span)
    if owner >= 0:
        state.scope.locals[owner].usage.reads = state.scope.locals[owner].usage.reads + 1
        const id = try list_lower.operation(mut state.batch, context, list_lower.Operation(owner=owner, kind=b"parse_int", arguments=[], ty=ty))
        return Expression(id=id, ty=ty)
    const lowered = try list_lower.access(mut state.batch, mut state.scope, context, list_lower.Access(base=base.id, owner_type=base.ty, kind=b"parse_int", arguments=[], result_type=ty, signed_length=False))
    const id = try list_lower.append(mut state.batch, context, lowered)
    return Expression(id=id, ty=ty)


func sequence_type(state: State, ty: int) -> bool:
    return ty >= 19 and (ty == state.batch.facts.string_type or ty == state.batch.facts.bytes_type or ty == state.batch.facts.lists.types.buffer.id)


func sequence_method(mut state: State, span: int, name: int, owner_span: int, owner: int, base: Expression, spelling: bytes, inputs: int[]) -> Expression fails syntax_value.Problem:
    mut kind = spelling
    mut arity = 2
    mut signature = "(start: int, end: int) -> " + type_name(state, base.ty)
    mut mutates = False
    mut result_type = base.ty
    if spelling == b"reserve":
        kind = b"buffer_reserve"
        arity = 1
        signature = "(extra: int) -> bool"
        mutates = True
        result_type = 1
    elif spelling == b"append_byte":
        kind = b"buffer_append_byte"
        arity = 1
        signature = "(value: int) -> bool"
        mutates = True
        result_type = 1
    elif spelling == b"append_range":
        kind = b"buffer_append_range"
        arity = 3
        signature = "(data: bytes, start: int, end: int) -> bool"
        mutates = True
        result_type = 1
    elif spelling != b"view":
        if spelling == b"write" or spelling == b"read":
            const rejection = try problem(state, name, "E_LIST_METHOD", "unknown method for a byte_buffer receiver; accepted methods: append_byte, append_float, append_int, append_range, append_utf8, copy, count, decode, endswith, find, find_any, hex, index, join, lstrip, parse_float, parse_float_range, parse_int, parse_int_range, reserve, rfind, rindex, rstrip, scalar_count, scalar_count_range, split, startswith, strip, to_list, view")
            fail rejection
        const rejection = try problem(state, span, "P_BODY_PROFILE", "sequence method is outside the admitted byte closure")
        fail rejection
    if owner >= 0:
        _ = try require_readable(mut state, owner, owner_span)
    if arity != len(inputs):
        mut plural = "s"
        if arity == 1:
            plural = ""
        const method_name = try suggestions.text(spelling)
        const rejection = try problem(state, span, "E_ARITY", "`" + type_name(state, base.ty) + "." + method_name + signature + "` takes " + str(arity) + " argument" + plural + ", but this call passes " + str(len(inputs)))
        fail rejection
    mut arguments: int[] = []
    mut types: int[] = []
    for input in inputs:
        const raw_id = try graph.number(state.syntax.pool, input)
        const value = try expression(mut state, raw_id)
        arguments.append(value.id)
        types.append(value.ty)
    if owner >= 0:
        state.scope.locals[owner].usage.reads = state.scope.locals[owner].usage.reads + 1
        if mutates:
            if not state.scope.locals[owner].mutable:
                const rejection = try problem(state, owner_span, "E_IMMUTABLE", "collection update requires a writable binding")
                fail rejection
            state.scope.locals[owner].usage.writes = state.scope.locals[owner].usage.writes + 1
    elif mutates:
        const rejection = try problem(state, span, "P_BODY_PROFILE", "mutation through temporary sequence receivers is outside the body profile")
        fail rejection
    if mutates and base.ty != state.batch.facts.lists.types.buffer.id:
        const rejection = try problem(state, owner_span, "E_COLLECTION_METHOD", "in-place buffer methods require a byte_buffer receiver")
        fail rejection
    for position in range(len(arguments)):
        if spelling == b"append_range" and position == 0:
            if types[position] != state.batch.facts.bytes_type and types[position] != state.batch.facts.lists.types.buffer.id:
                const rejection = try problem(state, owner_span, "E_COLLECTION_METHOD", "append_range requires a bytes or byte_buffer source")
                fail rejection
        elif types[position] != 0 and types[position] != 5 and types[position] != 7 and types[position] != 8:
            const rejection = try problem(state, owner_span, "E_TYPE", "operation requires an integer type")
            fail rejection
    if spelling == b"view" and base.ty != state.batch.facts.bytes_type:
        const rejection = try problem(state, owner_span, "E_COLLECTION_METHOD", "view requires an immutable bytes receiver")
        fail rejection
    const context = list_lower.Context(input=state.syntax.pool, span=span)
    if owner >= 0:
        const id = try list_lower.operation(mut state.batch, context, list_lower.Operation(owner=owner, kind=kind, arguments=arguments, ty=result_type))
        return Expression(id=id, ty=result_type)
    const lowered = try list_lower.access(mut state.batch, mut state.scope, context, list_lower.Access(base=base.id, owner_type=base.ty, kind=kind, arguments=arguments, result_type=result_type, signed_length=False))
    const id = try list_lower.append(mut state.batch, context, lowered)
    return Expression(id=id, ty=result_type)
