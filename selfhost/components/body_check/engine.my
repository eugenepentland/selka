    const id = try list_lower.append(mut state.batch, context, lowered)
    return Expression(id=id, ty=ty)


func sequence_type(state: State, ty: int) -> bool:
    return ty >= 19 and (ty == state.batch.facts.string_type or ty == state.batch.facts.bytes_type or ty == state.batch.facts.lists.types.buffer.id)


func sequence_method(mut state: State, span: int, name: int, owner_span: int, owner: int, base: Expression, spelling: bytes, inputs: int[]) -> Expression fails syntax_value.Problem:
    mut kind = spelling
    mut arity = 2
    mut signature = "(start: int, end: int) -> " + type_name(state, base.ty)
    mut mutates = False
    mut result_type = base.ty
    if spelling == b"reserve":
        kind = b"buffer_reserve"
        arity = 1
        signature = "(extra: int) -> bool"
        mutates = True
        result_type = 1
    elif spelling == b"append_byte":
        kind = b"buffer_append_byte"
        arity = 1
        signature = "(value: int) -> bool"
        mutates = True
        result_type = 1
    elif spelling == b"append_range":
        kind = b"buffer_append_range"
        arity = 3
        signature = "(data: bytes, start: int, end: int) -> bool"
        mutates = True
        result_type = 1
    elif spelling != b"view":
        if spelling == b"write" or spelling == b"read":
            const rejection = try problem(state, name, "E_LIST_METHOD", "unknown method for a byte_buffer receiver; accepted methods: append_byte, append_float, append_int, append_range, append_utf8, copy, count, decode, endswith, find, find_any, hex, index, join, lstrip, parse_float, parse_float_range, parse_int, parse_int_range, reserve, rfind, rindex, rstrip, scalar_count, scalar_count_range, split, startswith, strip, to_list, view")
            fail rejection
