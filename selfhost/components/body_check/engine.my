            const payload = try graph.payload(state.batch.pool, data_id)
            const original_span = try graph.field(state.batch.pool, original, "span")
            const copied_span = try graph.clone(mut state.syntax.pool, state.batch.pool, original_span, 0)
            const id = try emission.node(mut state.batch, state.syntax.pool, copied_span, base.ty, data.data, payload)
            return Expression(id=id, ty=base.ty)
        const lowered = try option_lower.default_value(mut state.batch, mut state.scope, context, base.id, option_lower.Shape(owner_type=base.ty, element=element, some=shape.some, none=shape.none), fallback.id)
        const id = try list_lower.append(mut state.batch, context, lowered)
