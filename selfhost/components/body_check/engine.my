        state.scope.locals[slot].usage.reads = 1
        state.control.values = Values(yield_type=expected, yield_slot=slot, depth=0, temporaries=[], gathers=saved.gathers, counters=saved.counters)
        const body = try match_payload(mut state, payload, span)
        const result_type = state.control.values.yield_type
        if result_type < 0:
            const rejection = try problem(state, span, "E_MATCH_YIELD", "match expression requires at least one yielded value")
            fail rejection
        const slot_value = try syntax_value.integer(mut state.batch.pool, slot)
        const local = try emission.node(mut state.batch, state.syntax.pool, span, result_type, b"local", slot_value)
        state.scope.locals[slot].usage.transfer_available = False
        state.control.values = saved
        const body_value = try syntax_value.integer(mut state.batch.pool, body.id)
        const local_value = try syntax_value.integer(mut state.batch.pool, local)
        result_payload = try syntax_value.object(mut state.batch.pool, ["body", "value"], [body_value, local_value])
        const id = try emission.node(mut state.batch, state.syntax.pool, span, result_type, b"block_value", result_payload)
        state.batch.resolved[raw_id] = id
        state.depth = state.depth - 1
        return Expression(id=id, ty=result_type)
    elif data.data == b"propagate":
        const operand = try graph.number(state.syntax.pool, payload)
        const value = try expression(mut state, operand)
        const input_result = try variants.result_shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, value.ty)
        if input_result.valid:
            const output_result = try variants.result_shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, state.return_type)
            if not output_result.valid:
                const rejection = try problem(state, span, "E_TRY_RETURN", "try requires a function returning a declared result type")
                fail rejection
            if input_result.failure != output_result.failure:
                const wrapper = try error_case(state, output_result.failure, input_result.failure)
                if wrapper < 0:
                    _ = try require(state, input_result.failure, output_result.failure, span)
            ty = input_result.success
        else:
            const input_option = try variants.option_shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, value.ty)
            if not input_option.valid:
                const rejection = try problem(state, span, "E_TRY_TYPE", "try requires a Result or optional value")
                fail rejection
            const output_option = try variants.option_shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, state.return_type)
            if not output_option.valid:
                const rejection = try problem(state, span, "E_TRY_RETURN", "optional try requires an optional return type")
                fail rejection
            ty = input_option.element
        _ = try obligations.handled(state.syntax.pool, state.batch.facts.lists.types.records.rows, state.scope, 0, span, mut state.problems)
        for position in range(len(state.control.values.temporaries) - 1):
            const pending = try variants.requires_handling(state.syntax.pool, state.batch.facts.lists.types.records.rows, state.control.values.temporaries[position])
            if pending:
                const rejection = try problem(state, span, "E_RESULT_PROPAGATION", "propagation could drop a pending result temporary; handle or transfer it before this expression")
                fail rejection
        const checked_value = try syntax_value.integer(mut state.batch.pool, value.id)
        const output = try syntax_value.integer(mut state.batch.pool, state.return_type)
        result_payload = try syntax_value.object(mut state.batch.pool, ["value", "output"], [checked_value, output])
    elif data.data == b"binary":
        const op_id = try graph.field(state.syntax.pool, payload, "op")
        const op = try graph.get(state.syntax.pool, op_id)
        const left_id = try graph.field(state.syntax.pool, payload, "left")
        const right_id = try graph.field(state.syntax.pool, payload, "right")
        const left_raw = try graph.number(state.syntax.pool, left_id)
        const right_raw = try graph.number(state.syntax.pool, right_id)
        const operator_span = try graph.field(state.syntax.pool, payload, "op_span")
        const chained_id = try graph.field(state.syntax.pool, payload, "chained")
        const chained = try graph.get(state.syntax.pool, chained_id)
        if chained.integer != 0:
            const result = try comparison_chain(mut state, raw_id, span)
            state.batch.resolved[raw_id] = result.id
            state.depth = state.depth - 1
            return result
        if (len(op.data) >= 3 and op.data[:3] == b"f64"):
            const rejection = try problem(state, span, "P_BODY_PROFILE", "binary operation is outside the B1 scalar profile")
            fail rejection
        mut sequence_constructor = False
        if op.data == b"mul":
            for operand in [left_raw, right_raw]:
                const operand_data_id = try graph.field(state.syntax.pool, state.syntax.nodes[operand], "data")
                const operand_data = try graph.get(state.syntax.pool, operand_data_id)
                if operand_data.data == b"list_literal" or operand_data.data == b"comprehension":
                    sequence_constructor = True
                    const context_type = state.batch.facts.expected[raw_id]
                    if list_types.element_type(state.batch.facts.lists, context_type) >= 0:
                        state.batch.facts.expected[operand] = context_type
        if not sequence_constructor:
            mut obvious = try obvious_type(state, left_raw, 0)
            if obvious < 0:
                obvious = try obvious_type(state, right_raw, 0)
            if obvious < 0:
                obvious = state.batch.facts.expected[raw_id]
            if scalars.is_integer(obvious) or (state.batch.facts.float_type >= 0 and obvious == state.batch.facts.float_type):
                state.batch.facts.expected[left_raw] = obvious
                state.batch.facts.expected[right_raw] = obvious
            elif op.data == b"eq" or op.data == b"ne":
                const left_hint = try obvious_type(state, left_raw, 0)
                const right_hint = try obvious_type(state, right_raw, 0)
                if left_hint >= 0:
                    state.batch.facts.expected[right_raw] = left_hint
                if right_hint >= 0:
                    state.batch.facts.expected[left_raw] = right_hint
        mut left = try expression(mut state, left_raw)
        const pending_checkpoint = try pending_flow.snapshot(state.scope, len(state.scope.locals))
        const options_checkpoint = option_flow.snapshot(state.control.options)
        if op.data == b"logical_and" or op.data == b"logical_or":
            try option_flow.assume(mut state.control.options, option_context(state), state.scope, option_flow.Guard(condition=left_raw, truth=op.data == b"logical_and"))
        mut right = try expression(mut state, right_raw)
        if op.data == b"logical_and" or op.data == b"logical_or":
            option_flow.restore(mut state.control.options, options_checkpoint)
            const difference = try pending_flow.mismatch(state.scope, pending_checkpoint)
            const right_span = try graph.field(state.syntax.pool, state.syntax.nodes[right_raw], "span")
            _ = try obligations.consistent(state.syntax.pool, state.scope, difference, right_span, False, mut state.problems)
        const result = try binary_values(mut state, BinaryRequest(span=span, operator_span=operator_span, op=op.data, chain=False), left, right)
        state.batch.resolved[raw_id] = result.id
        state.depth = state.depth - 1
        return result
    else:
        const rejection = try problem(state, span, "P_BODY_PROFILE", "body expression is outside the B1 scalar profile")
        fail rejection
    const id = try emission.node(mut state.batch, state.syntax.pool, span, ty, data.data, result_payload)
    state.batch.resolved[raw_id] = id
    state.depth = state.depth - 1
    return Expression(id=id, ty=ty)


func chain_obvious(state: State, raw: int) -> int fails syntax_value.Problem:
    const obvious = try obvious_type(state, raw, 0)
    if obvious >= 0:
        return obvious
    const data_id = try graph.field(state.syntax.pool, state.syntax.nodes[raw], "data")
    const data = try graph.get(state.syntax.pool, data_id)
    if data.data == b"integer":
        const token = try graph.payload(state.syntax.pool, data_id)
        const spelling = try graph.spelling(state.syntax.pool, state.syntax.source, token)
        if floating_literals.spelling(spelling):
            return state.batch.facts.float_type
    return -1


func chain_hint(mut state: State, left_raw: int, right_raw: int, op: bytes) -> Unit fails syntax_value.Problem:
    mut obvious = try chain_obvious(state, left_raw)
    if obvious < 0:
        obvious = try chain_obvious(state, right_raw)
    if scalars.is_integer(obvious) or (state.batch.facts.float_type >= 0 and obvious == state.batch.facts.float_type):
        state.batch.facts.expected[left_raw] = obvious
        state.batch.facts.expected[right_raw] = obvious
    elif op == b"eq" or op == b"ne" or collection_types.schema(state.batch.facts.lists.types.collections, obvious).kind == 1:
        const left_hint = try chain_obvious(state, left_raw)
        const right_hint = try chain_obvious(state, right_raw)
        if left_hint >= 0:
            state.batch.facts.expected[right_raw] = left_hint
        if right_hint >= 0:
            state.batch.facts.expected[left_raw] = right_hint


func awaits_peer(state: State, raw: int) -> bool fails syntax_value.Problem:
    if state.batch.facts.expected[raw] >= 0:
        return False
    const data_id = try graph.field(state.syntax.pool, state.syntax.nodes[raw], "data")
    const data = try graph.get(state.syntax.pool, data_id)
    if data.data == b"unit":
        return True
    if data.data != b"call":
        return False
    const call = try graph.payload(state.syntax.pool, data_id)
    const owner_id = try graph.field(state.syntax.pool, call, "owner")
    const owner = try graph.get(state.syntax.pool, owner_id)
    const arguments_id = try graph.field(state.syntax.pool, call, "type_arguments")
    const arguments = try graph.items(state.syntax.pool, arguments_id)
    if owner.kind != 0 or len(arguments) != 0:
        return False
    const name = try graph.field(state.syntax.pool, call, "name")
    const spelling = try graph.spelling(state.syntax.pool, state.syntax.source, name)
    if spelling != b"Some" and spelling != b"Ok" and spelling != b"Err":
        return False
    const declared = try top_level(state, name)
    return locals.find(state.scope, spelling) < 0 and not declared


func comparison_chain(mut state: State, raw: int, span: int) -> Expression fails syntax_value.Problem:
    const plan = try chained_compare.plan(state.syntax.pool, state.syntax.nodes, raw)
    for position in range(len(plan.links)):
        try chain_hint(mut state, plan.operands[position], plan.operands[position + 1], plan.links[position].op)
    mut checked: Expression[] = []
    const equality = plan.links[0].op == b"eq" or plan.links[0].op == b"ne"
    const left_awaits = try awaits_peer(state, plan.operands[0])
    const right_awaits = try awaits_peer(state, plan.operands[1])
    mut start = 1
    if equality and left_awaits and not right_awaits:
        const right = try expression(mut state, plan.operands[1])
        const left = try expression_expected(mut state, plan.operands[0], right.ty)
        checked.append(left)
        checked.append(right)
        start = 2
    else:
        const first = try expression(mut state, plan.operands[0])
        checked.append(first)
    for position in range(start, len(plan.operands)):
        const op = plan.links[position - 1].op
        const peer = try awaits_peer(state, plan.operands[position])
        mut value = Expression(id=-1, ty=-1)
        if (op == b"eq" or op == b"ne") and peer:
            value = try expression_expected(mut state, plan.operands[position], checked[position - 1].ty)
        else:
            value = try expression(mut state, plan.operands[position])
        checked.append(value)
    mut types: int[] = []
    mut inputs: int[] = []
    for value in checked:
        types.append(value.ty)
        inputs.append(value.id)
    const context = list_lower.Context(input=state.syntax.pool, span=span)
    const storage = try chained_compare.reserve(mut state.scope, context, types)
    mut tail = -1
    mut position = len(plan.links)
    while position > 0:
        position -= 1
        const link = plan.links[position]
        mut right = checked[position + 1]
        if position + 1 < len(plan.links):
            const read = try list_lower.read(mut state.batch, context, storage.slots[position + 1], checked[position + 1].ty)
            right = Expression(id=read, ty=checked[position + 1].ty)
        const left_id = try list_lower.read(mut state.batch, context, storage.slots[position], checked[position].ty)
        const left = Expression(id=left_id, ty=checked[position].ty)
        const comparison = try binary_values(mut state, BinaryRequest(span=link.span, operator_span=link.operator_span, op=link.op, chain=True), left, right)
        # Native chainBlock appends binaryValue's data using the whole-chain span.
        const node = state.batch.nodes[comparison.id]
        const node_type = try graph.field(state.batch.pool, node, "ty")
        const node_data = try graph.field(state.batch.pool, node, "data")
        const whole_span = try graph.clone(mut state.batch.pool, state.syntax.pool, span, 0)
        const replaced = try syntax_value.object(mut state.batch.pool, ["ty", "span", "data"], [node_type, whole_span, node_data])
        state.batch.nodes[comparison.id] = replaced
        tail = try chained_compare.link_block(mut state.batch, context, storage, inputs, chained_compare.Step(position=position, comparison=comparison.id, tail=tail))
    const result = try chained_compare.finish(mut state.batch, context, storage, checked[0].id, tail)
    const id = try list_lower.append(mut state.batch, context, result)
    return Expression(id=id, ty=1)


record BinaryRequest:
    span: int
    operator_span: int
    op: bytes
    chain: bool


func binary_values(mut state: State, request: BinaryRequest, first: Expression, second: Expression) -> Expression fails syntax_value.Problem:
    const span = request.span
    mut left = first
    mut right = second
    mut ty = 15
    mut result_payload = -1
    if request.op == b"mul" and ((repeatable_type(state, left.ty) and right.ty == 0) or (left.ty == 0 and repeatable_type(state, right.ty))):
        mut sequence = left
        mut count = right
        mut count_first = False
        if left.ty == 0:
            sequence = right
            count = left
            count_first = True
        mut gathered_type = -1
        if list_types.element_type(state.batch.facts.lists, sequence.ty) < 0:
            gathered_type = try list_types.intern(mut state.batch.facts.lists, state.syntax.pool, list_types.Recipe(id=0, element=sequence.ty, span=span), [state.batch.facts.string_type, state.batch.facts.bytes_type])
        const lowered = try list_repeat.build(mut state.batch, mut state.scope, list_lower.Context(input=state.syntax.pool, span=span), list_repeat.Input(sequence=sequence.id, count=count.id, ty=sequence.ty, count_first=count_first, loop_id=state.control.next, gathered_type=gathered_type))
        state.control.next = state.control.next + 1
        const id = try list_lower.append(mut state.batch, list_lower.Context(input=state.syntax.pool, span=span), lowered)
        return Expression(id=id, ty=sequence.ty)
    if (managed(state, left.ty) or (state.batch.facts.float_type >= 0 and left.ty == state.batch.facts.float_type)) and collection_types.schema(state.batch.facts.lists.types.collections, left.ty).kind != 1:
        const spelling = try graph.spelling(state.syntax.pool, state.syntax.source, request.operator_span)
        mut builtin = ""
        mut operator = ""
        if spelling == b"|":
            builtin = "bit_or"
            operator = "|"
        elif spelling == b"&":
            builtin = "bit_and"
            operator = "&"
        elif spelling == b"^":
            builtin = "bit_xor"
            operator = "^"
        if len(builtin) != 0:
            const rejection = try problem(state, request.operator_span, "E_SET_OPERATOR", "`" + operator + "` combines two sets or two integers (`" + builtin + "(a, b)`)")
            fail rejection
    if state.batch.facts.float_type >= 0 and (request.op == b"python_div" or left.ty == state.batch.facts.float_type or right.ty == state.batch.facts.float_type):
        const promotion_context = list_lower.Context(input=state.syntax.pool, span=request.operator_span)
        if scalars.is_integer(left.ty):
            const converted = try numeric_lower.from_integer(mut state.batch, promotion_context, left.id, left.ty)
            const id = try list_lower.append(mut state.batch, promotion_context, converted)
            left = Expression(id=id, ty=converted.ty)
        if scalars.is_integer(right.ty):
            const converted = try numeric_lower.from_integer(mut state.batch, promotion_context, right.id, right.ty)
            const id = try list_lower.append(mut state.batch, promotion_context, converted)
            right = Expression(id=id, ty=converted.ty)
        _ = try require(state, right.ty, left.ty, request.operator_span)
        if left.ty == state.batch.facts.float_type:
            const context = list_lower.Context(input=state.syntax.pool, span=span)
            const lowered = try numeric_lower.binary(mut state.batch, mut state.scope, context, request.op, left.id, right.id)
            const id = try list_lower.append(mut state.batch, context, lowered)
            return Expression(id=id, ty=lowered.ty)
    _ = try require(state, right.ty, left.ty, request.operator_span)
    const left_collection = collection_types.schema(state.batch.facts.lists.types.collections, left.ty)
    if left_collection.kind == 1 and request.op != b"eq" and request.op != b"ne":
        mut kind = b""
        mut relation = False
        if request.op == b"bit_or":
            kind = b"union"
        elif request.op == b"bit_and":
            kind = b"intersection"
        elif request.op == b"sub":
            kind = b"difference"
        elif request.op == b"bit_xor":
            kind = b"symmetric_difference"
        elif request.op == b"le":
            kind = b"subset"
            relation = True
        elif request.op == b"lt":
            kind = b"proper_subset"
            relation = True
        elif request.op == b"ge":
            kind = b"superset"
            relation = True
        elif request.op == b"gt":
            kind = b"proper_superset"
            relation = True
        else:
            const rejection = try problem(state, request.operator_span, "E_SET_OPERATOR", "sets combine with `|`, `&`, `-` and `^`, compare with `<=`, `<`, `>=` and `>`, and test equality with `==`")
            fail rejection
        const context = list_lower.Context(input=state.syntax.pool, span=request.operator_span)
        const set_request = set_lower.Binary(ty=left.ty, element=left_collection.key, left=left.id, right=right.id, kind=kind, loop_id=state.control.next)
        mut combined = set_lower.Combined(value=list_lower.Lowered(ty=left.ty, tag=b"", payload=-1), next_loop=state.control.next)
        if relation:
            const result = try set_lower.relation(mut state.batch, mut state.scope, context, set_request)
            combined = result
        else:
            const result = try set_lower.combine(mut state.batch, mut state.scope, context, set_request)
            combined = result
        state.control.next = combined.next_loop
        const id = try list_lower.append(mut state.batch, context, combined.value)
        return Expression(id=id, ty=combined.value.ty)
    if request.op == b"eq" or request.op == b"ne":
        const supported = try record_types.equality(state.syntax.pool, state.batch.facts.lists.types.records, state.batch.facts.lists.elements, left.ty, [state.batch.facts.string_type, state.batch.facts.bytes_type, state.batch.facts.lists.types.buffer.id], [])
        if not supported:
            const rejection = try problem(state, request.operator_span, "E_TYPE", "aggregate equality is not defined; compare the relevant elements explicitly")
            fail rejection
    ty = left.ty
    if managed(state, left.ty):
        if (list_types.element_type(state.batch.facts.lists, left.ty) >= 0 or left_collection.kind == 0 or left_collection.kind == 1) and request.op != b"eq" and request.op != b"ne":
            const rejection = try problem(state, request.operator_span, "E_TEXT_OPERATOR", "managed collections support equality; str and bytes also support `+` and `<`, `<=`, `>`, `>=`")
            fail rejection
        if request.op == b"add":
            ty = left.ty
        elif request.op == b"eq" or request.op == b"ne" or request.op == b"lt" or request.op == b"le" or request.op == b"gt" or request.op == b"ge":
            ty = 1
        else:
            const rejection = try problem(state, request.operator_span, "E_TEXT_OPERATOR", "managed collections support equality; str and bytes also support `+` and `<`, `<=`, `>`, `>=`")
            fail rejection
    elif request.op == b"logical_and" or request.op == b"logical_or":
        _ = try require(state, left.ty, 1, request.operator_span)
        ty = 1
    elif request.op == b"eq" or request.op == b"ne":
        ty = 1
    else:
        if not scalars.is_integer(left.ty):
            const rejection = try problem(state, request.operator_span, "E_TYPE", "operation requires an integer type")
            fail rejection
        if request.op == b"lt" or request.op == b"le" or request.op == b"gt" or request.op == b"ge":
            ty = 1
    const typed_op = try syntax_value.enumeration(mut state.batch.pool, request.op)
    const typed_left = try syntax_value.integer(mut state.batch.pool, left.id)
    const typed_right = try syntax_value.integer(mut state.batch.pool, right.id)
    const typed_span = try graph.clone(mut state.batch.pool, state.syntax.pool, request.operator_span, 0)
    result_payload = try syntax_value.object(mut state.batch.pool, ["op", "left", "right", "op_span"], [typed_op, typed_left, typed_right, typed_span])
    const id = try emission.node(mut state.batch, state.syntax.pool, span, ty, b"binary", result_payload)
    return Expression(id=id, ty=ty)


public func expression_expected(mut state: State, raw_id: int, expected: int) -> Expression fails syntax_value.Problem:
    if raw_id < 0 or raw_id >= len(state.syntax.nodes):
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid expected expression index")
    if len(state.batch.facts.expected) != len(state.syntax.nodes):
        state.batch.facts.expected = []
        for node in state.syntax.nodes:
            state.batch.facts.expected.append(-1)
    state.batch.facts.expected[raw_id] = expected
    return try expression(mut state, raw_id)


public func statement(mut state: State, raw_id: int) -> Statement fails syntax_value.Problem:
    if raw_id < 0 or raw_id >= len(state.syntax.statements):
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid statement index")
    const data_id = try graph.field(state.syntax.pool, state.syntax.statements[raw_id], "data")
    const data = try graph.get(state.syntax.pool, data_id)
    const payload = try graph.payload(state.syntax.pool, data_id)
    const scoped_options = data.data == b"loop" or data.data == b"for_each" or data.data == b"for_range" or data.data == b"match"
    if data.data == b"match":
        const arms_id = try graph.field(state.syntax.pool, payload, "arms")
        const arms = try graph.items(state.syntax.pool, arms_id)
        for arm in arms:
            const body_id = try graph.field(state.syntax.pool, arm, "body")
            const body = try graph.number(state.syntax.pool, body_id)
            try option_flow.invalidate_writes(mut state.control.options, option_context(state), state.scope, body)
    elif scoped_options:
        const body_id = try graph.field(state.syntax.pool, payload, "body")
        const body = try graph.number(state.syntax.pool, body_id)
        try option_flow.invalidate_writes(mut state.control.options, option_context(state), state.scope, body)
    const options_before = option_flow.snapshot(state.control.options)
    const checked = try checked_statement(mut state, raw_id)
    if scoped_options:
        option_flow.restore(mut state.control.options, options_before)
    const context = mutation_places.Context(pool=state.syntax.pool, source=state.syntax.source, nodes=state.syntax.nodes, typed_pool=state.batch.pool, typed_nodes=state.batch.nodes, resolved=state.batch.resolved)
    const diagnostics = try receiver_overlap.check(context, state.syntax.statements[raw_id], state.scope)
    if len(diagnostics) != 0:
        for diagnostic in diagnostics:
            state.problems.append(diagnostic)
        fail diagnostics[0].problem
    return checked


func checked_statement(mut state: State, raw_id: int) -> Statement fails syntax_value.Problem:
    if raw_id < 0 or raw_id >= len(state.syntax.statements):
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid statement index")
    if state.depth >= 256:
        fail syntax_value.Problem(code="P_BODY_LIMIT", start=0, end=0, message="body statement depth exceeded")
    state.depth = state.depth + 1
    const raw = state.syntax.statements[raw_id]
    const span = try graph.field(state.syntax.pool, raw, "span")
    const data_id = try graph.field(state.syntax.pool, raw, "data")
    const data = try graph.get(state.syntax.pool, data_id)
    const payload = try graph.payload(state.syntax.pool, data_id)
    if data.data == b"block":
        return try checked_block(mut state, span, payload)
    return try checked_statement_value(mut state, raw_id, span, payload, data.data)


func checked_block(mut state: State, span: int, payload: int) -> Statement fails syntax_value.Problem:
    const first_local = len(state.scope.locals)
    const active = state.scope.active
    const children = try graph.items(state.syntax.pool, payload)
    mut checked: int[] = []
    mut terminates = False
    mut looping = False
    for child in children:
        const child_id = try graph.number(state.syntax.pool, child)
        if terminates and not looping:
            const child_raw = state.syntax.statements[child_id]
            const child_span = try graph.field(state.syntax.pool, child_raw, "span")
            const rejection = try problem(state, child_span, "E_UNREACHABLE", "statement follows a structurally terminating statement")
            fail rejection
        const result = try statement(mut state, child_id)
        checked.append(result.id)
        terminates = result.terminates
        looping = result.looping
    if not terminates:
        _ = try obligations.handled(state.syntax.pool, state.batch.facts.lists.types.records.rows, state.scope, first_local, span, mut state.problems)
    option_flow.end_scope(mut state.control.options, first_local)
    state.scope.active = active
    const payload_out = try emission.ids(mut state.batch, checked)
    const id = try emission.statement(mut state.batch, state.syntax.pool, span, terminates, b"block", payload_out)
    state.depth = state.depth - 1
    return Statement(id=id, terminates=terminates, looping=looping)


func checked_statement_value(mut state: State, raw_id: int, span: int, payload: int, initial_tag: bytes) -> Statement fails syntax_value.Problem:
    mut terminates = False
    mut looping = False
    mut result_payload = -1
    mut tag = initial_tag
    if tag == b"gather_step":
        const lowered = try gather_step(mut state, payload, span)
        tag = lowered.tag
        result_payload = lowered.payload
    elif tag == b"with_scope":
        const resource_id = try graph.field(state.syntax.pool, payload, "resource")
        const resource = try graph.get(state.syntax.pool, resource_id)
        if resource.kind == 0:
            const rejection = try problem(state, span, "P_BODY_PROFILE", "arena scopes are outside the file resource profile")
            fail rejection
        const resource_raw = try graph.number(state.syntax.pool, resource_id)
        const previous_open = state.control.values.trapping_open
        state.control.values.trapping_open = resource_raw
        const value = try expression(mut state, resource_raw)
        state.control.values.trapping_open = previous_open
        if value.ty != 16 and value.ty != 17:
            const value_span = try graph.field(state.batch.pool, state.batch.nodes[value.id], "span")
            const copied_span = try graph.clone(mut state.syntax.pool, state.batch.pool, value_span, 0)
            mut message = "`with` opens `arena()` or a file handle; no other value can be used as a resource"
            const result = try variants.result_shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, value.ty)
            if result.valid:
                message = "`with` opens an arena or a file; `open` returns a Result, so propagate it with `open(...)?` or match it first"
            const rejection = try problem(state, copied_span, "E_WITH_RESOURCE", message)
            fail rejection
        const declared = try graph.field(state.syntax.pool, payload, "name")
        const declaration = try graph.get(state.syntax.pool, declared)
        if declaration.kind == 0:
            const rejection = try problem(state, span, "E_WITH_RESOURCE", "a file `with` scope requires a binding, as in `with open(fs, path, \"rb\")? as f:`")
            fail rejection
        const spelling = try graph.spelling(state.syntax.pool, state.syntax.source, declared)
        const shadows = try top_level(state, declared)
        if spelling != b"_" and (locals.find(state.scope, spelling) >= 0 or shadows):
            const rejection = try problem(state, declared, "E_SHADOWING", "file name shadows an active name")
            fail rejection
        const active = state.scope.active
        const slot = try locals.add(mut state.scope, spelling, declared, value.ty, False, b"local")
        state.scope.locals[slot].flags.scoped_file = True
        state.scope.locals[slot].usage.reads = 1
        const body_id = try graph.field(state.syntax.pool, payload, "body")
        const body_raw = try graph.number(state.syntax.pool, body_id)
        const body = try statement(mut state, body_raw)
        state.scope.active = active
        terminates = body.terminates
        const typed_slot = try syntax_value.integer(mut state.batch.pool, slot)
        const typed_resource = try syntax_value.integer(mut state.batch.pool, value.id)
        const typed_body = try syntax_value.integer(mut state.batch.pool, body.id)
        result_payload = try syntax_value.object(mut state.batch.pool, ["slot", "resource", "body"], [typed_slot, typed_resource, typed_body])
    elif tag == b"ret" or tag == b"discard" or tag == b"fail":
        const expression_id = try graph.number(state.syntax.pool, payload)
        mut result = Expression(id=-1, ty=15)
        mut expected = state.return_type
        if state.control.failure_type >= 0:
            expected = state.control.success_type
        if tag == b"fail":
            if state.control.failure_type < 0:
                const rejection = try problem(state, span, "E_FAIL_CONTEXT", "fail requires an enclosing function with a fails clause")
                fail rejection
            expected = state.control.failure_type
        if tag == b"ret" or tag == b"fail":
            result = try expression_expected(mut state, expression_id, expected)
            const context = failure_lower.Context(pool=state.syntax.pool, records=state.batch.facts.lists.types.records.rows, span=span)
            if tag == b"fail":
                const injected = try failure_lower.inject_error(mut state.batch, context, expected, result.id)
                const injected_type = try failure_lower.type_of(state.batch, injected)
                result = Expression(id=injected, ty=injected_type)
            _ = try require(state, result.ty, expected, span)
            if state.control.failure_type >= 0:
                mut wrapped = result.id
                if tag == b"fail":
                    wrapped = try failure_lower.wrap_err(mut state.batch, context, state.return_type, result.id)
                else:
                    wrapped = try failure_lower.wrap_success(mut state.batch, context, state.return_type, result.id)
                result = Expression(id=wrapped, ty=state.return_type)
            _ = try obligations.handled(state.syntax.pool, state.batch.facts.lists.types.records.rows, state.scope, 0, span, mut state.problems)
            terminates = True
            tag = b"ret"
        else:
            result = try expression(mut state, expression_id)
            const discard_problem = try discard_policy.check(state.syntax.pool, state.batch.facts.lists.types.records.rows, state.syntax.statements[raw_id], result.ty)
            match discard_problem:
                case Some(diagnostic):
                    state.problems.append(diagnostic)
                    fail diagnostic.problem
                case None:
                    pass
        result_payload = try syntax_value.integer(mut state.batch.pool, result.id)
    elif tag == b"yield_value":
        const slot = state.control.values.yield_slot
        if slot < 0:
            const rejection = try problem(state, span, "E_YIELD_CONTEXT", "yield requires a match expression arm")
            fail rejection
        const expression_id = try graph.number(state.syntax.pool, payload)
        mut value = Expression(id=-1, ty=15)
        if state.control.values.yield_type >= 0:
            value = try expression_expected(mut state, expression_id, state.control.values.yield_type)
            _ = try require(state, value.ty, state.control.values.yield_type, span)
        else:
            value = try expression(mut state, expression_id)
        state.control.values.yield_type = value.ty
        state.scope.locals[slot].ty = value.ty
        state.scope.locals[slot].flags.initialized = True
        const pending = try variants.requires_handling(state.syntax.pool, state.batch.facts.lists.types.records.rows, value.ty)
        state.scope.locals[slot].usage.transfer_available = pending
        result_payload = try emission.store(mut state.batch, slot, value.id)
        tag = b"initialize"
    elif tag == b"binding":
        const name_span = try graph.field(state.syntax.pool, payload, "name")
        const name = try graph.spelling(state.syntax.pool, state.syntax.source, name_span)
        const top_level_name = try top_level(state, name_span)
        if locals.find(state.scope, name) >= 0 or top_level_name:
            const rejection = try problem(state, name_span, "E_SHADOWING", "binding shadows an active local or top-level function")
            fail rejection
        const value_id = try graph.field(state.syntax.pool, payload, "value")
        const value_raw = try graph.number(state.syntax.pool, value_id)
        const annotation_id = try graph.field(state.syntax.pool, payload, "annotation")
        const annotation = try graph.get(state.syntax.pool, annotation_id)
        mut value = Expression(id=-1, ty=15)
        if annotation.kind != 0:
            const ty = try type_at(mut state, annotation_id)
            value = try expression_expected(mut state, value_raw, ty)
            _ = try require(state, value.ty, ty, annotation_id)
        else:
            value = try expression(mut state, value_raw)
        if value.ty == 16 or value.ty == 17:
            const rejection = try problem(state, name_span, "P_BODY_PROFILE", "ordinary file storage is outside the lexical resource profile")
            fail rejection
        const mutable_id = try graph.field(state.syntax.pool, payload, "mutable")
        const mutable = try graph.get(state.syntax.pool, mutable_id)
        const slot = try locals.add(mut state.scope, name, name_span, value.ty, mutable.integer != 0, b"local")
        const pending = try variants.requires_handling(state.syntax.pool, state.batch.facts.lists.types.records.rows, value.ty)
        state.scope.locals[slot].usage.transfer_available = pending
        const raw_data_id = try graph.field(state.syntax.pool, state.syntax.nodes[value_raw], "data")
        const raw_data = try graph.get(state.syntax.pool, raw_data_id)
        if raw_data.data == b"index":
            state.scope.locals[slot].origin = b"collection_copy"
        result_payload = try emission.store(mut state.batch, slot, value.id)
        tag = b"initialize"
    elif tag == b"branch":
        const condition_id = try graph.field(state.syntax.pool, payload, "condition")
        const condition_raw = try graph.number(state.syntax.pool, condition_id)
        const condition = try expression(mut state, condition_raw)
        const condition_span = try graph.field(state.syntax.pool, state.syntax.nodes[condition_raw], "span")
        _ = try require(state, condition.ty, 1, condition_span)
        const then_id = try graph.field(state.syntax.pool, payload, "then_body")
        const then_raw = try graph.number(state.syntax.pool, then_id)
        const before = locals_flow.snapshot(state.scope)
        const pending_before = try pending_flow.snapshot(state.scope, len(state.scope.locals))
        const options_before = option_flow.snapshot(state.control.options)
        try option_flow.assume(mut state.control.options, option_context(state), state.scope, option_flow.Guard(condition=condition_raw, truth=True))
        const then_body = try statement(mut state, then_raw)
        const options_then = option_flow.snapshot(state.control.options)
        const then_state = locals_flow.snapshot(state.scope)
        const pending_then = try pending_flow.snapshot(state.scope, len(pending_before))
        locals_flow.restore(mut state.scope, before)
        try pending_flow.restore(mut state.scope, pending_before)
        option_flow.restore(mut state.control.options, options_before)
        try option_flow.assume(mut state.control.options, option_context(state), state.scope, option_flow.Guard(condition=condition_raw, truth=False))
        const else_id = try graph.field(state.syntax.pool, payload, "else_body")
        const else_value = try graph.get(state.syntax.pool, else_id)
        mut else_body = try syntax_value.absent(mut state.batch.pool)
        mut else_terminates = False
        if else_value.kind != 0:
            const else_raw = try graph.number(state.syntax.pool, else_id)
            const result = try statement(mut state, else_raw)
            else_body = try syntax_value.integer(mut state.batch.pool, result.id)
            else_terminates = result.terminates
            terminates = then_body.terminates and result.terminates
        if not then_body.terminates:
            if else_terminates:
                option_flow.restore(mut state.control.options, options_then)
            else:
                option_flow.intersect(mut state.control.options, options_then)
        if else_terminates and not then_body.terminates:
            locals_flow.restore(mut state.scope, then_state)
        elif not then_body.terminates and not else_terminates:
            locals_flow.intersect(mut state.scope, then_state)
        const pending_difference = try pending_flow.branch(mut state.scope, pending_then, then_body.terminates, else_terminates)
        _ = try obligations.consistent(state.syntax.pool, state.scope, pending_difference, span, False, mut state.problems)
        const checked_condition = try syntax_value.integer(mut state.batch.pool, condition.id)
        const checked_then = try syntax_value.integer(mut state.batch.pool, then_body.id)
        result_payload = try syntax_value.object(mut state.batch.pool, ["condition", "then_body", "else_body"], [checked_condition, checked_then, else_body])
    elif tag == b"assignment":
        const name_span = try graph.field(state.syntax.pool, payload, "name")
        const name = try graph.spelling(state.syntax.pool, state.syntax.source, name_span)
        const op_id = try graph.field(state.syntax.pool, payload, "op")
        const op = try graph.get(state.syntax.pool, op_id)
        const slot = locals.find(state.scope, name)
        if slot < 0 and op.data != b"set":
            mut candidates: bytes[] = []
            for active_slot in state.scope.active:
                candidates.append(state.scope.locals[active_slot].name)
            const clause = try suggestions.clause(candidates, name)
            const rejection = try problem(state, name_span, "E_UNKNOWN_NAME", "name is not defined in this scope" + clause)
            fail rejection
        if slot < 0:
            const rejection = try problem(state, name_span, "E_BINDING_DECLARATION", "assignment requires a declared binding; introduce a writable local with `mut`")
            state.problems.append(syntax_problem.repaired(rejection, [syntax_problem.Edit(start=rejection.start, end=rejection.start, text=b"mut ")]))
            fail rejection
        if not state.scope.locals[slot].mutable:
            const rejection = try problem(state, name_span, "E_IMMUTABLE", "this binding cannot be assigned")
            fail rejection
        const value_id = try graph.field(state.syntax.pool, payload, "value")
        const value_raw = try graph.number(state.syntax.pool, value_id)
        if op.data == b"mul" and repeatable_type(state, state.scope.locals[slot].ty):
            _ = try require_readable(mut state, slot, name_span)
            const count = try expression(mut state, value_raw)
            const operator_span = try graph.field(state.syntax.pool, payload, "op_span")
            if count.ty != 0:
                const rejection = try problem(state, operator_span, "E_TYPE", "operation requires an integer type")
                fail rejection
            const owner_type = state.scope.locals[slot].ty
            state.scope.locals[slot].usage.reads = state.scope.locals[slot].usage.reads + 1
            state.scope.locals[slot].usage.writes = state.scope.locals[slot].usage.writes + 1
            const context = list_lower.Context(input=state.syntax.pool, span=operator_span)
            const sequence = try list_lower.read(mut state.batch, context, slot, owner_type)
            mut gathered_type = -1
            if list_types.element_type(state.batch.facts.lists, owner_type) < 0:
                gathered_type = try list_types.intern(mut state.batch.facts.lists, state.syntax.pool, list_types.Recipe(id=0, element=owner_type, span=operator_span), [state.batch.facts.string_type, state.batch.facts.bytes_type])
            const lowered = try list_repeat.build(mut state.batch, mut state.scope, context, list_repeat.Input(sequence=sequence, count=count.id, ty=owner_type, count_first=False, loop_id=state.control.next, gathered_type=gathered_type))
            state.control.next = state.control.next + 1
            const product = try list_lower.append(mut state.batch, context, lowered)
            if gathered_type >= 0:
                const id = try list_lower.store(mut state.batch, list_lower.Context(input=state.syntax.pool, span=span), slot, product, False)
                state.depth = state.depth - 1
                return Statement(id=id, terminates=False)
            const repeated = try list_lower.temporary(mut state.scope, context, owner_type)
            const read = try list_lower.read(mut state.batch, context, repeated, owner_type)
            const initialize = try list_lower.store(mut state.batch, context, repeated, product, True)
            const cleared = try list_lower.operation(mut state.batch, context, list_lower.Operation(owner=slot, kind=b"clear", arguments=[], ty=15))
            const clear_id = try syntax_value.integer(mut state.batch.pool, cleared)
            const clear = try emission.statement(mut state.batch, state.syntax.pool, operator_span, False, b"discard", clear_id)
            const extended = try list_lower.operation(mut state.batch, context, list_lower.Operation(owner=slot, kind=b"extend", arguments=[read], ty=15))
            const extend_id = try syntax_value.integer(mut state.batch.pool, extended)
            const extend = try emission.statement(mut state.batch, state.syntax.pool, operator_span, False, b"discard", extend_id)
            const statements = try emission.ids(mut state.batch, [initialize, clear, extend])
            const id = try emission.statement(mut state.batch, state.syntax.pool, span, False, b"block", statements)
            state.depth = state.depth - 1
            return Statement(id=id, terminates=False)
        const pending_target = try variants.requires_handling(state.syntax.pool, state.batch.facts.lists.types.records.rows, state.scope.locals[slot].ty)
        if pending_target and state.scope.locals[slot].usage.transfer_available:
            const rejection = try problem(state, name_span, "E_RESULT_OVERWRITE", "assignment would overwrite an unhandled result-bearing value")
            fail rejection
        mut value = try expression_expected(mut state, value_raw, state.scope.locals[slot].ty)
        if op.data != b"set":
            _ = try require_readable(mut state, slot, name_span)
            const operator_span = try graph.field(state.syntax.pool, payload, "op_span")
            _ = try require(state, value.ty, state.scope.locals[slot].ty, operator_span)
            if op.data == b"add" and list_types.element_type(state.batch.facts.lists, value.ty) >= 0:
                state.scope.locals[slot].usage.reads = state.scope.locals[slot].usage.reads + 1
                state.scope.locals[slot].usage.writes = state.scope.locals[slot].usage.writes + 1
                const context = list_lower.Context(input=state.syntax.pool, span=operator_span)
                const extended = try list_lower.operation(mut state.batch, context, list_lower.Operation(owner=slot, kind=b"extend", arguments=[value.id], ty=15))
                const operand = try syntax_value.integer(mut state.batch.pool, extended)
                const discarded = try emission.statement(mut state.batch, state.syntax.pool, operator_span, False, b"discard", operand)
                const statements = try emission.ids(mut state.batch, [discarded])
                const id = try emission.statement(mut state.batch, state.syntax.pool, span, False, b"block", statements)
                state.depth = state.depth - 1
                return Statement(id=id, terminates=False)
            if managed(state, value.ty):
                if op.data != b"add":
                    const rejection = try problem(state, operator_span, "E_TEXT_OPERATOR", "a managed collection augments with `+=` only, and str, bytes and list are the types that support it")
                    fail rejection
            elif value.ty != 0:
                const rejection = try problem(state, operator_span, "E_TYPE", "operation requires an integer type")
                fail rejection
            state.scope.locals[slot].usage.reads = state.scope.locals[slot].usage.reads + 1
            const local_payload = try syntax_value.integer(mut state.batch.pool, slot)
            const left = try emission.node(mut state.batch, state.syntax.pool, name_span, value.ty, b"local", local_payload)
            if op.data == b"div":
                const rejection = try problem(state, operator_span, "E_TYPE", "augmented `/=` produces a float; declare the binding as float or use `//=`")
                fail rejection
            mut operator = op.data
            if operator == b"rem":
                operator = b"floor_rem"
            const typed_op = try syntax_value.enumeration(mut state.batch.pool, operator)
            const typed_left = try syntax_value.integer(mut state.batch.pool, left)
            const typed_right = try syntax_value.integer(mut state.batch.pool, value.id)
            const typed_span = try graph.clone(mut state.batch.pool, state.syntax.pool, operator_span, 0)
            const binary = try syntax_value.object(mut state.batch.pool, ["op", "left", "right", "op_span"], [typed_op, typed_left, typed_right, typed_span])
            const combined = try emission.node(mut state.batch, state.syntax.pool, operator_span, value.ty, b"binary", binary)
            value = Expression(id=combined, ty=value.ty)
        _ = try require(state, value.ty, state.scope.locals[slot].ty, span)
        state.scope.locals[slot].usage.writes = state.scope.locals[slot].usage.writes + 1
        if op.data == b"set":
            const assigned_data_id = try graph.field(state.syntax.pool, state.syntax.nodes[value_raw], "data")
            const assigned_data = try graph.get(state.syntax.pool, assigned_data_id)
            state.scope.locals[slot].origin = b"local"
            if assigned_data.data == b"index":
                state.scope.locals[slot].origin = b"collection_copy"
        option_flow.forget(mut state.control.options, slot)
        state.scope.locals[slot].flags.initialized = True
        state.scope.locals[slot].usage.transfer_available = pending_target
        state.scope.locals[slot].usage.transfer_span = -1
        result_payload = try emission.store(mut state.batch, slot, value.id)
        tag = b"assign"
    elif tag == b"loop":
        const pending_before = try pending_flow.snapshot(state.scope, len(state.scope.locals))
        const condition_id = try graph.field(state.syntax.pool, payload, "condition")
        const condition_raw = try graph.number(state.syntax.pool, condition_id)
        const condition = try expression(mut state, condition_raw)
        const condition_span = try graph.field(state.syntax.pool, state.syntax.nodes[condition_raw], "span")
        _ = try require(state, condition.ty, 1, condition_span)
        const condition_difference = try pending_flow.mismatch(state.scope, pending_before)
        _ = try obligations.consistent(state.syntax.pool, state.scope, condition_difference, span, True, mut state.problems)
        const loop_id = state.control.next
        state.control.next = loop_id + 1
        state.control.active.append(loop_id)
        state.control.exited.append(False)
        const body_id = try graph.field(state.syntax.pool, payload, "body")
        const body_raw = try graph.number(state.syntax.pool, body_id)
        const before = locals_flow.snapshot(state.scope)
        try option_flow.assume(mut state.control.options, option_context(state), state.scope, option_flow.Guard(condition=condition_raw, truth=True))
        const body = try statement(mut state, body_raw)
        if not body.terminates:
            const difference = try pending_flow.mismatch(state.scope, pending_before)
            _ = try obligations.consistent(state.syntax.pool, state.scope, difference, span, True, mut state.problems)
        try pending_flow.restore(mut state.scope, pending_before)
        locals_flow.restore(mut state.scope, before)
        const last = len(state.control.active) - 1
        const condition_node = state.batch.nodes[condition.id]
        const condition_data = try graph.field(state.batch.pool, condition_node, "data")
        const condition_tag = try graph.get(state.batch.pool, condition_data)
        if condition_tag.data == b"boolean":
            const boolean_id = try graph.payload(state.batch.pool, condition_data)
            const boolean = try graph.get(state.batch.pool, boolean_id)
            terminates = boolean.integer == 1 and not state.control.exited[last]
            looping = terminates
        state.control.active = state.control.active[:last]
        state.control.exited = state.control.exited[:last]
        const identity = try syntax_value.integer(mut state.batch.pool, loop_id)
        const checked_condition = try syntax_value.integer(mut state.batch.pool, condition.id)
        const checked_body = try syntax_value.integer(mut state.batch.pool, body.id)
        const step = try syntax_value.absent(mut state.batch.pool)
        result_payload = try syntax_value.object(mut state.batch.pool, ["id", "condition", "body", "step"], [identity, checked_condition, checked_body, step])
    elif tag == b"loop_exit":
        if len(state.control.active) == 0:
            const rejection = try problem(state, span, "E_LOOP_EXIT", "break and continue require an enclosing loop")
            fail rejection
        const last = len(state.control.active) - 1
        const continuing = try graph.get(state.syntax.pool, payload)
        if continuing.integer == 0:
            state.control.exited[last] = True
        const target = try syntax_value.integer(mut state.batch.pool, state.control.active[last])
        const flag = try syntax_value.boolean(mut state.batch.pool, continuing.integer != 0)
        result_payload = try syntax_value.object(mut state.batch.pool, ["target", "continuing"], [target, flag])
        terminates = True
    elif tag == b"assertion":
        const condition_id = try graph.field(state.syntax.pool, payload, "condition")
        const condition_raw = try graph.number(state.syntax.pool, condition_id)
        const condition = try expression(mut state, condition_raw)
        const condition_span = try graph.field(state.syntax.pool, state.syntax.nodes[condition_raw], "span")
        _ = try require(state, condition.ty, 1, condition_span)
        const message_id = try graph.field(state.syntax.pool, payload, "message")
        const message = try graph.clone(mut state.batch.pool, state.syntax.pool, message_id, 0)
        const message_value = try graph.field(state.syntax.pool, payload, "value")
        const message_expression = try graph.get(state.syntax.pool, message_value)
        if message_expression.kind != 0:
            const rejection = try problem(state, span, "P_BODY_PROFILE", "dynamic assertion messages are outside the B1 scalar profile")
            fail rejection
        const checked_condition = try syntax_value.integer(mut state.batch.pool, condition.id)
        const absent = try syntax_value.absent(mut state.batch.pool)
        const kind = try syntax_value.enumeration(mut state.batch.pool, b"statement")
        result_payload = try syntax_value.object(mut state.batch.pool, ["condition", "message", "message_value", "kind"], [checked_condition, message, absent, kind])
    elif tag == b"match":
        const result = try match_payload(mut state, payload, span)
        state.depth = state.depth - 1
        return result
    elif tag == b"for_each":
        const prelude = try prelude_iteration_payload(mut state, payload, span)
        if prelude >= 0:
            state.depth = state.depth - 1
            const id = try emission.statement(mut state.batch, state.syntax.pool, span, False, b"block", prelude)
            return Statement(id=id, terminates=False)
        const iterable_id = try graph.field(state.syntax.pool, payload, "iterable")
        const iterable_raw = try graph.number(state.syntax.pool, iterable_id)
        const iterable = try expression(mut state, iterable_raw)
        const collection = collection_types.schema(state.batch.facts.lists.types.collections, iterable.ty)
        if collection.kind == 0 or collection.kind == 1 or collection.kind >= 3:
            result_payload = try dictionary_iteration_payload(mut state, payload, span, iterable, collection)
            tag = b"block"
            state.depth = state.depth - 1
            const id = try emission.statement(mut state.batch, state.syntax.pool, span, False, tag, result_payload)
            return Statement(id=id, terminates=False)
        result_payload = try sequence_iteration_payload(mut state, payload, span, iterable)
        tag = b"block"
    elif tag == b"for_range":
        result_payload = try range_statement(mut state, payload, span)
        tag = b"range_loop"
    else:
        const rejection = try problem(state, span, "P_BODY_PROFILE", "statement is outside the B1 scalar profile")
        fail rejection
    const id = try emission.statement(mut state.batch, state.syntax.pool, span, terminates, tag, result_payload)
    state.depth = state.depth - 1
    return Statement(id=id, terminates=terminates, looping=looping)


func require_readable(mut state: State, slot: int, span: int) -> bool fails syntax_value.Problem:
    if not state.scope.locals[slot].flags.initialized:
        const rejection = try problem(state, span, "E_UNBOUND", "name may be read before it is assigned; some control-flow path reaching here leaves it unbound")
        const previous = try problem(state, state.scope.locals[slot].declaration, "", "")
        const related = syntax_problem.Related(start=previous.start, end=previous.end, message="binding first assigned here", role="related")
        state.problems.append(syntax_problem.Diagnostic(problem=rejection, severity="err", notes=syntax_problem.Notes(related=[related], origin=[], requirement=[], edits=[])))
        fail rejection
    return True


public func managed(state: State, ty: int) -> bool:
    const collection = collection_types.schema(state.batch.facts.lists.types.collections, ty)
    return ty >= 19 and (ty == state.batch.facts.string_type or ty == state.batch.facts.bytes_type or ty == state.batch.facts.lists.types.buffer.id or list_types.element_type(state.batch.facts.lists, ty) >= 0 or collection.kind == 0 or collection.kind == 1)


func type_name(state: State, ty: int) -> str:
    if ty >= 0 and ty == state.batch.facts.float_type:
        return "float"
    const fixed = array_types.schema(state.batch.facts.lists.types.arrays, ty)
    if fixed.id >= 0 and fixed.key < 0:
        return "FixedArray[" + type_name(state, fixed.element) + ", " + str(fixed.length) + "]"
    const tuple = tuple_types.schema(state.batch.facts.lists.types.tuples, ty)
    if tuple.id >= 0:
        mut name = "tuple["
        for position in range(len(tuple.elements)):
            if position > 0:
                name = name + ", "
            name = name + type_name(state, tuple.elements[position])
        return name + "]"
    const element = list_types.element_type(state.batch.facts.lists, ty)
    if element >= 0:
        return type_name(state, element) + "[]"
    if ty >= 19 and ty == state.batch.facts.string_type:
        return "str"
    if ty >= 19 and ty == state.batch.facts.bytes_type:
        return "bytes"
    if ty >= 19 and ty == state.batch.facts.lists.types.buffer.id:
        return "byte_buffer"
    const collection = collection_types.schema(state.batch.facts.lists.types.collections, ty)
    if collection.id >= 0:
        if collection.kind == 1:
            return "set[" + type_name(state, collection.key) + "]"
        mut label = "dict"
        if collection.kind == 2:
            label = "DictItem"
        elif collection.kind == 3:
            label = "DictKeys"
        elif collection.kind == 4:
            label = "DictValues"
        elif collection.kind == 5:
            label = "DictItems"
        return label + "[" + type_name(state, collection.key) + ", " + type_name(state, collection.value) + "]"
    for key in state.batch.facts.lists.types.variants.index.keys:
        if key.id == ty:
            if key.kind == 2:
                return type_name(state, key.first) + "?"
            if key.kind == 1:
                return "Result[" + type_name(state, key.first) + ", " + type_name(state, key.second) + "]"
    const records = state.batch.facts.lists.types.records
    if ty >= 19 and ty < len(records.by_type):
        const declaration = records.by_type[ty]
        if declaration >= 0 and declaration < len(records.bindings.display):
            return records.bindings.display[declaration]
    return scalars.name(ty)


func array_length(state: State, span: int) -> int fails syntax_value.Problem:
    const spelling = try graph.spelling(state.syntax.pool, state.syntax.source, span)
    if len(spelling) == 0 or spelling[0] < 48 or spelling[0] > 57:
        const rejection = try problem(state, span, "P_BODY_PROFILE", "array length expression requires scalar constant evaluation")
        fail rejection
    const location = try problem(state, span, "", "")
    return try scalars.integer(spelling, False, location.start, location.end)


public func type_at(mut state: State, span: int) -> int fails syntax_value.Problem:
    const text = try graph.spelling(state.syntax.pool, state.syntax.source, span)
    if text == b"float" and state.batch.facts.float_type >= 0:
        return state.batch.facts.float_type
    for array in state.batch.facts.lists.types.arrays.sources:
        const array_span = try graph.field(state.syntax.pool, array, "span")
        const matches = try same_span(state.syntax.pool, array_span, span)
        if matches:
            const element_span = try graph.field(state.syntax.pool, array, "element")
            const element = try type_at(mut state, element_span)
            const index_id = try graph.field(state.syntax.pool, array, "index")
            const index = try graph.get(state.syntax.pool, index_id)
            const index_span = try graph.payload(state.syntax.pool, index_id)
            mut key = -1
            mut length = -1
            if index.data == b"length":
                length = try array_length(state, index_span)
            elif index.data == b"enum_type":
                key = try type_at(mut state, index_span)
                const variant = try variants.shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, key)
                length = len(variant.cases)
            const ty = array_types.find(state.batch.facts.lists.types.arrays, element, length, key)
            if ty < 0:
                const rejection = try problem(state, span, "P_BODY_PROFILE", "annotated array type is absent from the common catalog")
                fail rejection
            return ty
    for tuple in state.batch.facts.lists.types.tuples.sources:
        const tuple_span = try graph.field(state.syntax.pool, tuple, "span")
        const matches = try same_span(state.syntax.pool, tuple_span, span)
        if matches:
            const elements_id = try graph.field(state.syntax.pool, tuple, "elements")
            const elements = try graph.items(state.syntax.pool, elements_id)
            mut types: int[] = []
            for element in elements:
                const ty = try type_at(mut state, element)
                types.append(ty)
            const ty = tuple_types.find(state.batch.facts.lists.types.tuples, types)
            if ty < 0:
                const rejection = try problem(state, span, "P_BODY_PROFILE", "annotated tuple type is absent from the common catalog")
                fail rejection
            return ty
    for suffix in state.batch.facts.lists.types.suffixes:
        const suffix_span = try graph.field(state.syntax.pool, suffix, "span")
        const matches = try same_span(state.syntax.pool, suffix_span, span)
        if matches:
            const kind_id = try graph.field(state.syntax.pool, suffix, "kind")
            const kind = try graph.get(state.syntax.pool, kind_id)
            const base = try graph.field(state.syntax.pool, suffix, "base")
            const element = try type_at(mut state, base)
            if kind.data == b"optional":
                return try list_types.union_intern(mut state.batch.facts.lists, mut state.syntax.pool, element, -1, span, False)
            if kind.data != b"growable":
                const rejection = try problem(state, span, "P_BODY_PROFILE", "type suffix is outside the body profile")
                fail rejection
            const ty = list_types.lookup(state.batch.facts.lists, element)
            if ty < 0:
                const rejection = try problem(state, span, "P_BODY_PROFILE", "annotated list type is absent from the common catalog")
                fail rejection
            return ty
    for application in state.batch.facts.applications:
        const application_span = try graph.field(state.syntax.pool, application, "span")
        const matches = try same_span(state.syntax.pool, application_span, span)
        if matches:
            const name_span = try graph.field(state.syntax.pool, application, "name")
            const name = try graph.spelling(state.syntax.pool, state.syntax.source, name_span)
            const arguments_id = try graph.field(state.syntax.pool, application, "arguments")
            const arguments = try graph.items(state.syntax.pool, arguments_id)
            if name == b"FixedArray" and len(arguments) == 2:
                const element = try type_at(mut state, arguments[0])
                const length = try array_length(state, arguments[1])
                const ty = array_types.find(state.batch.facts.lists.types.arrays, element, length, -1)
                if ty < 0:
                    const rejection = try problem(state, span, "P_BODY_PROFILE", "annotated array type is absent from the common catalog")
                    fail rejection
                return ty
            if (name == b"Result" and len(arguments) == 2) or (name == b"Option" and len(arguments) == 1):
                const first = try type_at(mut state, arguments[0])
                mut second = -1
                if len(arguments) == 2:
                    second = try type_at(mut state, arguments[1])
                return try list_types.union_intern(mut state.batch.facts.lists, mut state.syntax.pool, first, second, span, name == b"Result")
            if (name == b"dict" and len(arguments) == 2) or (name == b"set" and len(arguments) == 1):
                const key = try type_at(mut state, arguments[0])
                mut value = 15
                mut kind = 1
                if name == b"dict":
                    kind = 0
                    value = try type_at(mut state, arguments[1])
                return try list_types.collection_intern(mut state.batch.facts.lists, mut state.syntax.pool, collection_types.Schema(id=-1, kind=kind, key=key, value=value, owner=-1), span)
            if name == b"list" and len(arguments) == 1:
                const element = try type_at(mut state, arguments[0])
                const ty = list_types.lookup(state.batch.facts.lists, element)
                if ty >= 0:
                    return ty
            const rejection = try problem(state, span, "P_BODY_PROFILE", "qualified or user generic type application is outside the body profile")
            fail rejection
    if text == b"Filesystem" or text == b"Stream":
        const declared = try declared_symbol(state, span)
        if not declared:
            if text == b"Filesystem":
                return 11
            return 18
    if text == b"byte_buffer":
        return try list_types.buffer_intern(mut state.batch.facts.lists, mut state.syntax.pool, span)
    if text == b"str" or text == b"bytes":
        mut ty = state.batch.facts.string_type
        if text == b"bytes":
            ty = state.batch.facts.bytes_type
        if ty < 0:
            const rejection = try problem(state, span, "P_BODY_PROFILE", "managed sequence builtin is unavailable")
            fail rejection
        return ty
    for width in [b"i8", b"i16", b"i32", b"u8", b"u16", b"u32", b"u64"]:
        if text == width:
            const location = try problem(state, span, "", "")
            return try scalars.annotation(text, location.start, location.end)
    if text != b"int" and text != b"i64" and text != b"bool" and text != b"Unit" and len(text) != 0:
        const resolution = try record_names.resolve(mut state.problems, state.syntax.pool, state.syntax.source, state.syntax.modules, record_names.Request(span=span, owner=-1, name=span))
        const ty = try nominal_key(mut state, resolution.key, span)
        if ty >= 0:
            if resolution.from >= 0 and resolution.import_index >= 0:
                state.syntax.usage[resolution.from][resolution.import_index] = True
            return ty
    const location = try problem(state, span, "", "")
    return try scalars.annotation(text, location.start, location.end)


func list_method(mut state: State, call: int, span: int, slot: int) -> Expression fails syntax_value.Problem:
    const name_span = try graph.field(state.syntax.pool, call, "name")
    const owner_span = try graph.field(state.syntax.pool, call, "owner")
    const name = try graph.spelling(state.syntax.pool, state.syntax.source, name_span)
    const arguments_id = try graph.field(state.syntax.pool, call, "arguments")
    const inputs = try graph.items(state.syntax.pool, arguments_id)
    const names_id = try graph.field(state.syntax.pool, call, "argument_names")
    const labels = try graph.items(state.syntax.pool, names_id)
    const types_id = try graph.field(state.syntax.pool, call, "type_arguments")
    const types = try graph.items(state.syntax.pool, types_id)
    if len(labels) != 0 or len(types) != 0:
        const rejection = try problem(state, span, "P_BODY_PROFILE", "named or generic list method operands are outside the body profile")
        fail rejection
    mut kind = name
    if name == b"index":
        kind = b"index_of"
    if name == b"pop" and len(inputs) == 1:
        kind = b"pop_at"
    mut arity = -1
    mut mutates = False
    mut result_type = 15
    const owner_type = state.scope.locals[slot].ty
    const element = list_types.element_type(state.batch.facts.lists, owner_type)
    if kind == b"append" or kind == b"extend" or kind == b"remove":
        arity = 1
        mutates = True
    elif kind == b"insert" or kind == b"write":
        arity = 2
        mutates = True
    elif kind == b"reverse" or kind == b"sort" or kind == b"clear":
        arity = 0
        mutates = True
    elif kind == b"pop" or kind == b"pop_at":
        arity = 0
        if kind == b"pop_at":
            arity = 1
        mutates = True
        result_type = element
    elif kind == b"read":
        arity = 1
        result_type = element
    elif kind == b"contains":
        arity = 1
        result_type = 1
    elif kind == b"index_of":
        arity = 1
        result_type = 0
    elif kind == b"copy":
        arity = 0
        result_type = owner_type
    elif kind == b"length" or kind == b"capacity":
        arity = 0
        result_type = 8
    if arity < 0:
        const rejection = try problem(state, name_span, "E_LIST_METHOD", "unknown method for a " + type_name(state, owner_type) + " receiver; accepted methods: append, clear, copy, extend, index, insert, pop, remove, reverse, sort")
        fail rejection
    if arity != len(inputs):
        mut error_span = owner_span
        if kind == b"append" or kind == b"read" or kind == b"write" or kind == b"length" or kind == b"capacity" or kind == b"contains":
            error_span = span
        mut plural = "s"
        if arity == 1:
            plural = ""
        const signature = try list_signature(state, owner_type, kind)
        const rejection = try problem(state, error_span, "E_ARITY", "`" + signature + "` takes " + str(arity) + " argument" + plural + ", but this call passes " + str(len(inputs)))
        fail rejection
    _ = try require_readable(mut state, slot, owner_span)
    if kind == b"sort" and element != 0 and element != state.batch.facts.string_type and element != state.batch.facts.bytes_type:
        const rejection = try problem(state, owner_span, "E_COLLECTION_METHOD", "sort requires an integer, float, str or bytes element type")
        fail rejection
    mut values: int[] = []
    mut position = 0
    for input in inputs:
        const raw = try graph.number(state.syntax.pool, input)
        mut expected = element
        if kind == b"extend":
            expected = owner_type
        elif kind == b"read" or kind == b"pop_at" or ((kind == b"insert" or kind == b"write") and position == 0):
            expected = 0
        const value = try expression_expected(mut state, raw, expected)
        const argument_span = try graph.field(state.syntax.pool, state.syntax.nodes[raw], "span")
        match require(state, value.ty, expected, argument_span):
            case Ok(unused):
                pass
            case Err(rejection):
                if kind == b"extend" or kind == b"remove" or kind == b"index_of" or (kind == b"insert" and position == 1):
                    const signature = try list_signature(state, owner_type, kind)
                    state.problems.append(syntax_problem.alternative(rejection, signature))
                fail rejection
        values.append(value.id)
        position = position + 1
    state.scope.locals[slot].usage.reads = state.scope.locals[slot].usage.reads + 1
    if mutates:
        if not state.scope.locals[slot].mutable:
            const rejection = try problem(state, owner_span, "E_IMMUTABLE", "collection update requires a writable binding")
            fail rejection
        state.scope.locals[slot].usage.writes = state.scope.locals[slot].usage.writes + 1
    const context = list_lower.Context(input=state.syntax.pool, span=span)
    const id = try list_lower.operation(mut state.batch, context, list_lower.Operation(owner=slot, kind=kind, arguments=values, ty=result_type))
    return Expression(id=id, ty=result_type)


func list_signature(state: State, owner_type: int, kind: bytes) -> str fails syntax_value.Problem:
    const owner = type_name(state, owner_type)
    const element = type_name(state, list_types.element_type(state.batch.facts.lists, owner_type))
    const spelling = try suggestions.text(kind)
    if kind == b"append" or kind == b"remove":
        return owner + "." + spelling + "(value: " + element + ") -> None"
    if kind == b"extend":
        return owner + ".extend(other: " + owner + ") -> None"
    if kind == b"insert" or kind == b"write":
        return owner + "." + spelling + "(index: int, value: " + element + ") -> None"
    if kind == b"pop_at" or kind == b"read":
        mut method = spelling
        if kind == b"pop_at":
            method = "pop"
        return owner + "." + method + "(index: int) -> " + element
    if kind == b"pop":
        return owner + ".pop() -> " + element
    if kind == b"copy":
        return owner + ".copy() -> " + owner
    if kind == b"index_of":
        return owner + ".index(value: " + element + ") -> int"
    if kind == b"contains":
        return owner + ".contains(value: " + element + ") -> bool"
    if kind == b"length" or kind == b"capacity":
        return owner + "." + spelling + "() -> int"
    return owner + "." + spelling + "() -> None"


func list_arity(kind: bytes) -> int:
    if kind == b"write" or kind == b"insert":
        return 2
    if kind == b"append" or kind == b"read" or kind == b"contains" or kind == b"extend" or kind == b"pop_at" or kind == b"remove" or kind == b"index_of":
        return 1
    if kind == b"length" or kind == b"capacity" or kind == b"pop" or kind == b"reverse" or kind == b"sort" or kind == b"copy" or kind == b"clear":
        return 0
    return -1


public func record_field(state: State, ty: int, span: int) -> int fails syntax_value.Problem:
    const fixed_table = array_types.schema(state.batch.facts.lists.types.arrays, ty)
    if fixed_table.id >= 0 and fixed_table.key >= 0:
        return try variant_tag(state, fixed_table.key, span)
    const tuple = tuple_types.schema(state.batch.facts.lists.types.tuples, ty)
    if tuple.id >= 0:
        const rejection = try problem(state, span, "E_TYPE", "a tuple has no fields; take it apart with `head, rest = value`")
        fail rejection
    const row = record_types.schema(state.batch.facts.lists.types.records, ty)
    if row < 0:
        const rejection = try problem(state, span, "E_TYPE", "operation requires a record value")
        fail rejection
    const fields_id = try graph.field(state.syntax.pool, row, "fields")
    const fields = try graph.items(state.syntax.pool, fields_id)
    const text = try graph.spelling(state.syntax.pool, state.syntax.source, span)
    mut names_list: bytes[] = []
    for index in range(len(fields)):
        const name_id = try graph.field(state.syntax.pool, fields[index], "name")
        const name = try graph.get(state.syntax.pool, name_id)
        if name.kind != 3:
            fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid record field name")
        if name.data == text:
            return index
        names_list.append(name.data)
    # Diagnostic enumeration is lexical, independent of hash/declaration order.
    match record_name_index.make(names_list):
        case Ok(table):
            mut declared = ""
            for position in table.order:
                if len(declared) != 0:
                    declared = declared + ", "
                const name = try suggestions.text(table.names[position])
                declared = declared + name
            const rejection = try problem(state, span, "E_UNKNOWN_FIELD", "field does not exist on this record type; declared fields: " + declared)
            fail rejection
        case Err(error):
            fail syntax_value.Problem(code="P_BODY_LIMIT", start=0, end=0, message=error.message)


func record_initializers(mut state: State, ty: int, span: int, initializers: record_construct.Initializer[]) -> int fails syntax_value.Problem:
    const table = array_types.schema(state.batch.facts.lists.types.arrays, ty)
    const keyed = table.id >= 0 and table.key >= 0
    const row = record_types.schema(state.batch.facts.lists.types.records, ty)
    const fields_id = try graph.field(state.syntax.pool, row, "fields")
    const fields = try graph.items(state.syntax.pool, fields_id)
    mut seen: bool[] = []
    for field in fields:
        seen.append(False)
    mut indices: int[] = []
    for initializer in initializers:
        const index = try record_field(state, ty, initializer.name)
        indices.append(index)
        const type_id = try graph.field(state.syntax.pool, fields[index], "ty")
        const expected = try graph.number(state.syntax.pool, type_id)
        if initializer.value < 0 or initializer.value >= len(state.syntax.nodes):
            fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid record initializer node")
        state.batch.facts.expected[initializer.value] = expected
    # Native queues every child before final duplicate/type/completeness checks.
    mut values: Expression[] = []
    for initializer in initializers:
        const value = try expression(mut state, initializer.value)
        values.append(value)
    mut checked: int[] = []
    mut position = 0
    for initializer in initializers:
        const index = indices[position]
        const value = values[position]
        position = position + 1
        if seen[index]:
            const duplicate_code = if keyed then "E_DUPLICATE_KEY" else "E_DUPLICATE_FIELD"
            const rejection = try problem(state, initializer.name, duplicate_code, "named entry is initialized more than once")
            fail rejection
        seen[index] = True
        const type_id = try graph.field(state.syntax.pool, fields[index], "ty")
        const expected = try graph.number(state.syntax.pool, type_id)
        const value_span = try graph.field(state.syntax.pool, state.syntax.nodes[initializer.value], "span")
        _ = try require(state, value.ty, expected, value_span)
        const index_value = try syntax_value.integer(mut state.batch.pool, index)
        const value_id = try syntax_value.integer(mut state.batch.pool, value.id)
        const field = try syntax_value.object(mut state.batch.pool, ["index", "value"], [index_value, value_id])
        checked.append(field)
    for index in range(len(fields)):
        if not seen[index]:
            const name_id = try graph.field(state.syntax.pool, fields[index], "name")
            const name = try graph.get(state.syntax.pool, name_id)
            const record_name_id = try graph.field(state.syntax.pool, row, "name")
            const record_name = try graph.get(state.syntax.pool, record_name_id)
            const field_text = try suggestions.text(name.data)
            const record_text = try suggestions.text(record_name.data)
            const missing_code = if keyed then "E_INCOMPLETE_TABLE" else "E_INCOMPLETE_CONSTRUCTION"
            const entry_kind = if keyed then "key" else "field"
            const rejection = try problem(state, span, missing_code, "missing initializer for " + entry_kind + " `" + field_text + "` of `" + record_text + "`")
            const declaration = try graph.field(state.syntax.pool, fields[index], "declaration")
            const site = try problem(state, declaration, "", "")
            const related = syntax_problem.Related(start=site.start, end=site.end, message="missing entry declared here", role="related")
            state.problems.append(syntax_problem.Diagnostic(problem=rejection, severity="err", notes=syntax_problem.Notes(related=[related], origin=[], requirement=[], edits=[])))
            fail rejection
    return try syntax_value.sequence(mut state.batch.pool, checked)


func nominal_key(mut state: State, key: bytes, span: int) -> int fails syntax_value.Problem:
    const ty = try record_types.named(state.batch.facts.lists.types.records, key)
    if ty >= -1:
        return ty
    const index = -2 - ty
    const aliases = state.batch.facts.lists.types.records.bindings.aliases
    if index < 0 or index >= len(aliases):
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid nominal alias index")
    if state.depth >= 256:
        const rejection = try problem(state, span, "P_BODY_PROFILE", "alias resolution depth exceeds the body profile")
        fail rejection
    state.depth = state.depth + 1
    const target = try graph.field(state.syntax.pool, aliases[index], "target")
    const resolved = try type_at(mut state, target)
    state.depth = state.depth - 1
    return resolved


record ArrayStep:
    value: int
    member: bool


record ArrayPlace:
    root: int
    steps: ArrayStep[]


# Native arrayPlace reads declared types only. Failed probes leave ordinary
# assignment checking responsible for diagnostics and do not evaluate operands.
func array_place(state: State, target: int, trailing: int) -> ArrayPlace fails syntax_value.Problem:
    mut chain: int[] = []
    mut cursor = target
    while True:
        if cursor < 0 or cursor >= len(state.syntax.nodes) or len(chain) >= 256:
            return ArrayPlace(root=-1, steps=[])
        const data_id = try graph.field(state.syntax.pool, state.syntax.nodes[cursor], "data")
        const data = try graph.get(state.syntax.pool, data_id)
        if data.data == b"name":
            break
        if data.data != b"field" and data.data != b"index":
            return ArrayPlace(root=-1, steps=[])
        chain.append(cursor)
        const base_id = try graph.field(state.syntax.pool, data.children[0], "base")
        cursor = try graph.number(state.syntax.pool, base_id)
    const data_id = try graph.field(state.syntax.pool, state.syntax.nodes[cursor], "data")
    const data = try graph.get(state.syntax.pool, data_id)
    const spelling = try graph.spelling(state.syntax.pool, state.syntax.source, data.children[0])
    const slot = locals.find(state.scope, spelling)
    if slot < 0:
        return ArrayPlace(root=-1, steps=[])
    mut reached = state.scope.locals[slot].ty
    mut root = cursor
    mut steps: ArrayStep[] = []
    mut fixed_below = False
    mut count = len(chain)
    if trailing >= 0:
        count += 1
    for position in range(count):
        mut raw = -1
        if position < len(chain):
            raw = chain[len(chain) - position - 1]
        mut value = trailing
        mut member = False
        if raw >= 0:
            const step_id = try graph.field(state.syntax.pool, state.syntax.nodes[raw], "data")
            const step = try graph.get(state.syntax.pool, step_id)
            if step.data == b"field":
                member = True
                value = try graph.field(state.syntax.pool, step.children[0], "name")
            else:
                const key = try graph.field(state.syntax.pool, step.children[0], "index")
                value = try graph.number(state.syntax.pool, key)
        if reached < 19:
            return ArrayPlace(root=-1, steps=[])
        const fixed = array_types.schema(state.batch.facts.lists.types.arrays, reached)
        if member:
            const tuple = tuple_types.schema(state.batch.facts.lists.types.tuples, reached)
            const variant = try variants.shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, reached)
            if fixed.id >= 0 or tuple.id >= 0 or variant.valid or managed(state, reached):
                return ArrayPlace(root=-1, steps=[])
            match record_field(state, reached, value):
                case Err(error):
                    return ArrayPlace(root=-1, steps=[])
                case Ok(index):
                    const row = record_types.schema(state.batch.facts.lists.types.records, reached)
                    const fields_id = try graph.field(state.syntax.pool, row, "fields")
                    const fields = try graph.items(state.syntax.pool, fields_id)
                    const ty = try graph.field(state.syntax.pool, fields[index], "ty")
                    reached = try graph.number(state.syntax.pool, ty)
            steps.append(ArrayStep(value=value, member=True))
        elif fixed.id >= 0:
            fixed_below = True
            reached = fixed.element
            steps.append(ArrayStep(value=value, member=False))
        else:
            mut element = list_types.element_type(state.batch.facts.lists, reached)
            const mapping = collection_types.schema(state.batch.facts.lists.types.collections, reached)
            if mapping.id >= 0 and mapping.kind == 0:
                element = mapping.value
            if element < 0 or raw < 0:
                return ArrayPlace(root=-1, steps=[])
            root = raw
            steps = []
            fixed_below = False
            reached = element
    if not fixed_below:
        return ArrayPlace(root=-1, steps=[])
    return ArrayPlace(root=root, steps=steps)


func array_transfers(state: State, ty: int) -> bool fails syntax_value.Problem:
    if ty < 19 or ty - 19 >= len(state.batch.facts.lists.types.records.rows):
        return ty == 16 or ty == 17
    const row = state.batch.facts.lists.types.records.rows[ty - 19]
    const contract = try graph.field(state.syntax.pool, row, "contract")
    const owned = try graph.field(state.syntax.pool, contract, "move_only")
    const pending = try graph.field(state.syntax.pool, contract, "requires_handling")
    const owned_value = try graph.get(state.syntax.pool, owned)
    const pending_value = try graph.get(state.syntax.pool, pending)
    return owned_value.integer != 0 or pending_value.integer != 0


func array_augmented(mut state: State, context: list_lower.Context, op: bytes, left: int, right: int, ty: int) -> int fails syntax_value.Problem:
    mut operator = op
    if operator == b"rem":
        operator = b"floor_rem"
    if operator == b"div":
        operator = b"python_div"
    if state.batch.facts.float_type >= 0 and ty == state.batch.facts.float_type:
        const lowered = try numeric_lower.binary(mut state.batch, mut state.scope, context, operator, left, right)
        return try list_lower.append(mut state.batch, context, lowered)
    const mapping = collection_types.schema(state.batch.facts.lists.types.collections, ty)
    if mapping.id >= 0 and mapping.kind == 1:
        const rejection = try problem(state, context.span, "E_SET_OPERATOR", "a set has no augmented assignment; write `s = s - t`, `s = s | t`, or call `s.update(t)`")
        fail rejection
    if managed(state, ty):
        if op != b"add" or mapping.kind == 0:
            const rejection = try problem(state, context.span, "E_TEXT_OPERATOR", "a managed collection augments with `+=` only, and str, bytes and list are the types that support it")
            fail rejection
    elif not scalars.is_integer(ty):
        const rejection = try problem(state, context.span, "E_TYPE", "operation requires an integer type")
        fail rejection
    elif op == b"div":
        const rejection = try problem(state, context.span, "E_TYPE", "augmented `/=` produces a float; declare the binding as float or use `//=`")
        fail rejection
    return try list_lower.binary(mut state.batch, context, operator, left, right, ty)


func array_assignment(mut state: State, place: ArrayPlace, rhs_raw: int, op: bytes, span: int) -> Expression fails syntax_value.Problem:
    const context = list_lower.Context(input=state.syntax.pool, span=span)
    const inherited = len(state.control.values.temporaries)
    const root_row = state.syntax.nodes[place.root]
    const root_span = try graph.field(state.syntax.pool, root_row, "span")
    const root_data_id = try graph.field(state.syntax.pool, root_row, "data")
    const root_data = try graph.get(state.syntax.pool, root_data_id)
    mut owner = -1
    mut index = -1
    mut current = -1
    mut root_setup: int[] = []
    if root_data.data == b"name":
        const name = try graph.spelling(state.syntax.pool, state.syntax.source, root_data.children[0])
        owner = locals.find(state.scope, name)
        _ = try require_readable(mut state, owner, root_data.children[0])
        if not state.scope.locals[owner].mutable:
            const rejection = try problem(state, root_span, "E_IMMUTABLE", "element assignment requires a mutable binding")
            fail rejection
        const transfers = try array_transfers(state, state.scope.locals[owner].ty)
        if transfers:
            const rejection = try problem(state, root_span, "E_RESULT_OPERATION", "element assignment requires a copyable value without pending results")
            fail rejection
        current = try array_places.read_root(mut state.batch, mut state.scope, context, owner)
    else:
        const root_context = list_lower.Context(input=state.syntax.pool, span=root_span)
        const base_id = try graph.field(state.syntax.pool, root_data.children[0], "base")
        const base_raw = try graph.number(state.syntax.pool, base_id)
        const base = try expression(mut state, base_raw)
        state.control.values.temporaries = state.control.values.temporaries[:inherited]
        const rooted = try list_places.receiver(mut state.batch, mut state.scope, root_context, base.id, base.ty)
        const key_id = try graph.field(state.syntax.pool, root_data.children[0], "index")
        const key_raw = try graph.number(state.syntax.pool, key_id)
        const key = try expression(mut state, key_raw)
        state.control.values.temporaries = state.control.values.temporaries[:inherited]
        const mapping = collection_types.schema(state.batch.facts.lists.types.collections, base.ty)
        mut prepared = rooted
        if mapping.id >= 0 and mapping.kind == 0:
            prepared = try dictionary_places.indexed(mut state.batch, mut state.scope, rooted, key.id, mapping.key, mapping.value)
        else:
            prepared = try list_places.indexed(mut state.batch, mut state.scope, rooted, key.id, list_types.element_type(state.batch.facts.lists, base.ty))
        owner = prepared.owner
        index = prepared.index
        current = prepared.current
        root_setup = prepared.setup
    mut bases: int[] = []
    mut steps: array_places.Step[] = []
    mut key_setup: int[] = []
    mut keys_inert = True
    for step in place.steps:
        bases.append(current)
        const base_type_id = try graph.field(state.batch.pool, state.batch.nodes[current], "ty")
        const base_type = try graph.number(state.batch.pool, base_type_id)
        if step.member:
            const transfers = try array_transfers(state, base_type)
            if transfers:
                const rejection = try problem(state, step.value, "E_RESULT_OPERATION", "field assignment requires a copyable record without pending results")
                fail rejection
            const member = try record_field(state, base_type, step.value)
            const row = record_types.schema(state.batch.facts.lists.types.records, base_type)
            const fields_id = try graph.field(state.syntax.pool, row, "fields")
            const fields = try graph.items(state.syntax.pool, fields_id)
            const ty_id = try graph.field(state.syntax.pool, fields[member], "ty")
            const ty = try graph.number(state.syntax.pool, ty_id)
            steps.append(array_places.Step(key=-1, from_end=False, member=member))
            current = try record_places.field(mut state.batch, context, current, member, ty)
        else:
            const fixed = array_types.schema(state.batch.facts.lists.types.arrays, base_type)
            const key_span = try graph.field(state.syntax.pool, state.syntax.nodes[step.value], "span")
            const pending_element = try variants.requires_handling(state.syntax.pool, state.batch.facts.lists.types.records.rows, fixed.element)
            if pending_element:
                const rejection = try problem(state, span, "E_RESULT_OPERATION", "replacement would drop an unhandled result-bearing element")
                fail rejection
            const key = try expression_expected(mut state, step.value, fixed.key)
            state.control.values.temporaries = state.control.values.temporaries[:inherited]
            if fixed.key >= 0:
                _ = try require(state, key.ty, fixed.key, key_span)
            elif not scalars.is_integer(key.ty):
                const rejection = try problem(state, key_span, "E_TYPE", "operation requires an integer type")
                fail rejection
            const selected = try array_index.select(state.batch, state.control.values.counters, key.id, fixed.length, fixed.key >= 0)
            mut normalized = selected.key
            if selected.folded:
                const typed_span = try graph.field(state.batch.pool, state.batch.nodes[key.id], "span")
                const copied = try graph.clone(mut state.syntax.pool, state.batch.pool, typed_span, 0)
                normalized = try list_lower.integer(mut state.batch, list_lower.Context(input=state.syntax.pool, span=copied), selected.value, 0)
            const key_free = try array_places.effect_free_value(state.batch, normalized)
            if not key_free:
                const spilled = try array_places.spill_value(mut state.batch, mut state.scope, context, normalized)
                normalized = spilled.value
                key_setup.append(spilled.statement)
            const key_inert = try array_places.inert_value(state.batch, normalized)
            keys_inert = keys_inert and key_inert
            steps.append(array_places.Step(key=normalized, from_end=selected.from_end, member=-1))
            const base_id = try syntax_value.integer(mut state.batch.pool, current)
            const key_id = try syntax_value.integer(mut state.batch.pool, normalized)
            const from_end = try syntax_value.boolean(mut state.batch.pool, selected.from_end)
            const payload = try syntax_value.object(mut state.batch.pool, ["base", "index", "from_end"], [base_id, key_id, from_end])
            current = try emission.node(mut state.batch, state.syntax.pool, span, fixed.element, b"index", payload)
    const leaf_id = try graph.field(state.batch.pool, state.batch.nodes[current], "ty")
    const leaf = try graph.number(state.batch.pool, leaf_id)
    const right = try expression_expected(mut state, rhs_raw, leaf)
    state.control.values.temporaries = state.control.values.temporaries[:inherited]
    _ = try require(state, right.ty, leaf, span)
    mut setup: int[] = []
    mut value = right.id
    const right_inert = try array_places.inert_value(state.batch, right.id)
    const right_free = try array_places.effect_free_value(state.batch, right.id)
    if op == b"set":
        if not right_inert and (index >= 0 or not keys_inert or not right_free):
            const spilled = try array_places.spill_value(mut state.batch, mut state.scope, context, right.id)
            value = spilled.value
            setup.append(spilled.statement)
        setup.extend(root_setup)
        setup.extend(key_setup)
    else:
        setup.extend(root_setup)
        setup.extend(key_setup)
        value = try array_augmented(mut state, context, op, current, right.id, leaf)
        if not right_free:
            const spilled = try array_places.spill_value(mut state.batch, mut state.scope, context, value)
            value = spilled.value
            setup.append(spilled.statement)
    const lowered = try array_places.finish(mut state.batch, context, array_places.Input(owner=owner, index=index, bases=bases, steps=steps, value=value, setup=setup))
    const id = try list_lower.append(mut state.batch, context, lowered)
    return Expression(id=id, ty=15)


func record_assignment(mut state: State, assignment: int, span: int) -> Expression fails syntax_value.Problem:
    const target_id = try graph.field(state.syntax.pool, assignment, "target")
    const target = try graph.number(state.syntax.pool, target_id)
    const target_data_id = try graph.field(state.syntax.pool, state.syntax.nodes[target], "data")
    const target_data = try graph.get(state.syntax.pool, target_data_id)
    if target_data.data == b"tuple":
        return try tuple_assignment(mut state, assignment, target)
    _ = try list_places.writable(state.syntax.pool, state.syntax.source, state.syntax.nodes, mut state.scope, target)
    const fixed_place = try array_place(state, target, -1)
    if fixed_place.root >= 0:
        const value_id = try graph.field(state.syntax.pool, assignment, "value")
        const operator_id = try graph.field(state.syntax.pool, assignment, "op")
        const operator_value = try graph.get(state.syntax.pool, operator_id)
        const value_raw = try graph.number(state.syntax.pool, value_id)
        return try array_assignment(mut state, fixed_place, value_raw, operator_value.data, span)
    mut path_names: int[] = []
    mut root = target
    while True:
        if root < 0 or root >= len(state.syntax.nodes) or len(path_names) >= 256:
            fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid record field path")
        const data_id = try graph.field(state.syntax.pool, state.syntax.nodes[root], "data")
        const data = try graph.get(state.syntax.pool, data_id)
        if data.data != b"field":
            break
        const field = try graph.payload(state.syntax.pool, data_id)
        const name = try graph.field(state.syntax.pool, field, "name")
        path_names.append(name)
        const base_id = try graph.field(state.syntax.pool, field, "base")
        root = try graph.number(state.syntax.pool, base_id)
    const root_span = try graph.field(state.syntax.pool, state.syntax.nodes[root], "span")
    const root_data_id = try graph.field(state.syntax.pool, state.syntax.nodes[root], "data")
    const root_data = try graph.get(state.syntax.pool, root_data_id)
    const root_payload = try graph.payload(state.syntax.pool, root_data_id)
    const root_context = list_lower.Context(input=state.syntax.pool, span=root_span)
    mut destination = record_places.Destination(owner=-1, index=-1, value=-1, refresh=-1, setup=[], dead_owner=-1)
    if root_data.data == b"name":
        const name = try graph.spelling(state.syntax.pool, state.syntax.source, root_payload)
        const slot = locals.find(state.scope, name)
        if slot < 0:
            fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="record mutation root disappeared")
        _ = try require_readable(mut state, slot, root_payload)
        destination = try record_places.prepare_local(mut state.batch, mut state.scope, root_context, slot)
    elif root_data.data == b"index":
        const base_id = try graph.field(state.syntax.pool, root_payload, "base")
        const base_raw = try graph.number(state.syntax.pool, base_id)
        const base = try expression(mut state, base_raw)
        const element = list_types.element_type(state.batch.facts.lists, base.ty)
        if element < 0:
            const rejection = try problem(state, root_span, "E_COLLECTION_METHOD", "indexed field assignment requires a list, dictionary or fixed array reached from a variable")
            fail rejection
        destination = try record_places.receiver(mut state.batch, mut state.scope, root_context, record_places.Receiver(base=base.id, ty=base.ty))
        const index_id = try graph.field(state.syntax.pool, root_payload, "index")
        const index_raw = try graph.number(state.syntax.pool, index_id)
        const index = try expression(mut state, index_raw)
        _ = try require(state, index.ty, 0, root_span)
        destination = try record_places.indexed(mut state.batch, mut state.scope, root_context, destination, record_places.Index(value=index.id, element=element))
    else:
        const rejection = try problem(state, root_span, "E_ASSIGNMENT_TARGET", "field assignment requires a mutable local record or list slot")
        fail rejection
    const context = list_lower.Context(input=state.syntax.pool, span=span)
    mut path = record_places.Path(bases=[], indices=[], current=destination.value, ty=15)
    mut position = len(path_names)
    while position > 0:
        position = position - 1
        const base = path.current
        const ty_id = try graph.field(state.batch.pool, state.batch.nodes[base], "ty")
        const ty = try graph.number(state.batch.pool, ty_id)
        const name = path_names[position]
        const index = try record_field(state, ty, name)
        const row = record_types.schema(state.batch.facts.lists.types.records, ty)
        const fields_id = try graph.field(state.syntax.pool, row, "fields")
        const fields = try graph.items(state.syntax.pool, fields_id)
        const field_type_id = try graph.field(state.syntax.pool, fields[index], "ty")
        const field_type = try graph.number(state.syntax.pool, field_type_id)
        path.bases.append(base)
        path.indices.append(index)
        const field_value = try record_places.field(mut state.batch, context, base, index, field_type)
        path.current = field_value
        path.ty = field_type
    if len(path.bases) == 0:
        const rejection = try problem(state, span, "P_BODY_PROFILE", "tuple assignment is outside the record body profile")
        fail rejection
    const rhs_id = try graph.field(state.syntax.pool, assignment, "value")
    const rhs_raw = try graph.number(state.syntax.pool, rhs_id)
    const rhs = try expression_expected(mut state, rhs_raw, path.ty)
    _ = try require(state, rhs.ty, path.ty, span)
    const op_id = try graph.field(state.syntax.pool, assignment, "op")
    const op = try graph.get(state.syntax.pool, op_id)
    mut mode = b"set"
    mut value = rhs.id
    if op.data != b"set":
        mode = b"augmented"
        if op.data == b"add" and list_types.element_type(state.batch.facts.lists, path.ty) >= 0:
            mode = b"extend"
        else:
            if managed(state, path.ty):
                if op.data != b"add":
                    const rejection = try problem(state, span, "E_TEXT_OPERATOR", "a managed collection augments with `+=` only, and str, bytes and list are the types that support it")
                    fail rejection
            elif path.ty != 0:
                const rejection = try problem(state, span, "E_TYPE", "operation requires an integer type")
                fail rejection
            elif op.data == b"div":
                const rejection = try problem(state, span, "E_TYPE", "augmented `/=` produces a float; declare the binding as float or use `//=`")
                fail rejection
            mut operator = op.data
            if operator == b"rem":
                operator = b"floor_rem"
            value = try list_lower.binary(mut state.batch, context, operator, path.current, rhs.id, path.ty)
    mut reference_parameter = False
    if destination.dead_owner >= 0:
        const local = state.scope.locals[destination.dead_owner]
        reference_parameter = local.origin == b"parameter" and local.mutable
    const result = try record_places.finish(mut state.batch, mut state.scope, context, record_places.Finish(destination=destination, path=path, value=value, mode=mode, reference_parameter=reference_parameter))
    const id = try list_lower.append(mut state.batch, context, result)
    return Expression(id=id, ty=15)


func variant_owner(mut state: State, span: int, expected: int) -> int fails syntax_value.Problem:
    const spelling = try graph.spelling(state.syntax.pool, state.syntax.source, span)
    if spelling == b"Result" or spelling == b"Option":
        mut available = state.batch.facts.lists.types.variants.result.id >= 0
        if spelling == b"Option":
            available = state.batch.facts.lists.types.variants.option.id >= 0
        if available:
            const shape = try variants.shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, expected)
            if shape.valid:
                const row = state.batch.facts.lists.types.records.rows[expected - 19]
                const name_id = try graph.field(state.syntax.pool, row, "name")
                const name = try graph.get(state.syntax.pool, name_id)
                if len(name.data) > len(spelling) and name.data[:len(spelling)] == spelling and name.data[len(spelling)] == 60:
                    return expected
            const rejection = try problem(state, span, "E_GENERIC_INFERENCE", "a generic variant infers its type arguments from the expected type; annotate the binding, parameter or result")
            fail rejection
    mut ty = -1
    if len(state.syntax.modules) == 0:
        ty = try nominal_key(mut state, spelling, span)
    else:
        const request = record_names.Request(span=span, owner=-1, name=span)
        const is_type = try record_names.is_type(state.syntax.pool, state.syntax.source, state.syntax.modules, request)
        if not is_type:
            return -1
        const resolution = try record_names.resolve(mut state.problems, state.syntax.pool, state.syntax.source, state.syntax.modules, request)
        ty = try nominal_key(mut state, resolution.key, span)
        if ty >= 0 and resolution.from >= 0 and resolution.import_index >= 0:
            state.syntax.usage[resolution.from][resolution.import_index] = True
    const shape = try variants.shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, ty)
    if shape.valid:
        return ty
    return -1


public func variant_tag(state: State, ty: int, span: int) -> int fails syntax_value.Problem:
    const shape = try variants.shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, ty)
    if not shape.valid:
        const rejection = try problem(state, span, "E_TYPE", "operation requires an enum or tagged union")
        fail rejection
    const name = try graph.spelling(state.syntax.pool, state.syntax.source, span)
    const tag = variants.case_tag(shape, name)
    if tag >= 0:
        return tag
    mut labels: bytes[] = []
    for member in shape.cases:
        labels.append(member.name)
    match record_name_index.make(labels):
        case Ok(table):
            mut declared = ""
            for index in table.order:
                if len(declared) != 0:
                    declared = declared + ", "
                const label = try suggestions.text(table.names[index])
                declared = declared + label
            const rejection = try problem(state, span, "E_UNKNOWN_VARIANT", "variant is not declared on this type; declared variants: " + declared)
            fail rejection
        case Err(error):
            fail syntax_value.Problem(code="P_BODY_LIMIT", start=0, end=0, message=error.message)


func variant_value(mut state: State, ty: int, tag: int, span: int, value_raw: int) -> Expression fails syntax_value.Problem:
    const shape = try variants.shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, ty)
    const member = shape.cases[tag]
    mut value = Expression(id=-1, ty=15)
    if value_raw >= 0:
        value = try expression_expected(mut state, value_raw, member.payload)
    if (member.payload >= 0) != (value_raw >= 0):
        const rejection = try problem(state, span, "E_VARIANT_PAYLOAD", "construction must supply exactly the payload declared for this variant")
        const declaration = try problem(state, member.declaration, "", "")
        const note = syntax_problem.Related(start=declaration.start, end=declaration.end, message="variant declared here", role="related")
        state.problems.append(syntax_problem.Diagnostic(problem=rejection, severity="err", notes=syntax_problem.Notes(related=[note], origin=[], requirement=[], edits=[])))
        fail rejection
    mut checked_value = try syntax_value.absent(mut state.batch.pool)
    if value.id >= 0:
        const value_span = try graph.field(state.syntax.pool, state.syntax.nodes[value_raw], "span")
        _ = try require(state, value.ty, member.payload, value_span)
        checked_value = try syntax_value.integer(mut state.batch.pool, value.id)
    const checked_tag = try syntax_value.integer(mut state.batch.pool, tag)
    const payload = try syntax_value.object(mut state.batch.pool, ["tag", "value"], [checked_tag, checked_value])
    const id = try emission.node(mut state.batch, state.syntax.pool, span, ty, b"variant", payload)
    return Expression(id=id, ty=ty)


public record ArmBinding:
    slot: int
    prologue: int[]


func fail_related(mut state: State, span: int, code: str, message: str, declaration: int, note: str) -> bool fails syntax_value.Problem:
    const rejection = try problem(state, span, code, message)
    const location = try problem(state, declaration, "", "")
    const related = syntax_problem.Related(start=location.start, end=location.end, message=note, role="related")
    state.problems.append(syntax_problem.Diagnostic(problem=rejection, severity="err", notes=syntax_problem.Notes(related=[related], origin=[], requirement=[], edits=[])))
    fail rejection


func pattern_tag(mut state: State, ty: int, arm: int) -> int fails syntax_value.Problem:
    const type_span = try graph.field(state.syntax.pool, arm, "ty")
    const spelling = try graph.spelling(state.syntax.pool, state.syntax.source, type_span)
    const name = try graph.field(state.syntax.pool, arm, "name")
    if len(spelling) != 0:
        mut expected = try variant_owner(mut state, type_span, ty)
        if expected < 0:
            expected = try type_at(mut state, type_span)
        _ = try require(state, expected, ty, type_span)
        return try variant_tag(state, ty, name)
    mut label = try graph.spelling(state.syntax.pool, state.syntax.source, name)
    if label == b"Ok":
        label = b"ok"
    elif label == b"Err":
        label = b"err"
    elif label == b"Some":
        label = b"some"
    elif label == b"None":
        label = b"none"
    const shape = try variants.shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, ty)
    const tag = variants.case_tag(shape, label)
    if tag < 0:
        const rejection = try problem(state, name, "E_UNKNOWN_VARIANT", "case is not a variant of the matched type")
        fail rejection
    return tag


func payload_local(mut state: State, arm_name: int, binding: int, internal_name: bytes, ty: int) -> int fails syntax_value.Problem:
    mut name = internal_name
    const internal = len(name) != 0
    if not internal:
        name = try graph.spelling(state.syntax.pool, state.syntax.source, binding)
        const top = try top_level(state, binding)
        if top or locals.find(state.scope, name) >= 0:
            const rejection = try problem(state, binding, "E_SHADOWING", "payload binding shadows an active binding or top-level name")
            fail rejection
    const slot = try locals.add(mut state.scope, name, binding, ty, False, b"local")
    state.scope.locals[slot].usage.temporary = internal
    const pending = try variants.requires_handling(state.syntax.pool, state.batch.facts.lists.types.records.rows, ty)
    state.scope.locals[slot].usage.transfer_available = pending
    return slot


func bind_arm(mut state: State, member: variants.Case, arm: int) -> ArmBinding fails syntax_value.Problem:
    const name = try graph.field(state.syntax.pool, arm, "name")
    const bindings_id = try graph.field(state.syntax.pool, arm, "bindings")
    const bindings = try graph.items(state.syntax.pool, bindings_id)
    const internal = try graph.field(state.syntax.pool, arm, "internal")
    const names_id = try graph.field(state.syntax.pool, internal, "names")
    const internal_names = try graph.items(state.syntax.pool, names_id)
    if not member.fielded:
        if len(bindings) > 1:
            _ = try fail_related(mut state, name, "E_PATTERN_PAYLOAD", "a single-payload case binds one name", member.declaration, "variant declared here")
        mut discard = False
        if len(bindings) == 1:
            const binding = try graph.get(state.syntax.pool, bindings[0])
            discard = binding.kind == 0
        const pending = try variants.requires_handling(state.syntax.pool, state.batch.facts.lists.types.records.rows, member.payload)
        if discard and pending:
            const rejection = try problem(state, name, "E_RESULT_DISCARD", "nested result payload requires a binding and explicit handling")
            fail rejection
        if (member.payload >= 0) != (len(bindings) == 1):
            _ = try fail_related(mut state, name, "E_PATTERN_PAYLOAD", "payload variants require a binding or (discard); empty variants take neither", member.declaration, "variant declared here")
        if len(bindings) == 0 or discard:
            return ArmBinding(slot=-1, prologue=[])
        mut key = b""
        if len(internal_names) != 0:
            const value = try graph.get(state.syntax.pool, internal_names[0])
            key = value.data
        const slot = try payload_local(mut state, name, bindings[0], key, member.payload)
        return ArmBinding(slot=slot, prologue=[])
    const row = record_types.schema(state.batch.facts.lists.types.records, member.payload)
    if row < 0:
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="fielded match payload is not an ordinary record")
    const fields_id = try graph.field(state.syntax.pool, row, "fields")
    const fields = try graph.items(state.syntax.pool, fields_id)
    const labels_id = try graph.field(state.syntax.pool, arm, "binding_names")
    const labels = try graph.items(state.syntax.pool, labels_id)
    const patterns_id = try graph.field(state.syntax.pool, arm, "payload_patterns")
    const patterns = try graph.items(state.syntax.pool, patterns_id)
    if (len(labels) != 0 and len(labels) != len(bindings)) or (len(internal_names) != 0 and len(internal_names) != len(bindings)) or (len(patterns) != 0 and len(patterns) != len(bindings)):
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid normalized field pattern cardinalities")
    mut edits: syntax_problem.Edit[] = []
    for position in range(len(bindings)):
        mut supplied = False
        if len(labels) != 0:
            const label = try graph.get(state.syntax.pool, labels[position])
            supplied = label.kind != 0
        if supplied or position >= len(fields):
            continue
        mut site = name
        const binding = try graph.get(state.syntax.pool, bindings[position])
        if binding.kind != 0:
            site = bindings[position]
        if position < len(patterns):
            const pattern = try graph.field(state.syntax.pool, patterns[position], "pattern")
            site = try graph.field(state.syntax.pool, pattern, "span")
        const location = try problem(state, site, "", "")
        const label_id = try graph.field(state.syntax.pool, fields[position], "name")
        const label = try graph.get(state.syntax.pool, label_id)
        edits.append(syntax_problem.Edit(start=location.start, end=location.start, text=label.data + b"="))
    if len(edits) != 0:
        const rejection = try problem(state, name, "E_NAMED_PATTERN", "payload fields must be supplied by name")
        state.problems.append(syntax_problem.repaired(rejection, edits))
        fail rejection
    if len(labels) == 0:
        const rejection = try problem(state, name, "E_NAMED_PATTERN", "named enum payload fields require labelled patterns")
        fail rejection
    mut ordered: int[] = []
    mut keys: bytes[] = []
    mut seen: bool[] = []
    for field in fields:
        ordered.append(-1)
        keys.append(b"")
        seen.append(False)
    for position in range(len(bindings)):
        const label = try graph.get(state.syntax.pool, labels[position])
        if label.kind == 0:
            const rejection = try problem(state, name, "E_NAMED_PATTERN", "named enum payload fields require labelled patterns")
            fail rejection
        const index = try record_field(state, member.payload, labels[position])
        if seen[index]:
            const rejection = try problem(state, labels[position], "E_DUPLICATE_FIELD", "pattern field is bound more than once")
            fail rejection
        seen[index] = True
        ordered[index] = bindings[position]
        if len(internal_names) != 0:
            const key = try graph.get(state.syntax.pool, internal_names[position])
            keys[index] = key.data
    mut all_discard = True
    for index in range(len(fields)):
        if not seen[index]:
            const rejection = try problem(state, name, "E_PATTERN_PAYLOAD", "pattern must name every enum payload field; use `_` to discard one")
            fail rejection
        const binding = try graph.get(state.syntax.pool, ordered[index])
        if binding.kind != 0:
            all_discard = False
    if all_discard:
        const pending = try variants.requires_handling(state.syntax.pool, state.batch.facts.lists.types.records.rows, member.payload)
        if pending:
            const rejection = try problem(state, name, "E_RESULT_DISCARD", "nested result payload requires a binding and explicit handling")
            fail rejection
        return ArmBinding(slot=-1, prologue=[])
    const slot = try locals.add(mut state.scope, b"", name, member.payload, False, b"local")
    state.scope.active = state.scope.active[:len(state.scope.active) - 1]
    state.scope.locals[slot].usage.temporary = True
    state.scope.locals[slot].usage.reads = 1
    mut prologue: int[] = []
    for index in range(len(fields)):
        const field_type_id = try graph.field(state.syntax.pool, fields[index], "ty")
        const field_type = try graph.number(state.syntax.pool, field_type_id)
        const binding = try graph.get(state.syntax.pool, ordered[index])
        if binding.kind == 0:
            const pending = try variants.requires_handling(state.syntax.pool, state.batch.facts.lists.types.records.rows, field_type)
            if pending:
                const declaration = try graph.field(state.syntax.pool, fields[index], "declaration")
                _ = try fail_related(mut state, name, "E_RESULT_DISCARD", "discarding this field would drop a result-bearing payload; bind it and handle the result", declaration, "result-bearing field declared here")
            continue
        const local = try payload_local(mut state, name, ordered[index], keys[index], field_type)
        const slot_value = try syntax_value.integer(mut state.batch.pool, slot)
        const base = try emission.node(mut state.batch, state.syntax.pool, name, member.payload, b"local", slot_value)
        const base_value = try syntax_value.integer(mut state.batch.pool, base)
        const index_value = try syntax_value.integer(mut state.batch.pool, index)
        const projection = try syntax_value.object(mut state.batch.pool, ["base", "index"], [base_value, index_value])
        const projected = try emission.node(mut state.batch, state.syntax.pool, ordered[index], field_type, b"field", projection)
        const initialized = try emission.store(mut state.batch, local, projected)
        const statement_id = try emission.statement(mut state.batch, state.syntax.pool, ordered[index], False, b"initialize", initialized)
        prologue.append(statement_id)
    return ArmBinding(slot=slot, prologue=prologue)


func match_payload(mut state: State, payload: int, span: int) -> Statement fails syntax_value.Problem:
    const value_id = try graph.field(state.syntax.pool, payload, "value")
    const value_raw = try graph.number(state.syntax.pool, value_id)
    try hint_option_operand(mut state, value_raw)
    const value = try expression(mut state, value_raw)
    const arms_id = try graph.field(state.syntax.pool, payload, "arms")
    const raw_arms = try graph.items(state.syntax.pool, arms_id)
    const arms = try variant_patterns.normalize(mut state.syntax.pool, mut state.syntax.nodes, mut state.syntax.statements, state.syntax.source, raw_arms)
    const shape = try variants.shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, value.ty)
    if not shape.valid:
        const rejection = try problem(state, span, "E_TYPE", "operation requires an enum or tagged union")
        fail rejection
    mut cover = try variant_patterns.coverage(len(shape.cases))
    const pending_before = try pending_flow.snapshot(state.scope, len(state.scope.locals))
    const init_before = locals_flow.snapshot(state.scope)
    const options_before = option_flow.snapshot(state.control.options)
    mut pending_continuation: pending_flow.Pending[] = []
    mut init_continuation: bool[] = []
    mut continuation = False
    mut terminates = True
    mut checked_arms: int[] = []
    for position in range(len(arms)):
        const arm = arms[position]
        option_flow.restore(mut state.control.options, options_before)
        const active = state.scope.active
        try pending_flow.restore(mut state.scope, pending_before)
        locals_flow.restore(mut state.scope, init_before)
        const name = try graph.field(state.syntax.pool, arm, "name")
        const type_span = try graph.field(state.syntax.pool, arm, "ty")
        const type_text = try graph.spelling(state.syntax.pool, state.syntax.source, type_span)
        const name_text = try graph.spelling(state.syntax.pool, state.syntax.source, name)
        const bindings_id = try graph.field(state.syntax.pool, arm, "bindings")
        const bindings = try graph.items(state.syntax.pool, bindings_id)
        const internal = try graph.field(state.syntax.pool, arm, "internal")
        const wildcard_id = try graph.field(state.syntax.pool, internal, "wildcard")
        const wildcard_value = try graph.get(state.syntax.pool, wildcard_id)
        const wildcard = wildcard_value.integer != 0 or (len(type_text) == 0 and name_text == b"_" and len(bindings) == 0)
        const first_local = len(state.scope.locals)
        mut tags: int[] = []
        mut bound = ArmBinding(slot=-1, prologue=[])
        if wildcard:
            const skip = try variant_patterns.wildcard_before(state.syntax.pool, cover, name, variant_patterns.Wildcard(internal=wildcard_value.integer != 0, last=position + 1 == len(arms)))
            if skip:
                continue
        else:
            const tag = try pattern_tag(mut state, value.ty, arm)
            try variant_patterns.named(state.syntax.pool, mut cover, name, tag, mut state.problems)
            bound = try bind_arm(mut state, shape.cases[tag], arm)
            tags.append(tag)
        const body_id = try graph.field(state.syntax.pool, arm, "body")
        const body_raw = try graph.number(state.syntax.pool, body_id)
        mut body = try statement(mut state, body_raw)
        if len(bound.prologue) != 0:
            mut children = bound.prologue
            children.append(body.id)
            const block = try emission.ids(mut state.batch, children)
            const id = try emission.statement(mut state.batch, state.syntax.pool, span, body.terminates, b"block", block)
            body = Statement(id=id, terminates=body.terminates, looping=body.looping)
        if not body.terminates:
            if not wildcard:
                _ = try obligations.handled(state.syntax.pool, state.batch.facts.lists.types.records.rows, state.scope, first_local, span, mut state.problems)
            if continuation:
                const difference = try pending_flow.mismatch(state.scope, pending_continuation)
                _ = try obligations.consistent(state.syntax.pool, state.scope, difference, span, False, mut state.problems)
                locals_flow.intersect(mut state.scope, init_continuation)
                init_continuation = locals_flow.snapshot(state.scope)
            else:
                const pending = try pending_flow.snapshot(state.scope, len(pending_before))
                pending_continuation = pending
                init_continuation = locals_flow.snapshot(state.scope)
                continuation = True
        terminates = terminates and body.terminates
        if wildcard:
            mut pending_payloads: bool[] = []
            for member in shape.cases:
                const pending = try variants.requires_handling(state.syntax.pool, state.batch.facts.lists.types.records.rows, member.payload)
                pending_payloads.append(pending)
            const uncovered = try variant_patterns.wildcard_after(state.syntax.pool, mut cover, name, pending_payloads)
            tags = uncovered
        for tag in tags:
            const tag_value = try syntax_value.integer(mut state.batch.pool, tag)
            mut slot_value = try syntax_value.absent(mut state.batch.pool)
            if bound.slot >= 0:
                slot_value = try syntax_value.integer(mut state.batch.pool, bound.slot)
            const body_value = try syntax_value.integer(mut state.batch.pool, body.id)
            const checked = try syntax_value.object(mut state.batch.pool, ["tag", "slot", "body"], [tag_value, slot_value, body_value])
            checked_arms.append(checked)
        state.scope.active = active
    mut cases: int[] = []
    for member in shape.cases:
        cases.append(member.row)
    try variant_patterns.complete(state.syntax.pool, cover, cases, span, mut state.problems)
    if continuation:
        try pending_flow.restore(mut state.scope, pending_continuation)
        locals_flow.restore(mut state.scope, init_continuation)
    else:
        locals_flow.restore(mut state.scope, init_before)
    const checked_value = try syntax_value.integer(mut state.batch.pool, value.id)
    const checked_cases = try syntax_value.sequence(mut state.batch.pool, checked_arms)
    const borrowed = try syntax_value.boolean(mut state.batch.pool, False)
    const output = try syntax_value.object(mut state.batch.pool, ["value", "arms", "borrowed"], [checked_value, checked_cases, borrowed])
    const id = try emission.statement(mut state.batch, state.syntax.pool, span, terminates, b"match", output)
    return Statement(id=id, terminates=terminates)


func error_case(state: State, expected: int, actual: int) -> int fails syntax_value.Problem:
    const shape = try variants.shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, expected)
    if not shape.valid or not shape.is_union:
        return -1
    for position in range(len(shape.cases)):
        const member = shape.cases[position]
        if member.payload == actual:
            return position
        if member.fielded and member.payload >= 19:
            const row = record_types.schema(state.batch.facts.lists.types.records, member.payload)
            if row >= 0:
                const fields_id = try graph.field(state.syntax.pool, row, "fields")
                const fields = try graph.items(state.syntax.pool, fields_id)
                if len(fields) == 1:
                    const type_id = try graph.field(state.syntax.pool, fields[0], "ty")
                    const ty = try graph.number(state.syntax.pool, type_id)
                    if ty == actual:
                        return position
    return -1


public func fresh_control() -> Control:
    return Control(next=0, active=[], exited=[], values=Values(yield_type=-1, yield_slot=-1, depth=0, temporaries=[], gathers=[], counters=[]), options=option_flow.State(present=[]))


func yields_every_path(state: State, raw_id: int, depth: int) -> bool fails syntax_value.Problem:
    if depth > 256 or raw_id < 0 or raw_id >= len(state.syntax.statements):
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid match expression statement tree")
    const data_id = try graph.field(state.syntax.pool, state.syntax.statements[raw_id], "data")
    const data = try graph.get(state.syntax.pool, data_id)
    const payload = try graph.payload(state.syntax.pool, data_id)
    if data.data == b"yield_value" or data.data == b"ret" or data.data == b"fail":
        return True
    if data.data == b"block":
        const children = try graph.items(state.syntax.pool, payload)
        if len(children) == 0:
            return False
        for position in range(len(children) - 1):
            const child = try graph.number(state.syntax.pool, children[position])
            if child < 0 or child >= len(state.syntax.statements):
                fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid match expression child")
            const child_data_id = try graph.field(state.syntax.pool, state.syntax.statements[child], "data")
            const child_data = try graph.get(state.syntax.pool, child_data_id)
            if child_data.data == b"yield_value":
                return False
        const last = try graph.number(state.syntax.pool, children[len(children) - 1])
        return try yields_every_path(state, last, depth + 1)
    if data.data == b"branch":
        const then_id = try graph.field(state.syntax.pool, payload, "then_body")
        const then_body = try graph.number(state.syntax.pool, then_id)
        const then_yields = try yields_every_path(state, then_body, depth + 1)
        const else_id = try graph.field(state.syntax.pool, payload, "else_body")
        const else_value = try graph.get(state.syntax.pool, else_id)
        if not then_yields or else_value.kind == 0:
            return False
        const else_body = try graph.number(state.syntax.pool, else_id)
        return try yields_every_path(state, else_body, depth + 1)
    return False


func fielded_variant(mut state: State, ty: int, tag: int, span: int, name: int, arguments: int[], labels: int[]) -> Expression fails syntax_value.Problem:
    const catalog = state.batch.facts.lists.types.records
    const shape = try variants.shape(state.syntax.pool, catalog.rows, ty)
    const member = shape.cases[tag]
    if member.payload < 0:
        _ = try fail_related(mut state, span, "E_VARIANT_PAYLOAD", "this case carries no payload, so it is constructed without parentheses", member.declaration, "variant declared here")
    const declaration = catalog.by_type[ty]
    if declaration < 0:
        const rejection = try problem(state, span, "P_BODY_PROFILE", "fielded builtin variant template is outside the body profile")
        fail rejection
    const cases_id = try graph.field(state.syntax.pool, catalog.declarations[declaration], "cases")
    const cases = try graph.items(state.syntax.pool, cases_id)
    const fields_id = try graph.field(state.syntax.pool, cases[tag], "fields")
    const fields = try graph.items(state.syntax.pool, fields_id)
    const initializers = try variant_construct.bind(state.syntax.pool, state.syntax.nodes, fields, variant_construct.Input(source=state.syntax.source, name=name, span=span, arguments=arguments, argument_names=labels), mut state.problems)
    const values = try record_initializers(mut state, member.payload, span, initializers)
    const value = try emission.node(mut state.batch, state.syntax.pool, span, member.payload, b"record", values)
    const checked_tag = try syntax_value.integer(mut state.batch.pool, tag)
    const checked_value = try syntax_value.integer(mut state.batch.pool, value)
    const payload = try syntax_value.object(mut state.batch.pool, ["tag", "value"], [checked_tag, checked_value])
    const id = try emission.node(mut state.batch, state.syntax.pool, span, ty, b"variant", payload)
    return Expression(id=id, ty=ty)


func numeric_parse_name(name: bytes) -> bool:
    return name == b"parse_int" or name == b"parse_float" or name == b"parse_int_range" or name == b"parse_float_range"


func parse_numeric_access(mut state: State, span: int, base: Expression, owner: int, site: int, kind: bytes, inputs: int[]) -> Expression fails syntax_value.Problem:
    if base.ty != state.batch.facts.string_type and base.ty != state.batch.facts.bytes_type:
        const rejection = try problem(state, span, "P_BODY_PROFILE", "numeric parsing receiver is outside the managed sequence profile")
        fail rejection
    if owner >= 0:
        _ = try require_readable(mut state, owner, site)
    const floating = kind == b"parse_float" or kind == b"parse_float_range"
    const ranged = kind == b"parse_int_range" or kind == b"parse_float_range"
    mut arity = 0
    if ranged:
        arity = 2
    if len(inputs) != arity:
        mut receiver = "str"
        if base.ty == state.batch.facts.bytes_type:
            receiver = "bytes"
        mut signature = "() -> Option[int]"
        if floating:
            signature = "() -> Option[float]"
        if ranged:
            signature = "(start: int, end: int) -> Option[int]"
            if floating:
                signature = "(start: int, end: int) -> Option[float]"
        const method_name = try suggestions.text(kind)
        const rejection = try problem(state, span, "E_ARITY", "`" + receiver + "." + method_name + signature + "` takes " + str(arity) + " arguments, but this call passes " + str(len(inputs)))
        fail rejection
    mut arguments: int[] = []
    for input in inputs:
        const raw = try graph.number(state.syntax.pool, input)
        const argument = try expression(mut state, raw)
        if not scalars.is_integer(argument.ty):
            const rejection = try problem(state, span, "E_TYPE", "operation requires an integer type")
            fail rejection
        arguments.append(argument.id)
    mut element = 0
    if floating:
        element = state.batch.facts.float_type
    const ty = try list_types.union_intern(mut state.batch.facts.lists, mut state.syntax.pool, element, -1, site, False)
    const context = list_lower.Context(input=state.syntax.pool, span=span)
    if owner >= 0:
        state.scope.locals[owner].usage.reads = state.scope.locals[owner].usage.reads + 1
        const id = try list_lower.operation(mut state.batch, context, list_lower.Operation(owner=owner, kind=kind, arguments=arguments, ty=ty))
