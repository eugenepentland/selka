                const input_span = try graph.field(state.syntax.pool, state.syntax.nodes[raw], "span")
                const ty = try list_types.intern(mut state.batch.facts.lists, state.syntax.pool, list_types.Recipe(id=0, element=schema.key, span=input_span), [state.batch.facts.string_type, state.batch.facts.bytes_type])
                hint = ty
        const value = try expression_expected(mut state, raw, hint)
        values.append(value)
    const arity = if empty then 0 else 1
    _ = try set_arity(mut state, span, schema.id, schema.key, method, len(inputs), arity)
    return try set_checked(mut state, span, schema, base.id, method, values)


