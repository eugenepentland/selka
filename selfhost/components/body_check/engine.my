public record Syntax:
    pool: syntax_value.Pool
    source: bytes
    nodes: int[]
    statements: int[]
    functions: int[]
    modules: int[]
    usage: bool[][]


public record State:
    syntax: Syntax
    batch: emission.Batch
    scope: locals.Scope
    return_type: int
    depth: int
    control: Control
    problems: syntax_problem.Diagnostic[]


public record Expression:
    id: int
    ty: int


public record GatherSink:
    kind: bytes
    expected: int
    owner: int


public record Values:
    yield_type: int
    yield_slot: int
    depth: int
    temporaries: int[]
    gathers: GatherSink[]
    counters: int[]
    trapping_open: int = -1


public record Control:
    next: int
    active: int[]
    exited: bool[]
    values: Values
    options: option_flow.State
    success_type: int = 15
    failure_type: int = -1


public record Statement:
    id: int
    terminates: bool
    looping: bool = False


public func make(pool: syntax_value.Pool, source: bytes, program: int) -> State fails syntax_value.Problem:
    const node_list = try graph.field(pool, program, "nodes")
    const statement_list = try graph.field(pool, program, "statements")
    const function_list = try graph.field(pool, program, "functions")
    const nodes = try graph.items(pool, node_list)
    const statements = try graph.items(pool, statement_list)
    const functions = try graph.items(pool, function_list)
    mut batch = emission.empty()
    for function in functions:
        const span = try graph.field(pool, function, "name")
        const name = try graph.spelling(pool, source, span)
        batch.facts.top_names.append(name)
    const types = try graph.field(pool, program, "types")
    for field_name in ["records", "domains", "resources", "variants", "constraints"]:
        const list_id = try graph.field(pool, types, field_name)
        const declarations = try graph.items(pool, list_id)
        for declaration in declarations:
            const span = try graph.field(pool, declaration, "name")
            const name = try graph.spelling(pool, source, span)
            batch.facts.top_names.append(name)
    const expressions = try graph.field(pool, types, "expressions")
    const source_types = try graph.get(pool, expressions)
    for position in range(len(source_types.names)):
        if source_types.names[position] == "arrays":
            const arrays = try graph.items(pool, source_types.children[position])
            batch.facts.lists.types.arrays.sources = arrays
    const applications_id = try graph.field(pool, expressions, "applications")
    const applications = try graph.items(pool, applications_id)
    batch.facts.applications = applications
    const aliases_id = try graph.field(pool, expressions, "aliases")
    const aliases = try graph.items(pool, aliases_id)
    for alias in aliases:
        const span = try graph.field(pool, alias, "name")
        const name = try graph.spelling(pool, source, span)
        batch.facts.top_names.append(name)
    return State(syntax=Syntax(pool=pool, source=source, nodes=nodes, statements=statements, functions=functions, modules=[], usage=[]), batch=batch, scope=locals.empty(), return_type=15, depth=0, control=fresh_control(), problems=[])


public func problem(state: State, span: int, code: str, message: str) -> syntax_value.Problem fails syntax_value.Problem:
    const begin = try graph.field(state.syntax.pool, span, "start")
    const finish = try graph.field(state.syntax.pool, span, "end")
    const start = try graph.number(state.syntax.pool, begin)
    const end = try graph.number(state.syntax.pool, finish)
    return syntax_value.Problem(code=code, start=start, end=end, message=message)


public func require(state: State, actual: int, expected: int, span: int) -> bool fails syntax_value.Problem:
    if actual != expected:
        const rejection = try problem(state, span, "E_TYPE", "expected " + type_name(state, expected) + ", found " + type_name(state, actual))
        fail rejection
    return True


public func declared_symbol(state: State, span: int) -> bool fails syntax_value.Problem:
    const name = try graph.spelling(state.syntax.pool, state.syntax.source, span)
    if len(state.syntax.modules) == 0:
        const ty = try record_types.named(state.batch.facts.lists.types.records, name)
        return ty != -1
    const start_id = try graph.field(state.syntax.pool, span, "start")
    const start = try graph.number(state.syntax.pool, start_id)
    const module = try names.module_at(state.syntax.pool, state.syntax.modules, start)
    if module < 0:
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="binding has no source module")
    const symbols_id = try graph.field(state.syntax.pool, state.syntax.modules[module], "symbols")
    const symbols = try graph.items(state.syntax.pool, symbols_id)
    for symbol in symbols:
        const name_id = try graph.field(state.syntax.pool, symbol, "name")
        const candidate = try graph.get(state.syntax.pool, name_id)
        if candidate.data == name:
            return True
    return False


public func top_level(state: State, span: int) -> bool fails syntax_value.Problem:
    const name = try graph.spelling(state.syntax.pool, state.syntax.source, span)
    if len(state.syntax.modules) == 0:
        for candidate in state.batch.facts.top_names:
            if candidate == name:
                return True
        for builtin in [b"int", b"i64", b"bool", b"Unit", b"i8", b"i16", b"i32", b"u8", b"u16", b"u32", b"u64", b"str", b"bytes", b"float"]:
            if builtin == name:
                return True
        return False
    const start_id = try graph.field(state.syntax.pool, span, "start")
    const start = try graph.number(state.syntax.pool, start_id)
    const module = try names.module_at(state.syntax.pool, state.syntax.modules, start)
    if module < 0:
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="binding has no source module")
    const symbols_id = try graph.field(state.syntax.pool, state.syntax.modules[module], "symbols")
    const symbols = try graph.items(state.syntax.pool, symbols_id)
    for symbol in symbols:
        const name_id = try graph.field(state.syntax.pool, symbol, "name")
        const candidate = try graph.get(state.syntax.pool, name_id)
        if candidate.data == name:
            return True
    const imports_id = try graph.field(state.syntax.pool, state.syntax.modules[module], "imports")
    const imports = try graph.items(state.syntax.pool, imports_id)
    for imported in imports:
        const name_id = try graph.field(state.syntax.pool, imported, "name")
        const candidate = try graph.get(state.syntax.pool, name_id)
        const alias_id = try graph.field(state.syntax.pool, imported, "alias")
        const alias = try graph.get(state.syntax.pool, alias_id)
        if candidate.data == name or alias.data == name:
            return True
    return False


func prelude_call(name: bytes) -> bool:
    for builtin in [b"len", b"range", b"int", b"i64", b"bool", b"str", b"bytes", b"byte_buffer", b"list", b"set", b"dict", b"tuple", b"print", b"sorted", b"min", b"max", b"abs", b"sum", b"all", b"any", b"enumerate", b"reversed", b"zip", b"Some", b"Ok", b"Err", b"parse_int", b"parse_float", b"ord", b"float", b"sqrt", b"floor", b"ceil", b"trunc", b"round"]:
        if name == builtin:
            return True
    return False


public func expression(mut state: State, raw_id: int) -> Expression fails syntax_value.Problem:
    if state.control.values.depth == 0:
        state.control.values.temporaries = []
    const first = len(state.control.values.temporaries)
    state.control.values.depth = state.control.values.depth + 1
    mut value = try checked_expression(mut state, raw_id)
    const expected = state.batch.facts.expected[raw_id]
    if expected >= 0 and expected != value.ty:
        const span = try graph.field(state.syntax.pool, state.syntax.nodes[raw_id], "span")
        const context = failure_lower.Context(pool=state.syntax.pool, records=state.batch.facts.lists.types.records.rows, span=span)
        const injected = try failure_lower.inject_optional(mut state.batch, context, expected, value.id)
        if injected != value.id:
            const ty = try failure_lower.type_of(state.batch, injected)
            state.batch.resolved[raw_id] = injected
            value = Expression(id=injected, ty=ty)
    state.control.values.temporaries = state.control.values.temporaries[:first]
    state.control.values.temporaries.append(value.ty)
    state.control.values.depth = state.control.values.depth - 1
    return value


func repeatable_type(state: State, ty: int) -> bool:
    return (ty >= 0 and (ty == state.batch.facts.string_type or ty == state.batch.facts.bytes_type)) or list_types.element_type(state.batch.facts.lists, ty) >= 0


func obvious_type(state: State, raw: int, depth: int) -> int fails syntax_value.Problem:
    if depth >= 256:
        return -1
    const data_id = try graph.field(state.syntax.pool, state.syntax.nodes[raw], "data")
    const data = try graph.get(state.syntax.pool, data_id)
    if data.data == b"name":
        const name = try graph.spelling(state.syntax.pool, state.syntax.source, data.children[0])
        const slot = locals.find(state.scope, name)
        if slot >= 0:
            const declared = state.scope.locals[slot].ty
            if option_flow.has(state.control.options, slot):
                const shape = try variants.option_shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, declared)
                if shape.valid:
                    return shape.element
            return declared
        match constant_hint(state, data.children[0]):
            case Ok(ty):
                return ty
            case Err(unused):
                return -1
    if raw < len(state.batch.facts.expected) and state.batch.facts.expected[raw] >= 0:
        return state.batch.facts.expected[raw]
    if data.data == b"index":
        const base_id = try graph.field(state.syntax.pool, data.children[0], "base")
        const base = try graph.number(state.syntax.pool, base_id)
        const ty = try obvious_type(state, base, depth + 1)
        return list_types.element_type(state.batch.facts.lists, ty)
    if data.data == b"field":
        const base_id = try graph.field(state.syntax.pool, data.children[0], "base")
        const base = try graph.number(state.syntax.pool, base_id)
        const ty = try obvious_type(state, base, depth + 1)
        const rows = state.batch.facts.lists.types.records.rows
        if ty < 19 or ty - 19 >= len(rows):
            return -1
        const name_id = try graph.field(state.syntax.pool, data.children[0], "name")
        const name = try graph.spelling(state.syntax.pool, state.syntax.source, name_id)
        const fields_id = try graph.field(state.syntax.pool, rows[ty - 19], "fields")
        const fields = try graph.items(state.syntax.pool, fields_id)
        for field in fields:
            const field_name_id = try graph.field(state.syntax.pool, field, "name")
            const field_name = try graph.get(state.syntax.pool, field_name_id)
            if field_name.data == name:
                const field_type = try graph.field(state.syntax.pool, field, "ty")
                return try graph.number(state.syntax.pool, field_type)
    return -1


func constant_hint(state: State, name: int) -> int fails syntax_value.Problem:
    if len(state.syntax.functions) == 0:
        return -1
    mut scratch = state
    const policy = try graph.field(scratch.syntax.pool, scratch.syntax.functions[0], "policy")
    const owner = try graph.field(scratch.syntax.pool, policy, "owner")
    const target = try constant_target(mut scratch, owner, name, name)
    if target < 0:
        return -1
    const signature = try graph.field(scratch.syntax.pool, scratch.syntax.functions[target], "signature")
    const annotation = try graph.field(scratch.syntax.pool, signature, "return_type")
    const ty = try type_at(mut scratch, annotation)
    if scalars.is_integer(ty):
        return ty
    return -1


func checked_expression(mut state: State, raw_id: int) -> Expression fails syntax_value.Problem:
    if raw_id < 0 or raw_id >= len(state.syntax.nodes):
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid expression index")
    if len(state.batch.resolved) > len(state.syntax.nodes) or len(state.batch.facts.expected) > len(state.syntax.nodes):
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="expression cache exceeds raw node table")
    while len(state.batch.resolved) < len(state.syntax.nodes):
        state.batch.resolved.append(-1)
    while len(state.batch.facts.expected) < len(state.syntax.nodes):
        state.batch.facts.expected.append(-1)
    const cached = state.batch.resolved[raw_id]
    if cached >= 0:
        const node = state.batch.nodes[cached]
        const type_id = try graph.field(state.batch.pool, node, "ty")
        const ty = try graph.number(state.batch.pool, type_id)
        return Expression(id=cached, ty=ty)
    if state.depth >= 256:
        fail syntax_value.Problem(code="P_BODY_LIMIT", start=0, end=0, message="body expression depth exceeded")
    state.depth = state.depth + 1
    const raw = state.syntax.nodes[raw_id]
    const span = try graph.field(state.syntax.pool, raw, "span")
    const data_id = try graph.field(state.syntax.pool, raw, "data")
    const data = try graph.get(state.syntax.pool, data_id)
    const payload = try graph.payload(state.syntax.pool, data_id)
    mut ty = 15
    mut result_payload = -1
    if data.data == b"integer":
        const spelling = try graph.spelling(state.syntax.pool, state.syntax.source, payload)
        const location = try problem(state, span, "", "")
        if floating_literals.spelling(spelling) or (state.batch.facts.float_type >= 0 and state.batch.facts.expected[raw_id] == state.batch.facts.float_type):
            const bits = try floating_literals.parse(spelling, location.start, location.end)
            const lowered = try numeric_lower.literal(mut state.batch, list_lower.Context(input=state.syntax.pool, span=span), bits)
            const id = try list_lower.append(mut state.batch, list_lower.Context(input=state.syntax.pool, span=span), lowered)
            state.batch.resolved[raw_id] = id
            state.depth = state.depth - 1
            return Expression(id=id, ty=state.batch.facts.float_type)
        const literal = try integer_literals.parse(spelling, False, state.batch.facts.expected[raw_id], location.start, location.end)
        ty = literal.ty
        if literal.upper:
            result_payload = try syntax_value.upper_integer(mut state.batch.pool, literal.value)
        else:
            result_payload = try syntax_value.integer(mut state.batch.pool, literal.value)
    elif data.data == b"cast":
        const type_span = try graph.field(state.syntax.pool, payload, "ty")
        const text = try graph.spelling(state.syntax.pool, state.syntax.source, type_span)
        const location = try problem(state, type_span, "", "")
        ty = try scalars.annotation(text, location.start, location.end)
        const value_id = try graph.field(state.syntax.pool, payload, "value")
        const value_raw = try graph.number(state.syntax.pool, value_id)
        const value = try expression(mut state, value_raw)
        if state.batch.facts.float_type >= 0 and value.ty == state.batch.facts.float_type:
            const context = list_lower.Context(input=state.syntax.pool, span=span)
            const lowered = try numeric_lower.to_integer(mut state.batch, context, value.id, ty)
            const id = try list_lower.append(mut state.batch, context, lowered)
            state.batch.resolved[raw_id] = id
            state.depth = state.depth - 1
            return Expression(id=id, ty=ty)
        if not scalars.is_integer(value.ty):
            const rejection = try problem(state, span, "E_TYPE", "operation requires an integer type")
            fail rejection
        result_payload = try syntax_value.integer(mut state.batch.pool, value.id)
    elif data.data == b"boolean":
        const value = try graph.get(state.syntax.pool, payload)
        if value.kind != 2:
            fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid Boolean payload")
        result_payload = try syntax_value.boolean(mut state.batch.pool, value.integer != 0)
        ty = 1
    elif data.data == b"unit":
        const spelling = try graph.spelling(state.syntax.pool, state.syntax.source, span)
        if spelling == b"None":
            const expected = state.batch.facts.expected[raw_id]
            const shape = try variants.option_shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, expected)
            if shape.valid:
                const tag = try syntax_value.integer(mut state.batch.pool, shape.none)
                const value = try syntax_value.absent(mut state.batch.pool)
                const wrapped = try syntax_value.object(mut state.batch.pool, ["tag", "value"], [tag, value])
                const id = try emission.node(mut state.batch, state.syntax.pool, span, expected, b"variant", wrapped)
                state.batch.resolved[raw_id] = id
                state.depth = state.depth - 1
                return Expression(id=id, ty=expected)
            if expected == 15:
                const rejection = try problem(state, span, "E_NONE_UNIT", "None means optional absence; write () for the Unit value")
                state.problems.append(syntax_problem.repaired(rejection, [syntax_problem.Edit(start=rejection.start, end=rejection.end, text=b"()")]))
                fail rejection
            const rejection = try problem(state, span, "E_NONE_CONTEXT", "None requires an expected optional type")
            fail rejection
        result_payload = try syntax_value.absent(mut state.batch.pool)
    elif data.data == b"text" or data.data == b"bytes":
        const value = try graph.get(state.syntax.pool, payload)
        if value.kind != 3:
            fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid sequence literal payload")
        ty = state.batch.facts.bytes_type
        mut text_literal = data.data == b"text"
        if data.data == b"bytes" and state.batch.facts.expected[raw_id] >= 19:
            ty = state.batch.facts.expected[raw_id]
            text_literal = ty == state.batch.facts.string_type
        const expected_bytes = state.batch.facts.expected[raw_id]
        if data.data == b"bytes" and expected_bytes >= 0 and expected_bytes != state.batch.facts.string_type and expected_bytes != state.batch.facts.bytes_type and expected_bytes != state.batch.facts.lists.types.buffer.id:
            ty = try list_types.array_intern(mut state.batch.facts.lists, mut state.syntax.pool, 5, len(value.data), span)
            text_literal = False
        if text_literal:
            ty = state.batch.facts.string_type
        if ty < 0:
            const rejection = try problem(state, span, "P_BODY_PROFILE", "managed sequence builtin is unavailable")
            fail rejection
        result_payload = try sequences.literal(mut state.batch, state.syntax.pool, span, value.data, text_literal)
        const id = try emission.node(mut state.batch, state.syntax.pool, span, ty, b"array", result_payload)
        state.batch.resolved[raw_id] = id
        state.depth = state.depth - 1
        return Expression(id=id, ty=ty)
    elif data.data == b"set_literal":
        const result = try set_literal(mut state, payload, span, state.batch.facts.expected[raw_id])
        state.batch.resolved[raw_id] = result.id
        state.depth = state.depth - 1
        return result
    elif data.data == b"dictionary_literal":
        const result = try dictionary_literal(mut state, payload, span, state.batch.facts.expected[raw_id])
        state.batch.resolved[raw_id] = result.id
        state.depth = state.depth - 1
        return result
    elif data.data == b"membership":
        const result = try membership_value(mut state, payload, span)
        state.batch.resolved[raw_id] = result.id
        state.depth = state.depth - 1
        return result
    elif data.data == b"tuple":
        const result = try tuple_value(mut state, raw_id, payload, span)
        state.batch.resolved[raw_id] = result.id
        state.depth = state.depth - 1
        return result
    elif data.data == b"list_literal":
        const fixed = array_types.schema(state.batch.facts.lists.types.arrays, state.batch.facts.expected[raw_id])
        if fixed.id >= 0 and fixed.key < 0:
            const result = try array_literal(mut state, payload, span, fixed)
            state.batch.resolved[raw_id] = result.id
            state.depth = state.depth - 1
            return result
        const inputs = try graph.items(state.syntax.pool, payload)
        mut element = list_types.element_type(state.batch.facts.lists, state.batch.facts.expected[raw_id])
        if state.batch.facts.expected[raw_id] >= 0 and element < 0:
            const rejection = try problem(state, span, "E_LIST_TYPE", "operation requires a managed list")
            fail rejection
        if len(inputs) == 0 and element < 0:
            const rejection = try problem(state, span, "E_LIST_INFERENCE", "empty list requires an expected List type")
            fail rejection
        mut values: int[] = []
        for input in inputs:
            const child = try graph.number(state.syntax.pool, input)
            if child < 0 or child >= len(state.syntax.nodes):
                fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid list element node")
            state.batch.facts.expected[child] = element
            const value = try expression(mut state, child)
            if element < 0:
                element = value.ty
            else:
                const child_span = try graph.field(state.syntax.pool, state.syntax.nodes[child], "span")
                _ = try require(state, value.ty, element, child_span)
            values.append(value.id)
        const list_type = try list_types.intern(mut state.batch.facts.lists, state.syntax.pool, list_types.Recipe(id=0, element=element, span=span), [state.batch.facts.string_type, state.batch.facts.bytes_type])
        ty = list_type
        const pending_element = try variants.requires_handling(state.syntax.pool, state.batch.facts.lists.types.records.rows, element)
        if pending_element:
            if state.batch.facts.expected[raw_id] < 0:
                fail syntax_value.Problem(code="E_LIST_ELEMENT", start=0, end=0, message="managed list elements must be copyable values without resources or result obligations")
            const rejection = try problem(state, span, "E_LIST_TYPE", "list elements require copyable storable values without pending results")
            fail rejection
        const lowered = try list_lower.literal(mut state.batch, mut state.scope, list_lower.Context(input=state.syntax.pool, span=span), list_lower.Literal(ty=ty, element=element, values=values))
        const id = try list_lower.append(mut state.batch, list_lower.Context(input=state.syntax.pool, span=span), lowered)
        state.batch.resolved[raw_id] = id
        state.depth = state.depth - 1
        return Expression(id=id, ty=ty)
    elif data.data == b"conditional":
        const result = try conditional_value(mut state, payload, span, state.batch.facts.expected[raw_id])
        state.batch.resolved[raw_id] = result.id
        state.depth = state.depth - 1
        return result
    elif data.data == b"gather":
        const result = try gather_value(mut state, payload, span, state.batch.facts.expected[raw_id])
        state.batch.resolved[raw_id] = result.id
        state.depth = state.depth - 1
        return result
    elif data.data == b"comprehension":
        const result = try comprehension(mut state, payload, span)
        state.batch.resolved[raw_id] = result.id
        state.depth = state.depth - 1
        return result
    elif data.data == b"field_assignment":
        const result = try record_assignment(mut state, payload, span)
        state.batch.resolved[raw_id] = result.id
        state.depth = state.depth - 1
        return result
    elif data.data == b"index_assignment":
        const target_id = try graph.field(state.syntax.pool, payload, "target")
        const target_raw = try graph.number(state.syntax.pool, target_id)
        _ = try list_places.writable(state.syntax.pool, state.syntax.source, state.syntax.nodes, mut state.scope, target_raw)
        const fixed_place = try array_place(state, target_raw, -1)
        if fixed_place.root >= 0:
            const assigned = try graph.field(state.syntax.pool, payload, "value")
            const operator_id = try graph.field(state.syntax.pool, payload, "op")
            const operator_value = try graph.get(state.syntax.pool, operator_id)
            const assigned_raw = try graph.number(state.syntax.pool, assigned)
