    if not elemental and not iterable and not empty:
        const rejection = try problem(state, span, "E_COLLECTION_METHOD", "unknown method for a " + type_name(state, base.ty) + " receiver; accepted methods: add, clear, copy, difference, discard, intersection, isdisjoint, issubset, issuperset, pop, remove, symmetric_difference, union, update")
