        hint = first.ty
    const last = try expression_expected(mut state, else_raw, hint)
    const first_typed_span = try graph.field(state.batch.pool, state.batch.nodes[first.id], "span")
    const last_typed_span = try graph.field(state.batch.pool, state.batch.nodes[last.id], "span")
    const first_span = try graph.clone(mut state.syntax.pool, state.batch.pool, first_typed_span, 0)
    const last_span = try graph.clone(mut state.syntax.pool, state.batch.pool, last_typed_span, 0)
    if expected >= 0:
        _ = try require(state, first.ty, expected, first_span)
        _ = try require(state, last.ty, expected, last_span)
    elif first.ty != last.ty:
        const rejection = try problem(state, first_span, "E_TYPE", "conditional arms must agree: `" + type_name(state, first.ty) + "` here, `" + type_name(state, last.ty) + "` in the else arm")
        fail rejection
    option_flow.intersect(mut state.control.options, options_then)
    locals_flow.intersect(mut state.scope, init_then)
    const difference = try pending_flow.mismatch(state.scope, then_state)
    _ = try obligations.consistent(state.syntax.pool, state.scope, difference, span, False, mut state.problems)
    try pending_flow.restore(mut state.scope, then_state)
    const active = state.scope.active
    const slot = try locals.add(mut state.scope, b"<conditional>", span, hint, False, b"local")
    state.scope.active = active
    state.scope.locals[slot].usage.reads = 1
    state.scope.locals[slot].usage.temporary = True
    const transfer = try variants.requires_handling(state.syntax.pool, state.batch.facts.lists.types.records.rows, hint)
    state.scope.locals[slot].usage.transfer_available = transfer
    const then_context = list_lower.Context(input=state.syntax.pool, span=first_span)
    const else_context = list_lower.Context(input=state.syntax.pool, span=last_span)
    const then_assign = try list_lower.store(mut state.batch, then_context, slot, first.id, False)
    const else_assign = try list_lower.store(mut state.batch, else_context, slot, last.id, False)
    const test = try syntax_value.integer(mut state.batch.pool, condition.id)
    const yes = try syntax_value.integer(mut state.batch.pool, then_assign)
    const no = try syntax_value.integer(mut state.batch.pool, else_assign)
    const branch = try syntax_value.object(mut state.batch.pool, ["condition", "then_body", "else_body"], [test, yes, no])
    const branch_id = try emission.statement(mut state.batch, state.syntax.pool, span, False, b"branch", branch)
    const context = list_lower.Context(input=state.syntax.pool, span=span)
    const body = try comprehension_lower.block_statement(mut state.batch, context, [branch_id])
    const read = try list_lower.read(mut state.batch, context, slot, hint)
    const body_id = try syntax_value.integer(mut state.batch.pool, body)
    const read_id = try syntax_value.integer(mut state.batch.pool, read)
    const block = try syntax_value.object(mut state.batch.pool, ["body", "value"], [body_id, read_id])
    const id = try emission.node(mut state.batch, state.syntax.pool, span, hint, b"block_value", block)
    return Expression(id=id, ty=hint)


func constant_target(mut state: State, owner: int, name: int, span: int) -> int fails syntax_value.Problem:
    mut spelling = try graph.spelling(state.syntax.pool, state.syntax.source, name)
    mut tail_start = 0
    for position in range(len(spelling)):
        if spelling[position] == 46:
            tail_start = position + 1
    while tail_start < len(spelling) and (spelling[tail_start] == 32 or spelling[tail_start] == 9 or spelling[tail_start] == 10 or spelling[tail_start] == 13):
        tail_start = tail_start + 1
    spelling = spelling[tail_start:]
    mut possible = False
    for function in state.syntax.functions:
        const policy = try graph.field(state.syntax.pool, function, "policy")
        const constant_id = try graph.field(state.syntax.pool, policy, "constant")
        const constant = try graph.get(state.syntax.pool, constant_id)
        if constant.integer != 0:
            const declaration = try graph.field(state.syntax.pool, function, "name")
            const candidate = try graph.spelling(state.syntax.pool, state.syntax.source, declaration)
            if candidate == spelling:
                possible = True
    if not possible:
        return -1
    const resolution = try names.target(mut state.problems, state.syntax.pool, state.syntax.source, state.syntax.modules, span, owner, name)
    mut index = 0
    for function in state.syntax.functions:
        const declaration = try graph.field(state.syntax.pool, function, "name")
        const candidate = try names.qualified(state.syntax.pool, state.syntax.source, state.syntax.modules, declaration)
        if candidate == resolution.key:
            const policy = try graph.field(state.syntax.pool, function, "policy")
            const flag_id = try graph.field(state.syntax.pool, policy, "constant")
            const flag = try graph.get(state.syntax.pool, flag_id)
            if flag.integer == 0:
                return -1
            if resolution.from >= 0 and resolution.import_index >= 0:
                state.syntax.usage[resolution.from][resolution.import_index] = True
            return index
        index = index + 1
    fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="constant identity has no raw declaration")


public func constant_evaluate(mut state: State, raw: int) -> constant_value.Value fails syntax_value.Problem:
    mut index = -1
    for position in range(len(state.syntax.functions)):
        if state.syntax.functions[position] == raw:
            index = position
            break
    if index < 0:
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="constant has no raw function index")
    const tables = constant_context.Tables(nodes=state.syntax.nodes, statements=state.syntax.statements, functions=state.syntax.functions)
    const types = constant_context.Types(records=state.batch.facts.lists.types.records, floating=state.batch.facts.float_type, string=state.batch.facts.string_type, bytes_type=state.batch.facts.bytes_type, catalog=state.batch.facts.lists, applications=state.batch.facts.applications)
    mut context = constant_context.Context(pool=state.syntax.pool, source=state.syntax.source, tables=tables, modules=state.syntax.modules, types=types, problems=state.problems, usage=state.syntax.usage)
    match constant_eval.evaluate(mut context, index):
        case Ok(value):
            state.problems = context.problems
            state.syntax.usage = context.usage
            return value
        case Err(rejection):
            state.problems = context.problems
            state.syntax.usage = context.usage
            fail rejection


public func constant_emit(mut state: State, value: constant_value.Value, span: int) -> Expression fails syntax_value.Problem:
    const number = constant_value.wire(value.bits)
    if value.ty == state.batch.facts.float_type:
        const context = list_lower.Context(input=state.syntax.pool, span=span)
        const lowered = try numeric_lower.literal(mut state.batch, context, number)
        const id = try list_lower.append(mut state.batch, context, lowered)
        return Expression(id=id, ty=value.ty)
    mut payload = -1
    mut tag = b"integer"
    if value.ty == 1:
        payload = try syntax_value.boolean(mut state.batch.pool, value.bits != 0u64)
        tag = b"boolean"
    elif value.ty == 8 and number < 0:
        payload = try syntax_value.upper_integer(mut state.batch.pool, number)
    else:
        payload = try syntax_value.integer(mut state.batch.pool, number)
    const id = try emission.node(mut state.batch, state.syntax.pool, span, value.ty, tag, payload)
    return Expression(id=id, ty=value.ty)


public func constant_scalar(mut state: State, raw: int, span: int) -> Expression fails syntax_value.Problem:
    const value = try constant_evaluate(mut state, raw)
    return try constant_emit(mut state, value, span)


func constant_read(mut state: State, target: int, span: int) -> Expression fails syntax_value.Problem:
    const ty = try constant_literal(mut state, state.syntax.functions[target])
    if ty != state.batch.facts.string_type and ty != state.batch.facts.bytes_type:
        return try constant_scalar(mut state, state.syntax.functions[target], span)
    const order = try emission.ids(mut state.batch, [])
    const evaluation = try syntax_value.absent(mut state.batch.pool)
    const function = try syntax_value.integer(mut state.batch.pool, target)
    const arguments = try emission.ids(mut state.batch, [])
    const payload = try syntax_value.object(mut state.batch.pool, ["evaluation_order", "evaluation", "function", "arguments"], [order, evaluation, function, arguments])
    const id = try emission.node(mut state.batch, state.syntax.pool, span, ty, b"call", payload)
    return Expression(id=id, ty=ty)


func resource_shapes(mut state: State, span: int) -> resource_lower.Shapes fails syntax_value.Problem:
    const text = state.batch.facts.string_type
    const bytes_type = state.batch.facts.bytes_type
    if text < 0 or bytes_type < 0:
        const rejection = try problem(state, span, "P_BODY_PROFILE", "file operations require the canonical str and bytes builtins")
        fail rejection
    const list = try list_types.intern(mut state.batch.facts.lists, state.syntax.pool, list_types.Recipe(id=0, element=text, span=span), [text, bytes_type])
    return resource_lower.Shapes(text=text, bytes=bytes_type, list=list)


func resource_positional(state: State, call: int) -> bool fails syntax_value.Problem:
    const labels_id = try graph.field(state.syntax.pool, call, "argument_names")
    const labels = try graph.items(state.syntax.pool, labels_id)
    for label in labels:
        const value = try graph.get(state.syntax.pool, label)
        if value.kind != 0:
            const rejection = try problem(state, label, "E_CALL_ARGUMENT", "keyword arguments require a declared function or record constructor")
            fail rejection
    return True


func resource_call(mut state: State, raw_id: int, span: int, call: int, slot: int) -> Expression fails syntax_value.Problem:
