    return Expression(id=id, ty=ty)


func stream_call(mut state: State, span: int, call: int, slot: int) -> Expression fails syntax_value.Problem:
    const name_span = try graph.field(state.syntax.pool, call, "name")
    const name = try graph.spelling(state.syntax.pool, state.syntax.source, name_span)
    if name != b"write" and name != b"print":
        const rejection = try problem(state, span, "P_BODY_PROFILE", "stream method is outside the print and write profile")
        fail rejection
    const arguments_id = try graph.field(state.syntax.pool, call, "arguments")
    const arguments = try graph.items(state.syntax.pool, arguments_id)
    mut split = io_arguments.Arguments(values=[], separator=-1, terminator=-1)
    if name == b"print":
        split = try io_arguments.split(state.syntax.pool, state.syntax.source, call)
    else:
        _ = try io_arguments.positional(state.syntax.pool, call)
        if len(arguments) != 1:
            const rejection = try problem(state, span, "E_ARITY", "stream.write takes one str or bytes argument")
            fail rejection
    mut checked: int[] = []
    for argument in arguments:
        const raw = try graph.number(state.syntax.pool, argument)
        mut value = Expression(id=-1, ty=15)
        if name == b"print" and (raw == split.separator or raw == split.terminator):
            value = try expression_expected(mut state, raw, state.batch.facts.string_type)
        else:
            value = try expression(mut state, raw)
        checked.append(value.id)
    const owner_span = try graph.field(state.syntax.pool, call, "owner")
    state.scope.locals[slot].usage.reads = state.scope.locals[slot].usage.reads + 1
    const local = try syntax_value.integer(mut state.batch.pool, slot)
    const receiver = try emission.node(mut state.batch, state.syntax.pool, owner_span, 18, b"local", local)
    if name == b"write":
        const value = checked[0]
        const ty_id = try graph.field(state.batch.pool, state.batch.nodes[value], "ty")
        const ty = try graph.number(state.batch.pool, ty_id)
        if ty != state.batch.facts.string_type and ty != state.batch.facts.bytes_type and ty != state.batch.facts.lists.types.buffer.id:
            const value_span = try graph.field(state.batch.pool, state.batch.nodes[value], "span")
            const copied_span = try graph.clone(mut state.syntax.pool, state.batch.pool, value_span, 0)
            const rejection = try problem(state, copied_span, "E_TYPE", "stream.write requires str or bytes")
            fail rejection
        const id = try resource_lower.write(mut state.batch, list_lower.Context(input=state.syntax.pool, span=span), receiver, value)
        return Expression(id=id, ty=0)
    mut values: int[] = []
    for raw in split.values:
        const value = state.batch.resolved[raw]
        const ty_id = try graph.field(state.batch.pool, state.batch.nodes[value], "ty")
        const ty = try graph.number(state.batch.pool, ty_id)
        const renderable = try printable(state, ty)
        if not renderable:
            const value_span = try graph.field(state.batch.pool, state.batch.nodes[value], "span")
            const copied_span = try graph.clone(mut state.syntax.pool, state.batch.pool, value_span, 0)
            const rejection = try problem(state, copied_span, "E_IO_ARGUMENT", "print cannot render this value; capabilities, files, owned resources and callbacks have no Python spelling")
            fail rejection
        const scalar = scalars.is_integer(ty) or ty == 1 or ty == 15 or (state.batch.facts.float_type >= 0 and ty == state.batch.facts.float_type)
        if not scalar and ty != state.batch.facts.string_type and ty != state.batch.facts.bytes_type and ty != state.batch.facts.lists.types.buffer.id:
            const value_span = try graph.field(state.batch.pool, state.batch.nodes[value], "span")
            const copied_span = try graph.clone(mut state.syntax.pool, state.batch.pool, value_span, 0)
            const rejection = try problem(state, copied_span, "P_BODY_PROFILE", "aggregate output is outside the closed Stream print profile")
            fail rejection
        values.append(value)
    mut separator = -1
    mut terminator = -1
    for raw in [split.separator, split.terminator]:
        if raw >= 0:
            const value = state.batch.resolved[raw]
            const ty_id = try graph.field(state.batch.pool, state.batch.nodes[value], "ty")
            const ty = try graph.number(state.batch.pool, ty_id)
            const value_span = try graph.field(state.batch.pool, state.batch.nodes[value], "span")
            const copied_span = try graph.clone(mut state.syntax.pool, state.batch.pool, value_span, 0)
            _ = try require(state, ty, state.batch.facts.string_type, copied_span)
            if raw == split.separator:
                separator = value
            if raw == split.terminator:
                terminator = value
    const id = try resource_lower.print(mut state.batch, list_lower.Context(input=state.syntax.pool, span=span), resource_lower.Print(arguments=values, separator=separator, terminator=terminator, stream=receiver))
    return Expression(id=id, ty=15)


func printable(state: State, ty: int) -> bool fails syntax_value.Problem:
    if ty == 0 or ty == 1 or (ty >= 2 and ty <= 8) or ty == 15:
        return True
    if ty == state.batch.facts.string_type or ty == state.batch.facts.bytes_type or ty == state.batch.facts.lists.types.buffer.id or list_types.element_type(state.batch.facts.lists, ty) >= 0:
        return True
    const rows = state.batch.facts.lists.types.records.rows
    if ty < 19 or ty - 19 >= len(rows):
        return False
    const row = rows[ty - 19]
    const contract = try graph.field(state.syntax.pool, row, "contract")
    const owned_id = try graph.field(state.syntax.pool, contract, "move_only")
    const owned = try graph.get(state.syntax.pool, owned_id)
    const callback_id = try graph.field(state.syntax.pool, contract, "callback")
    const callback = try graph.get(state.syntax.pool, callback_id)
    return owned.integer == 0 and callback.kind == 0


func same_span(pool: syntax_value.Pool, first: int, second: int) -> bool fails syntax_value.Problem:
    for field in ["start", "end"]:
        const first_id = try graph.field(pool, first, field)
        const second_id = try graph.field(pool, second, field)
        const first_value = try graph.number(pool, first_id)
        const second_value = try graph.number(pool, second_id)
        if first_value != second_value:
            return False
    return True


func option_context(state: State) -> option_flow.Context:
    return option_flow.Context(pool=state.syntax.pool, source=state.syntax.source, nodes=state.syntax.nodes, statements=state.syntax.statements)


func hint_option_operand(mut state: State, raw: int) -> Unit fails syntax_value.Problem:
    const data_id = try graph.field(state.syntax.pool, state.syntax.nodes[raw], "data")
    const data = try graph.get(state.syntax.pool, data_id)
    if data.data != b"name":
        return
    const name = try graph.spelling(state.syntax.pool, state.syntax.source, data.children[0])
    const slot = locals.find(state.scope, name)
    if slot < 0:
        return
    while len(state.batch.facts.expected) < len(state.syntax.nodes):
        state.batch.facts.expected.append(-1)
    state.batch.facts.expected[raw] = state.scope.locals[slot].ty


func option_local(mut state: State, slot: int, span: int) -> Expression fails syntax_value.Problem:
    _ = try require_readable(mut state, slot, span)
    mut ty = state.scope.locals[slot].ty
    const pending = try variants.requires_handling(state.syntax.pool, state.batch.facts.lists.types.records.rows, ty)
    if pending:
        _ = try obligations.consume(state.syntax.pool, mut state.scope, slot, span, False, mut state.problems)
    state.scope.locals[slot].usage.reads += 1
    const value = try syntax_value.integer(mut state.batch.pool, slot)
    mut id = try emission.node(mut state.batch, state.syntax.pool, span, ty, b"local", value)
    if option_flow.has(state.control.options, slot):
        const shape = try variants.option_shape(state.syntax.pool, state.batch.facts.lists.types.records.rows, ty)
        const lowered = try option_lower.payload_value(mut state.batch, mut state.scope, list_lower.Context(input=state.syntax.pool, span=span), id, option_lower.Shape(owner_type=ty, element=shape.element, some=shape.some, none=shape.none))
        id = try list_lower.append(mut state.batch, list_lower.Context(input=state.syntax.pool, span=span), lowered)
        ty = shape.element
    return Expression(id=id, ty=ty)


