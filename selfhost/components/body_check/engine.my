public func constant_literal(mut state: State, raw: int) -> int fails syntax_value.Problem:
    const signature = try graph.field(state.syntax.pool, raw, "signature")
    const return_span = try graph.field(state.syntax.pool, signature, "return_type")
    const ty = try type_at(mut state, return_span)
    if ty != state.batch.facts.string_type and ty != state.batch.facts.bytes_type:
        return ty
    const body_id = try graph.field(state.syntax.pool, raw, "body")
    const body = try graph.number(state.syntax.pool, body_id)
    const body_data_id = try graph.field(state.syntax.pool, state.syntax.statements[body], "data")
    const body_data = try graph.get(state.syntax.pool, body_data_id)
    if body_data.data != b"block":
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid constant getter body")
    const children = try graph.items(state.syntax.pool, body_data.children[0])
    if len(children) != 1:
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid constant getter statements")
    const return_statement = try graph.number(state.syntax.pool, children[0])
    const return_data_id = try graph.field(state.syntax.pool, state.syntax.statements[return_statement], "data")
    const return_data = try graph.get(state.syntax.pool, return_data_id)
    if return_data.data != b"ret":
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid constant getter return")
    const initializer = try graph.number(state.syntax.pool, return_data.children[0])
    const data_id = try graph.field(state.syntax.pool, state.syntax.nodes[initializer], "data")
    const data = try graph.get(state.syntax.pool, data_id)
    const span = try graph.field(state.syntax.pool, state.syntax.nodes[initializer], "span")
    if data.data == b"call":
        const call = data.children[0]
        const owner_id = try graph.field(state.syntax.pool, call, "owner")
        const owner = try graph.get(state.syntax.pool, owner_id)
        const name_id = try graph.field(state.syntax.pool, call, "name")
        const name = try graph.spelling(state.syntax.pool, state.syntax.source, name_id)
        if owner.kind == 0 and (name == b"embed_str" or name == b"embed_bytes"):
            const rejection = try problem(state, span, "P_BODY_PROFILE", "embedded constants are outside the literal getter profile")
            fail rejection
    if data.data != b"text" and data.data != b"bytes":
        const rejection = try problem(state, span, "E_CONSTANT_EXPRESSION", "str and bytes constants require a literal or an embed_bytes/embed_str call initializer; other calls, operators, casts and dependencies are excluded")
        fail rejection
    if (ty == state.batch.facts.string_type) != (data.data == b"text"):
        const rejection = try problem(state, span, "E_TYPE", "constant literal type differs from its declared str or bytes type")
        fail rejection
    return ty


func conditional_value(mut state: State, payload: int, span: int, expected: int) -> Expression fails syntax_value.Problem:
