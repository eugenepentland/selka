        if arity == 1:
            plural = ""
        const method_name = try suggestions.text(spelling)
        const rejection = try problem(state, span, "E_ARITY", "`" + type_name(state, base.ty) + "." + method_name + signature + "` takes " + str(arity) + " argument" + plural + ", but this call passes " + str(len(inputs)))
        fail rejection
    mut arguments: int[] = []
    mut types: int[] = []
    for input in inputs:
        const raw_id = try graph.number(state.syntax.pool, input)
        const value = try expression(mut state, raw_id)
        arguments.append(value.id)
        types.append(value.ty)
    if owner >= 0:
        state.scope.locals[owner].usage.reads = state.scope.locals[owner].usage.reads + 1
        if mutates:
            if not state.scope.locals[owner].mutable:
                const rejection = try problem(state, owner_span, "E_IMMUTABLE", "collection update requires a writable binding")
                fail rejection
            state.scope.locals[owner].usage.writes = state.scope.locals[owner].usage.writes + 1
    elif mutates:
        const rejection = try problem(state, span, "P_BODY_PROFILE", "mutation through temporary sequence receivers is outside the body profile")
        fail rejection
    if mutates and base.ty != state.batch.facts.lists.types.buffer.id:
        const rejection = try problem(state, owner_span, "E_COLLECTION_METHOD", "in-place buffer methods require a byte_buffer receiver")
        fail rejection
    for position in range(len(arguments)):
        if spelling == b"append_range" and position == 0:
            if types[position] != state.batch.facts.bytes_type and types[position] != state.batch.facts.lists.types.buffer.id:
                const rejection = try problem(state, owner_span, "E_COLLECTION_METHOD", "append_range requires a bytes or byte_buffer source")
                fail rejection
        elif types[position] != 0 and types[position] != 5 and types[position] != 7 and types[position] != 8:
            const rejection = try problem(state, owner_span, "E_TYPE", "operation requires an integer type")
            fail rejection
    if spelling == b"view" and base.ty != state.batch.facts.bytes_type:
        const rejection = try problem(state, owner_span, "E_COLLECTION_METHOD", "view requires an immutable bytes receiver")
        fail rejection
    const context = list_lower.Context(input=state.syntax.pool, span=span)
    if owner >= 0:
        const id = try list_lower.operation(mut state.batch, context, list_lower.Operation(owner=owner, kind=kind, arguments=arguments, ty=result_type))
        return Expression(id=id, ty=result_type)
    const lowered = try list_lower.access(mut state.batch, mut state.scope, context, list_lower.Access(base=base.id, owner_type=base.ty, kind=kind, arguments=arguments, result_type=result_type, signed_length=False))
    const id = try list_lower.append(mut state.batch, context, lowered)
    return Expression(id=id, ty=result_type)


