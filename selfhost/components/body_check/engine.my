    const op_span = try graph.clone(mut state.batch.pool, state.syntax.pool, span, 0)
    const payload = try syntax_value.object(mut state.batch.pool, ["op", "operand", "op_span"], [op, operand, op_span])
    const id = try emission.node(mut state.batch, state.syntax.pool, span, 1, b"unary", payload)
    return Expression(id=id, ty=1)


func list_value_access(mut state: State, span: int, base: Expression, kind_name: bytes, inputs: int[]) -> Expression fails syntax_value.Problem:
    const mapping = collection_types.schema(state.batch.facts.lists.types.collections, base.ty)
    if mapping.id >= 0 and mapping.kind == 0 and kind_name == b"write":
        if len(inputs) != 2:
            const rejection = try problem(state, span, "P_BODY_TRANSPORT", "dictionary write requires key and value")
            fail rejection
        const key_raw = try graph.number(state.syntax.pool, inputs[0])
        const value_raw = try graph.number(state.syntax.pool, inputs[1])
        const key = try expression_expected(mut state, key_raw, mapping.key)
        const value = try expression_expected(mut state, value_raw, mapping.value)
        _ = try require(state, key.ty, mapping.key, span)
        _ = try require(state, value.ty, mapping.value, span)
        const context = list_lower.Context(input=state.syntax.pool, span=span)
        const lowered = try mapping_lower.access(mut state.batch, mut state.scope, context, list_lower.Access(base=base.id, owner_type=base.ty, kind=b"write", arguments=[key.id, value.id], result_type=15, signed_length=False))
        const id = try list_lower.append(mut state.batch, context, lowered)
        return Expression(id=id, ty=15)
    if mapping.id >= 0 and mapping.kind == 0:
        return try dictionary_value_access(mut state, span, base, kind_name, inputs)
    if mapping.id >= 0 and mapping.kind == 1:
        return try set_value_access(mut state, span, base, kind_name, inputs)
    const element = list_types.element_type(state.batch.facts.lists, base.ty)
    if element < 0 and sequence_type(state, base.ty) and kind_name == b"write":
        const rejection = try problem(state, span, "E_COLLECTION_METHOD", "str and bytes are immutable")
        fail rejection
    if element < 0:
        const rejection = try problem(state, span, "P_BODY_PROFILE", "list operation receiver is outside the admitted list closure")
        fail rejection
    const arity = list_arity(kind_name)
    if arity < 0:
        const rejection = try problem(state, span, "P_BODY_PROFILE", "list method is outside the admitted list closure")
        fail rejection
    if arity != len(inputs):
        const signature = try list_signature(state, base.ty, kind_name)
        mut plural = "s"
        if arity == 1:
            plural = ""
        const rejection = try problem(state, span, "E_ARITY", "`" + signature + "` takes " + str(arity) + " argument" + plural + ", but this call passes " + str(len(inputs)))
        fail rejection
    if kind_name == b"sort" and element != 0 and element != state.batch.facts.string_type and element != state.batch.facts.bytes_type:
        const rejection = try problem(state, span, "E_COLLECTION_METHOD", "sort requires an integer, float, str or bytes element type")
        fail rejection
    mut values: int[] = []
    mut position = 0
    for input in inputs:
        const child_raw = try graph.number(state.syntax.pool, input)
        mut expected = 0
        if kind_name == b"append" or kind_name == b"contains" or kind_name == b"remove" or kind_name == b"index_of" or ((kind_name == b"write" or kind_name == b"insert") and position == 1):
            expected = element
        elif kind_name == b"extend":
            expected = base.ty
        const value = try expression_expected(mut state, child_raw, expected)
        _ = try require(state, value.ty, expected, span)
        values.append(value.id)
        position = position + 1
    mut result_type = 15
    if kind_name == b"read" or kind_name == b"pop" or kind_name == b"pop_at":
        result_type = element
    elif kind_name == b"contains":
        result_type = 1
    elif kind_name == b"length" or kind_name == b"capacity":
        result_type = 8
    elif kind_name == b"copy":
        result_type = base.ty
    elif kind_name == b"index_of":
        result_type = 0
    elif kind_name != b"write" and kind_name != b"append" and kind_name != b"extend" and kind_name != b"insert" and kind_name != b"remove" and kind_name != b"reverse" and kind_name != b"sort" and kind_name != b"clear":
        const rejection = try problem(state, span, "P_BODY_PROFILE", "list operation kind is outside the admitted list closure")
        fail rejection
    const context = list_lower.Context(input=state.syntax.pool, span=span)
    const lowered = try list_lower.access(mut state.batch, mut state.scope, context, list_lower.Access(base=base.id, owner_type=base.ty, kind=kind_name, arguments=values, result_type=result_type, signed_length=False))
    const id = try list_lower.append(mut state.batch, context, lowered)
    return Expression(id=id, ty=result_type)


func require_hash_key(mut state: State, key: int, span: int, set: bool) -> bool fails syntax_value.Problem:
    const context = hash_keys.Context(pool=state.syntax.pool, records=state.batch.facts.lists.types.records.rows, lists=state.batch.facts.lists.elements, text=state.batch.facts.string_type, bytes=state.batch.facts.bytes_type, buffer=state.batch.facts.lists.types.buffer.id)
    const refusal = try hash_keys.refusal(context, key)
    if refusal is None:
        return True
    const found = refusal
    mut role = "a dictionary key"
    mut code = "E_DICT_KEY"
    if set:
        role = "a set element"
        code = "E_SET_ELEMENT"
    mut reason = "a capability, file or resource is not a value"
    if found.reason == "float":
        reason = "a float is not hashable because NaN is not equal to itself; use an integer or str instead"
    elif found.reason == "shared":
        reason = "a list, dict, set, byte_buffer or class value is a shared reference whose contents can change after it is stored; use a record, tuple, str or bytes instead"
    elif found.reason == "callable":
        reason = "a function value has no equality"
    const name = type_name(state, key)
    mut message = "`" + name + "` cannot be " + role + ": " + reason
    if len(found.path) != 0:
        const path = try suggestions.text(found.path)
        message = "`" + name + "` cannot be " + role + ": `" + name + path + "` is `" + type_name(state, found.part) + "`, and " + reason
    const rejection = try problem(state, span, code, message)
    fail rejection


func table_literal(mut state: State, payload: int, span: int, table: array_types.Array) -> Expression fails syntax_value.Problem:
    const entries = try graph.items(state.syntax.pool, payload)
    if len(entries) % 2 != 0:
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="table literal has an odd entry table")
    # Native dictionary queuing retains checked keys before each checked value.
    mut queued = 0
    while queued < len(entries):
        const key_raw = try graph.number(state.syntax.pool, entries[queued])
        const value_raw = try graph.number(state.syntax.pool, entries[queued + 1])
        _ = try expression(mut state, key_raw)
        _ = try expression_expected(mut state, value_raw, table.element)
        queued += 2
    mut initializers: record_construct.Initializer[] = []
    mut position = 0
    while position < len(entries):
        const raw = try graph.number(state.syntax.pool, entries[position])
        const raw_span = try graph.field(state.syntax.pool, state.syntax.nodes[raw], "span")
        const data_id = try graph.field(state.syntax.pool, state.syntax.nodes[raw], "data")
        const data = try graph.get(state.syntax.pool, data_id)
        const raw_payload = try graph.payload(state.syntax.pool, data_id)
        mut qualifier = -1
        mut name = -1
        if data.data == b"variant":
            qualifier = try graph.field(state.syntax.pool, raw_payload, "ty")
            name = try graph.field(state.syntax.pool, raw_payload, "name")
        elif data.data == b"field":
            const base_id = try graph.field(state.syntax.pool, raw_payload, "base")
            const base = try graph.number(state.syntax.pool, base_id)
            const base_data_id = try graph.field(state.syntax.pool, state.syntax.nodes[base], "data")
            const base_data = try graph.get(state.syntax.pool, base_data_id)
            if base_data.data == b"name":
                qualifier = try graph.payload(state.syntax.pool, base_data_id)
                name = try graph.field(state.syntax.pool, raw_payload, "name")
        if qualifier < 0:
            const rejection = try problem(state, raw_span, "E_TABLE_KEY", "table entry keys name a case of the table's key enum, such as `Kind.first`")
            fail rejection
        const key = try variant_owner(mut state, qualifier, -1)
        if key < 0:
            const rejection = try problem(state, raw_span, "E_TABLE_KEY", "table entry keys name a case of the table's key enum, such as `Kind.first`")
            fail rejection
        if key != table.key:
            const rejection = try problem(state, raw_span, "E_TABLE_KEY", "table entry key names a case of a different enum than the table's key")
            fail rejection
        const value = try graph.number(state.syntax.pool, entries[position + 1])
        initializers.append(record_construct.Initializer(name=name, value=value, default=False))
        position += 2
    const initialized = try record_initializers(mut state, table.id, span, initializers)
    const id = try emission.node(mut state.batch, state.syntax.pool, span, table.id, b"record", initialized)
    return Expression(id=id, ty=table.id)


func dictionary_literal(mut state: State, payload: int, span: int, expected: int) -> Expression fails syntax_value.Problem:
    const table = array_types.schema(state.batch.facts.lists.types.arrays, expected)
    if table.id >= 0 and table.key >= 0:
        return try table_literal(mut state, payload, span, table)
    const inputs = try graph.items(state.syntax.pool, payload)
    if len(inputs) % 2 != 0:
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="dictionary literal has an odd entry table")
    mut schema = collection_types.schema(state.batch.facts.lists.types.collections, expected)
    mut values: Expression[] = []
    mut position = 0
    for input in inputs:
        const raw = try graph.number(state.syntax.pool, input)
        mut hint = -1
        if schema.id >= 0:
            hint = schema.value
            if position % 2 == 0:
                hint = schema.key
        const value = try expression_expected(mut state, raw, hint)
        values.append(value)
        position += 1
    mut ty = expected
    if ty < 0:
        if len(values) == 0:
            const rejection = try problem(state, span, "E_DICT_INFERENCE", "empty dictionary requires a dict key/value annotation")
            fail rejection
        ty = try list_types.collection_intern(mut state.batch.facts.lists, mut state.syntax.pool, collection_types.Schema(id=-1, kind=0, key=values[0].ty, value=values[1].ty, owner=-1), span)
        schema = collection_types.schema(state.batch.facts.lists.types.collections, ty)
    if schema.id < 0 or (schema.kind != 0 and schema.kind != 1):
        const rejection = try problem(state, span, "E_DICT_TYPE", "dictionary literal requires dict key/value types")
        fail rejection
    if schema.kind == 1:
        const rejection = try problem(state, span, "E_DICT_TYPE", "`{}` is an empty dict; write `set()` for an empty set, as Python does")
        fail rejection
    _ = try require_hash_key(mut state, schema.key, span, False)
    mut ids: int[] = []
    for index in range(len(values)):
        const raw = try graph.number(state.syntax.pool, inputs[index])
        const entry_span = try graph.field(state.syntax.pool, state.syntax.nodes[raw], "span")
        mut wanted = schema.value
        if index % 2 == 0:
            wanted = schema.key
        _ = try require(state, values[index].ty, wanted, entry_span)
        ids.append(values[index].id)
    const array = try emission.ids(mut state.batch, ids)
    const id = try emission.node(mut state.batch, state.syntax.pool, span, ty, b"array", array)
    return Expression(id=id, ty=ty)


func require_set_element(mut state: State, element: int, span: int) -> bool fails syntax_value.Problem:
    _ = try require_hash_key(mut state, element, span, True)
    if element < 19:
        return True
    const row = record_types.schema(state.batch.facts.lists.types.records, element)
    if row < 0:
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="set element schema is missing")
    const contract = try graph.field(state.syntax.pool, row, "contract")
    const storage_id = try graph.field(state.syntax.pool, contract, "storable")
    const move_id = try graph.field(state.syntax.pool, contract, "move_only")
    const pending_id = try graph.field(state.syntax.pool, contract, "requires_handling")
    const storage = try graph.get(state.syntax.pool, storage_id)
    const move = try graph.get(state.syntax.pool, move_id)
    const pending = try graph.get(state.syntax.pool, pending_id)
    if storage.kind != 2 or move.kind != 2 or pending.kind != 2:
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid set element storage flags")
    if storage.integer == 0 or move.integer != 0 or pending.integer != 0:
        const rejection = try problem(state, span, "E_SET_ELEMENT", "set elements require copyable storable values without pending results")
        fail rejection
    return True


func empty_set(mut state: State, span: int, expected: int) -> Expression fails syntax_value.Problem:
    if expected < 0:
        const rejection = try problem(state, span, "E_SET_INFERENCE", "`set()` needs an expected set type: annotate the binding, as in `seen: set[int] = set()`")
        fail rejection
    const schema = collection_types.schema(state.batch.facts.lists.types.collections, expected)
    if schema.id < 0 or schema.kind != 1:
        const rejection = try problem(state, span, "E_SET_INFERENCE", "`set()` builds a set, but the context expects another type")
        fail rejection
    _ = try require_set_element(mut state, schema.key, span)
    const values = try emission.ids(mut state.batch, [])
    const id = try emission.node(mut state.batch, state.syntax.pool, span, expected, b"array", values)
    return Expression(id=id, ty=expected)


func set_literal(mut state: State, payload: int, span: int, expected: int) -> Expression fails syntax_value.Problem:
    const inputs = try graph.items(state.syntax.pool, payload)
    if len(inputs) == 0:
        fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="empty set literal is not source syntax")
    const schema = collection_types.schema(state.batch.facts.lists.types.collections, expected)
    mut element = -1
    if schema.kind == 1:
        element = schema.key
    mut values: int[] = []
    for input in inputs:
        const raw = try graph.number(state.syntax.pool, input)
        const value = try expression_expected(mut state, raw, element)
        if element < 0:
            element = value.ty
        else:
            const value_span = try graph.field(state.syntax.pool, state.syntax.nodes[raw], "span")
            _ = try require(state, value.ty, element, value_span)
        values.append(value.id)
    _ = try require_set_element(mut state, element, span)
    mut ty = schema.id
    if schema.kind != 1:
        ty = try list_types.collection_intern(mut state.batch.facts.lists, mut state.syntax.pool, collection_types.Schema(id=-1, kind=1, key=element, value=15, owner=-1), span)
    const context = list_lower.Context(input=state.syntax.pool, span=span)
    const lowered = try set_lower.literal(mut state.batch, mut state.scope, context, set_lower.Literal(ty=ty, values=values))
    const id = try list_lower.append(mut state.batch, context, lowered)
    return Expression(id=id, ty=ty)


func dictionary_signature(state: State, schema: collection_types.Schema, kind: bytes) -> str fails syntax_value.Problem:
    const owner = type_name(state, schema.id)
    const key = type_name(state, schema.key)
    const value = type_name(state, schema.value)
    mut name = kind
    mut body = "() -> None"
    if kind == b"get" or kind == b"pop_default" or kind == b"setdefault":
        body = "(key: " + key + ", default: " + value + ") -> " + value
    elif kind == b"pop_key":
        body = "(key: " + key + ") -> " + value
    elif kind == b"update":
        body = "(other: " + owner + ") -> None"
    elif kind == b"copy":
        body = "() -> " + owner
    elif kind == b"keys":
        body = "() -> list[" + key + "]"
    elif kind == b"values" or kind == b"items":
        body = "() -> list[" + value + "]"
    if kind == b"pop_key" or kind == b"pop_default":
        name = b"pop"
    const spelling = try suggestions.text(name)
    return owner + "." + spelling + body


func dictionary_arity(mut state: State, schema: collection_types.Schema, kind: bytes, span: int, name: int, count: int, arity: int) -> bool fails syntax_value.Problem:
    mut plural = "s"
    if arity == 1:
        plural = ""
    const signature = try dictionary_signature(state, schema, kind)
    const rejection = try problem(state, span, "E_ARITY", "`" + signature + "` takes " + str(arity) + " argument" + plural + ", but this call passes " + str(count))
    if kind == b"get":
        const site = try problem(state, name, "", "")
        const note = syntax_problem.Related(start=site.start, end=site.end, message="a dictionary `get` always takes its fallback: `d.get(key, default)`", role="alternative")
        state.problems.append(syntax_problem.Diagnostic(problem=rejection, severity="err", notes=syntax_problem.Notes(related=[note], origin=[], requirement=[], edits=[])))
    fail rejection


func dictionary_method(mut state: State, call: int, span: int, slot: int) -> Expression fails syntax_value.Problem:
    const owner = try graph.field(state.syntax.pool, call, "owner")
    const name = try graph.field(state.syntax.pool, call, "name")
    _ = try require_readable(mut state, slot, owner)
    const labels_id = try graph.field(state.syntax.pool, call, "argument_names")
    const labels = try graph.items(state.syntax.pool, labels_id)
    for label in labels:
        const value = try graph.get(state.syntax.pool, label)
        if value.kind != 0:
            const rejection = try problem(state, name, "E_CALL_ARGUMENT", "keyword arguments require a declared function or record constructor")
            fail rejection
    const spelling = try graph.spelling(state.syntax.pool, state.syntax.source, name)
    const schema = collection_types.schema(state.batch.facts.lists.types.collections, state.scope.locals[slot].ty)
    const inputs_id = try graph.field(state.syntax.pool, call, "arguments")
    const inputs = try graph.items(state.syntax.pool, inputs_id)
    const types_id = try graph.field(state.syntax.pool, call, "type_arguments")
    const types = try graph.items(state.syntax.pool, types_id)
    mut kind = spelling
    mut arity = 0
    mut vocabulary = True
    mut result_type = 15
    if kind == b"get":
        arity = 2
        vocabulary = False
        result_type = schema.value
    elif kind == b"pop":
        kind = b"pop_key"
        arity = 1
        if len(inputs) == 2:
            kind = b"pop_default"
            arity = 2
        result_type = schema.value
    elif kind == b"setdefault":
        arity = 2
        result_type = schema.value
    elif kind == b"update":
        arity = 1
    elif kind == b"copy":
        result_type = schema.id
    elif kind == b"clear" or kind == b"items":
        pass
    elif kind == b"keys" or kind == b"values":
        vocabulary = False
    else:
        const rejection = try problem(state, name, "E_LIST_METHOD", "unknown method for a " + type_name(state, schema.id) + " receiver; accepted methods: clear, copy, get, items, keys, pop, setdefault, update, values")
        fail rejection
    if not vocabulary and (len(types) != 0 or len(inputs) != arity):
        _ = try dictionary_arity(mut state, schema, kind, span, name, len(inputs), arity)
    mut values: int[] = []
    for position in range(len(inputs)):
        const raw = try graph.number(state.syntax.pool, inputs[position])
        mut expected = -1
        if kind == b"update" and len(inputs) == 1:
            expected = schema.id
        elif position == 0:
            expected = schema.key
        elif position == 1 and len(inputs) == 2:
            expected = schema.value
        const value = try expression_expected(mut state, raw, expected)
        values.append(value.id)
    state.scope.locals[slot].usage.reads += 1
    const mutates = kind == b"clear" or kind == b"update" or kind == b"setdefault" or kind == b"pop_key" or kind == b"pop_default"
    if mutates:
        if not state.scope.locals[slot].mutable:
            const rejection = try problem(state, owner, "E_IMMUTABLE", "collection update requires a writable binding")
            fail rejection
        option_flow.forget(mut state.control.options, slot)
        state.scope.locals[slot].usage.writes += 1
    if len(inputs) != arity:
        _ = try dictionary_arity(mut state, schema, kind, owner, owner, len(inputs), arity)
    if kind == b"keys" or kind == b"values" or kind == b"items":
        mut view_kind = 3
        if kind == b"values":
            view_kind = 4
        elif kind == b"items":
            view_kind = 5
        const view = try list_types.collection_intern(mut state.batch.facts.lists, mut state.syntax.pool, collection_types.Schema(id=-1, kind=view_kind, key=schema.key, value=schema.value, owner=schema.id), span)
        const context = list_lower.Context(input=state.syntax.pool, span=span)
        const receiver = try list_lower.read(mut state.batch, context, slot, schema.id)
        const lowered = try dictionary_view_lower.construct(mut state.batch, context, view, receiver)
        const id = try list_lower.append(mut state.batch, context, lowered)
        return Expression(id=id, ty=view)
    for position in range(len(inputs)):
        const raw = try graph.number(state.syntax.pool, inputs[position])
        const type_id = try graph.field(state.batch.pool, state.batch.nodes[values[position]], "ty")
        const actual = try graph.number(state.batch.pool, type_id)
        mut expected = schema.key
        if kind == b"update":
            expected = schema.id
        elif position == 1:
            expected = schema.value
        mut site = owner
        if kind != b"get":
            site = try graph.field(state.syntax.pool, state.syntax.nodes[raw], "span")
        match require(state, actual, expected, site):
            case Ok(unused):
                pass
            case Err(rejection):
                if kind != b"get":
                    const signature = try dictionary_signature(state, schema, kind)
                    state.problems.append(syntax_problem.alternative(rejection, signature))
                fail rejection
    const id = try list_lower.operation(mut state.batch, list_lower.Context(input=state.syntax.pool, span=span), list_lower.Operation(owner=slot, kind=kind, arguments=values, ty=result_type))
    return Expression(id=id, ty=result_type)


func list_conversion(mut state: State, span: int, value: Expression) -> Expression fails syntax_value.Problem:
    const context = list_lower.Context(input=state.syntax.pool, span=span)
    const schema = collection_types.schema(state.batch.facts.lists.types.collections, value.ty)
    if schema.kind == 0 or schema.kind == 1:
        const ty = try list_types.intern(mut state.batch.facts.lists, state.syntax.pool, list_types.Recipe(id=0, element=schema.key, span=span), [state.batch.facts.string_type, state.batch.facts.bytes_type])
        const lowered = try list_lower.access(mut state.batch, mut state.scope, context, list_lower.Access(base=value.id, owner_type=value.ty, kind=b"keys", arguments=[], result_type=ty, signed_length=False))
        _ = try list_lower.append(mut state.batch, context, lowered)
        const id = try list_lower.append(mut state.batch, context, lowered)
        return Expression(id=id, ty=ty)
    if schema.kind >= 3 and schema.kind <= 5:
        mut element = schema.key
        mut kind = b"keys"
        mut item = -1
        if schema.kind == 4:
            element = schema.value
            kind = b"values"
        elif schema.kind == 5:
            const item_type = try list_types.collection_intern(mut state.batch.facts.lists, mut state.syntax.pool, collection_types.Schema(id=-1, kind=2, key=schema.key, value=schema.value, owner=-1), span)
            item = item_type
            element = item_type
            kind = b"items"
        const ty = try list_types.intern(mut state.batch.facts.lists, state.syntax.pool, list_types.Recipe(id=0, element=element, span=span), [state.batch.facts.string_type, state.batch.facts.bytes_type])
        const snapshot = try dictionary_view_lower.snapshot(mut state.batch, mut state.scope, context, dictionary_view_lower.Request(view=value.id, shape=dictionary_view_lower.Shape(mapping=schema.owner, key=schema.key, value=schema.value, item=item, list=ty, kind=kind), loop_id=state.control.next))
        state.control.next = snapshot.next_loop
        if schema.kind != 5:
            _ = try list_lower.append(mut state.batch, context, snapshot.value)
        const id = try list_lower.append(mut state.batch, context, snapshot.value)
        return Expression(id=id, ty=ty)
    const element = list_types.element_type(state.batch.facts.lists, value.ty)
    if element >= 0:
        const loop_id = state.control.next
        state.control.next += 1
        const lowered = try list_slice.slice(mut state.batch, mut state.scope, context, list_slice.Slice(base=value.id, owner_type=value.ty, element=element, start=-1, end=-1, loop_id=loop_id))
        const id = try list_lower.append(mut state.batch, context, lowered)
        return Expression(id=id, ty=value.ty)
    const rejection = try problem(state, span, "E_PRELUDE_TYPE", "list requires a list, range, reversed source or dictionary view")
    fail rejection


func prelude_iteration_payload(mut state: State, each: int, span: int) -> int fails syntax_value.Problem:
    const iterable_id = try graph.field(state.syntax.pool, each, "iterable")
    const raw = try graph.number(state.syntax.pool, iterable_id)
    const data_id = try graph.field(state.syntax.pool, state.syntax.nodes[raw], "data")
    const data = try graph.get(state.syntax.pool, data_id)
    if data.data != b"call":
        return -1
    const call = data.children[0]
    const name_span = try graph.field(state.syntax.pool, call, "name")
    const name = try graph.spelling(state.syntax.pool, state.syntax.source, name_span)
    if name != b"reversed" and name != b"zip":
        return -1
    const owner_id = try graph.field(state.syntax.pool, call, "owner")
    const owner = try graph.get(state.syntax.pool, owner_id)
    if owner.kind != 0 or locals.find(state.scope, name) >= 0:
        return -1
    const qualified = try names.qualified(state.syntax.pool, state.syntax.source, state.syntax.modules, name_span)
    for function in state.syntax.functions:
        const declaration = try graph.field(state.syntax.pool, function, "name")
        const candidate = try names.qualified(state.syntax.pool, state.syntax.source, state.syntax.modules, declaration)
        if candidate == qualified:
            return -1
    _ = try io_arguments.positional(state.syntax.pool, call)
    const arguments_id = try graph.field(state.syntax.pool, call, "arguments")
    const arguments = try graph.items(state.syntax.pool, arguments_id)
    const paired = name == b"zip"
    const call_span = try graph.field(state.syntax.pool, state.syntax.nodes[raw], "span")
    if len(arguments) != (if paired then 2 else 1):
        const rejection = try problem(state, call_span, "E_ARITY", "reversed takes one iterable and zip takes two")
        fail rejection
    const binding = try graph.field(state.syntax.pool, each, "name")
    const index_name = try graph.field(state.syntax.pool, each, "index_name")
    const index_value = try graph.get(state.syntax.pool, index_name)
    if paired != (index_value.kind != 0):
        const rejection = try problem(state, span, "E_COLLECTION_METHOD", "zip binds two iteration names and reversed binds one")
        fail rejection
    mut sources: Expression[] = []
    for argument in arguments:
        const argument_raw = try graph.number(state.syntax.pool, argument)
        const argument_data_id = try graph.field(state.syntax.pool, state.syntax.nodes[argument_raw], "data")
        const argument_data = try graph.get(state.syntax.pool, argument_data_id)
        if argument_data.data == b"list_literal":
            const children = try graph.items(state.syntax.pool, argument_data.children[0])
            if len(children) == 0:
                const hinted = try list_types.intern(mut state.batch.facts.lists, state.syntax.pool, list_types.Recipe(id=0, element=0, span=call_span), [state.batch.facts.string_type, state.batch.facts.bytes_type])
                state.batch.facts.expected[argument_raw] = hinted
        const value = try expression(mut state, argument_raw)
        sources.append(value)
    mut visible_names = [binding]
    if paired:
        visible_names = [index_name, binding]
    for visible in visible_names:
        const spelling = try graph.spelling(state.syntax.pool, state.syntax.source, visible)
        const declared = try top_level(state, visible)
        if spelling != b"_" and (locals.find(state.scope, spelling) >= 0 or declared):
            const rejection = try problem(state, visible, "E_SHADOWING", "iteration binding shadows an active declaration")
            fail rejection
    if paired:
        const first = try graph.spelling(state.syntax.pool, state.syntax.source, index_name)
        const second = try graph.spelling(state.syntax.pool, state.syntax.source, binding)
        if first != b"_" and first == second:
            const rejection = try problem(state, binding, "E_SHADOWING", "iteration binding shadows an active declaration")
            fail rejection
    mut plans: list_iteration.Plan[] = []
    const before_active = state.scope.active
    for at in range(len(sources)):
        const value = sources[at]
        mut element = list_types.element_type(state.batch.facts.lists, value.ty)
        if value.ty == state.batch.facts.string_type:
            element = value.ty
        if element < 0 or value.ty == state.batch.facts.bytes_type or value.ty == state.batch.facts.lists.types.buffer.id:
            const rejection = try problem(state, span, "E_PRELUDE_TYPE", "iteration requires a list or str")
            fail rejection
        const loop_id = state.control.next
        state.control.next += 1
        const visible = if paired and at == 0 then index_name else binding
        const plan = try list_iteration.prepare(mut state.batch, mut state.scope, state.syntax.pool, list_iteration.Input(source=state.syntax.source, name=visible, span=span, iterable=value.id, owner_type=value.ty, element=element, loop_id=loop_id))
        if paired and at == 1:
            const first = try graph.spelling(state.syntax.pool, state.syntax.source, index_name)
            const second = try graph.spelling(state.syntax.pool, state.syntax.source, binding)
            if first == b"_" and second == b"_":
                state.scope.locals[plan.binding].name = b"<collection>"
                state.scope.locals[plan.binding].declaration = span
                state.scope.locals[plan.binding].mutable = True
                state.scope.locals[plan.binding].origin = b"local"
                state.scope.locals[plan.binding].flags.initialized = False
                state.scope.active = state.scope.active[:len(state.scope.active) - 1]
        plans.append(plan)
    mut right = plans[0]
    mut limit = plans[0].limit
    if paired:
        right = plans[1]
        limit = try list_lower.temporary(mut state.scope, list_lower.Context(input=state.syntax.pool, span=span), 0)
    state.control.active.append(plans[0].request.loop_id)
    state.control.exited.append(False)
    const body_id = try graph.field(state.syntax.pool, each, "body")
    const body_raw = try graph.number(state.syntax.pool, body_id)
    const before = locals_flow.snapshot(state.scope)
    const pending_before = try pending_flow.snapshot(state.scope, len(state.scope.locals))
    const body = try statement(mut state, body_raw)
    if not body.terminates:
        const difference = try pending_flow.mismatch(state.scope, pending_before)
        _ = try obligations.consistent(state.syntax.pool, state.scope, difference, span, True, mut state.problems)
    try pending_flow.restore(mut state.scope, pending_before)
    const lowered = try prelude_iteration.finish(mut state.batch, mut state.scope, state.syntax.pool, prelude_iteration.Plan(left=plans[0], right=right, limit=limit, paired=paired), list_iteration.Finish(raw_statements=state.syntax.statements, raw_nodes=state.syntax.nodes, body_raw=body_raw, body=body.id))
    locals_flow.restore(mut state.scope, before)
    state.scope.active = before_active
    const last = len(state.control.active) - 1
    state.control.active = state.control.active[:last]
    state.control.exited = state.control.exited[:last]
    return lowered.payload


func sequence_iteration_payload(mut state: State, each: int, span: int, iterable: Expression) -> int fails syntax_value.Problem:
    const name_span = try graph.field(state.syntax.pool, each, "name")
    const index_id = try graph.field(state.syntax.pool, each, "index_name")
    const index_value = try graph.get(state.syntax.pool, index_id)
    const enumerated_id = try graph.field(state.syntax.pool, each, "enumerated")
    const enumerated_value = try graph.get(state.syntax.pool, enumerated_id)
    const enumerated = enumerated_value.integer != 0
    mut second_name = -1
    if index_value.kind != 0:
        second_name = index_id
    const fixed = array_types.schema(state.batch.facts.lists.types.arrays, iterable.ty)
    mut element = list_types.element_type(state.batch.facts.lists, iterable.ty)
    if fixed.id >= 0 and fixed.key < 0:
        element = fixed.element
    elif iterable.ty == state.batch.facts.string_type:
        element = iterable.ty
    elif iterable.ty == state.batch.facts.bytes_type or iterable.ty == state.batch.facts.lists.types.buffer.id:
        element = 0
    if element < 0 or (fixed.id >= 0 and fixed.key >= 0):
        const rejection = try problem(state, span, "E_COLLECTION_METHOD", "iteration requires a collection, fixed array or dictionary view")
        fail rejection
    const unpack = second_name >= 0 and not enumerated
    mut elements: int[] = []
    if unpack:
        const item = collection_types.schema(state.batch.facts.lists.types.collections, element)
        if item.kind == 2:
            elements = [item.key, item.value]
        else:
            const tuple = tuple_types.schema(state.batch.facts.lists.types.tuples, element)
            if tuple.id < 0:
                const rejection = try problem(state, span, "E_ITERATION", "two iteration names require dictionary items, enumerate, zip or a list of two-value tuples")
                fail rejection
            if len(tuple.elements) != 2:
                const message = "a two-name `for` destructures a two-value tuple; this one has " + str(len(tuple.elements)) + " values — bind it with one name and destructure it in the body"
                const rejection = try problem(state, span, "E_TUPLE_ARITY", message)
                fail rejection
            elements = tuple.elements
    mut names_to_check = [name_span]
    if second_name >= 0:
        names_to_check = if enumerated then [name_span, second_name] else [second_name, name_span]
    for binding_span in names_to_check:
        const binding_name = try graph.spelling(state.syntax.pool, state.syntax.source, binding_span)
        const declared = try top_level(state, binding_span)
        if binding_name != b"_" and (locals.find(state.scope, binding_name) >= 0 or declared):
            const rejection = try problem(state, binding_span, "E_SHADOWING", "iteration binding shadows an active declaration")
            fail rejection
    if second_name >= 0:
        const first = try graph.spelling(state.syntax.pool, state.syntax.source, name_span)
        const second = try graph.spelling(state.syntax.pool, state.syntax.source, second_name)
        if second != b"_" and first == second:
            const rejection = try problem(state, second_name, "E_SHADOWING", "iteration names must differ")
            fail rejection
    const body_id = try graph.field(state.syntax.pool, each, "body")
    const body_raw = try graph.number(state.syntax.pool, body_id)
    mut rebound = False
    if enumerated:
        const position_name = try graph.spelling(state.syntax.pool, state.syntax.source, second_name)
        rebound = try loop_assigns.assigns(loop_assigns.Context(pool=state.syntax.pool, source=state.syntax.source, nodes=state.syntax.nodes, statements=state.syntax.statements), body_raw, position_name)
    const loop_id = state.control.next
    state.control.next += 1
    const request = list_iteration.Input(source=state.syntax.source, name=name_span, span=span, iterable=iterable.id, owner_type=iterable.ty, element=element, loop_id=loop_id)
    const plan = try sequence_iteration.prepare(mut state.batch, mut state.scope, state.syntax.pool, sequence_iteration.Input(iteration=request, elements=elements, fixed=fixed, second_name=second_name, position=sequence_iteration.Position(enumerated=enumerated, rebound=rebound)))
    const counters_before = state.control.values.counters
    if enumerated and not rebound:
        state.control.values.counters.append(plan.walk.index)
    state.control.active.append(loop_id)
    state.control.exited.append(False)
    const before = locals_flow.snapshot(state.scope)
    const pending_before = try pending_flow.snapshot(state.scope, len(state.scope.locals))
    const body = try statement(mut state, body_raw)
    state.control.values.counters = counters_before
    if not body.terminates:
        const difference = try pending_flow.mismatch(state.scope, pending_before)
        _ = try obligations.consistent(state.syntax.pool, state.scope, difference, span, True, mut state.problems)
    try pending_flow.restore(mut state.scope, pending_before)
    const lowered = try sequence_iteration.finish(mut state.batch, mut state.scope, state.syntax.pool, plan, list_iteration.Finish(raw_statements=state.syntax.statements, raw_nodes=state.syntax.nodes, body_raw=body_raw, body=body.id))
    locals_flow.restore(mut state.scope, before)
    state.scope.active = plan.walk.before_active
    const last = len(state.control.active) - 1
    state.control.active = state.control.active[:last]
    state.control.exited = state.control.exited[:last]
    return lowered.payload


func dictionary_iteration_payload(mut state: State, each: int, span: int, iterable: Expression, schema: collection_types.Schema) -> int fails syntax_value.Problem:
    const name_span = try graph.field(state.syntax.pool, each, "name")
    const index_id = try graph.field(state.syntax.pool, each, "index_name")
    const index_value = try graph.get(state.syntax.pool, index_id)
    const enumerated_id = try graph.field(state.syntax.pool, each, "enumerated")
    const enumerated_value = try graph.get(state.syntax.pool, enumerated_id)
    const enumerated = enumerated_value.integer != 0
    mut second_name = -1
    if index_value.kind != 0:
        second_name = index_id
    mut element = schema.key
    mut item = -1
    mut kind = b"dict"
    mut mapping = schema.id
    if schema.kind == 1:
        kind = b"set"
    elif schema.kind >= 3:
        mapping = schema.owner
        kind = b"keys"
        if schema.kind == 4:
            kind = b"values"
            element = schema.value
        elif schema.kind == 5:
            kind = b"items"
            const item_type = try list_types.collection_intern(mut state.batch.facts.lists, mut state.syntax.pool, collection_types.Schema(id=-1, kind=2, key=schema.key, value=schema.value, owner=-1), span)
            item = item_type
            element = item_type
    if second_name >= 0 and not enumerated and kind != b"items":
        const rejection = try problem(state, span, "E_ITERATION", "two iteration names require dictionary items, enumerate, zip or a list of two-value tuples")
        fail rejection
    mut names_to_check = [name_span]
    if second_name >= 0:
        names_to_check = if enumerated then [name_span, second_name] else [second_name, name_span]
    for binding_span in names_to_check:
        const binding_name = try graph.spelling(state.syntax.pool, state.syntax.source, binding_span)
        const declared = try top_level(state, binding_span)
        if binding_name != b"_" and (locals.find(state.scope, binding_name) >= 0 or declared):
            const rejection = try problem(state, binding_span, "E_SHADOWING", "iteration binding shadows an active declaration")
            fail rejection
    if second_name >= 0:
        const first = try graph.spelling(state.syntax.pool, state.syntax.source, name_span)
        const second = try graph.spelling(state.syntax.pool, state.syntax.source, second_name)
        if second != b"_" and first == second:
            const rejection = try problem(state, second_name, "E_SHADOWING", "iteration names must differ")
            fail rejection
    const body_id = try graph.field(state.syntax.pool, each, "body")
    const body_raw = try graph.number(state.syntax.pool, body_id)
    mut rebound = False
    if enumerated:
        if second_name < 0:
            fail syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="enumerated iteration requires a position name")
        const position_name = try graph.spelling(state.syntax.pool, state.syntax.source, second_name)
        const assigned = try loop_assigns.assigns(loop_assigns.Context(pool=state.syntax.pool, source=state.syntax.source, nodes=state.syntax.nodes, statements=state.syntax.statements), body_raw, position_name)
        rebound = assigned
    const loop_id = state.control.next
    state.control.next += 1
    const request = list_iteration.Input(source=state.syntax.source, name=name_span, span=span, iterable=iterable.id, owner_type=mapping, element=element, loop_id=loop_id)
    const shape = dictionary_view_lower.Shape(mapping=mapping, key=schema.key, value=schema.value, item=item, list=-1, kind=kind)
    const plan = try dictionary_iteration.prepare(mut state.batch, mut state.scope, state.syntax.pool, dictionary_iteration.Input(iteration=request, shape=shape, kind=kind, second_name=second_name, position=dictionary_iteration.Position(enumerated=enumerated, rebound=rebound)))
    if enumerated and not rebound:
        state.control.values.counters.append(plan.walk.index)
    state.control.active.append(loop_id)
    state.control.exited.append(False)
    const before = locals_flow.snapshot(state.scope)
    const pending_before = try pending_flow.snapshot(state.scope, len(state.scope.locals))
    const body = try statement(mut state, body_raw)
    if not body.terminates:
        const difference = try pending_flow.mismatch(state.scope, pending_before)
        _ = try obligations.consistent(state.syntax.pool, state.scope, difference, span, True, mut state.problems)
    try pending_flow.restore(mut state.scope, pending_before)
    const lowered = try dictionary_iteration.finish(mut state.batch, mut state.scope, state.syntax.pool, plan, list_iteration.Finish(raw_statements=state.syntax.statements, raw_nodes=state.syntax.nodes, body_raw=body_raw, body=body.id))
    locals_flow.restore(mut state.scope, before)
    state.scope.active = plan.walk.before_active
    const last = len(state.control.active) - 1
    state.control.active = state.control.active[:last]
    state.control.exited = state.control.exited[:last]
    return lowered.payload


func set_conversion(mut state: State, span: int, value: Expression) -> Expression fails syntax_value.Problem:
    const schema = collection_types.schema(state.batch.facts.lists.types.collections, value.ty)
    mut element = list_types.element_type(state.batch.facts.lists, value.ty)
    mut owner_type = value.ty
    mut kind = b"list"
    mut item = -1
    if value.ty == state.batch.facts.string_type:
        element = value.ty
        kind = b"text"
    elif value.ty == state.batch.facts.bytes_type or value.ty == state.batch.facts.lists.types.buffer.id:
        element = 0
        kind = b"bytes"
    elif schema.kind == 0 or schema.kind == 1:
        element = schema.key
        kind = if schema.kind == 0 then b"dict" else b"set"
    elif schema.kind >= 3:
        element = schema.key
        owner_type = schema.owner
        kind = b"keys"
        if schema.kind == 4:
            element = schema.value
            kind = b"values"
        elif schema.kind == 5:
            const item_type = try list_types.collection_intern(mut state.batch.facts.lists, mut state.syntax.pool, collection_types.Schema(id=-1, kind=2, key=schema.key, value=schema.value, owner=-1), span)
            item = item_type
            element = item_type
            kind = b"items"
    if element < 0:
        const rejection = try problem(state, span, "E_COLLECTION_METHOD", "set() takes a list, str, bytes, fixed array, dictionary, dictionary view or set")
        fail rejection
    _ = try require_hash_key(mut state, element, span, True)
    const ty = try list_types.collection_intern(mut state.batch.facts.lists, mut state.syntax.pool, collection_types.Schema(id=-1, kind=1, key=element, value=15, owner=-1), span)
    const context = list_lower.Context(input=state.syntax.pool, span=span)
    const shape = dictionary_view_lower.Shape(mapping=owner_type, key=schema.key, value=schema.value, item=item, list=-1, kind=kind)
    const gathered = try collection_gather.set_from(mut state.batch, mut state.scope, context, collection_gather.Input(iterable=value.id, owner_type=owner_type, element=element, output_type=ty, projection=shape, kind=kind, loop_id=state.control.next))
    state.control.next = gathered.next_loop
    const id = try list_lower.append(mut state.batch, context, gathered.value)
    return Expression(id=id, ty=ty)


func set_signature(state: State, ty: int, key: int, method: bytes) -> str fails syntax_value.Problem:
    const owner = type_name(state, ty)
    const name = try suggestions.text(method)
    if method == b"add" or method == b"discard" or method == b"remove":
        return owner + "." + name + "(value: " + type_name(state, key) + ") -> None"
    if method == b"pop":
        return owner + ".pop() -> " + type_name(state, key)
    if method == b"copy":
        return owner + ".copy() -> " + owner
    if method == b"clear":
        return owner + ".clear() -> None"
    mut result = owner
    if method == b"update":
        result = "None"
    elif method == b"issubset" or method == b"issuperset" or method == b"isdisjoint":
        result = "bool"
    return owner + "." + name + "(other: " + owner + ") -> " + result


func set_arity(mut state: State, span: int, ty: int, key: int, method: bytes, actual: int, expected: int) -> bool fails syntax_value.Problem:
    if actual == expected:
        return True
    const signature = try set_signature(state, ty, key, method)
    const plural = if expected == 1 then "" else "s"
    const rejection = try problem(state, span, "E_ARITY", "`" + signature + "` takes " + str(expected) + " argument" + plural + ", but this call passes " + str(actual))
    fail rejection


func set_method(mut state: State, call: int, span: int, slot: int) -> Expression fails syntax_value.Problem:
    const name_span = try graph.field(state.syntax.pool, call, "name")
    const owner_span = try graph.field(state.syntax.pool, call, "owner")
    _ = try require_readable(mut state, slot, owner_span)
    _ = try io_arguments.positional(state.syntax.pool, call)
    const method = try graph.spelling(state.syntax.pool, state.syntax.source, name_span)
    const arguments_id = try graph.field(state.syntax.pool, call, "arguments")
    const inputs = try graph.items(state.syntax.pool, arguments_id)
    const types_id = try graph.field(state.syntax.pool, call, "type_arguments")
    const types = try graph.items(state.syntax.pool, types_id)
    const ty = state.scope.locals[slot].ty
    const schema = collection_types.schema(state.batch.facts.lists.types.collections, ty)
    const elemental = method == b"add" or method == b"discard" or method == b"remove"
    const combined = method == b"union" or method == b"intersection" or method == b"difference" or method == b"symmetric_difference"
    const relation = method == b"issubset" or method == b"issuperset" or method == b"isdisjoint"
    const iterable = combined or relation or method == b"update"
    const empty = method == b"pop" or method == b"copy" or method == b"clear"
    if not elemental and not iterable and not empty:
        const rejection = try problem(state, name_span, "E_LIST_METHOD", "unknown method for a " + type_name(state, ty) + " receiver; accepted methods: add, clear, copy, difference, discard, intersection, isdisjoint, issubset, issuperset, pop, remove, symmetric_difference, union, update")
        fail rejection
    const arity = if empty then 0 else 1
    const vocabulary = method == b"remove" or method == b"pop" or method == b"copy" or method == b"clear" or method == b"update"
    if not vocabulary:
        if len(types) != 0 or len(inputs) != arity:
            if len(inputs) == arity:
                const signature = try set_signature(state, ty, schema.key, method)
                const rejection = try problem(state, span, "E_ARITY", "`" + signature + "` takes " + str(arity) + " argument, but this call passes " + str(len(inputs)))
                fail rejection
            _ = try set_arity(mut state, span, ty, schema.key, method, len(inputs), arity)
    mut values: Expression[] = []
    for input in inputs:
        const raw = try graph.number(state.syntax.pool, input)
        mut hint = schema.key
        if iterable:
            hint = ty
            const data_id = try graph.field(state.syntax.pool, state.syntax.nodes[raw], "data")
            const data = try graph.get(state.syntax.pool, data_id)
            mut list_hint = data.data == b"list_literal"
            if data.data == b"comprehension":
                const payload = try graph.payload(state.syntax.pool, data_id)
                const set_id = try graph.field(state.syntax.pool, payload, "set")
                const is_set = try graph.get(state.syntax.pool, set_id)
                list_hint = is_set.integer == 0
            elif data.data == b"dictionary_literal":
                hint = -1
            if list_hint:
                const input_span = try graph.field(state.syntax.pool, state.syntax.nodes[raw], "span")
                const list_type = try list_types.intern(mut state.batch.facts.lists, state.syntax.pool, list_types.Recipe(id=0, element=schema.key, span=input_span), [state.batch.facts.string_type, state.batch.facts.bytes_type])
                hint = list_type
        const checked = try expression_expected(mut state, raw, hint)
        values.append(checked)
    state.scope.locals[slot].usage.reads += 1
    const mutates = elemental or method == b"update" or method == b"pop" or method == b"clear"
    if mutates:
        if not state.scope.locals[slot].mutable:
            const rejection = try problem(state, owner_span, "E_IMMUTABLE", "collection update requires a writable binding")
            fail rejection
        option_flow.forget(mut state.control.options, slot)
        state.scope.locals[slot].usage.writes += 1
    const context = list_lower.Context(input=state.syntax.pool, span=span)
    const base = try list_lower.read(mut state.batch, context, slot, ty)
    _ = try set_arity(mut state, span, ty, schema.key, method, len(inputs), arity)
    return try set_checked(mut state, span, schema, base, method, values)


func set_checked(mut state: State, span: int, schema: collection_types.Schema, base: int, method: bytes, values: Expression[]) -> Expression fails syntax_value.Problem:
    const ty = schema.id
    const combined = method == b"union" or method == b"intersection" or method == b"difference" or method == b"symmetric_difference"
    const relation = method == b"issubset" or method == b"issuperset" or method == b"isdisjoint"
