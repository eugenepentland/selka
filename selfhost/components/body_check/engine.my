    const path_type = try graph.number(state.batch.pool, path_type_id)
    const path_span = try graph.field(state.batch.pool, state.batch.nodes[checked[1]], "span")
    const copied_path_span = try graph.clone(mut state.syntax.pool, state.batch.pool, path_span, 0)
    _ = try require(state, path_type, shapes.text, copied_path_span)
    const mode_position = len(arguments) - 1
    const mode_raw = try graph.number(state.syntax.pool, arguments[mode_position])
    const mode_node = state.syntax.nodes[mode_raw]
    const mode_span = try graph.field(state.syntax.pool, mode_node, "span")
    const mode_data_id = try graph.field(state.syntax.pool, mode_node, "data")
    const mode_data = try graph.get(state.syntax.pool, mode_data_id)
    if mode_data.data != b"text":
        const rejection = try problem(state, mode_span, "E_FILE_ARGUMENT", "open requires a literal mode such as \"rb\", \"r\", \"wb\", \"w\", \"ab\" or \"a\"")
        fail rejection
    const mode_value_id = try graph.payload(state.syntax.pool, mode_data_id)
    const mode_value = try graph.get(state.syntax.pool, mode_value_id)
    const mode = mode_value.data
    if len(mode) < 1 or len(mode) > 2 or (mode[0] != 114 and mode[0] != 119 and mode[0] != 97) or (len(mode) == 2 and mode[1] != 98 and mode[1] != 116):
