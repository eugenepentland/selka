public record Value:
    ty: int
    bits: u64


public func integer(ty: int) -> bool:
    return ty == 0 or (ty >= 2 and ty <= 8)


public func signed(ty: int) -> bool:
    return ty == 0 or (ty >= 2 and ty <= 4)


public func width(ty: int) -> int:
    if ty == 0 or ty == 8:
        return 64
    return [8, 16, 32, 8, 16, 32][ty - 2]


public func mask(ty: int) -> u64:
    const count = width(ty)
    if count == 64:
        return 18446744073709551615u64
    return shift_left(1u64, u64(count)) - 1u64


public func sign_bit(ty: int) -> u64:
    return shift_left(1u64, u64(width(ty) - 1))


public func pack(value: int) -> u64:
    if value >= 0:
        return u64(value)
    return u64(value - (-9223372036854775807 - 1)) + 9223372036854775808u64


public func wire(bits: u64) -> int:
    if bits < 9223372036854775808u64:
        return int(bits)
    return int(bits - 9223372036854775808u64) + (-9223372036854775807 - 1)


public func normalize(ty: int, bits: u64) -> Value:
    mut retained = bit_and(bits, mask(ty))
    if signed(ty) and bit_and(retained, sign_bit(ty)) != 0u64:
        retained = bit_or(retained, bit_xor(18446744073709551615u64, mask(ty)))
    return Value(ty=ty, bits=retained)


public func negative(value: Value) -> bool:
    return signed(value.ty) and value.bits >= 9223372036854775808u64


public func magnitude(value: Value) -> u64:
    if negative(value):
        return wrapping_sub(0u64, value.bits)
    return value.bits


public func maximum(ty: int) -> Value:
    if signed(ty):
        return Value(ty=ty, bits=sign_bit(ty) - 1u64)
    return Value(ty=ty, bits=mask(ty))


public func minimum(ty: int) -> Value:
    if signed(ty):
        return normalize(ty, sign_bit(ty))
    return Value(ty=ty, bits=0u64)
