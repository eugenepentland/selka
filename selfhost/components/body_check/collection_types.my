import syntax_value
import graph
import recipe_index
import variants

# Kind IDs are private index keys; recipe tags remain normative wire names.
public record Schema:
    id: int
    kind: int
    key: int
    value: int
    owner: int


public record Catalog:
    bases: int[]
    schemas: Schema[]
    index: recipe_index.Index
    by_type: int[]


public func empty() -> Catalog:
    return Catalog(bases=[-1, -1, -1, -1, -1, -1], schemas=[], index=recipe_index.empty(), by_type=[])


public func label(kind: int) -> bytes:
    if kind == 0:
        return b"dict"
    if kind == 1:
        return b"set"
    if kind == 2:
        return b"DictItem"
    if kind == 3:
        return b"DictKeys"
    if kind == 4:
        return b"DictValues"
    return b"DictItems"


public func tag(kind: int) -> str:
    if kind == 0:
        return "dict"
    if kind == 1:
        return "set"
    if kind == 2:
        return "dict_item"
    if kind == 3:
        return "dict_keys"
    if kind == 4:
        return "dict_values"
    return "dict_items"


func bad() -> syntax_value.Problem:
    return syntax_value.Problem(code="P_BODY_TRANSPORT", start=0, end=0, message="invalid collection catalog authority")


func optional_field(pool: syntax_value.Pool, row: int, name: str) -> int fails syntax_value.Problem:
    const value = try graph.get(pool, row)
    for position in range(len(value.names)):
        if value.names[position] == name:
            return value.children[position]
    return -1


func zero_span(pool: syntax_value.Pool, row: int) -> bool fails syntax_value.Problem:
    const start_id = try graph.field(pool, row, "start")
    const end_id = try graph.field(pool, row, "end")
    const start = try graph.number(pool, start_id)
    const end = try graph.number(pool, end_id)
    return start == 0 and end == 0


public func find(catalog: Catalog, kind: int, key: int, value: int) -> int:
    return recipe_index.lookup(catalog.index, kind + 3, key, if kind == 1 then - 1 else value)


public func schema(catalog: Catalog, ty: int) -> Schema:
    if ty < 0 or ty >= len(catalog.by_type) or catalog.by_type[ty] < 0:
        return Schema(id=-1, kind=-1, key=-1, value=-1, owner=-1)
    return catalog.schemas[catalog.by_type[ty]]


public func add(mut catalog: Catalog, value: Schema) -> bool fails syntax_value.Problem:
    if value.kind < 0 or value.kind > 5 or value.id < 19 or value.id >= 65555 or value.key < 0 or value.value < 0:
        fail bad()
    const inserted = try recipe_index.insert(mut catalog.index, recipe_index.Key(kind=value.kind + 3, first=value.key, second=if value.kind == 1 then - 1 else value.value, id=value.id))
    if not inserted:
        return False
    while len(catalog.by_type) <= value.id:
        catalog.by_type.append(-1)
    if catalog.by_type[value.id] >= 0:
        fail bad()
    catalog.by_type[value.id] = len(catalog.schemas)
    catalog.schemas.append(value)
    return True


public func prepare(pool: syntax_value.Pool, input: int, records: int[]) -> Catalog fails syntax_value.Problem:
    mut result = empty()
    if len(records) > 65536:
        fail bad()
    const templates = try optional_field(pool, input, "templates")
    if templates < 0:
        return result
    const collections = try optional_field(pool, templates, "collections")
    if collections < 0:
        return result
    const names = ["dict", "set", "DictItem", "DictKeys", "DictValues", "DictItems"]
    for kind in range(6):
        const basis_id = try graph.field(pool, collections, names[kind])
        const basis = try graph.get(pool, basis_id)
        if basis.kind != 0:
            const identity_id = try graph.field(pool, basis_id, "id")
            const identity = try graph.number(pool, identity_id)
            const declaration = try graph.field(pool, basis_id, "declaration")
            const synthetic = try zero_span(pool, declaration)
            if identity < 0 or identity >= 65536 or not synthetic:
                fail bad()
            result.bases[kind] = identity
    # First discover independent mappings, sets and item records. Views then
    # resolve their already retained mapping by integer ID, never by a scan.
    for phase in range(2):
        for position in range(len(records)):
            const row = records[position]
            const declaration = try graph.field(pool, row, "declaration")
            const synthetic = try zero_span(pool, declaration)
            if not synthetic:
                continue
            const name_id = try graph.field(pool, row, "name")
            const name = try graph.get(pool, name_id)
            for kind in range(6):
                if result.bases[kind] < 0 or (kind >= 3) != (phase == 1):
                    continue
                const prefix = label(kind) + b"<"
                if len(name.data) < len(prefix) or name.data[0:len(prefix)] != prefix:
                    continue
                mut key = -1
                mut value = -1
                mut owner = -1
                const shape_id = try graph.field(pool, row, "shape")
                if kind < 2:
                    const collection_id = try graph.field(pool, row, "collection")
                    const key_id = try graph.field(pool, collection_id, "key")
                    key = try graph.number(pool, key_id)
                    const buffer_id = try graph.field(pool, shape_id, "buffer")
                    value = try graph.number(pool, buffer_id)
                    const flag_id = try graph.field(pool, collection_id, "set")
                    const flag = try graph.get(pool, flag_id)
                    if flag.kind != 2 or (flag.integer != 0) != (kind == 1) or (kind == 1 and value != 15):
                        fail bad()
                else:
                    const fields_id = try graph.field(pool, row, "fields")
                    const fields = try graph.items(pool, fields_id)
                    if len(fields) != (if kind == 2 then 2 else 1):
                        fail bad()
                    const first_id = try graph.field(pool, fields[0], "ty")
                    const first = try graph.number(pool, first_id)
                    if kind == 2:
                        key = first
                        const second_id = try graph.field(pool, fields[1], "ty")
                        value = try graph.number(pool, second_id)
                    else:
                        owner = first
                        const mapping = schema(result, owner)
                        if mapping.kind != 0:
                            fail bad()
                        key = mapping.key
                        value = mapping.value
                const key_name = try variants.internal_name(pool, records, key)
                mut expected = label(kind) + b"<" + key_name
                if kind != 1:
                    const value_name = try variants.internal_name(pool, records, value)
                    expected += b"," + value_name
                expected += b">"
                if name.kind != 3 or name.data != expected:
                    fail bad()
                _ = try add(mut result, Schema(id=19 + position, kind=kind, key=key, value=value, owner=owner))
    return result
