import graph
import codec
import incremental

# spec-case: SELFHOST-CACHE-PLAN-1
public func test_empty_and_empty_roots() -> bool fails str:
    mut empty = try graph.build([], [], [])
    mut roots = try graph.build([b"a" * 32], [[]], [[]])
    return empty == [] and roots == [[]]


# spec-case: SELFHOST-CACHE-PLAN-1
public func test_all_roots_excluded_duplicates_and_cycles() -> bool fails str:
    mut reached = try graph.build([b"a" * 32, b"b" * 32, b"c" * 32], [[1, 1], [2], [0]], [[0, 2, 0], [1]])
    return reached == [[1], [0, 2]]


# spec-case: SELFHOST-CACHE-PLAN-1
public func test_digest_order_and_distinct_equal_digest_multiplicity() -> bool fails str:
    mut reached = try graph.build([b"z" * 32, b"\xff" * 32, b"a" * 32, b"a" * 32, b"\x80" * 32], [[1, 4, 3, 2, 2], [], [], [], []], [[0], [2], []])
    return reached == [[2, 3, 4, 1], [], []]


# spec-case: SELFHOST-CACHE-PLAN-1
public func test_diamond_and_disconnected() -> bool fails str:
    mut reached = try graph.build([b"a" * 32, b"b" * 32, b"c" * 32, b"d" * 32, b"e" * 32], [[1, 2], [3], [3], [3], []], [[0], [4]])
    return reached == [[1, 2, 3], []]


# spec-case: SELFHOST-CACHE-PLAN-1
public func test_empty_protocol_golden() -> bool fails str:
    mut data = b"SLKCP001\x01\0\0\0\x01\0\0\0\0\0\0\0\x14\0\0\0" + b"\xff" * 40 + b"\0" * 20
    mut request = try codec.decode(data)
    mut reached = try graph.build(request.digests, request.adjacency, request.batches)
    mut reply = try codec.encode(request, reached)
    return reply == b"SLKCP001\x01\0\0\0\x01\0\0\0\x01\0\0\0\x04\0\0\0" + b"\xff" * 40 + b"\0" * 4


# spec-case: SELFHOST-CACHE-PLAN-1
public func test_malformed_and_unsupported_contract_rejected() -> bool:
    mut data = b"SLKCP001\x01\0\0\0\x01\0\0\0\0\0\0\0\x14\0\0\0" + b"\0" * 60
    match codec.decode(data + b"\0"):
        case Ok(value):
            return False
        case Err(message):
            pass
    match codec.decode(data[:83]):
        case Ok(value):
            return False
        case Err(message):
            pass
    match codec.decode(data[:64] + b"\x01" + data[65:]):
        case Ok(value):
            return False
        case Err(message):
            return True


# spec-case: SELFHOST-CACHE-PLAN-1
public func test_bad_ids_and_digests_rejected() -> bool:
    match graph.build([b"a" * 32], [[1]], [[0]]):
        case Ok(value):
            return False
        case Err(message):
            pass
    match graph.build([b"a"], [[]], [[0]]):
        case Ok(value):
            return False
        case Err(message):
            pass
    match graph.build([b"a" * 32], [[]], [[-1]]):
        case Ok(value):
            return False
        case Err(message):
            return True


func input_v2(adjacency: int[][], roots: int[][], changed: int[], candidates: bool[]) -> incremental.Input:
    return incremental.Input(graph=incremental.Graph(digests=[for node in range(len(adjacency)) yield b"a" * 32], adjacency=adjacency, topology=b"t" * 32), roots=roots, candidates=candidates, changed=changed, prior=incremental.Indexes(topology=b"", reverse=[], groups=[]))


# spec-case: SELFHOST-CACHE-PLAN-2
public func test_incremental_cycle_sharing_and_repeated_roots() -> bool fails str:
    mut input = input_v2([[1, 2], [0], [1], []], [[0, 0], [3], [1, 0]], [2], [True, True, True])
    mut result = try incremental.build(input)
    return result.indexes.groups == [0, 0, 0, 3] and result.reused == [False, True, False] and result.batches == [[1, 2], [], [2]] and result.work.affected_nodes == 3


# spec-case: SELFHOST-CACHE-PLAN-2
public func test_incremental_retained_indexes_reuse_without_closure_work() -> bool fails str:
    mut input = input_v2([[1], []], [[0], [1]], [], [False, False])
    mut initial = try incremental.build(input)
    input.prior = initial.indexes
    input.candidates = [True, True]
    mut warm = try incremental.build(input)
    return warm.reused == [True, True] and warm.work.closure_nodes == 0 and warm.work.closure_edges == 0 and warm.work.reused_tests == 2


# spec-case: SELFHOST-CACHE-PLAN-2
public func test_incremental_cycle_splitting_removes_dependencies() -> bool fails str:
    mut input = input_v2([[1], [0, 2], []], [[0], [2]], [1], [True, True])
    mut cycle = try incremental.build(input)
    input.graph.adjacency = [[1], [], []]
    input.graph.topology = b"u" * 32
    mut split = try incremental.build(input)
    return cycle.indexes.groups == [0, 0, 2] and split.indexes.groups == [0, 1, 2] and split.batches == [[1], []] and split.reused == [False, True]


# spec-case: SELFHOST-CACHE-PLAN-2
public func test_incremental_single_root_chain_has_linear_closure_work() -> bool fails str:
    mut adjacency: int[][] = []
    for node in range(255):
        adjacency.append([node + 1])
    adjacency.append([])
    mut result = try incremental.build(input_v2(adjacency, [[0]], [], [False]))
    return len(result.batches[0]) == 255 and result.work.closure_nodes <= 512 and result.work.closure_edges <= 256


# spec-case: SELFHOST-CACHE-PLAN-2
public func test_incremental_malformed_reverse_index_is_refused() -> bool fails str:
    mut input = input_v2([[1], []], [[0]], [], [True])
    input.prior = incremental.Indexes(topology=input.graph.topology, reverse=[[], []], groups=[0, 1])
    match incremental.build(input):
        case Ok(value):
            return False
        case Err(message):
            return True


# spec-case: SELFHOST-CACHE-PLAN-2
public func test_incremental_retained_groups_cannot_merge_unreachable_nodes() -> bool fails str:
    mut input = input_v2([[1, 3], [], [3], []], [[0], [2]], [1], [True, True])
    input.prior = incremental.Indexes(topology=input.graph.topology, reverse=[[], [0], [], [0, 2]], groups=[0, 0, 0, 0])
    mut result = try incremental.build(input)
    return result.indexes.groups == [0, 1, 2, 3] and result.batches == [[1, 3], []] and result.reused == [False, True]


# spec-case: SELFHOST-CACHE-PLAN-2
public func test_incremental_retained_groups_cannot_split_recursive_nodes() -> bool fails str:
    mut input = input_v2([[1], [0, 2], []], [[0], [2]], [1], [True, True])
    input.prior = incremental.Indexes(topology=input.graph.topology, reverse=[[1], [0], [1]], groups=[0, 1, 2])
    mut result = try incremental.build(input)
    return result.indexes.groups == [0, 0, 2] and result.batches == [[1, 2], []] and result.reused == [False, True]
