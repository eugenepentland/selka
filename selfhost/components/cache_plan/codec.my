public record Request:
    identity: bytes
    digests: bytes[]
    adjacency: int[][]
    batches: int[][]


func read_u32(data: bytes, at: int) -> int:
    return data[at] + data[at + 1] * 256 + data[at + 2] * 65536 + data[at + 3] * 16777216


public func decode(data: bytes) -> Request fails str:
    if len(data) < 84 or len(data) > 16777216:
        fail "invalid request frame size"
    if data[:8] != b"SLKCP001":
        fail "invalid component magic"
    if read_u32(data, 8) != 1 or read_u32(data, 12) != 1:
        fail "unsupported component protocol or schema"
    if read_u32(data, 16) != 0:
        fail "invalid request message kind"
    if read_u32(data, 20) != len(data) - 64:
        fail "invalid request payload length"
    if read_u32(data, 64) != 0 or read_u32(data, 68) != 0 or read_u32(data, 72) != 0:
        fail "unsupported computation retention or admission contract"
    mut nodes = read_u32(data, 76)
    mut batch_count = read_u32(data, 80)
    if nodes > 100000 or batch_count > 100000:
        fail "request table count exceeds limit"
    mut at = 84
    mut digests: bytes[] = []
    mut adjacency: int[][] = []
    mut edges = 0
    for node in range(nodes):
        if len(data) - at < 36:
            fail "truncated function table"
        digests.append(data[at:at + 32])
        at += 32
        mut count = read_u32(data, at)
        at += 4
        edges += count
        if edges > 1000000:
            fail "request edge count exceeds limit"
        if count > (len(data) - at) // 4:
            fail "truncated adjacency edges"
        mut targets: int[] = []
        for edge in range(count):
            mut target = read_u32(data, at)
            at += 4
            if target >= nodes:
                fail "invalid callee function index"
            targets.append(target)
        adjacency.append(targets)
    mut batches: int[][] = []
    mut root_total = 0
    for batch in range(batch_count):
        if len(data) - at < 4:
            fail "truncated root table"
        mut count = read_u32(data, at)
        at += 4
        root_total += count
        if root_total > 1000000:
            fail "request root count exceeds limit"
        if count > (len(data) - at) // 4:
            fail "truncated root indices"
        mut roots: int[] = []
        for item in range(count):
            mut root = read_u32(data, at)
            at += 4
            if root >= nodes:
                fail "invalid root function index"
            roots.append(root)
        batches.append(roots)
    if at != len(data):
        fail "trailing request bytes"
    return Request(identity=data[24:64], digests=digests, adjacency=adjacency, batches=batches)


func put_u32(mut buffer: byte_buffer, value: int):
    mut rest = value
    for octet in range(4):
        _ = buffer.append_byte(rest % 256)
        rest = rest // 256


public func encode(request: Request, reached: int[][]) -> bytes fails str:
    mut payload_size = 4
    for row in reached:
        payload_size += 4 + 4 * len(row)
        if payload_size > 67108800:
            fail "response frame exceeds limit"
    mut empty: int[] = []
    mut buffer = byte_buffer(empty)
    _ = buffer.reserve(payload_size + 64)
    _ = buffer.append_range(b"SLKCP001", 0, 8)
    put_u32(mut buffer, 1)
    put_u32(mut buffer, 1)
    put_u32(mut buffer, 1)
    put_u32(mut buffer, payload_size)
    _ = buffer.append_range(request.identity, 0, 40)
    put_u32(mut buffer, len(reached))
    for row in reached:
        put_u32(mut buffer, len(row))
        for node in row:
            put_u32(mut buffer, node)
    return bytes(buffer)
