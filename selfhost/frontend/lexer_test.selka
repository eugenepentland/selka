# Tests of the Selka lexer, written against what `selka dump-tokens` prints for the same bytes
# (selfhost/tests/syntax_parity.py checks the whole corpus; these pin the individual rules).
import byte_builder
import diagnostic_text
import lexer
import strings
import token_kinds
import tokens_json

# The token categories of a source, space separated, or `CODE START-END` when it does not lex.
func kinds_of(src: bytes) -> str:
    match lexer.lex(src):
        case Ok(tokens):
            mut names: str[] = []
            for kind in tokens.kind:
                append(mut names, token_kinds.kind_name(kind))
            return strings.join(names, " ")
        case Err(failure):
            return f"{failure.code} {failure.start}-{failure.end}"


# `kind@start-end` for each token, space separated.
func spans_of(src: bytes) -> str:
    match lexer.lex(src):
        case Ok(tokens):
            mut parts: str[] = []
            for index in range(len(tokens.kind)):
                append(mut parts, f"{token_kinds.kind_name(tokens.kind[index])}@{tokens.start[index]}-{tokens.end[index]}")
            return strings.join(parts, " ")
        case Err(failure):
            return f"{failure.code} {failure.start}-{failure.end}"


func code_of(src: bytes) -> str:
    match lexer.lex(src):
        case Ok(_):
            return "ok"
        case Err(failure):
            return copy(failure.code)


# `levels` nested `if a:` blocks around one statement.
func nested(levels: int) -> bytes:
    mut out = byte_builder.create()
    for level in range(levels):
        _ = byte_builder.append_spaces(mut out, 4 * level)
        byte_builder.append_text(mut out, "if a:\n")
    _ = byte_builder.append_spaces(mut out, 4 * levels)
    byte_builder.append_text(mut out, "b")
    return byte_builder.finish(out)


public func test_empty_source_is_end_of_file() -> bool:
    return kinds_of(b"") == "eof" and spans_of(b"") == "eof@0-0"


public func test_names_keywords_and_a_suite() -> bool:
    return kinds_of(b"func f(x):\n    return x\ny = z") == "kw_def ident lparen ident rparen indent kw_return ident dedent ident equal ident eof"


public func test_token_spans_follow_the_source_and_layout_tokens_are_empty_or_the_colon() -> bool:
    const spans = spans_of(b"func f(x):\n    return x\ny = z")
    return spans == "kw_def@0-4 ident@5-6 lparen@6-7 ident@7-8 rparen@8-9 indent@9-10 kw_return@15-21 ident@22-23 dedent@24-24 ident@24-25 equal@26-27 ident@28-29 eof@29-29"


public func test_both_spellings_of_def_and_the_word_operators() -> bool:
    return kinds_of(b"def a\nclass b\nand or not\nTrue False None") == "kw_def ident kw_class ident and_and or_or bang kw_true kw_false kw_none eof"


public func test_a_name_that_only_starts_like_a_keyword_is_a_name() -> bool:
    return kinds_of(b"define classy android notable Truely if_ _if i6 i64 u8") == "ident ident ident ident ident ident ident ident kw_i64 kw_u8 eof"


public func test_every_punctuation_spelling() -> bool:
    const expected = "plus plus_equal minus minus_equal arrow star star_equal slash slash_equal slash_slash slash_slash_equal percent percent_equal equal eq_eq bang_eq lt le gt ge question at lparen rparen lbracket rbracket lbrace rbrace semicolon colon comma dot ampersand pipe caret eof"
    return kinds_of(b"+ += - -= -> * *= / /= // //= % %= = == != < <= > >= ? @ ( ) [ ] { } ; : , . & | ^") == expected


public func test_adjacent_operators_split_greedily() -> bool:
    return kinds_of(b"a+=b==c//=d->e!=f<=g>=h") == "ident plus_equal ident eq_eq ident slash_slash_equal ident arrow ident bang_eq ident le ident ge ident eof"


public func test_a_colon_ends_a_suite_only_at_the_end_of_a_line() -> bool:
    return kinds_of(b"x: int") == "ident colon ident eof"


public func test_nested_suites_close_with_one_dedent_each() -> bool:
    return kinds_of(b"if a:\n    if b:\n        c\nd") == "kw_if ident indent kw_if ident indent ident dedent dedent ident eof"


public func test_blank_lines_do_not_change_the_layout() -> bool:
    return kinds_of(b"x\n\n   \n\ny") == "ident ident eof" and kinds_of(b"if a:\n    b\n\n    c\nd") == "kw_if ident indent ident ident dedent ident eof"


public func test_lines_inside_brackets_join_the_statement() -> bool:
    return kinds_of(b"f(a,\n  b)\nc") == "ident lparen ident comma ident rparen ident eof" and kinds_of(b"{a: b,\n  c: d}\ne") == "lbrace ident colon ident comma ident colon ident rbrace ident eof"


public func test_carriage_returns_in_the_indentation_are_blank() -> bool:
    return kinds_of(b"if a:\r\n    b\r\nc") == "kw_if ident indent ident dedent ident eof"


public func test_the_suite_still_open_at_the_end_of_the_file_is_closed() -> bool:
    return kinds_of(b"if a:\n    b") == "kw_if ident indent ident dedent eof" and kinds_of(b"if a:\n    if b:\n        c\n") == "kw_if ident indent kw_if ident indent ident dedent dedent eof"


public func test_a_tab_in_the_indentation_is_refused_at_the_token() -> bool:
    return kinds_of(b"if a:\n\tb") == "E_INDENTATION 7-8"


public func test_an_unexpected_indent_is_refused_at_the_token() -> bool:
    return kinds_of(b"a\n    b") == "E_INDENTATION 6-7"


public func test_a_dedent_that_matches_no_enclosing_block_is_refused() -> bool:
    return kinds_of(b"if a:\n    b\n  c") == "E_INDENTATION 14-15"


public func test_a_colon_needs_an_indented_block() -> bool:
    return kinds_of(b"if a:\nb") == "E_INDENTATION 6-7" and kinds_of(b"if a:\n") == "E_INDENTATION 6-6" and kinds_of(b"if a:\n    b\nif c:\n  d\nif e:\n  f\n  g\nif h:") == "E_INDENTATION 41-41"


public func test_indentation_is_limited_to_256_levels() -> bool:
    return code_of(nested(256)) == "ok" and code_of(nested(257)) == "E_NESTING_LIMIT"


public func test_a_character_with_no_token_is_refused_at_that_byte() -> bool:
    return kinds_of(b"x = $") == "E_TOKEN 4-5" and kinds_of(b"a!b") == "E_TOKEN 1-2" and kinds_of(b"a \xc3\xa9") == "E_TOKEN 2-3"


public func test_the_c_logical_operators_are_answered_with_their_words() -> bool:
    return kinds_of(b"a && b") == "E_REMOVED_SPELLING 2-4" and kinds_of(b"a || b") == "E_REMOVED_SPELLING 2-4" and kinds_of(b"a !b") == "E_REMOVED_SPELLING 2-3" and code_of(b"a != b") == "ok"


public func test_the_first_failure_wins() -> bool:
    return kinds_of(b"a $\n    b") == "E_TOKEN 2-3"


# The `tokens-v1` document of a source, or the diagnostic code when it does not lex.
func json_of(path: str, src: bytes) -> bytes:
    match lexer.lex(src):
        case Ok(tokens):
            return tokens_json.render(path, src, tokens)
        case Err(failure):
            return strings.encode(failure.code)


public func test_tokens_json_is_the_document_dump_tokens_writes() -> bool:
    const expected = b'{"version":"tokens-v1","path":"t.selka","count":13,"tokens":[{"kind":"kw_def","start":0,"end":4,"line":1,"column":1},{"kind":"ident","start":5,"end":6,"line":1,"column":6},{"kind":"lparen","start":6,"end":7,"line":1,"column":7},{"kind":"ident","start":7,"end":8,"line":1,"column":8},{"kind":"rparen","start":8,"end":9,"line":1,"column":9},{"kind":"indent","start":9,"end":10,"line":1,"column":10},{"kind":"kw_return","start":15,"end":21,"line":2,"column":5},{"kind":"ident","start":22,"end":23,"line":2,"column":12},{"kind":"dedent","start":24,"end":24,"line":3,"column":1},{"kind":"ident","start":24,"end":25,"line":3,"column":1},{"kind":"equal","start":26,"end":27,"line":3,"column":3},{"kind":"ident","start":28,"end":29,"line":3,"column":5},{"kind":"eof","start":29,"end":29,"line":3,"column":6}]}'
    return json_of("t.selka", b"func f(x):\n    return x\ny = z") == expected


public func test_tokens_json_counts_lines_across_blank_lines_and_ends_after_the_last_newline() -> bool:
    const blank = b'{"version":"tokens-v1","path":"u.selka","count":3,"tokens":[{"kind":"ident","start":0,"end":1,"line":1,"column":1},{"kind":"ident","start":3,"end":4,"line":3,"column":1},{"kind":"eof","start":4,"end":4,"line":3,"column":2}]}'
    const final = b'{"version":"tokens-v1","path":"v.selka","count":2,"tokens":[{"kind":"ident","start":0,"end":1,"line":1,"column":1},{"kind":"eof","start":2,"end":2,"line":2,"column":1}]}'
    return json_of("u.selka", b"a\n\nb") == blank and json_of("v.selka", b"x\n") == final


public func test_tokens_json_escapes_the_path_as_json_text() -> bool:
    const expected = b'{"version":"tokens-v1","path":"we\\"ird\\\\.selka","count":2,"tokens":[{"kind":"ident","start":0,"end":1,"line":1,"column":1},{"kind":"eof","start":2,"end":2,"line":2,"column":1}]}'
    return json_of('we"ird\\.selka', b"x\n") == expected and b'"path":"a\\tb\\u0001.selka"' in json_of("a\tb\x01.selka", b"")


public func test_comments_run_to_the_end_of_the_line_and_never_change_the_layout() -> bool:
    return kinds_of(b"x # note\ny") == "ident ident eof" and kinds_of(b"x # note") == "ident eof" and kinds_of(b"# only a comment") == "eof" and kinds_of(b"# c1\n# c2\nx") == "ident eof" and kinds_of(b"if a:\n    b\n\n    c\n  # note\nd") == "kw_if ident indent ident ident dedent ident eof"


public func test_vertical_tab_and_form_feed_are_whitespace() -> bool:
    return kinds_of(b"a\x0bb\x0cc") == "ident ident ident eof"


public func test_integers_in_every_base_with_underscores_and_a_width_suffix_are_single_tokens() -> bool:
    return spans_of(b"0 12 0xFF 0o17 0b10 1_000 0xFFu8") == "integer@0-1 integer@2-4 integer@5-9 integer@10-14 integer@15-19 integer@20-25 integer@26-32 eof@32-32"


public func test_floats_are_single_tokens_too() -> bool:
    return spans_of(b"1.5 .5 5. 1e10 1.5e-3 1e+5 5.e3 1_000.5 1e1_0") == "integer@0-3 integer@4-6 integer@7-9 integer@10-14 integer@15-21 integer@22-26 integer@27-31 integer@32-39 integer@40-45 eof@45-45"


public func test_a_malformed_number_stays_one_token_for_the_checker_to_name() -> bool:
    return spans_of(b"12abc 0x 0xg 08 1__0 1_ 1e 1e+ 5.name") == "integer@0-5 integer@6-8 integer@9-12 integer@13-15 integer@16-20 integer@21-23 integer@24-26 integer@27-30 integer@31-32 dot@32-33 ident@33-37 eof@37-37"


public func test_a_dot_before_a_digit_is_a_member_dot_right_after_an_operand() -> bool:
    return spans_of(b"x.5 f().5 a[0].5 x .5") == "ident@0-1 dot@1-2 integer@2-3 ident@4-5 lparen@5-6 rparen@6-7 dot@7-8 integer@8-9 ident@10-11 lbracket@11-12 integer@12-13 rbracket@13-14 dot@14-15 integer@15-16 ident@17-18 integer@19-21 eof@21-21"


public func test_the_literals_that_count_as_operands_for_that_dot() -> bool:
    return spans_of(b"True.5 None.5 'a'.5 x.5y") == "kw_true@0-4 dot@4-5 integer@5-6 kw_none@7-11 dot@11-12 integer@12-13 bytes@14-17 dot@17-18 integer@18-19 ident@20-21 dot@21-22 integer@22-24 eof@24-24"


public func test_quoted_literals_are_bytes_tokens_in_either_quote() -> bool:
    return spans_of(b"\"abc\" 'a' \"\" ''") == "bytes@0-5 bytes@6-9 bytes@10-12 bytes@13-15 eof@15-15"


public func test_b_and_f_prefixes_make_bytes_and_format_tokens() -> bool:
    return spans_of(b"b\"x\" b'y' b\"\" f\"{x}\" f'{y}'") == "bytes@0-4 bytes@5-9 bytes@10-13 format@14-20 format@21-27 eof@27-27"


public func test_b_and_f_without_a_quote_are_names() -> bool:
    return spans_of(b'b + f + bb + ff b"x"') == "ident@0-1 plus@2-3 ident@4-5 plus@6-7 ident@8-10 plus@11-12 ident@13-15 bytes@16-20 eof@20-20"


public func test_escapes_do_not_end_a_literal() -> bool:
    return spans_of(b'"a\\"b" "c\\\\" "d\\nz"') == "bytes@0-6 bytes@7-12 bytes@13-19 eof@19-19"


public func test_triple_quoted_literals_span_lines_and_skip_escaped_quotes() -> bool:
    return spans_of(b'"""doc\nstring""" x') == "bytes@0-16 ident@17-18 eof@18-18" and spans_of(b"'''a'b''c''' y") == "bytes@0-12 ident@13-14 eof@14-14" and spans_of(b'"""a\\"""" z') == "bytes@0-9 ident@10-11 eof@11-11"


public func test_a_b_prefixed_triple_quote_is_a_one_quote_literal_followed_by_more() -> bool:
    return spans_of(b'b"""x"""') == "bytes@0-3 bytes@3-6 bytes@6-8 eof@8-8"


# F-19: `f"""` and `f'''` open a triple-quoted format string, one token that may span lines (D-F19-1).
public func test_a_triple_quoted_format_string_is_one_format_token_over_lines() -> bool:
    return spans_of(b'f"""x"""') == "format@0-8 eof@8-8" and spans_of(b"f'''a\nb''' y") == "format@0-10 ident@11-12 eof@12-12" and spans_of(b'f"""""" z') == "format@0-7 ident@8-9 eof@9-9"


public func test_a_triple_quoted_format_string_ends_at_the_first_three_quotes_wherever_its_holes_are() -> bool:
    return spans_of(b'f"""a {x["k"]} b""" c') == "format@0-19 ident@20-21 eof@21-21" and spans_of(b"f\"\"\"a {x} \"q\" 'r' b\"\"\" c") == "format@0-22 ident@23-24 eof@24-24" and spans_of(b'f"""say \\"hi\\"""" c') == "format@0-17 ident@18-19 eof@19-19"


public func test_a_hole_that_holds_the_literals_three_quotes_ends_the_literal_there() -> bool:
    return spans_of(b'f"""{"""x"""}"""') == "format@0-8 ident@8-9 bytes@9-16 eof@16-16"


public func test_a_triple_quoted_format_string_keeps_the_layout_of_the_line_it_ends_on() -> bool:
    return kinds_of(b'x = f"""a\n  b {y}\n"""\nz') == "ident equal format ident eof" and kinds_of(b'if a:\n    x = f"""a\n\nb"""\n    y') == "kw_if ident indent ident equal format ident dedent eof"


# FR24: a token after the closing quotes of a multi-line text is on the line the literal ends on, so it continues the statement.
public func test_a_token_after_the_closing_quotes_of_a_multi_line_text_continues_its_line() -> bool:
    return kinds_of(b'x = """a\nb""" + y\nz') == "ident equal bytes plus ident ident eof" and kinds_of(b'x = f"""a {y}\nb""" + y\nz') == "ident equal format plus ident ident eof" and kinds_of(b"if a:\n    x = '''a\nb''' + y\n    z") == "kw_if ident indent ident equal bytes plus ident ident dedent eof"


public func test_a_colon_or_a_comment_after_the_closing_quotes_of_a_multi_line_text_ends_the_line() -> bool:
    return kinds_of(b'if """a\nb""" == x:\n    y') == "kw_if bytes eq_eq ident indent ident dedent eof" and kinds_of(b'x = """a\nb"""  # note\ny') == "ident equal bytes ident eof" and kinds_of(b'x = """a\nb"""\ny') == "ident equal bytes ident eof"


public func test_a_line_after_a_multi_line_text_that_is_out_of_place_is_still_refused() -> bool:
    return code_of(b'if a:\n    x = """a\nb""" + y\n  z') == "E_INDENTATION"


public func test_an_unterminated_triple_quoted_format_string_is_refused_from_its_quotes_to_the_end() -> bool:
    return kinds_of(b'x = f"""never closed\nmore') == "E_BYTE_LITERAL 5-25" and kinds_of(b'f"""x""') == "E_BYTE_LITERAL 1-7"


public func test_non_ascii_bytes_are_fine_inside_literals_and_comments() -> bool:
    return spans_of(b'"caf\xc3\xa9 \xe2\x82\xac"') == "bytes@0-11 eof@11-11" and spans_of(b"# caf\xc3\xa9\nx") == "ident@8-9 eof@9-9"


public func test_a_literal_that_ends_at_a_newline_or_the_end_is_refused_from_its_quote() -> bool:
    return kinds_of(b'x = "unterminated') == "E_BYTE_LITERAL 4-17" and kinds_of(b'x = "bad\nline"') == "E_BYTE_LITERAL 4-8" and kinds_of(b'"a\rb"') == "E_BYTE_LITERAL 0-2"


public func test_a_trailing_backslash_ends_the_literal_at_the_escaped_byte() -> bool:
    return kinds_of(b'x = "esc\\') == "E_BYTE_LITERAL 4-9" and kinds_of(b'x = "esc\\\ny"') == "E_BYTE_LITERAL 4-9"


public func test_a_prefix_moves_the_refused_span_past_the_prefix() -> bool:
    return kinds_of(b'b"abc') == "E_BYTE_LITERAL 1-5" and kinds_of(b'f"abc') == "E_BYTE_LITERAL 1-5"


public func test_an_unterminated_triple_quote_is_refused_to_the_end_of_the_source() -> bool:
    return kinds_of(b'"""never closed\nmore') == "E_BYTE_LITERAL 0-20" and kinds_of(b'"""x""') == "E_BYTE_LITERAL 0-6"


public func test_the_removed_fat_arrow_is_refused_over_both_bytes() -> bool:
    return kinds_of(b"x => y") == "E_REMOVED_SPELLING 2-4" and kinds_of(b"a=>b") == "E_REMOVED_SPELLING 1-3" and kinds_of(b"a >= b == c") == "ident ge ident eq_eq ident eof"


func rendered(path: str, src: bytes) -> bytes:
    match lexer.lex(src):
        case Ok(_):
            return b""
        case Err(failure):
            return diagnostic_text.render(path, src, failure)


public func test_a_diagnostic_renders_as_the_zig_text_with_the_line_and_a_caret() -> bool:
    return rendered("t.selka", b"x = $") == b"t.selka:1:5: error[E_TOKEN]: unexpected character in source\n  x = $\n      ^\n"


public func test_a_backslash_that_ends_a_line_says_how_an_expression_continues_as_the_zig_lexer_does() -> bool:
    assert rendered("t.selka", b"x = 1 + \\\n    2\n") == b"t.selka:1:9: error[E_TOKEN]: a backslash does not continue a line: an expression continues on the next line only inside parentheses, so write `(a +` ... `b)` and no backslash\n  x = 1 + \\\n          ^\n"
    assert rendered("u.selka", b"x = f(1, \\\n    2)\n") == b"u.selka:1:10: error[E_TOKEN]: a backslash does not continue a line, and inside brackets the line goes on without one: delete it\n  x = f(1, \\\n           ^\n"
    assert rendered("v.selka", b"x = (1 + \\\n") == b"v.selka:1:10: error[E_TOKEN]: a backslash does not continue a line: an expression continues on the next line only inside parentheses, so write `(a +` ... `b)` and no backslash\n  x = (1 + \\\n           ^\n"
    return rendered("w.selka", b"x = 1 \\ 2\n") == b"w.selka:1:7: error[E_TOKEN]: unexpected character in source\n  x = 1 \\ 2\n        ^\n"


public func test_the_caret_padding_keeps_tabs_and_the_line_drops_its_carriage_return() -> bool:
    return rendered("t.selka", b"a\t$\r\nmore\n") == b"t.selka:1:3: error[E_TOKEN]: unexpected character in source\n  a\t$\n   \t^\n"


public func test_a_diagnostic_at_an_empty_line_shows_an_empty_line() -> bool:
    return rendered("t.selka", b"if a:\n") == b"t.selka:2:1: error[E_INDENTATION]: expected an indented block after ':'\n  \n  ^\n"


public func test_a_diagnostic_on_a_later_line_counts_bytes_for_the_column() -> bool:
    return rendered("t.selka", b'x = "caf\xc3\xa9\n') == b't.selka:1:5: error[E_BYTE_LITERAL]: unterminated text: a text closes on its line with the quote that opened it; escape newlines with \\n\n  x = "caf\xc3\xa9\n      ^\n' and rendered("g.selka", b"x\n$") == b"g.selka:2:1: error[E_TOKEN]: unexpected character in source\n  $\n  ^\n"


# F-61 (FR14): the explanation the Zig lexer gives when a text before the unterminated literal ended at a quote inside a
# word, with the note at that quote (the bytes `selka dump-tokens` prints for the same source).
public func test_an_apostrophe_that_ended_a_text_is_named_with_a_note_at_it() -> bool:
    const wanted = b"t.selka:1:23: error[E_BYTE_LITERAL]: this quote opens a text that never closes: the single-quoted text before it ended at the apostrophe in `script's` (the note), so what followed was read as code; write that text in double quotes, or escape the apostrophe as \\'\n  x = 'the script's path'\n                        ^\n  note: t.selka:1:16: the apostrophe that ended the text\n"
    return rendered("t.selka", b"x = 'the script's path'\n") == wanted


public func test_a_double_quote_inside_a_word_is_named_and_a_quote_after_no_word_or_before_a_keyword_is_not() -> bool:
    const double = b't.selka:1:11: error[E_BYTE_LITERAL]: this quote opens a text that never closes: the double-quoted text before it ended at the quote in `a"b` (the note), so what followed was read as code; write that text in single quotes, or escape the quote as \\"\n  x = "a"b c"\n            ^\n  note: t.selka:1:7: the quote that ended the text\n'
    const plain = b"t.selka:1:11: error[E_BYTE_LITERAL]: unterminated text: a text closes on its line with the quote that opened it; escape newlines with \\n\n  x = 'a' + 'b\n            ^\n"
    const keyword = b"t.selka:1:11: error[E_BYTE_LITERAL]: unterminated text: a text closes on its line with the quote that opened it; escape newlines with \\n\n  x = 'a'in 'abc\n            ^\n"
    return rendered("t.selka", b'x = "a"b c"\n') == double and rendered("t.selka", b"x = 'a' + 'b\n") == plain and rendered("t.selka", b"x = 'a'in 'abc\n") == keyword


# F-19: an unterminated triple-quoted format string names the line it opened on, because it runs to the end of the file.
public func test_an_unterminated_triple_quoted_format_string_names_its_line() -> bool:
    const wanted = b't.selka:3:6: error[E_BYTE_LITERAL]: unterminated triple-quoted format string: it opened on line 3 and has no closing three quotes of the same kind\n  x = f"""a\n       ^\n'
    return rendered("t.selka", b'a\nb\nx = f"""a\n{y}') == wanted


public func test_a_triple_quoted_format_string_is_never_a_text_that_ended_inside_a_word() -> bool:
    return kinds_of(b'x = f"""a"b""" c') == "ident equal format ident eof" and kinds_of(b"x = f'''it's'''c") == "ident equal format ident eof"
