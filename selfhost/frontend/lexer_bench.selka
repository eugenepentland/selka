# Selka side of the lexer throughput comparison (bench/selfhost/lexer_throughput.py): the Selka lexer over files
# held in memory, timed per phase with the monotonic clock. The Zig twin is bench/selfhost/lexer_twin.zig.
#
#     lexer_bench LIST ROUNDS
#
# LIST names one source file per line, each of which must lex. All files are read first. Each of ROUNDS+1 rounds
# (round 0 warms up) then times `tokenize` over every file, `lower` over those token tables, and `lex` as a
# whole, and writes one JSON line.
import lexer
import strings
import time

func load(fs: Filesystem, paths: str[]) -> bytes[] fails str:
    mut files: bytes[] = []
    for path in paths:
        const data = try fs.read_file(path)
        append(mut files, own data)
    return files


func total_bytes(files: bytes[]) -> int:
    mut total = 0
    for file in files:
        total += len(file)
    return total


# Tokenize every file; the tables are returned so the next phase can lower them.
func tokenize_all(files: bytes[]) -> lexer.Tokens[] fails lexer.LexFailure:
    mut tables: lexer.Tokens[] = []
    for file in files:
        const tokens = try lexer.tokenize(file)
        append(mut tables, own tokens)
    return tables


func lower_all(files: bytes[], tables: lexer.Tokens[]) -> int fails lexer.LexFailure:
    mut count = 0
    for index in range(len(files)):
        const lowered = try lexer.lower(files[index], tables[index])
        count += len(lowered.kind)
    return count


func lex_all(files: bytes[]) -> int fails lexer.LexFailure:
    mut count = 0
    for file in files:
        const tokens = try lexer.lex(file)
        count += len(tokens.kind)
    return count


func round_line(out: Stream, round: int, files: int, bytes_read: int, tokens: int, tokenize_ns: int, lower_ns: int, lex_ns: int):
    print(out, f'{{"arm":"selka","round":{round},"files":{files},"bytes":{bytes_read},"tokens":{tokens},"tokenize_ns":{tokenize_ns},"lower_ns":{lower_ns},"lex_ns":{lex_ns}}}')


func measure(files: bytes[], clock: Clock, out: Stream, round: int) -> int fails lexer.LexFailure:
    const started = time.monotonic(clock)
    const tables = try tokenize_all(files)
    const tokenized = time.monotonic(clock)
    const tokens = try lower_all(files, tables)
    const lowered = time.monotonic(clock)
    _ = try lex_all(files)
    const lexed = time.monotonic(clock)
    round_line(out, round, len(files), total_bytes(files), tokens, tokenized - started, lowered - tokenized, lexed - lowered)
    return tokens


func main(args: str[], fs: Filesystem, clock: Clock, out: Stream, err: Stream) -> int:
    if len(args) != 2:
        print(err, "usage: lexer_bench LIST ROUNDS")
        return 2
    const rounds = parse_int(args[1])
    if rounds is None:
        print(err, "lexer_bench: ROUNDS is not a number")
        return 2
    match fs.read_text(args[0]):
        case Err(reason):
            print(err, f"lexer_bench: cannot read the list: {reason}")
            return 2
        case Ok(listing):
            match load(fs, strings.lines(listing)):
                case Err(reason):
                    print(err, f"lexer_bench: {reason}")
                    return 2
                case Ok(files):
                    for round in range(rounds + 1):
                        match measure(files, clock, out, round):
                            case Ok(_):
                                flush(out)
                            case Err(failure):
                                print(err, f"lexer_bench: {failure.code} at {failure.start}")
                                return 1
                    return 0
