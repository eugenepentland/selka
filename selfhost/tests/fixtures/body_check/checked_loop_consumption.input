enum Failure:
    bad
    empty

func parse(value: int) -> int fails Failure:
    if value < 0:
        fail Failure.bad
    if value == 0:
        fail Failure.empty
    return value

func main() -> int:
    mut total = 0
    for value in [3, 4]:
        const result = parse(value)
        match result:
            case Ok(number):
                total += number
            case Err(_):
                return 0
    return total
