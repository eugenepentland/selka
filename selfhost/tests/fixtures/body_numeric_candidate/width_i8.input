func verify(low: i8, high: i8) -> bool:
    if wrapping_add(high, 1i8) != low or wrapping_sub(low, 1i8) != high:
        return False
    if saturating_add(high, 1i8) != high or saturating_sub(low, 1i8) != low:
        return False
    if saturating_mul(high, high) != high:
        return False
    if bit_xor(high, high) != 0i8 or bit_and(7i8, 3i8) != 3i8:
        return False
    return shift_left(1i8, 2i8) == 4i8 and shift_right(4i8, 1i8) == 2i8


func main() -> int:
    assert verify(-128i8, 127i8)
    return 7
