func noted(mut seen: int[], value: int) -> bool:
    seen.append(value)
    return value == 4


func main() -> int:
    const source = FixedArray[int, 3]([3, 4, 5])
    const inner = FixedArray[int, 1]([1])
    mut seen: int[] = []
    if any(noted(mut seen, value * factor) for value in source for factor in inner):
        return seen[0] + seen[1]
    return 1
