import literal_constants
func main() -> int:
    const text = literal_constants.TEXT
    const bytes = literal_constants.OCTETS
    mut total = len(text) + len(bytes)
    for value in bytes:
        if value == 0:
            total += 2
    if total == 7 and text == "aé😀" and bytes == b"\x00\xff":
        return 7
    return 0
