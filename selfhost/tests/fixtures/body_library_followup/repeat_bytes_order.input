func sequence(mut trace: int) -> bytes:
    trace = trace * 10 + 1
    return b"\x00\xff"
func count(mut trace: int) -> int:
    trace = trace * 10 + 2
    return 2
func main() -> int:
    mut trace = 0
    const left = sequence(mut trace) * count(mut trace)
    assert trace == 12
    trace = 0
    const right = count(mut trace) * sequence(mut trace)
    assert trace == 21
    assert left == right
    assert len(left) == 4
    return 7
