func loops(values: int[], other: int[]) -> int:
    mut total = 0
    for i in range(1, 9, 2):
        if i == 5:
            continue
        total += i
    for index, value in enumerate(values):
        total += index + value
    for left, right in zip(values, other):
        total += left + right
    while total < 100:
        total += 1
        if total == 99:
            break
    return total
