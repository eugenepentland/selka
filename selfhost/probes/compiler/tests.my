import blocks

public func test_byte_offsets_and_source_snapshot() -> bool:
    mut source = b"a\xc3\xa9\n\xf0\x9f\x98\x80z\n"
    const snapshot = source
    const span = source[4:8]
    source = b"changed"
    return blocks.line_starts(snapshot) == [0, 4, 10] and span == b"\xf0\x9f\x98\x80" and len(snapshot) == 10 and source == b"changed"


public func test_nested_token_node_snapshot() -> bool:
    mut tokens: blocks.Token[] = [blocks.Token(start=0, end=2, kind=1)]
    mut nodes: blocks.Node[] = [blocks.Node(token=0, children=[1, 2])]
    const old_tokens = tokens
    const old_nodes = nodes
    tokens[0].kind = 9
    nodes[0].children[0] = 7
    nodes[0].children.append(3)
    return old_tokens[0].kind == 1 and tokens[0].kind == 9 and old_nodes[0].children == [1, 2] and nodes[0].children == [7, 2, 3]


public func test_names_sort_and_deterministic_queue() -> bool:
    mut names = blocks.Names(keys=[])
    const first = blocks.intern(mut names, b"z")
    const second = blocks.intern(mut names, b"a")
    const repeat = blocks.intern(mut names, b"z")
    mut ordered = names.keys
    blocks.sort_names(mut ordered)
    const walked = blocks.traverse([[2, 1, 2], [3], [3, 0], []], 0)
    return first == 0 and second == 1 and repeat == 0 and names.keys == [b"z", b"a"] and ordered == [b"a", b"z"] and walked == [0, 2, 1, 3]


public func test_diagnostic_fragments_locations() -> bool:
    const fragments = [b"4:8: ", b"E_NAME", b": ", b"\xc3\xa9", b"\n"]
    return blocks.diagnostic(fragments) == b"4:8: E_NAME: \xc3\xa9\n"


public func test_size_16() -> bool:
    return blocks.growing(16)


public func test_size_128() -> bool:
    return blocks.growing(128)


public func test_size_1024() -> bool:
    return blocks.growing(1024)


public func test_size_4096() -> bool:
    return blocks.growing(4096)


public func test_location_utf8_interior_eof_empty() -> bool fails str:
    const source = b"a\xc3\xa9\n\xf0\x9f\x98\x80z\n"
    const interior = try blocks.locate(source, 6)
    const eof = try blocks.locate(source, 10)
    const empty = try blocks.locate(b"", 0)
    return interior.line == 2 and interior.column == 3 and eof.line == 3 and eof.column == 1 and empty.line == 1 and empty.column == 1


public func test_location_invalid_bounds() -> bool:
    match blocks.locate(b"x", -1):
        case Ok(value):
            return False
        case Err(message):
            if message != "source offset out of bounds":
                return False
    match blocks.locate(b"x", 2):
        case Ok(value):
            return False
        case Err(message):
            return message == "source offset out of bounds"


public func test_stable_ties_empty_singleton() -> bool:
    const empty: int[] = []
    return blocks.stable_order([b"b", b"a", b"b", b"a"]) == [1, 3, 0, 2] and blocks.stable_order([]) == empty and blocks.traverse([[]], 0) == [0] and blocks.diagnostic([]) == b"" and blocks.growing(1)
