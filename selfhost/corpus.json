{
  "version": "syntax-corpus-v1",
  "about": "The files a Selka lexer and parser are checked against, byte for byte, by selfhost/tests/syntax_parity.py. A root's glob is relative to its path (the repository root for a relative path). Every file is an oracle input whether it parses or not: `selka dump-syntax` and `selka dump-tokens` describe a refused file as faithfully as an accepted one. `trusted` roots are parsed with the compiler's reserved internal spellings allowed (the embedded standard library); `optional` roots are skipped when absent and when the script runs with --in-tree. `negative` lists files (and globs of files) that must be refused by design: a corpus run fails when the reference accepts one, so a fixture cannot rot into a positive.",
  "roots": [
    {
      "name": "tests",
      "path": "tests",
      "glob": "**/*.selka"
    },
    {
      "name": "test",
      "path": "test",
      "glob": "**/*.selka"
    },
    {
      "name": "stdlib",
      "path": "src/stdlib",
      "glob": "*.selka",
      "trusted": true
    },
    {
      "name": "src-core",
      "path": "src/core",
      "glob": "**/*.selka"
    },
    {
      "name": "selfhost",
      "path": "selfhost",
      "glob": "**/*.selka"
    },
    {
      "name": "bench",
      "path": "bench",
      "glob": "**/*.selka"
    },
    {
      "name": "benchmarks",
      "path": "benchmarks",
      "glob": "**/*.selka"
    },
    {
      "name": "examples",
      "path": "examples",
      "glob": "**/*.selka"
    },
    {
      "name": "selka-projects",
      "path": "/home/epentland/ai/canopy/selka-projects",
      "glob": "**/*.selka",
      "optional": true
    }
  ],
  "exclude": [
    "**/.*/**",
    "**/node_modules/**"
  ],
  "negative": [
    "selfhost/corpus/negative/**/*.selka",
    "test/fixtures/fix-migration/lox/*.selka",
    "test/fixtures/fix-migration/port-defects/*.selka",
    "selfhost/diagnostic.selka",
    "selfhost/lexer.selka",
    "selfhost/prototype/bench.selka",
    "selfhost/prototype/lexer.selka",
    "selfhost/prototype/parser.selka",
    "selfhost/source.selka",
    "selfhost/tests/fixtures/lexer/at_token.selka",
