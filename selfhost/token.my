    if kind == TokenKind.and_and:
        return "and_and"
    if kind == TokenKind.kw_bool:
        return "kw_bool"
    if kind == TokenKind.kw_while:
        return "kw_while"
    if kind == TokenKind.kw_for:
        return "kw_for"
    if kind == TokenKind.kw_in:
        return "kw_in"
    if kind == TokenKind.kw_len:
        return "kw_len"
    if kind == TokenKind.kw_elif:
        return "kw_elif"
    if kind == TokenKind.kw_break:
        return "kw_break"
    if kind == TokenKind.kw_else:
        return "kw_else"
    if kind == TokenKind.kw_continue:
        return "kw_continue"
    if kind == TokenKind.ge:
        return "ge"
    if kind == TokenKind.kw_const:
        return "kw_const"
    if kind == TokenKind.kw_none:
        return "kw_none"
    if kind == TokenKind.minus_equal:
        return "minus_equal"
    if kind == TokenKind.gt:
        return "gt"
    if kind == TokenKind.kw_case:
        return "kw_case"
    if kind == TokenKind.eof:
        return "eof"
    if kind == TokenKind.kw_match:
        return "kw_match"
    if kind == TokenKind.slash_slash:
        return "slash_slash"
    if kind == TokenKind.percent:
        return "percent"
    if kind == TokenKind.question:
        return "question"
    if kind == TokenKind.le:
        return "le"
    if kind == TokenKind.format:
        return "format"
    if kind == TokenKind.at:
        return "at"
    if kind == TokenKind.kw_pass:
        return "kw_pass"
    if kind == TokenKind.kw_assert:
        return "kw_assert"
    if kind == TokenKind.kw_arena:
        return "kw_arena"
