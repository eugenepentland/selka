        return "kw_replace"
    if kind == TokenKind.kw_i64:
        return "kw_i64"
    if kind == TokenKind.kw_i8:
        return "kw_i8"
    if kind == TokenKind.kw_i16:
        return "kw_i16"
    if kind == TokenKind.kw_i32:
