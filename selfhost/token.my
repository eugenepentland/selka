module token

# Stage-0 lexical token categories. Member spellings are exactly the
# `@tagName` strings the Zig oracle emits, so the differential harness can
# compare kinds without a rename table.

public enum TokenKind:
    eof,
    ident,
    integer,
    bytes,
    format,
    at,
    kw_def,
    kw_none,
    kw_pass,
    kw_assert,
    kw_elif,
    kw_case,
    kw_arena,
    kw_with,
    kw_as,
    kw_enum,
    kw_union,
    kw_match,
    kw_domain,
    kw_private,
    kw_wrap,
    kw_todo,
    kw_codec_encode,
    kw_codec_decode,
    kw_unwrap,
    kw_class,
    kw_conversion,
    kw_replace,
    kw_len,
    kw_return,
    kw_true,
    kw_false,
    kw_i64,
    kw_i8,
    kw_i16,
    kw_i32,
    kw_u8,
    kw_u16,
    kw_u32,
    kw_u64,
    kw_filesystem_cap,
    kw_network_cap,
    kw_acquire_resource,
    kw_complete_resource,
    kw_environment_cap,
    kw_environment_get,
    kw_restrict_resource,
    kw_read_resource,
    kw_write_resource,
    kw_clock_cap,
    kw_random_cap,
    kw_clock_now,
    kw_random_u64,
    kw_bit_and,
    kw_bit_or,
    kw_bit_xor,
    kw_shift_left,
    kw_shift_right,
    kw_wrapping_add,
    kw_wrapping_sub,
    kw_wrapping_mul,
    kw_saturating_add,
    kw_saturating_sub,
    kw_saturating_mul,
    kw_f64_add,
    kw_f64_sub,
    kw_f64_mul,
    kw_f64_div,
    kw_f64_eq,
    kw_f64_lt,
    kw_f64_le,
    kw_f64_sqrt,
    kw_f64_floor,
    kw_f64_ceil,
    kw_f64_trunc,
    kw_f64_abs,
    kw_f64_neg,
    kw_f64_from_u64,
    kw_f64_to_u64,
    kw_bool,
    kw_if,
    kw_else,
    kw_while,
    kw_break,
    kw_continue,
    kw_const,
    kw_for,
    kw_in,
    kw_type,
    lparen,
    rparen,
    lbracket,
    rbracket,
    lbrace,
    rbrace,
    indent,
    dedent,
    arrow,
    fat_arrow,
    semicolon,
    colon,
    comma,
    dot,
    plus,
    minus,
    star,
    slash,
    slash_slash,
    percent,
    ampersand,
    and_and,
    or_or,
    plus_equal,
    minus_equal,
    star_equal,
    slash_equal,
    slash_slash_equal,
    percent_equal,
    equal,
    eq_eq,
    bang,
    bang_eq,
    question,
    lt,
    le,
    gt,
    ge


public record Token:
    kind: TokenKind
    start: int
    end: int


# The verbatim stage-0 tag spelling used by the `<kind> <start> <end>` protocol.
public def kind_name(kind: TokenKind) -> str:
    if kind == TokenKind.ident:
        return "ident"
    if kind == TokenKind.dot:
        return "dot"
    if kind == TokenKind.lparen:
        return "lparen"
    if kind == TokenKind.rparen:
        return "rparen"
    if kind == TokenKind.comma:
        return "comma"
    if kind == TokenKind.equal:
        return "equal"
    if kind == TokenKind.indent:
        return "indent"
    if kind == TokenKind.dedent:
        return "dedent"
    if kind == TokenKind.integer:
        return "integer"
    if kind == TokenKind.bytes:
        return "bytes"
    if kind == TokenKind.lbracket:
        return "lbracket"
    if kind == TokenKind.rbracket:
        return "rbracket"
    if kind == TokenKind.kw_if:
        return "kw_if"
    if kind == TokenKind.kw_return:
        return "kw_return"
    if kind == TokenKind.plus:
        return "plus"
    if kind == TokenKind.eq_eq:
        return "eq_eq"
    if kind == TokenKind.colon:
        return "colon"
    if kind == TokenKind.minus:
        return "minus"
    if kind == TokenKind.kw_def:
        return "kw_def"
    if kind == TokenKind.arrow:
        return "arrow"
    if kind == TokenKind.plus_equal:
        return "plus_equal"
    if kind == TokenKind.or_or:
        return "or_or"
    if kind == TokenKind.kw_true:
        return "kw_true"
    if kind == TokenKind.kw_false:
        return "kw_false"
    if kind == TokenKind.lt:
        return "lt"
    if kind == TokenKind.bang:
        return "bang"
