{
  "language_version": "0.1.0",
  "primary_backend": "vm",
  "native_backend": "partial-c",
  "implemented": [
    "fixed-width-integers",
    "std_math-binary64-domain",
    "named-integer-bitwise-shifts",
    "wrapping-saturating-integers",
    "booleans",
    "byte-literals",
    "nominal-records",
    "tagged-unions",
    "checked-results",
    "generic-functions",
    "generic-nominals",
    "structural-contracts",
    "buffers",
    "pools",
    "lexical-borrows",
    "input-origin-reference-returns",
    "arenas",
    "capability-effects",
    "disk-modules",
    "typed-json",
    "plain-json",
    "std_text",
    "std_json",
    "source-navigation",
    "syntax-cache",
    "exact-verdict-cache",
    "generic-buffers",
    "generic-pools",
    "independent-function-diagnostics",
    "copied-block-byte-io",
    "configurable-byte-io-budgets",
    "standard-unit",
    "scalar-module-constants",
    "structured-loop-exits",
    "integer-range-iteration",
    "value-producing-matches",
    "transparent-type-aliases"
  ],
  "unsupported": [
    "floats",
    "function-values",
    "stored-reference-fields",
    "guest-threads",
    "general-comptime",
    "disjoint-split-borrows"
  ],
  "native_exclusions": [
    "host-declarations",
    "source-json"
  ],
  "limits": {
    "borrow_conflicts": "whole-allocation",
    "generic_calls": "explicit-type-arguments",
    "container_elements": "copyable-no-owned-or-must-handle",
    "noalloc": "guest-backing-operations-only",
    "type_aliases": "non-parameterized",
    "constants": "scalar-expressions-with-acyclic-dependencies",
    "iteration": "ascending-half-open-integer-ranges"
  }
}
