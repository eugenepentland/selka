{
  "language_version": "0.1.0",
  "primary_backend": "vm",
  "native_backend": "partial-c",
  "implemented": [
    "fixed-width-integers",
    "booleans",
    "byte-literals",
    "nominal-records",
    "tagged-unions",
    "checked-results",
    "generic-functions",
    "generic-nominals",
    "structural-contracts",
    "buffers",
    "pools",
    "lexical-borrows",
    "input-origin-reference-returns",
    "arenas",
    "capability-effects",
    "disk-modules",
    "typed-json",
    "plain-json",
    "std_text",
    "std_json",
    "source-navigation",
    "syntax-cache",
    "exact-verdict-cache"
  ],
  "unsupported": [
    "floats",
    "function-values",
    "stored-reference-fields",
    "guest-threads",
    "general-comptime",
    "generic-buffers",
    "disjoint-split-borrows"
  ],
  "native_exclusions": [
    "host-declarations",
    "source-json"
  ],
  "limits": {
    "borrow_conflicts": "whole-allocation",
    "generic_calls": "explicit-type-arguments",
    "container_elements": "copyable-no-owned-or-must-handle",
    "noalloc": "guest-backing-operations-only"
  }
}
