  "unsupported": [
    "builtin-f64-syntax",
    "stored-reference-fields",
    "guest-shared-memory-threads",
    "unrestricted-comptime",
    "capturing-closures"
  ],
  "native_exclusions": [],
  "limits": {
    "borrow_conflicts": "whole-allocation-except-explicit-checked-split",
    "generic_calls": "explicit-type-arguments",
    "container_elements": "buffers: storable copy/owned values without must-handle or external resource owners; pools: copyable elements",
    "noalloc": "guest-backing-operations-only",
    "type_aliases": "non-parameterized",
    "constants": "bounded-scalar-expressions-and-nongeneric-source-functions",
    "iteration": "ascending-half-open-integer-ranges",
    "native_runtime": "JSON support linked through pinned Zig object; host effects require explicit ABI registration",
    "workers": "host-facing copied typed messages; no guest spawn syntax",
    "floating_point": "std_math::F64 nominal domain with named operations and bit codecs",
    "callbacks": "generic signatures, exact effect ceilings, explicit readonly context borrows, no captures or reference results",
    "semantic_reuse": "conservative function-body queries; generics constants aliases and inferred callback schemas check fresh",
    "text_data": "byte offsets and ASCII trim; bounded decimal parser; fixed formatting 0..9 places",
    "hash_collections": "fixed slot capacity; u64 or inline byte keys up to256bytes; copyable values",
    "time_random": "Unix wall clock and explicit entropy capabilities; deterministic noncryptographic SplitMix64",
    "directory_listing": "bounded immutable copied entries; unspecified order; no recursive walk"
  }
}
