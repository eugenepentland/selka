module bounds
import model as m
import units
export valid
export inside
export rectangle


def axis(origin: units.Micrometres, extent: units.Micrometres) -> bool:
    x = units.Micrometres.number(origin)
    width = units.Micrometres.number(extent)
    if x < -1000000000 or x > 1000000000:
        return False
    if width < 1 or width > 1000000000:
        return False
    return x + width <= 1000000000


def valid(rect: m.Rect) -> bool effects():
    return axis(rect.x, rect.width) and axis(rect.y, rect.height)


def inside(outer: m.Rect, inner: m.Rect) -> bool effects():
    x = units.Micrometres.number(inner.x)
    y = units.Micrometres.number(inner.y)
    left = units.Micrometres.number(outer.x)
    bottom = units.Micrometres.number(outer.y)
    return x >= left and y >= bottom and x + units.Micrometres.number(inner.width) <= left + units.Micrometres.number(outer.width) and y + units.Micrometres.number(inner.height) <= bottom + units.Micrometres.number(outer.height)


def rectangle(item: m.Feature) -> m.Rect effects():
    match item:
        case m.Feature.component(value):
            return value.rect
        case m.Feature.track(value):
            return value.rect
        case m.Feature.via(value):
            return value.rect
