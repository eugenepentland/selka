module wire
import io
# One fixed request layout, so every field sits at a position this module names.
# A slot is a presence byte and eight little-endian octets; a rectangle is four
# signed eight-octet fields; a region adds a face, three block flags and four
# admitted-net slots; a feature adds a family byte and one face or layer byte.


public const SLOT: i64 = 9
public const REGION: i64 = 73
public const FEATURE: i64 = 43
public const OUTLINE: i64 = 0
public const COMPONENTS: i64 = 32
public const NETS: i64 = 68
public const REGIONS: i64 = 104
public const FEATURES: i64 = 396
public const REQUEST: i64 = 740


public def unsigned(host: Host, position: i64) -> u64 effects(host):
    value = 0u64
    shift = 0u64
    i = 0i64
    while i < 8:
        value = bit_or(value, shift_left(u64(io.byte(host, position + i)), shift))
        shift = shift + 8u64
        i = i + 1
    return value


public def signed(host: Host, position: i64) -> i64 effects(host):
    value = i64(io.byte(host, position + 7))
    if value >= 128:
        value = value - 256
    i = 6i64
    while i >= 0:
        value = bit_or(shift_left(value, 8), i64(io.byte(host, position + i)))
        i = i - 1
    return value


public def code(host: Host, position: i64) -> u8 effects(host):
    return io.byte(host, position)


public def flag(host: Host, position: i64) -> bool effects(host):
    return io.byte(host, position) != 0u8


public def emitUnsigned(host: Host, value: u64) -> i64 effects(host):
    shift = 0u64
    i = 0i64
    while i < 8:
        _ = io.put(host, u8(bit_and(shift_right(value, shift), 255u64)))
        shift = shift + 8u64
        i = i + 1
    return 0
