module wire
import io
export SLOT
export REGION
export FEATURE
export OUTLINE
export COMPONENTS
export NETS
export REGIONS
export FEATURES
export REQUEST
export unsigned
export signed
export flag
export code
export emitUnsigned
# One fixed request layout, so every field sits at a position this module names.
# A slot is a presence byte and eight little-endian octets; a rectangle is four
# signed eight-octet fields; a region adds a face, three block flags and four
# admitted-net slots; a feature adds a family byte and one face or layer byte.


const SLOT: i64 = 9
const REGION: i64 = 73
const FEATURE: i64 = 43
const OUTLINE: i64 = 0
const COMPONENTS: i64 = 32
const NETS: i64 = 68
const REGIONS: i64 = 104
const FEATURES: i64 = 396
const REQUEST: i64 = 740


def unsigned(host: Host, position: i64) -> u64 effects(host):
    value = 0u64
    shift = 0u64
    i = 0i64
    while i < 8:
        value = bit_or(value, shift_left(u64(io.byte(host, position + i)), shift))
        shift = shift + 8u64
        i = i + 1
    return value


def signed(host: Host, position: i64) -> i64 effects(host):
    value = i64(io.byte(host, position + 7))
    if value >= 128:
        value = value - 256
    i = 6i64
    while i >= 0:
        value = bit_or(shift_left(value, 8), i64(io.byte(host, position + i)))
        i = i - 1
    return value


def code(host: Host, position: i64) -> u8 effects(host):
    return io.byte(host, position)


def flag(host: Host, position: i64) -> bool effects(host):
    return io.byte(host, position) != 0u8


def emitUnsigned(host: Host, value: u64) -> i64 effects(host):
    shift = 0u64
    i = 0i64
    while i < 8:
        _ = io.put(host, u8(bit_and(shift_right(value, shift), 255u64)))
        shift = shift + 8u64
        i = i + 1
    return 0
