module ids
export ComponentId
export NetId


domain ComponentId: u64:
    def make(raw: u64) -> ComponentId effects():
        return wrap[ComponentId](raw)

    def number(value: ComponentId) -> u64 effects():
        return unwrap(value)


domain NetId: u64:
    def make(raw: u64) -> NetId effects():
        return wrap[NetId](raw)

    def number(value: NetId) -> u64 effects():
        return unwrap(value)
