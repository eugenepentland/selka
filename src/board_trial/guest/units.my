module units


public domain Micrometres: i64:
    def make(raw: i64) -> Micrometres effects():
        return wrap[Micrometres](raw)

    def number(value: Micrometres) -> i64 effects():
        return unwrap(value)


public domain Millimetres: i64:
    def make(raw: i64) -> Millimetres effects():
        return wrap[Millimetres](raw)

    def toMicro(value: Millimetres) -> Micrometres effects():
        return Micrometres.make(unwrap(value) * 1000)
