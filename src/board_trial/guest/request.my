module request
import model as m
import ids
import units
import wire
export board
# Decode the host's fixed request layout into the board the validator expects.


def slot[T](present: bool, value: T) -> m.Slot[T]:
    empty: m.Slot[T] = m.Slot.none
    if not present:
        return empty
    return m.Slot.some(value)


def rect(host: Host, position: i64) -> m.Rect:
    return m.Rect(
        x=units.Micrometres.make(wire.signed(host, position)),
        y=units.Micrometres.make(wire.signed(host, position + 8)),
        width=units.Micrometres.make(wire.signed(host, position + 16)),
        height=units.Micrometres.make(wire.signed(host, position + 24))
    )


def component(host: Host, position: i64) -> m.Slot[ids.ComponentId]:
    return slot[ids.ComponentId](wire.flag(host, position), ids.ComponentId.make(wire.unsigned(host, position + 1)))


def net(host: Host, position: i64) -> m.Slot[ids.NetId]:
    return slot[ids.NetId](wire.flag(host, position), ids.NetId.make(wire.unsigned(host, position + 1)))


def face(code: u8) -> m.Face:
    if code == 0u8:
        return m.Face.top
    return m.Face.bottom


def regionFace(code: u8) -> m.RegionFace:
    if code == 0u8:
        return m.RegionFace.top
    if code == 1u8:
        return m.RegionFace.bottom
    return m.RegionFace.both


def layer(code: u8) -> m.Layer:
    if code == 0u8:
        return m.Layer.front
    if code == 1u8:
        return m.Layer.back
    return m.Layer.inner


def admitted(host: Host, position: i64) -> [4]m.Slot[ids.NetId]:
    return [net(host, position), net(host, position + wire.SLOT), net(host, position + 2 * wire.SLOT), net(host, position + 3 * wire.SLOT)]


def region(host: Host, position: i64) -> m.Slot[m.Region]:
    value = m.Region(
        rect=rect(host, position + 1),
        face=regionFace(wire.code(host, position + 33)),
        blocks=m.Blocks(component=wire.flag(host, position + 34), track=wire.flag(host, position + 35), via=wire.flag(host, position + 36)),
        allow_nets=admitted(host, position + 37)
    )
    return slot[m.Region](wire.flag(host, position), value)


def feature(host: Host, position: i64) -> m.Slot[m.Feature]:
    bounds = rect(host, position + 2)
    identity = wire.unsigned(host, position + 34)
    item = m.Feature.via(m.Via(net=ids.NetId.make(identity), rect=bounds))
    if wire.code(host, position + 1) == 0u8:
        item = m.Feature.component(m.Component(id=ids.ComponentId.make(identity), face=face(wire.code(host, position + 42)), rect=bounds))
    if wire.code(host, position + 1) == 1u8:
        item = m.Feature.track(m.Track(net=ids.NetId.make(identity), layer=layer(wire.code(host, position + 42)), rect=bounds))
    return slot[m.Feature](wire.flag(host, position), item)


def components(host: Host) -> [4]m.Slot[ids.ComponentId]:
    return [component(host, wire.COMPONENTS), component(host, wire.COMPONENTS + wire.SLOT), component(host, wire.COMPONENTS + 2 * wire.SLOT), component(host, wire.COMPONENTS + 3 * wire.SLOT)]


def nets(host: Host) -> [4]m.Slot[ids.NetId]:
    return [net(host, wire.NETS), net(host, wire.NETS + wire.SLOT), net(host, wire.NETS + 2 * wire.SLOT), net(host, wire.NETS + 3 * wire.SLOT)]


def regions(host: Host) -> [4]m.Slot[m.Region]:
    return [region(host, wire.REGIONS), region(host, wire.REGIONS + wire.REGION), region(host, wire.REGIONS + 2 * wire.REGION), region(host, wire.REGIONS + 3 * wire.REGION)]


def features(host: Host) -> [8]m.Slot[m.Feature]:
    return [
        feature(host, wire.FEATURES),
        feature(host, wire.FEATURES + wire.FEATURE),
        feature(host, wire.FEATURES + 2 * wire.FEATURE),
        feature(host, wire.FEATURES + 3 * wire.FEATURE),
        feature(host, wire.FEATURES + 4 * wire.FEATURE),
        feature(host, wire.FEATURES + 5 * wire.FEATURE),
        feature(host, wire.FEATURES + 6 * wire.FEATURE),
        feature(host, wire.FEATURES + 7 * wire.FEATURE)
    ]


def board(host: Host) -> m.Board effects(host):
    return m.Board(
        outline=rect(host, wire.OUTLINE),
        components=components(host),
        nets=nets(host),
        regions=regions(host),
        features=features(host)
    )
