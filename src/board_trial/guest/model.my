module model;
import units;
import ids;
export Rect;
export Face;
export RegionFace;
export Layer;
export Blocks;
export Component;
export Track;
export Via;
export Feature;
export Region;
export Board;
export ComponentSlot;
export NetSlot;
export RegionSlot;
export FeatureSlot;
export InputProblem;
export GeometryFailure;
export Failure;
export Preflight;
export Contact;
export Overlap;
export ContactResult;
export ViolationKind;
export RegionIndex;
export Violation;
export First;
export Report;
export Validation;
struct Rect {
    x: units::Micrometres,
    y: units::Micrometres,
    width: units::Micrometres,
    height: units::Micrometres
}
enum Face {
    top,
    bottom
}
enum RegionFace {
    top,
    bottom,
    both
}
enum Layer {
    front,
    back,
    inner
}
struct Blocks {
    component: bool,
    track: bool,
    via: bool
}
struct Component {
    id: ids::ComponentId,
    face: Face,
    rect: Rect
}
struct Track {
    net: ids::NetId,
    layer: Layer,
    rect: Rect
}
struct Via {
    net: ids::NetId,
    rect: Rect
}
union Feature {
    component: Component,
    track: Track,
    via: Via
}
union ComponentSlot {
    none,
    some: ids::ComponentId
}
union NetSlot {
    none,
    some: ids::NetId
}
struct Region {
    rect: Rect,
    face: RegionFace,
    blocks: Blocks,
    allow_nets: [4]NetSlot
}
union RegionSlot {
    none,
    some: Region
}
union FeatureSlot {
    none,
    some: Feature
}
struct Board {
    outline: Rect,
    components: [4]ComponentSlot,
    nets: [4]NetSlot,
    regions: [4]RegionSlot,
    features: [8]FeatureSlot
}
enum InputProblem {
    invalid_bounds,
    invalid_id,
    duplicate_component,
    duplicate_net,
    empty_blocks,
    unknown_allow_net,
    missing_component,
    missing_net
}
enum GeometryFailure {
    invalid_bounds,
    unavailable
}
union Failure {
    input: InputProblem,
    geometry: GeometryFailure
}
result Preflight {
    ok: bool,
    err: Failure
}
enum Contact {
    clear,
    intersection
}
result Overlap {
    ok: Contact,
    err: GeometryFailure
}
result ContactResult {
    ok: Contact,
    err: Failure
}
enum ViolationKind {
    outside_board,
    keepout
}
union RegionIndex {
    board,
    keepout: u64
}
struct Violation {
    feature: u64,
    kind: ViolationKind,
    region: RegionIndex
}
union First {
    none,
    some: Violation
}
struct Report {
    violations: u64,
    first: First
}
result Validation {
    ok: Report,
    err: Failure
}
