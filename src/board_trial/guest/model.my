module model
import units
import ids


public union Slot[T]:
    none,
    some: T


public record Rect:
    x: units.Micrometres
    y: units.Micrometres
    width: units.Micrometres
    height: units.Micrometres


public enum Face:
    top,
    bottom


public enum RegionFace:
    top,
    bottom,
    both


public enum Layer:
    front,
    back,
    inner


public record Blocks:
    component: bool
    track: bool
    via: bool


public record Component:
    id: ids.ComponentId
    face: Face
    rect: Rect


public record Track:
    net: ids.NetId
    layer: Layer
    rect: Rect


public record Via:
    net: ids.NetId
    rect: Rect


public union Feature:
    component: Component,
    track: Track,
    via: Via


public record Region:
    rect: Rect
    face: RegionFace
    blocks: Blocks
    allow_nets: [4]Slot[ids.NetId]


public record Board:
    outline: Rect
    components: [4]Slot[ids.ComponentId]
    nets: [4]Slot[ids.NetId]
    regions: [4]Slot[Region]
    features: [8]Slot[Feature]


public enum InputProblem:
    invalid_bounds,
    invalid_id,
    duplicate_component,
    duplicate_net,
    empty_blocks,
    unknown_allow_net,
    missing_component,
    missing_net


public enum GeometryFailure:
    invalid_bounds,
    unavailable


public union Failure:
    input: InputProblem,
    geometry: GeometryFailure


public result Preflight:
    ok: bool,
    err: Failure


public enum Contact:
    clear,
    intersection


public result Overlap:
    ok: Contact,
    err: GeometryFailure


public result ContactResult:
    ok: Contact,
    err: Failure


public enum ViolationKind:
    outside_board,
    keepout


public union RegionIndex:
    board,
    keepout: u64


public record Violation:
    feature: u64
    kind: ViolationKind
    region: RegionIndex


public record Report:
    violations: u64
    first: Slot[Violation]


public result Validation:
    ok: Report,
    err: Failure
