module model
import units
import ids
export Rect
export Face
export RegionFace
export Layer
export Blocks
export Component
export Track
export Via
export Feature
export Region
export Board
export Slot
export InputProblem
export GeometryFailure
export Failure
export Preflight
export Contact
export Overlap
export ContactResult
export ViolationKind
export RegionIndex
export Violation
export Report
export Validation


union Slot[T]:
    none,
    some: T


record Rect:
    x: units.Micrometres
    y: units.Micrometres
    width: units.Micrometres
    height: units.Micrometres


enum Face:
    top,
    bottom


enum RegionFace:
    top,
    bottom,
    both


enum Layer:
    front,
    back,
    inner


record Blocks:
    component: bool
    track: bool
    via: bool


record Component:
    id: ids.ComponentId
    face: Face
    rect: Rect


record Track:
    net: ids.NetId
    layer: Layer
    rect: Rect


record Via:
    net: ids.NetId
    rect: Rect


union Feature:
    component: Component,
    track: Track,
    via: Via


record Region:
    rect: Rect
    face: RegionFace
    blocks: Blocks
    allow_nets: [4]Slot[ids.NetId]


record Board:
    outline: Rect
    components: [4]Slot[ids.ComponentId]
    nets: [4]Slot[ids.NetId]
    regions: [4]Slot[Region]
    features: [8]Slot[Feature]


enum InputProblem:
    invalid_bounds,
    invalid_id,
    duplicate_component,
    duplicate_net,
    empty_blocks,
    unknown_allow_net,
    missing_component,
    missing_net


enum GeometryFailure:
    invalid_bounds,
    unavailable


union Failure:
    input: InputProblem,
    geometry: GeometryFailure


result Preflight:
    ok: bool,
    err: Failure


enum Contact:
    clear,
    intersection


result Overlap:
    ok: Contact,
    err: GeometryFailure


result ContactResult:
    ok: Contact,
    err: Failure


enum ViolationKind:
    outside_board,
    keepout


union RegionIndex:
    board,
    keepout: u64


record Violation:
    feature: u64
    kind: ViolationKind
    region: RegionIndex


record Report:
    violations: u64
    first: Slot[Violation]


result Validation:
    ok: Report,
    err: Failure
