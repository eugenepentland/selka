module validation
import model as m
import bounds
import checks
import policy
import geometry
export validate


def add(report: m.Report, position: u64, kind: m.ViolationKind, region: m.RegionIndex) -> m.Report:
    first = report.first
    match first:
        case m.Slot[m.Violation].none:
            first = m.Slot.some(m.Violation(feature=position, kind=kind, region=region))
        case m.Slot[m.Violation].some(_):
            pass
    return m.Report(violations=report.violations + 1u64, first=first)


def inspect(board: m.Board, item: m.Feature, position: u64, previous: m.Report) -> m.Validation effects(host):
    report = previous
    rect = bounds.rectangle(item)
    if not bounds.inside(board.outline, rect):
        report = add(report, position, m.ViolationKind.outside_board, m.RegionIndex.board)
    i = 0u64
    while i < len(board.regions):
        match board.regions[i]:
            case m.Slot[m.Region].none:
                pass
            case m.Slot[m.Region].some(region):
                if policy.applies(item, region):
                    contact = geometry.contact(rect, region.rect)?
                    match contact:
                        case m.Contact.clear:
                            pass
                        case m.Contact.intersection:
                            report = add(report, position, m.ViolationKind.keepout, m.RegionIndex.keepout(i))
        i = i + 1u64
    return Ok(report)


def validate(board: m.Board) -> m.Validation effects(host):
    _ = checks.preflight(board)?
    empty: m.Slot[m.Violation] = m.Slot.none
    report = m.Report(violations=0u64, first=empty)
    i = 0u64
    while i < len(board.features):
        match board.features[i]:
            case m.Slot[m.Feature].none:
                pass
            case m.Slot[m.Feature].some(item):
                report = inspect(board, item, i, report)?
        i = i + 1u64
    return Ok(report)
