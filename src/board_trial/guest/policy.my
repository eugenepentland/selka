module policy
import model as m
import ids
import inventory
export applies


def side(region: m.RegionFace, face: m.Face) -> bool:
    match region:
        case m.RegionFace.both:
            return True
        case m.RegionFace.top:
            return face == m.Face.top
        case m.RegionFace.bottom:
            return face == m.Face.bottom


def layer(region: m.RegionFace, value: m.Layer) -> bool:
    match region:
        case m.RegionFace.both:
            return True
        case m.RegionFace.top:
            return value == m.Layer.front
        case m.RegionFace.bottom:
            return value == m.Layer.back


def applies(item: m.Feature, region: m.Region) -> bool effects():
    match item:
        case m.Feature.component(value):
            return region.blocks.component and side(region.face, value.face)
        case m.Feature.track(value):
            return region.blocks.track and layer(region.face, value.layer) and not inventory.has[ids.NetId](region.allow_nets, value.net, u64(len(region.allow_nets)))
        case m.Feature.via(value):
            return region.blocks.via and not inventory.has[ids.NetId](region.allow_nets, value.net, u64(len(region.allow_nets)))
