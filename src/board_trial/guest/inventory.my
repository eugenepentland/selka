module inventory
import model as m
import ids


public def has[T: equality](slots: [4]m.Slot[T], needle: T, end: u64) -> bool effects():
    i = 0u64
    while i < end:
        match slots[i]:
            case m.Slot[T].none:
                pass
            case m.Slot[T].some(value):
                if value == needle:
                    return True
        i = i + 1u64
    return False


public def checkComponents(slots: [4]m.Slot[ids.ComponentId]) -> m.Preflight effects():
    i = 0u64
    while i < u64(len(slots)):
        match slots[i]:
            case m.Slot[ids.ComponentId].none:
                pass
            case m.Slot[ids.ComponentId].some(value):
                if ids.ComponentId.number(value) == 0u64:
                    return Err(m.Failure.input(m.InputProblem.invalid_id))
                if has[ids.ComponentId](slots, value, i):
                    return Err(m.Failure.input(m.InputProblem.duplicate_component))
        i = i + 1u64
    return Ok(True)


public def checkNets(slots: [4]m.Slot[ids.NetId]) -> m.Preflight effects():
    i = 0u64
    while i < u64(len(slots)):
        match slots[i]:
            case m.Slot[ids.NetId].none:
                pass
            case m.Slot[ids.NetId].some(value):
                if ids.NetId.number(value) == 0u64:
                    return Err(m.Failure.input(m.InputProblem.invalid_id))
                if has[ids.NetId](slots, value, i):
                    return Err(m.Failure.input(m.InputProblem.duplicate_net))
        i = i + 1u64
    return Ok(True)
