// Typed scoped-provider requests; authority comes only from the supplied capability.
module std_fs;
import std_io;
import std_path;
import std_bytes;
import std_result;
export ReadFileFailure;
export ReadFile;
export WriteFileFailure;
export WriteFile;
export read_file;
export write_file;
export FileKind;
export Metadata;
export MetadataResult;
export DirectoryEntry;
export Listing;
export Listed;
export metadata;
export list_directory;
export directory_count;
export directory_entry;
export Mode;
export Open;
export open;
enum Mode {
    read,
    write_existing,
    create_exclusive,
    truncate_existing
}
result RawOpen {
    ok: std_io::File,
    err: i64
}
result Open {
    ok: std_io::File,
    err: std_io::Error
}
fn open(heap: allocator, fs: filesystem_cap, path: &[]u8, mode: Mode) -> Open {
    if !std_path::valid(path) {
        return new Open.err(new std_io::Error {
            kind: new std_io::Kind.invalid_path,
            code: 1
        });
    }
    match std_bytes::create(heap, cast<i64>(len_slice(path) + 2u64)) {
        std_bytes::Built.err(e) => {
            return new Open.err(new std_io::Error {
                kind: new std_io::Kind.allocation,
                code: e.code
            });
        },
        std_bytes::Built.ok(bytes) => {
            match mode {
                Mode.read => {
                    return requested(restrict_resource<read, complete>(fs), bytes, "r:", path);
                },
                Mode.write_existing => {
                    return requested(restrict_resource<write, complete>(fs), bytes, "w:", path);
                },
                Mode.create_exclusive => {
                    return requested(restrict_resource<write, complete>(fs), bytes, "c:", path);
                },
                Mode.truncate_existing => {
                    return requested(restrict_resource<write, complete>(fs), bytes, "t:", path);
                }
            }
        }
    }
}
fn requested(fs: filesystem_cap, bytes: std_bytes::Bytes, prefix: &[]u8, path: &[]u8) -> Open {
    match std_bytes::append(bytes, prefix) {
        std_bytes::Built.err(e) => {
            return new Open.err(new std_io::Error {
                kind: new std_io::Kind.allocation,
                code: e.code
            });
        },
        std_bytes::Built.ok(first) => {
            match std_bytes::append(first, path) {
                std_bytes::Built.err(e) => {
                    return new Open.err(new std_io::Error {
                        kind: new std_io::Kind.allocation,
                        code: e.code
                    });
                },
                std_bytes::Built.ok(request) => {
                    match acquire_resource<RawOpen>(fs, request) {
                        RawOpen.ok(file) => {
                            return new Open.ok(file);
                        },
                        RawOpen.err(code) => {
                            return new Open.err(std_io::provider_error(code));
                        }
                    }
                }
            }
        }
    }
}
struct ReadFileFailure {
    bytes: std_bytes::Bytes,
    cause: std_io::Error,
    progress: u64
}
result ReadFile {
    ok: std_bytes::Bytes,
    err: ReadFileFailure
}
struct WriteFileFailure {
    cause: std_io::Error,
    progress: u64
}
result WriteFile {
    ok: u64,
    err: WriteFileFailure
}
fn read_file(heap: allocator, fs: filesystem_cap, path: &[]u8, output: std_bytes::Bytes, limit: u64) -> ReadFile {
    match open(heap, fs, path, new Mode.read) {
        Open.err(cause) => {
            return new ReadFile.err(new ReadFileFailure {
                bytes: output,
                cause: cause,
                progress: 0u64
            });
        },
        Open.ok(file) => {
            match std_io::read_to_end(std_io::reader(file), output, limit) {
                std_io::Collected.err(failure) => {
                    return new ReadFile.err(new ReadFileFailure {
                        cause: read_field(failure, cause),
                        progress: read_field(failure, progress),
                        bytes: take_field(failure, bytes)
                    });
                },
                std_io::Collected.ok(value) => {
                    return new ReadFile.ok(take_field(value, bytes));
                }
            }
        }
    }
}
fn write_file(heap: allocator, fs: filesystem_cap, path: &[]u8, mode: Mode, source: &[]u8) -> WriteFile {
    match open(heap, fs, path, mode) {
        Open.err(cause) => {
            return new WriteFile.err(new WriteFileFailure {
                cause: cause,
                progress: 0u64
            });
        },
        Open.ok(file) => {
            match std_io::write_all(std_io::writer(file), source) {
                std_io::Writing.err(failure) => {
                    let cause = read_field(failure, cause);
                    let accepted = read_field(failure, progress);
                    let state = take_field(failure, writer);
                    let pending = read_field(state, length);
                    return new WriteFile.err(new WriteFileFailure {
                        cause: cause,
                        progress: accepted - pending
                    });
                },
                std_io::Writing.ok(value) => {
                    match std_io::finish(take_field(value, writer)) {
                        std_io::Finished.ok(discard) => {
                            return new WriteFile.ok(len_slice(source));
                        },
                        std_io::Finished.err(failure) => {
                            let cause = read_field(failure, cause);
                            let state = take_field(failure, writer);
                            let pending = read_field(state, length);
                            return new WriteFile.err(new WriteFileFailure {
                                cause: cause,
                                progress: len_slice(source) - pending
                            });
                        }
                    }
                }
            }
        }
    }
}
enum FileKind {
    other,
    file,
    directory,
    symlink
}
struct Metadata {
    kind: FileKind,
    size: u64
}
result MetadataResult {
    ok: Metadata,
    err: std_io::Error
}
struct DirectoryEntry {
    kind: FileKind,
    name: std_path::Span
}
struct Listing {
    bytes: std_bytes::Bytes,
    count: u64
}
result Listed {
    ok: Listing,
    err: ReadFileFailure
}
fn query(heap: allocator, fs: filesystem_cap, path: &[]u8, prefix: &[]u8) -> Open {
    if len_slice(path) != 0u64 && !std_path::valid(path) {
        return new Open.err(new std_io::Error {
            kind: new std_io::Kind.invalid_path,
            code: 1
        });
    }
    match std_bytes::create(heap, cast<i64>(len_slice(path) + 2u64)) {
        std_bytes::Built.err(e) => {
            return new Open.err(new std_io::Error {
                kind: new std_io::Kind.allocation,
                code: e.code
            });
        },
        std_bytes::Built.ok(bytes) => {
            return requested(restrict_resource<read, complete>(fs), bytes, prefix, path);
        }
    }
}
fn malformed() -> std_io::Error noalloc {
    return new std_io::Error {
        kind: new std_io::Kind.malformed,
        code: 0
    };
}
fn file_kind(code: u8) -> FileKind noalloc {
    if code == 1u8 {
        return new FileKind.file;
    }
    if code == 2u8 {
        return new FileKind.directory;
    }
    if code == 3u8 {
        return new FileKind.symlink;
    }
    return new FileKind.other;
}
fn metadata(heap: allocator, fs: filesystem_cap, path: &[]u8) -> MetadataResult {
    match query(heap, fs, path, "m:") {
        Open.err(cause) => {
            return new MetadataResult.err(cause);
        },
        Open.ok(file) => {
            let mut bytes = new [10]u8[0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
            borrow mut bytes[0..10] as view {
                match std_io::read_exact(std_io::reader(file), view) {
                    std_io::Reading.err(failure) => {
                        return new MetadataResult.err(read_field(failure, cause));
                    },
                    std_io::Reading.ok(value) => {
                        return metadata_end(take_field(value, reader), view);
                    }
                }
            }
        }
    }
}
fn metadata_end(input: std_io::Reader, bytes: &[]u8) -> MetadataResult {
    let mut extra = new [1]u8[0u8];
    borrow mut extra[0..1] as view {
        match std_io::read(input, view) {
            std_io::Reading.err(failure) => {
                return new MetadataResult.err(read_field(failure, cause));
            },
            std_io::Reading.ok(value) => {
                let progress = read_field(value, progress);
                if progress.length != 0u64 {
                    return new MetadataResult.err(malformed());
                }
            }
        }
    }
    if read_slice(bytes, 0) != 1u8 || read_slice(bytes, 1) > 3u8 {
        return new MetadataResult.err(malformed());
    }
    let mut size = 0u64;
    let mut i = 0u64;
    while i < 8u64 {
        size = bit_or(size, shift_left(cast<u64>(read_slice(bytes, i + 2u64)), i * 8u64));
        i += 1u64;
    }
    return new MetadataResult.ok(new Metadata {
        kind: file_kind(read_slice(bytes, 1)),
        size: size
    });
}
fn directory_count(bytes: &[]u8) -> std_result::Option<u64> noalloc {
    if len_slice(bytes) == 0u64 || read_slice(bytes, 0) != 1u8 {
        return new std_result::Option<u64>.none;
    }
    let mut count = 0u64;
    let mut offset = 1u64;
    while offset < len_slice(bytes) {
        if len_slice(bytes) - offset < 3u64 {
            return new std_result::Option<u64>.none;
        }
        if read_slice(bytes, offset) > 3u8 {
            return new std_result::Option<u64>.none;
        }
        let length = cast<u64>(read_slice(bytes, offset + 1u64)) + 256u64 * cast<u64>(read_slice(bytes, offset + 2u64));
        offset += 3u64;
        if length == 0u64 || length > len_slice(bytes) - offset {
            return new std_result::Option<u64>.none;
        }
        borrow bytes[offset..offset + length] as name {
            if !directory_name(name) {
                return new std_result::Option<u64>.none;
            }
        }
        offset += length;
        count += 1u64;
    }
    return new std_result::Option<u64>.some(count);
}
fn directory_entry(bytes: &[]u8, index: u64) -> std_result::Option<DirectoryEntry> noalloc {
    match directory_count(bytes) {
        std_result::Option<u64>.none => {
            return new std_result::Option<DirectoryEntry>.none;
        },
        std_result::Option<u64>.some(count) => {
            if index >= count {
                return new std_result::Option<DirectoryEntry>.none;
            }
        }
    }
    let mut offset = 1u64;
    let mut count = 0u64;
    while offset < len_slice(bytes) {
        let kind = file_kind(read_slice(bytes, offset));
        let length = cast<u64>(read_slice(bytes, offset + 1u64)) + 256u64 * cast<u64>(read_slice(bytes, offset + 2u64));
        offset += 3u64;
        if count == index {
            return new std_result::Option<DirectoryEntry>.some(new DirectoryEntry {
                kind: kind,
                name: new std_path::Span {
                    start: offset,
                    end: offset + length
                }
            });
        }
        offset += length;
        count += 1u64;
    }
    return new std_result::Option<DirectoryEntry>.none;
}
fn list_directory(heap: allocator, fs: filesystem_cap, path: &[]u8, output: std_bytes::Bytes, limit: u64) -> Listed {
    if len_buffer(output) != 0u64 {
        return new Listed.err(new ReadFileFailure {
            bytes: output,
            cause: malformed(),
            progress: 0u64
        });
    }
    match query(heap, fs, path, "l:") {
        Open.err(cause) => {
            return new Listed.err(new ReadFileFailure {
                bytes: output,
                cause: cause,
                progress: 0u64
            });
        },
        Open.ok(file) => {
            match std_io::read_to_end(std_io::reader(file), output, limit) {
                std_io::Collected.err(failure) => {
                    return new Listed.err(new ReadFileFailure {
                        cause: read_field(failure, cause),
                        progress: read_field(failure, progress),
                        bytes: take_field(failure, bytes)
                    });
                },
                std_io::Collected.ok(value) => {
                    return listing(take_field(value, bytes));
                }
            }
        }
    }
}
fn listing(bytes: std_bytes::Bytes) -> Listed {
    let mut count = 0u64;
    let mut valid = false;
    borrow bytes[0..len_buffer(bytes)] as view {
        match directory_count(view) {
            std_result::Option<u64>.none => {},
            std_result::Option<u64>.some(n) => {
                count = n;
                valid = true;
            }
        }
    }
    if !valid {
        return new Listed.err(new ReadFileFailure {
            cause: malformed(),
            progress: len_buffer(bytes),
            bytes: bytes
        });
    }
    return new Listed.ok(new Listing {
        count: count,
        bytes: bytes
    });
}
fn directory_name(name: &[]u8) -> bool noalloc {
    let length = len_slice(name);
    if length == 0u64 || length > 4094u64 {
        return false;
    }
    if length == 1u64 && read_slice(name, 0) == 46u8 {
        return false;
    }
    if length == 2u64 && read_slice(name, 0) == 46u8 && read_slice(name, 1) == 46u8 {
        return false;
    }
    let mut i = 0u64;
    while i < length {
        if read_slice(name, i) == 0u8 || read_slice(name, i) == 47u8 {
            return false;
        }
        i += 1u64;
    }
    return true;
}
