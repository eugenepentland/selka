// Ordinary JSON transport and queries. Node zero represents a missing value.
module std_json;
export Bytes;
export Input;
export Document;
export Parsed;
export Status;
export parse;
export get;
export field;
export equal;
export compare;
export textis;
buffer Bytes: u8;
result Input {
    ok: Bytes,
    err: i64
}
buffer Document: i64;
result Parsed {
    ok: Document,
    err: i64
}
result Status {
    ok: bool,
    err: i64
}
fn parse(heap: allocator, bytes: Bytes, limit: i64) -> Parsed {
    return json_parse::< Parsed >(heap, bytes, limit);
}
// Tape fields: kind, decoded text start/end, subtree end, child count, integer.
fn get(document: &[]i64, node: i64, slot: i64) -> i64 {
    return read_slice(document, node * 6 + slot);
}
fn field(document: &[]i64, node: i64, key: &[]u8) -> i64 {
    if get(document, node, 0) != 1 {
        return 0;
    }
    let mut child = node + 1;
    while child < get(document, node, 3) {
        if textis(document, child, key) {
            return child + 1;
        }
        child = get(document, child + 1, 3);
    }
    return 0;
}
fn textis(document: &[]i64, node: i64, text: &[]u8) -> bool {
    if get(document, node, 0) != 3 {
        return false;
    }
    let start = get(document, node, 1);
    let length = get(document, node, 2) - start;
    if length != cast<i64>(len_slice(text)) {
        return false;
    }
    let mut i = 0;
    while i < length {
        if read_slice(document, start + i) != cast<i64>(read_slice(text, i)) {
            return false;
        }
        i += 1;
    }
    return true;
}
fn equal(document: &[]i64, left: i64, right: i64) -> bool {
    return get(document, left, 0) == 3 && get(document, right, 0) == 3 && compare(document, left, right) == 0;
}
fn compare(document: &[]i64, left: i64, right: i64) -> i64 {
    let mut a = get(document, left, 1);
    let mut b = get(document, right, 1);
    let end_a = get(document, left, 2);
    let end_b = get(document, right, 2);
    while a < end_a && b < end_b {
        let difference = read_slice(document, a) - read_slice(document, b);
        if difference != 0 {
            return difference;
        }
        a += 1;
        b += 1;
    }
    return (end_a - a) -(end_b - b);
}
