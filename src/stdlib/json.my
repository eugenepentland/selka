module json
import strings
export Json
export max_depth
export null_value
export boolean
export integer
export number
export text
export array
export object
export loads
export dumps
export type_name
export is_null
export as_bool
export as_int
export as_float
export as_str
export as_list
export as_dict
export get
export at


# An RFC 8259 value. Objects keep the key order in which they were parsed.
union Json:
    null,
    boolean: bool,
    integer: int,
    number: float,
    text: str,
    array: list[Json],
    object: dict[str, Json]


# One position inside the UTF-8 form of a document; the cell is shared by copies.
class Scanner:
    data: bytes
    position: list[int]


# Deepest container nesting that loads accepts.
def max_depth() -> int:
    return 64


# The JSON null value.
def null_value() -> Json:
    return new Json.null


# A JSON true or false value.
def boolean(value: bool) -> Json:
    return new Json.boolean(value)


# A JSON number that is exactly a 64-bit signed integer.
def integer(value: int) -> Json:
    return new Json.integer(value)


# A JSON number carried as binary64.
def number(value: float) -> Json:
    return new Json.number(value)


# A JSON string.
def text(value: str) -> Json:
    return new Json.text(value)


# A JSON array of values.
def array(items: list[Json]) -> Json:
    return new Json.array(items)


# A JSON object; iteration and rendering follow insertion order.
def object(fields: dict[str, Json]) -> Json:
    return new Json.object(fields)


# The RFC 8259 name of a value's kind.
def type_name(value: Json) -> str:
    match value:
        case Json.null:
            return "null"
        case Json.boolean(_):
            return "boolean"
        case Json.integer(_):
            return "number"
        case Json.number(_):
            return "number"
        case Json.text(_):
            return "string"
        case Json.array(_):
            return "array"
        case Json.object(_):
            return "object"


# Whether a value is JSON null.
def is_null(value: Json) -> bool:
    match value:
        case Json.null:
            return True
        case Json.boolean(_):
            return False
        case Json.integer(_):
            return False
        case Json.number(_):
            return False
        case Json.text(_):
            return False
        case Json.array(_):
            return False
        case Json.object(_):
            return False


# The boolean carried by a value, if it is one.
def as_bool(value: Json) -> Option[bool]:
    match value:
        case Json.boolean(flag):
            return Some(flag)
        case Json.null:
            return None
        case Json.integer(_):
            return None
        case Json.number(_):
            return None
        case Json.text(_):
            return None
        case Json.array(_):
            return None
        case Json.object(_):
            return None


# The exact integer carried by a value, if it has one.
def as_int(value: Json) -> Option[int]:
    match value:
        case Json.integer(count):
            return Some(count)
        case Json.null:
            return None
        case Json.boolean(_):
            return None
        case Json.number(_):
            return None
        case Json.text(_):
            return None
        case Json.array(_):
            return None
        case Json.object(_):
            return None


# The number carried by a value, widening an exact integer to binary64.
def as_float(value: Json) -> Option[float]:
    match value:
        case Json.number(amount):
            return Some(amount)
        case Json.integer(count):
            return Some(float(count))
        case Json.null:
            return None
        case Json.boolean(_):
            return None
        case Json.text(_):
            return None
        case Json.array(_):
            return None
        case Json.object(_):
            return None


# The string carried by a value, if it is one.
def as_str(value: Json) -> Option[str]:
    match value:
        case Json.text(body):
            return Some(body)
        case Json.null:
            return None
        case Json.boolean(_):
            return None
        case Json.integer(_):
            return None
        case Json.number(_):
            return None
        case Json.array(_):
            return None
        case Json.object(_):
            return None


# The elements of an array value, if it is one.
def as_list(value: Json) -> Option[list[Json]]:
    match value:
        case Json.array(items):
            return Some(items)
        case Json.null:
            return None
        case Json.boolean(_):
            return None
        case Json.integer(_):
            return None
        case Json.number(_):
            return None
        case Json.text(_):
            return None
        case Json.object(_):
            return None


# The members of an object value, if it is one.
def as_dict(value: Json) -> Option[dict[str, Json]]:
    match value:
        case Json.object(fields):
            return Some(fields)
        case Json.null:
            return None
        case Json.boolean(_):
            return None
        case Json.integer(_):
            return None
        case Json.number(_):
            return None
        case Json.text(_):
            return None
        case Json.array(_):
            return None


# The member of an object under a key, if both the object and the key exist.
def get(value: Json, key: str) -> Option[Json]:
    match as_dict(value):
        case Some(fields):
            if key not in fields:
                return None
            return Some(fields[key])
        case None:
            return None


# The element of an array at an index, if both the array and the index exist.
def at(value: Json, index: int) -> Option[Json]:
    match as_list(value):
        case Some(items):
            if index < 0 or index >= len(items):
                return None
            return Some(items[index])
        case None:
            return None


# A scanner positioned at the start of a UTF-8 document.
def scanner_of(data: bytes) -> Scanner:
    cursor: list[int] = []
    cursor.append(0)
    return Scanner(data=data, position=cursor)


# Whether the scanner has consumed every byte.
def at_end(scanner: Scanner) -> bool:
    return scanner.position[0] >= len(scanner.data)


# The byte under the cursor, or -1 at the end of the document.
def peek(scanner: Scanner) -> int:
    if at_end(scanner):
        return 0 - 1
    return scanner.data[scanner.position[0]]


# Move the cursor one byte forward.
def advance(scanner: Scanner):
    scanner.position[0] = scanner.position[0] + 1
    return


# Move the cursor past the four whitespace bytes RFC 8259 allows.
def skip_whitespace(scanner: Scanner):
    while not at_end(scanner):
        byte = peek(scanner)
        if byte != 32 and byte != 9 and byte != 10 and byte != 13:
            return
        advance(scanner)
    return


# A message naming the byte offset the scanner stopped at.
def fail(scanner: Scanner, message: str) -> str:
    match strings.format_int(scanner.position[0], 10):
        case Ok(rendered):
            return message + " at byte " + rendered
        case Err(_):
            return message


# Whether a byte is an ASCII decimal digit.
def is_digit_byte(byte: int) -> bool:
    return byte >= 48 and byte <= 57


# The value of one hexadecimal digit byte, or -1 when it is not one.
def hex_value(byte: int) -> int:
    if is_digit_byte(byte):
        return byte - 48
    if byte >= 97 and byte <= 102:
        return byte - 87
    if byte >= 65 and byte <= 70:
        return byte - 55
    return 0 - 1


# Append the UTF-8 encoding of one code point to a byte accumulator.
def append_code_point(out: list[int], code: int):
    if code < 128:
        out.append(code)
        return
    if code < 2048:
        out.append(192 + code // 64)
        out.append(128 + code % 64)
        return
    if code < 65536:
        trailing = code // 64 % 64
        out.append(224 + code // 4096)
        out.append(128 + trailing)
        out.append(128 + code % 64)
        return
    second = code // 4096 % 64
    third = code // 64 % 64
    out.append(240 + code // 262144)
    out.append(128 + second)
    out.append(128 + third)
    out.append(128 + code % 64)
    return


# Text for accumulated UTF-8 bytes, rejecting sequences the source made invalid.
def decoded(values: list[int]) -> Result[str, str]:
    match bytes(values).decode():
        case Ok(rendered):
            return Ok(rendered)
        case Err(_):
            return Err("JSON string is not valid UTF-8")


# The four hexadecimal digits of a \u escape.
def read_hex4(scanner: Scanner) -> Result[int, str]:
    value = 0
    index = 0
    while index < 4:
        if at_end(scanner):
            return Err(fail(scanner, "truncated JSON unicode escape"))
        digit = hex_value(peek(scanner))
        if digit < 0:
            return Err(fail(scanner, "invalid JSON unicode escape"))
        advance(scanner)
        value = value * 16 + digit
        index += 1
    return Ok(value)


# One escaped code point, including a complete surrogate pair.
def read_unicode_escape(scanner: Scanner, out: list[int]) -> Result[bool, str]:
    first = read_hex4(scanner)?
    if first >= 56320 and first <= 57343:
        return Err(fail(scanner, "JSON low surrogate has no high surrogate"))
    if first < 55296 or first > 56319:
        append_code_point(out, first)
        return Ok(True)
    if peek(scanner) != 92:
        return Err(fail(scanner, "JSON high surrogate needs a low surrogate"))
    advance(scanner)
    if peek(scanner) != 117:
        return Err(fail(scanner, "JSON high surrogate needs a low surrogate"))
    advance(scanner)
    second = read_hex4(scanner)?
    if second < 56320 or second > 57343:
        return Err(fail(scanner, "JSON high surrogate needs a low surrogate"))
    append_code_point(out, 65536 + (first - 55296) * 1024 + second - 56320)
    return Ok(True)


# One backslash escape from an RFC 8259 string body.
def read_escape(scanner: Scanner, out: list[int]) -> Result[bool, str]:
    if at_end(scanner):
        return Err(fail(scanner, "unterminated JSON escape"))
    byte = peek(scanner)
    advance(scanner)
    if byte == 34 or byte == 92 or byte == 47:
        out.append(byte)
        return Ok(True)
    if byte == 98:
        out.append(8)
        return Ok(True)
    if byte == 102:
        out.append(12)
        return Ok(True)
    if byte == 110:
        out.append(10)
        return Ok(True)
    if byte == 114:
        out.append(13)
        return Ok(True)
    if byte == 116:
        out.append(9)
        return Ok(True)
    if byte != 117:
        return Err(fail(scanner, "unknown JSON string escape"))
    return read_unicode_escape(scanner, out)


# One string body, with the opening quote under the cursor.
def read_string(scanner: Scanner) -> Result[str, str]:
    advance(scanner)
    out: list[int] = []
    while not at_end(scanner):
        byte = peek(scanner)
        advance(scanner)
        if byte == 34:
            return decoded(out)
        if byte < 32:
            return Err(fail(scanner, "unescaped control character in JSON string"))
        if byte != 92:
            out.append(byte)
        else:
            _ = read_escape(scanner, out)?
    return Err(fail(scanner, "unterminated JSON string"))


# Move the cursor past the digits of an integer or fraction part.
def skip_digits(scanner: Scanner):
    while not at_end(scanner) and is_digit_byte(peek(scanner)):
        advance(scanner)
    return


# The exponent part of a number, if one starts under the cursor.
def read_exponent(scanner: Scanner) -> Result[bool, str]:
    if at_end(scanner):
        return Ok(False)
    if peek(scanner) != 101 and peek(scanner) != 69:
        return Ok(False)
    advance(scanner)
    if peek(scanner) == 43 or peek(scanner) == 45:
        advance(scanner)
    if at_end(scanner) or not is_digit_byte(peek(scanner)):
        return Err(fail(scanner, "JSON exponent needs a digit"))
    skip_digits(scanner)
    return Ok(True)


# The fraction part of a number, if one starts under the cursor.
def read_fraction(scanner: Scanner) -> Result[bool, str]:
    if at_end(scanner) or peek(scanner) != 46:
        return Ok(False)
    advance(scanner)
    if at_end(scanner) or not is_digit_byte(peek(scanner)):
        return Err(fail(scanner, "JSON fraction needs a digit"))
    skip_digits(scanner)
    return Ok(True)


# The integer part of a number, rejecting a leading zero before more digits.
def read_integer_part(scanner: Scanner) -> Result[bool, str]:
    if peek(scanner) == 45:
        advance(scanner)
    if at_end(scanner) or not is_digit_byte(peek(scanner)):
        return Err(fail(scanner, "JSON number needs a digit"))
    if peek(scanner) != 48:
        skip_digits(scanner)
        return Ok(True)
    advance(scanner)
    if not at_end(scanner) and is_digit_byte(peek(scanner)):
        return Err(fail(scanner, "JSON number has a leading zero"))
    return Ok(True)


# One number literal, exact when it has no fraction, exponent or overflow.
def read_number(scanner: Scanner) -> Result[Json, str]:
    start = scanner.position[0]
    _ = read_integer_part(scanner)?
    floating = read_fraction(scanner)?
    if read_exponent(scanner)?:
        floating = True
    literal = ""
    match scanner.data[start:scanner.position[0]].decode():
        case Ok(rendered):
            literal = rendered
        case Err(_):
            return Err(fail(scanner, "JSON number is not valid text"))
    if not floating:
        match strings.to_int(literal):
            case Some(value):
                return Ok(integer(value))
            case None:
                floating = True
    match strings.to_float(literal):
        case Some(value):
            return Ok(number(value))
        case None:
            return Err(fail(scanner, "JSON number is malformed"))


# One of the three bare literals, matched exactly.
def read_literal(scanner: Scanner, word: bytes, value: Json) -> Result[Json, str]:
    start = scanner.position[0]
    if start + len(word) > len(scanner.data):
        return Err(fail(scanner, "truncated JSON literal"))
    if scanner.data[start:start + len(word)] != word:
        return Err(fail(scanner, "unknown JSON literal"))
    scanner.position[0] = start + len(word)
    return Ok(value)


# One array body, with the opening bracket under the cursor.
def read_array(scanner: Scanner, depth: int) -> Result[Json, str]:
    advance(scanner)
    items: list[Json] = []
    skip_whitespace(scanner)
    if peek(scanner) == 93:
        advance(scanner)
        return Ok(array(items))
    while not at_end(scanner):
        items.append(read_value(scanner, depth + 1)?)
        skip_whitespace(scanner)
        byte = peek(scanner)
        if byte == 93:
            advance(scanner)
            return Ok(array(items))
        if byte != 44:
            return Err(fail(scanner, "expected ',' or ']' in JSON array"))
        advance(scanner)
    return Err(fail(scanner, "unterminated JSON array"))


# One object member, added to the accumulated fields.
def read_member(scanner: Scanner, fields: dict[str, Json], depth: int) -> Result[bool, str]:
    skip_whitespace(scanner)
    if peek(scanner) != 34:
        return Err(fail(scanner, "JSON object keys must be strings"))
    key = read_string(scanner)?
    if key in fields:
        return Err(fail(scanner, "JSON object has a duplicate key"))
    skip_whitespace(scanner)
    if peek(scanner) != 58:
        return Err(fail(scanner, "expected ':' after a JSON object key"))
    advance(scanner)
    fields[key] = read_value(scanner, depth + 1)?
    return Ok(True)


# One object body, with the opening brace under the cursor.
def read_object(scanner: Scanner, depth: int) -> Result[Json, str]:
    advance(scanner)
    fields: dict[str, Json] = {}
    skip_whitespace(scanner)
    if peek(scanner) == 125:
        advance(scanner)
        return Ok(object(fields))
    while not at_end(scanner):
        _ = read_member(scanner, fields, depth)?
        skip_whitespace(scanner)
        byte = peek(scanner)
        if byte == 125:
            advance(scanner)
            return Ok(object(fields))
        if byte != 44:
            return Err(fail(scanner, "expected ',' or '}' in JSON object"))
        advance(scanner)
    return Err(fail(scanner, "unterminated JSON object"))


# One value of any kind, bounded by the nesting limit.
def read_value(scanner: Scanner, depth: int) -> Result[Json, str]:
    if depth > max_depth():
        return Err(fail(scanner, "JSON nesting is deeper than the limit"))
    skip_whitespace(scanner)
    byte = peek(scanner)
    if byte == 123:
        return read_object(scanner, depth)
    if byte == 91:
        return read_array(scanner, depth)
    if byte == 34:
        return Ok(text(read_string(scanner)?))
    if byte == 116:
        return read_literal(scanner, b"true", boolean(True))
    if byte == 102:
        return read_literal(scanner, b"false", boolean(False))
    if byte == 110:
        return read_literal(scanner, b"null", null_value())
    if byte == 45 or is_digit_byte(byte):
        return read_number(scanner)
    if byte < 0:
        return Err(fail(scanner, "unexpected end of JSON input"))
    return Err(fail(scanner, "unexpected character in JSON input"))


# One complete RFC 8259 document, rejecting anything after the top-level value.
def loads(source: str) -> Result[Json, str]:
    scanner = scanner_of(source.encode())
    value = read_value(scanner, 1)?
    skip_whitespace(scanner)
    if not at_end(scanner):
        return Err(fail(scanner, "trailing characters after a JSON value"))
    return Ok(value)


# The thirty-two ASCII control characters, in code point order.
def controls() -> str:
    return "\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f"


# The control code of a character, or -1 when it needs no escape.
def control_code(character: str) -> int:
    for code, entry in enumerate(controls()):
        if entry == character:
            return code
    return 0 - 1


# The shortest escape RFC 8259 allows for one control code.
def escape_unit(code: int) -> str:
    if code == 8:
        return "\\b"
    if code == 9:
        return "\\t"
    if code == 10:
        return "\\n"
    if code == 12:
        return "\\f"
    if code == 13:
        return "\\r"
    table = "0123456789abcdef"
    return "\\u00" + table[code // 16] + table[code % 16]


# A string rendered with its quotes and the escapes RFC 8259 requires.
def quoted(body: str) -> str:
    out = "\""
    for character in body:
        if character == "\"":
            out = out + "\\\""
        elif character == "\\":
            out = out + "\\\\"
        else:
            code = control_code(character)
            if code < 0:
                out = out + character
            else:
                out = out + escape_unit(code)
    return out + "\""


# A binary64 number rendered as JSON; infinities and not-a-number become null.
def rendered_number(value: float) -> str:
    if value != value:
        return "null"
    if value > 1.7976931348623157e308 or value < 0.0 - 1.7976931348623157e308:
        return "null"
    return str(value)


# Append the compact rendering of one value to the accumulated pieces.
def write_value(pieces: list[str], value: Json):
    match value:
        case Json.null:
            pieces.append("null")
        case Json.boolean(flag):
            if flag:
                pieces.append("true")
            else:
                pieces.append("false")
        case Json.integer(count):
            pieces.append(str(count))
        case Json.number(amount):
            pieces.append(rendered_number(amount))
        case Json.text(body):
            pieces.append(quoted(body))
        case Json.array(items):
            write_array(pieces, items)
        case Json.object(fields):
            write_object(pieces, fields)
    return


# Append a rendered array, keeping element order.
def write_array(pieces: list[str], items: list[Json]):
    pieces.append("[")
    for index, item in enumerate(items):
        if index > 0:
            pieces.append(",")
        write_value(pieces, item)
    pieces.append("]")
    return


# Append a rendered object, keeping insertion order.
def write_object(pieces: list[str], fields: dict[str, Json]):
    pieces.append("{")
    first = True
    for key in fields:
        if not first:
            pieces.append(",")
        first = False
        pieces.append(quoted(key))
        pieces.append(":")
        write_value(pieces, fields[key])
    pieces.append("}")
    return


# A value rendered as compact RFC 8259 text without added whitespace.
def dumps(value: Json) -> str:
    pieces: list[str] = []
    write_value(pieces, value)
    return "".join(pieces)
