import math

# The ten decimal digits, in value order.
public func digits() -> str:
    return "0123456789"


# One rejected string operation, carrying the human-readable reason.
public enum Error:
    Invalid(value: str)
    Overflow(value: str)


# The human-readable reason carried by a rejected string operation.
public func message(error: Error) -> str:
    match error:
        case Error.Invalid(value=detail):
            return detail
        case Error.Overflow(value=detail):
            return detail


# The thirty-six digits used by bases up to 36, in value order.
func base_digits() -> str:
    return "0123456789abcdefghijklmnopqrstuvwxyz"


# The twenty-six lowercase ASCII letters followed by the uppercase ones.
public func letters() -> str:
    return "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"


# The ASCII characters treated as whitespace by this module.
public func whitespace() -> str:
    return " \t\n\r"


# Position of a single character inside a table, or -1 when it is absent.
func table_index(table: str, character: str) -> int:
    for index, entry in enumerate(table):
        if entry == character:
            return index
    return 0 - 1


# Whether every character belongs to a table, rejecting the empty text.
func all_in(table: str, text: str) -> bool:
    if len(text) == 0:
        return False
    for character in text:
        if table_index(table, character) < 0:
            return False
    return True


# Whether the text is nonempty and made only of decimal digits.
public func is_digit(text: str) -> bool effects():
    return text.isdigit()


# Whether the text is nonempty and made only of ASCII letters.
public func is_alpha(text: str) -> bool effects():
    return text.isalpha()


# Whether the text is nonempty and made only of ASCII letters and digits.
public func is_alnum(text: str) -> bool:
    return all_in(letters() + digits(), text)


# Whether the text is nonempty and made only of spaces, tabs and line breaks.
public func is_space(text: str) -> bool effects():
    return text.isspace()


# Whether the text begins with a prefix; every text starts with the empty one.
public func starts_with(text: str, prefix: str) -> bool effects():
    return text.startswith(prefix)


# Whether the text ends with a suffix; every text ends with the empty one.
public func ends_with(text: str, suffix: str) -> bool effects():
    return text.endswith(suffix)


# First position where a nonempty needle occurs, searching from the front.
public func find(text: str, needle: str) -> int? effects():
    mut position = text.find(needle)
    if position < 0:
        return None
    return Some(position)


# Number of nonoverlapping occurrences of a nonempty needle.
public func count(text: str, needle: str) -> int effects():
    if len(needle) == 0:
        return 0
    return text.count(needle)


# Text without leading whitespace.
public func lstrip(text: str) -> str:
    return text.lstrip()


# Text without trailing whitespace.
public func rstrip(text: str) -> str:
    return text.rstrip()


# Text without leading or trailing whitespace.
public func strip(text: str) -> str:
    return text.strip()


# Text split on line feeds, with one trailing carriage return removed per line.
public func lines(text: str) -> str[]:
    mut out: str[] = []
    if len(text) == 0:
        return out
    for piece in text.split("\n"):
        if piece.endswith("\r"):
            out.append(piece[0:len(piece) - 1])
        else:
            out.append(piece)
    return out


# Text repeated a nonnegative number of times. The copies double: `out` holds
# `copies` copies and is appended to itself while that stays within `times`, and
# one prefix of it tops up the rest, so building the answer copies each octet
# of it at most three times instead of copying the growing answer once per copy.
public func repeat(text: str, times: int) -> Result[str, Error]:
    if times < 0:
        return Err(Error.Invalid(value="repeat count must not be negative"))
    if times == 0 or len(text) == 0:
        return Ok("")
    mut out = text
    mut copies = 1
    while copies <= times - copies:
        out = out + out
        copies = copies * 2
    if copies < times:
        out = out + out[:len(text) * (times - copies)]
    return Ok(out)


# Text padded on the left with a single fill character up to a width.
public func pad_left(text: str, width: int, fill: str) -> Result[str, Error]:
    if len(fill) != 1:
        return Err(Error.Invalid(value="pad fill must be exactly one character"))
    if len(text) >= width:
        return Ok(text)
    const padding = try repeat(fill, width - len(text))
    return Ok(padding + text)


# Text padded on the right with a single fill character up to a width.
public func pad_right(text: str, width: int, fill: str) -> Result[str, Error]:
    if len(fill) != 1:
        return Err(Error.Invalid(value="pad fill must be exactly one character"))
    if len(text) >= width:
        return Ok(text)
    const padding = try repeat(fill, width - len(text))
    return Ok(text + padding)


# Text with ASCII lowercase letters replaced by their uppercase forms.
public func upper(text: str) -> str:
    return text.upper()


# Text with ASCII uppercase letters replaced by their lowercase forms.
public func lower(text: str) -> str:
    return text.lower()


# Every nonoverlapping occurrence of a nonempty needle replaced by a substitute.
public func substitute(text: str, needle: str, insertion: str) -> Result[str, Error]:
    if len(needle) == 0:
        return Err(Error.Invalid(value="replacement needle must not be empty"))
    return Ok(text.replace(needle, insertion))


# Signed decimal text converted to an integer, rejecting overflow and junk.
public func to_int(text: str) -> int?:
    return parse_int(text)


# Text converted through the pinned float grammar shared with byte parsing.
public func to_float(text: str) -> float?:
    return parse_float(text)


# Integer rendered in a base between 2 and 36 using lowercase digits.
public func format_int(value: int, base: int) -> Result[str, Error]:
    if base < 2 or base > 36:
        return Err(Error.Invalid(value="integer base must be between 2 and 36"))
    if value == 0:
        return Ok("0")
    mut magnitude = 0u64
    if value < 0:
        magnitude = u64(0 - (value + 1)) + 1u64
    else:
        magnitude = u64(value)
    mut radix = u64(base)
    mut out = ""
    while magnitude > 0u64:
        out = base_digits()[i64(magnitude % radix)] + out
        magnitude = magnitude // radix
    if value < 0:
        return Ok("-" + out)
    return Ok(out)


# The exact rounding error of `a * b`, whose rounded value is `product`: Dekker's
# two-product over Veltkamp halves, exact while no partial product overflows.
func product_error(a: float, b: float, product: float) -> float:
    mut a_split = 134217729.0 * a
    mut a_high = a_split - (a_split - a)
    mut a_low = a - a_high
    mut b_split = 134217729.0 * b
    mut b_high = b_split - (b_split - b)
    mut b_low = b - b_high
    return ((a_high * b_high - product) + a_high * b_low + a_low * b_high) + a_low * b_low


# Float rendered with a fixed number of decimals, rounding the exact binary value and
# sending exact halves away from zero.
public func format_float(value: float, decimals: int) -> Result[str, Error]:
    if decimals < 0 or decimals > 17:
        return Err(Error.Invalid(value="decimal count must be between 0 and 17"))
    if math.is_nan(value):
        return Ok("nan")
    if math.is_inf(value):
        if value < 0.0:
            return Ok("-inf")
        return Ok("inf")
    mut magnitude = math.fabs(value)
    mut scale = math.pow(10.0, decimals)
    mut product = magnitude * scale
    mut shifted = math.round(product)
    if shifted >= 9223372036854775808.0:
        return Err(Error.Overflow(value="value is too large to render with fixed decimals"))
    # A product that rounded onto an exact half (2.675 * 100.0 == 267.5) is only a tie
    # if the unrounded product is one; below it, the value rounds toward zero.
    if shifted - product == 0.5 and product_error(magnitude, scale, product) < 0.0:
        shifted = shifted - 1.0
    mut scaled = int(shifted)
    mut body = try format_int(scaled, 10)
    if decimals == 0:
        if value < 0.0 and scaled != 0:
            return Ok("-" + body)
        return Ok(body)
    body = try pad_left(body, decimals + 1, "0")
    mut whole = body[0:len(body) - decimals]
    mut fraction = body[len(body) - decimals:len(body)]
    if value < 0.0 and scaled != 0:
        return Ok("-" + whole + "." + fraction)
    return Ok(whole + "." + fraction)


# Unicode scalar value of a single-character text, or `Err` for any other length.
public func ord(text: str) -> Result[int, Error]:
    if len(text) != 1:
        return Err(Error.Invalid(value="ord requires exactly one character"))
    mut encoded = text.encode()
    mut first = encoded[0]
    if first < 128:
        return Ok(first)
    const width = if first < 224 then 2 else if first < 240 then 3 else 4
    const mask = if first < 224 then 31 else if first < 240 then 15 else 7
    if len(encoded) != width:
        return Err(Error.Invalid(value="ord requires exactly one character"))
    mut value = bit_and(first, mask)
    mut index = 1
    while index < width:
        value = value * 64 + bit_and(encoded[index], 63)
        index = index + 1
    return Ok(value)


# One-character text for a Unicode scalar value. Surrogates and code points past
# `0x10FFFF` are rejected rather than encoded as replacement bytes.
public func chr(code: int) -> Result[str, Error]:
    if code < 0:
        return Err(Error.Invalid(value="chr requires a non-negative code point"))
    if code > 1114111:
        return Err(Error.Overflow(value="chr requires a code point at most 0x10FFFF"))
    if code >= 55296 and code <= 57343:
        return Err(Error.Invalid(value="chr rejects surrogate code points"))
    mut values: int[] = []
    if code < 128:
        values.append(code)
    elif code < 2048:
        values.append(192 + code // 64)
        values.append(128 + code % 64)
    elif code < 65536:
        values.append(224 + code // 4096)
        values.append(128 + (code // 64) % 64)
        values.append(128 + code % 64)
    else:
        values.append(240 + code // 262144)
        values.append(128 + (code // 4096) % 64)
        values.append(128 + (code // 64) % 64)
        values.append(128 + code % 64)
    match bytes(values).decode():
        case Ok(text):
            return Ok(text)
        case Err(_):
            return Err(Error.Invalid(value="chr could not encode the code point"))
