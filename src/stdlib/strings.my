module strings
import math


# The ten decimal digits, in value order.
public def digits() -> str effects(managed_allocation):
    return "0123456789"


# One rejected string operation, carrying the human-readable reason.
public union Error:
    Invalid: str,
    Overflow: str


# The human-readable reason carried by a rejected string operation.
public def message(error: Error) -> str:
    match error:
        case Error.Invalid(detail):
            return detail
        case Error.Overflow(detail):
            return detail


# The thirty-six digits used by bases up to 36, in value order.
def base_digits() -> str:
    return "0123456789abcdefghijklmnopqrstuvwxyz"


# The twenty-six lowercase ASCII letters followed by the uppercase ones.
public def letters() -> str effects(managed_allocation):
    return "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"


# The ASCII characters treated as whitespace by this module.
public def whitespace() -> str effects(managed_allocation):
    return " \t\n\r"


# Position of a single character inside a table, or -1 when it is absent.
def table_index(table: str, character: str) -> int:
    for index, entry in enumerate(table):
        if entry == character:
            return index
    return 0 - 1


# Whether every character belongs to a table, rejecting the empty text.
def all_in(table: str, text: str) -> bool:
    if len(text) == 0:
        return False
    for character in text:
        if table_index(table, character) < 0:
            return False
    return True


# Whether the text is nonempty and made only of decimal digits.
public def is_digit(text: str) -> bool effects():
    return text.isdigit()


# Whether the text is nonempty and made only of ASCII letters.
public def is_alpha(text: str) -> bool effects():
    return text.isalpha()


# Whether the text is nonempty and made only of ASCII letters and digits.
public def is_alnum(text: str) -> bool effects(managed_allocation):
    return all_in(letters() + digits(), text)


# Whether the text is nonempty and made only of spaces, tabs and line breaks.
public def is_space(text: str) -> bool effects():
    return text.isspace()


# Whether the text begins with a prefix; every text starts with the empty one.
public def starts_with(text: str, prefix: str) -> bool effects():
    return text.startswith(prefix)


# Whether the text ends with a suffix; every text ends with the empty one.
public def ends_with(text: str, suffix: str) -> bool effects():
    return text.endswith(suffix)


# First position where a nonempty needle occurs, searching from the front.
public def find(text: str, needle: str) -> Option[int] effects():
    position = text.find(needle)
    if position < 0:
        return None
    return Some(position)


# Number of nonoverlapping occurrences of a nonempty needle.
public def count(text: str, needle: str) -> int effects():
    if len(needle) == 0:
        return 0
    return text.count(needle)


# Text without leading whitespace.
public def lstrip(text: str) -> str effects(managed_allocation):
    return text.lstrip()


# Text without trailing whitespace.
public def rstrip(text: str) -> str effects(managed_allocation):
    return text.rstrip()


# Text without leading or trailing whitespace.
public def strip(text: str) -> str effects(managed_allocation):
    return text.strip()


# Text split on line feeds, with one trailing carriage return removed per line.
public def lines(text: str) -> list[str] effects(managed_allocation):
    out: list[str] = []
    if len(text) == 0:
        return out
    for piece in text.split("\n"):
        if piece.endswith("\r"):
            out.append(piece[0:len(piece) - 1])
        else:
            out.append(piece)
    return out


# Text repeated a nonnegative number of times.
public def repeat(text: str, times: int) -> Result[str, Error] effects(managed_allocation):
    if times < 0:
        return Err(Error.Invalid("repeat count must not be negative"))
    out = ""
    remaining = times
    while remaining > 0:
        out = out + text
        remaining -= 1
    return Ok(out)


# Text padded on the left with a single fill character up to a width.
public def pad_left(text: str, width: int, fill: str) -> Result[str, Error] effects(managed_allocation):
    if len(fill) != 1:
        return Err(Error.Invalid("pad fill must be exactly one character"))
    if len(text) >= width:
        return Ok(text)
    return Ok(repeat(fill, width - len(text))? + text)


# Text padded on the right with a single fill character up to a width.
public def pad_right(text: str, width: int, fill: str) -> Result[str, Error] effects(managed_allocation):
    if len(fill) != 1:
        return Err(Error.Invalid("pad fill must be exactly one character"))
    if len(text) >= width:
        return Ok(text)
    return Ok(text + repeat(fill, width - len(text))?)


# Text with ASCII lowercase letters replaced by their uppercase forms.
public def upper(text: str) -> str effects(managed_allocation):
    return text.upper()


# Text with ASCII uppercase letters replaced by their lowercase forms.
public def lower(text: str) -> str effects(managed_allocation):
    return text.lower()


# Every nonoverlapping occurrence of a nonempty needle replaced by a substitute.
public def substitute(text: str, needle: str, insertion: str) -> Result[str, Error] effects(managed_allocation):
    if len(needle) == 0:
        return Err(Error.Invalid("replacement needle must not be empty"))
    return Ok(text.replace(needle, insertion))


# Signed decimal text converted to an integer, rejecting overflow and junk.
public def to_int(text: str) -> Option[int] effects(managed_allocation):
    return int(text)


# Text converted through the pinned float grammar shared with byte parsing.
public def to_float(text: str) -> Option[float] effects(managed_allocation):
    return float(text)


# Integer rendered in a base between 2 and 36 using lowercase digits.
public def format_int(value: int, base: int) -> Result[str, Error] effects(managed_allocation):
    if base < 2 or base > 36:
        return Err(Error.Invalid("integer base must be between 2 and 36"))
    if value == 0:
        return Ok("0")
    magnitude = 0u64
    if value < 0:
        magnitude = u64(0 - (value + 1)) + 1u64
    else:
        magnitude = u64(value)
    radix = u64(base)
    out = ""
    while magnitude > 0u64:
        out = base_digits()[i64(magnitude % radix)] + out
        magnitude = magnitude // radix
    if value < 0:
        return Ok("-" + out)
    return Ok(out)


# Float rendered with a fixed number of decimals, rounding halves away from zero.
public def format_float(value: float, decimals: int) -> Result[str, Error] effects(managed_allocation):
    if decimals < 0 or decimals > 17:
        return Err(Error.Invalid("decimal count must be between 0 and 17"))
    if math.is_nan(value):
        return Ok("nan")
    if math.is_inf(value):
        if value < 0.0:
            return Ok("-inf")
        return Ok("inf")
    magnitude = math.fabs(value)
    shifted = math.round(magnitude * math.pow(10.0, decimals))
    if shifted >= 9223372036854775808.0:
        return Err(Error.Overflow("value is too large to render with fixed decimals"))
    scaled = int(shifted)
    body = format_int(scaled, 10)?
    if decimals == 0:
        if value < 0.0 and scaled != 0:
            return Ok("-" + body)
        return Ok(body)
    body = pad_left(body, decimals + 1, "0")?
    whole = body[0:len(body) - decimals]
    fraction = body[len(body) - decimals:len(body)]
    if value < 0.0 and scaled != 0:
        return Ok("-" + whole + "." + fraction)
    return Ok(whole + "." + fraction)


# Unicode scalar value of a single-character text, or `Err` for any other length.
public def ord(text: str) -> Result[int, Error] effects(managed_allocation):
    if len(text) != 1:
        return Err(Error.Invalid("ord requires exactly one character"))
    encoded = text.encode()
    first = encoded[0]
    if first < 128:
        return Ok(first)
    if first < 224:
        width = 2
        mask = 31
    elif first < 240:
        width = 3
        mask = 15
    else:
        width = 4
        mask = 7
    if len(encoded) != width:
        return Err(Error.Invalid("ord requires exactly one character"))
    value = bit_and(first, mask)
    index = 1
    while index < width:
        value = value * 64 + bit_and(encoded[index], 63)
        index = index + 1
    return Ok(value)


# One-character text for a Unicode scalar value. Surrogates and code points past
# `0x10FFFF` are rejected rather than encoded as replacement bytes.
public def chr(code: int) -> Result[str, Error] effects(managed_allocation):
    if code < 0:
        return Err(Error.Invalid("chr requires a non-negative code point"))
    if code > 1114111:
        return Err(Error.Overflow("chr requires a code point at most 0x10FFFF"))
    if code >= 55296 and code <= 57343:
        return Err(Error.Invalid("chr rejects surrogate code points"))
    values: list[int] = []
    if code < 128:
        values.append(code)
    elif code < 2048:
        values.append(192 + code // 64)
        values.append(128 + code % 64)
    elif code < 65536:
        values.append(224 + code // 4096)
        values.append(128 + (code // 64) % 64)
        values.append(128 + code % 64)
    else:
        values.append(240 + code // 262144)
        values.append(128 + (code // 4096) % 64)
        values.append(128 + (code // 64) % 64)
        values.append(128 + code % 64)
    match bytes(values).decode():
        case Ok(text):
            return Ok(text)
        case Err(_):
            return Err(Error.Invalid("chr could not encode the code point"))
