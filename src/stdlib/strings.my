module strings
import math
export digits
export letters
export whitespace
export is_digit
export is_alpha
export is_alnum
export is_space
export starts_with
export ends_with
export find
export count
export strip
export lstrip
export rstrip
export lines
export repeat
export pad_left
export pad_right
export upper
export lower
export substitute
export to_int
export to_float
export format_int
export format_float


# The ten decimal digits, in value order.
def digits() -> str:
    return "0123456789"


# The thirty-six digits used by bases up to 36, in value order.
def base_digits() -> str:
    return "0123456789abcdefghijklmnopqrstuvwxyz"


# The twenty-six lowercase ASCII letters followed by the uppercase ones.
def letters() -> str:
    return "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"


# The ASCII characters treated as whitespace by this module.
def whitespace() -> str:
    return " \t\n\r"


# Position of a single character inside a table, or -1 when it is absent.
def table_index(table: str, character: str) -> int:
    for index, entry in enumerate(table):
        if entry == character:
            return index
    return 0 - 1


# Whether every character belongs to a table, rejecting the empty text.
def all_in(table: str, text: str) -> bool:
    if len(text) == 0:
        return False
    for character in text:
        if table_index(table, character) < 0:
            return False
    return True


# Whether the text is nonempty and made only of decimal digits.
def is_digit(text: str) -> bool:
    return all_in(digits(), text)


# Whether the text is nonempty and made only of ASCII letters.
def is_alpha(text: str) -> bool:
    return all_in(letters(), text)


# Whether the text is nonempty and made only of ASCII letters and digits.
def is_alnum(text: str) -> bool:
    return all_in(letters() + digits(), text)


# Whether the text is nonempty and made only of spaces, tabs and line breaks.
def is_space(text: str) -> bool:
    return all_in(whitespace(), text)


# Whether the text begins with a prefix; every text starts with the empty one.
def starts_with(text: str, prefix: str) -> bool:
    if len(prefix) > len(text):
        return False
    return text[0:len(prefix)] == prefix


# Whether the text ends with a suffix; every text ends with the empty one.
def ends_with(text: str, suffix: str) -> bool:
    if len(suffix) > len(text):
        return False
    return text[len(text) - len(suffix):len(text)] == suffix


# First position where a nonempty needle occurs, searching from the front.
def find(text: str, needle: str) -> Option[int]:
    if len(needle) == 0:
        return Some(0)
    if len(needle) > len(text):
        return None
    start = 0
    while start + len(needle) <= len(text):
        if text[start:start + len(needle)] == needle:
            return Some(start)
        start += 1
    return None


# Number of nonoverlapping occurrences of a nonempty needle.
def count(text: str, needle: str) -> int:
    if len(needle) == 0:
        return 0
    total = 0
    start = 0
    while start + len(needle) <= len(text):
        if text[start:start + len(needle)] == needle:
            total += 1
            start += len(needle)
        else:
            start += 1
    return total


# Text without leading whitespace.
def lstrip(text: str) -> str:
    start = 0
    while start < len(text) and table_index(whitespace(), text[start]) >= 0:
        start += 1
    return text[start:len(text)]


# Text without trailing whitespace.
def rstrip(text: str) -> str:
    end = len(text)
    while end > 0 and table_index(whitespace(), text[end - 1]) >= 0:
        end -= 1
    return text[0:end]


# Text without leading or trailing whitespace.
def strip(text: str) -> str:
    return rstrip(lstrip(text))


# Text split on line feeds, with one trailing carriage return removed per line.
def lines(text: str) -> list[str]:
    out: list[str] = []
    if len(text) == 0:
        return out
    for piece in text.split("\n"):
        if ends_with(piece, "\r"):
            out.append(piece[0:len(piece) - 1])
        else:
            out.append(piece)
    return out


# Text repeated a nonnegative number of times.
def repeat(text: str, times: int) -> Result[str, str]:
    if times < 0:
        return Err("repeat count must not be negative")
    out = ""
    remaining = times
    while remaining > 0:
        out = out + text
        remaining -= 1
    return Ok(out)


# Text padded on the left with a single fill character up to a width.
def pad_left(text: str, width: int, fill: str) -> Result[str, str]:
    if len(fill) != 1:
        return Err("pad fill must be exactly one character")
    if len(text) >= width:
        return Ok(text)
    return Ok(repeat(fill, width - len(text))? + text)


# Text padded on the right with a single fill character up to a width.
def pad_right(text: str, width: int, fill: str) -> Result[str, str]:
    if len(fill) != 1:
        return Err("pad fill must be exactly one character")
    if len(text) >= width:
        return Ok(text)
    return Ok(text + repeat(fill, width - len(text))?)


# Text with ASCII lowercase letters replaced by their uppercase forms.
def upper(text: str) -> str:
    out = ""
    for character in text:
        position = table_index(letters()[0:26], character)
        if position < 0:
            out = out + character
        else:
            out = out + letters()[26 + position]
    return out


# Text with ASCII uppercase letters replaced by their lowercase forms.
def lower(text: str) -> str:
    out = ""
    for character in text:
        position = table_index(letters()[26:52], character)
        if position < 0:
            out = out + character
        else:
            out = out + letters()[position]
    return out


# Every nonoverlapping occurrence of a nonempty needle replaced by a substitute.
def substitute(text: str, needle: str, insertion: str) -> Result[str, str]:
    if len(needle) == 0:
        return Err("replacement needle must not be empty")
    return Ok(insertion.join(text.split(needle)))


# Signed decimal text converted to an integer, rejecting overflow and junk.
def to_int(text: str) -> Option[int]:
    if len(text) == 0:
        return None
    start = 0
    negative = False
    if text[0] == "+" or text[0] == "-":
        negative = text[0] == "-"
        start = 1
    if start >= len(text):
        return None
    total = 0
    index = start
    while index < len(text):
        digit = table_index(digits(), text[index])
        if digit < 0:
            return None
        if total < 0 - 922337203685477580:
            return None
        total = total * 10
        if total < 0 - 9223372036854775807 - 1 + digit:
            return None
        total = total - digit
        index += 1
    if negative:
        return Some(total)
    if total == 0 - 9223372036854775807 - 1:
        return None
    return Some(0 - total)


# Largest mantissa that can still take another decimal digit without overflow.
def mantissa_ceiling() -> int:
    return 922337203685477580


# A decimal mantissa and its power-of-ten scale, combined with one rounding.
def combined(mantissa: int, scale: int) -> float:
    if mantissa == 0:
        return 0.0
    magnitude = scale
    if magnitude < 0:
        magnitude = 0 - magnitude
    power = math.pow(10.0, magnitude)
    if scale < 0:
        return float(mantissa) / power
    return float(mantissa) * power


# Decimal text with an optional fraction and exponent converted to a float.
def to_float(text: str) -> Option[float]:
    if len(text) == 0:
        return None
    start = 0
    negative = False
    if text[0] == "+" or text[0] == "-":
        negative = text[0] == "-"
        start = 1
    mantissa = 0
    seen = 0
    scale = 0
    index = start
    while index < len(text) and table_index(digits(), text[index]) >= 0:
        if mantissa < mantissa_ceiling():
            mantissa = mantissa * 10 + table_index(digits(), text[index])
        else:
            scale += 1
        seen += 1
        index += 1
    if index < len(text) and text[index] == ".":
        index += 1
        while index < len(text) and table_index(digits(), text[index]) >= 0:
            if mantissa < mantissa_ceiling():
                mantissa = mantissa * 10 + table_index(digits(), text[index])
                scale -= 1
            seen += 1
            index += 1
    if seen == 0:
        return None
    if index < len(text) and (text[index] == "e" or text[index] == "E"):
        index += 1
        exponent_negative = False
        if index < len(text) and (text[index] == "+" or text[index] == "-"):
            exponent_negative = text[index] == "-"
            index += 1
        exponent_digits = 0
        exponent = 0
        while index < len(text) and table_index(digits(), text[index]) >= 0:
            if exponent < 100000:
                exponent = exponent * 10 + table_index(digits(), text[index])
            exponent_digits += 1
            index += 1
        if exponent_digits == 0:
            return None
        if exponent_negative:
            scale -= exponent
        else:
            scale += exponent
    if index != len(text):
        return None
    value = combined(mantissa, scale)
    if negative:
        return Some(0.0 - value)
    return Some(value)


# Integer rendered in a base between 2 and 36 using lowercase digits.
def format_int(value: int, base: int) -> Result[str, str]:
    if base < 2 or base > 36:
        return Err("integer base must be between 2 and 36")
    if value == 0:
        return Ok("0")
    magnitude = 0u64
    if value < 0:
        magnitude = cast<u64>(0 - (value + 1)) + 1u64
    else:
        magnitude = cast<u64>(value)
    radix = cast<u64>(base)
    out = ""
    while magnitude > 0u64:
        out = base_digits()[cast<i64>(magnitude % radix)] + out
        magnitude = magnitude // radix
    if value < 0:
        return Ok("-" + out)
    return Ok(out)


# Float rendered with a fixed number of decimals, rounding halves away from zero.
def format_float(value: float, decimals: int) -> Result[str, str]:
    if decimals < 0 or decimals > 17:
        return Err("decimal count must be between 0 and 17")
    if math.is_nan(value):
        return Ok("nan")
    if math.is_inf(value):
        if value < 0.0:
            return Ok("-inf")
        return Ok("inf")
    magnitude = math.fabs(value)
    shifted = math.round(magnitude * math.pow(10.0, decimals))
    if shifted >= 9223372036854775808.0:
        return Err("value is too large to render with fixed decimals")
    scaled = int(shifted)
    body = format_int(scaled, 10)?
    if decimals == 0:
        if value < 0.0 and scaled != 0:
            return Ok("-" + body)
        return Ok(body)
    body = pad_left(body, decimals + 1, "0")?
    whole = body[0:len(body) - decimals]
    fraction = body[len(body) - decimals:len(body)]
    if value < 0.0 and scaled != 0:
        return Ok("-" + whole + "." + fraction)
    return Ok(whole + "." + fraction)
