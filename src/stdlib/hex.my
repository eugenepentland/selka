module hex
import strings
export encode
export encode_upper
export decode
export is_hex


# Lowercase hexadecimal text for a byte string, two digits per octet.
def encode(data: bytes) -> str effects(managed_allocation):
    return data.hex()


# Uppercase hexadecimal text for a byte string, two digits per octet.
def encode_upper(data: bytes) -> str effects(managed_allocation):
    return strings.upper(data.hex())


# Bytes for even-length hexadecimal text, accepting either letter case.
def decode(text: str) -> Result[bytes, str] effects(managed_allocation):
    return bytes.fromhex(text)


# Whether text is even-length hexadecimal that decode would accept.
def is_hex(text: str) -> bool effects(managed_allocation):
    match bytes.fromhex(text):
        case Ok(_):
            return True
        case Err(_):
            return False
