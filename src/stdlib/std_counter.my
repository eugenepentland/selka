module std_counter;
import std_hash_bytes as h;
import std_map as m;
export Status;
export add_bytes;
export get_bytes;
enum Status {
    ok,
    full,
    invalid,
    overflow
}
fn get_bytes(counts: &h::Map<u64>, key: h::Key) -> u64 noalloc {
    match h::lookup::< u64 >(counts, key) {
        m::Value<u64>.none => {
            return 0u64;
        },
        m::Value<u64>.some(value) => {
            return value;
        }
    }
}
fn add_bytes(counts: &mut h::Map<u64>, key: h::Key, amount: u64) -> Status noalloc {
    if !h::valid(key) {
        return new Status.invalid;
    }
    let old = get_bytes(counts, key);
    if amount > 18446744073709551615u64 - old {
        return new Status.overflow;
    }
    match h::put::< u64 >(counts, key, old + amount) {
        h::PutStatus.inserted => {
            return new Status.ok;
        },
        h::PutStatus.replaced => {
            return new Status.ok;
        },
        h::PutStatus.full => {
            return new Status.full;
        },
        h::PutStatus.invalid => {
            return new Status.invalid;
        }
    }
}
