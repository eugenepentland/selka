module std_order;
export Item;
export valid;
export compare;
export sort;
export heap_push;
export heap_pop;
export Pop;
export lower_bound;
export equal_run_end;
struct Item {
    value: i64,
    first: u64,
    first_len: u64,
    second: u64,
    second_len: u64
}
struct Pop {
    found: bool,
    count: u64,
    value: Item
}
fn swap(values: &mut []Item, a: u64, b: u64) -> bool {
    let value = read_slice(values, a);
    write_slice(values, a, read_slice(values, b));
    write_slice(values, b, value);
    return true;
}
fn sift(values: &mut []Item, base: u64, count: u64, root: u64, keys: &[]i64) -> bool {
    let mut at = root;
    while at < count / 2u64 {
        let mut child = at * 2u64 + 1u64;
        if child + 1u64 < count && less(keys, read_slice(values, base + child), read_slice(values, base + child + 1u64)) {
            child += 1u64;
        }
        if !less(keys, read_slice(values, base + at), read_slice(values, base + child)) {
            break;
        }
        discard swap(values, base + at, base + child);
        at = child;
    }
    return true;
}
fn sort(keys: &[]i64, values: &mut []Item, base: u64, count: u64) -> bool {
    if base > len_slice(values) {
        return false;
    }
    if count > len_slice(values) - base {
        return false;
    }
    let mut check = 0u64;
    while check < count {
        if !valid(keys, read_slice(values, base + check)) {
            return false;
        }
        check += 1u64;
    }
    let mut at = count / 2u64;
    while at > 0u64 {
        at -= 1u64;
        discard sift(values, base, count, at, keys);
    }
    at = count;
    while at > 1u64 {
        at -= 1u64;
        discard swap(values, base, base + at);
        discard sift(values, base, at, 0u64, keys);
    }
    return true;
}
fn heap_push(keys: &[]i64, values: &mut []Item, count: u64, value: Item) -> bool {
    if count >= len_slice(values) || !valid(keys, value) {
        return false;
    }
    write_slice(values, count, value);
    let mut at = count;
    while at > 0u64 {
        let parent =(at - 1u64) / 2u64;
        if !less(keys, read_slice(values, at), read_slice(values, parent)) {
            break;
        }
        discard swap(values, at, parent);
        at = parent;
    }
    return true;
}
fn heap_pop(keys: &[]i64, values: &mut []Item, count: u64, fallback: Item) -> Pop {
    if count == 0u64 || count > len_slice(values) {
        return new Pop {
            found: false,
            count: count,
            value: fallback
        };
    }
    let value = read_slice(values, 0u64);
    let size = count - 1u64;
    if size > 0u64 {
        write_slice(values, 0u64, read_slice(values, size));
    }
    let mut at = 0u64;
    while at < size / 2u64 {
        let mut child = at * 2u64 + 1u64;
        if child + 1u64 < size && less(keys, read_slice(values, child + 1u64), read_slice(values, child)) {
            child += 1u64;
        }
        if !less(keys, read_slice(values, child), read_slice(values, at)) {
            break;
        }
        discard swap(values, at, child);
        at = child;
    }
    return new Pop {
        found: true,
        count: size,
        value: value
    };
}
fn lower_bound(keys: &[]i64, values: &[]Item, base: u64, count: u64, needle: Item) -> u64 {
    if base > len_slice(values) {
        return len_slice(values);
    }
    if count > len_slice(values) - base {
        return len_slice(values);
    }
    let mut left = 0u64;
    let mut right = count;
    while left < right {
        let middle = left +(right - left) / 2u64;
        if less(keys, read_slice(values, base + middle), needle) {
            left = middle + 1u64;
        } else {
            right = middle;
        }
    }
    return base + left;
}
fn range_valid(text: &[]i64, start: u64, count: u64) -> bool noalloc {
    if start > len_slice(text) {
        return false;
    }
    return count <= len_slice(text) - start;
}
fn valid(text: &[]i64, item: Item) -> bool noalloc {
    return range_valid(text, item.first, item.first_len) && range_valid(text, item.second, item.second_len);
}
fn range_compare(text: &[]i64, a: u64, an: u64, b: u64, bn: u64) -> i64 noalloc {
    let mut i = 0u64;
    while i < an && i < bn {
        let left = read_slice(text, a + i);
        let right = read_slice(text, b + i);
        if left < right {
            return - 1;
        }
        if left > right {
            return 1;
        }
        i += 1u64;
    }
    if an < bn {
        return - 1;
    }
    if an > bn {
        return 1;
    }
    return 0;
}
fn compare(text: &[]i64, left: Item, right: Item) -> i64 noalloc {
    if !valid(text, left) || !valid(text, right) {
        return 0;
    }
    let first = range_compare(text, left.first, left.first_len, right.first, right.first_len);
    if first != 0 {
        return first;
    }
    return range_compare(text, left.second, left.second_len, right.second, right.second_len);
}
fn less(text: &[]i64, left: Item, right: Item) -> bool noalloc {
    return compare(text, left, right) < 0;
}
fn equal_run_end(keys: &[]i64, values: &[]Item, start: u64, end: u64) -> u64 noalloc {
    if start >= end || end > len_slice(values) {
        return start;
    }
    let value = read_slice(values, start);
    if !valid(keys, value) {
        return start;
    }
    let mut at = start + 1u64;
    while at < end {
        let next = read_slice(values, at);
        if !valid(keys, next) || compare(keys, value, next) != 0 {
            break;
        }
        at += 1u64;
    }
    return at;
}
