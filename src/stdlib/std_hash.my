module std_hash;
export bytes;
export integer;
fn bytes(input: &[]u8) -> u64 noalloc {
    let mut hash = 14695981039346656037u64;
    let mut i = 0u64;
    while i < len_slice(input) {
        hash = wrapping_mul(bit_xor(hash, cast<u64>(read_slice(input, i))), 1099511628211u64);
        i += 1u64;
    }
    return hash;
}
fn integer(value: u64) -> u64 noalloc {
    let mut x = value;
    x = wrapping_mul(bit_xor(x, shift_right(x, 30u64)), 13787848793156543929u64);
    x = wrapping_mul(bit_xor(x, shift_right(x, 27u64)), 10723151780598845931u64);
    return bit_xor(x, shift_right(x, 31u64));
}
