// Byte-oriented text operations; ranges borrow no storage.
module std_strings;
import std_bytes;
import std_result;
export Range;
export pad_right;
export join;
export Split;
export starts_with;
export ends_with;
export trim;
export split_next;
export replace_all;
export unsigned;
export signed;
export push;
export append_range;
struct Range {
    start: u64,
    end: u64
}
struct Split {
    part: Range,
    next: u64,
    done: bool
}
fn starts_with(text: &[]u8, prefix: &[]u8) -> bool {
    if len_slice(prefix) > len_slice(text) {
        return false;
    }
    let mut i = 0u64;
    while i < len_slice(prefix) {
        if read_slice(text, i) != read_slice(prefix, i) {
            return false;
        }
        i += 1u64;
    }
    return true;
}
fn ends_with(text: &[]u8, suffix: &[]u8) -> bool {
    if len_slice(suffix) > len_slice(text) {
        return false;
    }
    let start = len_slice(text) - len_slice(suffix);
    let mut i = 0u64;
    while i < len_slice(suffix) {
        if read_slice(text, start + i) != read_slice(suffix, i) {
            return false;
        }
        i += 1u64;
    }
    return true;
}
fn space(byte: u8) -> bool {
    return byte == 32u8 ||(byte >= 9u8 && byte <= 13u8);
}
fn trim(text: &[]u8) -> Range {
    let mut a = 0u64;
    let mut b = len_slice(text);
    while a < b && space(read_slice(text, a)) {
        a += 1u64;
    }
    while b > a && space(read_slice(text, b - 1u64)) {
        b -= 1u64;
    }
    return new Range {
        start: a,
        end: b
    };
}
// Start at zero, stop after done. Empty fields, including a trailing field, are retained.
fn split_next(text: &[]u8, delimiter: u8, start: u64) -> std_result::Result<Split, std_result::Error> {
    if start > len_slice(text) {
        return new std_result::Result<Split, std_result::Error>.err(new std_result::Error {
            category: new std_result::Category.bounds,
            code: 1
        });
    }
    let mut i = start;
    while i < len_slice(text) {
        if read_slice(text, i) == delimiter {
            return new std_result::Result<Split, std_result::Error>.ok(new Split {
                part: new Range {
                    start: start,
                    end: i
                },
                next: i + 1u64,
                done: false
            });
        }
        i += 1u64;
    }
    return new std_result::Result<Split, std_result::Error>.ok(new Split {
        part: new Range {
            start: start,
            end: i
        },
        next: i,
        done: true
    });
}
result Status {
    ok: bool,
    err: i64
}
fn push(input: std_bytes::Bytes, byte: u8) -> std_bytes::Built {
    let mut bytes = input;
    match append_buffer<Status>(bytes, byte) {
        Status.err(code) => {
            return new std_bytes::Built.err(std_result::allocation_error(code));
        },
        Status.ok(discard) => {
            return new std_bytes::Built.ok(bytes);
        }
    }
}
fn append_range(input: std_bytes::Bytes, text: &[]u8, range: Range) -> std_bytes::Built {
    if range.start > range.end || range.end > len_slice(text) {
        return new std_bytes::Built.err(new std_result::Error {
            category: new std_result::Category.bounds,
            code: 1
        });
    }
    let mut bytes = input;
    let mut i = range.start;
    while i < range.end {
        bytes = try push(bytes, read_slice(text, i));
        i += 1u64;
    }
    return new std_bytes::Built.ok(bytes);
}
fn replace_all(heap: allocator, text: &[]u8, needle: &[]u8, replacement: &[]u8, limit: i64) -> std_bytes::Built {
    if len_slice(needle) == 0u64 {
        return new std_bytes::Built.err(new std_result::Error {
            category: new std_result::Category.malformed,
            code: 1
        });
    }
    let mut bytes = try std_bytes::create(heap, limit);
    let mut i = 0u64;
    while i < len_slice(text) {
        let mut same = len_slice(needle) <= len_slice(text) - i;
        let mut j = 0u64;
        while same && j < len_slice(needle) {
            same = read_slice(text, i + j) == read_slice(needle, j);
            j += 1u64;
        }
        if same {
            bytes = try std_bytes::append(bytes, replacement);
            i += len_slice(needle);
        } else {
            bytes = try push(bytes, read_slice(text, i));
            i += 1u64;
        }
    }
    return new std_bytes::Built.ok(bytes);
}
fn digit(n: u64) -> u8 {
    if n < 10u64 {
        return cast<u8>(48u64 + n);
    }
    return cast<u8>(87u64 + n);
}
fn digits(input: std_bytes::Bytes, value: u64, base: u64) -> std_bytes::Built {
    let mut bytes = input;
    if value >= base {
        bytes = try digits(bytes, value / base, base);
    }
    return push(bytes, digit(value % base));
}
fn unsigned(heap: allocator, value: u64, base: u64, limit: i64) -> std_bytes::Built {
    if base < 2u64 || base > 36u64 {
        return new std_bytes::Built.err(new std_result::Error {
            category: new std_result::Category.malformed,
            code: 1
        });
    }
    return digits(try std_bytes::create(heap, limit), value, base);
}
fn signed(heap: allocator, value: i64, base: u64, limit: i64) -> std_bytes::Built {
    if base < 2u64 || base > 36u64 {
        return new std_bytes::Built.err(new std_result::Error {
            category: new std_result::Category.malformed,
            code: 1
        });
    }
    let mut bytes = try std_bytes::create(heap, limit);
    if value < 0 {
        bytes = try push(bytes, 45u8);
        return digits(bytes, cast<u64>(-(value + 1)) + 1u64, base);
    }
    return digits(bytes, cast<u64>(value), base);
}
// Width is bytes, never Unicode display columns; a shorter width never truncates.
fn pad_right(heap: allocator, text: &[]u8, width: u64, fill: u8, limit: u64) -> std_bytes::Built {
    let mut size = len_slice(text);
    if width > size {
        size = width;
    }
    if size > limit || size > 9223372036854775807u64 {
        return new std_bytes::Built.err(new std_result::Error {
            category: new std_result::Category.bounds,
            code: 1
        });
    }
    let mut bytes = try std_bytes::append(try std_bytes::create(heap, cast<i64>(size)), text);
    let mut i = len_slice(text);
    while i < size {
        bytes = try push(bytes, fill);
        i += 1u64;
    }
    return new std_bytes::Built.ok(bytes);
}
// Validate every half-open span and total output bound before allocating.
fn join(heap: allocator, text: &[]u8, parts: &[]Range, separator: &[]u8, limit: u64) -> std_bytes::Built {
    let mut size = 0u64;
    let mut i = 0u64;
    while i < len_slice(parts) {
        let part = read_slice(parts, i);
        if part.start > part.end || part.end > len_slice(text) {
            return new std_bytes::Built.err(new std_result::Error {
                category: new std_result::Category.bounds,
                code: 1
            });
        }
        if i > 0u64 {
            if len_slice(separator) > limit - size {
                return new std_bytes::Built.err(new std_result::Error {
                    category: new std_result::Category.bounds,
                    code: 1
                });
            }
            size += len_slice(separator);
        }
        if part.end - part.start > limit - size {
            return new std_bytes::Built.err(new std_result::Error {
                category: new std_result::Category.bounds,
                code: 1
            });
        }
        size += part.end - part.start;
        i += 1u64;
    }
    if size > 9223372036854775807u64 {
        return new std_bytes::Built.err(new std_result::Error {
            category: new std_result::Category.bounds,
            code: 1
        });
    }
    let mut bytes = try std_bytes::create(heap, cast<i64>(size));
    i = 0u64;
    while i < len_slice(parts) {
        if i > 0u64 {
            bytes = try std_bytes::append(bytes, separator);
        }
        bytes = try append_range(bytes, text, read_slice(parts, i));
        i += 1u64;
    }
    return new std_bytes::Built.ok(bytes);
}
