module std_format;
import std_math;
import std_bytes;
import std_strings;
import std_result;
export parse_float;
export fixed;
fn bad() -> std_result::Error {
    return new std_result::Error {
        category: new std_result::Category.malformed,
        code: 1
    };
}
// Strict finite decimal grammar, at most 19 significant digits and exponent magnitude 308.
fn parse_float(text: &[]u8) -> std_result::Result<std_math::F64, std_result::Error> {
    let mut i = 0u64;
    let mut negative = false;
    if len_slice(text) > 0u64 && read_slice(text, 0) == 45u8 {
        negative = true;
        i = 1u64;
    }
    let mut mantissa = 0u64;
    let mut digits = 0u64;
    let mut significant = 0u64;
    let mut fraction = 0;
    let mut dot = false;
    while i < len_slice(text) {
        let b = read_slice(text, i);
        if b == 46u8 && !dot {
            if digits == 0u64 || i + 1u64 >= len_slice(text) || read_slice(text, i + 1u64) < 48u8 || read_slice(text, i + 1u64) > 57u8 {
                return new std_result::Result<std_math::F64, std_result::Error>.err(bad());
            }
            dot = true;
            i += 1u64;
        } else {
            if b < 48u8 || b > 57u8 {
                break;
            }
            let digit = cast<u64>(b - 48u8);
            if mantissa != 0u64 || digit != 0u64 {
                significant += 1u64;
            }
            if significant > 19u64 {
                return new std_result::Result<std_math::F64, std_result::Error>.err(new std_result::Error {
                    category: new std_result::Category.overflow,
                    code: 1
                });
            }
            mantissa = mantissa * 10u64 + digit;
            digits += 1u64;
            if dot {
                fraction += 1;
            }
            i += 1u64;
        }
    }
    if digits == 0u64 {
        return new std_result::Result<std_math::F64, std_result::Error>.err(bad());
    }
    let mut exponent = 0;
    let mut exp_negative = false;
    if i < len_slice(text) &&(read_slice(text, i) == 101u8 || read_slice(text, i) == 69u8) {
        i += 1u64;
        if i < len_slice(text) &&(read_slice(text, i) == 45u8 || read_slice(text, i) == 43u8) {
            exp_negative = read_slice(text, i) == 45u8;
            i += 1u64;
        }
        let start = i;
        while i < len_slice(text) {
            let b = read_slice(text, i);
            if b < 48u8 || b > 57u8 {
                return new std_result::Result<std_math::F64, std_result::Error>.err(bad());
            }
            exponent = exponent * 10 + cast<i64>(b - 48u8);
            if exponent > 308 {
                return new std_result::Result<std_math::F64, std_result::Error>.err(new std_result::Error {
                    category: new std_result::Category.overflow,
                    code: 1
                });
            }
            i += 1u64;
        }
        if i == start {
            return new std_result::Result<std_math::F64, std_result::Error>.err(bad());
        }
    }
    if i != len_slice(text) {
        return new std_result::Result<std_math::F64, std_result::Error>.err(bad());
    }
    if exp_negative {
        exponent = - exponent;
    }
    exponent -= fraction;
    if exponent < - 308 || exponent > 308 {
        return new std_result::Result<std_math::F64, std_result::Error>.err(new std_result::Error {
            category: new std_result::Category.overflow,
            code: 1
        });
    }
    let mut value = std_math::from_u64(mantissa);
    let ten = std_math::from_u64(10u64);
    while exponent > 0 {
        value = std_math::mul(value, ten);
        exponent -= 1;
    }
    while exponent < 0 {
        value = std_math::div(value, ten);
        exponent += 1;
    }
    if !std_math::is_finite(value) {
        return new std_result::Result<std_math::F64, std_result::Error>.err(new std_result::Error {
            category: new std_result::Category.overflow,
            code: 1
        });
    }
    if negative {
        value = std_math::neg(value);
    }
    return new std_result::Result<std_math::F64, std_result::Error>.ok(value);
}
// Fixed decimal, 0..9 places, truncates magnitude toward zero. Not a shortest-roundtrip formatter.
fn fixed(heap: allocator, value: std_math::F64, places: u64, limit: i64) -> std_bytes::Built {
    if places > 9u64 || !std_math::is_finite(value) {
        return new std_bytes::Built.err(bad());
    }
    let magnitude = std_math::abs(value);
    let mut integer = 0u64;
    match std_math::to_u64(magnitude) {
        std_math::Unsigned.err(discard) => {
            return new std_bytes::Built.err(new std_result::Error {
                category: new std_result::Category.overflow,
                code: 1
            });
        },
        std_math::Unsigned.ok(n) => {
            integer = n;
        }
    }
    let mut bytes = try std_bytes::create(heap, limit);
    if bit_and(std_math::bits(value), 9223372036854775808u64) != 0u64 {
        bytes = try std_strings::push(bytes, 45u8);
    }
    let whole = try std_strings::unsigned(heap, integer, 10u64, 20);
    borrow whole[0..len_buffer(whole)] as text {
        bytes = try std_bytes::append(bytes, text);
    }
    if places > 0u64 {
        bytes = try std_strings::push(bytes, 46u8);
    }
    let fraction = std_math::sub(magnitude, std_math::from_u64(integer));
    let mut scale = 1u64;
    let mut i = 0u64;
    while i < places {
        scale = scale * 10u64;
        i += 1u64;
    }
    let mut digits = scaled_fraction(fraction, scale);
    let mut divisor = scale / 10u64;
    i = 0u64;
    while i < places {
        bytes = try std_strings::push(bytes, cast<u8>(48u64 + digits / divisor));
        digits = digits % divisor;
        divisor = divisor / 10u64;
        i += 1u64;
    }
    return new std_bytes::Built.ok(bytes);
}
// Exact 53-bit significand times a <=1e9 scale, represented by two u64 limbs.
// This avoids rounding a fractional digit upward during decimal extraction.
fn scaled_fraction(value: std_math::F64, scale: u64) -> u64 {
    let raw = std_math::bits(value);
    let exponent = bit_and(shift_right(raw, 52u64), 2047u64);
    let mut mantissa = bit_and(raw, 4503599627370495u64);
    let mut shift = 1074u64;
    if exponent != 0u64 {
        mantissa += 4503599627370496u64;
        shift = 1075u64 - exponent;
    }
    if shift >= 128u64 {
        return 0u64;
    }
    let product_low = bit_and(mantissa, 4294967295u64) * scale;
    let product_high = shift_right(mantissa, 32u64) * scale;
    let low = wrapping_add(product_low, bit_and(product_high, 4294967295u64) * 4294967296u64);
    let mut high = shift_right(product_high, 32u64);
    if low < product_low {
        high += 1u64;
    }
    if shift >= 64u64 {
        return shift_right(high, shift - 64u64);
    }
    return bit_or(shift_right(low, shift), shift_left(high, 64u64 - shift));
}
