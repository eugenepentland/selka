// SplitMix64 is deterministic simulation state, not cryptographic randomness.
module std_random;
export Generator;
export Draw;
export Error;
export Sample;
export Seeded;
export Bounded;
export Filled;
export Rejected;
export FillError;
export seed;
export next;
export bounded;
export entropy;
export seed_from_entropy;
export entropy_bounded;
export fill;
struct Generator {
    state: u64
}
struct Draw {
    generator: Generator,
    value: u64
}
enum Error {
    invalid_bound,
    exhausted,
    unavailable,
    denied,
    failed
}
result Sample {
    ok: u64,
    err: Error
}
result Seeded {
    ok: Generator,
    err: Error
}
struct Rejected {
    generator: Generator,
    error: Error
}
result Bounded {
    ok: Draw,
    err: Rejected
}
struct FillError {
    written: u64,
    error: Error
}
result Filled {
    ok: u64,
    err: FillError
}
result Raw {
    ok: u64,
    err: i64
}
fn seed(value: u64) -> Generator noalloc {
    return new Generator {
        state: value
    };
}
fn next(generator: Generator) -> Draw noalloc {
    let state = wrapping_add(generator.state, 11400714819323198485u64);
    let mut word = state;
    word = wrapping_mul(bit_xor(word, shift_right(word, 30u64)), 13787848793156543929u64);
    word = wrapping_mul(bit_xor(word, shift_right(word, 27u64)), 10723151780598845931u64);
    word = bit_xor(word, shift_right(word, 31u64));
    return new Draw {
        generator: seed(state),
        value: word
    };
}
fn bounded(generator: Generator, upper: u64, max_draws: u64) -> Bounded noalloc {
    if upper == 0u64 {
        return new Bounded.err(new Rejected {
            generator: generator,
            error: new Error.invalid_bound
        });
    }
    let threshold = wrapping_sub(0u64, upper) % upper;
    let mut current = generator;
    let mut count = 0u64;
    while count < max_draws {
        let draw = next(current);
        current = draw.generator;
        if draw.value >= threshold {
            return new Bounded.ok(new Draw {
                generator: current,
                value: draw.value % upper
            });
        }
        count += 1u64;
    }
    return new Bounded.err(new Rejected {
        generator: current,
        error: new Error.exhausted
    });
}
fn entropy(cap: random_cap) -> Sample effects(random) {
    match random_u64<Raw>(cap) {
        Raw.ok(word) => {
            return new Sample.ok(word);
        },
        Raw.err(code) => {
            if code == 1 {
                return new Sample.err(new Error.unavailable);
            }
            if code == 2 {
                return new Sample.err(new Error.denied);
            }
            return new Sample.err(new Error.failed);
        }
    }
}
fn seed_from_entropy(cap: random_cap) -> Seeded effects(random) {
    return new Seeded.ok(seed(try entropy(cap)));
}
fn entropy_bounded(cap: random_cap, upper: u64, max_draws: u64) -> Sample effects(random) {
    if upper == 0u64 {
        return new Sample.err(new Error.invalid_bound);
    }
    let threshold = wrapping_sub(0u64, upper) % upper;
    let mut count = 0u64;
    while count < max_draws {
        let word = try entropy(cap);
        if word >= threshold {
            return new Sample.ok(word % upper);
        }
        count += 1u64;
    }
    return new Sample.err(new Error.exhausted);
}
fn fill(cap: random_cap, bytes: &mut []u8) -> Filled effects(random) {
    let mut written = 0u64;
    while written < len_slice(bytes) {
        match entropy(cap) {
            Sample.err(e) => {
                return new Filled.err(new FillError {
                    written: written,
                    error: e
                });
            },
            Sample.ok(word) => {
                let mut remaining = word;
                let mut count = 0u64;
                while count < 8u64 && written < len_slice(bytes) {
                    write_slice(bytes, written, cast<u8>(bit_and(remaining, 255u64)));
                    remaining = shift_right(remaining, 8u64);
                    written += 1u64;
                    count += 1u64;
                }
            }
        }
    }
    return new Filled.ok(written);
}
