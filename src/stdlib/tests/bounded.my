module main;
import std_map as m;
import std_set as s;
import std_queue as q;
result Answer{ok:i64,err:i64}
enum First{a,b}
enum Second{x,y}

fn map_test<K:equality>(heap:allocator,key:K,other:K)->Answer {
    let initial = try m::create::<K,i64>(heap,1u64);
    let put = m::put::<K,i64>(initial,key,7);
    let status = read_field(put,status);
    let map = take_field(put,map);
    if status != new m::PutStatus.inserted{return new Answer.ok(-1);}
    let replaced = m::put::<K,i64>(map,key,9);
    let replacement = read_field(replaced,status);
    let map2 = take_field(replaced,map);
    if replacement != new m::PutStatus.replaced{return new Answer.ok(-2);}
    let full = m::put::<K,i64>(map2,other,11);
    let limit = read_field(full,status);
    let map3 = take_field(full,map);
    if limit != new m::PutStatus.full{return new Answer.ok(-3);}
    let found = m::get::<K,i64>(map3,key);
    let value = read_field(found,value);
    let map4 = take_field(found,map);
    match value {
        m::Value<i64>.none=>{return new Answer.ok(-4);},
        m::Value<i64>.some(n)=>{if n != 9{return new Answer.ok(-5);}}
    }
    let removed = m::remove::<K,i64>(map4,key);
    let old = read_field(removed,value);
    let map5 = take_field(removed,map);
    if len_buffer(map5) != 0u64{return new Answer.ok(-6);}
    match old {
        m::Value<i64>.none=>{return new Answer.ok(-7);},
        m::Value<i64>.some(n)=>{return new Answer.ok(n);}
    }
}

fn queue_test<T:equality>(heap:allocator,first:T,second:T)->Answer {
    let initial = try q::create::<T>(heap,2u64);
    let added = q::push::<T>(initial,first);
    let accepted = read_field(added,accepted);
    let queue = take_field(added,queue);
    if !accepted{return new Answer.ok(-10);}
    let again = q::push::<T>(queue,second);
    let two = take_field(again,queue);
    let full = q::push::<T>(two,first);
    let overflow = read_field(full,accepted);
    let queue2 = take_field(full,queue);
    if overflow{return new Answer.ok(-11);}
    let removed = q::pop::<T>(queue2);
    let item = read_field(removed,item);
    let queue3 = take_field(removed,queue);
    match item {
        q::Item<T>.none=>{return new Answer.ok(-12);},
        q::Item<T>.some(value)=>{if value != first{return new Answer.ok(-13);}}
    }
    let next = q::pop::<T>(queue3);
    let next_item = read_field(next,item);
    let queue4 = take_field(next,queue);
    match next_item {
        q::Item<T>.none=>{return new Answer.ok(-15);},
        q::Item<T>.some(value)=>{if value != second{return new Answer.ok(-16);}}
    }
    let empty = q::pop::<T>(queue4);
    let missing = read_field(empty,item);
    discard take_field(empty,queue);
    match missing {
        q::Item<T>.none=>{return new Answer.ok(1);},
        q::Item<T>.some(discard)=>{return new Answer.ok(-14);}
    }
}

fn set_test<T:equality>(heap:allocator,value:T,other:T)->Answer {
    let initial = try s::create::<T>(heap,1u64);
    let added = s::insert::<T>(initial,value);
    let changed = read_field(added,changed);
    let set = take_field(added,set);
    if !changed{return new Answer.ok(-20);}
    let duplicate = s::insert::<T>(set,value);
    let duplicate_added = read_field(duplicate,changed);
    let set2 = take_field(duplicate,set);
    if duplicate_added{return new Answer.ok(-21);}
    let full = s::insert::<T>(set2,other);
    let overflow = read_field(full,full);
    let set3 = take_field(full,set);
    if !overflow{return new Answer.ok(-22);}
    let found = s::contains::<T>(set3,value);
    let present = read_field(found,present);
    let set4 = take_field(found,set);
    if !present{return new Answer.ok(-23);}
    let removed = s::remove::<T>(set4,value);
    let deleted = read_field(removed,changed);
    let set5 = take_field(removed,set);
    if !deleted{return new Answer.ok(-24);}
    let absent = s::contains::<T>(set5,value);
    let missing = read_field(absent,present);
    discard take_field(absent,set);
    if missing{return new Answer.ok(-25);}
    return new Answer.ok(1);
}

fn work(heap:allocator)->Answer {
    let first = try map_test::<First>(heap,new First.a,new First.b);
    let second = try map_test::<Second>(heap,new Second.x,new Second.y);
    let queue = try queue_test::<i64>(heap,3,7);
    let bools = try queue_test::<bool>(heap,true,false);
    let set = try set_test::<First>(heap,new First.a,new First.b);
    return new Answer.ok(first + second + queue + bools + set);
}
fn main(heap:allocator)->i64 {
    match work(heap){Answer.ok(n)=>{return n;},Answer.err(e)=>{return e;}}
}
