// Byte offsets and byte ordering. UTF-8 validation is explicit; no normalization.
module std_bytes;
import std_result;
export compare;
export find;
export utf8;
export integer;
export Bytes;
export Built;
export escaped;
export append;
export create;
export decimal;
buffer Bytes: u8;
result Raw {
    ok: Bytes,
    err: i64
}
result Status {
    ok: bool,
    err: i64
}
result Built {
    ok: Bytes,
    err: std_result::Error
}
fn compare(a: &[]u8, b: &[]u8) -> i64 {
    let mut i = 0u64;
    while i < len_slice(a) && i < len_slice(b) {
        let difference = cast<i64>(read_slice(a, i)) - cast<i64>(read_slice(b, i));
        if difference != 0 {
            return difference;
        }
        i += 1u64;
    }
    if len_slice(a) < len_slice(b) {
        return - 1;
    }
    if len_slice(a) > len_slice(b) {
        return 1;
    }
    return 0;
}
fn find(text: &[]u8, needle: &[]u8) -> std_result::Option<u64> {
    if len_slice(needle) > len_slice(text) {
        return new std_result::Option<u64>.none;
    }
    let mut i = 0u64;
    while i <= len_slice(text) - len_slice(needle) {
        let mut j = 0u64;
        let mut same = true;
        while j < len_slice(needle) {
            if read_slice(text, i + j) != read_slice(needle, j) {
                same = false;
            }
            j += 1u64;
        }
        if same {
            return new std_result::Option<u64>.some(i);
        }
        i += 1u64;
    }
    return new std_result::Option<u64>.none;
}
fn utf8(text: &[]u8) -> bool {
    let mut i = 0u64;
    while i < len_slice(text) {
        let lead = read_slice(text, i);
        let mut count = 0u64;
        let mut low = 128u8;
        let mut high = 191u8;
        if lead < 128u8 {
            count = 0u64;
        } else {
            if lead >= 194u8 && lead <= 223u8 {
                count = 1u64;
            } else {
                if lead >= 224u8 && lead <= 239u8 {
                    count = 2u64;
                    if lead == 224u8 {
                        low = 160u8;
                    }
                    if lead == 237u8 {
                        high = 159u8;
                    }
                } else {
                    if lead >= 240u8 && lead <= 244u8 {
                        count = 3u64;
                        if lead == 240u8 {
                            low = 144u8;
                        }
                        if lead == 244u8 {
                            high = 143u8;
                        }
                    } else {
                        return false;
                    }
                }
            }
        }
        if count >= len_slice(text) - i {
            return false;
        }
        let mut j = 1u64;
        while j <= count {
            let byte = read_slice(text, i + j);
            if j == 1u64 {
                if byte < low || byte > high {
                    return false;
                }
            } else {
                if byte < 128u8 || byte > 191u8 {
                    return false;
                }
            }
            j += 1u64;
        }
        i += count + 1u64;
    }
    return true;
}
fn integer(text: &[]u8) -> std_result::Result<i64, std_result::Error> {
    if len_slice(text) == 0u64 {
        return new std_result::Result<i64, std_result::Error>.err(new std_result::Error {
            category: new std_result::Category.malformed,
            code: 0
        });
    }
    let negative = read_slice(text, 0) == 45u8;
    let mut i = 0u64;
    if negative {
        i = 1u64;
    }
    if i == len_slice(text) {
        return new std_result::Result<i64, std_result::Error>.err(new std_result::Error {
            category: new std_result::Category.malformed,
            code: 0
        });
    }
    let mut value = 0;
    while i < len_slice(text) {
        let byte = read_slice(text, i);
        if byte < 48u8 || byte > 57u8 {
            return new std_result::Result<i64, std_result::Error>.err(new std_result::Error {
                category: new std_result::Category.malformed,
                code: 0
            });
        }
        let digit = cast<i64>(byte) - 48;
        let mut last = 7;
        if negative {
            last = 8;
        }
        if value < - 922337203685477580 ||(value == - 922337203685477580 && digit > last) {
            return new std_result::Result<i64, std_result::Error>.err(new std_result::Error {
                category: new std_result::Category.overflow,
                code: 0
            });
        }
        value = value * 10 - digit;
        i += 1u64;
    }
    if negative {
        return new std_result::Result<i64, std_result::Error>.ok(value);
    }
    return new std_result::Result<i64, std_result::Error>.ok(- value);
}
// The owned buffer's fixed capacity is the builder budget. Failure consumes it.
fn append(input: Bytes, text: &[]u8) -> Built {
    let mut bytes = input;
    if len_slice(text) > capacity_buffer(bytes) - len_buffer(bytes) {
        return new Built.err(std_result::allocation_error(2));
    }
    let mut i = 0u64;
    while i < len_slice(text) {
        acknowledge append_buffer<Status>(bytes, read_slice(text, i));
        i += 1u64;
    }
    return new Built.ok(bytes);
}
fn escaped(heap: allocator, text: &[]u8, limit: i64) -> Built {
    if !utf8(text) {
        return new Built.err(new std_result::Error {
            category: new std_result::Category.invalid_utf8,
            code: 0
        });
    }
    if limit < 2 {
        return new Built.err(std_result::allocation_error(2));
    }
    let mut required = 2u64;
    let mut i = 0u64;
    while i < len_slice(text) {
        let byte = read_slice(text, i);
        let mut width = 1u64;
        if byte < 32u8 {
            width = 6u64;
        } else {
            if byte == 34u8 || byte == 92u8 {
                width = 2u64;
            }
        }
        if width > cast<u64>(limit) - required {
            return new Built.err(std_result::allocation_error(2));
        }
        required += width;
        i += 1u64;
    }
    match acquire_buffer<Raw>(heap, limit) {
        Raw.err(code) => {
            return new Built.err(std_result::allocation_error(code));
        },
        Raw.ok(input) => {
            let mut bytes = input;
            acknowledge append_buffer<Status>(bytes, 34u8);
            i = 0u64;
            while i < len_slice(text) {
                let byte = read_slice(text, i);
                if byte < 32u8 {
                    acknowledge append_buffer<Status>(bytes, 92u8);
                    acknowledge append_buffer<Status>(bytes, 117u8);
                    acknowledge append_buffer<Status>(bytes, 48u8);
                    acknowledge append_buffer<Status>(bytes, 48u8);
                    acknowledge append_buffer<Status>(bytes, hex(byte / 16u8));
                    acknowledge append_buffer<Status>(bytes, hex(byte % 16u8));
                } else {
                    if byte == 34u8 || byte == 92u8 {
                        acknowledge append_buffer<Status>(bytes, 92u8);
                    }
                    acknowledge append_buffer<Status>(bytes, byte);
                }
                i += 1u64;
            }
            acknowledge append_buffer<Status>(bytes, 34u8);
            return new Built.ok(bytes);
        }
    }
}
fn hex(value: u8) -> u8 {
    if value < 10u8 {
        return 48u8 + value;
    }
    return 87u8 + value;
}
fn create(heap: allocator, limit: i64) -> Built {
    if limit < 0 {
        return new Built.err(new std_result::Error {
            category: new std_result::Category.invalid_budget,
            code: 4
        });
    }
    match acquire_buffer<Raw>(heap, limit) {
        Raw.err(code) => {
            return new Built.err(std_result::allocation_error(code));
        },
        Raw.ok(bytes) => {
            return new Built.ok(bytes);
        }
    }
}
fn decimal(heap: allocator, value: i64, limit: i64) -> Built {
    let bytes = try create(heap, limit);
    if value < 0 {
        return digits(try append(bytes, "-"), value);
    }
    return digits(bytes, - value);
}
fn digits(input: Bytes, value: i64) -> Built {
    let mut bytes = input;
    if value <= - 10 {
        bytes = try digits(bytes, value / 10);
    }
    match append_buffer<Status>(bytes, cast<u8>(48 - value % 10)) {
        Status.err(code) => {
            return new Built.err(std_result::allocation_error(code));
        },
        Status.ok(discard) => {
            return new Built.ok(bytes);
        }
    }
}
