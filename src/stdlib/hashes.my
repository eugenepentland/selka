func rotate(value: u32, count: u32) -> u32 effects():
    return bit_or(shift_right(value, count), shift_left(value, 32u32 - count))


func triple(first: u32, second: u32, third: u32) -> u32 effects():
    return bit_xor(bit_xor(first, second), third)


func constants() -> u32[]:
    return [0x428a2f98u32, 0x71374491u32, 0xb5c0fbcfu32, 0xe9b5dba5u32, 0x3956c25bu32, 0x59f111f1u32, 0x923f82a4u32, 0xab1c5ed5u32, 0xd807aa98u32, 0x12835b01u32, 0x243185beu32, 0x550c7dc3u32, 0x72be5d74u32, 0x80deb1feu32, 0x9bdc06a7u32, 0xc19bf174u32, 0xe49b69c1u32, 0xefbe4786u32, 0x0fc19dc6u32, 0x240ca1ccu32, 0x2de92c6fu32, 0x4a7484aau32, 0x5cb0a9dcu32, 0x76f988dau32, 0x983e5152u32, 0xa831c66du32, 0xb00327c8u32, 0xbf597fc7u32, 0xc6e00bf3u32, 0xd5a79147u32, 0x06ca6351u32, 0x14292967u32, 0x27b70a85u32, 0x2e1b2138u32, 0x4d2c6dfcu32, 0x53380d13u32, 0x650a7354u32, 0x766a0abbu32, 0x81c2c92eu32, 0x92722c85u32, 0xa2bfe8a1u32, 0xa81a664bu32, 0xc24b8b70u32, 0xc76c51a3u32, 0xd192e819u32, 0xd6990624u32, 0xf40e3585u32, 0x106aa070u32, 0x19a4c116u32, 0x1e376c08u32, 0x2748774cu32, 0x34b0bcb5u32, 0x391c0cb3u32, 0x4ed8aa4au32, 0x5b9cca4fu32, 0x682e6ff3u32, 0x748f82eeu32, 0x78a5636fu32, 0x84c87814u32, 0x8cc70208u32, 0x90befffau32, 0xa4506cebu32, 0xbef9a3f7u32, 0xc67178f2u32]


func octet(data: bytes, position: int, total: int) -> u32 effects():
    if position < len(data):
        return u32(data[position])
    if position == len(data):
        return 128u32
    if position >= total - 8:
        return u32(bit_and(shift_right(u64(len(data)) * 8u64, u64((total - position - 1) * 8)), 255u64))
    return 0u32


func compress(data: bytes, start: int, total: int, mut state: u32[], rounds: u32[]):
    mut words = [for index in range(64) yield 0u32]
    for index in range(16):
        mut value = 0u32
        for part in range(4):
            value = bit_or(shift_left(value, 8u32), octet(data, start + index * 4 + part, total))
        words[index] = value
    for index in range(16, 64):
        const a = words[index - 15]
        const b = words[index - 2]
        const first = triple(rotate(a, 7u32), rotate(a, 18u32), shift_right(a, 3u32))
        const second = triple(rotate(b, 17u32), rotate(b, 19u32), shift_right(b, 10u32))
        words[index] = wrapping_add(wrapping_add(words[index - 16], first), wrapping_add(words[index - 7], second))
    mut a = state[0]
    mut b = state[1]
    mut c = state[2]
    mut d = state[3]
    mut e = state[4]
    mut f = state[5]
    mut g = state[6]
    mut h = state[7]
    for index in range(64):
        const choice = bit_xor(bit_and(e, f), bit_and(bit_xor(e, 0xffffffffu32), g))
        const upper = triple(rotate(e, 6u32), rotate(e, 11u32), rotate(e, 25u32))
        const first = wrapping_add(wrapping_add(wrapping_add(h, upper), choice), wrapping_add(rounds[index], words[index]))
        const lower = triple(rotate(a, 2u32), rotate(a, 13u32), rotate(a, 22u32))
        const majority = triple(bit_and(a, b), bit_and(a, c), bit_and(b, c))
        const second = wrapping_add(lower, majority)
        h = g
        g = f
        f = e
        e = wrapping_add(d, first)
        d = c
        c = b
        b = a
        a = wrapping_add(first, second)
    const next = [a, b, c, d, e, f, g, h]
    for index in range(8):
        state[index] = wrapping_add(state[index], next[index])


# SHA-256 as 64 lowercase hexadecimal digits. Reads the input in 64-byte blocks
# with fixed-size working arrays; padding never copies the entire input.
public func sha256(data: bytes) -> str:
    mut state = [0x6a09e667u32, 0xbb67ae85u32, 0x3c6ef372u32, 0xa54ff53au32, 0x510e527fu32, 0x9b05688cu32, 0x1f83d9abu32, 0x5be0cd19u32]
    const rounds = constants()
    mut blocks = len(data) // 64 + 1
    if len(data) % 64 >= 56:
        blocks += 1
    for block in range(blocks):
        compress(data, block * 64, blocks * 64, mut state, rounds)
    mut result: int[] = []
    for word in state:
        for part in range(4):
            result.append(int(bit_and(shift_right(word, u32((3 - part) * 8)), 255u32)))
    return bytes(result).hex()
