module std_hash_bytes;
import std_hash as h;
import std_collections as c;
import std_map as m;
export Entry;
export Slot;
export Map;
export Created;
export create;
export lookup;
export put;
export remove;
export clear;
export count;
export Key;
export PutStatus;
export valid;
export KeyResult;
export from_bytes;
export key_equal;
export key_hash;
enum PutStatus {
    inserted,
    replaced,
    full,
    invalid
}
struct Key {
    bytes: [256]u8,
    length: u64
}
result KeyResult {
    ok: Key,
    err: i64
}
fn from_bytes(input: &[]u8) -> KeyResult noalloc {
    if len_slice(input) > 256u64 {
        return new KeyResult.err(1);
    }
    let mut data = new [256]u8[0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    let mut i = 0u64;
    borrow mut data[0..256] as output {
        while i < len_slice(input) {
            write_slice(output, i, read_slice(input, i));
            i += 1u64;
        }
    }
    return new KeyResult.ok(new Key {
        bytes: data,
        length: len_slice(input)
    });
}
fn valid(value: Key) -> bool noalloc {
    return value.length <= 256u64;
}
fn key_equal(a: Key, b: Key) -> bool noalloc {
    if !valid(a) || !valid(b) {
        return false;
    }
    if a.length != b.length {
        return false;
    }
    let mut i = 0u64;
    while i < a.length {
        if a.bytes[i] != b.bytes[i] {
            return false;
        }
        i += 1u64;
    }
    return true;
}
fn key_hash(value: Key) -> u64 noalloc {
    if !valid(value) {
        return 0u64;
    }
    let data = value.bytes;
    borrow data[0..value.length] as bytes {
        return h::bytes(bytes);
    }
}
struct Entry<V: copy> {
    key: Key,
    value: V
}
union Slot<V: copy> {
    empty,
    deleted,
    occupied: Entry<V>
}
buffer Map < V: copy >: Slot<V>;
result Created<V: copy> {
    ok: Map<V>,
    err: i64
}
fn create < V: copy >(heap: allocator, capacity: u64) -> Created<V> {
    let mut map = try acquire_buffer<Created<V>>(heap, capacity);
    discard try resize_buffer<c::Status>(map, capacity, new Slot<V>.empty);
    return new Created<V>.ok(map);
}
fn lookup < V: copy >(map: &Map<V>, key: Key) -> m::Value<V> noalloc {
    if !valid(key) {
        return new m::Value<V>.none;
    }
    let capacity = len_buffer(map);
    if capacity == 0u64 {
        return new m::Value<V>.none;
    }
    let start = key_hash(key) % capacity;
    let mut step = 0u64;
    while step < capacity {
        let i =(start + step) % capacity;
        match read_buffer(map, i) {
            Slot<V>.empty => {
                return new m::Value<V>.none;
            },
            Slot<V>.deleted => {},
            Slot<V>.occupied(e) => {
                if key_equal(e.key, key) {
                    return new m::Value<V>.some(e.value);
                }
            }
        }
        step += 1u64;
    }
    return new m::Value<V>.none;
}
fn put < V: copy >(map: &mut Map<V>, key: Key, value: V) -> PutStatus noalloc {
    if !valid(key) {
        return new PutStatus.invalid;
    }
    let capacity = len_buffer(map);
    if capacity == 0u64 {
        return new PutStatus.full;
    }
    let start = key_hash(key) % capacity;
    let mut step = 0u64;
    let mut vacant = capacity;
    while step < capacity {
        let i =(start + step) % capacity;
        match read_buffer(map, i) {
            Slot<V>.empty => {
                if vacant == capacity {
                    vacant = i;
                }
                break;
            },
            Slot<V>.deleted => {
                if vacant == capacity {
                    vacant = i;
                }
            },
            Slot<V>.occupied(e) => {
                if key_equal(e.key, key) {
                    match write_buffer<c::Status>(map, i, new Slot<V>.occupied(new Entry<V> {
                        key: key,
                        value: value
                    })) {
                        c::Status.ok(discard) => {
                            return new PutStatus.replaced;
                        },
                        c::Status.err(discard) => {
                            return new PutStatus.full;
                        }
                    }
                }
            }
        }
        step += 1u64;
    }
    if vacant == capacity {
        return new PutStatus.full;
    }
    match write_buffer<c::Status>(map, vacant, new Slot<V>.occupied(new Entry<V> {
        key: key,
        value: value
    })) {
        c::Status.ok(discard) => {
            return new PutStatus.inserted;
        },
        c::Status.err(discard) => {
            return new PutStatus.full;
        }
    }
}
fn remove < V: copy >(map: &mut Map<V>, key: Key) -> m::Value<V> noalloc {
    if !valid(key) {
        return new m::Value<V>.none;
    }
    let capacity = len_buffer(map);
    if capacity == 0u64 {
        return new m::Value<V>.none;
    }
    let start = key_hash(key) % capacity;
    let mut step = 0u64;
    while step < capacity {
        let i =(start + step) % capacity;
        match read_buffer(map, i) {
            Slot<V>.empty => {
                return new m::Value<V>.none;
            },
            Slot<V>.deleted => {},
            Slot<V>.occupied(e) => {
                if key_equal(e.key, key) {
                    match write_buffer<c::Status>(map, i, new Slot<V>.deleted) {
                        c::Status.ok(discard) => {
                            return new m::Value<V>.some(e.value);
                        },
                        c::Status.err(discard) => {
                            return new m::Value<V>.none;
                        }
                    }
                }
            }
        }
        step += 1u64;
    }
    return new m::Value<V>.none;
}
fn clear < V: copy >(map: &mut Map<V>) -> c::Status noalloc {
    let mut i = 0u64;
    while i < len_buffer(map) {
        discard try write_buffer<c::Status>(map, i, new Slot<V>.empty);
        i += 1u64;
    }
    return new c::Status.ok(true);
}
fn count < V: copy >(map: &Map<V>) -> u64 noalloc {
    let mut total = 0u64;
    let mut i = 0u64;
    while i < len_buffer(map) {
        match read_buffer(map, i) {
            Slot<V>.empty => {},
            Slot<V>.deleted => {},
            Slot<V>.occupied(discard) => {
                total += 1u64;
            }
        }
        i += 1u64;
    }
    return total;
}
