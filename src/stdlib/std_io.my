// Owned file I/O state is returned on both success and recoverable failure.
module std_io;
import std_bytes;
export Finished;
export finish;
export File;
export Error;
export Kind;
export provider_error;
export Reader;
export Writer;
export Progress;
export ReadValue;
export ReadFailure;
export WriteValue;
export WriteFailure;
export CollectedValue;
export CollectedFailure;
export Reading;
export Writing;
export Collected;
export reader;
export writer;
export read;
export read_exact;
export write_all;
export flush;
export read_to_end;
export read_line;
resource File: filesystem;
enum Kind {
    unavailable,
    denied,
    provider,
    unexpected_eof,
    no_progress,
    limit,
    allocation,
    invalid_path,
    malformed
}
struct Error {
    kind: Kind,
    code: i64
}
fn provider_error(code: i64) -> Error noalloc {
    if code == 1 {
        return new Error {
            kind: new Kind.unavailable,
            code: code
        };
    }
    if code == 2 {
        return new Error {
            kind: new Kind.denied,
            code: code
        };
    }
    return new Error {
        kind: new Kind.provider,
        code: code
    };
}
struct Progress {
    length: u64,
    eof: bool
}
struct Chunk {
    bytes: [64]u8,
    length: u64,
    eof: bool
}
result RawRead {
    ok: Chunk,
    err: i64
}
result RawWrite {
    ok: u64,
    err: i64
}
result RawStatus {
    ok: bool,
    err: i64
}
struct Reader {
    file: File,
    bytes: [64]u8,
    position: u64,
    length: u64,
    eof: bool
}
struct Writer {
    file: File,
    bytes: [64]u8,
    length: u64
}
struct ReadValue {
    reader: Reader,
    progress: Progress
}
struct ReadFailure {
    reader: Reader,
    cause: Error,
    progress: u64
}
result Reading {
    ok: ReadValue,
    err: ReadFailure
}
struct WriteValue {
    writer: Writer,
    progress: u64
}
struct WriteFailure {
    writer: Writer,
    cause: Error,
    progress: u64
}
result Writing {
    ok: WriteValue,
    err: WriteFailure
}
struct CollectedValue {
    reader: Reader,
    bytes: std_bytes::Bytes,
    eof: bool,
    newline: bool
}
struct CollectedFailure {
    reader: Reader,
    bytes: std_bytes::Bytes,
    cause: Error,
    progress: u64
}
result Collected {
    ok: CollectedValue,
    err: CollectedFailure
}
fn reader(file: File) -> Reader {
    return new Reader {
        file: file,
        bytes: zeros(),
        position: 0u64,
        length: 0u64,
        eof: false
    };
}
fn writer(file: File) -> Writer {
    return new Writer {
        file: file,
        bytes: zeros(),
        length: 0u64
    };
}
fn read(input: Reader, destination: &mut []u8) -> Reading {
    let mut bytes = read_field(input, bytes);
    let mut position = read_field(input, position);
    let mut length = read_field(input, length);
    let mut eof = read_field(input, eof);
    let mut file = take_field(input, file);
    let mut count = 0u64;
    while count < len_slice(destination) {
        if position == length {
            if eof {
                break;
            }
            match read_resource<RawRead>(file) {
                RawRead.err(code) => {
                    return new Reading.err(new ReadFailure {
                        reader: new Reader {
                            file: file,
                            bytes: bytes,
                            position: position,
                            length: length,
                            eof: eof
                        },
                        cause: provider_error(code),
                        progress: count
                    });
                },
                RawRead.ok(chunk) => {
                    bytes = chunk.bytes;
                    length = chunk.length;
                    position = 0u64;
                    eof = chunk.eof;
                    if length == 0u64 && !eof {
                        return new Reading.err(new ReadFailure {
                            reader: new Reader {
                                file: file,
                                bytes: bytes,
                                position: position,
                                length: length,
                                eof: eof
                            },
                            cause: new Error {
                                kind: new Kind.no_progress,
                                code: 0
                            },
                            progress: count
                        });
                    }
                    if length == 0u64 {
                        break;
                    }
                }
            }
        }
        write_slice(destination, count, bytes[position]);
        position += 1u64;
        count += 1u64;
    }
    return new Reading.ok(new ReadValue {
        reader: new Reader {
            file: file,
            bytes: bytes,
            position: position,
            length: length,
            eof: eof
        },
        progress: new Progress {
            length: count,
            eof: eof && position == length
        }
    });
}
fn read_exact(input: Reader, destination: &mut []u8) -> Reading {
    match read(input, destination) {
        Reading.err(failure) => {
            return new Reading.err(failure);
        },
        Reading.ok(value) => {
            let progress = read_field(value, progress);
            if progress.length != len_slice(destination) {
                return new Reading.err(new ReadFailure {
                    reader: take_field(value, reader),
                    cause: new Error {
                        kind: new Kind.unexpected_eof,
                        code: 0
                    },
                    progress: progress.length
                });
            }
            return new Reading.ok(value);
        }
    }
}
fn flush(input: Writer) -> Writing {
    let bytes = read_field(input, bytes);
    let length = read_field(input, length);
    let mut file = take_field(input, file);
    let mut count = 0u64;
    while count < length {
        borrow bytes[count..length] as view {
            match write_resource_slice<RawWrite>(file, view) {
                RawWrite.err(code) => {
                    return flush_failure(file, bytes, count, length, provider_error(code));
                },
                RawWrite.ok(written) => {
                    if written == 0u64 {
                        return flush_failure(file, bytes, count, length, new Error {
                            kind: new Kind.no_progress,
                            code: 0
                        });
                    }
                    count += written;
                }
            }
        }
    }
    return new Writing.ok(new WriteValue {
        writer: new Writer {
            file: file,
            bytes: bytes,
            length: 0u64
        },
        progress: count
    });
}
fn flush_failure(file: File, input: [64]u8, count: u64, length: u64, cause: Error) -> Writing {
    let mut bytes = input;
    let mut i = count;
    while i < length {
        bytes = replace(bytes, i - count, bytes[i]);
        i += 1u64;
    }
    return new Writing.err(new WriteFailure {
        writer: new Writer {
            file: file,
            bytes: bytes,
            length: length - count
        },
        cause: cause,
        progress: count
    });
}
fn write_all(input: Writer, source: &[]u8) -> Writing {
    let mut state = input;
    let mut count = 0u64;
    while count < len_slice(source) {
        if read_field(state, length) == 64u64 {
            match flush(state) {
                Writing.err(failure) => {
                    return new Writing.err(new WriteFailure {
                        cause: read_field(failure, cause),
                        progress: count,
                        writer: take_field(failure, writer)
                    });
                },
                Writing.ok(value) => {
                    state = take_field(value, writer);
                }
            }
        }
        let mut bytes = read_field(state, bytes);
        let mut length = read_field(state, length);
        while count < len_slice(source) && length < 64u64 {
            bytes = replace(bytes, length, read_slice(source, count));
            count += 1u64;
            length += 1u64;
        }
        state = new Writer {
            file: take_field(state, file),
            bytes: bytes,
            length: length
        };
    }
    return new Writing.ok(new WriteValue {
        writer: state,
        progress: count
    });
}
fn read_to_end(input: Reader, output: std_bytes::Bytes, limit: u64) -> Collected {
    return collect(input, output, limit, false);
}
fn read_line(input: Reader, output: std_bytes::Bytes, limit: u64) -> Collected {
    return collect(input, output, limit, true);
}
fn rewind(input: Reader) -> Reader {
    return new Reader {
        bytes: read_field(input, bytes),
        length: read_field(input, length),
        position: read_field(input, position) - 1u64,
        eof: read_field(input, eof),
        file: take_field(input, file)
    };
}
fn collect(input: Reader, output: std_bytes::Bytes, limit: u64, line: bool) -> Collected {
    let mut state = input;
    let mut bytes = output;
    let mut count = 0u64;
    if len_buffer(bytes) > limit {
        return new Collected.err(new CollectedFailure {
            reader: state,
            bytes: bytes,
            cause: new Error {
                kind: new Kind.limit,
                code: 0
            },
            progress: count
        });
    }
    while true {
        let mut single = new [1]u8[0u8];
        borrow mut single[0..1] as view {
            match read(state, view) {
                Reading.err(failure) => {
                    return new Collected.err(new CollectedFailure {
                        bytes: bytes,
                        cause: read_field(failure, cause),
                        progress: count,
                        reader: take_field(failure, reader)
                    });
                },
                Reading.ok(value) => {
                    let progress = read_field(value, progress);
                    state = take_field(value, reader);
                    if progress.length == 0u64 {
                        return new Collected.ok(new CollectedValue {
                            reader: state,
                            bytes: bytes,
                            eof: true,
                            newline: false
                        });
                    }
                }
            }
        }
        if line && single[0] == 10u8 {
            return new Collected.ok(new CollectedValue {
                reader: state,
                bytes: bytes,
                eof: false,
                newline: true
            });
        }
        if len_buffer(bytes) == limit {
            return new Collected.err(new CollectedFailure {
                reader: rewind(state),
                bytes: bytes,
                cause: new Error {
                    kind: new Kind.limit,
                    code: 0
                },
                progress: count
            });
        }
        match append_buffer<RawStatus>(bytes, single[0]) {
            RawStatus.err(code) => {
                return new Collected.err(new CollectedFailure {
                    reader: rewind(state),
                    bytes: bytes,
                    cause: new Error {
                        kind: new Kind.allocation,
                        code: code
                    },
                    progress: count
                });
            },
            RawStatus.ok(discard) => {}
        }
        count += 1u64;
    }
    return new Collected.err(new CollectedFailure {
        reader: state,
        bytes: bytes,
        cause: new Error {
            kind: new Kind.no_progress,
            code: 0
        },
        progress: count
    });
}
fn zeros() -> [64]u8 {
    return new [64]u8[0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
}
struct RawCloseFailure {
    resource: File,
    code: i64
}
result RawClose {
    ok: bool,
    err: RawCloseFailure
}
result Finished {
    ok: u64,
    err: WriteFailure
}
fn finish(input: Writer) -> Finished {
    match flush(input) {
        Writing.err(failure) => {
            return new Finished.err(failure);
        },
        Writing.ok(value) => {
            let progress = read_field(value, progress);
            let state = take_field(value, writer);
            let bytes = read_field(state, bytes);
            match complete_resource<RawClose>(take_field(state, file)) {
                RawClose.ok(discard) => {
                    return new Finished.ok(progress);
                },
                RawClose.err(failure) => {
                    return new Finished.err(new WriteFailure {
                        cause: provider_error(read_field(failure, code)),
                        progress: progress,
                        writer: new Writer {
                            file: take_field(failure, resource),
                            bytes: bytes,
                            length: 0u64
                        }
                    });
                }
            }
        }
    }
}
