module std_encoding;
import std_bytes;
import std_strings;
import std_result;
export read_uint;
export write_uint;
export hex_encode;
export hex_decode;
export base64_encode;
export base64_decode;
fn failure() -> std_result::Error {
    return new std_result::Error {
        category: new std_result::Category.malformed,
        code: 1
    };
}
fn read_uint(bytes: &[]u8, offset: u64, width: u64, little: bool) -> std_result::Result<u64, std_result::Error> {
    if width == 0u64 || width > 8u64 || offset > len_slice(bytes) || width > len_slice(bytes) - offset {
        return new std_result::Result<u64, std_result::Error>.err(failure());
    }
    let mut value = 0u64;
    let mut i = 0u64;
    while i < width {
        let mut index = offset + i;
        if little {
            index = offset + width - 1u64 - i;
        }
        value = bit_or(shift_left(value, 8u64), cast<u64>(read_slice(bytes, index)));
        i += 1u64;
    }
    return new std_result::Result<u64, std_result::Error>.ok(value);
}
fn write_uint(bytes: &mut []u8, offset: u64, width: u64, little: bool, value: u64) -> std_result::Result<bool, std_result::Error> {
    if width == 0u64 || width > 8u64 || offset > len_slice(bytes) || width > len_slice(bytes) - offset {
        return new std_result::Result<bool, std_result::Error>.err(failure());
    }
    if width < 8u64 && shift_right(value, width * 8u64) != 0u64 {
        return new std_result::Result<bool, std_result::Error>.err(new std_result::Error {
            category: new std_result::Category.overflow,
            code: 1
        });
    }
    let mut rest = value;
    let mut i = 0u64;
    while i < width {
        let mut index = offset + width - 1u64 - i;
        if little {
            index = offset + i;
        }
        write_slice(bytes, index, cast<u8>(bit_and(rest, 255u64)));
        rest = shift_right(rest, 8u64);
        i += 1u64;
    }
    return new std_result::Result<bool, std_result::Error>.ok(true);
}
fn hex_digit(n: u8) -> u8 {
    if n < 10u8 {
        return 48u8 + n;
    }
    return 87u8 + n;
}
fn unhex(n: u8) -> i64 {
    if n >= 48u8 && n <= 57u8 {
        return cast<i64>(n) - 48;
    }
    if n >= 65u8 && n <= 70u8 {
        return cast<i64>(n) - 55;
    }
    if n >= 97u8 && n <= 102u8 {
        return cast<i64>(n) - 87;
    }
    return - 1;
}
fn hex_encode(heap: allocator, text: &[]u8, limit: i64) -> std_bytes::Built {
    let mut bytes = try std_bytes::create(heap, limit);
    let mut i = 0u64;
    while i < len_slice(text) {
        let b = read_slice(text, i);
        bytes = try std_strings::push(bytes, hex_digit(b / 16u8));
        bytes = try std_strings::push(bytes, hex_digit(b % 16u8));
        i += 1u64;
    }
    return new std_bytes::Built.ok(bytes);
}
fn hex_decode(heap: allocator, text: &[]u8, limit: i64) -> std_bytes::Built {
    if len_slice(text) % 2u64 != 0u64 {
        return new std_bytes::Built.err(failure());
    }
    let mut bytes = try std_bytes::create(heap, limit);
    let mut i = 0u64;
    while i < len_slice(text) {
        let a = unhex(read_slice(text, i));
        let b = unhex(read_slice(text, i + 1u64));
        if a < 0 || b < 0 {
            return new std_bytes::Built.err(failure());
        }
        bytes = try std_strings::push(bytes, cast<u8>(a * 16 + b));
        i += 2u64;
    }
    return new std_bytes::Built.ok(bytes);
}
fn sextet(n: u64) -> u8 {
    if n < 26u64 {
        return cast<u8>(65u64 + n);
    }
    if n < 52u64 {
        return cast<u8>(97u64 + n - 26u64);
    }
    if n < 62u64 {
        return cast<u8>(48u64 + n - 52u64);
    }
    if n == 62u64 {
        return 43u8;
    }
    return 47u8;
}
fn unsextet(n: u8) -> i64 {
    if n >= 65u8 && n <= 90u8 {
        return cast<i64>(n) - 65;
    }
    if n >= 97u8 && n <= 122u8 {
        return cast<i64>(n) - 71;
    }
    if n >= 48u8 && n <= 57u8 {
        return cast<i64>(n) + 4;
    }
    if n == 43u8 {
        return 62;
    }
    if n == 47u8 {
        return 63;
    }
    return - 1;
}
fn base64_encode(heap: allocator, text: &[]u8, limit: i64) -> std_bytes::Built {
    let mut bytes = try std_bytes::create(heap, limit);
    let mut i = 0u64;
    while i < len_slice(text) {
        let remain = len_slice(text) - i;
        let mut n = cast<u64>(read_slice(text, i)) * 65536u64;
        if remain > 1u64 {
            n += cast<u64>(read_slice(text, i + 1u64)) * 256u64;
        }
        if remain > 2u64 {
            n += cast<u64>(read_slice(text, i + 2u64));
        }
        bytes = try std_strings::push(bytes, sextet(n / 262144u64));
        bytes = try std_strings::push(bytes, sextet(n / 4096u64 % 64u64));
        let mut c = 61u8;
        let mut d = 61u8;
        if remain > 1u64 {
            c = sextet(n / 64u64 % 64u64);
        }
        if remain > 2u64 {
            d = sextet(n % 64u64);
        }
        bytes = try std_strings::push(bytes, c);
        bytes = try std_strings::push(bytes, d);
        i += 3u64;
    }
    return new std_bytes::Built.ok(bytes);
}
fn base64_decode(heap: allocator, text: &[]u8, limit: i64) -> std_bytes::Built {
    if len_slice(text) % 4u64 != 0u64 {
        return new std_bytes::Built.err(failure());
    }
    let mut bytes = try std_bytes::create(heap, limit);
    let mut i = 0u64;
    while i < len_slice(text) {
        let a = unsextet(read_slice(text, i));
        let b = unsextet(read_slice(text, i + 1u64));
        let c = unsextet(read_slice(text, i + 2u64));
        let d = unsextet(read_slice(text, i + 3u64));
        let cp = read_slice(text, i + 2u64) == 61u8;
        let dp = read_slice(text, i + 3u64) == 61u8;
        if a < 0 || b < 0 ||(c < 0 && !cp) ||(d < 0 && !dp) ||(cp && !dp) ||((cp || dp) && i + 4u64 != len_slice(text)) ||(cp && b % 16 != 0) ||(dp && !cp && c % 4 != 0) {
            return new std_bytes::Built.err(failure());
        }
        bytes = try std_strings::push(bytes, cast<u8>(a * 4 + b / 16));
        if !cp {
            bytes = try std_strings::push(bytes, cast<u8>((b % 16) * 16 + c / 4));
            if !dp {
                bytes = try std_strings::push(bytes, cast<u8>((c % 4) * 64 + d));
            }
        }
        i += 4u64;
    }
    return new std_bytes::Built.ok(bytes);
}
