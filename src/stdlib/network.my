# One open stream returned by `connect`. Read and write consume and close it.
# Close consumes it too; a failed completion returns the live owner in Failure.
public resource Connection: network


# One `read` result: up to `N` bytes, the count actually read, and the EOF flag.
public record Chunk[const N: u64]:
    bytes: FixedArray[u8, N]
    length: u64
    eof: bool


# Typed carrier for one acquisition attempt.
public result Connected:
    ok: Connection,
    err: int


# Typed carrier for one read attempt of `N` bytes.
public result Read[const N: u64]:
    ok: Chunk[N],
    err: int


# Typed carrier for one write attempt.
public result Written:
    ok: u64,
    err: int


# The error payload `close` keeps so a failed completion can stay live.
public record Failure:
    resource: Connection
    code: int


# Typed carrier for one completion attempt.
public result Closed:
    ok: bool,
    err: Failure


# A Network stand-in that reaches nothing: every acquisition through it, or
# through a `net.host(...)` narrowing of it, fails with `denied_here`. It grants
# no real authority, so building one needs no capability and is not an effect.
public func denied() -> Network:
    return __stand_in[Network](0)


# The `Connected.err` code a stand-in Network answers every request with.
public func denied_here() -> int:
    return 6


# A readable reason for a `Connected.err` code.
public func describe(code: int) -> str:
    if code == 1:
        return "no network authority is available"
    if code == 2:
        return "denied: outside the granted endpoints"
    if code == 4:
        return "too many connections are open"
    if code == denied_here():
        return "network access is denied in this context: this Network is a deterministic stand-in"
    return "failed: the endpoint could not be reached"


# Connect through a Network already narrowed to a single endpoint. The narrowed
# capability pins the request, so no endpoint string is passed here.
public func connect(net: Network) -> Connected effects(network):
    const request = FixedArray[u8, 1]([0u8])
    return acquire_resource[Connected](net, request)


# Consume a live connection and read up to `N` bytes; EOF is reported in the chunk.
public func read[const N: u64](connection: Connection) -> Read[N] effects(network):
    mut owned_connection = connection
    return read_resource[Read[N]](owned_connection)


# Consume a live connection, write fixed bytes, and report the accepted count.
public func write[const N: u64](connection: Connection, data: FixedArray[u8, N]) -> Written effects(network):
    mut owned_connection = connection
    return write_resource[Written](owned_connection, data)


# Complete a connection, releasing its host handle on success.
public func close(connection: Connection) -> Closed effects(network):
    return complete_resource[Closed](connection)
