module std_graph;
export Edge;
export prepare;
export ready;
export take_ready;
export complete;
export finished;
export stalled;
struct Edge {
    from: u64,
    to: u64
}
fn prepare(state: &mut []i64, edges: &[]Edge) -> bool noalloc {
    let count = len_slice(state);
    if len_slice(edges) > 9223372036854775807u64 {
        return false;
    }
    let mut i = 0u64;
    while i < len_slice(edges) {
        let edge = read_slice(edges, i);
        if edge.from >= count || edge.to >= count {
            return false;
        }
        i += 1u64;
    }
    i = 0u64;
    while i < count {
        write_slice(state, i, 0);
        i += 1u64;
    }
    i = 0u64;
    while i < len_slice(edges) {
        let edge = read_slice(edges, i);
        write_slice(state, edge.to, read_slice(state, edge.to) + 1);
        i += 1u64;
    }
    return true;
}
fn ready(state: &[]i64, node: u64) -> bool noalloc {
    if node >= len_slice(state) {
        return false;
    }
    return read_slice(state, node) == 0;
}
fn take_ready(state: &mut []i64, node: u64) -> bool noalloc {
    if !ready(state, node) {
        return false;
    }
    write_slice(state, node, - 2);
    return true;
}
fn complete(state: &mut []i64, edges: &[]Edge, node: u64) -> bool noalloc {
    if node >= len_slice(state) {
        return false;
    }
    if read_slice(state, node) != - 2 {
        return false;
    }
    let mut i = 0u64;
    while i < len_slice(edges) {
        let edge = read_slice(edges, i);
        if edge.from >= len_slice(state) || edge.to >= len_slice(state) {
            return false;
        }
        i += 1u64;
    }
    write_slice(state, node, - 1);
    i = 0u64;
    while i < len_slice(edges) {
        let edge = read_slice(edges, i);
        if edge.from == node {
            write_slice(state, edge.to, read_slice(state, edge.to) - 1);
        }
        i += 1u64;
    }
    return true;
}
fn finished(state: &[]i64) -> bool noalloc {
    let mut i = 0u64;
    while i < len_slice(state) {
        if read_slice(state, i) != - 1 {
            return false;
        }
        i += 1u64;
    }
    return true;
}
fn stalled(state: &[]i64) -> bool noalloc {
    let mut blocked = false;
    let mut i = 0u64;
    while i < len_slice(state) {
        let value = read_slice(state, i);
        if value == 0 || value == - 2 {
            return false;
        }
        if value > 0 {
            blocked = true;
        }
        i += 1u64;
    }
    return blocked;
}
