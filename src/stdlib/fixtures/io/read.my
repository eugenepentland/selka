module main;
import std_io;
import std_fs;
fn main(heap: allocator, fs: filesystem_cap) -> i64 {
    match std_fs::open(heap, fs, "data", new std_fs::Mode.read) {
        std_fs::Open.err(e) => {
            return - 10 - e.code;
        },
        std_fs::Open.ok(file) => {
            let mut bytes = new [4]u8[0u8, 0u8, 0u8, 0u8];
            borrow mut bytes[0..4] as view {
                match std_io::read_exact(std_io::reader(file), view) {
                    std_io::Reading.ok(discard) => {
                        return - 1;
                    },
                    std_io::Reading.err(failure) => {
                        let cause = read_field(failure, cause);
                        let progress = read_field(failure, progress);
                        if cause.kind == new std_io::Kind.no_progress {
                            discard failure;
                            return 10 + cast<i64>(progress);
                        }
                        if cause.kind == new std_io::Kind.provider {
                            discard failure;
                            return 20 + cast<i64>(progress);
                        }
                        if cause.kind != new std_io::Kind.unexpected_eof {
                            discard failure;
                            return - 2;
                        }
                        discard failure;
                        if read_slice(view, 0) != 97u8 || read_slice(view, 2) != 99u8 {
                            return - 3;
                        }
                        return cast<i64>(progress);
                    }
                }
            }
        }
    }
}
