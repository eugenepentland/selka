module main;
import std_io as io;
import std_fs as fs;
fn start(file: io::File) -> i64 {
    match io::write_all(io::writer(file), "012345678901234567890123456789012345678901234567890123456789") {
        io::Writing.err(discard) => {
            return - 1;
        },
        io::Writing.ok(first) => {
            if read_field(first, progress) != 60u64 {
                return - 2;
            }
            match io::write_all(take_field(first, writer), "ABCDEFGH") {
                io::Writing.ok(discard) => {
                    return - 3;
                },
                io::Writing.err(failure) => {
                    if read_field(failure, progress) != 4u64 {
                        return - 4;
                    }
                    let retry = take_field(failure, writer);
                    if read_field(retry, length) != 62u64 {
                        return - 5;
                    }
                    match io::write_all(retry, "EFGH") {
                        io::Writing.err(discard) => {
                            return - 6;
                        },
                        io::Writing.ok(last) => {
                            if read_field(last, progress) != 4u64 {
                                return - 7;
                            }
                            match io::finish(take_field(last, writer)) {
                                io::Finished.err(discard) => {
                                    return - 8;
                                },
                                io::Finished.ok(n) => {
                                    if n != 2u64 {
                                        return - 9;
                                    }
                                    return 42;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
fn main(heap: allocator, cap: filesystem_cap) -> i64 {
    match fs::open(heap, cap, "data", new fs::Mode.write_existing) {
        fs::Open.err(discard) => {
            return - 10;
        },
        fs::Open.ok(file) => {
            return start(file);
        }
    }
}
