module main;
import std_collections as c;
import std_map as m;
result Answer {
    ok: i64,
    err: i64
}
fn positive(n: i64) -> bool effects() {
    return n > 0;
}
fn work(heap: allocator) -> Answer {
    let mut values = try c::vector::< i64 >(heap, 5u64);
    borrow mut values as v {
        let input = new [5]i64[2, - 1, 2, 3, - 1];
        borrow input[0..5] as s {
            discard try c::append_many::< i64 >(v, s);
        }
        let extra = new [1]i64[99];
        borrow extra[0..1] as s {
            match c::append_many::< i64 >(v, s) {
                c::Status.ok(discard) => {
                    return new Answer.err(90);
                },
                c::Status.err(discard) => {}
            }
        }
        discard try c::dedup::< i64 >(v);
        if len_buffer(v) != 3u64 {
            return new Answer.err(91);
        }
        discard try c::filter_i64(v, positive);
        if len_buffer(v) != 2u64 || read_buffer(v, 0) != 2 || read_buffer(v, 1) != 3 {
            return new Answer.err(92);
        }
        discard try c::clear::< i64 >(v);
        discard try c::clear::< i64 >(v);
    }
    let mut map = try m::create::< i64,
    i64 >(heap, 1u64);
    borrow mut map as v {
        if m::put_mut::< i64,
        i64 >(v, 2, 4) != new m::PutStatus.inserted {
            return new Answer.err(93);
        }
        if m::put_mut::< i64,
        i64 >(v, 3, 9) != new m::PutStatus.full {
            return new Answer.err(94);
        }
        if m::put_mut::< i64,
        i64 >(v, 2, 7) != new m::PutStatus.replaced {
            return new Answer.err(95);
        }
        match m::lookup::< i64,
        i64 >(v, 2) {
            m::Value<i64>.none => {
                return new Answer.err(96);
            },
            m::Value<i64>.some(n) => {
                if n != 7 {
                    return new Answer.err(97);
                }
            }
        }
        match m::remove_mut::< i64,
        i64 >(v, 2) {
            m::Value<i64>.none => {
                return new Answer.err(98);
            },
            m::Value<i64>.some(n) => {
                if n != 7 {
                    return new Answer.err(99);
                }
            }
        }
        discard try m::clear::< i64,
        i64 >(v);
    }
    return new Answer.ok(42);
}
fn main(heap: allocator) -> i64 {
    match work(heap) {
        Answer.ok(n) => {
            return n;
        },
        Answer.err(e) => {
            return e;
        }
    }
}
