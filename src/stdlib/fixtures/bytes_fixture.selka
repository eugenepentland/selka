import bytes

func main() -> int:
    const data = b" a,b ,c "
    if not bytes.starts_with(data, b" ") or not bytes.ends_with(data, b" "):
        return 1
    if bytes.starts_with(b"abc", b"z") or bytes.ends_with(b"abc", b"z"):
        return 2
    const stripped = bytes.strip(data)
    if stripped != b"a,b ,c":
        return 3
    if bytes.lstrip(data) != b"a,b ,c ":
        return 4
    if bytes.rstrip(data) != b" a,b ,c":
        return 5
    if bytes.split(stripped, b",") != [b"a", b"b ", b"c"]:
        return 6
    if bytes.join([b"x", b"y"], b"-") != b"x-y":
        return 7
    if bytes.find(data, b"z") != 0 - 1 or bytes.find(data, b"a") != 1:
        return 8
    if bytes.rfind(data, b"c") != 6 or bytes.count(data, b",") != 2:
        return 9
    if bytes.parse_int_range(b"123", 0, 2) != Some(12):
        return 10
    if bytes.parse_int_range(b"xx7", 2, 3) != Some(7) or bytes.parse_int_range(b"12x", 0, 3) is not None:
        return 11
    if bytes.parse_float_range(b"1.5x", 0, 3) != Some(1.5):
        return 12
    if bytes.scalar_count_range(b"h\xc3\xa9", 0, 3) != Ok(2):
        return 13
    if bytes.scalar_count_range(b"h\xc3\xa9", 0, 2) == Ok(2):
        return 14
    return 42
