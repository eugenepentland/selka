module main;
import std_collections as c;
fn before(context: &[]i64, a: i64, b: i64) -> bool effects() {
    return a * read_slice(context, 0u64) < b * read_slice(context, 0u64);
}
fn check(heap: allocator) -> c::Status {
    let mut values = try c::filled::< i64 >(heap, 16384u64, 0);
    let context = new [1]i64[1];
    let mut round = 0u64;
    while round < 3u64 {
        let mut i = 0u64;
        while i < 16384u64 {
            let mut value = 16383u64 - i;
            if round == 1u64 {
                value =(i * 7919u64) % 16384u64;
            }
            if round == 2u64 {
                value = i % 17u64;
            }
            discard try write_buffer<c::Status>(values, i, cast<i64>(value));
            i += 1u64;
        }
        borrow context[0..1] as ctx {
            borrow mut values[0..16384] as items {
                discard c::sort_by::< i64,
                i64 >(items, ctx, before);
                let mut j = 1u64;
                while j < 16384u64 {
                    if read_slice(items, j - 1u64) > read_slice(items, j) {
                        return new c::Status.err(- 1);
                    }
                    j += 1u64;
                }
                if round < 2u64 &&(read_slice(items, 0u64) != 0 || read_slice(items, 16383u64) != 16383) {
                    return new c::Status.err(- 2);
                }
            }
        }
        round += 1u64;
    }
    return new c::Status.ok(true);
}
fn main(heap: allocator) -> i64 {
    match check(heap) {
        c::Status.ok(discard) => {
            return 42;
        },
        c::Status.err(e) => {
            return e;
        }
    }
}
