module main;
import std_order as o;
import std_ascii as a;
import std_iter as it;
import std_graph as g;
import std_counter as c;
import std_hash_bytes as h;
fn item(value: i64) -> o::Item {
    return new o::Item {
        value: value,
        first: cast<u64>(value),
        first_len: 1u64,
        second: 0u64,
        second_len: 0u64
    };
}
fn check_order() -> i64 {
    let keys = new [5]i64[9, 4, 6, 1, 4];
    let mut indices = new [7]o::Item[item(0), item(0), item(1), item(2), item(3), item(4), item(0)];
    borrow keys[0..5] as k {
        borrow mut indices[0..7] as v {
            if !o::sort(k, v, 1u64, 5u64) {
                return - 1;
            }
            if read_slice(v, 0).value != 0 || read_slice(v, 6).value != 0 {
                return - 2;
            }
            let mut i = 2u64;
            while i < 6u64 {
                if o::compare(k, read_slice(v, i), read_slice(v, i - 1u64)) < 0 {
                    return - 3;
                }
                i += 1u64;
            }
            if o::sort(k, v, 6u64, 2u64) {
                return - 4;
            }
            if !o::sort(k, v, 7u64, 0u64) {
                return - 5;
            }
            if o::lower_bound(k, v, 1u64, 5u64, item(4)) != 2u64 || o::equal_run_end(k, v, 2u64, 6u64) != 4u64 {
                return - 6;
            }
        }
        let mut heap = new [5]o::Item[item(0), item(0), item(0), item(0), item(0)];
        borrow mut heap[0..5] as v {
            let mut i = 0u64;
            while i < 5u64 {
                if !o::heap_push(k, v, i, item(cast<i64>(i))) {
                    return - 7;
                }
                i += 1u64;
            }
            if o::heap_push(k, v, 5u64, item(0)) {
                return - 8;
            }
            let mut previous = - 1;
            while i > 0u64 {
                let p = o::heap_pop(k, v, i, item(0));
                if !p.found || read_slice(k, p.value.value) < previous {
                    return - 9;
                }
                previous = read_slice(k, p.value.value);
                i = p.count;
            }
            if o::heap_pop(k, v, 0u64, item(0)).found {
                return - 10;
            }
        }
    }
    return 0;
}
fn check_ranges() -> i64 {
    let data = new [5]i64[97, 98, 97, 99, 0];
    let empty = new o::Item {
        value: 10,
        first: 5u64,
        first_len: 0u64,
        second: 5u64,
        second_len: 0u64
    };
    let first_item = new o::Item {
        value: 11,
        first: 0u64,
        first_len: 1u64,
        second: 1u64,
        second_len: 1u64
    };
    let b = new o::Item {
        value: 12,
        first: 2u64,
        first_len: 1u64,
        second: 3u64,
        second_len: 1u64
    };
    let invalid = new o::Item {
        value: 13,
        first: 18446744073709551615u64,
        first_len: 1u64,
        second: 0u64,
        second_len: 0u64
    };
    let mut values = new [3]o::Item[b, first_item, empty];
    borrow data[0..5] as text {
        if o::compare(text, first_item, b) >= 0 || o::compare(text, empty, first_item) >= 0 || o::valid(text, invalid) {
            return - 50;
        }
        borrow mut values[0..3] as v {
            if !o::sort(text, v, 0u64, 3u64) || read_slice(v, 0u64).value != 10 || read_slice(v, 2u64).value != 12 {
                return - 51;
            }
            write_slice(v, 1u64, invalid);
            if o::sort(text, v, 0u64, 3u64) || read_slice(v, 0u64).value != 10 || read_slice(v, 2u64).value != 12 {
                return - 52;
            }
            if o::sort(text, v, 18446744073709551615u64, 1u64) {
                return - 53;
            }
            if o::heap_push(text, v, 0u64, invalid) {
                return - 54;
            }
        }
    }
    return 0;
}
fn check_graph() -> i64 {
    let edges = new [4]g::Edge[new g::Edge {
        from: 0u64,
        to: 2u64
    }, new g::Edge {
        from: 1u64,
        to: 2u64
    }, new g::Edge {
        from: 2u64,
        to: 3u64
    }, new g::Edge {
        from: 2u64,
        to: 3u64
    }];
    let mut state = new [4]i64[9, 9, 9, 9];
    borrow edges[0..4] as e {
        borrow mut state[0..4] as s {
            if !g::prepare(s, e) || g::finished(s) || g::stalled(s) {
                return - 20;
            }
            if !g::take_ready(s, 0u64) || g::take_ready(s, 0u64) || !g::take_ready(s, 1u64) {
                return - 21;
            }
            if !g::complete(s, e, 0u64) || g::ready(s, 2u64) || g::complete(s, e, 0u64) {
                return - 22;
            }
            if !g::complete(s, e, 1u64) || !g::take_ready(s, 2u64) || !g::complete(s, e, 2u64) {
                return - 23;
            }
            if !g::take_ready(s, 3u64) || !g::complete(s, e, 3u64) || !g::finished(s) {
                return - 24;
            }
        }
    }
    let cycle = new [1]g::Edge[new g::Edge {
        from: 0u64,
        to: 0u64
    }];
    borrow cycle[0..1] as e {
        borrow mut state[0..1] as s {
            if !g::prepare(s, e) || !g::stalled(s) {
                return - 25;
            }
        }
    }
    return 0;
}
fn counter(heap: allocator) -> h::Created<u64> {
    let mut counts = try h::create::< u64 >(heap, 1u64);
    let key = try h::from_bytes("a");
    let other = try h::from_bytes("b");
    borrow mut counts as view {
        if c::add_bytes(view, key, 18446744073709551615u64) != new c::Status.ok {
            return new h::Created<u64>.err(- 30);
        }
        if c::add_bytes(view, key, 1u64) != new c::Status.overflow || c::get_bytes(view, key) != 18446744073709551615u64 {
            return new h::Created<u64>.err(- 31);
        }
        if c::add_bytes(view, other, 1u64) != new c::Status.full || c::get_bytes(view, other) != 0u64 {
            return new h::Created<u64>.err(- 32);
        }
    }
    return new h::Created<u64>.ok(counts);
}
fn main(heap: allocator) -> i64 {
    let ordered = check_order();
    if ordered != 0 {
        return ordered;
    }
    let ranges = check_ranges();
    if ranges != 0 {
        return ranges;
    }
    let graph = check_graph();
    if graph != 0 {
        return graph;
    }
    match counter(heap) {
        h::Created<u64>.err(error) => {
            return error;
        },
        h::Created<u64>.ok(discard) => {}
    }
    let head = new a::Class {
        lower: true,
        upper: false,
        digit: false,
        underscore: false,
        hyphen: false
    };
    let tail = new a::Class {
        lower: true,
        upper: false,
        digit: true,
        underscore: true,
        hyphen: true
    };
    if !a::matches::< u8 >("a_9-z", head, tail, 1u64, 32u64) {
        return - 40;
    }
    if a::matches::< u8 >("A", head, tail, 1u64, 32u64) || a::matches::< u8 >("", head, tail, 1u64, 32u64) {
        return - 41;
    }
    let invalid = new [2]i64[97, - 1];
    borrow invalid[0..2] as text {
        if a::matches::< i64 >(text, head, tail, 1u64, 32u64) {
            return - 42;
        }
    }
    let mut p = it::pairs(4u64);
    let mut count = 0;
    while !p.done {
        if p.first >= p.second || p.second >= 4u64 {
            return - 43;
        }
        count += 1;
        p = it::next_pair(p);
    }
    if count != 6 || !it::pairs(0u64).done || !it::pairs(1u64).done {
        return - 44;
    }
    return 42;
}
