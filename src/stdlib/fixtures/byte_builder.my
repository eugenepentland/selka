import byte_builder

func main() -> int:
    mut output = byte_builder.create()
    byte_builder.append(mut output, b"head:")
    if not byte_builder.append_byte(mut output, 0):
        return 1
    if byte_builder.append_byte(mut output, 256):
        return 2
    byte_builder.append_text(mut output, "hé")
    if byte_builder.append_spaces(mut output, 0 - 1):
        return 3
    if not byte_builder.append_spaces(mut output, 66):
        return 4
    mut indent = byte_builder.create()
    if not byte_builder.append_spaces(mut indent, 63):
        return 11
    mut indentation = byte_builder.finish(indent)
    if len(indentation) != 63:
        return 12
    for octet in indentation:
        if octet != 32:
            return 13
    mut first = byte_builder.finish(output)
    mut expected = b"head:\0h\xc3\xa9                                                                  "
    if first != expected:
        return 5
    if not byte_builder.append_byte(mut output, 33):
        return 6
    mut second = byte_builder.finish(output)
    if first != expected:
        return 7
    if second != expected + b"!":
        return 8
    byte_builder.append(mut output, second)
    mut third = byte_builder.finish(output)
    if third != second + second:
        return 9
    if byte_builder.finish(output) != third:
        return 10

    # Range appends: the front, a middle interval and the tail of one span
    # rebuild that span exactly, and an empty range changes nothing.
    mut span = b"0123456789"
    mut ranged = byte_builder.create()
    if not byte_builder.append_range(mut ranged, span, 0, 3):
        return 14
    if not byte_builder.append_range(mut ranged, span, 3, 8):
        return 15
    if not byte_builder.append_range(mut ranged, span, 8, 10):
        return 16
    if not byte_builder.append_range(mut ranged, span, 4, 4):
        return 17
    if byte_builder.finish(ranged) != span:
        return 18
    if not byte_builder.append_range(mut ranged, span, 4, 6):
        return 19
    if byte_builder.finish(ranged) != span + b"45":
        return 20

    # A rejected range leaves the builder unchanged.
    if byte_builder.append_range(mut ranged, span, 0 - 1, 4):
        return 21
    if byte_builder.append_range(mut ranged, span, 4, 3):
        return 22
    if byte_builder.append_range(mut ranged, span, 4, 11):
        return 23
    if byte_builder.append_range(mut ranged, span, 0, 0 - 1):
        return 24
    if byte_builder.append_range(mut ranged, span, 11, 11):
        return 25
    if byte_builder.finish(ranged) != span + b"45":
        return 26

    # Multi-byte UTF-8: a two-byte scalar, a four-byte emoji and another
    # four-byte scalar outside the surrogate range.
    mut scalars = byte_builder.create()
    byte_builder.append_text(mut scalars, "λ")
    byte_builder.append_text(mut scalars, "😀")
    byte_builder.append_text(mut scalars, "𐍈")
    if byte_builder.finish(scalars) != b"\xce\xbb\xf0\x9f\x98\x80\xf0\x90\x8d\x88":
        return 27

    # Integer spellings: zero, a positive value, negatives, both extrema and
    # values whose spelling ends in zeros.
    mut numbers = byte_builder.create()
    byte_builder.append_int(mut numbers, 0)
    byte_builder.append_int(mut numbers, 7)
    byte_builder.append_int(mut numbers, 0 - 1234)
    byte_builder.append_int(mut numbers, 1000000)
    byte_builder.append_int(mut numbers, 9223372036854775807)
    byte_builder.append_int(mut numbers, -9223372036854775808)
    byte_builder.append_int(mut numbers, 0 - 10)
    byte_builder.append_int(mut numbers, 0 - 100)
    mut spelling = b"07-123410000009223372036854775807-9223372036854775808-10-100"
    if byte_builder.finish(numbers) != spelling:
        return 28
    mut frozen = byte_builder.finish(numbers)
    byte_builder.append_int(mut numbers, 0 - 5)
    if byte_builder.finish(numbers) != spelling + b"-5":
        return 29
    if frozen != spelling:
        return 30

    # Float spellings: the canonical text `str(value)` prints, written into the
    # buffer's capacity, with the non-finite values spelled by name.
    mut floats = byte_builder.create()
    for value in [0.1, 2.5, 0.0 - 2.5e-7, 1.0 / 3.0]:
        if not byte_builder.append_float(mut floats, value):
            return 50
        if not byte_builder.append_byte(mut floats, 32):
            return 51
    if byte_builder.finish(floats) != b"0.1 2.5 -0.00000025 0.3333333333333333 ":
        return 48
    mut huge = 1e300 * 1e300
    mut nonfinite = byte_builder.create()
    for value in [huge, 0.0 - huge]:
        if not byte_builder.append_float(mut nonfinite, value):
            return 52
        if not byte_builder.append_byte(mut nonfinite, 32):
            return 53
    if byte_builder.finish(nonfinite) != b"inf -inf ":
        return 49

    # Reserve changes neither the finished length nor the content, and the
    # builder keeps appending afterwards.
    mut reserved = byte_builder.create()
    byte_builder.append(mut reserved, b"seed")
    if not byte_builder.reserve(mut reserved, 4096):
        return 31
    if byte_builder.finish(reserved) != b"seed":
        return 32
    if not byte_builder.reserve(mut reserved, 0):
        return 33
    if byte_builder.reserve(mut reserved, 0 - 1):
        return 34
    if byte_builder.finish(reserved) != b"seed":
        return 35
    byte_builder.append(mut reserved, b"tail")
    if byte_builder.finish(reserved) != b"seedtail":
        return 36

    # Growth past several capacity doublings, with an interleaved snapshot
    # that a later append must not change.
    mut growing = byte_builder.create()
    mut total = 0
    mut index = 0
    while index < 100000:
        if not byte_builder.append_byte(mut growing, index % 256):
            return 37
        total += index % 256
        index += 1
    mut early = byte_builder.finish(growing)
    if len(early) != 100000:
        return 38
    if total != 12742320:
        return 39
    if not byte_builder.append_byte(mut growing, 65):
        return 40
    mut grown = byte_builder.finish(growing)
    if len(grown) != 100001:
        return 41
    if len(early) != 100000 or early[0] != 0 or early[255] != 255 or early[99999] != 159:
        return 45
    if grown[100000] != 65 or grown[99999] != 159 or grown[0] != 0:
        return 46
    if early[99999] != 159 or early[256] != 0:
        return 47

    return len(grown) - 99959
