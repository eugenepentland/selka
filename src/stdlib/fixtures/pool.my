module main
import pool


class Node:
    label: str
    weight: int


def value_of(store: pool.Pool[int], handle: pool.Handle[int]) -> int:
    match pool.get(store, handle):
        case Some(value):
            return value
        case None:
            return 0 - 1


def lifecycle() -> int:
    seed: list[int] = []
    store = pool.create(seed)
    first = pool.insert(store, 10)
    second = pool.insert(store, 20)
    if pool.count(store) != 2 or pool.capacity(store) != 2:
        return 1
    if value_of(store, first) != 10 or value_of(store, second) != 20:
        return 2
    if not pool.occupied(store, first) or not pool.set(store, first, 11):
        return 3
    if value_of(store, first) != 11:
        return 4
    if not pool.remove(store, first) or pool.remove(store, first):
        return 5
    if value_of(store, first) != 0 - 1 or pool.set(store, first, 99):
        return 6
    if pool.occupied(store, first) or pool.count(store) != 1:
        return 7
    third = pool.insert(store, 30)
    if pool.capacity(store) != 2 or value_of(store, third) != 30:
        return 8
    if value_of(store, first) != 0 - 1:
        return 9
    return 0


def sharing() -> int:
    store = pool.create([1, 2, 3])
    if pool.count(store) != 3:
        return 20
    alias = store
    _ = pool.insert(alias, 40)
    if pool.count(store) != 4 or pool.capacity(store) != 4:
        return 21
    live = pool.handles(store)
    total = 0
    for handle in live:
        total += value_of(store, handle)
    if len(live) != 4 or total != 46:
        return 22
    other: list[int] = []
    outside = pool.create(other)
    foreign = pool.insert(outside, 7)
    _ = pool.remove(store, pool.handles(store)[0])
    if pool.count(store) != 3:
        return 23
    if value_of(outside, foreign) != 7:
        return 24
    return 0


def records() -> int:
    empty: list[Node] = []
    store = pool.create(empty)
    handle = pool.insert(store, Node(label="a", weight=2))
    match pool.get(store, handle):
        case Some(node):
            if node.label != "a" or node.weight != 2:
                return 30
        case None:
            return 31
    if not pool.set(store, handle, Node(label="b", weight=3)):
        return 32
    match pool.get(store, handle):
        case Some(node):
            if node.label != "b":
                return 33
        case None:
            return 34
    if not pool.remove(store, handle):
        return 35
    match pool.get(store, handle):
        case Some(_):
            return 36
        case None:
            _ = 0
    return 0


def churn() -> int:
    seed: list[int] = []
    store = pool.create(seed)
    handles: list[pool.Handle[int]] = []
    index = 0
    while index < 32:
        handles.append(pool.insert(store, index))
        index += 1
    index = 0
    while index < 32:
        if index % 2 == 0:
            if not pool.remove(store, handles[index]):
                return 40
        index += 1
    if pool.count(store) != 16 or pool.capacity(store) != 32:
        return 41
    index = 0
    while index < 16:
        _ = pool.insert(store, 100 + index)
        index += 1
    if pool.capacity(store) != 32 or pool.count(store) != 32:
        return 42
    index = 0
    while index < 32:
        if index % 2 == 0 and pool.occupied(store, handles[index]):
            return 43
        if index % 2 == 1 and not pool.occupied(store, handles[index]):
            return 44
        index += 1
    return 0


def main() -> int:
    checks = [lifecycle(), sharing(), records(), churn()]
    for value in checks:
        if value != 0:
            return value
    return 42
