module main;
import std_hash as h;
import std_hash_set as set;
import std_hash_byte_set as bs;
import std_borrowed_set as small;
import std_hash_map as m;
import std_hash_bytes as b;
import std_map as linear;
result Answer {
    ok: i64,
    err: i64
}
fn work(heap: allocator) -> Answer {
    let mut empty = try m::create::< i64 >(heap, 0u64);
    borrow mut empty as view {
        if m::put::< i64 >(view, 0u64, 1) != new linear::PutStatus.full {
            return new Answer.err(104);
        }
        match m::lookup::< i64 >(view, 0u64) {
            linear::Value<i64>.none => {},
            linear::Value<i64>.some(discard) => {
                return new Answer.err(105);
            }
        }
    }
    let good = try b::from_bytes("");
    let bad = update(good) {
        length: 257u64
    };
    if b::valid(bad) || b::key_equal(bad, bad) || b::key_hash(bad) != 0u64 {
        return new Answer.err(106);
    }
    let mut guarded = try b::create::< i64 >(heap, 1u64);
    borrow mut guarded as view {
        if b::put::< i64 >(view, bad, 1) != new b::PutStatus.invalid {
            return new Answer.err(107);
        }
        if b::count::< i64 >(view) != 0u64 {
            return new Answer.err(108);
        }
        match b::lookup::< i64 >(view, bad) {
            linear::Value<i64>.none => {},
            linear::Value<i64>.some(discard) => {
                return new Answer.err(109);
            }
        }
    }
    if h::bytes("") != 14695981039346656037u64 || h::bytes("a") != 12638187200555641996u64 {
        return new Answer.err(90);
    }
    let mut numbers = try set::create(heap, 1u64);
    borrow mut numbers as s {
        discard set::insert(s, 8u64);
        if !set::contains(s, 8u64) || !set::remove(s, 8u64) {
            return new Answer.err(101);
        }
        discard try set::clear(s);
    }
    let mut names = try bs::create(heap, 1u64);
    borrow mut names as s {
        let k = try b::from_bytes("hi");
        discard bs::insert(s, k);
        if !bs::contains(s, k) || !bs::remove(s, k) {
            return new Answer.err(102);
        }
    }
    let mut tiny = try small::create::< i64 >(heap, 1u64);
    borrow mut tiny as s {
        discard small::insert::< i64 >(s, 9);
        if !small::contains::< i64 >(s, 9) || small::remove::< i64 >(s, 9) != new small::Change.changed {
            return new Answer.err(103);
        }
        discard try small::clear::< i64 >(s);
    }
    let mut map = try m::create::< i64 >(heap, 2u64);
    borrow mut map as v {
        if m::put::< i64 >(v, 1u64, 4) != new linear::PutStatus.inserted {
            return new Answer.err(91);
        }
        discard m::put::< i64 >(v, 2u64, 6);
        if m::put::< i64 >(v, 3u64, 7) != new linear::PutStatus.full {
            return new Answer.err(92);
        }
        match m::remove::< i64 >(v, 1u64) {
            linear::Value<i64>.some(n) => {
                if n != 4 {
                    return new Answer.err(93);
                }
            },
            linear::Value<i64>.none => {
                return new Answer.err(94);
            }
        }
        if m::put::< i64 >(v, 2u64, 8) != new linear::PutStatus.replaced {
            return new Answer.err(95);
        }
        if m::put::< i64 >(v, 3u64, 9) != new linear::PutStatus.inserted {
            return new Answer.err(96);
        }
        match m::lookup::< i64 >(v, 2u64) {
            linear::Value<i64>.some(n) => {
                if n != 8 {
                    return new Answer.err(97);
                }
            },
            linear::Value<i64>.none => {
                return new Answer.err(98);
            }
        }
        if m::count::< i64 >(v) != 2u64 {
            return new Answer.err(99);
        }
        discard try m::clear::< i64 >(v);
    }
    let mut bytes = try b::create::< i64 >(heap, 1u64);
    let key = try b::from_bytes("hello");
    borrow mut bytes as v {
        discard b::put::< i64 >(v, key, 42);
        match b::lookup::< i64 >(v, try b::from_bytes("hello")) {
            linear::Value<i64>.some(n) => {
                return new Answer.ok(n);
            },
            linear::Value<i64>.none => {
                return new Answer.err(100);
            }
        }
    }
}
fn main(heap: allocator) -> i64 {
    match work(heap) {
        Answer.ok(n) => {
            return n;
        },
        Answer.err(e) => {
            return e;
        }
    }
}
