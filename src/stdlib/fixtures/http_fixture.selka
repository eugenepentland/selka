import bytes
import http
import strings


func parse_request_ok() -> bool:
    mut wire = "GET /hello?x=1 HTTP/1.1\r\nHost: example.test\r\nContent-Length: 5\r\n\r\nhello"
    match http.parse_request(strings.encode(wire)):
        case Ok(request):
            if request.method != "GET" or request.target != "/hello?x=1":
                return False
            if request.version != "HTTP/1.1" or request.body != b"hello":
                return False
            if http.path(request) != "/hello" or http.query(request) != "x=1":
                return False
            match http.header(request.headers, "HOST"):
                case Some(value):
                    return value == "example.test"
                case None:
                    return False
        case Err(_):
            return False


func write_request_ok() -> bool:
    mut headers: http.Header[] = [http.Header(name="Host", value="example.test")]
    mut request = http.Request(method="POST", target="/submit", version="HTTP/1.1",
                               headers=own headers, body=b"hello")
    match http.write_request(request):
        case Ok(wire):
            if bytes.find(wire, b"Content-Length: 5\r\n") < 0:
                return False
            match http.parse_request(wire):
                case Ok(parsed):
                    return parsed.method == "POST" and parsed.target == "/submit" and parsed.body == b"hello"
                case Err(_):
                    return False
        case Err(_):
            return False


func chunked_response_ok() -> bool:
    mut wire = b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n6\r\n world\r\n0\r\nX-Trailer: yes\r\n\r\n"
    match http.parse_response(wire, True):
        case Ok(response):
            if response.status != 200 or response.body != b"hello world":
                return False
            return http.header(response.headers, "transfer-encoding") == Some("chunked")
        case Err(_):
            return False


func close_delimited_response_ok() -> bool:
    mut wire = b"HTTP/1.0 200 OK\r\nServer: test\r\n\r\nplain"
    match http.parse_response(wire, False):
        case Ok(_):
            return False
        case Err(Incomplete):
            match http.parse_response(wire, True):
                case Ok(response):
                    return response.body == b"plain" and response.status == 200
                case Err(_):
                    return False
        case Err(Malformed(value=_)):
            return False
        case Err(BodyTooLarge(value=_)):
            return False
        case Err(HeaderTooLarge(value=_)):
            return False
        case Err(Unsupported(value=_)):
            return False
        case Err(UnsupportedVersion(value=_)):
            return False


func no_body_response_ok() -> bool:
    mut wire = b"HTTP/1.1 204 No Content\r\nContent-Length: 9\r\n\r\nignored!"
    match http.parse_response(wire, False):
        case Ok(response):
            return response.status == 204 and len(response.body) == 0
        case Err(_):
            return False


func conflicting_lengths_refused() -> bool:
    mut wire = b"POST / HTTP/1.1\r\nContent-Length: 1\r\nContent-Length: 2\r\n\r\nx"
    match http.parse_request(wire):
        case Err(Malformed(value=_)):
            return True
        case Err(BodyTooLarge(value=_)):
            return True
        case Err(HeaderTooLarge(value=_)):
            return True
        case Ok(_):
            return False
        case Err(Incomplete):
            return False
        case Err(Unsupported(value=_)):
            return False
        case Err(UnsupportedVersion(value=_)):
            return False


func invalid_header_name_refused() -> bool:
    mut wire = b"GET / HTTP/1.1\r\nBad Name: value\r\n\r\n"
    match http.parse_request(wire):
        case Err(Malformed(value=_)):
            return True
        case Err(BodyTooLarge(value=_)):
            return True
        case Err(HeaderTooLarge(value=_)):
            return True
        case Ok(_):
            return False
        case Err(Incomplete):
            return False
        case Err(Unsupported(value=_)):
            return False
        case Err(UnsupportedVersion(value=_)):
            return False


func mismatched_length_refused() -> bool:
    mut headers: http.Header[] = [http.Header(name="Content-Length", value="4")]
    mut response = http.Response(version="HTTP/1.1", status=200, reason="OK",
                                 headers=own headers, body=b"hi")
    match http.write_response(response):
        case Err(Malformed(value=_)):
            return True
        case Err(BodyTooLarge(value=_)):
            return True
        case Err(HeaderTooLarge(value=_)):
            return True
        case Ok(_):
            return False
        case Err(Incomplete):
            return False
        case Err(Unsupported(value=_)):
            return False
        case Err(UnsupportedVersion(value=_)):
            return False


func write_response_ok() -> bool:
    mut headers: http.Header[] = [http.Header(name="Content-Type", value="text/plain")]
    mut response = http.Response(version="HTTP/1.1", status=201, reason="Created",
                                 headers=own headers, body=b"ok")
    match http.write_response(response):
        case Ok(wire):
            match http.parse_response(wire, False):
                case Ok(parsed):
                    return parsed.status == 201 and parsed.reason == "Created" and parsed.body == b"ok"
                case Err(_):
                    return False
        case Err(_):
            return False


func main() -> int:
    if not parse_request_ok():
        return 1
    if not write_request_ok():
        return 2
    if not chunked_response_ok():
        return 3
    if not close_delimited_response_ok():
        return 4
    if not no_body_response_ok():
        return 5
    if not conflicting_lengths_refused():
        return 6
    if not invalid_header_name_refused():
        return 7
    if not mismatched_length_refused():
        return 8
    if not write_response_ok():
        return 9
    return 42
