// Expected decimals independently calculated from exact Python Fraction.from_float.
module main;
import std_format as f;
import std_math as m;
import std_bytes as b;
import std_result as r;
fn same(value: b::Bytes, expected: &[]u8) -> bool {
    borrow value[0..len_buffer(value)] as text {
        return b::compare(text, expected) == 0;
    }
}
fn checks(heap: allocator) -> r::Result<i64, r::Error> {
    if !same(try f::fixed(heap, m::from_bits(0u64), 0u64, 40), "0") {
        return new r::Result<i64, r::Error>.ok(- 1);
    }
    if !same(try f::fixed(heap, m::from_bits(0u64), 1u64, 40), "0.0") {
        return new r::Result<i64, r::Error>.ok(- 1);
    }
    if !same(try f::fixed(heap, m::from_bits(0u64), 9u64, 40), "0.000000000") {
        return new r::Result<i64, r::Error>.ok(- 1);
    }
    if !same(try f::fixed(heap, m::from_bits(9223372036854775808u64), 0u64, 40), "-0") {
        return new r::Result<i64, r::Error>.ok(- 2);
    }
    if !same(try f::fixed(heap, m::from_bits(9223372036854775808u64), 1u64, 40), "-0.0") {
        return new r::Result<i64, r::Error>.ok(- 2);
    }
    if !same(try f::fixed(heap, m::from_bits(9223372036854775808u64), 9u64, 40), "-0.000000000") {
        return new r::Result<i64, r::Error>.ok(- 2);
    }
    if !same(try f::fixed(heap, m::from_bits(1u64), 0u64, 40), "0") {
        return new r::Result<i64, r::Error>.ok(- 3);
    }
    if !same(try f::fixed(heap, m::from_bits(1u64), 1u64, 40), "0.0") {
        return new r::Result<i64, r::Error>.ok(- 3);
    }
    if !same(try f::fixed(heap, m::from_bits(1u64), 9u64, 40), "0.000000000") {
        return new r::Result<i64, r::Error>.ok(- 3);
    }
    if !same(try f::fixed(heap, m::from_bits(4599075939470750515u64), 0u64, 40), "0") {
        return new r::Result<i64, r::Error>.ok(- 4);
    }
    if !same(try f::fixed(heap, m::from_bits(4599075939470750515u64), 1u64, 40), "0.2") {
        return new r::Result<i64, r::Error>.ok(- 4);
    }
    if !same(try f::fixed(heap, m::from_bits(4599075939470750515u64), 9u64, 40), "0.299999999") {
        return new r::Result<i64, r::Error>.ok(- 4);
    }
    if !same(try f::fixed(heap, m::from_bits(4591870180066957722u64), 0u64, 40), "0") {
        return new r::Result<i64, r::Error>.ok(- 5);
    }
    if !same(try f::fixed(heap, m::from_bits(4591870180066957722u64), 1u64, 40), "0.1") {
        return new r::Result<i64, r::Error>.ok(- 5);
    }
    if !same(try f::fixed(heap, m::from_bits(4591870180066957722u64), 9u64, 40), "0.100000000") {
        return new r::Result<i64, r::Error>.ok(- 5);
    }
    if !same(try f::fixed(heap, m::from_bits(4607182418800017407u64), 0u64, 40), "0") {
        return new r::Result<i64, r::Error>.ok(- 6);
    }
    if !same(try f::fixed(heap, m::from_bits(4607182418800017407u64), 1u64, 40), "0.9") {
        return new r::Result<i64, r::Error>.ok(- 6);
    }
    if !same(try f::fixed(heap, m::from_bits(4607182418800017407u64), 9u64, 40), "0.999999999") {
        return new r::Result<i64, r::Error>.ok(- 6);
    }
    if !same(try f::fixed(heap, m::from_bits(4602678819172646912u64), 0u64, 40), "0") {
        return new r::Result<i64, r::Error>.ok(- 7);
    }
    if !same(try f::fixed(heap, m::from_bits(4602678819172646912u64), 1u64, 40), "0.5") {
        return new r::Result<i64, r::Error>.ok(- 7);
    }
    if !same(try f::fixed(heap, m::from_bits(4602678819172646912u64), 9u64, 40), "0.500000000") {
        return new r::Result<i64, r::Error>.ok(- 7);
    }
    if !same(try f::fixed(heap, m::from_bits(4463067230724161535u64), 0u64, 40), "0") {
        return new r::Result<i64, r::Error>.ok(- 8);
    }
    if !same(try f::fixed(heap, m::from_bits(4463067230724161535u64), 1u64, 40), "0.0") {
        return new r::Result<i64, r::Error>.ok(- 8);
    }
    if !same(try f::fixed(heap, m::from_bits(4463067230724161535u64), 9u64, 40), "0.000000000") {
        return new r::Result<i64, r::Error>.ok(- 8);
    }
    if !same(try f::fixed(heap, m::from_bits(4895412794951729151u64), 0u64, 40), "18446744073709549568") {
        return new r::Result<i64, r::Error>.ok(- 9);
    }
    if !same(try f::fixed(heap, m::from_bits(4895412794951729151u64), 1u64, 40), "18446744073709549568.0") {
        return new r::Result<i64, r::Error>.ok(- 9);
    }
    if !same(try f::fixed(heap, m::from_bits(4895412794951729151u64), 9u64, 40), "18446744073709549568.000000000") {
        return new r::Result<i64, r::Error>.ok(- 9);
    }
    if !same(try f::fixed(heap, m::from_bits(13830554455654793215u64), 0u64, 40), "-0") {
        return new r::Result<i64, r::Error>.ok(- 10);
    }
    if !same(try f::fixed(heap, m::from_bits(13830554455654793215u64), 1u64, 40), "-0.9") {
        return new r::Result<i64, r::Error>.ok(- 10);
    }
    if !same(try f::fixed(heap, m::from_bits(13830554455654793215u64), 9u64, 40), "-0.999999999") {
        return new r::Result<i64, r::Error>.ok(- 10);
    }
    return new r::Result<i64, r::Error>.ok(42);
}
fn main(heap: allocator) -> i64 {
    match checks(heap) {
        r::Result<i64, r::Error>.ok(n) => {
            return n;
        },
        r::Result<i64, r::Error>.err(discard) => {
            return - 99;
        }
    }
}
