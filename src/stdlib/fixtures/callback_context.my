module main;
import std_json as j;
import std_collections as c;
struct Item {
    node: i64,
    serial: i64
}
fn before(document: &[]i64, a: Item, b: Item) -> bool effects() {
    let comparison = j::compare(document, a.node, b.node);
    return comparison < 0 ||(comparison == 0 && a.serial < b.serial);
}
fn keep(document: &[]i64, item: Item) -> bool effects() {
    return !j::textis(document, item.node, "z");
}
fn parse(heap: allocator) -> j::Parsed {
    let text = "[\"z\",\"a\",\"m\",\"a\"]";
    let mut bytes = try acquire_buffer<j::Input>(heap, len(text));
    borrow text[0..len(text)] as view {
        let mut i = 0u64;
        while i < len_slice(view) {
            discard try append_buffer<j::Status>(bytes, read_slice(view, i));
            i += 1u64;
        }
    }
    return j::parse(heap, bytes, 4096);
}
fn check(heap: allocator, document: &[]i64) -> c::Status {
    let mut indices = new [4]Item[new Item {
        node: 2,
        serial: 0
    }, new Item {
        node: 3,
        serial: 1
    }, new Item {
        node: 4,
        serial: 2
    }, new Item {
        node: 5,
        serial: 3
    }];
    borrow mut indices[0..4] as items {
        discard c::sort_by::< Item,
        i64 >(items, document, before);
        if read_slice(items, 0).serial != 1 || read_slice(items, 1).serial != 3 || read_slice(items, 2).serial != 2 || read_slice(items, 3).serial != 0 {
            return new c::Status.err(- 1);
        }
        let middle = c::lower_bound_by::< Item,
        i64 >(items, document, new Item {
            node: 4,
            serial: 0
        }, before);
        if middle != 2u64 {
            return new c::Status.err(- 2);
        }
    }
    let mut vector = try c::vector::< Item >(heap, 4u64);
    borrow indices[0..4] as input {
        borrow mut vector as values {
            discard try c::append_many::< Item >(values, input);
        }
    }
    borrow mut vector as values {
        discard try c::filter_by::< Item,
        i64 >(values, document, keep);
    }
    if len_buffer(vector) != 3u64 || read_buffer(vector, 0u64).serial != 1 || read_buffer(vector, 1u64).serial != 3 || read_buffer(vector, 2u64).serial != 2 {
        return new c::Status.err(- 3);
    }
    let mut empty = new [0]Item[];
    borrow mut empty[0..0] as items {
        if c::sort_by::< Item,
        i64 >(items, document, before) != 0u64 || c::lower_bound_by::< Item,
        i64 >(items, document, new Item {
            node: 4,
            serial: 0
        }, before) != 0u64 {
            return new c::Status.err(- 4);
        }
    }
    return new c::Status.ok(true);
}
fn main(heap: allocator) -> i64 {
    match parse(heap) {
        j::Parsed.err(e) => {
            return e;
        },
        j::Parsed.ok(document) => {
            borrow document[0..len_buffer(document)] as context {
                match check(heap, context) {
                    c::Status.err(e) => {
                        return e;
                    },
                    c::Status.ok(discard) => {
                        return 42;
                    }
                }
            }
        }
    }
}
