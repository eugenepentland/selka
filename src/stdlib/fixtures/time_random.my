import random
import time


func streams() -> int:
    mut generator = random.seeded(42)
    mut first = random.next_word(mut generator)
    mut snapshot = generator
    mut second = random.next_word(mut snapshot)
    if first == second:
        return 1
    mut replay = random.seeded(42)
    if random.next_word(mut replay) != first or random.next_word(mut replay) != second:
        return 2
    if random.next_word(mut generator) != second:
        return 3
    mut third = random.next_word(mut snapshot)
    if random.next_word(mut generator) != third or random.next_word(mut replay) != third:
        return 7
    if first != 13679457532755275413u64:
        return 4
    mut seeded = random.seeded(0)
    if random.next_word(mut seeded) != 16294208416658607535u64:
        return 5
    mut top = random.from_word(18446744073709551615u64)
    mut wrapped = random.seeded(0 - 1)
    if random.next_word(mut top) != random.next_word(mut wrapped):
        return 6
    return 0


func fractions() -> int:
    mut generator = random.seeded(7)
    mut draw = 0
    while draw < 500:
        mut value = random.random(mut generator)
        if value < 0.0 or value >= 1.0:
            return 10
        draw += 1
    return 0


func ranges() -> int:
    mut generator = random.seeded(1)
    mut draw = 0
    mut low = 0
    mut high = 0
    while draw < 500:
        match random.randint(mut generator, 0 - 3, 3):
            case Ok(value):
                if value < 0 - 3 or value > 3:
                    return 20
                if value == 0 - 3:
                    low += 1
                if value == 3:
                    high += 1
            case Err(_):
                return 21
        draw += 1
    if low == 0 or high == 0:
        return 22
    match random.randint(mut generator, 5, 4):
        case Ok(_):
            return 23
        case Err(_):
            _ = 0
    match random.randint(mut generator, 0 - 9223372036854775807 - 1, 9223372036854775807):
        case Ok(_):
            _ = 0
        case Err(_):
            return 24
    match random.randint(mut generator, 0 - 9223372036854775807 - 1, 0):
        case Ok(value):
            if value > 0:
                return 25
        case Err(_):
            return 26
    match random.randint(mut generator, 7, 7):
        case Ok(value):
            if value != 7:
                return 27
        case Err(_):
            return 28
    return 0


func permutations() -> int:
    mut generator = random.seeded(5)
    mut items = [1, 2, 3, 4, 5]
    random.shuffle(mut generator, mut items)
    mut total = 0
    for value in items:
        total += value
    if total != 15 or len(items) != 5:
        return 30
    match random.choice(mut generator, items):
        case Some(value):
            if value < 1 or value > 5:
                return 31
        case None:
            return 32
    mut empty: int[] = []
    match random.choice(mut generator, empty):
        case Some(_):
            return 33
        case None:
            _ = 0
    random.shuffle(mut generator, mut empty)
    return 0


func durations() -> int:
    match time.seconds(2):
        case Ok(duration):
            if duration.nanoseconds != 2000000000 or time.to_milliseconds(duration) != 2000:
                return 40
            if time.to_seconds(duration) != 2.0:
                return 41
        case Err(_):
            return 42
    match time.milliseconds(9223372036854):
        case Ok(_):
            _ = 0
        case Err(_):
            return 43
    match time.seconds(9223372037):
        case Ok(_):
            return 44
        case Err(_):
            _ = 0
    match time.microseconds(0 - 9223372036854776):
        case Ok(_):
            return 45
        case Err(_):
            _ = 0
    if time.to_milliseconds(time.nanoseconds(0 - 1500000)) != 0 - 1:
        return 46
    if time.to_milliseconds(time.nanoseconds(0 - 9223372036854775807 - 1)) != 0 - 9223372036854:
        return 47
    if time.compare(time.nanoseconds(1), time.nanoseconds(2)) != 0 - 1:
        return 48
    if time.compare(time.nanoseconds(2), time.nanoseconds(2)) != 0:
        return 49
    return 0


func arithmetic() -> int:
    match time.sum(time.nanoseconds(9223372036854775807), time.nanoseconds(1)):
        case Ok(_):
            return 50
        case Err(_):
            _ = 0
    match time.sum(time.nanoseconds(0 - 9223372036854775807 - 1), time.nanoseconds(0 - 1)):
        case Ok(_):
            return 51
        case Err(_):
            _ = 0
    match time.difference(time.nanoseconds(5), time.nanoseconds(0 - 9223372036854775807 - 1)):
        case Ok(_):
            return 52
        case Err(_):
            _ = 0
    match time.difference(time.nanoseconds(5), time.nanoseconds(2)):
        case Ok(span):
            if span.nanoseconds != 3:
                return 53
        case Err(_):
            return 54
    return 0


func instants() -> int:
    mut start = time.from_unix_nanoseconds(1000)
    match time.after(start, time.nanoseconds(500)):
        case Ok(later):
            if later.unix_nanoseconds != 1500:
                return 60
            if not time.expired(start, later) or time.expired(later, start):
                return 61
            match time.elapsed(start, later):
                case Ok(span):
                    if span.nanoseconds != 500:
                        return 62
                case Err(_):
                    return 63
        case Err(_):
            return 64
    match time.after(time.from_unix_nanoseconds(9223372036854775807), time.nanoseconds(1)):
        case Ok(_):
            return 65
        case Err(_):
            _ = 0
    match time.elapsed(time.from_unix_nanoseconds(10), time.from_unix_nanoseconds(5)):
        case Ok(_):
            return 66
        case Err(_):
            _ = 0
    match time.elapsed(time.from_unix_nanoseconds(0 - 9223372036854775807 - 1), time.from_unix_nanoseconds(9223372036854775807)):
        case Ok(_):
            return 67
        case Err(_):
            _ = 0
    return 0


func main() -> int:
    mut checks = [streams(), fractions(), ranges(), permutations(), durations(), arithmetic(), instants()]
    for value in checks:
        if value != 0:
            return value
    return 0
