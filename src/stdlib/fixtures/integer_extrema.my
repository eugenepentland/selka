module main
import math


def bounds[T: integer](low: T, high: T) -> bool:
    if math.min(low, high) != low or math.min(high, low) != low:
        return False
    if math.max(low, high) != high or math.max(high, low) != high:
        return False
    if math.min(low, low) != low or math.max(high, high) != high:
        return False
    return math.clamp(low, low, high) == low and math.clamp(high, low, high) == high


def widths() -> int:
    if not bounds(cast<i8>(0 - 128), cast<i8>(127)):
        return 1
    if not bounds(cast<i16>(0 - 32768), cast<i16>(32767)):
        return 2
    if not bounds(cast<i32>(0 - 2147483648), cast<i32>(2147483647)):
        return 3
    if not bounds(0 - 9223372036854775807 - 1, 9223372036854775807):
        return 4
    if not bounds(0u8, 255u8):
        return 5
    if not bounds(cast<u16>(0), cast<u16>(65535)):
        return 6
    if not bounds(cast<u32>(0), cast<u32>(4294967295)):
        return 7
    if not bounds(0u64, 18446744073709551615u64):
        return 8
    return 0


def signs() -> int:
    if math.min(0 - 9223372036854775807 - 1, 9223372036854775807) != 0 - 9223372036854775807 - 1:
        return 10
    if math.max(0 - 9, 0 - 1) != 0 - 1 or math.min(0 - 9, 0 - 1) != 0 - 9:
        return 11
    if math.min(5u64, 5u64) != 5u64 or math.max(5u64, 5u64) != 5u64:
        return 12
    if math.min(0u64, 18446744073709551615u64) != 0u64:
        return 13
    if math.max(0u64, 18446744073709551615u64) != 18446744073709551615u64:
        return 14
    if math.clamp(0u64, 1u64, 18446744073709551615u64) != 1u64:
        return 15
    return 0


def main() -> int:
    if widths() != 0:
        return widths()
    if signs() != 0:
        return signs()
    return 42
