module main;
import std_time as t;
import std_random as r;
fn main(clock: clock_cap, random: random_cap) -> i64 {
    match t::now(clock) {
        t::Measured.ok(value) => {
            if value.unix_nanoseconds != - 7 {
                return 1;
            }
        },
        t::Measured.err(e) => {
            if e == new t::Error.denied {
                return 42;
            }
            if e == new t::Error.unavailable {
                return 43;
            }
            return 44;
        }
    }
    match r::entropy_bounded(random, 10u64, 4u64) {
        r::Sample.ok(n) => {
            if n != 6u64 {
                return 6;
            }
        },
        r::Sample.err(_) => {
            return 7;
        }
    }
    match r::seed_from_entropy(random) {
        r::Seeded.ok(g) => {
            if g.state != 72623859790382856u64 {
                return 8;
            }
        },
        r::Seeded.err(_) => {
            return 9;
        }
    }
    return 0;
}
