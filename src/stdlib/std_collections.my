module std_collections;
export Vector;
export Created;
export Status;
export vector;
export filled;
export find;
export contains;
export reverse;
export sort;
export lower_bound;
export sort_by_i64;
export sort_by;
export lower_bound_by;
export filter_by;
export transform_i64;
export clear;
export append_many;
export dedup;
export filter_i64;
buffer Vector < T: copy >: T;
result Created<T: copy> {
    ok: Vector<T>,
    err: i64
}
result Status {
    ok: bool,
    err: i64
}
fn vector < T: copy >(heap: allocator, capacity: u64) -> Created<T> {
    return acquire_buffer<Created<T>>(heap, capacity);
}
fn filled < T: copy >(heap: allocator, count: u64, value: T) -> Created<T> {
    let mut values = try vector::< T >(heap, count);
    discard try resize_buffer<Status>(values, count, value);
    return new Created<T>.ok(values);
}
fn find < T: equality >(values: &[]T, needle: T) -> i64 noalloc {
    let mut index = 0u64;
    while index < len_slice(values) {
        if read_slice(values, index) == needle {
            return cast<i64>(index);
        }
        index += 1u64;
    }
    return - 1;
}
fn contains < T: equality >(values: &[]T, needle: T) -> bool noalloc {
    return find::< T >(values, needle) >= 0;
}
fn reverse < T: copy >(values: &mut []T) -> i64 noalloc {
    let mut left = 0u64;
    let mut right = len_slice(values);
    while left < right {
        right -= 1u64;
        let old = read_slice(values, left);
        write_slice(values, left, read_slice(values, right));
        write_slice(values, right, old);
        left += 1u64;
    }
    return 0;
}
fn sort < T: integer >(values: &mut []T) -> i64 noalloc {
    let mut index = 1u64;
    while index < len_slice(values) {
        let value = read_slice(values, index);
        let mut position = index;
        while position > 0u64 {
            let previous = read_slice(values, position - 1u64);
            if previous <= value {
                position = 0u64;
            } else {
                write_slice(values, position, previous);
                write_slice(values, position - 1u64, value);
                position -= 1u64;
            }
        }
        index += 1u64;
    }
    return 0;
}
fn lower_bound < T: integer >(values: &[]T, needle: T) -> u64 noalloc {
    let mut left = 0u64;
    let mut right = len_slice(values);
    while left < right {
        let middle = left +(right - left) / 2u64;
        if read_slice(values, middle) < needle {
            left = middle + 1u64;
        } else {
            right = middle;
        }
    }
    return left;
}
fn sort_by_i64(values: &mut []i64, before: fn(i64, i64) -> bool effects()) -> u64 {
    let length = len_slice(values);
    let mut i = 1u64;
    while i < length {
        let value = read_slice(values, i);
        let mut at = i;
        while at > 0u64 {
            let previous = read_slice(values, at - 1u64);
            if !before(value, previous) {
                break;
            }
            write_slice(values, at, previous);
            at -= 1u64;
        }
        write_slice(values, at, value);
        i += 1u64;
    }
    return length;
}
fn transform_i64(values: &mut []i64, apply: fn(i64) -> i64 effects()) -> u64 {
    let mut i = 0u64;
    while i < len_slice(values) {
        write_slice(values, i, apply(read_slice(values, i)));
        i += 1u64;
    }
    return i;
}
fn clear < T: copy >(values: &mut Vector<T>) -> Status noalloc {
    if len_buffer(values) == 0u64 {
        return new Status.ok(true);
    }
    return resize_buffer<Status>(values, 0u64, read_buffer(values, 0u64));
}
fn append_many < T: copy >(values: &mut Vector<T>, input: &[]T) -> Status noalloc {
    let count = len_slice(input);
    if count > capacity_buffer(values) - len_buffer(values) {
        return new Status.err(1);
    }
    let mut i = 0u64;
    while i < count {
        discard try append_buffer<Status>(values, read_slice(input, i));
        i += 1u64;
    }
    return new Status.ok(true);
}
fn dedup < T: equality >(values: &mut Vector<T>) -> Status noalloc {
    let count = len_buffer(values);
    let mut out = 0u64;
    let mut i = 0u64;
    while i < count {
        let value = read_buffer(values, i);
        let mut seen = false;
        let mut j = 0u64;
        while j < out {
            if read_buffer(values, j) == value {
                seen = true;
                break;
            }
            j += 1u64;
        }
        if !seen {
            discard try write_buffer<Status>(values, out, value);
            out += 1u64;
        }
        i += 1u64;
    }
    if count == 0u64 {
        return new Status.ok(true);
    }
    return resize_buffer<Status>(values, out, read_buffer(values, 0u64));
}
fn filter_i64(values: &mut Vector<i64>, keep: fn(i64) -> bool effects()) -> Status {
    let count = len_buffer(values);
    let mut out = 0u64;
    let mut i = 0u64;
    while i < count {
        let value = read_buffer(values, i);
        if keep(value) {
            discard try write_buffer<Status>(values, out, value);
            out += 1u64;
        }
        i += 1u64;
    }
    if count == 0u64 {
        return new Status.ok(true);
    }
    return resize_buffer<Status>(values, out, read_buffer(values, 0u64));
}
fn sift_by < T: copy, C: copy >(values: &mut []T, context: &[]C, start: u64, count: u64, before: fn(&[]C, T, T) -> bool effects()) -> i64 noalloc {
    let mut root = start;
    while root < count / 2u64 {
        let mut child = root * 2u64 + 1u64;
        if child + 1u64 < count && before(context, read_slice(values, child), read_slice(values, child + 1u64)) {
            child += 1u64;
        }
        let value = read_slice(values, root);
        let selected = read_slice(values, child);
        if !before(context, value, selected) {
            break;
        }
        write_slice(values, root, selected);
        write_slice(values, child, value);
        root = child;
    }
    return 0;
}
fn sort_by < T: copy, C: copy >(values: &mut []T, context: &[]C, before: fn(&[]C, T, T) -> bool effects()) -> u64 noalloc {
    let count = len_slice(values);
    let mut start = count / 2u64;
    while start > 0u64 {
        start -= 1u64;
        discard sift_by::< T,
        C >(values, context, start, count, before);
    }
    let mut end = count;
    while end > 1u64 {
        end -= 1u64;
        let last = read_slice(values, end);
        write_slice(values, end, read_slice(values, 0u64));
        write_slice(values, 0u64, last);
        discard sift_by::< T,
        C >(values, context, 0u64, end, before);
    }
    return count;
}
fn lower_bound_by < T: copy, C: copy >(values: &[]T, context: &[]C, needle: T, before: fn(&[]C, T, T) -> bool effects()) -> u64 noalloc {
    let mut left = 0u64;
    let mut right = len_slice(values);
    while left < right {
        let middle = left +(right - left) / 2u64;
        if before(context, read_slice(values, middle), needle) {
            left = middle + 1u64;
        } else {
            right = middle;
        }
    }
    return left;
}
fn filter_by < T: copy, C: copy >(values: &mut Vector<T>, context: &[]C, keep: fn(&[]C, T) -> bool effects()) -> Status noalloc {
    let count = len_buffer(values);
    let mut out = 0u64;
    let mut i = 0u64;
    while i < count {
        let value = read_buffer(values, i);
        if keep(context, value) {
            discard try write_buffer<Status>(values, out, value);
            out += 1u64;
        }
        i += 1u64;
    }
    if count == 0u64 {
        return new Status.ok(true);
    }
    return resize_buffer<Status>(values, out, read_buffer(values, 0u64));
}
