module std_borrowed_set;
import std_collections as c;
export Set;
export Created;
export Change;
export create;
export contains;
export insert;
export remove;
export clear;
buffer Set < T: equality >: T;
result Created<T: equality> {
    ok: Set<T>,
    err: i64
}
enum Change {
    unchanged,
    changed,
    full
}
fn create < T: equality >(heap: allocator, capacity: u64) -> Created<T> {
    return acquire_buffer<Created<T>>(heap, capacity);
}
fn contains < T: equality >(set: &Set<T>, value: T) -> bool noalloc {
    let mut i = 0u64;
    while i < len_buffer(set) {
        if read_buffer(set, i) == value {
            return true;
        }
        i += 1u64;
    }
    return false;
}
fn insert < T: equality >(set: &mut Set<T>, value: T) -> Change noalloc {
    if contains::< T >(set, value) {
        return new Change.unchanged;
    }
    match append_buffer<c::Status>(set, value) {
        c::Status.ok(discard) => {
            return new Change.changed;
        },
        c::Status.err(discard) => {
            return new Change.full;
        }
    }
}
fn remove < T: equality >(set: &mut Set<T>, value: T) -> Change noalloc {
    let total = len_buffer(set);
    let mut i = 0u64;
    while i < total {
        if read_buffer(set, i) == value {
            let last = read_buffer(set, total - 1u64);
            match write_buffer<c::Status>(set, i, last) {
                c::Status.ok(discard) => {},
                c::Status.err(discard) => {
                    return new Change.unchanged;
                }
            }
            match resize_buffer<c::Status>(set, total - 1u64, last) {
                c::Status.ok(discard) => {
                    return new Change.changed;
                },
                c::Status.err(discard) => {
                    return new Change.unchanged;
                }
            }
        }
        i += 1u64;
    }
    return new Change.unchanged;
}
fn clear < T: equality >(set: &mut Set<T>) -> c::Status noalloc {
    if len_buffer(set) == 0u64 {
        return new c::Status.ok(true);
    }
    return resize_buffer<c::Status>(set, 0u64, read_buffer(set, 0u64));
}
