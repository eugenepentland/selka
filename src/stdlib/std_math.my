// Binary64 values retain their exact representation; eq implements numeric equality.
module std_math;
export F64;
export min;
export max;
export min_or;
export max_or;
export Decoded;
export Unsigned;
export Signed;
export from_bits;
export bits;
export from_u64;
export from_i64;
export to_u64;
export to_i64;
export add;
export sub;
export mul;
export div;
export eq;
export lt;
export le;
export sqrt;
export floor;
export ceil;
export trunc;
export abs;
export neg;
export is_nan;
export is_finite;
result Decoded {
    ok: F64,
    err: i64
}
domain F64: u64 {
    codec u64 {
        decode: decode_bits,
        encode: raw
    }
    fn decode_bits(value: u64) -> Decoded noalloc {
        return new Decoded.ok(wrap<F64>(value));
    }
    fn make(value: u64) -> F64 noalloc {
        return wrap<F64>(value);
    }
    fn raw(value: F64) -> u64 noalloc {
        return unwrap(value);
    }
}
result Unsigned {
    ok: u64,
    err: i64
}
result Signed {
    ok: i64,
    err: i64
}
fn from_bits(value: u64) -> F64 noalloc {
    return F64.make(value);
}
fn bits(value: F64) -> u64 noalloc {
    return F64.raw(value);
}
fn from_u64(value: u64) -> F64 noalloc {
    return F64.make(f64_from_u64(value));
}
fn from_i64(value: i64) -> F64 noalloc {
    if value < 0 {
        return neg(from_u64(cast<u64>(-(value + 1)) + 1u64));
    }
    return from_u64(cast<u64>(value));
}
fn add(a: F64, b: F64) -> F64 noalloc {
    return F64.make(f64_add(F64.raw(a), F64.raw(b)));
}
fn sub(a: F64, b: F64) -> F64 noalloc {
    return F64.make(f64_sub(F64.raw(a), F64.raw(b)));
}
fn mul(a: F64, b: F64) -> F64 noalloc {
    return F64.make(f64_mul(F64.raw(a), F64.raw(b)));
}
fn div(a: F64, b: F64) -> F64 noalloc {
    return F64.make(f64_div(F64.raw(a), F64.raw(b)));
}
fn eq(a: F64, b: F64) -> bool noalloc {
    return f64_eq(F64.raw(a), F64.raw(b));
}
fn lt(a: F64, b: F64) -> bool noalloc {
    return f64_lt(F64.raw(a), F64.raw(b));
}
fn le(a: F64, b: F64) -> bool noalloc {
    return f64_le(F64.raw(a), F64.raw(b));
}
fn sqrt(a: F64) -> F64 noalloc {
    return F64.make(f64_sqrt(F64.raw(a)));
}
fn floor(a: F64) -> F64 noalloc {
    return F64.make(f64_floor(F64.raw(a)));
}
fn ceil(a: F64) -> F64 noalloc {
    return F64.make(f64_ceil(F64.raw(a)));
}
fn trunc(a: F64) -> F64 noalloc {
    return F64.make(f64_trunc(F64.raw(a)));
}
fn abs(a: F64) -> F64 noalloc {
    return F64.make(f64_abs(F64.raw(a)));
}
fn neg(a: F64) -> F64 noalloc {
    return F64.make(f64_neg(F64.raw(a)));
}
fn is_nan(a: F64) -> bool noalloc {
    return !eq(a, a);
}
fn is_finite(a: F64) -> bool noalloc {
    return bit_and(F64.raw(a), 9218868437227405312u64) != 9218868437227405312u64;
}
fn to_u64(a: F64) -> Unsigned noalloc {
    let value = trunc(a);
    if !is_finite(value) || lt(value, from_u64(0u64)) || !lt(value, from_bits(4895412794951729152u64)) {
        return new Unsigned.err(1);
    }
    return new Unsigned.ok(f64_to_u64(F64.raw(value)));
}
fn to_i64(a: F64) -> Signed noalloc {
    let value = trunc(a);
    let limit = from_bits(4890909195324358656u64);
    if !is_finite(value) || lt(value, neg(limit)) || !lt(value, limit) {
        return new Signed.err(1);
    }
    if eq(value, neg(limit)) {
        return new Signed.ok(- 9223372036854775808);
    }
    let magnitude = cast<i64>(f64_to_u64(F64.raw(abs(value))));
    if lt(value, from_u64(0u64)) {
        return new Signed.ok(- magnitude);
    }
    return new Signed.ok(magnitude);
}
// Integer extrema compare without subtraction, so full-width bounds are safe.
fn min < T: integer >(a: T, b: T) -> T noalloc {
    if a <= b {
        return a;
    }
    return b;
}
fn max < T: integer >(a: T, b: T) -> T noalloc {
    if a >= b {
        return a;
    }
    return b;
}
// The fallback is returned only for an empty slice, never folded into values.
fn min_or < T: integer >(values: &[]T, fallback: T) -> T noalloc {
    if len_slice(values) == 0u64 {
        return fallback;
    }
    let mut best = read_slice(values, 0u64);
    let mut index = 1u64;
    while index < len_slice(values) {
        best = min::< T >(best, read_slice(values, index));
        index += 1u64;
    }
    return best;
}
fn max_or < T: integer >(values: &[]T, fallback: T) -> T noalloc {
    if len_slice(values) == 0u64 {
        return fallback;
    }
    let mut best = read_slice(values, 0u64);
    let mut index = 1u64;
    while index < len_slice(values) {
        best = max::< T >(best, read_slice(values, index));
        index += 1u64;
    }
    return best;
}
