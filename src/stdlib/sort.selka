import lists

# Three-way comparison of two texts in Unicode code point order.
public func compare_strs(a: str, b: str) -> int:
    if a == b:
        return 0
    if a < b:
        return 0 - 1
    return 1


# A new ascending list of integers; the input list is not modified.
public func sort_ints(values: int[]) -> int[]:
    mut out = copy(values)
    sort(mut out)
    return out


# A new ascending list of floats; NaNs follow ordered values and the input is unchanged.
public func sort_floats(values: float[]) -> float[]:
    mut out = copy(values)
    sort(mut out)
    return out


# A new list of texts in Unicode code point order; the input is not modified.
public func sort_strs(values: str[]) -> str[]:
    mut out = copy(values)
    sort(mut out)
    return out


# A new list ordered by an integer key function; the ordering is stable and
# the input is unchanged. It is `sorted(values, key=key)`: each key is
# computed exactly once, in input order, and the native keyed sort gathers the
# elements into the new list in key order.
public func sort_by_key[T: copy + storable](values: T[], key: func(T) -> int) -> T[]:
    return sorted(values, key=key)


# One bottom-up merge pass of `src`, a list of positions of `values` that is sorted in runs of `width`, into `dst`: each
# pair of neighbouring runs becomes one run. A pair whose first right element does not go before the last left element
# is copied across without a merge, and in a merge the right run's element goes ahead of the left run's only when it
# compares less, which keeps equal elements in their input order.
func merge_pass[T: copy + storable, C: copy + storable](values: T[], compare: func(T, T, C) -> int, context: C, src: int[], mut dst: int[], width: int):
    const total = len(src)
    mut low = 0
    while low < total:
        const middle = min(low + width, total)
        const high = min(low + 2 * width, total)
        mut left = low
        mut right = middle
        mut out = low
        if middle < high and compare(values[src[middle]], values[src[middle - 1]], context) < 0:
            while left < middle and right < high:
                if compare(values[src[right]], values[src[left]], context) < 0:
                    dst[out] = src[right]
                    right += 1
                else:
                    dst[out] = src[left]
                    left += 1
                out += 1
        while left < middle:
            dst[out] = src[left]
            left += 1
            out += 1
        while right < high:
            dst[out] = src[right]
            right += 1
            out += 1
        low += 2 * width


# The positions 0 to len(values) - 1 in the order their elements sort by `compare`: a stable merge sort of the
# positions, so the elements are only read, each lent to `compare`, and none is copied. The result is a permutation
# of the positions whatever `compare` answers.
func order_by_compare[T: copy + storable, C: copy + storable](values: T[], compare: func(T, T, C) -> int, context: C) -> int[]:
    const total = len(values)
    mut first: int[] = []
    mut second: int[] = []
    for position in range(total):
        append(mut first, position)
        append(mut second, position)
    mut width = 1
    mut in_first = True
    while width < total:
        if in_first:
            merge_pass(values, compare, context, first, mut second, width)
        else:
            merge_pass(values, compare, context, second, mut first, width)
        in_first = not in_first
        width *= 2
    if in_first:
        return first
    return second


# `merge_pass` for a comparison of two elements: one bottom-up merge pass of `src`, a list of positions of `values` that
# is sorted in runs of `width`, into `dst`: each pair of neighbouring runs becomes one run. A pair whose first right
# element does not go before the last left element is copied across without a merge, and in a merge the right run's
# element goes ahead of the left run's only when it compares less, which keeps equal elements in their input order.
func merge_pass_plain[T: copy + storable](values: T[], compare: func(T, T) -> int, src: int[], mut dst: int[], width: int):
    const total = len(src)
    mut low = 0
    while low < total:
        const middle = min(low + width, total)
        const high = min(low + 2 * width, total)
        mut left = low
        mut right = middle
        mut out = low
        if middle < high and compare(values[src[middle]], values[src[middle - 1]]) < 0:
            while left < middle and right < high:
                if compare(values[src[right]], values[src[left]]) < 0:
                    dst[out] = src[right]
                    right += 1
                else:
                    dst[out] = src[left]
                    left += 1
                out += 1
        while left < middle:
            dst[out] = src[left]
            left += 1
            out += 1
        while right < high:
            dst[out] = src[right]
            right += 1
            out += 1
        low += 2 * width


# `order_by_compare` for a comparison of two elements: the positions 0 to len(values) - 1 in the order their elements
# sort by `compare`, a stable merge sort of the positions, so the elements are only read, each lent to `compare`, and
# none is copied. The result is a permutation of the positions whatever `compare` answers.
func order_by_compare_plain[T: copy + storable](values: T[], compare: func(T, T) -> int) -> int[]:
    const total = len(values)
    mut first: int[] = []
    mut second: int[] = []
    for position in range(total):
        append(mut first, position)
        append(mut second, position)
    mut width = 1
    mut in_first = True
    while width < total:
        if in_first:
            merge_pass_plain(values, compare, first, mut second, width)
        else:
            merge_pass_plain(values, compare, second, mut first, width)
        in_first = not in_first
        width *= 2
    if in_first:
        return first
    return second


# Moves the element at position `order[k]` to position `k`, for every `k`, in place and without copying an element.
# `order` holds each position of `values` once. The last element is taken out to be the free hand, then every cycle of
# the permutation is followed with `exchange`, which puts the carried element in a slot and carries the slot's former
# element on; a cycle ends when the element that belongs in its first slot arrives and the hand comes back.
func move_into_order[T: copy + storable](mut values: T[], order: int[]):
    const total = len(values)
    mut target = copy(order)
    for position in range(total):
        target[order[position]] = position
    mut held = lists.pop(mut values)
    if target[total - 1] != total - 1:
        mut slot = target[total - 1]
        target[total - 1] = total - 1
        while slot != total - 1:
            const next = target[slot]
            target[slot] = slot
            held = lists.exchange(mut values, slot, own held)
            slot = next
        append(mut values, own held)
        held = lists.pop(mut values)
    for start in range(total - 1):
        if target[start] != start:
            mut slot = start
            while True:
                const next = target[slot]
                target[slot] = slot
                held = lists.exchange(mut values, slot, own held)
                slot = next
                if slot == start:
                    break
            held = lists.exchange(mut values, start, own held)
    append(mut values, own held)


# Sorts a list in place, stably, by a comparison the caller names: a top-level function of two elements and a context
# value that returns a negative integer when the first element goes before the second, zero when neither does and a
# positive integer when the second goes first. The context is `compare`'s third argument on every call: write a record
# of what the comparison needs (the direction of each key, a table to look values up in), because there are no closures.
# Equal elements keep their input order, and the sort moves each element once and copies none; it holds two lists of
# positions beside the list. A comparison that is not an order (it contradicts itself) still ends, and leaves the list
# in some order of its own elements.
public func sort_by_compare_with[T: copy + storable, C: copy + storable](mut values: T[], compare: func(T, T, C) -> int, context: C):
    if len(values) < 2:
        return
    move_into_order(mut values, order_by_compare(values, compare, context))


# `sort_by_compare_with` for a comparison that needs nothing beside the two elements.
public func sort_by_compare[T: copy + storable](mut values: T[], compare: func(T, T) -> int):
    if len(values) < 2:
        return
    move_into_order(mut values, order_by_compare_plain(values, compare))


# Whether a list of integers is already in ascending order.
public func is_sorted_ints(values: int[]) -> bool:
    mut index = 1
    while index < len(values):
        if values[index] < values[index - 1]:
            return False
        index += 1
    return True


# Position of a target in an ascending list of integers, if it is present.
public func binary_search(values: int[], target: int) -> int?:
    mut low = 0
    mut high = len(values) - 1
    while low <= high:
        mut middle = low + (high - low) // 2
        if values[middle] == target:
            return Some(middle)
        if values[middle] < target:
            low = middle + 1
        else:
            high = middle - 1
    return None


# Smallest value of a list of integers, if the list has one.
public func min_int(values: int[]) -> int?:
    if len(values) == 0:
        return None
    mut best = values[0]
    for value in values:
        if value < best:
            best = value
    return Some(best)


# Largest value of a list of integers, if the list has one.
public func max_int(values: int[]) -> int?:
    if len(values) == 0:
        return None
    mut best = values[0]
    for value in values:
        if value > best:
            best = value
    return Some(best)


# Smallest text of a list in code point order, if the list has one.
public func min_str(values: str[]) -> str?:
    if len(values) == 0:
        return None
    mut best = copy(values[0])
    for value in values:
        if compare_strs(value, best) < 0:
            best = copy(value)
    return Some(own best)


# Integers with later duplicates removed, keeping first-occurrence order.
public func unique_ints(values: int[]) -> int[]:
    mut seen: dict[int, bool] = {}
    mut out: int[] = []
    for value in values:
        if value not in seen:
            seen[value] = True
            append(mut out, value)
    return out


# Texts with later duplicates removed, keeping first-occurrence order.
public func unique_strs(values: str[]) -> str[]:
    mut seen: dict[str, bool] = {}
    mut out: str[] = []
    for value in values:
        if value not in seen:
            seen[copy(value)] = True
            append(mut out, copy(value))
    return out
