# Three-way comparison of two texts in Unicode code point order.
public func compare_strs(a: str, b: str) -> int effects():
    if a == b:
        return 0
    if min(a, b) == a:
        return 0 - 1
    return 1


# A new ascending list of integers; the input list is not modified.
public func sort_ints(values: int[]) -> int[]:
    return sorted(values)


# A new ascending list of floats; NaNs follow ordered values and the input is unchanged.
public func sort_floats(values: float[]) -> float[]:
    return sorted(values)


# A new list of texts in Unicode code point order; the input is not modified.
public func sort_strs(values: str[]) -> str[]:
    return sorted(values)


# A new list ordered by an integer key function; the ordering is stable and
# the input is unchanged. It is `sorted(values, key=key)`: each key is
# computed exactly once, in input order, and the native keyed sort gathers the
# elements into the new list in key order.
public func sort_by_key[T: copy + storable](values: T[], key: func(T) -> int effects()) -> T[]:
    return sorted(values, key=key)


# Whether a list of integers is already in ascending order.
public func is_sorted_ints(values: int[]) -> bool effects():
    mut index = 1
    while index < len(values):
        if values[index] < values[index - 1]:
            return False
        index += 1
    return True


# Position of a target in an ascending list of integers, if it is present.
public func binary_search(values: int[], target: int) -> int? effects():
    mut low = 0
    mut high = len(values) - 1
    while low <= high:
        mut middle = low + (high - low) // 2
        if values[middle] == target:
            return Some(middle)
        if values[middle] < target:
            low = middle + 1
        else:
            high = middle - 1
    return None


# Smallest value of a list of integers, if the list has one.
public func min_int(values: int[]) -> int? effects():
    if len(values) == 0:
        return None
    mut best = values[0]
    for value in values:
        if value < best:
            best = value
    return Some(best)


# Largest value of a list of integers, if the list has one.
public func max_int(values: int[]) -> int? effects():
    if len(values) == 0:
        return None
    mut best = values[0]
    for value in values:
        if value > best:
            best = value
    return Some(best)


# Smallest text of a list in code point order, if the list has one.
public func min_str(values: str[]) -> str? effects():
    if len(values) == 0:
        return None
    mut best = values[0]
    for value in values:
        if compare_strs(value, best) < 0:
            best = value
    return Some(best)


# Integers with later duplicates removed, keeping first-occurrence order.
public func unique_ints(values: int[]) -> int[]:
    mut seen: dict[int, bool] = {}
    mut out: int[] = []
    for value in values:
        if value not in seen:
            seen[value] = True
            out.append(value)
    return out


# Texts with later duplicates removed, keeping first-occurrence order.
public func unique_strs(values: str[]) -> str[]:
    mut seen: dict[str, bool] = {}
    mut out: str[] = []
    for value in values:
        if value not in seen:
            seen[value] = True
            out.append(value)
    return out
