# Decompression for the DEFLATE family: raw streams (RFC 1951), zlib (RFC 1950) and gzip (RFC 1952), whole or in pieces. The
# module only decompresses. `inflate`, `zlib_decode` and `gunzip` take all the compressed bytes and a `limit` on the size of
# the result, which stops a small input from claiming gigabytes. `inflater`, `zlib_inflater` and `gzip_inflater` make a
# stream state that `feed` takes the compressed bytes by piece, returning the plain bytes each piece yields, so a stream of
# any size runs in the memory of one 32 KiB window and one piece; `finish` and `ended` say whether it ended cleanly. Every
# function fails with a message instead of trapping: a truncated stream, a bad block, a code that is not a prefix code, a
# distance before the start of the output, a checksum that does not match, or a result past the limit. The one-shot
# functions run the same inflater on one piece.
import buffers
import bytes
import lists

# The most history a back reference reaches (RFC 1951 section 3.2.5).
const WINDOW: int = 32768


# A Huffman code is one `int[]` of TABLE_SIZE entries: FAST entries that a lookup of the next ten input bits indexes (the
# symbol times 16 plus the code length, 0 when the code is longer or unused), then the count of codes of each length 0 to
# 15 from COUNTS, the symbols in code order from SYMBOLS, and from OFFSETS and NEXT two scratch rows of 16 that building
# the code uses.
const FAST: int = 1024


const COUNTS: int = 1024


const SYMBOLS: int = 1040


const OFFSETS: int = 1328


const NEXT: int = 1344


const TABLE_SIZE: int = 1360


# The kinds of stream.
const RAW: int = 0


const ZLIB: int = 1


const GZIP: int = 2


# Where a stream is: the start of the zlib header or of a gzip member, the parts of a gzip header, a block header, inside
# a stored block (its header, then its bytes), inside a dynamic block's header or its symbols, the checksum after the
# stream, the end, or failed.
const S_START: int = 0


const S_XLEN: int = 1


const S_EXTRA: int = 2


const S_NAME: int = 3


const S_COMMENT: int = 4


const S_HCRC: int = 5


const S_BLOCK: int = 6


const S_STORED: int = 7


const S_COPY: int = 8


const S_DYNAMIC: int = 9


const S_CODES: int = 10


const S_TRAILER: int = 11


const S_DONE: int = 12


const S_FAILED: int = 13


# The output buffer keeps the window and what `feed` has not returned; it is cut back to the window once it holds this much.
const COMPACT_AT: int = 131072


# How many plain bytes one `feed` returns at most (a little more, up to one match); the rest waits for the next call.
const CHUNK: int = 1048576


# A position in the compressed input: the next byte to load, the loaded bits not yet used (least significant first), and
# how many there are.
record Reader:
    bits: int
    count: int
    at: int


# The state of one compressed stream. It is a value: pass it with `mut`. `carry` is the input not yet used, `bits` and
# `count` the bits loaded and not yet used, `out` the last of the output (the window and what `feed` has not returned),
# `emitted`, `checked` and `base` positions in it, `discarded` how much output is gone from its front, and `lit` and
# `dist` the codes of the current block.
public record Inflater:
    format: int
    stage: int
    whole: bool
    limit: int
    chunk: int
    failure: str
    carry: bytes
    at: int
    bits: int
    count: int
    out: byte_buffer
    emitted: int
    checked: int
    base: int
    discarded: int
    check: int
    size: int
    members: int
    last: bool
    left: int
    flags: int
    padded: bool
    lit: int[]
    dist: int[]


# The base value (16 bits, least significant octet first) and extra-bit count of each length and distance symbol (RFC 1951
# section 3.2.5), and the order of the code length code lengths. The loop that decodes reads them by index because a call to
# `bytes.read_u16_le` costs a block of a test's step budget.
const LENGTH_BASE: bytes = b"\x03\x00\x04\x00\x05\x00\x06\x00\x07\x00\x08\x00\x09\x00\x0a\x00\x0b\x00\x0d\x00\x0f\x00\x11\x00\x13\x00\x17\x00\x1b\x00\x1f\x00\x23\x00\x2b\x00\x33\x00\x3b\x00\x43\x00\x53\x00\x63\x00\x73\x00\x83\x00\xa3\x00\xc3\x00\xe3\x00\x02\x01"


const LENGTH_EXTRA: bytes = b"\x00\x00\x00\x00\x00\x00\x00\x00\x01\x01\x01\x01\x02\x02\x02\x02\x03\x03\x03\x03\x04\x04\x04\x04\x05\x05\x05\x05\x00"


const DISTANCE_BASE: bytes = b"\x01\x00\x02\x00\x03\x00\x04\x00\x05\x00\x07\x00\x09\x00\x0d\x00\x11\x00\x19\x00\x21\x00\x31\x00\x41\x00\x61\x00\x81\x00\xc1\x00\x01\x01\x81\x01\x01\x02\x01\x03\x01\x04\x01\x06\x01\x08\x01\x0c\x01\x10\x01\x18\x01\x20\x01\x30\x01\x40\x01\x60"


const DISTANCE_EXTRA: bytes = b"\x00\x00\x00\x00\x01\x01\x02\x02\x03\x03\x04\x04\x05\x05\x06\x06\x07\x07\x08\x08\x09\x09\x0a\x0a\x0b\x0b\x0c\x0c\x0d\x0d"


const ORDER: bytes = b"\x10\x11\x12\x00\x08\x07\x09\x06\x0a\x05\x0b\x04\x0c\x03\x0d\x02\x0e\x01\x0f"


# Zero octets: the table a code starts from, which `bytes.to_list` makes a list of in one step, and the longest run a match can
# copy (258), which a match of distance 1 appends a piece of. The compiler builds it while it checks the program.
const ZEROS: bytes = zeros()


func zeros() -> bytes:
    mut table = buffers.empty()
    for index in range(TABLE_SIZE):
        _ = buffers.append_byte(mut table, 0)
    return bytes(table)


# A table for a code of a dynamic block: TABLE_SIZE zeros. `build` sets everything it reads.
func fresh_table() -> int[]:
    return bytes.to_list(ZEROS)


