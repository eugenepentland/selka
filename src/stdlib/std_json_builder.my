// Checked string escaping and bounded object/array output.
module std_json_builder;
import std_bytes;
import std_strings;
import std_result;
export Array;
export CreatedArray;
export array;
export array_string;
export array_integer;
export array_bool;
export array_null;
export array_object;
export array_array;
export array_field;
export finish_array;
export object_field;
export integers_field;
export Object;
export Created;
export object;
export string_field;
export integer_field;
export bool_field;
export null_field;
export finish;
export integers;
struct Object {
    bytes: std_bytes::Bytes
}
result Created {
    ok: Object,
    err: std_result::Error
}
fn object(heap: allocator, limit: i64) -> Created {
    let bytes = try std_bytes::create(heap, limit);
    return new Created.ok(new Object {
        bytes: try std_bytes::append(bytes, "{")
    });
}
fn key(heap: allocator, input: Object, name: &[]u8) -> Created {
    let mut bytes = input.bytes;
    if len_buffer(bytes) > 1u64 {
        bytes = try std_bytes::append(bytes, ",");
    }
    let quoted = try std_bytes::escaped(heap, name, cast<i64>(capacity_buffer(bytes) - len_buffer(bytes)));
    borrow quoted[0..len_buffer(quoted)] as text {
        bytes = try std_bytes::append(bytes, text);
    }
    bytes = try std_bytes::append(bytes, ":");
    return new Created.ok(new Object {
        bytes: bytes
    });
}
fn string_field(heap: allocator, input: Object, name: &[]u8, value: &[]u8) -> Created {
    let keyed = try key(heap, input, name);
    let mut bytes = keyed.bytes;
    let quoted = try std_bytes::escaped(heap, value, cast<i64>(capacity_buffer(bytes) - len_buffer(bytes)));
    borrow quoted[0..len_buffer(quoted)] as text {
        bytes = try std_bytes::append(bytes, text);
    }
    return new Created.ok(new Object {
        bytes: bytes
    });
}
fn integer_field(heap: allocator, input: Object, name: &[]u8, value: i64) -> Created {
    let keyed = try key(heap, input, name);
    let mut bytes = keyed.bytes;
    let number = try std_bytes::decimal(heap, value, 20);
    borrow number[0..len_buffer(number)] as text {
        bytes = try std_bytes::append(bytes, text);
    }
    return new Created.ok(new Object {
        bytes: bytes
    });
}
fn bool_field(heap: allocator, input: Object, name: &[]u8, value: bool) -> Created {
    let keyed = try key(heap, input, name);
    let mut bytes = keyed.bytes;
    if value {
        bytes = try std_bytes::append(bytes, "true");
    } else {
        bytes = try std_bytes::append(bytes, "false");
    }
    return new Created.ok(new Object {
        bytes: bytes
    });
}
fn null_field(heap: allocator, input: Object, name: &[]u8) -> Created {
    let keyed = try key(heap, input, name);
    return new Created.ok(new Object {
        bytes: try std_bytes::append(keyed.bytes, "null")
    });
}
fn finish(input: Object) -> std_bytes::Built {
    return std_bytes::append(input.bytes, "}");
}
fn integers(heap: allocator, values: &[]i64, limit: i64) -> std_bytes::Built {
    let mut bytes = try std_bytes::create(heap, limit);
    bytes = try std_bytes::append(bytes, "[");
    let mut i = 0u64;
    while i < len_slice(values) {
        if i > 0u64 {
            bytes = try std_bytes::append(bytes, ",");
        }
        let number = try std_bytes::decimal(heap, read_slice(values, i), 20);
        borrow number[0..len_buffer(number)] as text {
            bytes = try std_bytes::append(bytes, text);
        }
        i += 1u64;
    }
    return std_bytes::append(bytes, "]");
}
fn object_field(heap: allocator, input: Object, name: &[]u8, value: Object) -> Created {
    let keyed = try key(heap, input, name);
    let mut bytes = keyed.bytes;
    let nested = try finish(value);
    borrow nested[0..len_buffer(nested)] as text {
        bytes = try std_bytes::append(bytes, text);
    }
    return new Created.ok(new Object {
        bytes: bytes
    });
}
fn integers_field(heap: allocator, input: Object, name: &[]u8, values: &[]i64) -> Created {
    let keyed = try key(heap, input, name);
    let mut bytes = keyed.bytes;
    let nested = try integers(heap, values, cast<i64>(capacity_buffer(bytes) - len_buffer(bytes)));
    borrow nested[0..len_buffer(nested)] as text {
        bytes = try std_bytes::append(bytes, text);
    }
    return new Created.ok(new Object {
        bytes: bytes
    });
}
struct Array {
    bytes: std_bytes::Bytes
}
result CreatedArray {
    ok: Array,
    err: std_result::Error
}
fn array(heap: allocator, limit: i64) -> CreatedArray {
    return new CreatedArray.ok(new Array {
        bytes: try std_bytes::append(try std_bytes::create(heap, limit), "[")
    });
}
fn element(input: Array) -> std_bytes::Built {
    let mut bytes = input.bytes;
    if len_buffer(bytes) > 1u64 {
        bytes = try std_bytes::append(bytes, ",");
    }
    return new std_bytes::Built.ok(bytes);
}
fn array_string(heap: allocator, input: Array, value: &[]u8) -> CreatedArray {
    let mut bytes = try element(input);
    let quoted = try std_bytes::escaped(heap, value, cast<i64>(capacity_buffer(bytes) - len_buffer(bytes)));
    borrow quoted[0..len_buffer(quoted)] as text {
        bytes = try std_bytes::append(bytes, text);
    }
    return new CreatedArray.ok(new Array {
        bytes: bytes
    });
}
fn array_integer(heap: allocator, input: Array, value: i64) -> CreatedArray {
    let mut bytes = try element(input);
    let number = try std_bytes::decimal(heap, value, 20);
    borrow number[0..len_buffer(number)] as text {
        bytes = try std_bytes::append(bytes, text);
    }
    return new CreatedArray.ok(new Array {
        bytes: bytes
    });
}
fn array_bool(input: Array, value: bool) -> CreatedArray {
    let mut bytes = try element(input);
    if value {
        bytes = try std_bytes::append(bytes, "true");
    } else {
        bytes = try std_bytes::append(bytes, "false");
    }
    return new CreatedArray.ok(new Array {
        bytes: bytes
    });
}
fn array_null(input: Array) -> CreatedArray {
    return new CreatedArray.ok(new Array {
        bytes: try std_bytes::append(try element(input), "null")
    });
}
fn array_object(input: Array, value: Object) -> CreatedArray {
    let mut bytes = try element(input);
    let nested = try finish(value);
    borrow nested[0..len_buffer(nested)] as text {
        bytes = try std_bytes::append(bytes, text);
    }
    return new CreatedArray.ok(new Array {
        bytes: bytes
    });
}
fn array_array(input: Array, value: Array) -> CreatedArray {
    let mut bytes = try element(input);
    let nested = try finish_array(value);
    borrow nested[0..len_buffer(nested)] as text {
        bytes = try std_bytes::append(bytes, text);
    }
    return new CreatedArray.ok(new Array {
        bytes: bytes
    });
}
fn finish_array(input: Array) -> std_bytes::Built {
    return std_bytes::append(input.bytes, "]");
}
fn array_field(heap: allocator, input: Object, name: &[]u8, value: Array) -> Created {
    let keyed = try key(heap, input, name);
    let mut bytes = keyed.bytes;
    let nested = try finish_array(value);
    borrow nested[0..len_buffer(nested)] as text {
        bytes = try std_bytes::append(bytes, text);
    }
    return new Created.ok(new Object {
        bytes: bytes
    });
}
