module std_map;
import std_collections as c;
export Entry;
export Map;
export Created;
export Value;
export PutStatus;
export Put;
export Found;
export Removed;
export create;
export put;
export get;
export remove;
export lookup;
export put_mut;
export remove_mut;
export clear;
struct Entry<K: equality, V: copy> {
    key: K,
    value: V
}
buffer Map < K: equality, V: copy >: Entry<K, V>;
result Created<K: equality, V: copy> {
    ok: Map<K, V>,
    err: i64
}
union Value<V: copy> {
    none,
    some: V
}
enum PutStatus {
    inserted,
    replaced,
    full
}
struct Put<K: equality, V: copy> {
    map: Map<K, V>,
    status: PutStatus
}
struct Found<K: equality, V: copy> {
    map: Map<K, V>,
    value: Value<V>
}
struct Removed<K: equality, V: copy> {
    map: Map<K, V>,
    value: Value<V>
}
fn create < K: equality, V: copy >(heap: allocator, capacity: u64) -> Created<K, V> {
    return acquire_buffer<Created<K, V>>(heap, capacity);
}
fn put < K: equality, V: copy >(input: Map<K, V>, key: K, value: V) -> Put<K, V> noalloc {
    let mut map = input;
    let mut index = 0u64;
    while index < len_buffer(map) {
        let entry = read_buffer(map, index);
        if entry.key == key {
            match write_buffer<c::Status>(map, index, new Entry<K, V> {
                key: key,
                value: value
            }) {
                c::Status.ok(discard) => {
                    return new Put<K, V> {
                        map: map,
                        status: new PutStatus.replaced
                    };
                },
                c::Status.err(discard) => {
                    return new Put<K, V> {
                        map: map,
                        status: new PutStatus.full
                    };
                }
            }
        }
        index += 1u64;
    }
    match append_buffer<c::Status>(map, new Entry<K, V> {
        key: key,
        value: value
    }) {
        c::Status.ok(discard) => {
            return new Put<K, V> {
                map: map,
                status: new PutStatus.inserted
            };
        },
        c::Status.err(discard) => {
            return new Put<K, V> {
                map: map,
                status: new PutStatus.full
            };
        }
    }
}
fn get < K: equality, V: copy >(input: Map<K, V>, key: K) -> Found<K, V> noalloc {
    let map = input;
    let mut index = 0u64;
    while index < len_buffer(map) {
        let entry = read_buffer(map, index);
        if entry.key == key {
            return new Found<K, V> {
                map: map,
                value: new Value<V>.some(entry.value)
            };
        }
        index += 1u64;
    }
    return new Found<K, V> {
        map: map,
        value: new Value<V>.none
    };
}
fn remove < K: equality, V: copy >(input: Map<K, V>, key: K) -> Removed<K, V> noalloc {
    let mut map = input;
    let count = len_buffer(map);
    let mut index = 0u64;
    while index < count {
        let entry = read_buffer(map, index);
        if entry.key == key {
            let last = read_buffer(map, count - 1u64);
            match write_buffer<c::Status>(map, index, last) {
                c::Status.ok(discard) => {},
                c::Status.err(discard) => {
                    return new Removed<K, V> {
                        map: map,
                        value: new Value<V>.none
                    };
                }
            }
            match resize_buffer<c::Status>(map, count - 1u64, last) {
                c::Status.ok(discard) => {
                    return new Removed<K, V> {
                        map: map,
                        value: new Value<V>.some(entry.value)
                    };
                },
                c::Status.err(discard) => {
                    return new Removed<K, V> {
                        map: map,
                        value: new Value<V>.none
                    };
                }
            }
        }
        index += 1u64;
    }
    return new Removed<K, V> {
        map: map,
        value: new Value<V>.none
    };
}
fn lookup < K: equality, V: copy >(map: &Map<K, V>, key: K) -> Value<V> noalloc {
    let mut i = 0u64;
    while i < len_buffer(map) {
        let e = read_buffer(map, i);
        if e.key == key {
            return new Value<V>.some(e.value);
        }
        i += 1u64;
    }
    return new Value<V>.none;
}
fn put_mut < K: equality, V: copy >(map: &mut Map<K, V>, key: K, value: V) -> PutStatus noalloc {
    let mut i = 0u64;
    while i < len_buffer(map) {
        let e = read_buffer(map, i);
        if e.key == key {
            match write_buffer<c::Status>(map, i, new Entry<K, V> {
                key: key,
                value: value
            }) {
                c::Status.ok(discard) => {
                    return new PutStatus.replaced;
                },
                c::Status.err(discard) => {
                    return new PutStatus.full;
                }
            }
        }
        i += 1u64;
    }
    match append_buffer<c::Status>(map, new Entry<K, V> {
        key: key,
        value: value
    }) {
        c::Status.ok(discard) => {
            return new PutStatus.inserted;
        },
        c::Status.err(discard) => {
            return new PutStatus.full;
        }
    }
}
fn remove_mut < K: equality, V: copy >(map: &mut Map<K, V>, key: K) -> Value<V> noalloc {
    let count = len_buffer(map);
    let mut i = 0u64;
    while i < count {
        let e = read_buffer(map, i);
        if e.key == key {
            let last = read_buffer(map, count - 1u64);
            match write_buffer<c::Status>(map, i, last) {
                c::Status.ok(discard) => {},
                c::Status.err(discard) => {
                    return new Value<V>.none;
                }
            }
            match resize_buffer<c::Status>(map, count - 1u64, last) {
                c::Status.ok(discard) => {
                    return new Value<V>.some(e.value);
                },
                c::Status.err(discard) => {
                    return new Value<V>.none;
                }
            }
        }
        i += 1u64;
    }
    return new Value<V>.none;
}
fn clear < K: equality, V: copy >(map: &mut Map<K, V>) -> c::Status noalloc {
    if len_buffer(map) == 0u64 {
        return new c::Status.ok(true);
    }
    return resize_buffer<c::Status>(map, 0u64, read_buffer(map, 0u64));
}
