module std_queue;
import std_collections as c;
export Queue;
export Created;
export Item;
export Added;
export Removed;
export create;
export push;
export pop;

buffer Queue<T:copy>:T;
result Created<T:copy>{ok:Queue<T>,err:i64}
union Item<T:copy>{none,some:T}
struct Added<T:copy>{queue:Queue<T>,accepted:bool}
struct Removed<T:copy>{queue:Queue<T>,item:Item<T>}

fn create<T:copy>(heap:allocator, capacity:u64)->Created<T> {
    return acquire_buffer<Created<T>>(heap, capacity);
}

fn push<T:copy>(input:Queue<T>, value:T)->Added<T> noalloc {
    let mut queue = input;
    match append_buffer<c::Status>(queue, value) {
        c::Status.ok(discard)=>{return new Added<T>{queue:queue,accepted:true};},
        c::Status.err(discard)=>{return new Added<T>{queue:queue,accepted:false};}
    }
}

fn pop<T:copy>(input:Queue<T>)->Removed<T> noalloc {
    let mut queue = input;
    let count = len_buffer(queue);
    if count == 0u64 {
        return new Removed<T>{queue:queue,item:new Item<T>.none};
    }
    let value = read_buffer(queue, 0);
    let mut index = 1u64;
    while index < count {
        match write_buffer<c::Status>(queue, index - 1u64, read_buffer(queue, index)) {
            c::Status.ok(discard)=>{},
            c::Status.err(discard)=>{return new Removed<T>{queue:queue,item:new Item<T>.none};}
        }
        index += 1u64;
    }
    match resize_buffer<c::Status>(queue, count - 1u64, value) {
        c::Status.ok(discard)=>{return new Removed<T>{queue:queue,item:new Item<T>.some(value)};},
        c::Status.err(discard)=>{return new Removed<T>{queue:queue,item:new Item<T>.none};}
    }
}
