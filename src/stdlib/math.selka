# The bit pattern of a binary64 value, as its u64 IEEE encoding. Every NaN
# answers the canonical quiet NaN, since no program may observe a NaN's payload.
public func bits(value: float) -> u64:
    if value != value:
        return 9221120237041090560
    return __float_bits(value)


# The binary64 value whose IEEE encoding is the given u64 pattern.
public func from_bits(pattern: u64) -> float:
    return __float_from_bits(pattern)


# The bit pattern of a binary32 value, as its u32 IEEE encoding; every NaN answers the canonical quiet NaN.
public func f32_bits(value: f32) -> u32:
    if value != value:
        return 2143289344
    return __f32_bits(value)


# The binary32 value whose IEEE encoding is the given u32 pattern.
public func f32_from_bits(pattern: u32) -> f32:
    return __f32_from_bits(pattern)


# Fused multiply-add: `a * b + c` with a single rounding (IEEE fusedMultiplyAdd, `llvm.fma`).
public func fma(a: float, b: float, c: float) -> float:
    return __float_fma(a, b, c)


# Fused multiply-add of binary32 values: `a * b + c` rounded once to binary32.
public func f32_fma(a: f32, b: f32, c: f32) -> f32:
    return __f32_fma(a, b, c)


# Scaling bounds of `hypot`, as Zig's std.math defines them: sqrt of the largest finite value
# halved, sqrt of the smallest normal, and the smallest subnormal times the upper bound.
const HYPOT_UPPER: float = __float_sqrt(1.7976931348623157e308 / 2.0)


const HYPOT_LOWER: float = __float_sqrt(2.2250738585072014e-308)


const HYPOT_SCALE: float = 5e-324 * HYPOT_UPPER


# Zig's `hypotFused` for x >= y >= 0: one correction step with fused multiply-adds.
func hypot_fused(x: float, y: float) -> float:
    const r = __float_sqrt(fma(x, x, y * y))
    const rr = r * r
    const xx = x * x
    const z = fma(-y, y, rr - xx) + fma(r, r, -rr) - fma(x, x, -xx)
    return r - z / (2.0 * r)


# Zig's `std.math.hypot`: sqrt(x * x + y * y) without unnecessary overflow or underflow, with
# the same rounding, so a value ported from Zig answers the same bits.
public func hypot(x: float, y: float) -> float:
    if is_inf(x) or is_inf(y):
        return infinity()
    if is_nan(x) or is_nan(y):
        return nan()
    mut major = fabs(x)
    mut minor = fabs(y)
    if minor > major:
        const tempo = major
        major = minor
        minor = tempo
    if minor == 0.0:
        return major
    if major - minor == major:
        return major
    if major > HYPOT_UPPER:
        return hypot_fused(major * HYPOT_SCALE, minor * HYPOT_SCALE) / HYPOT_SCALE
    if minor < HYPOT_LOWER:
        return hypot_fused(major / HYPOT_SCALE, minor / HYPOT_SCALE) * HYPOT_SCALE
    return hypot_fused(major, minor)


# Zig's `std.math.hypot` for binary32: the squares are formed and summed in binary64 and the root
# is rounded once to binary32, as Zig does.
public func f32_hypot(x: f32, y: f32) -> f32:
    if is_inf(float(x)) or is_inf(float(y)):
        return f32(infinity())
    if is_nan(float(x)) or is_nan(float(y)):
        return f32(nan())
    const wide_x = float(x)
    const wide_y = float(y)
    return f32(__float_sqrt(fma(wide_x, wide_x, wide_y * wide_y)))


# --- Zig-exact log10, exp, atan2 and pow_float -----------------------------------------------------------------
# These four answer the bits of the pinned Zig toolchain's `std.math.log10`, `exp`, `atan2` and `pow` for `f64`: each
# follows the code Zig runs, operation for operation and in the same order (no reordering, no fused multiply-add).
# `log10` and `exp` are the compiler_rt routines `@log10` and `@exp` lower to (musl / fdlibm); `atan2` and `atan` are
# `std/math/atan2.zig` and `atan.zig`; `pow_float` is `std/math/pow.zig` (Go's algorithm), which calls `ln`
# and `exp`. Special values (NaN, infinities,
# zeros, subnormals, negative bases) follow Zig's special cases. A NaN result is the canonical NaN, as everywhere in
# this module. The integer exponents Zig keeps as `i32` and the 32-bit words it keeps as `u32` are `int` here.
# 2^54: scale of a subnormal argument of `log10`.
const TWO54: float = 18014398509481984.0


# 2^52: scale of a subnormal argument of `ln`.
const TWO52: float = 4503599627370496.0


# The sign bit, the exponent field and the fraction field of a binary64 pattern.
const SIGN_BIT_MASK: u64 = 0x8000000000000000u64


const EXPONENT_MASK: u64 = 0x7ff0000000000000u64


const FRACTION_MASK: u64 = 0x000fffffffffffffu64


# ATAN2_PI and its low part, the constants of `atan2_64`.
const ATAN2_PI: float = 3.1415926535897931160e+00


const ATAN2_PI_LO: float = 1.2246467991473531772e-16


# The high 32 bits of a float's IEEE pattern, as an int.
func bits_high_word(x: float) -> int:
    return int(shift_right(bits(x), 32u64))


# Whether the sign bit is set (true for -0.0 and -inf).
func bits_sign_set(x: float) -> bool:
    return shift_right(bits(x), 63u64) == 1u64


# The number of leading zero bits of a 64-bit pattern (64 for zero).
func bits_leading_zeros(v: u64) -> int:
    mut count = 0
    mut probe = SIGN_BIT_MASK
    while count < 64 and bit_and(v, probe) == 0u64:
        count = count + 1
        probe = shift_right(probe, 1u64)
    return count


# The number of trailing zero bits of a 64-bit pattern (64 for zero).
func bits_trailing_zeros(v: u64) -> int:
    mut count = 0
    mut probe = 1u64
    while count < 64 and bit_and(v, probe) == 0u64:
        count = count + 1
        probe = shift_left(probe, 1u64)
    return count


# Zig's `std.math.Frexp(f64)`: the significand and exponent `frexp_parts` answers.
record FrexpParts:
    significand: float
    exponent: int


# Zig's `std.math.frexp(f64)`: x = significand * 2^exponent with |significand| in [0.5, 1) (zero and
# infinity give exponent 0; for a NaN Zig leaves the exponent undefined and this gives 0).
func frexp_parts(x: float) -> FrexpParts:
    const v = bits(x)
    const biased = int(bit_and(shift_right(v, 52u64), 0x7ffu64))
    const m = bit_and(v, FRACTION_MASK)
    if biased == 0:
        if m == 0u64:
            return FrexpParts(significand=x, exponent=0)
        # Subnormal: move the leading one of `m` to the (implicit) bit 52 and drop it.
        const top = 63 - bits_leading_zeros(m)
        const kept = bit_and(m, shift_left(1u64, u64(top)) - 1u64)
        const moved = shift_left(kept, u64(52 - top))
        const pattern = bit_or(bit_or(bit_and(v, SIGN_BIT_MASK), shift_left(1022u64, 52u64)), moved)
        return FrexpParts(significand=from_bits(pattern), exponent=top - 1073)
    if biased == 2047:
        return FrexpParts(significand=x, exponent=0)
    const pattern = bit_or(bit_and(v, 0x800fffffffffffffu64), shift_left(1022u64, 52u64))
    return FrexpParts(significand=from_bits(pattern), exponent=biased - 1022)


# Zig's `std.math.scalbn(f64, x, n)` (= `ldexp`): x * 2^n, rounded to nearest even in the subnormal range.
func scalbn_exact(x: float, n: int) -> float:
    if x != x or is_inf(x):
        return x
    const repr = bits(x)
    const sign_bit = bit_and(repr, SIGN_BIT_MASK)
    mut exponent = int(bit_and(shift_right(repr, 52u64), 0x7ffu64))
    if exponent == 0:
        exponent = exponent + 11 - bits_leading_zeros(shift_left(repr, 1u64))
    if n >= 0:
        if n > 2046 - exponent:
            return from_bits(bit_or(EXPONENT_MASK, sign_bit))
        if exponent + n <= 0:
            # The result is subnormal.
            return from_bits(bit_or(shift_left(repr, u64(n)), sign_bit))
        if exponent <= 0:
            # The result is normal but the argument needs shifting.
            const field = shift_left(u64(n + exponent), 52u64)
            const fraction = bit_and(shift_left(repr, u64(1 - exponent)), FRACTION_MASK)
            return from_bits(bit_or(bit_or(field, fraction), sign_bit))
        return from_bits(repr + shift_left(u64(n), 52u64))
    if n <= -exponent:
        if n < -(52 + exponent):
            # Severe underflow: a signed zero.
            return from_bits(sign_bit)
        # The result underflowed: shift and round, ties to even.
        mut shift = -n
        if -(exponent + n) + 1 < shift:
            shift = -(exponent + n) + 1
        const exact_tie = bits_trailing_zeros(repr) == shift - 1
        mut result = bit_and(repr, FRACTION_MASK)
        if exponent > 0:
            result = bit_or(result, 0x0010000000000000u64)
        result = shift_right(result, u64(shift - 1))
        result = shift_right(result + 1u64, 1u64)
        if exact_tie:
            result = bit_and(result, 0xfffffffffffffffeu64)
        return from_bits(bit_or(result, sign_bit))
    return from_bits(repr - shift_left(u64(-n), 52u64))


# Zig's `@log10` for f64 (compiler_rt `log10_f64`), bit for bit: the base-10 logarithm.
public func log10(x: float) -> float:
    const ix = bits(x)
    mut hx = int(shift_right(ix, 32u64))
    mut v = x
    mut k = 0
    if hx < 0x00100000 or hx >= 0x80000000:
        # log10(+-0) = -inf; log10(negative) = nan; a subnormal is scaled up.
        if bit_and(ix, 0x7fffffffffffffffu64) == 0u64:
            return -infinity()
        if hx >= 0x80000000:
            return nan()
        k = k - 54
        v = v * TWO54
        hx = bits_high_word(v)
    elif hx >= 0x7ff00000:
        return x
    elif hx == 0x3ff00000 and bit_and(ix, 0xffffffffu64) == 0u64:
        return 0.0
    # x into [sqrt(2) / 2, sqrt(2)].  As in the Zig, the low word is the *unscaled* argument's.
    hx = hx + (0x3ff00000 - 0x3fe6a09e)
    k = k + shift_right(hx, 20) - 0x3ff
    hx = bit_and(hx, 0x000fffff) + 0x3fe6a09e
    v = from_bits(bit_or(shift_left(u64(hx), 32u64), bit_and(ix, 0xffffffffu64)))
    const f = v - 1.0
    const hfsq = 0.5 * f * f
    const s = f / (2.0 + f)
    const z = s * s
    const w = z * z
    const t1 = w * (3.999999999940941908e-01 + w * (2.222219843214978396e-01 + w * 1.531383769920937332e-01))
    const t2 = z * (6.666666666666735130e-01 + w * (2.857142874366239149e-01 + w * (1.818357216161805012e-01 + w * 1.479819860511658591e-01)))
    const r = t2 + t1
    # hi + lo = f - hfsq + s * (hfsq + r) ~ log(1 + f)
    const hi = from_bits(bit_and(bits(f - hfsq), 0xffffffff00000000u64))
    const lo = f - hi - hfsq + s * (hfsq + r)
    # val_hi + val_lo ~ log10(1 + f) + k * log10(2)
    mut val_hi = hi * 4.34294481878168880939e-01
    const dk = float(k)
    const y = dk * 3.01029995663611771306e-01
    mut val_lo = dk * 3.69423907715893078616e-13 + (lo + hi) * 2.50829467116452752298e-11 + lo * 4.34294481878168880939e-01
    # Extra precision multiplication.
    const ww = y + val_hi
    val_lo = val_lo + ((y - ww) + val_hi)
    val_hi = ww
    return val_lo + val_hi


# One 64-bit word of `LOG_TABLE`, big endian, as a float (two 32-bit halves, no loop).
func log_table_word(row: int, column: int) -> float:
    const base = row * 32 + column * 8
    const high = LOG_TABLE[base] * 16777216 + LOG_TABLE[base + 1] * 65536 + LOG_TABLE[base + 2] * 256 + LOG_TABLE[base + 3]
    const low = LOG_TABLE[base + 4] * 16777216 + LOG_TABLE[base + 5] * 65536 + LOG_TABLE[base + 6] * 256 + LOG_TABLE[base + 7]
    return from_bits(bit_or(shift_left(u64(high), 32u64), u64(low)))


# The natural logarithm's table (compiler_rt `log_f64`'s `tab` and `tab2`): 128 rows of four
# big-endian binary64 words, `invc`, `logc`, `chi`, `clo`.  Generated from lib/compiler_rt/log.zig
# of the pinned toolchain (hex floats converted exactly); `support_math_test.selka` checks its crc32.
