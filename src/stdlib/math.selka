# One 24-bit word of 2/pi.
func ipio2_word(index: int) -> int:
    const base = index * 3
    return IPIO2[base] * 65536 + IPIO2[base + 1] * 256 + IPIO2[base + 2]


# A list of `count` zeros, the scratch arrays of `rem_pio2_large`.
func zero_floats(count: int) -> float[]:
    mut values: float[] = []
    for position in range(0, count):
        append(mut values, 0.0)
    return values


func zero_ints(count: int) -> int[]:
    mut values: int[] = []
    for position in range(0, count):
        append(mut values, 0)
    return values


# pi/2 cut into 24-bit chunks (compiler_rt `PIo2`).
func pio2_chunks() -> float[]:
    return [1.57079625129699707031e+00, 7.54978941586159635335e-08, 5.39030252995776476554e-15, 3.28200341580791294123e-22, 1.27065575308067607349e-29, 1.22933308981111328932e-36, 2.73370053816464559624e-44, 2.16741683877804819444e-51]


# compiler_rt `rem_pio2_large` (musl `__rem_pio2_large`) for binary64 (`prec` = 1): the remainder of x * 2^e0 by pi/2 from the
# Payne-Hanek reduction, with `x` the `nx` 24-bit pieces of the argument. The same steps, indexes and `goto recompute` loop.
func rem_pio2_large(x: float[], e0: int, nx: int) -> Pio2Reduction:
    const jk = 4
    const jp = 4
    const two24 = 16777216.0
    const two_m24 = 5.960464477539063e-08
    const jx = nx - 1
    mut jv = (e0 - 3) // 24
    if jv < 0:
        jv = 0
    mut q0 = e0 - 24 * (jv + 1)
    mut f = zero_floats(20)
    mut fq = zero_floats(20)
    mut q = zero_floats(20)
    mut iq = zero_ints(20)
    # set up f[0] to f[jx+jk] where f[jx+jk] = ipio2[jv+jk]
    mut j = jv - jx
    const m = jx + jk
    mut i = 0
    while i <= m:
        if j < 0:
            f[i] = 0.0
        else:
            f[i] = float(ipio2_word(j))
        i = i + 1
        j = j + 1
    # compute q[0],q[1],...q[jk]
    i = 0
    while i <= jk:
        j = 0
        mut fw = 0.0
        while j <= jx:
            fw = fw + x[j] * f[jx + i - j]
            j = j + 1
        q[i] = fw
        i = i + 1
    mut jz = jk
    mut n = 0
    mut ih = 0
    mut z = 0.0
    mut recompute = True
    while recompute:
        recompute = False
        # distill q[] into iq[] reversingly
        i = 0
        j = jz
        z = q[jz]
        while j > 0:
            const chunk = float(int(two_m24 * z))
            iq[i] = int(z - two24 * chunk)
            z = q[j - 1] + chunk
            i = i + 1
            j = j - 1
        # compute n
        z = scalbn_exact(z, q0)
        z = z - 8.0 * floor(z * 0.125)
        n = int(z)
        z = z - float(n)
        ih = 0
        if q0 > 0:
            # need iq[jz-1] to determine n
            i = shift_right(iq[jz - 1], 24 - q0)
            n = n + i
            iq[jz - 1] = iq[jz - 1] - shift_left(i, 24 - q0)
            ih = shift_right(iq[jz - 1], 23 - q0)
        elif q0 == 0:
            ih = shift_right(iq[jz - 1], 23)
        elif z >= 0.5:
            ih = 2
        if ih > 0:
            # q > 0.5
            n = n + 1
            mut carry = 0
            i = 0
            while i < jz:
                # compute 1-q
                j = iq[i]
                if carry == 0:
                    if j != 0:
                        carry = 1
                        iq[i] = 0x1000000 - j
                else:
                    iq[i] = 0xffffff - j
                i = i + 1
            if q0 > 0:
                # rare case: chance is 1 in 12
                if q0 == 1:
                    iq[jz - 1] = bit_and(iq[jz - 1], 0x7fffff)
                elif q0 == 2:
                    iq[jz - 1] = bit_and(iq[jz - 1], 0x3fffff)
            if ih == 2:
                z = 1.0 - z
                if carry != 0:
                    z = z - scalbn_exact(1.0, q0)
        # check if recomputation is needed
        if z == 0.0:
            j = 0
            i = jz - 1
            while i >= jk:
                j = bit_or(j, iq[i])
                i = i - 1
            if j == 0:
                # need recomputation: k = no. of terms needed
                mut k = 1
                while iq[jk - k] == 0:
                    k = k + 1
                # add q[jz+1] to q[jz+k]
                i = jz + 1
                while i <= jz + k:
                    f[jx + i] = float(ipio2_word(jv + i))
                    j = 0
                    mut fw = 0.0
                    while j <= jx:
                        fw = fw + x[j] * f[jx + i - j]
                        j = j + 1
                    q[i] = fw
                    i = i + 1
                jz = jz + k
                recompute = True
        if not recompute:
            # chop off zero terms
            if z == 0.0:
                jz = jz - 1
                q0 = q0 - 24
                while iq[jz] == 0:
                    jz = jz - 1
                    q0 = q0 - 24
            else:
                # break z into 24-bit if necessary
                z = scalbn_exact(z, -q0)
                if z >= two24:
                    const chunk = float(int(two_m24 * z))
                    iq[jz] = int(z - two24 * chunk)
                    jz = jz + 1
                    q0 = q0 + 24
                    iq[jz] = int(chunk)
                else:
                    iq[jz] = int(z)
    # convert integer "bit" chunk to floating-point value
    mut fw = scalbn_exact(1.0, q0)
    i = jz
    while i >= 0:
        q[i] = fw * float(iq[i])
        fw = fw * two_m24
        i = i - 1
    # compute PIo2[0,...,jp]*q[jz,...,0]
    const pio2 = pio2_chunks()
    i = jz
    while i >= 0:
        fw = 0.0
        mut k = 0
        while k <= jp and k <= jz - i:
            fw = fw + pio2[k] * q[i + k]
            k = k + 1
        fq[jz - i] = fw
        i = i - 1
    # compress fq[] into y[]
    fw = 0.0
    i = jz
    while i >= 0:
        fw = fw + fq[i]
        i = i - 1
    mut y0 = fw
    if ih != 0:
        y0 = -fw
    fw = fq[0] - fw
    i = 1
    while i <= jz:
        fw = fw + fq[i]
        i = i + 1
    mut y1 = fw
    if ih != 0:
        y1 = -fw
    return Pio2Reduction(n=bit_and(n, 7), y0=y0, y1=y1)


# The biased exponent field of a float.
func exponent_field(x: float) -> int:
    return int(bit_and(shift_right(bits(x), 52u64), 0x7ffu64))


# compiler_rt `rem_pio2`'s `medium`: `fn = rint(x / (pi/2))` with up to three rounds of the 33-bit pieces
# of pi/2 (good to 151 bits). `ix` is the high word of |x| without the sign.
func rem_pio2_medium(ix: int, x: float) -> Pio2Reduction:
    # 1.5 / floatEps(f64) = 1.5 * 2^52.
    const toint = 6755399441055744.0
    mut fnv = x * RP_INVPIO2 + toint - toint
    mut n = int(fnv)
    mut r = x - fnv * RP_PIO2_1
    mut w = fnv * RP_PIO2_1T
    # Matters with directed rounding.
    if r - w < -RP_PIO4:
        n = n - 1
        fnv = fnv - 1.0
        r = x - fnv * RP_PIO2_1
        w = fnv * RP_PIO2_1T
    elif r - w > RP_PIO4:
        n = n + 1
        fnv = fnv + 1.0
        r = x - fnv * RP_PIO2_1
        w = fnv * RP_PIO2_1T
    mut y0 = r - w
    mut ey = exponent_field(y0)
    const ex = shift_right(ix, 20)
    # 2nd round, good to 118 bits
    if ex - ey > 16:
        mut t = r
        w = fnv * RP_PIO2_2
        r = t - w
        w = fnv * RP_PIO2_2T - ((t - r) - w)
        y0 = r - w
        ey = exponent_field(y0)
        # 3rd round, good to 151 bits, covers all cases
        if ex - ey > 49:
            t = r
            w = fnv * RP_PIO2_3
            r = t - w
            w = fnv * RP_PIO2_3T - ((t - r) - w)
            y0 = r - w
    return Pio2Reduction(n=n, y0=y0, y1=(r - y0) - w)


# The reduction of x by `m` quarter turns with one round of the 33-bit piece (`z = x -+ m*pio2_1`, `y0 = z -+ m*pio2_1t`,
# `y1 = (z - y0) -+ m*pio2_1t`), as Zig's `rem_pio2` writes each of its cases. `m` is exact in binary64.
func rem_pio2_quarters(x: float, negative: bool, m: float) -> Pio2Reduction:
    const hi = m * RP_PIO2_1
    const lo = m * RP_PIO2_1T
    if not negative:
        const z = x - hi
        const y0 = z - lo
        return Pio2Reduction(n=int(m), y0=y0, y1=(z - y0) - lo)
    const z = x + hi
    const y0 = z + lo
    return Pio2Reduction(n=-int(m), y0=y0, y1=(z - y0) + lo)


# compiler_rt `rem_pio2` (musl `__rem_pio2`) for a finite x with |x| > pi/4: `x = n * (pi/2) + (y0 + y1)`. An infinity or a NaN
# answers n = 0 and NaN, as in Zig; the callers handle those first.
func rem_pio2(x: float) -> Pio2Reduction:
    const ui = bits(x)
    const negative = shift_right(ui, 63u64) == 1u64
    const ix = int(bit_and(shift_right(ui, 32u64), 0x7fffffffu64))
    # |x| ~<= 5pi/4
    if ix <= 0x400f6a7a:
        # |x| ~= pi/2 or 2pi/2
        if bit_and(ix, 0xfffff) == 0x921fb:
            return rem_pio2_medium(ix, x)
        # |x| ~<= 3pi/4
        if ix <= 0x4002d97c:
            return rem_pio2_quarters(x, negative, 1.0)
        return rem_pio2_quarters(x, negative, 2.0)
    # |x| ~<= 9pi/4
    if ix <= 0x401c463b:
        # |x| ~<= 7pi/4
        if ix <= 0x4015fdbc:
            # |x| ~= 3pi/2
            if ix == 0x4012d97c:
                return rem_pio2_medium(ix, x)
            return rem_pio2_quarters(x, negative, 3.0)
        # |x| ~= 4pi/2
        if ix == 0x401921fb:
            return rem_pio2_medium(ix, x)
        return rem_pio2_quarters(x, negative, 4.0)
    # |x| ~< 2^20*(pi/2), medium size
    if ix < 0x413921fb:
        return rem_pio2_medium(ix, x)
    # all other (large) arguments: x is inf or NaN
    if ix >= 0x7ff00000:
        const bad = x - x
        return Pio2Reduction(n=0, y0=bad, y1=bad)
    # set z = scalbn(|x|, -ilogb(x) + 23)
    mut z = from_bits(bit_or(bit_and(ui, 0x000fffffffffffffu64), shift_left(1046u64, 52u64)))
    mut tx: float[] = []
    for index in range(0, 2):
        const piece = float(int(z))
        append(mut tx, piece)
        z = (z - piece) * 16777216.0
    append(mut tx, z)
    # skip zero terms, first term is non-zero
    mut last = 2
    while tx[last] == 0.0:
        last = last - 1
    const reduced = rem_pio2_large(tx, shift_right(ix, 20) - 1046, last + 1)
    if negative:
        return Pio2Reduction(n=-reduced.n, y0=-reduced.y0, y1=-reduced.y1)
    return reduced


# compiler_rt `trig.zig` `sin` (musl `__sin`): sin(x + y) for |x| <= pi/4, with `y` the tail of `x`; `tail` is false when `y` is zero.
func kernel_sin(x: float, y: float, tail: bool) -> float:
    const s1 = -1.66666666666666324348e-01
    const s2 = 8.33333333332248946124e-03
    const s3 = -1.98412698298579493134e-04
    const s4 = 2.75573137070700676789e-06
    const s5 = -2.50507602534068634195e-08
    const s6 = 1.58969099521155010221e-10
    const z = x * x
    const w = z * z
    const r = s2 + z * (s3 + z * s4) + z * w * (s5 + z * s6)
    const v = z * x
    if not tail:
        return x + v * (s1 + z * r)
    return x - ((z * (0.5 * y - v * r) - y) - v * s1)


# compiler_rt `trig.zig` `cos` (musl `__cos`): cos(x + y) for |x| <= pi/4, with `y` the tail of `x`.
func kernel_cos(x: float, y: float) -> float:
    const c1 = 4.16666666666666019037e-02
    const c2 = -1.38888888888741095749e-03
    const c3 = 2.48015872894767294178e-05
    const c4 = -2.75573143513906633035e-07
    const c5 = 2.08757232129817482790e-09
    const c6 = -1.13596475577881948265e-11
    const z = x * x
    const zs = z * z
    const r = z * (c1 + z * (c2 + z * c3)) + zs * zs * (c4 + z * (c5 + z * c6))
    const hz = 0.5 * z
    const w = 1.0 - hz
    return w + (((1.0 - w) - hz) + (z * r - x * y))


# compiler_rt `trig.zig` `tan` (musl `__tan`): tan(x + y) for |x| <= pi/4 (`odd` false) or -1/tan(x + y) (`odd` true), with `y` the
# tail of `x`.
func kernel_tan(x_in: float, y_in: float, odd: bool) -> float:
    const t0 = 3.33333333333334091986e-01
    const t1 = 1.33333333333201242699e-01
    const t2 = 5.39682539762260521377e-02
    const t3 = 2.18694882948595424599e-02
    const t4 = 8.86323982359930005737e-03
    const t5 = 3.59207910759131235356e-03
    const t6 = 1.45620945432529025516e-03
    const t7 = 5.88041240820264096874e-04
    const t8 = 2.46463134818469906812e-04
    const t9 = 7.81794442939557092300e-05
    const t10 = 7.14072491382608190305e-05
    const t11 = -1.85586374855275456654e-05
    const t12 = 2.59073051863633712884e-05
    const pio4 = 7.85398163397448278999e-01
    const pio4lo = 3.06161699786838301793e-17
    mut x = x_in
    mut y = y_in
    const hx = int(shift_right(bits(x), 32u64))
    # |x| >= 0.6744
    const big = bit_and(hx, 0x7fffffff) >= 0x3fe59428
    mut negative = False
    if big:
        negative = shift_right(hx, 31) != 0
        if negative:
            x = -x
            y = -y
        x = (pio4 - x) + (pio4lo - y)
        y = 0.0
    const z = x * x
    mut w = z * z
    # Break x^5*(T[1]+x^2*T[2]+...) into x^5(T[1]+x^4*T[3]+...+x^20*T[11]) + x^5(x^2*(T[2]+x^4*T[4]+...+x^22*[T12]))
    mut r = t1 + w * (t3 + w * (t5 + w * (t7 + w * (t9 + w * t11))))
    mut v = z * (t2 + w * (t4 + w * (t6 + w * (t8 + w * (t10 + w * t12)))))
    mut s = z * x
    r = y + z * (s * (r + v) + y) + s * t0
    w = x + r
    if big:
        s = 1.0
        if odd:
            s = -1.0
        v = s - 2.0 * (x + (r - w * w / (w + s)))
        if negative:
            return -v
        return v
    if not odd:
        return w
    # -1.0/(x+r) has up to 2ulp error, so compute it accurately
    const w0 = from_bits(bit_and(bits(w), 0xffffffff00000000u64))
    v = r - (w0 - x)
    const a = -1.0 / w
    const a0 = from_bits(bit_and(bits(a), 0xffffffff00000000u64))
    return a0 + a * (1.0 + a0 * w0 + a0 * v)


# Zig's `@sin` for f64 (compiler_rt `sin_f64`, from musl), bit for bit: the sine of an angle in radians. Sine of an
# infinity or a NaN is NaN, and the sine of a signed zero is that zero.
public func sin(x: float) -> float:
    const ix = bit_and(int(shift_right(bits(x), 32u64)), 0x7fffffff)
    # |x| ~< pi/4
    if ix <= 0x3fe921fb:
        # |x| < 2^-26
        if ix < 0x3e500000:
            return x
        return kernel_sin(x, 0.0, False)
    # sin(Inf or NaN) is NaN
    if ix >= 0x7ff00000:
        return x - x
    const reduced = rem_pio2(x)
    const quadrant = bit_and(reduced.n, 3)
    if quadrant == 0:
        return kernel_sin(reduced.y0, reduced.y1, True)
    if quadrant == 1:
        return kernel_cos(reduced.y0, reduced.y1)
    if quadrant == 2:
        return -kernel_sin(reduced.y0, reduced.y1, True)
    return -kernel_cos(reduced.y0, reduced.y1)


# Zig's `@cos` for f64 (compiler_rt `cos_f64`, from musl), bit for bit: the cosine of an angle in radians. Cosine of an
# infinity or a NaN is NaN.
public func cos(x: float) -> float:
    const ix = bit_and(int(shift_right(bits(x), 32u64)), 0x7fffffff)
    # |x| ~< pi/4
    if ix <= 0x3fe921fb:
        # |x| < 2^-27 * sqrt(2)
        if ix < 0x3e46a09e:
            return 1.0
        return kernel_cos(x, 0.0)
    # cos(Inf or NaN) is NaN
    if ix >= 0x7ff00000:
        return x - x
    const reduced = rem_pio2(x)
    const quadrant = bit_and(reduced.n, 3)
    if quadrant == 0:
        return kernel_cos(reduced.y0, reduced.y1)
    if quadrant == 1:
        return -kernel_sin(reduced.y0, reduced.y1, True)
    if quadrant == 2:
        return -kernel_cos(reduced.y0, reduced.y1)
    return kernel_sin(reduced.y0, reduced.y1, True)


# Zig's `@tan` for f64 (compiler_rt `tan_f64`, from musl), bit for bit: the tangent of an angle in radians. Tangent of an
# infinity or a NaN is NaN.
public func tan(x: float) -> float:
    const ix = bit_and(int(shift_right(bits(x), 32u64)), 0x7fffffff)
    # |x| ~< pi/4
    if ix <= 0x3fe921fb:
        # |x| < 2^-27
        if ix < 0x3e400000:
            return x
        return kernel_tan(x, 0.0, False)
    # tan(Inf or NaN) is NaN
    if ix >= 0x7ff00000:
        return x - x
    const reduced = rem_pio2(x)
    return kernel_tan(reduced.y0, reduced.y1, bit_and(reduced.n, 1) != 0)


# --- binary32 forms: f32_log10, f32_exp, f32_atan2 and f32_pow_float ------------------------------------------------
# The same four for `f32`, each following Zig's binary32 code: `log10_f32` and `exp_f32` and `log_f32` of compiler_rt (musl's
# `log10f`, `expf` and `logf`), `atan2_32` and `atanBinary32`, and the generic `pow`, `frexp` and `ldexp` instantiated at `f32`.
# Every operation rounds to binary32, as Zig's do; the patterns are handled as `u64`, whose upper half stays zero.
# The binary32 pattern of a value, widened so the pattern arithmetic can share the binary64 helpers.
func f32_pattern(x: f32) -> u64:
    return u64(f32_bits(x))


# The value a binary32 pattern held in a `u64` names.
func f32_of_pattern(pattern: u64) -> f32:
    return f32_from_bits(u32(pattern))


# The absolute value of a binary32 number, by clearing the sign bit.
func f32_magnitude(x: f32) -> f32:
    return f32_of_pattern(bit_and(f32_pattern(x), 0x7fffffffu64))


# Whether a binary32 number is infinite.
func f32_is_inf(x: f32) -> bool:
    return bit_and(f32_pattern(x), 0x7fffffffu64) == 0x7f800000u64


# The square root of a binary32 number: binary64 carries the root of a binary32 value to enough bits that rounding it once more
# to binary32 is the correctly rounded binary32 root, which is what Zig's `@sqrt` answers.
func f32_root(x: f32) -> f32:
    return f32(__float_sqrt(float(x)))


# The number of leading zero bits of a 32-bit pattern (32 for zero).
func bits_leading_zeros32(v: u64) -> int:
    return bits_leading_zeros(v) - 32


# Zig's `std.math.scalbn(f32, x, n)` (= `ldexp`): x * 2^n, rounded to nearest even in the subnormal range.
func scalbn_f32(x: f32, n: int) -> f32:
    const repr = f32_pattern(x)
    if bit_and(repr, 0x7fffffffu64) >= 0x7f800000u64:
        return x
    const sign_bit = bit_and(repr, 0x80000000u64)
    mut exponent = int(bit_and(shift_right(repr, 23u64), 0xffu64))
    if exponent == 0:
        exponent = exponent + 8 - bits_leading_zeros32(bit_and(shift_left(repr, 1u64), 0xffffffffu64))
    if n >= 0:
        if n > 254 - exponent:
            return f32_of_pattern(bit_or(0x7f800000u64, sign_bit))
        if exponent + n <= 0:
            return f32_of_pattern(bit_or(bit_and(shift_left(repr, u64(n)), 0xffffffffu64), sign_bit))
        if exponent <= 0:
            const field = shift_left(u64(n + exponent), 23u64)
            const fraction = bit_and(shift_left(repr, u64(1 - exponent)), 0x7fffffu64)
            return f32_of_pattern(bit_or(bit_or(field, fraction), sign_bit))
        return f32_of_pattern(repr + shift_left(u64(n), 23u64))
    if n <= -exponent:
        if n < -(23 + exponent):
            return f32_of_pattern(sign_bit)
        mut shift = -n
        if -(exponent + n) + 1 < shift:
            shift = -(exponent + n) + 1
        const exact_tie = bits_trailing_zeros(repr) == shift - 1
        mut result = bit_and(repr, 0x7fffffu64)
        if exponent > 0:
            result = bit_or(result, 0x800000u64)
        result = shift_right(result, u64(shift - 1))
        result = shift_right(result + 1u64, 1u64)
        if exact_tie:
            result = bit_and(result, 0xfffffffeu64)
        return f32_of_pattern(bit_or(result, sign_bit))
    return f32_of_pattern(repr - shift_left(u64(-n), 23u64))


# Zig's `std.math.frexp(f32)`: x = significand * 2^exponent with |significand| in [0.5, 1) for a finite nonzero x.
record Frexp32Parts:
    significand: f32
    exponent: int


func frexp32_parts(x: f32) -> Frexp32Parts:
    const v = f32_pattern(x)
    const biased = int(bit_and(shift_right(v, 23u64), 0xffu64))
    const m = bit_and(v, 0x7fffffu64)
    if biased == 0:
        if m == 0u64:
            return Frexp32Parts(significand=x, exponent=0)
        # Subnormal: the offset counts the zeros above the leading one of the 23-bit fraction.
        const offset = bits_leading_zeros32(m) - 9
        const moved = bit_and(shift_left(m, u64(offset + 1)), 0x7fffffu64)
        const pattern = bit_or(bit_or(bit_and(v, 0x80000000u64), shift_left(126u64, 23u64)), moved)
        return Frexp32Parts(significand=f32_of_pattern(pattern), exponent=-126 - offset)
    if biased == 255:
        return Frexp32Parts(significand=x, exponent=0)
    const pattern = bit_or(bit_and(v, 0x807fffffu64), shift_left(126u64, 23u64))
    return Frexp32Parts(significand=f32_of_pattern(pattern), exponent=biased - 126)


# Zig's `@log10` for f32 (compiler_rt `log10_f32`, musl's `log10f`): the base-10 logarithm, bit for bit.
public func f32_log10(value: f32) -> f32:
    const ivln10hi = 4.3432617188e-01f32
    const ivln10lo = -3.1689971365e-05f32
    const log10_2hi = 3.0102920532e-01f32
    const log10_2lo = 7.9034151668e-07f32
    const lg1 = 0.66666662693023681640625f32
    const lg2 = 0.4000097215175628662109375f32
    const lg3 = 0.284987866878509521484375f32
    const lg4 = 0.2427907884120941162109375f32
    mut x = value
    mut ix = f32_pattern(x)
    mut k = 0
    if ix < 0x00800000u64 or shift_right(ix, 31u64) != 0u64:
        # log(+-0) = -inf; log(negative) = nan; a subnormal is scaled up.
        if bit_and(ix, 0x7fffffffu64) == 0u64:
            return f32(-infinity())
        if shift_right(ix, 31u64) != 0u64:
            return f32(nan())
        k = k - 25
        x = x * 33554432.0f32
        ix = f32_pattern(x)
    elif ix >= 0x7f800000u64:
        return x
    elif ix == 0x3f800000u64:
        return 0.0f32
    # x into [sqrt(2) / 2, sqrt(2)]
    ix = ix + (0x3f800000u64 - 0x3f3504f3u64)
    k = k + int(shift_right(ix, 23u64)) - 0x7f
    ix = bit_and(ix, 0x007fffffu64) + 0x3f3504f3u64
    x = f32_of_pattern(ix)
    const f = x - 1.0f32
    const s = f / (2.0f32 + f)
    const z = s * s
    const w = z * z
    const t1 = w * (lg2 + w * lg4)
    const t2 = z * (lg1 + w * lg3)
    const r = t2 + t1
    const hfsq = 0.5f32 * f * f
    const hi = f32_of_pattern(bit_and(f32_pattern(f - hfsq), 0xfffff000u64))
    const lo = f - hi - hfsq + s * (hfsq + r)
    const dk = f32(k)
    return dk * log10_2lo + (lo + hi) * ivln10lo + lo * ivln10hi + hi * ivln10hi + dk * log10_2hi


# Zig's `@log` for f32 (compiler_rt `log_f32`, musl's `logf`): the natural logarithm, the kernel of `f32_pow_float`.
func f32_ln(value: f32) -> f32:
    const ln2_hi = 6.9313812256e-01f32
    const ln2_lo = 9.0580006145e-06f32
    const lg1 = 0.66666662693023681640625f32
    const lg2 = 0.4000097215175628662109375f32
    const lg3 = 0.284987866878509521484375f32
    const lg4 = 0.2427907884120941162109375f32
    mut x = value
    mut ix = f32_pattern(x)
    mut k = 0
    if ix < 0x00800000u64 or shift_right(ix, 31u64) != 0u64:
        if bit_and(ix, 0x7fffffffu64) == 0u64:
            return f32(-infinity())
        if shift_right(ix, 31u64) != 0u64:
            return f32(nan())
        k = k - 25
        x = x * 33554432.0f32
        ix = f32_pattern(x)
    elif ix >= 0x7f800000u64:
        return x
    elif ix == 0x3f800000u64:
        return 0.0f32
    ix = ix + (0x3f800000u64 - 0x3f3504f3u64)
    k = k + int(shift_right(ix, 23u64)) - 0x7f
    ix = bit_and(ix, 0x007fffffu64) + 0x3f3504f3u64
    x = f32_of_pattern(ix)
    const f = x - 1.0f32
    const s = f / (2.0f32 + f)
    const z = s * s
    const w = z * z
    const t1 = w * (lg2 + w * lg4)
    const t2 = z * (lg1 + w * lg3)
    const r = t2 + t1
    const hfsq = 0.5f32 * f * f
    const dk = f32(k)
    return s * (hfsq + r) + dk * ln2_lo - hfsq + f + dk * ln2_hi


# Zig's `@exp` for f32 (compiler_rt `exp_f32`, musl's `expf`): e raised to the power x, bit for bit.
public func f32_exp(value: f32) -> f32:
    const ln2hi = 6.9314575195e-1f32
    const ln2lo = 1.4286067653e-6f32
    const invln2 = 1.4426950216e+0f32
    const p1 = 1.6666625440e-1f32
    const p2 = -2.7667332906e-3f32
    mut x = value
    mut hx = f32_pattern(x)
    const negative = int(shift_right(hx, 31u64))
    hx = bit_and(hx, 0x7fffffffu64)
    if x != x:
        return x
    # |x| >= 87.33655 or nan
    if hx >= 0x42aeac50u64:
        if hx > 0x7f800000u64:
            return x
        # x >= 88.722839
        if hx >= 0x42b17218u64 and negative == 0:
            return x * 170141183460469231731687303715884105728.0f32
        # x <= -103.972084
        if negative != 0 and hx >= 0x42cff1b5u64:
            return 0.0f32
    mut k = 0
    mut hi = 0.0f32
    mut lo = 0.0f32
    if hx > 0x3eb17218u64:
        # |x| > 0.5 * ln2
        if hx > 0x3f851592u64:
            if negative == 1:
                k = int(invln2 * x + -0.5f32)
            else:
                k = int(invln2 * x + 0.5f32)
        else:
            k = 1 - negative - negative
        const fk = f32(k)
        hi = x - fk * ln2hi
        lo = fk * ln2lo
        x = hi - lo
    elif hx > 0x39000000u64:
        # |x| > 2^-14
        hi = x
    else:
        return 1.0f32 + x
    const xx = x * x
    const c = x - xx * (p1 + xx * p2)
    const y = 1.0f32 + (x * c / (2.0f32 - c) - lo + hi)
    if k == 0:
        return y
    return scalbn_f32(y, k)


# Zig's `std.math.atan(f32)` (`atanBinary32`), the kernel of `f32_atan2`.
func f32_atan(x: f32) -> f32:
    const atanhi0 = 4.6364760399e-01f32
    const atanhi1 = 7.8539812565e-01f32
    const atanhi2 = 9.8279368877e-01f32
    const atanhi3 = 1.5707962513e+00f32
    const atanlo0 = 5.0121582440e-09f32
    const atanlo1 = 3.7748947079e-08f32
    const atanlo2 = 3.4473217170e-08f32
    const atanlo3 = 7.5497894159e-08f32
    const at0 = 3.3333328366e-01f32
    const at1 = -1.9999158382e-01f32
    const at2 = 1.4253635705e-01f32
    const at3 = -1.0648017377e-01f32
    const at4 = 6.1687607318e-02f32
    const pattern = f32_pattern(x)
    const ix = bit_and(pattern, 0x7fffffffu64)
    const negative = shift_right(pattern, 31u64) != 0u64
    # |x| >= 2^26 or nan
    if ix >= 0x4c800000u64:
        if x != x:
            return x
        const big = atanhi3 + 7.52316384526264e-37f32
        if negative:
            return -big
        return big
    mut v = x
    mut id = -1
    if ix < 0x3ee00000u64:
        # |x| < 0.4375
        if ix < 0x39800000u64:
            return x
    else:
        v = f32_magnitude(x)
        if ix < 0x3f980000u64:
            if ix < 0x3f300000u64:
                id = 0
                v = (2.0f32 * v - 1.0f32) / (2.0f32 + v)
            else:
                id = 1
                v = (v - 1.0f32) / (v + 1.0f32)
        elif ix < 0x401c0000u64:
            id = 2
            v = (v - 1.5f32) / (1.0f32 + 1.5f32 * v)
        else:
            id = 3
            v = -1.0f32 / v
    const z = v * v
    const w = z * z
    const s1 = z * (at0 + w * (at2 + w * at4))
    const s2 = w * (at1 + w * at3)
    if id < 0:
        return v - v * (s1 + s2)
    mut hi = atanhi3
    mut lo = atanlo3
    match id:
        case 0:
            hi = atanhi0
            lo = atanlo0
        case 1:
            hi = atanhi1
            lo = atanlo1
        case 2:
            hi = atanhi2
            lo = atanlo2
        case _:
            hi = atanhi3
            lo = atanlo3
    const r = hi - ((v * (s1 + s2) - lo) - v)
    if negative:
        return -r
    return r


# Zig's `std.math.atan2(f32, f32)` (`atan2_32`, musl's `atan2f`): the angle of the point (x, y), in [-pi, pi], bit for bit.
public func f32_atan2(y: f32, x: f32) -> f32:
    const pi32 = 3.1415927410e+00f32
    const pi32_lo = -8.7422776573e-08f32
    if x != x or y != y:
        return x + y
    const ix0 = f32_pattern(x)
    const iy0 = f32_pattern(y)
    # x = 1.0
    if ix0 == 0x3f800000u64:
        return f32_atan(y)
    # 2 * sign(x) + sign(y)
    const m = bit_or(bit_and(shift_right(iy0, 31u64), 1u64), bit_and(shift_right(ix0, 30u64), 2u64))
    const ix = bit_and(ix0, 0x7fffffffu64)
    const iy = bit_and(iy0, 0x7fffffffu64)
    if iy == 0u64:
        # atan2(+-0, x)
        if m == 0u64 or m == 1u64:
            return y
        if m == 2u64:
            return pi32
        return -pi32
    if ix == 0u64:
        # atan2(y, +-0)
        if bit_and(m, 1u64) != 0u64:
            return -pi32 / 2.0f32
        return pi32 / 2.0f32
    if ix == 0x7f800000u64:
        if iy == 0x7f800000u64:
            if m == 0u64:
                return pi32 / 4.0f32
            if m == 1u64:
                return -pi32 / 4.0f32
            if m == 2u64:
                return 3.0f32 * pi32 / 4.0f32
            return -3.0f32 * pi32 / 4.0f32
        if m == 0u64:
            return 0.0f32
        if m == 1u64:
            return -0.0f32
        if m == 2u64:
            return pi32
        return -pi32
    # |y / x| > 0x1p26
    if ix + 218103808u64 < iy or iy == 0x7f800000u64:
        if bit_and(m, 1u64) != 0u64:
            return -pi32 / 2.0f32
        return pi32 / 2.0f32
    # z = atan(|y / x|) with correct underflow
    mut z = 0.0f32
    if not (bit_and(m, 2u64) != 0u64 and iy + 218103808u64 < ix):
        z = f32_atan(f32_magnitude(y / x))
    if m == 0u64:
        return z
    if m == 1u64:
        return -z
    if m == 2u64:
        return pi32 - (z - pi32_lo)
    return (z - pi32_lo) - pi32


# Zig's `std.math.pow(f32, x, y)`, bit for bit: x raised to the float power y (Go's algorithm, which Zig ports).
public func f32_pow_float(x: f32, y: f32) -> f32:
    if y == 0.0f32 or x == 1.0f32:
        return 1.0f32
    if x != x or y != y:
        return f32(nan())
    if y == 1.0f32:
        return x
    if x == 0.0f32:
        if y < 0.0f32:
            if is_odd_integer(float(y)):
                # copysign(inf, x)
                if bit_and(f32_pattern(x), 0x80000000u64) != 0u64:
                    return f32(-infinity())
                return f32(infinity())
            return f32(infinity())
        if is_odd_integer(float(y)):
            return x
        return 0.0f32
    if f32_is_inf(y):
        if x == -1.0f32:
            return 1.0f32
        if (f32_magnitude(x) < 1.0f32) == (y > 0.0f32):
            return 0.0f32
        return f32(infinity())
    if f32_is_inf(x):
        if x < 0.0f32:
            return f32_pow_float(1.0f32 / x, -y)
        if y < 0.0f32:
            return 0.0f32
        if y > 0.0f32:
            return f32(infinity())
    if y == 0.5f32:
        return f32_root(x)
    if y == -0.5f32:
        return 1.0f32 / f32_root(x)
    const ay = f32_magnitude(y)
    mut yi = f32(trunc(float(ay)))
    mut yf = ay - yi
    if yf != 0.0f32 and x < 0.0f32:
        return f32(nan())
    if yi >= 2147483648.0f32:
        # yi is a large even int, so the result is positive whatever the sign of x.
        return f32_exp(y * f32_ln(f32_magnitude(x)))
    # a = a1 * 2^ae
    mut a1 = 1.0f32
    mut ae = 0
    # a *= x^yf
    if yf != 0.0f32:
        if yf > 0.5f32:
            yf = yf - 1.0f32
            yi = yi + 1.0f32
        a1 = f32_exp(yf * f32_ln(x))
    # a *= x^yi
    const parts = frexp32_parts(x)
    mut xe = parts.exponent
    mut x1 = parts.significand
    mut i = int(yi)
    while i != 0:
        if xe < -512 or 512 < xe:
            # xe would overflow the shift below; the lower bound on ae already decides under/overflow.
            ae = ae + xe
            break
        if bit_and(i, 1) == 1:
            a1 = a1 * x1
            ae = ae + xe
        x1 = x1 * x1
        xe = xe * 2
        if x1 < 0.5f32:
            x1 = x1 + x1
            xe = xe - 1
        i = shift_right(i, 1)
    # a *= a1 * 2^ae
    if y < 0.0f32:
        a1 = 1.0f32 / a1
        ae = -ae
    return scalbn_f32(a1, ae)


# Largest finite binary64 value; anything above it is positive infinity.
func max_finite() -> float:
    return 1.7976931348623157e308


# Ratio of a circle's circumference to its diameter, rounded to binary64.
public func pi() -> float:
    return 3.141592653589793


# Base of the natural logarithm, rounded to binary64.
public func e() -> float:
    return 2.718281828459045


# The canonical quiet not-a-number.
public func nan() -> float:
    return 0.0 / 0.0


# Positive infinity.
public func infinity() -> float:
    return 1.0 / 0.0


# Whether a value is not-a-number, which is the only value unequal to itself.
public func is_nan(value: float) -> bool:
    return value != value


# Whether a value is one of the two infinities.
public func is_inf(value: float) -> bool:
    return value > max_finite() or value < 0.0 - max_finite()


# Whether a value is neither infinite nor not-a-number.
public func is_finite(value: float) -> bool:
    return not is_nan(value) and not is_inf(value)


# Magnitude of a floating value, mapping both zeros to positive zero.
public func fabs(value: float) -> float:
    if value == 0.0:
        return 0.0
    if value < 0.0:
        return 0.0 - value
    return value


# Sign of a floating value as -1, 0 or 1; not-a-number reports 0.
public func sign(value: float) -> int:
    if value > 0.0:
        return 1
    if value < 0.0:
        return 0 - 1
    return 0


# The integer `int(value)` gives, or `None` where `int(value)` would trap: not-a-number, an infinity, or a value
# whose truncation is outside the signed 64-bit range (from 2^63 up, below -2^63).
public func to_int(value: float) -> int?:
    if is_nan(value) or value >= 9223372036854775808.0 or value < 0.0 - 9223372036854775808.0:
        return None
    return Some(int(value))


# `int(value)` that cannot trap: a value from 2^63 up (and +infinity) gives 9223372036854775807, one below -2^63 (and
# -infinity) gives -9223372036854775808, not-a-number gives 0, and every other value is truncated toward zero.
public func to_int_saturating(value: float) -> int:
    if is_nan(value):
        return 0
    if value >= 9223372036854775808.0:
        return 9223372036854775807
    if value < 0.0 - 9223372036854775808.0:
        return 0 - 9223372036854775807 - 1
    return int(value)


# Integral part of a value, rounding toward zero.
public func trunc(value: float) -> float:
    if is_nan(value) or is_inf(value):
        return value
    if value >= 9223372036854775808.0 or value < 0.0 - 9223372036854775808.0:
        return value
    return float(int(value))


# Largest integral value that is not greater than the argument.
public func floor(value: float) -> float:
    mut whole = trunc(value)
    if whole > value:
        return whole - 1.0
    return whole


# Smallest integral value that is not less than the argument.
public func ceil(value: float) -> float:
    mut whole = trunc(value)
    if whole < value:
        return whole + 1.0
    return whole


# Nearest integral value, with halves rounded away from zero.
public func round(value: float) -> float:
    if is_nan(value) or is_inf(value):
        return value
    mut whole = trunc(value)
    mut fraction = value - whole
    if fraction >= 0.5:
        return whole + 1.0
    if fraction <= 0.0 - 0.5:
        return whole - 1.0
    return whole


# Square root, correctly rounded by the binary64 intrinsic. This module
# declares `sqrt`, which shadows the prelude helper, so it reaches the
# compiler-internal intrinsic spelling directly.
public func sqrt(value: float) -> float:
    if is_nan(value) or value == 0.0:
        return value
    if value < 0.0:
        return nan()
    if is_inf(value):
        return value
    return __float_sqrt(value)


# Repeated squaring for a nonnegative exponent that already fits the budget.
func positive_power(base: float, exponent: int) -> float:
    mut total = 1.0
    mut factor = base
    mut remaining = exponent
    while remaining > 0:
        if remaining % 2 == 1:
            total = total * factor
        factor = factor * factor
        remaining = remaining // 2
    return total


# Exponents past this magnitude only decide overflow, underflow and sign.
func saturated(exponent: int) -> int:
    if exponent > 4096 or exponent < 0 - 4096:
        return 4096 + exponent % 2
    if exponent < 0:
        return 0 - exponent
    return exponent


# Base raised to an integer exponent; magnitudes above 4096 saturate by parity.
public func pow(base: float, exponent: int) -> float:
    if exponent == 0:
        return 1.0
    mut magnitude = positive_power(base, saturated(exponent))
    if exponent < 0:
        return 1.0 / magnitude
    return magnitude


# Smaller of two floating values; a not-a-number operand propagates.
public func fmin(a: float, b: float) -> float:
    if is_nan(a) or is_nan(b):
        return nan()
    if a <= b:
        return a
    return b


# Larger of two floating values; a not-a-number operand propagates.
public func fmax(a: float, b: float) -> float:
    if is_nan(a) or is_nan(b):
        return nan()
    if a >= b:
        return a
    return b


@noalloc
# Smaller of two integers of any width, compared without subtraction.
public func min[T: integer](a: T, b: T) -> T:
    if a <= b:
        return a
    return b


@noalloc
# Larger of two integers of any width, compared without subtraction.
public func max[T: integer](a: T, b: T) -> T:
    if a >= b:
        return a
    return b


@noalloc
# Value restricted to an inclusive integer range; an inverted range yields low.
public func clamp[T: integer](value: T, low: T, high: T) -> T:
    if high < low:
        return low
    if value < low:
        return low
    if value > high:
        return high
    return value


# Magnitude of an integer; the most negative value has no positive counterpart.
public func abs(value: int) -> int fails str:
    if value == 0 - 9223372036854775807 - 1:
        fail "absolute value of -9223372036854775808 is not representable"
    if value < 0:
        return 0 - value
    return value


# Greatest common divisor, reported as a nonnegative integer.
public func gcd(a: int, b: int) -> int fails str:
    mut left = a
    mut right = b
    while right != 0:
        mut remainder = left % right
        left = right
        right = remainder
    return try abs(left)


# Least common multiple of two integers, reported as a nonnegative integer.
public func lcm(a: int, b: int) -> int fails str:
    if a == 0 or b == 0:
        return 0
    mut left = try abs(a)
    mut right = try abs(b)
    mut divisor = try gcd(left, right)
    mut quotient = left // divisor
    if quotient > 9223372036854775807 // right:
        fail "least common multiple does not fit a 64-bit integer"
    return quotient * right


# Integer square root: the largest whole number whose square is not larger.
public func isqrt(value: int) -> int fails str:
    if value < 0:
        fail "integer square root of a negative value is undefined"
    if value < 2:
        return value
    mut estimate = int(sqrt(float(value)))
    while estimate > 0 and estimate > value // estimate:
        estimate = (estimate + value // estimate) // 2
    while (estimate + 1) <= value // (estimate + 1):
        estimate += 1
    return estimate
