# Zig's `@log` for f64 (compiler_rt `log_f64`, the table-driven ARM optimized-routines algorithm), bit for bit: the natural
# logarithm, and the kernel of `pow_float`. The logarithm of zero is minus infinity and of a negative value is NaN.
public func ln(x: float) -> float:
    const ix = bits(x)
    # [1 - 2^-4, 1 + 0x1.09p-4): the polynomial about 1.
    if 0x3fee000000000000u64 <= ix < 0x3ff1090000000000u64:
        if ix == 0x3ff0000000000000u64:
            return 0.0
        const r = x - 1.0
        const r2 = r * r
        const r3 = r * r2
        const y = r3 * (3.333333333333352e-01 + r * -2.4999999999998432e-01 + r2 * 1.9999999999320328e-01 + r3 * (-1.6666666669929706e-01 + r * 1.4285715076560868e-01 + r2 * -1.2499997863982555e-01 + r3 * (1.1110712032936046e-01 + r * -1.0000486757818193e-01 + r2 * 9.181994006195467e-02 + r3 * -8.328363062289341e-02)))
        mut w = r * 134217728.0
        const rhi = r + w - w
        const rlo = r - rhi
        w = rhi * rhi * -0.5
        const hi = r + w
        const lo = r - hi + w + -0.5 * rlo * (rhi + r)
        return y + lo + hi
    const top = int(shift_right(ix, 48u64))
    mut scaled = 0
    if top < 0x0010 or top >= 0x7ff0:
        if bit_and(ix, 0x7fffffffffffffffu64) == 0u64:
            return -infinity()
        if ix == EXPONENT_MASK:
            return x
        if top >= 0x8000 or bit_and(top, 0x7ff0) == 0x7ff0:
            return nan()
        # Subnormal: scale by 2^52 and take the exponent back off the pattern.
        scaled = int(bits(x * TWO52)) - 0x0340000000000000
    else:
        scaled = int(ix)
    # ix - 0x3fe6000000000000 splits into the row (bits 45..51) and the exponent k (bits 52..63, signed).
    const tmp = scaled - 0x3fe6000000000000
    const row = bit_and(shift_right(tmp, 45), 127)
    const k = shift_right(tmp, 52)
    const z = from_bits(u64(scaled - shift_left(k, 52)))
    const invc = log_table_word(row, 0)
    const logc = log_table_word(row, 1)
    const r = (z - log_table_word(row, 2) - log_table_word(row, 3)) * invc
    const kd = float(k)
    const w = kd * 6.931471805598903e-01 + logc
    const hi = w + r
    const lo = w - hi + r + kd * 5.497923018708371e-14
    const r2 = r * r
    return lo + r2 * -5.000000000000001e-01 + r * r2 * (3.3333333331825593e-01 + r * -2.499999999622955e-01 + r2 * (2.0000304511814496e-01 + r * -1.6667054827627667e-01)) + hi


# Zig's `@exp` for f64 (compiler_rt `exp_f64`), bit for bit: e raised to the power x.
public func exp(x: float) -> float:
    if x != x:
        return x
    const ux = bits(x)
    const sign_bit = int(shift_right(ux, 63u64))
    const hx = bit_and(int(shift_right(ux, 32u64)), 0x7fffffff)
    # |x| >= 708.39: overflow, underflow to zero, or fall through to the reduction.
    if hx >= 0x4086232b:
        if x > 709.782712893383973096:
            return infinity()
        if x < -708.39641853226410622 and x < -745.13321910194110842:
            return 0.0
    mut xr = x
    mut k = 0
    mut hi = 0.0
    mut lo = 0.0
    if hx > 0x3fd62e42:
        # |x| > 0.5 * ln2
        if hx > 0x3ff0a2b2:
            if sign_bit == 1:
                k = int(1.44269504088896338700e+00 * x + -0.5)
            else:
                k = int(1.44269504088896338700e+00 * x + 0.5)
        else:
            k = 1 - sign_bit - sign_bit
        const dk = float(k)
        hi = x - dk * 6.93147180369123816490e-01
        lo = dk * 1.90821492927058770002e-10
        xr = hi - lo
    elif hx > 0x3e300000:
        # |x| > 2^-28
        hi = x
    else:
        return 1.0 + x
    const xx = xr * xr
    const c = xr - xx * (1.66666666666666019037e-01 + xx * (-2.77777777770155933842e-03 + xx * (6.61375632143793436117e-05 + xx * (-1.65339022054652515390e-06 + xx * 4.13813679705723846039e-08))))
    const y = 1.0 + (xr * c / (2.0 - c) - lo + hi)
    if k == 0:
        return y
    return scalbn_exact(y, k)


# Zig's `std.math.atan(f64)` (`atanBinary64`), bit for bit: the arc tangent in [-pi/2, pi/2], and the kernel of `atan2`.
public func atan(x: float) -> float:
    const pattern = bits(x)
    const ix = bit_and(int(shift_right(pattern, 32u64)), 0x7fffffff)
    const negative = shift_right(pattern, 63u64) == 1u64
    # |x| >= 2^66, infinity or nan.
    if ix >= 0x44100000:
        if x != x:
            return x
        const big = 1.57079632679489655800e+00 + 7.52316384526264e-37
        if negative:
            return -big
        return big
    mut v = x
    mut id = -1
    if ix < 0x3fdc0000:
        # |x| < 0.4375
        if ix < 0x3e400000:
            return x
    else:
        v = fabs(x)
        if ix < 0x3ff30000:
            if ix < 0x3fe60000:
                id = 0
                v = (2.0 * v - 1.0) / (2.0 + v)
            else:
                id = 1
                v = (v - 1.0) / (v + 1.0)
        elif ix < 0x40038000:
            id = 2
            v = (v - 1.5) / (1.0 + 1.5 * v)
        else:
            id = 3
            v = -1.0 / v
    const z = v * v
    const w = z * z
    const s1 = z * (3.33333333333329318027e-01 + w * (1.42857142725034663711e-01 + w * (9.09088713343650656196e-02 + w * (6.66107313738753120669e-02 + w * (4.97687799461593236017e-02 + w * 1.62858201153657823623e-02)))))
    const s2 = w * (-1.99999999998764832476e-01 + w * (-1.11111104054623557880e-01 + w * (-7.69187620504482999495e-02 + w * (-5.83357013379057348645e-02 + w * -3.65315727442169155270e-02))))
    if id < 0:
        return v - v * (s1 + s2)
    mut hi = 0.0
    mut lo = 0.0
    match id:
        case 0:
            hi = 4.63647609000806093515e-01
            lo = 2.26987774529616870924e-17
        case 1:
            hi = 7.85398163397448278999e-01
            lo = 3.06161699786838301793e-17
        case 2:
            hi = 9.82793723247329054082e-01
            lo = 1.39033110312309984516e-17
        case _:
            hi = 1.57079632679489655800e+00
            lo = 6.12323399573676603587e-17
    const r = hi - (v * (s1 + s2) - lo - v)
    if negative:
        return -r
    return r


# Zig's `std.math.atan2(f64, f64)` (`atan2_64`), bit for bit: the angle of the point (x, y), in [-pi, pi].
public func atan2(y: float, x: float) -> float:
    if x != x or y != y:
        return x + y
    const ux = bits(x)
    const uy = bits(y)
    const ix0 = int(shift_right(ux, 32u64))
    const lx = int(bit_and(ux, 0xffffffffu64))
    const iy0 = int(shift_right(uy, 32u64))
    const ly = int(bit_and(uy, 0xffffffffu64))
    # x = 1.0
    if ix0 == 0x3ff00000 and lx == 0:
        return atan(y)
    # 2 * sign(x) + sign(y)
    const m = bit_or(bit_and(shift_right(iy0, 31), 1), bit_and(shift_right(ix0, 30), 2))
    const ix = bit_and(ix0, 0x7fffffff)
    const iy = bit_and(iy0, 0x7fffffff)
    if bit_or(iy, ly) == 0:
        # atan2(+-0, x)
        if m == 0 or m == 1:
            return y
        if m == 2:
            return ATAN2_PI
        return -ATAN2_PI
    if bit_or(ix, lx) == 0:
        # atan2(y, +-0)
        if bit_and(m, 1) != 0:
            return -ATAN2_PI / 2.0
        return ATAN2_PI / 2.0
    if ix == 0x7ff00000:
        if iy == 0x7ff00000:
            if m == 0:
                return ATAN2_PI / 4.0
            if m == 1:
                return -ATAN2_PI / 4.0
            if m == 2:
                return 3.0 * ATAN2_PI / 4.0
            return -3.0 * ATAN2_PI / 4.0
        if m == 0:
            return 0.0
        if m == 1:
            return -0.0
        if m == 2:
            return ATAN2_PI
        return -ATAN2_PI
    # |y / x| > 0x1p64
    if ix + 0x4000000 < iy or iy == 0x7ff00000:
        if bit_and(m, 1) != 0:
            return -ATAN2_PI / 2.0
        return ATAN2_PI / 2.0
    # z = atan(|y / x|) with correct underflow
    mut z = 0.0
    if not (bit_and(m, 2) != 0 and iy + 0x4000000 < ix):
        z = atan(fabs(y / x))
    if m == 0:
        return z
    if m == 1:
        return -z
    if m == 2:
        return ATAN2_PI - (z - ATAN2_PI_LO)
    return (z - ATAN2_PI_LO) - ATAN2_PI


# Zig's private `isOddInteger(f64)` of `pow.zig`.
func is_odd_integer(x: float) -> bool:
    if fabs(x) >= 9007199254740992.0:
        return False
    const whole = trunc(x)
    return x - whole == 0.0 and bit_and(int(whole), 1) == 1


# Zig's `std.math.pow(f64, x, y)`, bit for bit: x raised to the float power y (Go's algorithm, which Zig ports).
public func pow_float(x: float, y: float) -> float:
    if y == 0.0 or x == 1.0:
        return 1.0
    if x != x or y != y:
        return nan()
    if y == 1.0:
        return x
    if x == 0.0:
        if y < 0.0:
            if is_odd_integer(y):
                # copysign(inf, x)
                if bits_sign_set(x):
                    return -infinity()
                return infinity()
            return infinity()
        if is_odd_integer(y):
            return x
        return 0.0
    if is_inf(y):
        if x == -1.0:
            return 1.0
        if (fabs(x) < 1.0) == (y > 0.0):
            return 0.0
        return infinity()
    if is_inf(x):
        if x < 0.0:
            return pow_float(1.0 / x, -y)
        if y < 0.0:
            return 0.0
        if y > 0.0:
            return infinity()
    if y == 0.5:
        return sqrt(x)
    if y == -0.5:
        return 1.0 / sqrt(x)
    const ay = fabs(y)
    mut yi = trunc(ay)
    mut yf = ay - yi
    if yf != 0.0 and x < 0.0:
        return nan()
    if yi >= 9223372036854775808.0:
        # yi is a large even int, so the result is positive whatever the sign of x.
        return exp(y * ln(fabs(x)))
    # a = a1 * 2^ae
    mut a1 = 1.0
    mut ae = 0
    # a *= x^yf
    if yf != 0.0:
        if yf > 0.5:
            yf = yf - 1.0
            yi = yi + 1.0
        a1 = exp(yf * ln(x))
    # a *= x^yi
    const parts = frexp_parts(x)
    mut xe = parts.exponent
    mut x1 = parts.significand
    mut i = int(yi)
    while i != 0:
        if xe < -4096 or 4096 < xe:
            # xe would overflow the shift below; the lower bound on ae already decides under/overflow.
            ae = ae + xe
            break
        if bit_and(i, 1) == 1:
            a1 = a1 * x1
            ae = ae + xe
        x1 = x1 * x1
        xe = xe * 2
        if x1 < 0.5:
            x1 = x1 + x1
            xe = xe - 1
        i = shift_right(i, 1)
    # a *= a1 * 2^ae
    if y < 0.0:
        a1 = 1.0 / a1
        ae = -ae
    return scalbn_exact(a1, ae)


# --- the rest of the Zig-exact binary64 functions ---------------------------------------------------------------------
# `acos`, `asin`, `expm1`, `sinh`, `cosh`, `tanh` and `cbrt` are the routines of the pinned Zig's `std/math/*.zig`, and `sin`,
# `cos` and `tan` are compiler_rt's `sin_f64`, `cos_f64` and `tan_f64` with their `__sin`, `__cos` and `__tan` kernels
# (`trig.zig`) and the `rem_pio2` argument reduction, Payne-Hanek `rem_pio2_large` included, so no finite argument traps.
# Each follows the Zig operation for operation and in the same order, with no reordering and no fused multiply-add. The
# special values are Zig's, and a NaN result is the canonical NaN. The 32-bit words Zig keeps as `u32` and `i32` are `int`.
# 2^-120, the "inexact" addend Zig writes as `0x1.0p-120`.
const TINY_2M120: float = 7.52316384526264e-37


# pi/2 split in two: the high word and the low part, as the musl routines carry them.
const PIO2_HI: float = 1.57079632679489655800e+00


const PIO2_LO: float = 6.12323399573676603587e-17


# The rational approximation shared by Zig's `acosBinary64` and `asinBinary64`: p(z) / q(z), musl's `R`.
func asin_acos_rational(z: float) -> float:
    const p = z * (1.66666666666666657415e-01 + z * (-3.25565818622400915405e-01 + z * (2.01212532134862925881e-01 + z * (-4.00555345006794114027e-02 + z * (7.91534994289814532176e-04 + z * 3.47933107596021167570e-05)))))
    const q = 1.0 + z * (-2.40339491173441421878e+00 + z * (2.02094576023350569471e+00 + z * (-6.88283971605453293030e-01 + z * 7.70381505559019352791e-02)))
    return p / q


# Zig's `std.math.acos(f64)` (`acosBinary64`, from musl), bit for bit: the arc cosine of x in [0, pi], NaN for |x| > 1.
public func acos(x: float) -> float:
    const ux = bits(x)
    const hx = int(shift_right(ux, 32u64))
    const ix = bit_and(hx, 0x7fffffff)
    # |x| >= 1 or nan
    if ix >= 0x3ff00000:
        const lx = int(bit_and(ux, 0xffffffffu64))
        if bit_or(ix - 0x3ff00000, lx) == 0:
            if shift_right(hx, 31) != 0:
                return 2.0 * PIO2_HI + TINY_2M120
            return 0.0
        return 0.0 / (x - x)
    # |x| < 0.5
    if ix < 0x3fe00000:
        # |x| < 2^-57
        if ix <= 0x3c600000:
            return PIO2_HI + TINY_2M120
        return PIO2_HI - (x - (PIO2_LO - x * asin_acos_rational(x * x)))
    # x < -0.5
    if shift_right(hx, 31) != 0:
        const zn = (1.0 + x) * 0.5
        const sn = sqrt(zn)
        const wn = asin_acos_rational(zn) * sn - PIO2_LO
        return 2.0 * (PIO2_HI - (sn + wn))
    # x > 0.5
    const z = (1.0 - x) * 0.5
    const s = sqrt(z)
    const df = from_bits(bit_and(bits(s), 0xffffffff00000000u64))
    const c = (z - df * df) / (s + df)
    const w = asin_acos_rational(z) * s + c
    return 2.0 * (df + w)


# Zig's `std.math.asin(f64)` (`asinBinary64`, from musl), bit for bit: the arc sine of x in [-pi/2, pi/2], NaN for |x| > 1.
public func asin(x: float) -> float:
    const ux = bits(x)
    const hx = int(shift_right(ux, 32u64))
    const ix = bit_and(hx, 0x7fffffff)
    # |x| >= 1 or nan
    if ix >= 0x3ff00000:
        const lx = int(bit_and(ux, 0xffffffffu64))
        # asin(1) = +-pi/2 with inexact
        if bit_or(ix - 0x3ff00000, lx) == 0:
            return x * PIO2_HI + TINY_2M120
        return 0.0 / (x - x)
    # |x| < 0.5
    if ix < 0x3fe00000:
        # 0x1p-1022 <= |x| < 0x1p-26
        if 0x00100000 <= ix < 0x3e500000:
            return x
        return x + x * asin_acos_rational(x * x)
    # 1 > |x| >= 0.5
    const z = (1.0 - fabs(x)) * 0.5
    const s = sqrt(z)
    const r = asin_acos_rational(z)
    # |x| > 0.975
    if ix >= 0x3fef3333:
        const near_one = PIO2_HI - (2.0 * (s + s * r) - PIO2_LO)
        if shift_right(hx, 31) != 0:
            return -near_one
        return near_one
    # f + c = sqrt(z)
    const f = from_bits(bit_and(bits(s), 0xffffffff00000000u64))
    const c = (z - f * f) / (s + f)
    const middle = 0.5 * PIO2_HI - (2.0 * s * r - (PIO2_LO - 2.0 * c) - (0.5 * PIO2_HI - 2.0 * f))
    if shift_right(hx, 31) != 0:
        return -middle
    return middle


# Zig's `std.math.expm1(f64)` (`expm1_64`, from musl), bit for bit: e^x - 1, accurate for small x.
public func expm1(x_in: float) -> float:
    if x_in != x_in:
        return nan()
    const o_threshold = 7.09782712893383973096e+02
    const ln2_hi = 6.93147180369123816490e-01
    const ln2_lo = 1.90821492927058770002e-10
    const invln2 = 1.44269504088896338700e+00
    const q1 = -3.33333333333331316428e-02
    const q2 = 1.58730158725481460165e-03
    const q3 = -7.93650757867487942473e-05
    const q4 = 4.00821782732936239552e-06
    const q5 = -2.01099218183624371326e-07
    mut x = x_in
    const ux = bits(x)
    const hx = bit_and(int(shift_right(ux, 32u64)), 0x7fffffff)
    const negative = shift_right(ux, 63u64) != 0u64
    if x == -infinity():
        return -1.0
    # |x| >= 56 * ln2
    if hx >= 0x4043687A:
        # expm1(-ve) = -1
        if negative:
            return -1.0
        if x > o_threshold:
            return infinity()
    mut hi = 0.0
    mut lo = 0.0
    mut c = 0.0
    mut k = 0
    if hx > 0x3FD62E42:
        # |x| > 0.5 * ln2
        if hx < 0x3FF0A2B2:
            # |x| < 1.5 * ln2
            if not negative:
                hi = x - ln2_hi
                lo = ln2_lo
                k = 1
            else:
                hi = x + ln2_hi
                lo = -ln2_lo
                k = -1
        else:
            mut kf = invln2 * x
            if negative:
                kf = kf - 0.5
            else:
                kf = kf + 0.5
            k = int(kf)
            const kd = float(k)
            hi = x - kd * ln2_hi
            lo = kd * ln2_lo
        x = hi - lo
        c = (hi - x) - lo
    elif hx < 0x3C900000:
        # |x| < 2^-54
        return x
    const hfx = 0.5 * x
    const hxs = x * hfx
    const r1 = 1.0 + hxs * (q1 + hxs * (q2 + hxs * (q3 + hxs * (q4 + hxs * q5))))
    const t = 3.0 - r1 * hfx
    mut err = hxs * ((r1 - t) / (6.0 - x * t))
    # c is 0
    if k == 0:
        return x - (x * err - hxs)
    err = x * (err - c) - c
    err = err - hxs
    # exp(x) ~ 2^k (x_reduced - err + 1)
    if k == -1:
        return 0.5 * (x - err) - 0.5
    if k == 1:
        if x < -0.25:
            return -2.0 * (err - (x + 0.5))
        return 1.0 + 2.0 * (x - err)
    if k < 0 or k > 56:
        mut y = x - err + 1.0
        if k == 1024:
            y = y * 2.0 * 8.98846567431158e+307
        else:
            y = y * from_bits(shift_left(u64(0x3FF + k), 52u64))
        return y - 1.0
    const twopk = from_bits(shift_left(u64(0x3FF + k), 52u64))
    const uf = from_bits(shift_left(u64(0x3FF - k), 52u64))
    if k < 20:
        return (x - err + (1.0 - uf)) * twopk
    return (x - (err + uf) + 1.0) * twopk


# Zig's `std.math.expo2(f64)`: exp(x) / 2 for x >= log(maxFloat), as `exp(x - 1416.09...) * 2^1021 * 2^1021`.
func expo2(x: float) -> float:
    return exp(x - 1416.0996898839683) * 2.247116418577895e+307 * 2.247116418577895e+307


# Zig's `std.math.sinh(f64)` (`sinh64`, from musl), bit for bit: the hyperbolic sine.
public func sinh(x: float) -> float:
    const ux = bits(x)
    const w = bit_and(int(shift_right(ux, 32u64)), 0x7fffffff)
    const ax = from_bits(bit_and(ux, 0x7fffffffffffffffu64))
    if x == 0.0 or x != x:
        return x
    mut h = 0.5
    if shift_right(ux, 63u64) != 0u64:
        h = -0.5
    # |x| < log(FLT_MAX)
    if w < 0x40862E42:
        const t = expm1(ax)
        if w < 0x3FF00000:
            # |x| < 2^-26
            if w < 0x3E500000:
                return x
            return h * (2.0 * t - t * t / (t + 1.0))
        return h * (t + t / (t + 1.0))
    # |x| > log(DBL_MAX) or nan
    return 2.0 * h * expo2(ax)


# Zig's `std.math.cosh(f64)` (`cosh64`, from musl), bit for bit: the hyperbolic cosine.
public func cosh(x: float) -> float:
    const ux = bits(x)
    const w = bit_and(int(shift_right(ux, 32u64)), 0x7fffffff)
    const ax = from_bits(bit_and(ux, 0x7fffffffffffffffu64))
    if x == 0.0:
        return 1.0
    # |x| < log(2)
    if w < 0x3FE62E42:
        # |x| < 2^-26
        if w < 0x3E500000:
            return 1.0
        const t = expm1(ax)
        return 1.0 + t * t / (2.0 * (1.0 + t))
    # |x| < log(DBL_MAX)
    if w < 0x40862E42:
        const t = exp(ax)
        return 0.5 * (t + 1.0 / t)
    # |x| > log(DBL_MAX) or nan
    return expo2(ax)


# Zig's `std.math.tanh(f64)` (`tanh64`, from musl), bit for bit: the hyperbolic tangent.
public func tanh(x: float) -> float:
    const ux = bits(x)
    const w = bit_and(int(shift_right(ux, 32u64)), 0x7fffffff)
    const ax = from_bits(bit_and(ux, 0x7fffffffffffffffu64))
    mut t = 0.0
    if w > 0x3FE193EA:
        # |x| < log(3) / 2 ~= 0.5493 or nan
        if w > 0x40340000:
            # |x| > 20 or nan
            t = 1.0 - 0.0 / ax
        else:
            t = expm1(2.0 * ax)
            t = 1.0 - 2.0 / (t + 2.0)
    elif w > 0x3FD058AE:
        # |x| > log(5 / 3) / 2 ~= 0.2554
        t = expm1(2.0 * ax)
        t = t / (t + 2.0)
    elif w >= 0x00100000:
        # |x| >= 0x1.0p-1022
        t = expm1(-2.0 * ax)
        t = -t / (t + 2.0)
    else:
        # |x| is subnormal
        t = ax
    if shift_right(ux, 63u64) != 0u64:
        return -t
    return t


# Zig's `std.math.cbrt(f64)` (`cbrt64`, from FreeBSD), bit for bit: the cube root.
public func cbrt(x: float) -> float:
    const p0 = 1.87595182427177009643
    const p1 = -1.88497979543377169875
    const p2 = 1.621429720105354466140
    const p3 = -0.758397934778766047437
    const p4 = 0.145996192886612446982
    mut u = bits(x)
    mut hx = bit_and(int(shift_right(u, 32u64)), 0x7fffffff)
    # cbrt(nan, inf) = itself
    if hx >= 0x7FF00000:
        return x + x
    # cbrt to ~5bits
    if hx < 0x00100000:
        u = bits(x * 1.8014398509481984e+16)
        hx = bit_and(int(shift_right(u, 32u64)), 0x7fffffff)
        # cbrt(+-0) = itself
        if hx == 0:
            return x
        hx = hx // 3 + 696219795
    else:
        hx = hx // 3 + 715094163
    u = bit_or(bit_and(u, SIGN_BIT_MASK), shift_left(u64(hx), 32u64))
    mut t = from_bits(u)
    # cbrt to 23 bits: cbrt(x) = t * cbrt(x / t^3) ~= t * P(t^3 / x)
    const r = (t * t) * (t / x)
    t = t * ((p0 + r * (p1 + r * p2)) + ((r * r) * r) * (p3 + r * p4))
    # Round t away from 0 to 23 bits
    u = bit_and(bits(t) + 0x80000000u64, 0xFFFFFFFFC0000000u64)
    t = from_bits(u)
    # one step newton to 53 bits
    const s = t * t
    mut q = x / s
    const w = t + t
    q = (q - t) / (w + q)
    return t + t * q


# The coefficients and the splitting of pi/2 into 33-bit pieces that `rem_pio2` uses (compiler_rt `rem_pio2.zig`).
const RP_PIO4: float = 7.85398163397448278999e-01


const RP_INVPIO2: float = 6.36619772367581382433e-01


const RP_PIO2_1: float = 1.57079632673412561417e+00


const RP_PIO2_1T: float = 6.07710050650619224932e-11


const RP_PIO2_2: float = 6.07710050630396597660e-11


const RP_PIO2_2T: float = 2.02226624879595063154e-21


const RP_PIO2_3: float = 2.02226624871116645580e-21


const RP_PIO2_3T: float = 8.47842766036889956997e-32


# The remainder of a reduction by pi/2: `x = n * (pi/2) + (y0 + y1)`, Zig's `rem_pio2(x, &y)` result and `y`.
record Pio2Reduction:
    n: int
    y0: float
    y1: float


# 396 hexadecimal digits of 2/pi, as 690 big-endian 24-bit words (compiler_rt `rem_pio2_large.zig`'s `ipio2`, generated from it):
