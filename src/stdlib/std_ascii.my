module std_ascii;
export Class;
export contains;
export matches;
struct Class {
    lower: bool,
    upper: bool,
    digit: bool,
    underscore: bool,
    hyphen: bool
}
fn contains < T: integer >(allowed: Class, value: T) -> bool noalloc {
    if allowed.lower && value >= cast<T>(97) && value <= cast<T>(122) {
        return true;
    }
    if allowed.upper && value >= cast<T>(65) && value <= cast<T>(90) {
        return true;
    }
    if allowed.digit && value >= cast<T>(48) && value <= cast<T>(57) {
        return true;
    }
    if allowed.underscore && value == cast<T>(95) {
        return true;
    }
    return allowed.hyphen && value == cast<T>(45);
}
fn matches < T: integer >(text: &[]T, head: Class, tail: Class, minimum: u64, maximum: u64) -> bool noalloc {
    let count = len_slice(text);
    if minimum > maximum || count < minimum || count > maximum {
        return false;
    }
    if count == 0u64 {
        return true;
    }
    if !contains::< T >(head, read_slice(text, 0u64)) {
        return false;
    }
    let mut at = 1u64;
    while at < count {
        if !contains::< T >(tail, read_slice(text, at)) {
            return false;
        }
        at += 1u64;
    }
    return true;
}
