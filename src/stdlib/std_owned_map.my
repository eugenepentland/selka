module std_owned_map;
import std_owned as o;
export Entry;
export Map;
export Created;
export Extracted;
export Removed;
export PutStatus;
export Status;
export create;
export put;
export take;
export clear;
struct Entry<K: equality, V: storable> {
    key: K,
    value: V
}
buffer Map < K: equality, V: storable >: Entry<K, V>;
result Created<K: equality, V: storable> {
    ok: Map<K, V>,
    err: i64
}
result Extracted<K: equality, V: storable> {
    ok: Entry<K, V>,
    err: i64
}
result Removed<V: storable> {
    ok: V,
    err: i64
}
enum PutStatus {
    inserted,
    replaced
}
result Status {
    ok: PutStatus,
    err: i64
}
fn create < K: equality, V: storable >(heap: allocator, capacity: u64) -> Created<K, V> {
    return acquire_buffer<Created<K, V>>(heap, capacity);
}
fn put < K: equality, V: storable >(map: &mut Map<K, V>, key: K, value: V) -> Status noalloc {
    let mut i = len_buffer(map);
    while i > 0u64 {
        i -= 1u64;
        let entry = try take_buffer<Extracted<K, V>>(map, i);
        if read_field(entry, key) == key {
            discard entry.value;
            discard try append_buffer<o::Status>(map, new Entry<K, V> {
                key: key,
                value: value
            });
            return new Status.ok(new PutStatus.replaced);
        }
        discard try append_buffer<o::Status>(map, entry);
    }
    discard try append_buffer<o::Status>(map, new Entry<K, V> {
        key: key,
        value: value
    });
    return new Status.ok(new PutStatus.inserted);
}
fn take < K: equality, V: storable >(map: &mut Map<K, V>, key: K) -> Removed<V> noalloc {
    let mut i = len_buffer(map);
    while i > 0u64 {
        i -= 1u64;
        let entry = try take_buffer<Extracted<K, V>>(map, i);
        if read_field(entry, key) == key {
            return new Removed<V>.ok(entry.value);
        }
        discard try append_buffer<o::Status>(map, entry);
    }
    return new Removed<V>.err(4);
}
fn clear < K: equality, V: storable >(map: &mut Map<K, V>) -> o::Status noalloc {
    return truncate_buffer<o::Status>(map, 0u64);
}
