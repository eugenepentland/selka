module math
export pi
export e
export nan
export infinity
export is_nan
export is_inf
export is_finite
export fabs
export sign
export trunc
export floor
export ceil
export round
export sqrt
export pow
export fmin
export fmax
export min
export max
export clamp
export abs
export gcd
export lcm
export isqrt


# Largest finite binary64 value; anything above it is positive infinity.
def max_finite() -> float:
    return 1.7976931348623157e308


# Ratio of a circle's circumference to its diameter, rounded to binary64.
def pi() -> float:
    return 3.141592653589793


# Base of the natural logarithm, rounded to binary64.
def e() -> float:
    return 2.718281828459045


# The canonical quiet not-a-number.
def nan() -> float:
    return 0.0 / 0.0


# Positive infinity.
def infinity() -> float:
    return 1.0 / 0.0


# Whether a value is not-a-number, which is the only value unequal to itself.
def is_nan(value: float) -> bool:
    return value != value


# Whether a value is one of the two infinities.
def is_inf(value: float) -> bool:
    return value > max_finite() or value < 0.0 - max_finite()


# Whether a value is neither infinite nor not-a-number.
def is_finite(value: float) -> bool:
    return not is_nan(value) and not is_inf(value)


# Magnitude of a floating value, mapping both zeros to positive zero.
def fabs(value: float) -> float:
    if value == 0.0:
        return 0.0
    if value < 0.0:
        return 0.0 - value
    return value


# Sign of a floating value as -1, 0 or 1; not-a-number reports 0.
def sign(value: float) -> int:
    if value > 0.0:
        return 1
    if value < 0.0:
        return 0 - 1
    return 0


# Integral part of a value, rounding toward zero.
def trunc(value: float) -> float:
    if is_nan(value) or is_inf(value):
        return value
    if value >= 9223372036854775808.0 or value < 0.0 - 9223372036854775808.0:
        return value
    return float(int(value))


# Largest integral value that is not greater than the argument.
def floor(value: float) -> float:
    whole = trunc(value)
    if whole > value:
        return whole - 1.0
    return whole


# Smallest integral value that is not less than the argument.
def ceil(value: float) -> float:
    whole = trunc(value)
    if whole < value:
        return whole + 1.0
    return whole


# Nearest integral value, with halves rounded away from zero.
def round(value: float) -> float:
    if is_nan(value) or is_inf(value):
        return value
    whole = trunc(value)
    fraction = value - whole
    if fraction >= 0.5:
        return whole + 1.0
    if fraction <= 0.0 - 0.5:
        return whole - 1.0
    return whole


# Square root computed by argument reduction and Newton refinement.
def sqrt(value: float) -> float:
    if is_nan(value) or value == 0.0:
        return value
    if value < 0.0:
        return nan()
    if is_inf(value):
        return value
    scale = 1.0
    reduced = value
    while reduced >= 4.0:
        reduced = reduced / 4.0
        scale = scale * 2.0
    while reduced < 1.0:
        reduced = reduced * 4.0
        scale = scale / 2.0
    estimate = 0.5 * (1.0 + reduced)
    step = 0
    while step < 8:
        estimate = 0.5 * (estimate + reduced / estimate)
        step += 1
    return estimate * scale


# Repeated squaring for a nonnegative exponent that already fits the budget.
def positive_power(base: float, exponent: int) -> float:
    total = 1.0
    factor = base
    remaining = exponent
    while remaining > 0:
        if remaining % 2 == 1:
            total = total * factor
        factor = factor * factor
        remaining = remaining // 2
    return total


# Exponents past this magnitude only decide overflow, underflow and sign.
def saturated(exponent: int) -> int:
    if exponent > 4096 or exponent < 0 - 4096:
        return 4096 + exponent % 2
    if exponent < 0:
        return 0 - exponent
    return exponent


# Base raised to an integer exponent; magnitudes above 4096 saturate by parity.
def pow(base: float, exponent: int) -> float:
    if exponent == 0:
        return 1.0
    magnitude = positive_power(base, saturated(exponent))
    if exponent < 0:
        return 1.0 / magnitude
    return magnitude


# Smaller of two floating values; a not-a-number operand propagates.
def fmin(a: float, b: float) -> float:
    if is_nan(a) or is_nan(b):
        return nan()
    if a <= b:
        return a
    return b


# Larger of two floating values; a not-a-number operand propagates.
def fmax(a: float, b: float) -> float:
    if is_nan(a) or is_nan(b):
        return nan()
    if a >= b:
        return a
    return b


# Smaller of two integers of any width, compared without subtraction.
def min[T: integer](a: T, b: T) -> T noalloc:
    if a <= b:
        return a
    return b


# Larger of two integers of any width, compared without subtraction.
def max[T: integer](a: T, b: T) -> T noalloc:
    if a >= b:
        return a
    return b


# Value restricted to an inclusive integer range; an inverted range yields low.
def clamp[T: integer](value: T, low: T, high: T) -> T noalloc:
    if high < low:
        return low
    if value < low:
        return low
    if value > high:
        return high
    return value


# Magnitude of an integer; the most negative value has no positive counterpart.
def abs(value: int) -> Result[int, str]:
    if value == 0 - 9223372036854775807 - 1:
        return Err("absolute value of -9223372036854775808 is not representable")
    if value < 0:
        return Ok(0 - value)
    return Ok(value)


# Greatest common divisor, reported as a nonnegative integer.
def gcd(a: int, b: int) -> Result[int, str]:
    left = a
    right = b
    while right != 0:
        remainder = left % right
        left = right
        right = remainder
    return abs(left)


# Least common multiple of two integers, reported as a nonnegative integer.
def lcm(a: int, b: int) -> Result[int, str]:
    if a == 0 or b == 0:
        return Ok(0)
    left = abs(a)?
    right = abs(b)?
    divisor = gcd(left, right)?
    quotient = left // divisor
    if quotient > 9223372036854775807 // right:
        return Err("least common multiple does not fit a 64-bit integer")
    return Ok(quotient * right)


# Integer square root: the largest whole number whose square is not larger.
def isqrt(value: int) -> Result[int, str]:
    if value < 0:
        return Err("integer square root of a negative value is undefined")
    if value < 2:
        return Ok(value)
    estimate = int(sqrt(float(value)))
    while estimate > 0 and estimate > value // estimate:
        estimate = (estimate + value // estimate) // 2
    while (estimate + 1) <= value // (estimate + 1):
        estimate += 1
    return Ok(estimate)
