// Parse one already-separated argument. Host token acquisition remains explicit.
module std_args;
import std_strings;
import std_bytes;
import std_result;
export integer_value;
export is_flag;
export Kind;
export Token;
export classify;
export name_is;
enum Kind {
    positional,
    option,
    terminator
}
struct Token {
    kind: Kind,
    name: std_strings::Range,
    value: std_strings::Range,
    has_value: bool
}
fn classify(text: &[]u8, options: bool) -> Token {
    let end = len_slice(text);
    let mut kind = new Kind.positional;
    let mut start = 0u64;
    let mut separator = end;
    let mut has_value = false;
    if options && std_strings::starts_with(text, "--") {
        start = 2u64;
        kind = new Kind.option;
        if end == 2u64 {
            kind = new Kind.terminator;
        } else {
            let mut i = start;
            while i < end {
                if read_slice(text, i) == 61u8 {
                    separator = i;
                    has_value = true;
                    break;
                }
                i += 1u64;
            }
        }
    }
    let mut value = end;
    if has_value {
        value = separator + 1u64;
    }
    return new Token {
        kind: kind,
        name: new std_strings::Range {
            start: start,
            end: separator
        },
        value: new std_strings::Range {
            start: value,
            end: end
        },
        has_value: has_value
    };
}
fn name_is(text: &[]u8, token: Token, name: &[]u8) -> bool {
    if token.name.start > token.name.end || token.name.end > len_slice(text) || token.name.end - token.name.start != len_slice(name) {
        return false;
    }
    let mut i = 0u64;
    while i < len_slice(name) {
        if read_slice(text, token.name.start + i) != read_slice(name, i) {
            return false;
        }
        i += 1u64;
    }
    return true;
}
fn is_flag(text: &[]u8, token: Token, name: &[]u8) -> bool {
    return token.kind == new Kind.option && !token.has_value && name_is(text, token, name);
}
fn integer_value(text: &[]u8, token: Token) -> std_result::Result<i64, std_result::Error> {
    if !token.has_value {
        return new std_result::Result<i64, std_result::Error>.err(new std_result::Error {
            category: new std_result::Category.absent,
            code: 1
        });
    }
    if token.value.start > token.value.end || token.value.end > len_slice(text) {
        return new std_result::Result<i64, std_result::Error>.err(new std_result::Error {
            category: new std_result::Category.bounds,
            code: 1
        });
    }
    borrow text[token.value.start..token.value.end] as value {
        return std_bytes::integer(value);
    }
}
