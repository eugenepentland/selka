module base64
export standard_alphabet
export urlsafe_alphabet
export b64encode
export b64decode
export urlsafe_b64encode
export urlsafe_b64decode


# The sixty-four symbols of RFC 4648 section 4, in value order.
def standard_alphabet() -> bytes effects(managed_allocation):
    return b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"


# The sixty-four symbols of RFC 4648 section 5, in value order.
def urlsafe_alphabet() -> bytes effects(managed_allocation):
    return b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"


# The padding octet that completes a four-symbol group.
def padding() -> int:
    return 61


# Bytes encoded with an explicit alphabet and canonical trailing padding.
def encode_with(data: bytes, alphabet: bytes) -> bytes:
    out: list[int] = []
    index = 0
    while index + 3 <= len(data):
        chunk = data[index] * 65536 + data[index + 1] * 256 + data[index + 2]
        second = chunk // 4096 % 64
        third = chunk // 64 % 64
        out.append(alphabet[chunk // 262144])
        out.append(alphabet[second])
        out.append(alphabet[third])
        out.append(alphabet[chunk % 64])
        index += 3
    remaining = len(data) - index
    if remaining == 1:
        chunk = data[index] * 16
        out.append(alphabet[chunk // 64])
        out.append(alphabet[chunk % 64])
        out.append(padding())
        out.append(padding())
    elif remaining == 2:
        chunk = data[index] * 1024 + data[index + 1] * 4
        middle = chunk // 64 % 64
        out.append(alphabet[chunk // 4096])
        out.append(alphabet[middle])
        out.append(alphabet[chunk % 64])
        out.append(padding())
    return bytes(out)


# Reverse lookup from an alphabet symbol to its six-bit value.
def reverse(alphabet: bytes) -> dict[int, int]:
    table: dict[int, int] = {}
    for value, symbol in enumerate(alphabet):
        table[symbol] = value
    return table


# Bytes decoded with an explicit alphabet, rejecting every noncanonical form.
def decode_with(data: bytes, alphabet: bytes) -> Result[bytes, str]:
    if len(data) % 4 != 0:
        return Err("base64 input length must be a multiple of four")
    table = reverse(alphabet)
    out: list[int] = []
    index = 0
    while index < len(data):
        final = index + 4 == len(data)
        pad = 0
        values: list[int] = []
        position = 0
        while position < 4:
            symbol = data[index + position]
            if symbol == padding():
                if not final or position < 2:
                    return Err("base64 padding may only end the final group")
                pad += 1
                values.append(0)
            elif pad > 0:
                return Err("base64 padding may not be followed by data")
            elif symbol not in table:
                return Err("base64 input has a symbol outside the alphabet")
            else:
                values.append(table[symbol])
            position += 1
        chunk = values[0] * 262144 + values[1] * 4096 + values[2] * 64 + values[3]
        if pad == 0:
            out.append(chunk // 65536)
            out.append((chunk // 256) % 256)
            out.append(chunk % 256)
        elif pad == 1:
            if chunk % 256 != 0:
                return Err("base64 group has nonzero padding bits")
            out.append(chunk // 65536)
            out.append((chunk // 256) % 256)
        else:
            if chunk % 65536 != 0:
                return Err("base64 group has nonzero padding bits")
            out.append(chunk // 65536)
        index += 4
    return Ok(bytes(out))


# Bytes encoded with the standard alphabet and canonical padding.
def b64encode(data: bytes) -> bytes effects(managed_allocation):
    return encode_with(data, standard_alphabet())


# Standard-alphabet base64 decoded, rejecting invalid symbols and padding.
def b64decode(data: bytes) -> Result[bytes, str] effects(managed_allocation):
    return decode_with(data, standard_alphabet())


# Bytes encoded with the URL and filename safe alphabet.
def urlsafe_b64encode(data: bytes) -> bytes effects(managed_allocation):
    return encode_with(data, urlsafe_alphabet())


# URL-safe base64 decoded, rejecting invalid symbols and padding.
def urlsafe_b64decode(data: bytes) -> Result[bytes, str] effects(managed_allocation):
    return decode_with(data, urlsafe_alphabet())
