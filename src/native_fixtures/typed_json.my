buffer Bytes:u8;
result Encoded{ok:Bytes,err:i64}
enum Flag {a,b}
struct Item {number:u64,ready:bool,empty:[0]u8,table:[Flag]i64}
union Choice {none,item:Item}
result Value {ok:Choice,err:i64}
result Decoded {ok:Value,err:i64}
fn roundtrip(heap:allocator)->Decoded {
    let item=new Item{number:18446744073709551615u64,ready:true,empty:new [0]u8 [],table:new [Flag]i64 {a:-9223372036854775808,b:42}};
    let bytes=try json_encode::<Encoded>(heap,new Value.ok(new Choice.item(item)),4096);
    return json_decode::<Decoded>(heap,bytes,4096);
}
fn main(heap:allocator)->i64 {
    match roundtrip(heap) {
        Decoded.err(e)=>{return -e;},
        Decoded.ok(value)=>{
            match value {
                Value.err(discard)=>{return -5;},
                Value.ok(choice)=>{
                    match choice {
                        Choice.none=>{return -6;},
                        Choice.item(item)=>{
                            if item.number!=18446744073709551615u64 || !item.ready || len(item.empty)!=0u64{return -7;}
                            return item.table[new Flag.b];
                        }
                    }
                }
            }
        }
    }
}
