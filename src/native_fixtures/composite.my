domain D: i64:
    def make(value: i64) -> D:
        return wrap<D>(value)

    def value(value: D) -> i64:
        return unwrap(value)


class Pair:
    tag: D
    bytes: [2]u8


result Outcome:
    ok: Pair,
    err: i64


host def echo(value: Outcome) -> Outcome effects(host)


def forward[T](value: T) -> T:
    return value


def main() -> i64:
    pair = Pair(tag=D.make(40), bytes=[1u8, 2u8])
    match echo(Ok(forward[Pair](pair))):
        case Outcome.err(_):
            return -1
        case Outcome.ok(value):
            if value.tag != D.make(40):
                return -2
            return D.value(value.tag) + cast<i64>(value.bytes[1])
