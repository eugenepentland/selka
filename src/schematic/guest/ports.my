module ports
import io
import text
import sexpr as s
import circuit as c
export Port
export collect
export validate
export equal


class Port:
    prefix: text.Span
    name: text.Span
    direction: text.Span


def portForm(nodes: list[s.Node], i: int) -> bool:
    return s.form(nodes, i, b"port")


def port_groupForm(nodes: list[s.Node], i: int) -> bool:
    return s.form(nodes, i, b"port-group")


def interfaceForm(nodes: list[s.Node], i: int) -> bool:
    return s.form(nodes, i, b"interface")


def signalForm(nodes: list[s.Node], i: int) -> bool:
    return s.form(nodes, i, b"signal")


def renameForm(nodes: list[s.Node], i: int) -> bool:
    return s.form(nodes, i, b"rename")


def fail(span: text.Span) -> Result[list[Port], int]:
    _ = io.issue(21, span.file, span.start)
    return Err(21)


def direction(span: text.Span) -> bool:
    if text.matches(span, b"in"):
        return True
    if text.matches(span, b"out"):
        return True
    if text.matches(span, b"bidi"):
        return True
    return False


def collect(nodes: list[s.Node], lanes: list[s.Node]) -> Result[list[Port], int]:
    out: list[Port] = []
    if not interfaceForm(lanes, 1) or s.at(lanes, 1).next != len(lanes):
        return fail(s.at(lanes, 1).span)
    b = c.body(nodes)
    i = b + 3
    while i < s.at(nodes, b).next:
        if portForm(nodes, i):
            name = s.at(nodes, i + 2)
            dir = s.at(nodes, i + 3)
            if i + 3 >= s.at(nodes, i).next or name.kind != s.Kind.string or not text.identifier(name.span) or not direction(dir.span):
                return fail(name.span)
            if out.len() == 32u64:
                return fail(name.span)
            out.append(Port(
                prefix=text.empty(),
                name=name.span,
                direction=dir.span
            ))
        elif port_groupForm(nodes, i):
            prefix = s.at(nodes, i + 2).span
            if not text.identifier(prefix) or not text.equal(s.at(nodes, i + 3).span, s.at(lanes, 3).span):
                return fail(prefix)
            rename = i + 4
            while rename < s.at(nodes, i).next:
                if not renameForm(nodes, rename) or s.at(nodes, rename).next != rename + 4 or s.at(nodes, rename + 3).kind != s.Kind.string:
                    return fail(s.at(nodes, rename).span)
                found = False
                lane = 5
                while lane < s.at(lanes, 1).next:
                    if text.equal(s.at(nodes, rename + 2).span, s.at(lanes, lane + 2).span):
                        found = True
                    lane = s.at(lanes, lane).next
                if not found:
                    return fail(s.at(nodes, rename + 2).span)
                rename = s.at(nodes, rename).next
            lane = 5
            while lane < s.at(lanes, 1).next:
                if not signalForm(lanes, lane) or s.at(lanes, lane).next < lane + 4 or not direction(s.at(lanes, lane + 3).span):
                    return fail(s.at(lanes, lane).span)
                name = s.at(lanes, lane + 2).span
                original = name
                pre = prefix
                renamed = False
                rename = i + 4
                while rename < s.at(nodes, i).next:
                    if text.equal(s.at(nodes, rename + 2).span, original):
                        if renamed:
                            return fail(s.at(nodes, rename).span)
                        renamed = True
                        name = s.at(nodes, rename + 3).span
                        pre = text.empty()
                    rename = s.at(nodes, rename).next
                if not text.identifier(name) or out.len() == 32u64:
                    return fail(name)
                out.append(Port(
                    prefix=pre,
                    name=name,
                    direction=s.at(lanes, lane + 3).span
                ))
                lane = s.at(lanes, lane).next
        i = s.at(nodes, i).next
    return Ok(out)


def size(item: Port) -> int:
    n = item.name.end - item.name.start
    if item.prefix.start != item.prefix.end:
        n += item.prefix.end - item.prefix.start + 1
    return n


def byteAt(item: Port, index: int) -> u8:
    n = item.prefix.end - item.prefix.start
    if n == 0:
        return io.byte(item.name.file, item.name.start + index)
    if index < n:
        return io.byte(item.prefix.file, item.prefix.start + index)
    if index == n:
        return 95u8
    return io.byte(item.name.file, item.name.start + index - n - 1)


def equal(a: Port, b: Port) -> bool:
    if size(a) != size(b):
        return False
    i = 0
    while i < size(a):
        if byteAt(a, i) != byteAt(b, i):
            return False
        i += 1
    return True


def validate(connections: list[Port], pins: list[c.Pin]) -> int:
    i = 0
    while i < len(connections):
        item = connections[i]
        j = 0
        while j < i:
            if equal(item, connections[j]):
                _ = io.issue(22, item.name.file, item.name.start)
                return 22
            j += 1
        found = False
        j = 0
        while j < len(pins):
            pin = pins[j]
            candidate = Port(prefix=text.empty(), name=pin.net, direction=text.empty())
            if not pin.nc and equal(item, candidate):
                found = True
            j += 1
        if not found:
            _ = io.issue(23, item.name.file, item.name.start)
            return 23
        i += 1
    return 0
