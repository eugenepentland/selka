module validate;
import io;
import text;
import sexpr as s;
import circuit as c;
export source;
export model;
export pinoutCheck;
fn importForm(nodes: &[]s::Node, i: i64) -> bool {
    {
        let word = "import";
        borrow word[0..len(word)] as w {
            return s::form(nodes, i, w);
        }
    }
}
fn defmoduleForm(nodes: &[]s::Node, i: i64) -> bool {
    {
        let word = "defmodule";
        borrow word[0..len(word)] as w {
            return s::form(nodes, i, w);
        }
    }
}
