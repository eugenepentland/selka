fn metadata(nodes: &[]s::Node, i: i64) -> bool {
    {
        let word = "net-envelope";
        borrow word[0..len(word)] as w {
            if s::form(nodes, i, w) {
                return true;
            }
        }
    }
    {
        let word = "port";
        borrow word[0..len(word)] as w {
            if s::form(nodes, i, w) {
                return true;
            }
        }
    }
    {
        let word = "port-group";
        borrow word[0..len(word)] as w {
            if s::form(nodes, i, w) {
                return true;
            }
        }
    }
    {
        let word = "net-class";
        borrow word[0..len(word)] as w {
            if s::form(nodes, i, w) {
                return true;
            }
        }
    }
    {
        let word = "pcb-plan";
        borrow word[0..len(word)] as w {
            if s::form(nodes, i, w) {
                return true;
            }
        }
    }
    {
        let word = "rough";
        borrow word[0..len(word)] as w {
            if s::form(nodes, i, w) {
                return true;
            }
        }
    }
    {
        let word = "note";
        borrow word[0..len(word)] as w {
            if s::form(nodes, i, w) {
                return true;
            }
        }
    }
    return false;
}
fn fail(code: i64, span: text::Span) -> i64 {
    discard io::issue(code, span.file, span.start);
    return code;
}
fn source(nodes: &[]s::Node) -> i64 {
    let mut i = 1;
    let mut modules = 0;
    let mut blocks = 0;
    while i < cast<i64>(len_slice(nodes)) {
        if defmoduleForm(nodes, i) {
            modules += 1;
            let params = s::at(nodes, i + 3);
            if modules != 1 || params.kind != new s::Kind.list || params.next != i + 4 {
                return fail(16, s::at(nodes, i).span);
            }
            let mut f = i + 4;
            while f < s::at(nodes, i).next {
                if s::at(nodes, f).kind == new s::Kind.string || implementsForm(nodes, f) {} else if design_blockForm(nodes, f) {
                    blocks += 1;
                    if blocks != 1 || s::at(nodes, f + 2).kind != new s::Kind.string {
                        return fail(16, s::at(nodes, f).span);
                    }
                    let mut child = f + 3;
                    while child < s::at(nodes, f).next {
                        if !instanceForm(nodes, child) && !metadata(nodes, child) {
                            return fail(17, s::at(nodes, child).span);
                        }
                        child = s::at(nodes, child).next;
                    }
                } else {
                    return fail(17, s::at(nodes, f).span);
                }
                f = s::at(nodes, f).next;
            }
        } else if !importForm(nodes, i) {
            return fail(17, s::at(nodes, i).span);
        }
        i = s::at(nodes, i).next;
    }
    if modules != 1 || blocks != 1 {
        return fail(16, s::at(nodes, 0).span);
    }
    return 0;
}
fn pinoutCheck(nodes: &[]s::Node) -> i64 {
    if !pinoutForm(nodes, 1) || s::at(nodes, 1).next != cast<i64>(len_slice(nodes)) || s::at(nodes, 3).kind != new s::Kind.string {
        return fail(18, s::at(nodes, 1).span);
    }
    let mut count = 0;
    let mut i = 4;
    while i < s::at(nodes, 1).next {
        let number = text::number(s::at(nodes, i + 2).span);
        if !pinForm(nodes, i) || s::at(nodes, i).next != i + 4 || number < 1 || number > 41 || s::at(nodes, i + 3).kind != new s::Kind.string || !text::identifier(s::at(nodes, i + 3).span) {
            return fail(18, s::at(nodes, i).span);
        }
        let mut j = 4;
        while j < i {
            if text::number(s::at(nodes, j + 2).span) == number {
                return fail(18, s::at(nodes, i).span);
            }
            j = s::at(nodes, j).next;
        }
        count += 1;
        i = s::at(nodes, i).next;
    }
    if count != 41 {
        return fail(18, s::at(nodes, 1).span);
    }
    return 0;
}
fn fields(nodes: &[]s::Node, item: c::Part) -> i64 {
    let spec = s::at(nodes, item.node + 3);
    if item.kind != 0 &&(spec.kind != new s::Kind.list || spec.next < item.node + 6 || s::at(nodes, item.node + 5).kind != new s::Kind.string) {
        return fail(19, spec.span);
    }
    if item.kind == 0 && spec.kind != new s::Kind.atom {
        return fail(19, spec.span);
    }
    let mut f = spec.next;
    while f < s::at(nodes, item.node).next {
        if !pinForm(nodes, f) && !nc_okForm(nodes, f) && !idForm(nodes, f) && !decouplesForm(nodes, f) {
            return fail(17, s::at(nodes, f).span);
        }
        if nc_okForm(nodes, f) && item.kind != 0 {
            return fail(13, s::at(nodes, f).span);
        }
        if pinForm(nodes, f) || nc_okForm(nodes, f) {
            let mut j = f + 2;
            while j < s::at(nodes, f).next && s::at(nodes, j).kind == new s::Kind.atom {
                j += 1;
            }
            if j == f + 2 || s::at(nodes, j).kind != new s::Kind.string {
                return fail(13, s::at(nodes, f).span);
            }
            if nc_okForm(nodes, f) &&(j != f + 3 || s::at(nodes, f).next != j + 1) {
                return fail(13, s::at(nodes, f).span);
            }
            j += 1;
            while j < s::at(nodes, f).next {
                if !i_typForm(nodes, j) && !i_maxForm(nodes, j) {
                    return fail(17, s::at(nodes, j).span);
                }
                j = s::at(nodes, j).next;
            }
        }
        f = s::at(nodes, f).next;
    }
    return 0;
}
fn model(nodes: &[]s::Node, parts: &[]c::Part, pins: &[]c::Pin, pinout: &[]s::Node) -> i64 {
    let schema = pinoutCheck(pinout);
    if schema != 0 {
        return schema;
    }
    let mut chips = 0;
    let mut p = 0;
    while p < cast<i64>(len_slice(parts)) {
        let item = read_slice(parts, p);
        let fieldError = fields(nodes, item);
        if fieldError != 0 {
            return fieldError;
        }
        if item.kind == 0 {
            chips += 1;
            if !text::folded(item.family, s::at(pinout, 3).span) {
                return fail(19, item.family);
            }
        }
        let mut count = 0;
        let mut j = 0;
        while j < cast<i64>(len_slice(pins)) {
            if read_slice(pins, j).part == p {
                count += 1;
            }
            j += 1;
        }
        if (item.kind == 0 && count != 41) ||(item.kind != 0 && count != 2) {
            return fail(20, item.ref);
        }
        p += 1;
    }
    if chips != 1 {
        return fail(19, s::at(nodes, 0).span);
    }
    return 0;
}
