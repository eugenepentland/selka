module layout_graph
import circuit as c
import text
import io
export Net
export build
export find
export rail


class Net:
    span: text.Span
    group: int
    owner: int
    distance: int


class Edge:
    a: int
    b: int


def rail(span: text.Span) -> bool:
    if text.matches(span, b"GND"):
        return True
    return span.end - span.start >= 2 and io.byte(span.file, span.start) == 86u8 and io.byte(span.file, span.start + 1) == 95u8


def find(nets: list[Net], span: text.Span) -> int:
    i = 0
    while i < len(nets):
        if text.equal(nets[i].span, span):
            return i
        i += 1
    return - 1


def build(parts: list[c.Part], pins: list[c.Pin]) -> list[Net]:
    nets: list[Net] = []
    edges: list[Edge] = []
    i = 0
    while i < len(pins):
        pin = pins[i]
        if not pin.nc:
            span = c.displayNet(pin.net, parts, pins)
            present = False
            n = 0
            while n < len(nets):
                if text.equal(nets[n].span, span):
                    present = True
                n += 1
            if not present:
                nets.append(Net(
                    span=span,
                    group=len(nets),
                    owner=- 1,
                    distance=4096
                ))
        i += 1
    part = 0
    while part < len(parts):
        if parts[part].kind != 0:
            a = text.empty()
            b = text.empty()
            i = 0
            while i < len(pins):
                pin = pins[i]
                if pin.part == part and not pin.nc:
                    if pin.number == 1:
                        a = c.displayNet(pin.net, parts, pins)
                    if pin.number == 2:
                        b = c.displayNet(pin.net, parts, pins)
                i += 1
            if not rail(a) and not rail(b):
                na = - 1
                nb = - 1
                ga = - 1
                gb = - 1
                i = 0
                while i < len(nets):
                    item = nets[i]
                    if text.equal(item.span, a):
                        ga = item.group
                        na = i
                    if text.equal(item.span, b):
                        gb = item.group
                        nb = i
                    i += 1
                if na >= 0 and nb >= 0:
                    edges.append(Edge(
                        a=na,
                        b=nb
                    ))
                if ga >= 0 and gb >= 0 and ga != gb:
                    i = 0
                    while i < len(nets):
                        item = nets[i]
                        if item.group == gb:
                            nets[i].group = ga
                        i += 1
        part += 1
    i = 0
    while i < len(pins):
        pin = pins[i]
        if not pin.nc and parts[pin.part].kind == 0:
            span = c.displayNet(pin.net, parts, pins)
            n = 0
            while n < len(nets):
                item = nets[n]
                if item.owner < 0 and text.equal(item.span, span):
                    nets[n].owner = i
                    nets[n].distance = 0
                n += 1
        i += 1
    changed = True
    passes = 0
    while changed and passes < 128:
        changed = False
        i = 0
        while i < len(edges):
            edge = edges[i]
            head = nets[edge.a]
            tail = nets[edge.b]
            if head.distance + 1 < tail.distance  or (head.owner >= 0 and tail.owner >= 0 and head.distance + 1 == tail.distance and pins[head.owner].number < pins[tail.owner].number):
                nets[edge.b].owner = head.owner
                nets[edge.b].distance = head.distance + 1
                changed = True
            if tail.distance + 1 < head.distance  or (head.owner >= 0 and tail.owner >= 0 and tail.distance + 1 == head.distance and pins[tail.owner].number < pins[head.owner].number):
                nets[edge.a].owner = tail.owner
                nets[edge.a].distance = tail.distance + 1
                changed = True
            i += 1
        passes += 1
    return nets
