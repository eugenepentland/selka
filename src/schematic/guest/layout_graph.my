module layout_graph
import circuit as c
import text


public record Net:
    span: text.Span
    identity: int
    group: int
    owner: int
    distance: int


record Edge:
    a: int
    b: int


public def rail(host: Host, span: text.Span) -> bool effects(host, managed_allocation):
    if text.matches(host, span, b"GND"):
        return True
    return span.end - span.start >= 2 and span.source[span.start] == 86 and span.source[span.start + 1] == 95


public def find(host: Host, nets: list[Net], span: text.Span) -> int effects(host):
    i = 0
    while i < len(nets):
        if text.equal(host, nets[i].span, span):
            return i
        i += 1
    return - 1


public def findId(nets: list[Net], identity: int) -> int:
    i = 0
    while i < len(nets):
        if nets[i].identity == identity:
            return i
        i += 1
    return - 1


public def build(host: Host, parts: list[c.Part], pins: list[c.Pin]) -> list[Net] effects(host, managed_allocation):
    nets: list[Net] = []
    edges: list[Edge] = []
    i = 0
    while i < len(pins):
        pin = pins[i]
        if not pin.nc:
            span = pin.display
            present = False
            n = 0
            while n < len(nets):
                if nets[n].identity == pin.display_id:
                    present = True
                n += 1
            if not present:
                nets.append(Net(
                    span=span,
                    identity=pin.display_id,
                    group=len(nets),
                    owner=- 1,
                    distance=4096
                ))
        i += 1
    part = 0
    while part < len(parts):
        if parts[part].kind != 0:
            ai = parts[part].pin1
            bi = parts[part].pin2
            if ai >= 0 and bi >= 0 and not pins[ai].nc and not pins[bi].nc and pins[ai].rail == 0 and pins[bi].rail == 0:
                na = - 1
                nb = - 1
                ga = - 1
                gb = - 1
                i = 0
                while i < len(nets):
                    item = nets[i]
                    if item.identity == pins[ai].display_id:
                        ga = item.group
                        na = i
                    if item.identity == pins[bi].display_id:
                        gb = item.group
                        nb = i
                    i += 1
                if na >= 0 and nb >= 0:
                    edges.append(Edge(
                        a=na,
                        b=nb
                    ))
                if ga >= 0 and gb >= 0 and ga != gb:
                    i = 0
                    while i < len(nets):
                        item = nets[i]
                        if item.group == gb:
                            nets[i].group = ga
                        i += 1
        part += 1
    i = 0
    while i < len(pins):
        pin = pins[i]
        if not pin.nc and parts[pin.part].kind == 0:
            n = 0
            while n < len(nets):
                item = nets[n]
                if item.owner < 0 and item.identity == pin.display_id:
                    nets[n].owner = i
                    nets[n].distance = 0
                n += 1
        i += 1
    changed = True
    passes = 0
    while changed and passes < 128:
        changed = False
        i = 0
        while i < len(edges):
            edge = edges[i]
            head = nets[edge.a]
            tail = nets[edge.b]
            if head.distance + 1 < tail.distance  or (head.owner >= 0 and tail.owner >= 0 and head.distance + 1 == tail.distance and pins[head.owner].number < pins[tail.owner].number):
                nets[edge.b].owner = head.owner
                nets[edge.b].distance = head.distance + 1
                changed = True
            if tail.distance + 1 < head.distance  or (head.owner >= 0 and tail.owner >= 0 and tail.distance + 1 == head.distance and pins[tail.owner].number < pins[head.owner].number):
                nets[edge.a].owner = tail.owner
                nets[edge.a].distance = tail.distance + 1
                changed = True
            i += 1
        passes += 1
    return nets
