module io
# Document identities come from the host; application code uses their roles.


public record Document:
    identity: int
    source: bytes


public def id(document: Document) -> int noalloc:
    return document.identity


public class Output:
    buffer: byte_buffer
    failed: bool


def load(host: Host, identity: int) -> Result[Document, int]:
    return Ok(Document(identity=identity, source=read_document(host, identity)))


public def output() -> Output:
    values: list[int] = []
    return Output(buffer=byte_buffer(values), failed=False)


public def append(out: mut Output, value: bytes):
    if out.failed:
        return
    if len(out.buffer) > 4194304 - len(value):
        out.failed = True
        return
    if not out.buffer.append_range(value, 0, len(value)):
        out.failed = True
    return


public def appendByte(out: mut Output, value: u8):
    if out.failed:
        return
    if len(out.buffer) == 4194304:
        out.failed = True
        return
    if not out.buffer.append_byte(int(value)):
        out.failed = True
    return


public def appendInt(out: mut Output, value: int):
    if out.failed:
        return
    width = decimalWidth(value)
    if len(out.buffer) > 4194304 - width:
        out.failed = True
        return
    if not out.buffer.append_int(value):
        out.failed = True
    return


public def decimalWidth(value: int) -> int:
    width = 1
    if value < 0:
        width = 2
        threshold = - 10
        while value <= threshold:
            width += 1
            if threshold == - 1000000000000000000:
                return width
            threshold = threshold * 10
        return width
    threshold = 10
    while value >= threshold:
        width += 1
        if threshold == 1000000000000000000:
            return width
        threshold = threshold * 10
    return width


public def flush(host: Host, out: Output) -> int:
    if out.failed:
        _ = output_limit(host)
        return 5
    status = write_bytes(host, bytes(out.buffer))
    if status != 0:
        return status
    return finish(host)


public record Inputs:
    circuit: Document
    pinout: Document
    interface: Document


public def inputs(host: Host) -> Result[Inputs, int]:
    circuit = load(host, circuit_input(host))?
    pinout = load(host, pinout_input(host))?
    interface = load(host, interface_input(host))?
    return Ok(Inputs(circuit=circuit, pinout=pinout, interface=interface))
host def circuit_input(host: Host) -> int effects(host)
host def pinout_input(host: Host) -> int effects(host)
host def interface_input(host: Host) -> int effects(host)
public host def length(host: Host, file: int) -> int effects(host)
public host def read_block(host: Host, file: int, position: int) -> [256]u8 effects(host)
public host def read_document(host: Host, file: int) -> bytes effects(host)
public host def write_block(host: Host, payload: [256]u8, count: int) -> int effects(host)
public host def write_bytes(host: Host, payload: bytes) -> int effects(host)
public host def finish(host: Host) -> int effects(host)
public host def output_limit(host: Host) -> int effects(host)
public host def byte(host: Host, file: int, position: int) -> u8 effects(host)
public host def put(host: Host, value: u8) -> int effects(host)
public host def issue(host: Host, code: int, file: int, position: int) -> int effects(host)
