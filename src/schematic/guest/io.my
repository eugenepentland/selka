module io
export Document
export Inputs
export inputs
export length
export byte
export put
export issue
# Document identities come from the host; application code uses their roles.


domain Document: int:
    def circuit() -> Document effects(host):
        return wrap[Document](circuit_input())
    def pinout() -> Document effects(host):
        return wrap[Document](pinout_input())
    def interface() -> Document effects(host):
        return wrap[Document](interface_input())
    def id(document: Document) -> int noalloc:
        return unwrap(document)


record Inputs:
    circuit: Document
    pinout: Document
    interface: Document


def inputs() -> Inputs effects(host):
    return Inputs(
        circuit=Document.circuit(),
        pinout=Document.pinout(),
        interface=Document.interface()
    )
host def circuit_input(host: Host) -> int effects(host)
host def pinout_input(host: Host) -> int effects(host)
host def interface_input(host: Host) -> int effects(host)
host def length(host: Host, file: int) -> int effects(host)
host def byte(host: Host, file: int, position: int) -> u8 effects(host)
host def put(host: Host, value: u8) -> int effects(host)
host def issue(host: Host, code: int, file: int, position: int) -> int effects(host)
