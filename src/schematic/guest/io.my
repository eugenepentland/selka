module io
# Document identities come from the host; application code uses their roles.


public domain Document: int:
    def circuit(host: Host) -> Document effects(host):
        return wrap[Document](circuit_input(host))
    def pinout(host: Host) -> Document effects(host):
        return wrap[Document](pinout_input(host))
    def interface(host: Host) -> Document effects(host):
        return wrap[Document](interface_input(host))
    def id(document: Document) -> int noalloc:
        return unwrap(document)


public record Inputs:
    circuit: Document
    pinout: Document
    interface: Document


public def inputs(host: Host) -> Inputs effects(host):
    return Inputs(
        circuit=Document.circuit(host),
        pinout=Document.pinout(host),
        interface=Document.interface(host)
    )
host def circuit_input(host: Host) -> int effects(host)
host def pinout_input(host: Host) -> int effects(host)
host def interface_input(host: Host) -> int effects(host)
public host def length(host: Host, file: int) -> int effects(host)
public host def byte(host: Host, file: int, position: int) -> u8 effects(host)
public host def put(host: Host, value: u8) -> int effects(host)
public host def issue(host: Host, code: int, file: int, position: int) -> int effects(host)
