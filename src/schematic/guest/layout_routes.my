module layout_routes
import layout as l
import circuit as c
import text
import ports as p
export Segment
export build
export external


record Segment:
    x1: int
    y1: int
    x2: int
    y2: int
    net: text.Span
    junction: bool
    terminal: bool


def ground(span: text.Span) -> bool:
    return text.matches(span, b"GND")


def distance(a: l.Point, b: l.Point) -> int:
    x = a.x - b.x
    y = a.y - b.y
    if x < 0:
        x = - x
    if y < 0:
        y = - y
    return x + y


def external(net: text.Span, connections: list[p.Port]) -> bool effects(host):
    target = p.Port(
        prefix=text.empty(),
        name=net,
        direction=text.empty()
    )
    i = 0
    while i < len(connections):
        if p.equal(target, connections[i]):
            return True
        i += 1
    return False


def decoupling(pin: c.Pin, parts: list[c.Part], pins: list[c.Pin]) -> bool:
    if not ground(pin.net) or parts[pin.part].kind != 1:
        return False
    i = 0
    while i < len(pins):
        other = pins[i]
        if other.part == pin.part and other.number != pin.number:
            display = c.displayNet(other.net, parts, pins)
            return l.rail(display) and not ground(display) and not text.equal(display, other.net)
        i += 1
    return False


def blocked(a: l.Point, b: l.Point, net: text.Span, parts: list[c.Part], pins: list[c.Pin], points: list[l.Point]) -> bool:
    i = 0
    while i < len(pins):
        pin = pins[i]
        q = points[i]
        if not pin.nc and not text.equal(net, c.displayNet(pin.net, parts, pins)):
            if a.x == b.x and q.x == a.x  and ((q.y >= a.y and q.y <= b.y)  or (q.y >= b.y and q.y <= a.y)):
                return True
            if a.y == b.y and q.y == a.y  and ((q.x >= a.x and q.x <= b.x)  or (q.x >= b.x and q.x <= a.x)):
                return True
        i += 1
    return False


def build(parts: list[c.Part], pins: list[c.Pin], points: list[l.Point], connections: list[p.Port]) -> list[Segment] effects(host, managed_allocation):
    out: list[Segment] = []
    i = 0
    while i < len(pins):
        pin = pins[i]
        point = points[i]
        if not pin.nc:
            display = c.displayNet(pin.net, parts, pins)
            isGround = ground(pin.net)
            coupledGround = decoupling(pin, parts, pins)
            localGround = isGround and parts[pin.part].kind != 0 and not coupledGround
            isRail = l.rail(display) and not isGround
            standaloneRail = isRail and parts[pin.part].kind != 0 and text.equal(pin.net, display)
            nearest = - 1
            shortest = 1000000
            count = 0
            j = 0
            while j < len(pins):
                other = pins[j]
                otherPoint = points[j]
                otherStandalone = isRail and parts[other.part].kind != 0 and text.equal(other.net, display)
                allowed =(not isGround  or (coupledGround and decoupling(other, parts, pins))  or (not coupledGround and parts[other.part].kind == 0)) and not otherStandalone
                if not other.nc and allowed and text.equal(display, c.displayNet(other.net, parts, pins)):
                    count += 1
                    if j < i and distance(point, otherPoint) < shortest:
                        nearest = j
                        shortest = distance(point, otherPoint)
                j += 1
            if nearest < 0 and count > 1  and (isGround or isRail) and not localGround and not standaloneRail:
                low = point.y
                high = point.y
                k = 0
                while k < len(pins):
                    other = pins[k]
                    if not other.nc  and ((coupledGround and decoupling(other, parts, pins))  or (not coupledGround and parts[other.part].kind == 0)) and text.equal(display, c.displayNet(other.net, parts, pins)):
                        q = points[k]
                        if q.y < low:
                            low = q.y
                        if q.y > high:
                            high = q.y
                    k += 1
                side = - 1
                if point.x > 442:
                    side = 1
                y =(low + high) // 2
                if isRail:
                    y = low - 20
                if coupledGround:
                    y = high
                bus = point.x + side * 40
                if coupledGround:
                    bus = point.x + side * 20
                out.append(Segment(
                    x1=bus,
                    y1=point.y,
                    x2=bus,
                    y2=y,
                    net=display,
                    junction=False,
                    terminal=False
                ))
                reach = 100
                if coupledGround:
                    reach = 10
                out.append(Segment(
                    x1=bus,
                    y1=y,
                    x2=bus + side * reach,
                    y2=y,
                    net=display,
                    junction=False,
                    terminal=True
                ))
            if nearest < 0 and count > 1 and not isGround and not isRail and external(display, connections):
                dx = 24
                if point.x < 442:
                    dx = - 24
                out.append(Segment(
                    x1=point.x,
                    y1=point.y,
                    x2=point.x + dx,
                    y2=point.y,
                    net=display,
                    junction=False,
                    terminal=True
                ))
            if localGround or standaloneRail or count == 1:
                dx = 24
                if parts[pin.part].kind == 0:
                    dx = 140
                    if not external(display, connections) and not isRail and not isGround:
                        dx = 50
                if point.x < 442:
                    dx = - dx
                out.append(Segment(
                    x1=point.x,
                    y1=point.y,
                    x2=point.x + dx,
                    y2=point.y,
                    net=display,
                    junction=False,
                    terminal=True
                ))
            elif nearest >= 0:
                previous = points[nearest]
                if isGround  or (point.x == previous.x  and (point.x == 352 or point.x == 532)):
                    bus = point.x - 40
                    if point.x > 442:
                        bus = point.x + 40
                    if coupledGround:
                        bus = point.x - 20
                        if point.x > 442:
                            bus = point.x + 20
                    out.append(Segment(
                        x1=point.x,
                        y1=point.y,
                        x2=bus,
                        y2=point.y,
                        net=display,
                        junction=False,
                        terminal=False
                    ))
                    out.append(Segment(
                        x1=bus,
                        y1=point.y,
                        x2=bus,
                        y2=previous.y,
                        net=display,
                        junction=True,
                        terminal=False
                    ))
                    out.append(Segment(
                        x1=bus,
                        y1=previous.y,
                        x2=previous.x,
                        y2=previous.y,
                        net=display,
                        junction=False,
                        terminal=False
                    ))
                elif isRail and parts[pin.part].kind != 0:
                    bus = 302
                    if point.x > 442:
                        bus = 582
                    out.append(Segment(
                        x1=point.x,
                        y1=point.y,
                        x2=bus,
                        y2=point.y,
                        net=display,
                        junction=False,
                        terminal=False
                    ))
                    out.append(Segment(
                        x1=bus,
                        y1=point.y,
                        x2=bus,
                        y2=previous.y,
                        net=display,
                        junction=False,
                        terminal=False
                    ))
                    out.append(Segment(
                        x1=bus,
                        y1=previous.y,
                        x2=previous.x,
                        y2=previous.y,
                        net=display,
                        junction=False,
                        terminal=False
                    ))
                elif parts[pins[nearest].part].kind == 0 and point.y != previous.y:
                    side = 1
                    if previous.x < 442:
                        side = - 1
                    bus = previous.x + side * 50
                    out.append(Segment(
                        x1=point.x,
                        y1=point.y,
                        x2=bus,
                        y2=point.y,
                        net=display,
                        junction=False,
                        terminal=False
                    ))
                    out.append(Segment(
                        x1=bus,
                        y1=point.y,
                        x2=bus,
                        y2=previous.y,
                        net=display,
                        junction=False,
                        terminal=False
                    ))
                    out.append(Segment(
                        x1=bus,
                        y1=previous.y,
                        x2=previous.x,
                        y2=previous.y,
                        net=display,
                        junction=False,
                        terminal=False
                    ))
                elif point.x == previous.x and blocked(point, previous, display, parts, pins, points):
                    offset = 16
                    lane = point.x + offset
                    lane_start = l.Point(x=lane, y=point.y)
                    lane_end = l.Point(x=lane, y=previous.y)
                    while blocked(lane_start, lane_end, display, parts, pins, points) and offset < 160:
                        offset += 16
                        lane = point.x + offset
                        lane_start.x = lane
                        lane_end.x = lane
                    out.append(Segment(
                        x1=point.x,
                        y1=point.y,
                        x2=lane,
                        y2=point.y,
                        net=display,
                        junction=False,
                        terminal=False
                    ))
                    out.append(Segment(
                        x1=lane,
                        y1=point.y,
                        x2=lane,
                        y2=previous.y,
                        net=display,
                        junction=False,
                        terminal=False
                    ))
                    out.append(Segment(
                        x1=lane,
                        y1=previous.y,
                        x2=previous.x,
                        y2=previous.y,
                        net=display,
                        junction=False,
                        terminal=False
                    ))
                else:
                    out.append(Segment(
                        x1=point.x,
                        y1=point.y,
                        x2=previous.x,
                        y2=point.y,
                        net=display,
                        junction=count > 2,
                        terminal=False
                    ))
                    if point.y != previous.y:
                        out.append(Segment(
                            x1=previous.x,
                            y1=point.y,
                            x2=previous.x,
                            y2=previous.y,
                            net=display,
                            junction=count > 2,
                            terminal=False
                        ))
        i += 1
    return out
