module layout
import circuit as c
import text
import layout_graph as g


public record Point:
    x: int
    y: int


record Row:
    index: int
    group: int
    height: int
    rail: int
    side: int
    y: int


public def rail(host: Host, span: text.Span) -> bool effects(host, managed_allocation):
    return g.rail(host, span)


def pinGroup(host: Host, pin: c.Pin, parts: list[c.Part], pins: list[c.Pin], nets: list[g.Net]) -> int:
    id = g.find(host, nets, c.displayNet(host, pin.net, parts, pins))
    if id < 0:
        return - 1
    return nets[id].group


def railKind(host: Host, span: text.Span) -> int:
    if text.matches(host, span, b"GND"):
        return 1
    if g.rail(host, span):
        return 2
    return 0


def rowHeight(host: Host, pin: c.Pin, pins: list[c.Pin], parts: list[c.Part]) -> int:
    if g.rail(host, c.displayNet(host, pin.net, parts, pins)):
        return 40
    count = 0
    hasBridge = False
    i = 0
    while i < len(pins):
        other = pins[i]
        if parts[other.part].kind != 0 and text.equal(host, pin.net, other.net):
            count += 1
            j = 0
            while j < len(pins):
                farPin = pins[j]
                if farPin.part == other.part and farPin.number != other.number and not g.rail(host, farPin.net):
                    k = 0
                    while k < len(pins):
                        hub = pins[k]
                        if parts[hub.part].kind == 0 and text.equal(host, hub.net, farPin.net):
                            hasBridge = True
                        k += 1
                j += 1
        i += 1
    if count > 1:
        if not hasBridge:
            return count * 40
        return 56 +(count - 1) * 40
    return 56


def collectRows(host: Host, parts: list[c.Part], pins: list[c.Pin], nets: list[g.Net]) -> list[Row]:
    out: list[Row] = []
    number = 1
    while number <= 128:
        i = 0
        while i < len(pins):
            pin = pins[i]
            if parts[pin.part].kind == 0 and not pin.nc and pin.number == number:
                group = pinGroup(host, pin, parts, pins, nets)
                present = False
                n = 0
                while n < len(out):
                    if out[n].group == group:
                        present = True
                    n += 1
                if not present:
                    member = 1
                    while member <= 128:
                        j = 0
                        while j < len(pins):
                            other = pins[j]
                            if other.part == pin.part and not other.nc and other.number == member and pinGroup(host, other, parts, pins, nets) == group:
                                out.append(Row(
                                    index=j,
                                    group=group,
                                    height=rowHeight(host, other, pins, parts),
                                    rail=railKind(host, c.displayNet(host, other.net, parts, pins)),
                                    side=0,
                                    y=0
                                ))
                            j += 1
                        member += 1
            i += 1
        number += 1
    return out


public def height(points: list[Point]) -> int effects():
    bottom = 160
    i = 0
    while i < len(points):
        if points[i].y + 40 > bottom:
            bottom = points[i].y + 40
        i += 1
    return bottom


def placeRows(rows: list[Row]) -> int:
    total = 0
    i = 0
    while i < len(rows):
        row = rows[i]
        total += row.height
        if i == 0 or rows[i - 1].group != row.group:
            if row.rail == 1:
                total += 16
            if row.rail == 2:
                total += 56
        i += 1
    prefix = 0
    best = total * 100
    split = len(rows)
    i = 0
    while i + 1 < len(rows):
        row = rows[i]
        prefix += row.height
        if i == 0 or rows[i - 1].group != row.group:
            if row.rail == 1:
                prefix += 16
            if row.rail == 2:
                prefix += 56
        if rows[i].group != rows[i + 1].group:
            delta = total * 48 - 100 * prefix
            if delta < 0:
                delta = - delta
            if delta < best:
                best = delta
                split = i + 1
        i += 1
    y = 80
    i = 0
    while i < len(rows):
        if i == split:
            y = 80
        row = rows[i]
        if i > 0 and i != split and rows[i - 1].group != row.group:
            if rows[i - 1].rail == 1:
                y += 16
            if rows[i - 1].rail == 2:
                y += 36
            if rows[i - 1].height == 80:
                y += 16
        if row.rail == 2  and (i == 0 or i == split or rows[i - 1].group != row.group):
            y += 20
        offset = 0
        if row.height > 56:
            offset =(row.height - 56) // 2
        if row.height == 80:
            offset = 20
        side = - 1
        if i >= split:
            side = 1
        rows[i].side = side
        rows[i].y = y + offset
        y += row.height
        i += 1
    return 0


def nearest(host: Host, pin: c.Pin, parts: list[c.Part], pins: list[c.Pin], rows: list[Row], nets: list[g.Net]) -> int:
    group = pinGroup(host, pin, parts, pins, nets)
    id = g.find(host, nets, c.displayNet(host, pin.net, parts, pins))
    owner = - 1
    if id >= 0:
        owner = nets[id].owner
    fallback = - 1
    i = 0
    while i < len(rows):
        row = rows[i]
        hub = pins[row.index]
        if text.equal(host, pin.net, hub.net):
            return i
        if row.index == owner:
            fallback = i
        if row.group == group and fallback < 0:
            fallback = i
        i += 1
    return fallback


def partPin(part: int, number: int, pins: list[c.Pin]) -> c.Pin:
    i = 0
    while i < len(pins):
        pin = pins[i]
        if pin.part == part and pin.number == number:
            return pin
        i += 1
    return c.Pin(
        part=part,
        number=number,
        net=text.empty(),
        nc=True
    )


def depth(host: Host, pin: c.Pin, parts: list[c.Part], pins: list[c.Pin], nets: list[g.Net]) -> int:
    id = g.find(host, nets, c.displayNet(host, pin.net, parts, pins))
    if id < 0:
        return 4096
    return nets[id].distance


def innerPin(host: Host, part: int, parts: list[c.Part], pins: list[c.Pin], nets: list[g.Net]) -> c.Pin:
    a = partPin(part, 1, pins)
    b = partPin(part, 2, pins)
    if g.rail(host, a.net) and not g.rail(host, b.net):
        return b
    if not g.rail(host, b.net) and depth(host, b, parts, pins, nets) < depth(host, a, parts, pins, nets):
        return b
    return a


def bridge(host: Host, part: int, parts: list[c.Part], pins: list[c.Pin], rows: list[Row], nets: list[g.Net]) -> bool:
    a = partPin(part, 1, pins)
    b = partPin(part, 2, pins)
    if g.rail(host, a.net) or g.rail(host, b.net):
        return False
    if depth(host, a, parts, pins, nets) != depth(host, b, parts, pins, nets):
        return False
    ai = nearest(host, a, parts, pins, rows, nets)
    bi = nearest(host, b, parts, pins, rows, nets)
    return ai >= 0 and bi >= 0 and ai != bi


def groundBranch(host: Host, part: int, parts: list[c.Part], pins: list[c.Pin], nets: list[g.Net]) -> bool:
    inner = innerPin(host, part, parts, pins, nets)
    outer = partPin(part, 3 - inner.number, pins)
    if railKind(host, outer.net) == 1:
        return True
    if railKind(host, outer.net) == 2:
        return False
    found = False
    j = 0
    while j < len(parts):
        if parts[j].kind != 0 and j != part:
            a = partPin(j, 1, pins)
            b = partPin(j, 2, pins)
            other = text.empty()
            if text.equal(host, a.net, outer.net):
                other = b.net
            if text.equal(host, b.net, outer.net):
                other = a.net
            if railKind(host, other) == 2:
                return False
            if railKind(host, other) == 1:
                found = True
        j += 1
    return found


def branch(host: Host, part: int, parts: list[c.Part], pins: list[c.Pin], rows: list[Row], nets: list[g.Net], remaining: int) -> int:
    if remaining == 0:
        return 0
    inner = innerPin(host, part, parts, pins, nets)
    level = depth(host, inner, parts, pins, nets)
    offset = 0
    j = 0
    if level > 0:
        owner = nearest(host, inner, parts, pins, rows, nets)
        while j < len(parts):
            if parts[j].kind != 0 and j != part:
                previous = innerPin(host, j, parts, pins, nets)
                if depth(host, previous, parts, pins, nets) < level and nearest(host, previous, parts, pins, rows, nets) == owner:
                    outer = partPin(j, 3 - previous.number, pins)
                    if text.equal(host, outer.net, inner.net):
                        offset = branch(host, j, parts, pins, rows, nets, remaining - 1)
                        j = len(parts)
            j += 1
    count = 0
    rank = 0
    hasBridge = False
    grounded = groundBranch(host, part, parts, pins, nets)
    j = 0
    while j < len(parts):
        if parts[j].kind != 0:
            previous = innerPin(host, j, parts, pins, nets)
            a = partPin(j, 1, pins)
            b = partPin(j, 2, pins)
            if bridge(host, j, parts, pins, rows, nets):
                if text.equal(host, a.net, inner.net) or text.equal(host, b.net, inner.net):
                    hasBridge = True
            elif text.equal(host, previous.net, inner.net):
                count += 1
                otherGround = groundBranch(host, j, parts, pins, nets)
                if level > 0:
                    if j < part:
                        rank += 1
                elif (otherGround and not grounded)  or (otherGround == grounded and j < part):
                    rank += 1
        j += 1
    if level == 0:
        spacing = 20
        if hasBridge:
            spacing = 40
        offset -=(count - 1) * spacing
    return offset + rank * 40


def endpoint(host: Host, pin: c.Pin, parts: list[c.Part], pins: list[c.Pin], rows: list[Row], nets: list[g.Net]) -> Point:
    inner = innerPin(host, pin.part, parts, pins, nets)
    chosen = nearest(host, inner, parts, pins, rows, nets)
    if chosen < 0:
        return Point(
            x=100 + pin.number * 60,
            y=80 + pin.part * 60
        )
    row = rows[chosen]
    edge = 352
    if row.side == 1:
        edge = 532
    level = depth(host, inner, parts, pins, nets)
    if bridge(host, pin.part, parts, pins, rows, nets):
        target = nearest(host, pin, parts, pins, rows, nets)
        other = rows[target]
        reach = 50
        if level > 0:
            reach = 170
        return Point(
            x=edge + row.side * reach,
            y=other.y
        )
    hub = pins[row.index]
    count = 0
    j = 0
    while j < len(parts):
        if parts[j].kind != 0:
            attached = innerPin(host, j, parts, pins, nets)
            if text.equal(host, attached.net, hub.net) and not bridge(host, j, parts, pins, rows, nets):
                count += 1
        j += 1
    reach = 40
    if count > 1:
        reach = 60
    if pin.number != inner.number:
        reach = 120
    folded = c.displayNet(host, inner.net, parts, pins)
    localRail = railKind(host, inner.net) == 2 and not text.equal(host, folded, inner.net)
    y = row.y + branch(host, pin.part, parts, pins, rows, nets, 128)
    if localRail:
        reach = 70
        if pin.number != inner.number:
            reach = 110
        y += 20
    x = edge + row.side *(reach + level * 60)
    return Point(
        x=x,
        y=y
    )


public def build(host: Host, parts: list[c.Part], pins: list[c.Pin]) -> list[Point] effects(host, managed_allocation):
    nets = g.build(host, parts, pins)
    out: list[Point] = []
    ordered = collectRows(host, parts, pins, nets)
    _ = placeRows(ordered)
    i = 0
    while i < len(pins):
        pin = pins[i]
        point = Point(
            x=- 1,
            y=- 1
        )
        if parts[pin.part].kind == 0:
            j = 0
            while j < len(ordered):
                row = ordered[j]
                if row.index == i:
                    x = 352
                    if row.side == 1:
                        x = 532
                    point = Point(
                        x=x,
                        y=row.y
                    )
                j += 1
        else:
            point = endpoint(host, pin, parts, pins, ordered, nets)
        out.append(point)
        i += 1
    return out
