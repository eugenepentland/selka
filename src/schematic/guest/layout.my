module layout
import circuit as c
import text
import layout_graph as g


public record Point:
    x: int
    y: int


record Row:
    index: int
    group: int
    height: int
    rail: int
    side: int
    y: int


public def rail(host: Host, span: text.Span) -> bool effects(host, managed_allocation):
    return g.rail(host, span)


def netLookup(pins: list[c.Pin], nets: list[g.Net]) -> list[int]:
    out: list[int] = []
    i = 0
    while i < len(pins):
        out.append(- 1)
        i += 1
    i = 0
    while i < len(nets):
        identity = nets[i].identity
        if identity >= 0 and identity < len(out):
            out[identity] = i
        i += 1
    return out


def pinGroup(pin: c.Pin, nets: list[g.Net], lookup: list[int]) -> int:
    id = - 1
    if pin.display_id >= 0 and pin.display_id < len(lookup):
        id = lookup[pin.display_id]
    if id < 0:
        return - 1
    return nets[id].group


def rowHeight(pin: c.Pin, passive_counts: list[int], bridge_nets: list[bool]) -> int:
    if pin.rail != 0:
        return 40
    count = passive_counts[pin.net_id]
    if count > 1:
        if not bridge_nets[pin.net_id]:
            return count * 40
        return 56 +(count - 1) * 40
    return 56


def collectRows(host: Host, parts: list[c.Part], pins: list[c.Pin], nets: list[g.Net], lookup: list[int]) -> list[Row]:
    out: list[Row] = []
    counts: list[int] = []
    offsets: list[int] = []
    cursor: list[int] = []
    ordered: list[int] = []
    passive_counts: list[int] = []
    bridge_nets: list[bool] = []
    hub_nets: list[bool] = []
    i = 0
    while i <= 129:
        counts.append(0)
        offsets.append(0)
        cursor.append(0)
        i += 1
    i = 0
    while i < len(pins):
        passive_counts.append(0)
        bridge_nets.append(False)
        hub_nets.append(False)
        ordered.append(- 1)
        i += 1
    hub_count = 0
    i = 0
    while i < len(pins):
        pin = pins[i]
        if parts[pin.part].kind == 0:
            if not pin.nc and pin.number >= 1 and pin.number <= 128:
                counts[pin.number] = counts[pin.number] + 1
                hub_count += 1
            # NC labels participated in the original bridge-presence scan.
            if pin.net_id >= 0:
                hub_nets[pin.net_id] = True
        elif not pin.nc and pin.net_id >= 0:
            passive_counts[pin.net_id] = passive_counts[pin.net_id] + 1
        i += 1
    number = 1
    while number <= 129:
        offsets[number] = offsets[number - 1] + counts[number - 1]
        cursor[number] = offsets[number]
        number += 1
    i = 0
    while i < len(pins):
        pin = pins[i]
        if parts[pin.part].kind == 0 and not pin.nc and pin.number >= 1 and pin.number <= 128:
            slot = cursor[pin.number]
            ordered[slot] = i
            cursor[pin.number] = slot + 1
        i += 1
    i = 0
    while i < len(pins):
        pin = pins[i]
        if parts[pin.part].kind != 0 and not pin.nc:
            far = parts[pin.part].pin1
            if far == i:
                far = parts[pin.part].pin2
            if far >= 0 and pins[far].raw_rail == 0 and pins[far].net_id >= 0 and hub_nets[pins[far].net_id]:
                bridge_nets[pin.net_id] = True
        i += 1
    seen_groups: list[int] = []
    position = 0
    while position < hub_count:
        index = ordered[position]
        pin = pins[index]
        group = pinGroup(pin, nets, lookup)
        present = False
        n = 0
        while n < len(seen_groups):
            if seen_groups[n] == group:
                present = True
            n += 1
        if not present:
            seen_groups.append(group)
            member = 0
            while member < hub_count:
                other_index = ordered[member]
                other = pins[other_index]
                if other.part == pin.part and pinGroup(other, nets, lookup) == group:
                    out.append(Row(
                        index=other_index,
                        group=group,
                        height=rowHeight(other, passive_counts, bridge_nets),
                        rail=other.rail,
                        side=0,
                        y=0
                    ))
                member += 1
        position += 1
    return out


public def height(points: list[Point]) -> int effects():
    bottom = 160
    i = 0
    while i < len(points):
        if points[i].y + 40 > bottom:
            bottom = points[i].y + 40
        i += 1
    return bottom


def placeRows(rows: list[Row]) -> int:
    total = 0
    i = 0
    while i < len(rows):
        row = rows[i]
        total += row.height
        if i == 0 or rows[i - 1].group != row.group:
            if row.rail == 1:
                total += 16
            if row.rail == 2:
                total += 56
        i += 1
    prefix = 0
    best = total * 100
    split = len(rows)
    i = 0
    while i + 1 < len(rows):
        row = rows[i]
        prefix += row.height
        if i == 0 or rows[i - 1].group != row.group:
            if row.rail == 1:
                prefix += 16
            if row.rail == 2:
                prefix += 56
        if rows[i].group != rows[i + 1].group:
            delta = total * 48 - 100 * prefix
            if delta < 0:
                delta = - delta
            if delta < best:
                best = delta
                split = i + 1
        i += 1
    y = 80
    i = 0
    while i < len(rows):
        if i == split:
            y = 80
        row = rows[i]
        if i > 0 and i != split and rows[i - 1].group != row.group:
            if rows[i - 1].rail == 1:
                y += 16
            if rows[i - 1].rail == 2:
                y += 36
            if rows[i - 1].height == 80:
                y += 16
        if row.rail == 2  and (i == 0 or i == split or rows[i - 1].group != row.group):
            y += 20
        offset = 0
        if row.height > 56:
            offset =(row.height - 56) // 2
        if row.height == 80:
            offset = 20
        side = - 1
        if i >= split:
            side = 1
        rows[i].side = side
        rows[i].y = y + offset
        y += row.height
        i += 1
    return 0


def nearest(host: Host, pin: c.Pin, parts: list[c.Part], pins: list[c.Pin], rows: list[Row], nets: list[g.Net], lookup: list[int]) -> int:
    group = pinGroup(pin, nets, lookup)
    id = - 1
    if pin.display_id >= 0 and pin.display_id < len(lookup):
        id = lookup[pin.display_id]
    owner = - 1
    if id >= 0:
        owner = nets[id].owner
    fallback = - 1
    i = 0
    while i < len(rows):
        row = rows[i]
        hub = pins[row.index]
        if pin.net_id == hub.net_id:
            return i
        if row.index == owner:
            fallback = i
        if row.group == group and fallback < 0:
            fallback = i
        i += 1
    return fallback


def partPin(part: int, number: int, parts: list[c.Part], pins: list[c.Pin]) -> c.Pin:
    index = - 1
    if number == 1:
        index = parts[part].pin1
    elif number == 2:
        index = parts[part].pin2
    if index >= 0 and index < len(pins) and pins[index].part == part and pins[index].number == number:
        return pins[index]
    i = 0
    while i < len(pins):
        pin = pins[i]
        if pin.part == part and pin.number == number:
            return pin
        i += 1
    return c.Pin(
        part=part,
        number=number,
        net=text.empty(),
        nc=True,
        display=text.empty(),
        net_id=- 1,
        display_id=- 1,
        raw_rail=0,
        rail=0,
        decoupling=False
    )


def depth(host: Host, pin: c.Pin, parts: list[c.Part], pins: list[c.Pin], nets: list[g.Net], lookup: list[int]) -> int:
    id = - 1
    if pin.display_id >= 0 and pin.display_id < len(lookup):
        id = lookup[pin.display_id]
    if id < 0:
        return 4096
    return nets[id].distance


def innerPin(host: Host, part: int, parts: list[c.Part], pins: list[c.Pin], nets: list[g.Net], lookup: list[int]) -> c.Pin:
    a = partPin(part, 1, parts, pins)
    b = partPin(part, 2, parts, pins)
    if a.raw_rail != 0 and b.raw_rail == 0:
        return b
    if b.raw_rail == 0 and depth(host, b, parts, pins, nets, lookup) < depth(host, a, parts, pins, nets, lookup):
        return b
    return a


def bridge(host: Host, part: int, parts: list[c.Part], pins: list[c.Pin], rows: list[Row], nets: list[g.Net], lookup: list[int]) -> bool:
    a = partPin(part, 1, parts, pins)
    b = partPin(part, 2, parts, pins)
    if a.raw_rail != 0 or b.raw_rail != 0:
        return False
    if depth(host, a, parts, pins, nets, lookup) != depth(host, b, parts, pins, nets, lookup):
        return False
    ai = nearest(host, a, parts, pins, rows, nets, lookup)
    bi = nearest(host, b, parts, pins, rows, nets, lookup)
    return ai >= 0 and bi >= 0 and ai != bi


def groundBranch(host: Host, part: int, parts: list[c.Part], pins: list[c.Pin], nets: list[g.Net], lookup: list[int]) -> bool:
    inner = innerPin(host, part, parts, pins, nets, lookup)
    outer = partPin(part, 3 - inner.number, parts, pins)
    if outer.raw_rail == 1:
        return True
    if outer.raw_rail == 2:
        return False
    found = False
    j = 0
    while j < len(parts):
        if parts[j].kind != 0 and j != part:
            a = partPin(j, 1, parts, pins)
            b = partPin(j, 2, parts, pins)
            otherRail = 0
            if a.net_id == outer.net_id:
                otherRail = b.raw_rail
            if b.net_id == outer.net_id:
                otherRail = a.raw_rail
            if otherRail == 2:
                return False
            if otherRail == 1:
                found = True
        j += 1
    return found


def branch(host: Host, part: int, parts: list[c.Part], pins: list[c.Pin], rows: list[Row], nets: list[g.Net], lookup: list[int], remaining: int) -> int:
    if remaining == 0:
        return 0
    inner = innerPin(host, part, parts, pins, nets, lookup)
    level = depth(host, inner, parts, pins, nets, lookup)
    offset = 0
    j = 0
    if level > 0:
        owner = nearest(host, inner, parts, pins, rows, nets, lookup)
        while j < len(parts):
            if parts[j].kind != 0 and j != part:
                previous = innerPin(host, j, parts, pins, nets, lookup)
                if depth(host, previous, parts, pins, nets, lookup) < level and nearest(host, previous, parts, pins, rows, nets, lookup) == owner:
                    outer = partPin(j, 3 - previous.number, parts, pins)
                    if outer.net_id == inner.net_id:
                        offset = branch(host, j, parts, pins, rows, nets, lookup, remaining - 1)
                        j = len(parts)
            j += 1
    count = 0
    rank = 0
    hasBridge = False
    grounded = groundBranch(host, part, parts, pins, nets, lookup)
    j = 0
    while j < len(parts):
        if parts[j].kind != 0:
            previous = innerPin(host, j, parts, pins, nets, lookup)
            a = partPin(j, 1, parts, pins)
            b = partPin(j, 2, parts, pins)
            if bridge(host, j, parts, pins, rows, nets, lookup):
                if a.net_id == inner.net_id or b.net_id == inner.net_id:
                    hasBridge = True
            elif previous.net_id == inner.net_id:
                count += 1
                otherGround = groundBranch(host, j, parts, pins, nets, lookup)
                if level > 0:
                    if j < part:
                        rank += 1
                elif (otherGround and not grounded)  or (otherGround == grounded and j < part):
                    rank += 1
        j += 1
    if level == 0:
        spacing = 20
        if hasBridge:
            spacing = 40
        offset -=(count - 1) * spacing
    return offset + rank * 40


def endpoint(host: Host, pin: c.Pin, parts: list[c.Part], pins: list[c.Pin], rows: list[Row], nets: list[g.Net], lookup: list[int]) -> Point:
    inner = innerPin(host, pin.part, parts, pins, nets, lookup)
    chosen = nearest(host, inner, parts, pins, rows, nets, lookup)
    if chosen < 0:
        return Point(
            x=100 + pin.number * 60,
            y=80 + pin.part * 60
        )
    row = rows[chosen]
    edge = 352
    if row.side == 1:
        edge = 532
    level = depth(host, inner, parts, pins, nets, lookup)
    if bridge(host, pin.part, parts, pins, rows, nets, lookup):
        target = nearest(host, pin, parts, pins, rows, nets, lookup)
        other = rows[target]
        reach = 50
        if level > 0:
            reach = 170
        return Point(
            x=edge + row.side * reach,
            y=other.y
        )
    hub = pins[row.index]
    count = 0
    j = 0
    while j < len(parts):
        if parts[j].kind != 0:
            attached = innerPin(host, j, parts, pins, nets, lookup)
            if attached.net_id == hub.net_id and not bridge(host, j, parts, pins, rows, nets, lookup):
                count += 1
        j += 1
    reach = 40
    if count > 1:
        reach = 60
    if pin.number != inner.number:
        reach = 120
    localRail = inner.raw_rail == 2 and inner.display_id != inner.net_id
    y = row.y + branch(host, pin.part, parts, pins, rows, nets, lookup, 128)
    if localRail:
        reach = 70
        if pin.number != inner.number:
            reach = 110
        y += 20
    x = edge + row.side *(reach + level * 60)
    return Point(
        x=x,
        y=y
    )


public def build(host: Host, parts: list[c.Part], pins: list[c.Pin]) -> list[Point] effects(host, managed_allocation):
    nets = g.build(host, parts, pins)
    lookup = netLookup(pins, nets)
    out: list[Point] = []
    ordered = collectRows(host, parts, pins, nets, lookup)
    _ = placeRows(ordered)
    i = 0
    while i < len(pins):
        pin = pins[i]
        point = Point(
            x=- 1,
            y=- 1
        )
        if parts[pin.part].kind == 0:
            j = 0
            while j < len(ordered):
                row = ordered[j]
                if row.index == i:
                    x = 352
                    if row.side == 1:
                        x = 532
                    point = Point(
                        x=x,
                        y=row.y
                    )
                j += 1
        else:
            point = endpoint(host, pin, parts, pins, ordered, nets, lookup)
        out.append(point)
        i += 1
    return out
