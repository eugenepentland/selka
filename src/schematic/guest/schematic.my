module schematic
import sexpr
import circuit
import validate
import ports
export Schematic
export build


record Schematic:
    nodes: list[sexpr.Node]
    parts: list[circuit.Part]
    pins: list[circuit.Pin]
    pinout: list[sexpr.Node]
    connections: list[ports.Port]


def build(host: Host, nodes: list[sexpr.Node], pinout: list[sexpr.Node], interface: list[sexpr.Node]) -> Result[Schematic, int] effects(host, managed_allocation):
    source_error = validate.source(host, nodes)
    if source_error != 0:
        return Err(source_error)
    parts = circuit.collectParts(host, nodes)?
    pinout_error = validate.pinoutCheck(host, pinout)
    if pinout_error != 0:
        return Err(pinout_error)
    pins = circuit.collectPins(host, nodes, parts, pinout)?
    model_error = validate.model(host, nodes, parts, pins, pinout)
    if model_error != 0:
        return Err(model_error)
    connections = ports.collect(host, nodes, interface)?
    ports_error = ports.validate(host, connections, pins)
    if ports_error != 0:
        return Err(ports_error)
    return Ok(Schematic(
        nodes=nodes,
        parts=parts,
        pins=pins,
        pinout=pinout,
        connections=connections
    ))
