module draw
import text
import io


public def rect(out: mut io.Output, x: int, y: int, w: int, h: int):
    text.write(mut out, b"<rect class=\"chip\" x=\"")
    text.decimal(mut out, x)
    text.write(mut out, b"\" y=\"")
    text.decimal(mut out, y)
    text.write(mut out, b"\" width=\"")
    text.decimal(mut out, w)
    text.write(mut out, b"\" height=\"")
    text.decimal(mut out, h)
    text.write(mut out, b"\" rx=\"6\"/>")
    return


public def line(out: mut io.Output, x1: int, y1: int, x2: int, y2: int):
    text.write(mut out, b"<line x1=\"")
    text.decimal(mut out, x1)
    text.write(mut out, b"\" y1=\"")
    text.decimal(mut out, y1)
    text.write(mut out, b"\" x2=\"")
    text.decimal(mut out, x2)
    text.write(mut out, b"\" y2=\"")
    text.decimal(mut out, y2)
    text.write(mut out, b"\"/>")
    return


public def labelStart(out: mut io.Output, x: int, y: int, anchor: int):
    text.write(mut out, b"<text x=\"")
    text.decimal(mut out, x)
    text.write(mut out, b"\" y=\"")
    text.decimal(mut out, y)
    text.write(mut out, b"\" text-anchor=\"")
    if anchor == 0:
        text.write(mut out, b"start")
    elif anchor == 1:
        text.write(mut out, b"middle")
    else:
        text.write(mut out, b"end")
    text.write(mut out, b"\">")
    return


public def labelEnd(out: mut io.Output):
    text.write(mut out, b"</text>")
    return


public def label(out: mut io.Output, x: int, y: int, anchor: int, value: text.Span):
    labelStart(mut out, x, y, anchor)
    text.escaped(mut out, value)
    return labelEnd(mut out)


public def symbol(out: mut io.Output, kind: int):
    text.write(mut out, b"<g class=\"symbol\">")
    line(mut out, - 20, 0, - 12, 0)
    line(mut out, 12, 0, 20, 0)
    if kind == 1:
        line(mut out, - 3, - 6, - 3, 6)
        line(mut out, 3, - 6, 3, 6)
        line(mut out, - 12, 0, - 3, 0)
        line(mut out, 3, 0, 12, 0)
    elif kind == 2:
        text.write(mut out, b"<rect x=\"-12\" y=\"-5\" width=\"24\" height=\"10\"/>")
    else:
        text.write(mut out, b"<path d=\"M -12 0 c 0,-7 6,-7 6,0 c 0,-7 6,-7 6,0 c 0,-7 6,-7 6,0 c 0,-7 6,-7 6,0\"/>")
    text.write(mut out, b"</g>")
    return
