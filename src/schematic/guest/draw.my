module draw
import text
export rect
export line
export labelStart
export labelEnd
export label
export symbol


def rect(host: Host, x: int, y: int, w: int, h: int) effects(host, managed_allocation):
    text.write(host, b"<rect class=\"chip\" x=\"")
    text.decimal(host, x)
    text.write(host, b"\" y=\"")
    text.decimal(host, y)
    text.write(host, b"\" width=\"")
    text.decimal(host, w)
    text.write(host, b"\" height=\"")
    text.decimal(host, h)
    text.write(host, b"\" rx=\"6\"/>")
    return


def line(host: Host, x1: int, y1: int, x2: int, y2: int) effects(host, managed_allocation):
    text.write(host, b"<line x1=\"")
    text.decimal(host, x1)
    text.write(host, b"\" y1=\"")
    text.decimal(host, y1)
    text.write(host, b"\" x2=\"")
    text.decimal(host, x2)
    text.write(host, b"\" y2=\"")
    text.decimal(host, y2)
    text.write(host, b"\"/>")
    return


def labelStart(host: Host, x: int, y: int, anchor: int) effects(host, managed_allocation):
    text.write(host, b"<text x=\"")
    text.decimal(host, x)
    text.write(host, b"\" y=\"")
    text.decimal(host, y)
    text.write(host, b"\" text-anchor=\"")
    if anchor == 0:
        text.write(host, b"start")
    elif anchor == 1:
        text.write(host, b"middle")
    else:
        text.write(host, b"end")
    text.write(host, b"\">")
    return


def labelEnd(host: Host) effects(host, managed_allocation):
    text.write(host, b"</text>")
    return


def label(host: Host, x: int, y: int, anchor: int, value: text.Span) effects(host, managed_allocation):
    labelStart(host, x, y, anchor)
    text.escaped(host, value)
    return labelEnd(host)


def symbol(host: Host, kind: int) effects(host, managed_allocation):
    text.write(host, b"<g class=\"symbol\">")
    line(host, - 20, 0, - 12, 0)
    line(host, 12, 0, 20, 0)
    if kind == 1:
        line(host, - 3, - 6, - 3, 6)
        line(host, 3, - 6, 3, 6)
        line(host, - 12, 0, - 3, 0)
        line(host, 3, 0, 12, 0)
    elif kind == 2:
        text.write(host, b"<rect x=\"-12\" y=\"-5\" width=\"24\" height=\"10\"/>")
    else:
        text.write(host, b"<path d=\"M -12 0 c 0,-7 6,-7 6,0 c 0,-7 6,-7 6,0 c 0,-7 6,-7 6,0 c 0,-7 6,-7 6,0\"/>")
    text.write(host, b"</g>")
    return
