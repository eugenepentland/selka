module circuit
import io
import text
import sexpr as s


public record Part:
    node: int
    ref: text.Span
    family: text.Span
    value: text.Span
    kind: int
    pin1: int
    pin2: int


public record Pin:
    part: int
    number: int
    net: text.Span
    nc: bool
    display: text.Span
    net_id: int
    display_id: int
    raw_rail: int
    rail: int
    decoupling: bool


def instanceForm(host: Host, nodes: list[s.Node], index: int) -> bool:
    return s.form(host, nodes, index, b"instance")


def blockForm(host: Host, nodes: list[s.Node], index: int) -> bool:
    return s.form(host, nodes, index, b"design-block")


def moduleForm(host: Host, nodes: list[s.Node], index: int) -> bool:
    return s.form(host, nodes, index, b"defmodule")


def pinForm(host: Host, nodes: list[s.Node], index: int) -> bool:
    return s.form(host, nodes, index, b"pin")


def ncForm(host: Host, nodes: list[s.Node], index: int) -> bool:
    return s.form(host, nodes, index, b"nc-ok")


def groupForm(host: Host, nodes: list[s.Node], index: int) -> bool:
    return s.form(host, nodes, index, b"group")


public def body(host: Host, nodes: list[s.Node]) -> int:
    i = 1
    while i < len(nodes):
        if blockForm(host, nodes, i):
            return i
        if moduleForm(host, nodes, i):
            i += 1
        else:
            i = s.at(nodes, i).next
    return - 1


public def title(host: Host, nodes: list[s.Node]) -> text.Span:
    b = body(host, nodes)
    if b < 0:
        return text.empty()
    return s.at(nodes, b + 2).span


def kind(host: Host, family: text.Span) -> int:
    if text.matches(host, family, b"cap-0402"):
        return 1
    if text.matches(host, family, b"cap-0603"):
        return 1
    if text.matches(host, family, b"res-0402"):
        return 2
    if text.matches(host, family, b"ind-0402"):
        return 3
    return 0


public def collectParts(host: Host, nodes: list[s.Node]) -> Result[list[Part], int]:
    out: list[Part] = []
    b = body(host, nodes)
    if b < 0:
        _ = io.issue(host, 10, 0, 0)
        return Err(10)
    i = b + 3
    while i < s.at(nodes, b).next:
        if instanceForm(host, nodes, i):
            ref = s.at(nodes, i + 2)
            spec = s.at(nodes, i + 3)
            if i + 3 >= s.at(nodes, i).next:
                _ = io.issue(host, 11, 0, ref.span.start)
                return Err(11)
            if not text.identifier(host, ref.span) or ref.kind != s.Kind.string:
                _ = io.issue(host, 11, 0, ref.span.start)
                return Err(11)
            family = spec.span
            value = text.empty()
            if spec.kind == s.Kind.list:
                family = s.at(nodes, i + 4).span
                value = s.at(nodes, i + 5).span
            if len(out) == 128:
                _ = io.issue(host, 5, 0, ref.span.start)
                return Err(5)
            j = 0
            while j < len(out):
                if text.equal(host, out[j].ref, ref.span):
                    _ = io.issue(host, 12, 0, ref.span.start)
                    return Err(12)
                j += 1
            out.append(Part(
                node=i,
                ref=ref.span,
                family=family,
                value=value,
                kind=kind(host, family),
                pin1=- 1,
                pin2=- 1
            ))
        i = s.at(nodes, i).next
    return Ok(out)


public def label(host: Host, pinout: list[s.Node], number: int) -> text.Span:
    i = 1
    while i < len(pinout):
        if pinForm(host, pinout, i) and text.number(host, s.at(pinout, i + 2).span) == number:
            return s.at(pinout, i + 3).span
        i += 1
    return text.empty()


public def collectPins(host: Host, nodes: list[s.Node], parts: list[Part], pinout: list[s.Node]) -> Result[list[Pin], int]:
    out: list[Pin] = []
    part = 0
    while part < len(parts):
        item = parts[part]
        f = s.at(nodes, item.node + 3).next
        while f < s.at(nodes, item.node).next:
            nc = ncForm(host, nodes, f)
            if pinForm(host, nodes, f) or nc:
                netindex = f + 2
                while netindex < s.at(nodes, f).next and s.at(nodes, netindex).kind != s.Kind.string:
                    netindex = s.at(nodes, netindex).next
                if netindex == s.at(nodes, f).next or netindex == f + 2:
                    _ = io.issue(host, 13, 0, s.at(nodes, f).span.start)
                    return Err(13)
                net = s.at(nodes, netindex).span
                if (not nc and not text.identifier(host, net)) or net.start == net.end:
                    _ = io.issue(host, 13, 0, net.start)
                    return Err(13)
                p = f + 2
                while p < netindex:
                    number = text.number(host, s.at(nodes, p).span)
                    valid = number == 1 or number == 2
                    if item.kind == 0:
                        named = label(host, pinout, number)
                        valid = named.end > named.start
                    if not valid:
                        _ = io.issue(host, 14, 0, s.at(nodes, p).span.start)
                        return Err(14)
                    j = 0
                    while j < len(out):
                        previous = out[j]
                        if previous.part == part and previous.number == number:
                            _ = io.issue(host, 15, 0, s.at(nodes, p).span.start)
                            return Err(15)
                        j += 1
                    if len(out) == 1024:
                        _ = io.issue(host, 5, 0, net.start)
                        return Err(5)
                    out.append(Pin(
                        part=part,
                        number=number,
                        net=net,
                        nc=nc,
                        display=net,
                        net_id=- 1,
                        display_id=- 1,
                        raw_rail=0,
                        rail=0,
                        decoupling=False
                    ))
                    p = s.at(nodes, p).next
            f = s.at(nodes, f).next
        part += 1
    return Ok(out)


public def group(host: Host, nodes: list[s.Node], reference: text.Span) -> text.Span:
    i = 1
    while i < len(nodes):
        if groupForm(host, nodes, i):
            child = i + 3
            while child < s.at(nodes, i).next:
                if text.equal(host, s.at(nodes, child).span, reference):
                    return s.at(nodes, i + 2).span
                child = s.at(nodes, child).next
        i += 1
    return text.empty()
# Netlisp per-pad supply branches fold only when the named host pad and trunk exist.


public def displayNet(host: Host, net: text.Span, parts: list[Part], pins: list[Pin]) -> text.Span effects(host):
    last = - 1
    previous = - 1
    i = net.start
    while i < net.end:
        if net.source[i] == 46:
            previous = last
            last = i
        i += 1
    if previous <= net.start or last <= previous + 1 or last + 1 == net.end:
        return net
    base = net
    base.end = previous
    ref = net
    ref.start = previous + 1
    ref.end = last
    number_span = net
    number_span.start = last + 1
    number = text.number(host, number_span)
    trunk = False
    named_host = False
    i = 0
    while i < len(pins):
        pin = pins[i]
        if not pin.nc:
            if text.equal(host, pin.net, base):
                trunk = True
            if pin.number == number and text.equal(host, pin.net, net) and text.equal(host, parts[pin.part].ref, ref):
                named_host = True
        i += 1
    if trunk and named_host:
        return base
    return net


def railKind(host: Host, span: text.Span) -> int:
    if text.matches(host, span, b"GND"):
        return 1
    if span.end - span.start >= 2 and span.source[span.start] == 86 and span.source[span.start + 1] == 95:
        return 2
    return 0


# Resolve textual identities and topology facts once. Layout and routing retain
# the original source spans for metadata, but compare these compact identities.
public def normalize(host: Host, parts: mut list[Part], pins: mut list[Pin]):
    i = 0
    while i < len(pins):
        pins[i].display = displayNet(host, pins[i].net, parts, pins)
        pins[i].raw_rail = railKind(host, pins[i].net)
        pins[i].rail = railKind(host, pins[i].display)
        if pins[i].number == 1:
            parts[pins[i].part].pin1 = i
        if pins[i].number == 2:
            parts[pins[i].part].pin2 = i
        raw_id = - 1
        j = 0
        while j < i:
            if raw_id < 0 and text.equal(host, pins[j].net, pins[i].net):
                raw_id = pins[j].net_id
            j += 1
        if raw_id < 0:
            raw_id = i
        pins[i].net_id = raw_id
        i += 1
    i = 0
    while i < len(pins):
        display_id = - 1
        j = 0
        while j < len(pins):
            if display_id < 0 and text.equal(host, pins[j].net, pins[i].display):
                display_id = pins[j].net_id
            j += 1
        j = 0
        while j < i:
            if display_id < 0 and text.equal(host, pins[j].display, pins[i].display):
                display_id = pins[j].display_id
            j += 1
        if display_id < 0:
            display_id = len(pins) + i
        pins[i].display_id = display_id
        i += 1
    i = 0
    while i < len(pins):
        pin = pins[i]
        if pin.raw_rail == 1 and parts[pin.part].kind == 1:
            other_index = parts[pin.part].pin1
            if other_index == i:
                other_index = parts[pin.part].pin2
            if other_index >= 0:
                other = pins[other_index]
                pins[i].decoupling = other.rail == 2 and other.raw_rail != 1 and other.display_id != other.net_id
        i += 1
    return
