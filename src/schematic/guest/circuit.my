module circuit
import io
import text
import sexpr as s
export Part
export Pin
export collectParts
export collectPins
export body
export title
export label
export group
export displayNet


record Part:
    node: int
    ref: text.Span
    family: text.Span
    value: text.Span
    kind: int


record Pin:
    part: int
    number: int
    net: text.Span
    nc: bool


def instanceForm(nodes: list[s.Node], index: int) -> bool:
    return s.form(nodes, index, b"instance")


def blockForm(nodes: list[s.Node], index: int) -> bool:
    return s.form(nodes, index, b"design-block")


def moduleForm(nodes: list[s.Node], index: int) -> bool:
    return s.form(nodes, index, b"defmodule")


def pinForm(nodes: list[s.Node], index: int) -> bool:
    return s.form(nodes, index, b"pin")


def ncForm(nodes: list[s.Node], index: int) -> bool:
    return s.form(nodes, index, b"nc-ok")


def groupForm(nodes: list[s.Node], index: int) -> bool:
    return s.form(nodes, index, b"group")


def body(nodes: list[s.Node]) -> int:
    i = 1
    while i < len(nodes):
        if blockForm(nodes, i):
            return i
        if moduleForm(nodes, i):
            i += 1
        else:
            i = s.at(nodes, i).next
    return - 1


def title(nodes: list[s.Node]) -> text.Span:
    b = body(nodes)
    if b < 0:
        return text.empty()
    return s.at(nodes, b + 2).span


def kind(family: text.Span) -> int:
    if text.matches(family, b"cap-0402"):
        return 1
    if text.matches(family, b"cap-0603"):
        return 1
    if text.matches(family, b"res-0402"):
        return 2
    if text.matches(family, b"ind-0402"):
        return 3
    return 0


def collectParts(nodes: list[s.Node]) -> Result[list[Part], int]:
    out: list[Part] = []
    b = body(nodes)
    if b < 0:
        _ = io.issue(10, 0, 0)
        return Err(10)
    i = b + 3
    while i < s.at(nodes, b).next:
        if instanceForm(nodes, i):
            ref = s.at(nodes, i + 2)
            spec = s.at(nodes, i + 3)
            if i + 3 >= s.at(nodes, i).next:
                _ = io.issue(11, 0, ref.span.start)
                return Err(11)
            if not text.identifier(ref.span) or ref.kind != s.Kind.string:
                _ = io.issue(11, 0, ref.span.start)
                return Err(11)
            family = spec.span
            value = text.empty()
            if spec.kind == s.Kind.list:
                family = s.at(nodes, i + 4).span
                value = s.at(nodes, i + 5).span
            if len(out) == 128:
                _ = io.issue(5, 0, ref.span.start)
                return Err(5)
            j = 0
            while j < len(out):
                if text.equal(out[j].ref, ref.span):
                    _ = io.issue(12, 0, ref.span.start)
                    return Err(12)
                j += 1
            out.append(Part(
                node=i,
                ref=ref.span,
                family=family,
                value=value,
                kind=kind(family)
            ))
        i = s.at(nodes, i).next
    return Ok(out)


def label(pinout: list[s.Node], number: int) -> text.Span:
    i = 1
    while i < len(pinout):
        if pinForm(pinout, i) and text.number(s.at(pinout, i + 2).span) == number:
            return s.at(pinout, i + 3).span
        i += 1
    return text.empty()


def collectPins(nodes: list[s.Node], parts: list[Part], pinout: list[s.Node]) -> Result[list[Pin], int]:
    out: list[Pin] = []
    part = 0
    while part < len(parts):
        item = parts[part]
        f = s.at(nodes, item.node + 3).next
        while f < s.at(nodes, item.node).next:
            nc = ncForm(nodes, f)
            if pinForm(nodes, f) or nc:
                netindex = f + 2
                while netindex < s.at(nodes, f).next and s.at(nodes, netindex).kind != s.Kind.string:
                    netindex = s.at(nodes, netindex).next
                if netindex == s.at(nodes, f).next or netindex == f + 2:
                    _ = io.issue(13, 0, s.at(nodes, f).span.start)
                    return Err(13)
                net = s.at(nodes, netindex).span
                if (not nc and not text.identifier(net)) or net.start == net.end:
                    _ = io.issue(13, 0, net.start)
                    return Err(13)
                p = f + 2
                while p < netindex:
                    number = text.number(s.at(nodes, p).span)
                    valid = number == 1 or number == 2
                    if item.kind == 0:
                        named = label(pinout, number)
                        valid = named.end > named.start
                    if not valid:
                        _ = io.issue(14, 0, s.at(nodes, p).span.start)
                        return Err(14)
                    j = 0
                    while j < len(out):
                        previous = out[j]
                        if previous.part == part and previous.number == number:
                            _ = io.issue(15, 0, s.at(nodes, p).span.start)
                            return Err(15)
                        j += 1
                    if len(out) == 1024:
                        _ = io.issue(5, 0, net.start)
                        return Err(5)
                    out.append(Pin(
                        part=part,
                        number=number,
                        net=net,
                        nc=nc
                    ))
                    p = s.at(nodes, p).next
            f = s.at(nodes, f).next
        part += 1
    return Ok(out)


def group(nodes: list[s.Node], reference: text.Span) -> text.Span:
    i = 1
    while i < len(nodes):
        if groupForm(nodes, i):
            child = i + 3
            while child < s.at(nodes, i).next:
                if text.equal(s.at(nodes, child).span, reference):
                    return s.at(nodes, i + 2).span
                child = s.at(nodes, child).next
        i += 1
    return text.empty()
# Netlisp per-pad supply branches fold only when the named host pad and trunk exist.


def displayNet(net: text.Span, parts: list[Part], pins: list[Pin]) -> text.Span:
    last = - 1
    previous = - 1
    i = net.start
    while i < net.end:
        if io.byte(net.file, i) == 46u8:
            previous = last
            last = i
        i += 1
    if previous <= net.start or last <= previous + 1 or last + 1 == net.end:
        return net
    base = net
    base.end = previous
    ref = net
    ref.start = previous + 1
    ref.end = last
    number_span = net
    number_span.start = last + 1
    number = text.number(number_span)
    trunk = False
    host = False
    i = 0
    while i < len(pins):
        pin = pins[i]
        if not pin.nc:
            if text.equal(pin.net, base):
                trunk = True
            if pin.number == number and text.equal(pin.net, net) and text.equal(parts[pin.part].ref, ref):
                host = True
        i += 1
    if trunk and host:
        return base
    return net
