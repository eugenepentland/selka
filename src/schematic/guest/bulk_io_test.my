module bulk_io_test
import io


# SCHEMATIC-BULK-1: the decimal fast path must spell the full signed range.
public def test_minimum_integer_decimal() -> bool:
    out = io.output()
    io.appendInt(mut out, -9223372036854775808)
    return not out.failed and out.buffer == b"-9223372036854775808"


public def test_negative_decimal_width_boundaries() -> bool:
    return io.decimalWidth(- 9) == 2 and io.decimalWidth(- 10) == 3 and io.decimalWidth(- 99) == 3 and io.decimalWidth(- 100) == 4 and io.decimalWidth(-9223372036854775808) == 20


# SCHEMATIC-BULK-1: refuse before appending any byte beyond the output budget.
public def test_output_limit_fails_without_oversized_buffer() -> bool:
    out = io.output()
    block = b"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    i = 0
    while i < 16384:
        io.append(mut out, block)
        i += 1
    if out.failed or len(out.buffer) != 4194304:
        return False
    io.appendByte(out, 120u8)
    return out.failed and len(out.buffer) == 4194304


public def test_decimal_uses_exact_remaining_capacity() -> bool:
    out = io.output()
    block = b"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    i = 0
    while i < 16383:
        io.append(mut out, block)
        i += 1
    tail = b"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    io.append(out, tail)
    if out.failed or len(out.buffer) != 4194301:
        return False
    io.appendInt(out, - 99)
    return not out.failed and len(out.buffer) == 4194304 and out.buffer[4194301:4194304] == b"-99"
