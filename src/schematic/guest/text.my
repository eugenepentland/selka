module text
import io
export Span
export equal
export matches
export number
export write
export escaped
export decimal
export empty
export identifier
export folded


record Span:
    file: int
    start: int
    end: int


def empty() -> Span:
    return Span(
        file=0,
        start=0,
        end=0
    )


def equal(a: Span, b: Span) -> bool:
    if a.end - a.start != b.end - b.start:
        return False
    i = 0
    while i < a.end - a.start:
        if io.byte(a.file, a.start + i) != io.byte(b.file, b.start + i):
            return False
        i += 1
    return True


def matches(a: Span, b: bytes) -> bool:
    if a.end - a.start != len(b):
        return False
    i = 0
    while i < a.end - a.start:
        if int(io.byte(a.file, a.start + i)) != b[i]:
            return False
        i += 1
    return True


def number(a: Span) -> int:
    value = 0
    i = a.start
    if i == a.end:
        return - 1
    while i < a.end:
        c = int(io.byte(a.file, i))
        if c < 48 or c > 57:
            return - 1
        if value > 1000000:
            return - 1
        value = value * 10 + c - 48
        i += 1
    return value


def write(text: bytes):
    i = 0
    while i < len(text):
        _ = io.put(u8(text[i]))
        i += 1
    return


def escaped(a: Span):
    i = a.start
    while i < a.end:
        c = io.byte(a.file, i)
        i += 1
        if c == 92u8 and i < a.end:
            c = io.byte(a.file, i)
            i += 1
            if c == 110u8:
                c = 10u8
            elif c == 114u8:
                c = 13u8
            elif c == 116u8:
                c = 9u8
        if c == 9u8:
            write(b"&#9;")
        elif c == 10u8:
            write(b"&#10;")
        elif c == 13u8:
            write(b"&#13;")
        elif c == 38u8:
            write(b"&amp;")
        elif c == 60u8:
            write(b"&lt;")
        elif c == 62u8:
            write(b"&gt;")
        elif c == 34u8:
            write(b"&quot;")
        else:
            _ = io.put(c)
    return


def decimal(value: int):
    if value < 0:
        _ = io.put(45u8)
        if value <= - 10:
            decimal(-((value + 9) // 10))
        _ = io.put(u8(((-(value + 1) % 10 + 1) % 10) + 48))
        return
    if value >= 10:
        decimal(value // 10)
    _ = io.put(u8(value % 10 + 48))
    return


def identifier(a: Span) -> bool:
    if a.start == a.end or a.end - a.start > 64:
        return False
    i = a.start
    while i < a.end:
        ch = io.byte(a.file, i)
        if ch < 33u8 or ch == 92u8:
            return False
        i += 1
    return True


def lower(ch: u8) -> u8:
    if ch >= 65u8 and ch <= 90u8:
        return ch + 32u8
    return ch


def folded(a: Span, b: Span) -> bool:
    if a.end - a.start != b.end - b.start:
        return False
    i = 0
    while i < a.end - a.start:
        if lower(io.byte(a.file, a.start + i)) != lower(io.byte(b.file, b.start + i)):
            return False
        i += 1
    return True
