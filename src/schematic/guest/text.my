module text
import io


public record Span:
    file: int
    start: int
    end: int


public def empty() -> Span effects():
    return Span(
        file=0,
        start=0,
        end=0
    )


public def equal(host: Host, a: Span, b: Span) -> bool effects(host):
    if a.end - a.start != b.end - b.start:
        return False
    i = 0
    while i < a.end - a.start:
        if io.byte(host, a.file, a.start + i) != io.byte(host, b.file, b.start + i):
            return False
        i += 1
    return True


public def matches(host: Host, a: Span, b: bytes) -> bool effects(host):
    if a.end - a.start != len(b):
        return False
    i = 0
    while i < a.end - a.start:
        if int(io.byte(host, a.file, a.start + i)) != b[i]:
            return False
        i += 1
    return True


public def number(host: Host, a: Span) -> int effects(host):
    value = 0
    i = a.start
    if i == a.end:
        return - 1
    while i < a.end:
        c = int(io.byte(host, a.file, i))
        if c < 48 or c > 57:
            return - 1
        if value > 1000000:
            return - 1
        value = value * 10 + c - 48
        i += 1
    return value


public def write(host: Host, text: bytes) effects(host):
    i = 0
    while i < len(text):
        _ = io.put(host, u8(text[i]))
        i += 1
    return


public def escaped(host: Host, a: Span) effects(host, managed_allocation):
    i = a.start
    while i < a.end:
        c = io.byte(host, a.file, i)
        i += 1
        if c == 92u8 and i < a.end:
            c = io.byte(host, a.file, i)
            i += 1
            if c == 110u8:
                c = 10u8
            elif c == 114u8:
                c = 13u8
            elif c == 116u8:
                c = 9u8
        if c == 9u8:
            write(host, b"&#9;")
        elif c == 10u8:
            write(host, b"&#10;")
        elif c == 13u8:
            write(host, b"&#13;")
        elif c == 38u8:
            write(host, b"&amp;")
        elif c == 60u8:
            write(host, b"&lt;")
        elif c == 62u8:
            write(host, b"&gt;")
        elif c == 34u8:
            write(host, b"&quot;")
        else:
            _ = io.put(host, c)
    return


public def decimal(host: Host, value: int) effects(host):
    if value < 0:
        _ = io.put(host, 45u8)
        if value <= - 10:
            decimal(host, -((value + 9) // 10))
        _ = io.put(host, u8(((-(value + 1) % 10 + 1) % 10) + 48))
        return
    if value >= 10:
        decimal(host, value // 10)
    _ = io.put(host, u8(value % 10 + 48))
    return


public def identifier(host: Host, a: Span) -> bool effects(host):
    if a.start == a.end or a.end - a.start > 64:
        return False
    i = a.start
    while i < a.end:
        ch = io.byte(host, a.file, i)
        if ch < 33u8 or ch == 92u8:
            return False
        i += 1
    return True


def lower(ch: u8) -> u8:
    if ch >= 65u8 and ch <= 90u8:
        return ch + 32u8
    return ch


public def folded(host: Host, a: Span, b: Span) -> bool effects(host):
    if a.end - a.start != b.end - b.start:
        return False
    i = 0
    while i < a.end - a.start:
        if lower(io.byte(host, a.file, a.start + i)) != lower(io.byte(host, b.file, b.start + i)):
            return False
        i += 1
    return True
