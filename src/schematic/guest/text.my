module text
import io


public record Span:
    file: int
    source: bytes
    start: int
    end: int


public def empty() -> Span:
    return Span(
        file=0,
        source=b"",
        start=0,
        end=0
    )


public def equal(host: Host, a: Span, b: Span) -> bool effects(host):
    if a.end - a.start != b.end - b.start:
        return False
    i = 0
    while i < a.end - a.start:
        if a.source[a.start + i] != b.source[b.start + i]:
            return False
        i += 1
    return True


public def matches(host: Host, a: Span, b: bytes) -> bool effects(host):
    if a.end - a.start != len(b):
        return False
    i = 0
    while i < a.end - a.start:
        if a.source[a.start + i] != b[i]:
            return False
        i += 1
    return True


public def number(host: Host, a: Span) -> int effects(host):
    value = 0
    i = a.start
    if i == a.end:
        return - 1
    while i < a.end:
        c = a.source[i]
        if c < 48 or c > 57:
            return - 1
        if value > 1000000:
            return - 1
        value = value * 10 + c - 48
        i += 1
    return value


public def write(out: mut io.Output, value: bytes):
    return io.append(mut out, value)


public def escaped(out: mut io.Output, a: Span):
    i = a.start
    while i < a.end:
        c = u8(a.source[i])
        i += 1
        if c == 92u8 and i < a.end:
            c = u8(a.source[i])
            i += 1
            if c == 110u8:
                c = 10u8
            elif c == 114u8:
                c = 13u8
            elif c == 116u8:
                c = 9u8
        if c == 9u8:
            write(mut out, b"&#9;")
        elif c == 10u8:
            write(mut out, b"&#10;")
        elif c == 13u8:
            write(mut out, b"&#13;")
        elif c == 38u8:
            write(mut out, b"&amp;")
        elif c == 60u8:
            write(mut out, b"&lt;")
        elif c == 62u8:
            write(mut out, b"&gt;")
        elif c == 34u8:
            write(mut out, b"&quot;")
        else:
            io.appendByte(mut out, c)
    return


public def decimal(out: mut io.Output, value: int):
    return io.appendInt(mut out, value)


public def identifier(host: Host, a: Span) -> bool effects(host):
    if a.start == a.end or a.end - a.start > 64:
        return False
    i = a.start
    while i < a.end:
        ch = u8(a.source[i])
        if ch < 33u8 or ch == 92u8:
            return False
        i += 1
    return True


def lower(ch: u8) -> u8:
    if ch >= 65u8 and ch <= 90u8:
        return ch + 32u8
    return ch


public def folded(host: Host, a: Span, b: Span) -> bool effects(host):
    if a.end - a.start != b.end - b.start:
        return False
    i = 0
    while i < a.end - a.start:
        if lower(u8(a.source[a.start + i])) != lower(u8(b.source[b.start + i])):
            return False
        i += 1
    return True
