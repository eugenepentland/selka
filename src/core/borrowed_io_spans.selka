import bytes
import filesystem
import strings

func expanded(data: bytes) -> int[]:
    return bytes.to_list(data)


func tail(data: bytes) -> int[]:
    return bytes.to_list(data[1:])


func emit(out: Stream, data: bytes, text: str):
    write(out, data)
    write(out, text[:2])
    print(out, text[:2], "!", sep="")


func roundtrip(fs: Filesystem, path: str, data: bytes) -> bool fails str:
    _ = try fs.write_file(path, data)
    const saved = try fs.read_file(path)
    return saved == data


func save_literal(fs: Filesystem, path: str) -> bool fails str:
    _ = try fs.write_file(path, b"xyz")
    const saved = try fs.read_file(path)
    return saved == b"xyz"


func file_chunk(fs: Filesystem, path: str, data: bytes) -> int:
    mut written = 0
    with fs.open(path, "wb") as file:
        written = file.write(data[1:3])
    return written


func main(out: Stream) -> int fails str:
    const data = b"\x00\xffab"
    mut values = expanded(data)
    values[0] = 7
    print(out, values[0], data[0], values[1], len(tail(data)), len(expanded(b"")))
    emit(out, data[:2], "λx")
    emit(out, b"", "")
    print(out, strings.lstrip_chars("000120", "0"))
    print(out, strings.strip_chars(" xx ", " x"), "tail", sep="|")
    const fs = filesystem.memory()
    const same = try roundtrip(fs, "data", data)
    const written = file_chunk(fs, "chunk", data)
    const literal = try save_literal(fs, "literal")
    print(out, same, written, literal)
    return 0
