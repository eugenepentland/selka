# spec-case: AUGMENTED-FIELD-1
record AugmentedOwner:
    items: str[]
    label: str


record AugmentedParent:
    child: AugmentedOwner
    rows: AugmentedOwner[]
    mapping: dict[int, AugmentedOwner]


record InlinedCounter:
    items: int[]
    number: int


func replace_counter_items(mut counter: InlinedCounter) -> int[]:
    counter.items = [50]
    counter.number = 7
    return [2]


func owner(seed: int) -> AugmentedOwner:
    return AugmentedOwner(items=["item-" + str(seed)], label="label-" + str(seed))


func selected(mut events: int[]) -> int:
    events.append(1)
    return -1


func values(mut events: int[], out: Stream) -> str[]:
    events.append(2)
    out.print("rhs")
    return ["extra-" + str(len(events))]


func main(args: str[], out: Stream) -> int:
    mut parent = AugmentedParent(child=owner(0), rows=[owner(1)], mapping={3: owner(3)})
    const before = parent.copy()
    mut events: int[] = []
    if len(args) > 0:
        if args[0] == "bounds":
            parent.rows[-2].items += values(mut events, out)
        else:
            parent.mapping[9].items += values(mut events, out)
        return 9
    parent.rows[selected(mut events)].items += values(mut events, out)
    assert events == [1, 2]
    assert parent.rows[0].items == ["item-1", "extra-2"]
    assert before.rows[0].items == ["item-1"]
    parent.child.items += ["nested"]
    parent.mapping[3].items += ["mapped"]
    parent.child.items += parent.child.items
    assert parent.child.items == ["item-0", "nested", "item-0", "nested"]
    assert parent.mapping[3].items == ["item-3", "mapped"]
    assert before.child.items == ["item-0"] and before.mapping[3].items == ["item-3"]
    mut explicit = owner(8)
    mut other = owner(9)
    explicit.items.extend(explicit.items)
    explicit.items.extend(other.items)
    assert explicit.items == ["item-8", "item-8", "item-9"]
    assert other.items == ["item-9"]
    parent.child.items.extend(parent.child.items)
    assert len(parent.child.items) == 8
    parent.child.items.extend(parent.mapping[3].items)
    assert len(parent.child.items) == 10 and parent.child.items[9] == "mapped"
    assert parent.mapping[3].items == ["item-3", "mapped"]
    mut maybe: AugmentedOwner? = Some(owner(4))
    if maybe is None:
        return 8
    maybe.items += ["optional"]
    assert maybe.items == ["item-4", "optional"]
    const independent = parent.rows[0].items.copy()
    parent.rows.clear()
    assert independent == ["item-1", "extra-2"]
    assert parent.child.label == "label-0" and before.rows[0].label == "label-1"
    # Inlining appends the result/writeback aggregate after its earlier-numbered
    # projections. Ownership must propagate through both levels of those reads.
    mut counter = InlinedCounter(items=[1], number=1)
    mut added = replace_counter_items(mut counter)
    counter.items += added
    assert counter.items == [50, 2] and counter.number == 7
    mut method_counter = InlinedCounter(items=[3], number=2)
    mut method_added = replace_counter_items(mut method_counter)
    method_counter.items.extend(method_added)
    assert method_counter.items == [50, 2] and method_counter.number == 7
    out.print("field augmented preserved")
    return 0
