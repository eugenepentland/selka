public enum InvalidQuantity:
    outside_range


public result Parsed:
    ok: Count,
    err: InvalidQuantity


public domain Count: u16:
    func parse(value: int) -> Parsed effects():
        if value < 0 or value > 99:
            return Err(InvalidQuantity.outside_range)
        return Ok(wrap[Count](u16(value)))
    func number(value: Count) -> u16 effects():
        return unwrap(value)
