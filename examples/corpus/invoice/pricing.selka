import catalog
import delivery
import handling
import money
import packaging
import quantity

record Line:
    product: catalog.Product
    count: quantity.Count


record Totals:
    gross: money.Cents
    discount: money.Cents
    tax: money.Cents
    delivery: money.Cents
    packaging: money.Cents
    handling: money.Cents
    total: money.Cents
    items: u16


public record Receipt:
    gross: int
    discount: int
    tax: int
    delivery: int
    packaging: int
    handling: int
    total: int
    items: u16


public result Invoice:
    ok: Receipt,
    err: quantity.InvalidQuantity


conversion func receipt(totals: Totals) -> Receipt:
    return Receipt(gross=totals.gross.value, discount=totals.discount.value, tax=totals.tax.value, delivery=totals.delivery.value, packaging=totals.packaging.value, handling=totals.handling.value, total=totals.total.value, items=totals.items)


public func calculate(books: int, cables: int, adapters: int) -> Invoice:
    const book_count = try quantity.parse(books)
    const book_line = Line(product=catalog.Product.book, count=book_count)
    const cable_count = try quantity.parse(cables)
    const cable_line = Line(product=catalog.Product.cable, count=cable_count)
    const adapter_count = try quantity.parse(adapters)
    const adapter_line = Line(product=catalog.Product.adapter, count=adapter_count)
    const lines = FixedArray[Line, 3]([book_line, cable_line, adapter_line])
    mut gross = money.make(0u64)
    mut items = 0u16
    mut index = 0
    while index < len(lines):
        mut line = lines[index]
        mut count = line.count.value
        mut cents = catalog.price(line.product).value * int(count)
        gross = money.add(gross, money.make(u64(cents)))
        items += count
        index += 1
    mut discount = 0
    if items >= 10u16:
        discount = divtrunc(gross.value, 10)
    mut taxable = gross.value - discount
    mut tax = divtrunc(taxable * 750 + 5000, 10000)
    mut shipping = delivery.fee(int(items))
    mut packing = packaging.fee(int(items))
    mut service = handling.fee(int(items))
    mut totals = Totals(gross=gross, discount=money.make(u64(discount)), tax=money.make(u64(tax)), delivery=money.make(u64(shipping)), packaging=money.make(u64(packing)), handling=money.make(u64(service)), total=money.make(u64(taxable + tax + shipping + packing + service)), items=items)
    return Ok(receipt(totals))
