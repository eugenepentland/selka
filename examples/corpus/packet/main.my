module main
import inputs
import decoder
import model

def main() -> int:
    packet = inputs.bytes()
    size = inputs.size()
    match decoder.decode(packet, size):
        case model.Decoded.err(error):
            return model.error_code(error)
        case model.Decoded.ok(message):
            match message:
                case model.Message.heartbeat(sequence):
                    return int(sequence)
                case model.Message.reading(reading):
                    return int(reading.sequence) * 4294967296 + int(reading.value)
