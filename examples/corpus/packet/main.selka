import decoder
import inputs
import model

func main() -> int:
    mut packet = inputs.bytes()
    mut size = inputs.size()
    match decoder.decode(packet, size):
        case err(error):
            return model.error_code(error)
        case ok(message):
            match message:
                case heartbeat(value=sequence):
                    return int(sequence)
                case reading(value=reading):
                    return int(reading.sequence) * 4294967296 + int(reading.value)
