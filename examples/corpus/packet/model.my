
public record Reading:
    sequence: u8
    value: u32


public enum Message:
    heartbeat(value: u8)
    reading(value: Reading)


public enum Error:
    frame_length
    version
    kind
    payload_length
    checksum


public result Decoded:
    ok: Message,
    err: Error


public func error_code(error: Error) -> int effects():
    mut codes: [Error]int = {Error.frame_length: -1, Error.version: -2, Error.kind: -3, Error.payload_length: -4, Error.checksum: -5}
    return codes[error]
