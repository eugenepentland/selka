module model
export Reading
export Message
export Error
export Decoded
export error_code


class Reading:
    sequence: u8
    value: u32


union Message:
    heartbeat: u8,
    reading: Reading


enum Error:
    frame_length,
    version,
    kind,
    payload_length,
    checksum


result Decoded:
    ok: Message,
    err: Error


def error_code(error: Error) -> int:
    codes: [Error]int = {Error.frame_length: -1, Error.version: -2, Error.kind: -3, Error.payload_length: -4, Error.checksum: -5}
    return codes[error]
