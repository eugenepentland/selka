module model

public record Reading:
    sequence: u8
    value: u32


public union Message:
    heartbeat: u8,
    reading: Reading


public enum Error:
    frame_length,
    version,
    kind,
    payload_length,
    checksum


public result Decoded:
    ok: Message,
    err: Error


public def error_code(error: Error) -> int effects():
    codes: [Error]int = {Error.frame_length: -1, Error.version: -2, Error.kind: -3, Error.payload_length: -4, Error.checksum: -5}
    return codes[error]
