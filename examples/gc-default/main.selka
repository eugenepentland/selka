# Assignment preserves a list value; a marked call changes only its receiver.
func add_pin(mut pins: int[], pin: int):
    pins.append(pin)


func main() -> int:
    mut pins: int[] = []
    mut alias = pins
    for pin in range(100):
        add_pin(mut alias, pin)
    alias[0] = 42
    assert len(pins) == 0
    return alias[0] + len(alias)
