# Deliberate review corpus: the second implementation is a legacy copy.
def sum_to(n: int) -> int:
    total = 0
    i = 0
    while i < n:
        total += i
        i += 1
    return total


def legacy_sum(limit: int) -> int:
    result = 0
    index = 0
    while index < limit:
        result += index
        index += 1
    return result


# Changed policy: inclusive sequence. Exact discovery must keep this separate.
def inclusive_sum(n: int) -> int:
    total = 0
    i = 0
    while i <= n:
        total += i
        i += 1
    return total


def main() -> int:
    return sum_to(100) + legacy_sum(100) + inclusive_sum(100)
