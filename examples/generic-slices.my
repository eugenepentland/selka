fn fill<T: copy>(values: &mut []T, replacement: T) -> u64 {
    let mut index = 0u64;
    while index < len_slice(values) {
        write_slice(values, index, replacement);
        index += 1u64;
    }
    return index;
}
fn sum<T: integer>(values: &[]T) -> T {
    let mut total = cast<T>(0);
    let mut index = 0u64;
    while index < len_slice(values) {
        total += read_slice(values, index);
        index += 1u64;
    }
    return total;
}
fn main() -> i64 {
    let mut values = new [3]i8 [2i8, 3i8, 5i8];
    let original = values;
    borrow mut values[1..3] as selected { discard fill::<i8>(selected, 4i8); }
    borrow values[0..3] as all { return cast<i64>(sum::<i8>(all)) + cast<i64>(original[1]); }
}
