result Time:
    ok: int,
    err: int


result Random:
    ok: u64,
    err: int


def sample(clock: Clock, rng: Entropy) -> Time effects(clock, random):
    now = clock_now[Time](clock)?
    _ = random_u64[Random](rng)?
    return Ok(now)


def main(clock: Clock, rng: Entropy) -> int noio:
    match sample(clock, rng):
        case Time.ok(now):
            return now
        case Time.err(code):
            return code
