buffer B: i64;
result Open {
    ok: B,
    err: i64
}
result Status {
    ok: bool,
    err: i64
}
result Work {
    ok: i64,
    err: i64
}
fn reset < T: copy >(region: allocator) -> Status noalloc {
    return reset_arena<Status>(region);
}
fn work < T: integer >(heap: allocator) -> Work {
    arena heap as scratch {
        let copy = scratch;
        let mut buffer = try acquire_buffer<Open>(scratch, 8);
        discard try append_buffer<Status>(buffer, 7);
        borrow buffer[0..1] as view {
            match reset::< T >(copy) {
                Status.ok(discard) => {
                    return new Work.err(90);
                },
                Status.err(code) => {
                    if code != 1 {
                        return new Work.err(91);
                    }
                }
            }
            if read_slice(view, 0) != 7 {
                return new Work.err(92);
            }
        }
        discard buffer;
        arena scratch as child {
            discard try reset::< T >(child);
            match reset::< T >(scratch) {
                Status.ok(discard) => {
                    return new Work.err(93);
                },
                Status.err(code) => {
                    if code != 2 {
                        return new Work.err(94);
                    }
                }
            }
        }
        discard try reset::< T >(copy);
        let replacement = try acquire_buffer<Open>(scratch, 3);
        let value = cast<i64>(capacity_buffer(replacement));
        discard replacement;
        discard try reset::< T >(scratch);
        return new Work.ok(value);
    }
}
fn main(heap: allocator) -> i64 {
    match work::< u8 >(heap) {
        Work.ok(value) => {
            return value;
        },
        Work.err(code) => {
            return code;
        }
    }
}
