record Box[T]:
    value: T


union Slot[T]:
    none,
    some: T


def pack[T](x: T) -> Box[T]:
    return Box[T](value=x)


def extract[T](box: Box[T]) -> T:
    return box.value


def slot[T](x: T) -> Slot[T]:
    return Slot.some(x)


def choose[T](x: Slot[T], fallback: T) -> T:
    match x:
        case Slot.none:
            return fallback
        case Slot.some(value):
            return value


def main() -> int:
    return extract[int](pack[int](choose[int](slot[int](7), 0)))
