module main

public record Stats:
    sum: int
    squares: int


public def analyze(values: [4]int) -> Stats effects():
    sum = 0
    squares = 0
    i = 0u64
    while i < 4u64:
        n = values[i]
        sum += n
        squares += n * n
        i += 1u64
    return Stats(sum=sum, squares=squares)


def main() -> int:
    return 0
