
public record Stats:
    sum: int
    squares: int


public func analyze(values: FixedArray[int, 4]) -> Stats effects():
    mut sum = 0
    mut squares = 0
    mut i = 0u64
    while i < 4u64:
        mut n = values[i]
        sum += n
        squares += n * n
        i += 1u64
    return Stats(sum=sum, squares=squares)


func main() -> int:
    return 0
