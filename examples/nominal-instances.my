class Box[T]:
    value: T


union Slot[T]:
    none,
    some: T


def main() -> i64:
    original = Box[i64](value=7)
    changed = original
    changed.value = 9
    slot: Slot[Box[i64]] = Slot.some(changed)
    match slot:
        case Slot.none:
            return 0
        case Slot.some(box):
            return original.value + box.value
