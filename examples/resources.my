resource File: filesystem

result Open:
    ok: File,
    err: i64


class Failure:
    code: i64
    resource: File


result Finish:
    ok: bool,
    err: Failure


def retry(file: File) -> Finish effects(filesystem):
    match complete_resource[Finish](file):
        case Finish.ok(done):
            return Ok(done)
        case Finish.err(failure):
            return complete_resource[Finish](failure.resource)


def main(fs: filesystem_cap) -> i64 noalloc:
    request: [1]u8 = [42u8]
    match acquire_resource[Open](fs, request):
        case Open.ok(file):
            match retry(file):
                case Finish.ok(done):
                    if done:
                        return 7
                    else:
                        return 0
                case Finish.err(failure):
                    return failure.code
        case Open.err(code):
            return code
