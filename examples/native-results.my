enum ArithmeticError:
    zero


result Quotient:
    ok: int,
    err: ArithmeticError


result Total:
    err: ArithmeticError,
    ok: int


def divide(n: int, d: int) -> Quotient:
    if d == 0:
        return Err(ArithmeticError.zero)
    return Ok(divtrunc(n, d))


def calculate(denominator: int) -> Total:
    return Ok(10 + divide(21, denominator)?)


def handle(outcome: Total) -> int:
    match outcome:
        case Total.ok(value):
            return value
        case Total.err(_):
            return 3


def main() -> int:
    return handle(calculate(3)) + handle(calculate(0))
