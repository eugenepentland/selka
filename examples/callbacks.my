record Pair:
    values: FixedArray[int, 2]


func build(n: int) -> Pair effects():
    return Pair(values=FixedArray[int, 2]([n, n + 1]))


func apply(callback: func(int) -> Pair effects(), n: int) -> Pair:
    return callback(n)


func identity(callback: func(int) -> Pair effects()) -> func(int) -> Pair effects():
    return callback


func main() -> int:
    mut callback = identity(build)
    mut a = apply(callback, 7)
    mut b = callback(9)
    return a.values[0] + b.values[1]
