record Pair:
    values: [2]int


def build(n: int) -> Pair effects():
    return Pair(values=[n, n + 1])


def apply(callback: def(int) -> Pair effects(), n: int) -> Pair:
    return callback(n)


def identity(callback: def(int) -> Pair effects()) -> def(int) -> Pair effects():
    return callback


def main() -> int:
    callback = identity(build)
    a = apply(callback, 7)
    b = callback(9)
    return a.values[0] + b.values[1]
