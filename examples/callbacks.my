class Pair:
    values: [2]i64


def build(n: i64) -> Pair effects():
    return Pair(values=[n, n + 1])


def apply(callback: def(i64) -> Pair effects(), n: i64) -> Pair:
    return callback(n)


def identity(callback: def(i64) -> Pair effects()) -> def(i64) -> Pair effects():
    return callback


def main() -> i64:
    callback = identity(build)
    a = apply(callback, 7)
    b = callback(9)
    return a.values[0] + b.values[1]
