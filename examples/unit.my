def set(values: list[int], index: int, replacement: int):
    values[index] = replacement


def countdown(n: int) effects():
    if n == 0:
        return
    countdown(n - 1)


def apply(callback: def(int) -> None effects(), value: int):
    callback(value)


def main() -> int:
    values: list[int] = [0]
    set(values, 0, 42)
    apply(countdown, 3)
    return values[0]
