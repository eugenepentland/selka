fn set(values: List<i64>, index: i64, replacement: i64) -> unit {
    values[index] = replacement;
}
fn countdown(n: i64) -> unit effects() {
    if n == 0 {
        return;
    }
    countdown(n - 1);
}
fn apply(callback: fn(i64) -> unit effects(), value: i64) -> unit {
    callback(value);
}
fn main() -> i64 {
    let values: List<i64> = [0];
    set(values, 0, 42);
    apply(countdown, 3);
    return values[0];
}
