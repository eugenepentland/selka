def set(values: List[i64], index: i64, replacement: i64):
    values[index] = replacement


def countdown(n: i64) effects():
    if n == 0:
        return
    countdown(n - 1)


def apply(callback: fn(i64) -> None effects(), value: i64):
    callback(value)


def main() -> i64:
    values: List[i64] = [0]
    set(values, 0, 42)
    apply(countdown, 3)
    return values[0]
