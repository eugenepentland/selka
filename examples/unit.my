fn set(value: &mut i64, replacement: i64) -> unit {
    write_ref(value, replacement);
}

fn countdown(n: i64) -> unit effects() {
    if n == 0 { return; }
    countdown(n - 1);
}

fn apply(callback: fn(i64) -> unit effects(), value: i64) -> unit {
    callback(value);
}

fn ignore<T: copy>(value: T) -> unit {
    discard value;
}

fn main() -> i64 {
    let mut value = 0;
    borrow mut value as edit {
        set(edit, 42);
    }
    apply(countdown, 3);
    ignore::<i64>(value);
    return value;
}
