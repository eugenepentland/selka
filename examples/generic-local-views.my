buffer B: i64;
result A {
    ok: B,
    err: i64
}
result S {
    ok: bool,
    err: i64
}
result R {
    ok: i64,
    err: i64
}
fn tail < T: copy >(a: &mut [3]i64) -> &mut []i64 from a {
    borrow mut a[1..3] as s {
        return s;
    }
}
fn arrays < T: integer >(n: T) -> i64 {
    let mut a = new [3]i64[1, 2, 3];
    let original = a;
    borrow mut a as whole {
        borrow mut tail::< T >(whole) as s {
            write_slice(s, 0, cast<i64>(n));
        }
    }
    borrow a[0..3] as s {
        borrow s[1..2] as child {
            return read_slice(child, 0) + original[1];
        }
    }
}
fn buffers < T: integer >(heap: allocator, n: T) -> R {
    let mut b = try acquire_buffer<A>(heap, 3);
    discard try append_buffer<S>(b, 1);
    discard try append_buffer<S>(b, 2);
    borrow mut b[0..len_buffer(b)] as s {
        write_slice(s, 0, cast<i64>(n));
    }
    return new R.ok(read_buffer(b, 0) + read_buffer(b, 1));
}
fn main(heap: allocator) -> i64 {
    match buffers::< u8 >(heap, 9u8) {
        R.ok(n) => {
            return n + arrays::< i8 >(9i8);
        },
        R.err(e) => {
            return e;
        }
    }
}
