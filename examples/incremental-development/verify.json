{
  "version": 2,
  "policy": "incremental-example-v1",
  "steps": [
    {
      "id": "invoice",
      "kind": "test",
      "complete": true,
      "inputs": ["invoice/*.my"],
      "tools": ["mylang"],
      "commands": [["mylang", "run-project", "--print-result", "invoice/main.my"]],
      "expect_stdout": "42\n"
    },
    {
      "id": "independent",
      "kind": "test",
      "complete": true,
      "inputs": ["independent/*.my"],
      "tools": ["mylang"],
      "commands": [["mylang", "run-project", "--print-result", "independent/main.my"]],
      "expect_stdout": "7\n"
    }
  ]
}
