fn collatz_steps(start: i64) -> i64 {
    let mut n = start;
    let mut steps = 0;
    while n > 1 {
        if n % 2 == 0 {
            n = n / 2;
        } else {
            n = 3 * n + 1;
        }
        steps += 1;
    }
    return steps;
}

fn main() -> i64 {
    return collatz_steps(27);
}
