buffer B:i64;
result A{ok:B,err:i64}
result S{ok:bool,err:i64}
fn first(x:&mut []i64)->&mut []i64 from x {
    borrow mut x[0..1] as selected { return selected; }
}
fn change(left:&mut []i64,right:&mut []i64)->i64 {
    borrow mut first(left) as selected { write_slice(selected,0,7); }
    write_slice(right,0,9);
    return read_slice(left,0)+read_slice(right,0);
}
fn main(heap:allocator)->i64 {
    let mut a=new [4]i64 [1,2,3,4];
    let saved=a;
    borrow mut a[1..4] as view {
        split view at 1 as left,right {
            discard change(left,right);
            split right at 0 as empty,tail { discard len_slice(empty); write_slice(tail,1,5); }
        }
    }
    match acquire_buffer<A>(heap,4) {
        A.ok(acquired)=>{
            let mut b=acquired;
            acknowledge resize_buffer<S>(b,4,1);
            borrow mut b[1..4] as view {
                split view at 1 as left,right { discard change(left,right); }
            }
            return a[1]+a[2]+a[3]+saved[1]+read_buffer(b,1)+read_buffer(b,2);
        },
        A.err(e)=>{return e;}
    }
}
