enum ArithmeticError { zero }
result Quotient { ok: i64, err: ArithmeticError }
result Total { err: ArithmeticError, ok: i64 }

fn divide(n: i64, d: i64) -> Quotient {
    if d == 0 { return new Quotient.err(new ArithmeticError.zero); }
    return new Quotient.ok(n / d);
}

fn calculate(denominator: i64) -> Total {
    let mut value = 10;
    value = value + divide(21, denominator)?;
    return new Total.ok(value);
}

fn handle(outcome: Total) -> i64 {
    match outcome {
        Total.ok(value) => { return value; },
        Total.err(_) => { return 3; }
    }
}

fn main() -> i64 {
    return handle(calculate(3)) + handle(calculate(0));
}
