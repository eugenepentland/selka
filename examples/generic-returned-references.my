fn tail<T: copy>(values: &mut []T) -> &mut []T from values {
    borrow mut values[1..len_slice(values)] as rest { return rest; }
}
fn forward<U: copy>(values: &mut []U) -> &mut []U from values {
    borrow mut tail::<U>(values) as rest { return rest; }
}
fn same<T: copy>(value: &T) -> &T from value { return value; }
fn main() -> i64 {
    let mut values = new [3]i8 [1i8, 2i8, 3i8];
    let original = values;
    borrow mut values[0..3] as all {
        borrow mut forward::<i8>(all) as rest { write_slice(rest, 0, 9i8); }
        write_slice(all, 0, 4i8);
    }
    let number = 7;
    borrow number as input {
        borrow same::<i64>(input) as selected {
            return read_ref(selected) + cast<i64>(values[0]) + cast<i64>(values[1]) + cast<i64>(original[1]);
        }
    }
}
