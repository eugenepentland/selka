module main;
import std_collections as c;
fn descending(a:i64,b:i64)->bool effects(){return a>b;}
fn twice(x:i64)->i64 effects(){return x*2;}
fn main()->i64{
    let mut values=new [4]i64 [3,1,4,2];
    borrow mut values[0..4] as view{
        discard c::sort_by_i64(view,descending);
        discard c::transform_i64(view,twice);
    }
    return values[0]*10+values[3];
}
