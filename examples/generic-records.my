class Sample:
    values: [2]i64
    tag: u8


def make[T: integer](x: T) -> Sample:
    return Sample(values=[cast<i64>(x), cast<i64>(x) + 1], tag=7u8)


def total[T](context: T, sample: Sample) -> i64:
    _ = context
    return sample.values[0] + sample.values[1] + cast<i64>(len(sample.values))


def main() -> i64:
    return total[bool](True, make[u8](7u8))
