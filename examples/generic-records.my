class Sample:
    values: [2]int
    tag: u8


def make[T: integer](x: T) -> Sample:
    return Sample(values=[int(x), int(x) + 1], tag=7u8)


def total[T](context: T, sample: Sample) -> int:
    _ = context
    return sample.values[0] + sample.values[1] + int(len(sample.values))


def main() -> int:
    return total[bool](True, make[u8](7u8))
