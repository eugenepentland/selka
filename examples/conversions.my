class Source:
    x: i64
    y: i64
    note: bool


class View:
    distance: i64


def combine(x: i64, y: i64) -> i64:
    return x + y


conversion def to_view(source: Source) -> View:
    _ = source.note
    return View(distance=combine(source.x, source.y))


def main() -> i64:
    source = Source(x=4, y=7, note=True)
    return to_view(source).distance
