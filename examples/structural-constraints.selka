func counter_score(item: Counter) -> int:
    return item.value


record Reading:
    value: int


record TaggedReading:
    tag: bool
    value: int


func value[T: copy + field(value: int)](item: T) -> int:
    return item.value


func forward[U: copy + field(value: int)](item: U) -> int:
    return value[U](item)


record Counter:
    value: int


func make(n: int) -> Counter:
    return Counter(value=n)


func score[T: copy](item: T, named score_operation: func(T) -> int) -> int:
    return score_operation(item)


func main() -> int:
    return value[Reading](Reading(value=2)) + forward[TaggedReading](TaggedReading(tag=True, value=3)) + score[Counter](make(7), score_operation=counter_score)
