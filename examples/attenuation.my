resource File: filesystem

result Open:
    ok: File,
    err: int


record Chunk:
    bytes: [16]u8
    length: u64
    eof: bool


result Read:
    ok: Chunk,
    err: int


def delegate(fs: Filesystem) -> Filesystem effects():
    return restrict_resource[read](fs)


def main(fs: Filesystem) -> int:
    reader = delegate(fs)
    request: [1]u8 = [42u8]
    match acquire_resource[Open](reader, request):
        case Open.ok(input):
            file = input
            match read_resource[Read](file):
                case Read.ok(chunk):
                    return int(chunk.length)
                case Read.err(code):
                    return -code
        case Open.err(code):
            return -code
