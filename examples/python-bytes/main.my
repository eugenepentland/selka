# Parse a length-prefixed binary record set the way Python code would: managed
# byte strings, integer octets, and a checked result instead of an exception.
record Record:
    tag: str
    body: bytes


func checksum(body: bytes) -> int:
    mut total = 0
    for octet in body:
        total = (total + octet) % 251
    return total


func split_records(payload: bytes) -> Result[Record[], str]:
    mut records: Record[] = []
    mut cursor = 0
    while cursor < len(payload):
        if cursor + 1 >= len(payload):
            return Err("truncated record header")
        mut size = payload[cursor + 1]
        mut start = cursor + 2
        mut stop = start + size
        if stop > len(payload):
            return Err("record body runs past the payload")
        mut tag = try bytes([payload[cursor]]).decode()
        records.append(Record(tag=tag, body=payload[start:stop]))
        cursor = stop
    return Ok(records)


func report(payload: bytes) -> Result[int, str]:
    if not payload.startswith(b"A"):
        return Err("payload does not start with the A record")
    mut records = try split_records(payload)
    if len(records) != 3:
        return Err("expected three records")
    if records[0].tag != "A" or records[0].body != b"abc":
        return Err("first record did not round-trip")
    if records[1].body.hex() != "ff01":
        return Err("second record is not ff01")
    if len(records[2].body) != 0:
        return Err("third record should be empty")
    mut names: dict[str, bytes] = {}
    for record in records:
        names[record.tag] = record.body
    if b"bc" not in names["A"]:
        return Err("subsequence search failed")
    mut total = 0
    for record in records:
        total += checksum(record.body)
    return Ok(total + len(names))


func main() -> int:
    match report(b"A\x03abcB\x02\xff\x01C\x00"):
        case Ok(value):
            return value
        case Err(message):
            return 0 - len(message)
