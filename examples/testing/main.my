module main;
export test_square;
export test_sum;

fn square(value: i64) -> i64 {
    return value * value;
}

fn sum(left: i64, right: i64) -> i64 {
    return left + right;
}

fn test_square() -> bool {
    return square(7) == 49;
}

fn test_sum() -> bool {
    return sum(20, 22) == 42;
}

fn main() -> i64 {
    return 0;
}
