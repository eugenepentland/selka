module main
export test_square
export test_sum


def square(value: int) -> int:
    return value * value


def sum(left: int, right: int) -> int:
    return left + right


def test_square() -> bool effects():
    return square(7) == 49


def test_sum() -> bool effects():
    return sum(20, 22) == 42


def main() -> int:
    return 0
