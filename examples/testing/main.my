module main
export test_square
export test_sum


def square(value: i64) -> i64:
    return value * value


def sum(left: i64, right: i64) -> i64:
    return left + right


def test_square() -> bool:
    return square(7) == 49


def test_sum() -> bool:
    return sum(20, 22) == 42


def main() -> i64:
    return 0
