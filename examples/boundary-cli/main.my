import summary

func trace_requested(env: Environment) -> bool effects(environment):
    match env.get("MYLANG_ACCEPT_MODE"):
        case Some(value):
            return len(value) >= 0
        case None:
            return False


func main(args: str[], fs: Filesystem, env: Environment, out: Stream, err: Stream) -> Result[int, str]:
    if len(args) != 1:
        return Err("usage: boundary-cli <source.my>")
    if trace_requested(env):
        err.print("reading", args[0])
    mut source = try read_text(fs, args[0])
    out.print(summary.render(source))
    return Ok(0)
