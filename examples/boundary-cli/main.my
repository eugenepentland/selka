module main
import summary

def trace_requested(env: Environment) -> bool effects(environment):
    match env.get("MYLANG_ACCEPT_MODE"):
        case Some(value):
            return len(value) >= 0
        case None:
            return False

def main(args: list[str], fs: Filesystem, env: Environment) -> Result[int, str]:
    if len(args) != 1:
        return Err("usage: boundary-cli <source.my>")
    if trace_requested(env):
        eprint("reading", args[0])
    source = read_text(fs, args[0])?
    print(summary.render(source))
    return Ok(0)
