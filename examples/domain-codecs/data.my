module data
export Wire
export Decoded
export Positive


class Wire:
    n: int


result Decoded:
    ok: Positive,
    err: int


domain Positive: int:
    codec Wire:
        decode: from_wire,
        encode: to_wire

    private def raw(x: int) -> Positive:
        return wrap[Positive](x)

    def from_wire(x: Wire) -> Decoded:
        if x.n <= 0:
            return Err(-1)
        return Ok(Positive.raw(x.n))

    def to_wire(x: Positive) -> Wire:
        return Wire(n=unwrap(x))
