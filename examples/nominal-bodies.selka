record Box[T]:
    value: T


enum Slot[T]:
    none
    some(value: T)


func pack[T](x: T) -> Box[T]:
    return Box[T](value=copy(x))


func extract[T](box: Box[T]) -> T from box:
    return box.value


func slot[T](x: T) -> Slot[T]:
    return Slot.some(value=copy(x))


func choose[T](x: Slot[T], fallback: T) -> T from x, fallback:
    match x:
        case none:
            return fallback
        case some(value):
            return value


func main() -> int:
    return extract[int](pack[int](choose[int](slot[int](7), 0)))
