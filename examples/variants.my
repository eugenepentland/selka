enum Color:
    red,
    green,
    blue


record Point:
    x: int
    y: int


union Shape:
    point: Point,
    radius: int,
    empty


def score(shape: Shape) -> int:
    match shape:
        case Shape.empty:
            return 0
        case Shape.radius(r):
            return r * r
        case Shape.point(p):
            return p.x + p.y


def color_score(color: Color) -> int:
    match color:
        case Color.red:
            return 1
        case Color.green:
            return 2
        case Color.blue:
            return 3


def main() -> int:
    shapes: [3]Shape = [Shape.point(Point(x=2, y=3)), Shape.radius(4), Shape.empty]
    return score(shapes[0]) + score(shapes[1]) + score(shapes[2]) + color_score(Color.blue)
