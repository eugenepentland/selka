fn sum<T: integer>(values: &[]T) -> T {
    if len_slice(values) == 0u64 { return cast<T>(0); }
    let first = read_slice(values, 0);
    borrow values[1..len_slice(values)] as tail {
        return first + sum::<T>(tail);
    }
}
fn fill<T: copy>(values: &mut []T, replacement: T) -> u64 {
    if len_slice(values) == 0u64 { return 0u64; }
    write_slice(values, 0, replacement);
    let size = len_slice(values);
    borrow mut values[1..size] as tail {
        discard fill::<T>(tail, replacement);
    }
    return len_slice(values);
}
fn main() -> i64 {
    let mut values = new [3]i8 [1i8, 2i8, 3i8];
    let original = values;
    borrow mut values[0..3] as all { discard fill::<i8>(all, 4i8); }
    borrow values[0..3] as all { return cast<i64>(sum::<i8>(all)) + cast<i64>(original[0]); }
}
