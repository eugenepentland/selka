class Pair:
    values: [2]int
    flag: bool


enum Key:
    first,
    second


def change[T: integer](pair: Pair, index: T, value: int) -> Pair:
    changed = pair
    changed.values = replace(pair.values, index, value)
    return changed


def put[T: integer](table: [Key]int, key: Key, value: T) -> [Key]int:
    return replace(table, key, int(value))


def main() -> int:
    original = Pair(values=[7, 8], flag=True)
    changed = change[u8](original, 0u8, 20)
    old: [Key]int = {Key.first: 1, Key.second: 2}
    table = put[u8](old, Key.first, 8u8)
    if changed.flag:
        return original.values[0] + changed.values[0] + changed.values[1] + old[Key.first] + table[Key.first]
    return 0
