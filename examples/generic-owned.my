buffer B: u8;
result A {
    ok: B,
    err: i64
}
struct Box {
    b: B,
    n: i64
}
fn forward < T: copy >(b: B) -> B noalloc {
    return b;
}
fn drop < T: copy >(b: B) -> i64 noalloc {
    return 1;
}
fn replenish < T: copy >(first: B, second: B) -> B {
    let mut slot = first;
    slot = second;
    return slot;
}
fn fields < T: copy >(b: Box) -> i64 {
    discard take_field(b, b);
    return read_field(b, n);
}
fn select < T: copy >(flag: bool, first: B, second: B) -> B {
    if flag {
        return first;
    }
    return second;
}
fn work(heap: allocator, flag: bool) -> i64 {
    match acquire_buffer<A>(heap, 1) {
        A.ok(first) => {
            match acquire_buffer<A>(heap, 1) {
                A.ok(second) => {
                    match acquire_buffer<A>(heap, 1) {
                        A.ok(third) => {
                            return fields::< bool >(new Box {
                                b: forward::< bool >(replenish::< bool >(select::< bool >(flag, first, second), third)),
                                n: 7
                            });
                        },
                        A.err(e) => {
                            return e;
                        }
                    }
                },
                A.err(e) => {
                    return e;
                }
            }
        },
        A.err(e) => {
            return e;
        }
    }
}
fn main(heap: allocator) -> i64 {
    return work(heap, true) + work(heap, false);
}
