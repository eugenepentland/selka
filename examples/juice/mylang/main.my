func checksum(count: int) -> int:
    mut values: int[] = []
    for i in range(count):
        values.append(i % 97)
    mut result = 0
    for value in values:
        result += value
    return result


func number(text: str) -> int:
    match parse_int(text):
        case Some(value):
            return value
        case None:
            return 0


func main(args: str[], out: Stream) -> int:
    if len(args) != 2:
        return 2
    const count = number(args[0])
    const rounds = number(args[1])
    if count < 1 or count > 1000000 or rounds < 1 or rounds > 10000:
        return 2
    mut result = 0
    for round in range(rounds):
        result += checksum(count)
    out.print(result)
    return 0
