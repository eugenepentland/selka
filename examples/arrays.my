class Samples:
    values: [3]int


def sum(values: [3]int) -> int:
    index = 0u64
    total = 0
    while index < len(values):
        total += values[index]
        index += 1u64
    return total


def main() -> int:
    original = Samples(values=[4, 7, 9])
    changed = original
    changed.values = replace(original.values, 1, 11)
    return sum(original.values) + sum(changed.values)
