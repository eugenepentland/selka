resource File: filesystem


result Open:
    ok: File,
    err: int


record Failure:
    code: int
    resource: File


result Finish:
    err: Failure,
    ok: bool


result Status:
    ok: bool,
    err: int


record Owned:
    file: File
    code: int


func forward[T](own file: File) -> File:
    return file


func drop[T](own file: File) -> int:
    return 1


func fields[T](own value: Owned) -> int:
    _ = own value
    return 7


func handle[T](own r: Open) -> int:
    match own r:
        case ok(file):
            return fields[bool](Owned(file=forward[bool](own file), code=7))
        case err(code):
            return code


func main(fs: Filesystem) -> int:
    mut empty: FixedArray[u8, 0] = FixedArray[u8, 0]([])
    mut first = handle[bool](acquire_resource[Open](fs, empty))
    match acquire_resource[Open](fs, empty):
        case ok(file):
            return first + drop[bool](own file)
        case err(code):
            return code
