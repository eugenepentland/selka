# scan_replace: str.replace over LIB.md's 4 MB text.


def shared_text() -> str:
    block = "".join([f"item{i},{(i * 7919) % 100003},{'xxxxxx'[:i % 7]}\n" for i in range(2000)])
    return "".join([block for _ in range(110)])


def main(out: Stream) -> int:
    text = shared_text()
    total = 0
    a = 0
    b = 0
    c = 0
    for _ in range(4):
        a = len(text.replace("item", "it"))
        b = len(text.replace(",", ";;"))
        c = len(text.replace("x\nitem1", "|"))
        total += a + b + c
    out.print(f"{a} {b} {c} {total}")
    return 0
