import lists
import strings

# scan_count: str.count over LIB.md's 4 MB text.
func shared_text() -> str:
    mut block_parts: str[] = []
    for i in range(2000):
        append(mut block_parts, f"item{i},{(i * 7919) % 100003},{strings.char_slice('xxxxxx', None, i % 7)}\n")
    mut block = strings.join(block_parts, "")
    return strings.join(lists.filled[str](110, block), "")


func main(out: Stream) -> int:
    mut text = shared_text()
    mut total = 0
    mut a = 0
    mut b = 0
    mut c = 0
    mut d = 0
    for _ in range(12):
        a = strings.count(text, ",1")
        b = strings.count(text, "\n")
        c = strings.count(text, "item1")
        d = strings.count(text, "x\nitem")
        total += a + b + c + d
    print(out, f"{strings.char_count(text)} {a} {b} {c} {d} {total}")
    return 0
