# scan_split: str.split(separator) over LIB.md's 4 MB text. Each piece is a
# fresh str until shared string slices land (plan section 5.4).


func shared_text() -> str:
    mut block = "".join([for i in range(2000) yield f"item{i},{(i * 7919) % 100003},{'xxxxxx'[:i % 7]}\n"])
    return "".join([for _ in range(110) yield block])


func main(out: Stream) -> int:
    mut text = shared_text()
    mut lines = 0
    mut width = 0
    mut fields = 0
    mut runs = 0
    mut run_width = 0
    for _ in range(3):
        for line in text.split("\n"):
            lines += 1
            width += len(line)
        fields += len(text.split(","))
        for run in text.split("x\nitem"):
            runs += 1
            run_width += len(run)
    out.print(f"{lines} {width} {fields} {runs} {run_width}")
    return 0
