# hash_bytes: a hand-written SHA-256 (FIPS 180-4) and a table-driven CRC32 over a
# 64 MiB byte buffer filled from the xorshift generator (SUITE.md section 14).
# Words are loaded big-endian from the octets of `bytes`; the arithmetic is u32.
import byte_builder
import bytes
import strings

func xorshift(input: u64) -> u64:
    mut x = input
    x = bit_xor(x, shift_left(x, 13u64))
    x = bit_xor(x, shift_right(x, 7u64))
    return bit_xor(x, shift_left(x, 17u64))


func rotate_right(value: u32, count: u32) -> u32:
    return bit_or(shift_right(value, count), shift_left(value, 32u32 - count))


func round_constants() -> u32[]:
    return [0x428a2f98u32, 0x71374491u32, 0xb5c0fbcfu32, 0xe9b5dba5u32, 0x3956c25bu32, 0x59f111f1u32, 0x923f82a4u32, 0xab1c5ed5u32, 0xd807aa98u32, 0x12835b01u32, 0x243185beu32, 0x550c7dc3u32, 0x72be5d74u32, 0x80deb1feu32, 0x9bdc06a7u32, 0xc19bf174u32, 0xe49b69c1u32, 0xefbe4786u32, 0x0fc19dc6u32, 0x240ca1ccu32, 0x2de92c6fu32, 0x4a7484aau32, 0x5cb0a9dcu32, 0x76f988dau32, 0x983e5152u32, 0xa831c66du32, 0xb00327c8u32, 0xbf597fc7u32, 0xc6e00bf3u32, 0xd5a79147u32, 0x06ca6351u32, 0x14292967u32, 0x27b70a85u32, 0x2e1b2138u32, 0x4d2c6dfcu32, 0x53380d13u32, 0x650a7354u32, 0x766a0abbu32, 0x81c2c92eu32, 0x92722c85u32, 0xa2bfe8a1u32, 0xa81a664bu32, 0xc24b8b70u32, 0xc76c51a3u32, 0xd192e819u32, 0xd6990624u32, 0xf40e3585u32, 0x106aa070u32, 0x19a4c116u32, 0x1e376c08u32, 0x2748774cu32, 0x34b0bcb5u32, 0x391c0cb3u32, 0x4ed8aa4au32, 0x5b9cca4fu32, 0x682e6ff3u32, 0x748f82eeu32, 0x78a5636fu32, 0x84c87814u32, 0x8cc70208u32, 0x90befffau32, 0xa4506cebu32, 0xbef9a3f7u32, 0xc67178f2u32]


# The big-endian word of the four octets at data[start:start+4]: one checked load.
func word_at(data: bytes, start: int) -> u32:
    return bytes.read_u32_be(data, start)


# Compresses the 64-byte block at `start` into `state`, using the caller's schedule buffer.
func compress(data: bytes, start: int, mut state: u32[], mut schedule: u32[], constants: u32[]):
    for index in range(16):
        schedule[index] = word_at(data, start + index * 4)
    for index in range(16, 64):
        const early = schedule[index - 15]
        const late = schedule[index - 2]
        const small0 = bit_xor(bit_xor(rotate_right(early, 7u32), rotate_right(early, 18u32)), shift_right(early, 3u32))
        const small1 = bit_xor(bit_xor(rotate_right(late, 17u32), rotate_right(late, 19u32)), shift_right(late, 10u32))
        schedule[index] = wrapping_add(wrapping_add(schedule[index - 16], small0), wrapping_add(schedule[index - 7], small1))
    mut a = state[0]
    mut b = state[1]
    mut c = state[2]
    mut d = state[3]
    mut e = state[4]
    mut f = state[5]
    mut g = state[6]
    mut h = state[7]
    for index in range(64):
        const choice = bit_xor(bit_and(e, f), bit_and(bit_xor(e, 0xffffffffu32), g))
        const upper = bit_xor(bit_xor(rotate_right(e, 6u32), rotate_right(e, 11u32)), rotate_right(e, 25u32))
        const first = wrapping_add(wrapping_add(wrapping_add(h, upper), choice), wrapping_add(constants[index], schedule[index]))
        const lower = bit_xor(bit_xor(rotate_right(a, 2u32), rotate_right(a, 13u32)), rotate_right(a, 22u32))
        const majority = bit_xor(bit_xor(bit_and(a, b), bit_and(a, c)), bit_and(b, c))
        const second = wrapping_add(lower, majority)
        h = g
        g = f
        f = e
        e = wrapping_add(d, first)
        d = c
        c = b
        b = a
        a = wrapping_add(first, second)
    state[0] = wrapping_add(state[0], a)
    state[1] = wrapping_add(state[1], b)
    state[2] = wrapping_add(state[2], c)
    state[3] = wrapping_add(state[3], d)
    state[4] = wrapping_add(state[4], e)
    state[5] = wrapping_add(state[5], f)
    state[6] = wrapping_add(state[6], g)
    state[7] = wrapping_add(state[7], h)


# The 32-byte SHA-256 digest of `data`, with the FIPS 180-4 padding for the final block(s).
func sha256(data: bytes) -> bytes:
    mut state = [0x6a09e667u32, 0xbb67ae85u32, 0x3c6ef372u32, 0xa54ff53au32, 0x510e527fu32, 0x9b05688cu32, 0x1f83d9abu32, 0x5be0cd19u32]
    const constants = round_constants()
    mut schedule: u32[] = []
    for _ in range(64):
        append(mut schedule, 0u32)
    const full = len(data) // 64
    for block in range(full):
        compress(data, block * 64, mut state, mut schedule, constants)
    const rest = len(data) - full * 64
    mut tail = byte_builder.create()
    for index in range(full * 64, len(data)):
        _ = byte_builder.append_byte(mut tail, int(data[index]))
    _ = byte_builder.append_byte(mut tail, 128)
    for _ in range((119 - rest) % 64):
        _ = byte_builder.append_byte(mut tail, 0)
    mut bits = u64(len(data)) * 8u64
    mut shift = 56
    while shift >= 0:
        _ = byte_builder.append_byte(mut tail, int(bit_and(shift_right(bits, u64(shift)), 255u64)))
        shift -= 8
    const padded = byte_builder.finish(tail)
    for block in range(len(padded) // 64):
        compress(padded, block * 64, mut state, mut schedule, constants)
    mut digest = byte_builder.create()
    for word in state:
        mut part = 3
        while part >= 0:
            _ = byte_builder.append_byte(mut digest, int(bit_and(shift_right(word, u32(part * 8)), 255u32)))
            part -= 1
    return byte_builder.finish(digest)


# The lowercase hexadecimal spelling of `data`, two digits per octet.
func hex_text(data: bytes) -> str:
    mut out = byte_builder.create()
    for octet in data:
        for nibble in [octet // 16, octet % 16]:
            if nibble < 10:
                _ = byte_builder.append_byte(mut out, 48 + nibble)
            else:
                _ = byte_builder.append_byte(mut out, 87 + nibble)
    match strings.decode(byte_builder.finish(out)):
        case Ok(text):
            return text
        case Err(_):
            return ""


func crc_table() -> int[]:
    mut table: int[] = []
    for n in range(256):
        mut c = n
        for _ in range(8):
            if c % 2 == 1:
                c = bit_xor(3988292384, c // 2)
            else:
                c = c // 2
        append(mut table, c)
    return table


# The IEEE CRC32 of `data`, with the reflected polynomial and the initial and final XOR.
func crc32(data: bytes, table: int[]) -> int:
    mut crc = 4294967295
    for octet in data:
        const index = bit_xor(crc, octet) % 256
        crc = bit_xor(table[index], crc // 256)
    return bit_xor(crc, 4294967295)


func main(out: Stream) -> int:
    mut state = 88172645463325252u64
    mut buffer = byte_builder.create()
    for _ in range(67108864):
        state = xorshift(state)
        _ = byte_builder.append_byte(mut buffer, int(bit_and(shift_right(state, 33u64), 255u64)))
    const data = byte_builder.finish(buffer)
    const abc = strings.encode("abc")
    print(out, f"sha256 abc {hex_text(sha256(abc))}")
    print(out, f"sha256 {hex_text(sha256(data))}")
    const table = crc_table()
    print(out, f"crc32 {crc32(data, table)}")
    return 0
