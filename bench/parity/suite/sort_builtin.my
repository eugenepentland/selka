# sort_builtin: two million xorshift values sorted in place by list.sort(),
# the built-in stable sort; prints three order statistics and a checksum.


func xorshift(input: u64) -> u64:
    mut x = input
    x = bit_xor(x, shift_left(x, 13u64))
    x = bit_xor(x, shift_right(x, 7u64))
    return bit_xor(x, shift_left(x, 17u64))


func mix(c: int, v: int) -> int:
    return (c * 31 + v) % 1000000007


func main(out: Stream) -> int:
    mut n = 2000000
    mut state = 88172645463325252u64
    mut values: int[] = []
    for _ in range(n):
        state = xorshift(state)
        values.append(int(shift_right(state, 33u64)))
    values.sort()
    out.print(values[0], values[n // 2], values[n - 1])
    mut c = 0
    for v in values:
        c = mix(c, v)
    out.print(c)
    return 0
