# text_ops: building, splitting, parsing and rewriting text with str methods
# and f-strings (SUITE.md section 11).
import strings

# 'x' * count: str has no repetition operator; strings.repeat is the library
# spelling. The workload supplies a nonnegative count.
func pad(count: int) -> str:
    return strings.repeat("x", count)


func main(out: Stream) -> int:
    mut text_parts: str[] = []
    for i in range(200000):
        append(mut text_parts, f"item{i},{(i * 7919) % 100003},{pad(i % 7)}")
    mut text = strings.join(text_parts, "\n")
    mut total = 0
    mut widths = 0
    mut sevens = 0
    for line in strings.split(text, "\n"):
        mut fields = strings.split(line, ",")
        match parse_int(fields[1]):
            case Some(value):
                total += value
            case None:
                return 1
        widths += strings.char_count(fields[2])
        if strings.ends_with(fields[0], "7"):
            sevens += 1
    mut rewritten = strings.replace(text, "item", "it")
    print(out, f"{total} {widths} {sevens}")
    print(out, f"{strings.char_count(text)} {strings.char_count(rewritten)} {strings.count(text, ',1')}")
    return 0
