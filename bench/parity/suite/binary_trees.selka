# binary_trees: perfect binary trees of recursive value nodes on the collecting heap.
# Every short-lived tree becomes garbage after its check; the tracing
# collector reclaims it. See SUITE.md section 1.
record Node:
    left: Node?
    right: Node?


func make(depth: int) -> Node:
    if depth == 0:
        return Node(left=None, right=None)
    return Node(left=Some(make(depth - 1)), right=Some(make(depth - 1)))


func child_check(child: Node?) -> int:
    if child is None:
        return 0
    return check(child)


func check(node: Node) -> int:
    if node.left is None or node.right is None:
        return 1
    return 1 + child_check(node.left) + child_check(node.right)


func main(out: Stream) -> int:
    mut max_depth = 16
    mut min_depth = 4
    mut stretch = max_depth + 1
    print(out, f"stretch tree of depth {stretch}\t check: {check(make(stretch))}")
    mut long_lived = make(max_depth)
    mut depth = min_depth
    while depth <= max_depth:
        mut iterations = shift_left(1, max_depth - depth + min_depth)
        mut total = 0
        for _ in range(iterations):
            total = total + check(make(depth))
        print(out, f"{iterations}\t trees of depth {depth}\t check: {total}")
        depth = depth + 2
    print(out, f"long lived tree of depth {max_depth}\t check: {check(long_lived)}")
    return 0
