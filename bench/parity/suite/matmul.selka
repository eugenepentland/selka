# matmul: n x n float matrices as list[list[float]] (the Python shape), C = A * B
# by the i-k-j loop; prints the trace and the sum of C, each scaled by 1000.
func lcg(seed: int) -> int:
    return (seed * 3877 + 29573) % 139968


public record RandomMatrix:
    rows: float[][]
    seed: int


func random_matrix(n: int, input_seed: int) -> RandomMatrix:
    mut seed = input_seed
    mut rows: float[][] = []
    for i in range(n):
        mut row: float[] = []
        for j in range(n):
            seed = lcg(seed)
            append(mut row, float(seed) / 139968.0)
        append(mut rows, own row)
    return RandomMatrix(rows=own rows, seed=seed)


func main(out: Stream) -> int:
    mut n = 500
    const a = random_matrix(n, 42)
    const b = random_matrix(n, a.seed)
    mut gather_result: float[][] = []
    for i in range(0, n):
        mut gather_result_next: float[] = []
        for j in range(0, n):
            const gather_value_next: float = 0.0
            append(mut gather_result_next, gather_value_next)
        const gather_value: float[] = own gather_result_next
        append(mut gather_result, own gather_value)
    mut c = own gather_result
    for i in range(n):
        for k in range(n):
            mut aik = a.rows[i][k]
            for j in range(n):
                c[i][j] = c[i][j] + aik * b.rows[k][j]
    mut trace = 0.0
    for i in range(n):
        trace = trace + c[i][i]
    mut total = 0.0
    for i in range(n):
        for j in range(n):
            total = total + c[i][j]
    print(out, int(trace * 1000.0))
    print(out, int(total * 1000.0))
    return 0
