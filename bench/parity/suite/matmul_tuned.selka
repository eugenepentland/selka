# matmul_tuned: matmul.selka (list[list[float]], i-k-j loop order) with the row of C
# rebuilt by a comprehension for every k instead of updated in place.
# Each C[i][j] still receives c + aik * b[k][j] for k = 0..n-1 in order, so the
# IEEE operation sequence, and therefore the output, is unchanged.
#
# What changed: `c[i][j] = c[i][j] + aik * b[k][j]` over j becomes
# `ci = [ci[j] + aik * bk[j] for j in range(n)]`. A comprehension appends into
# a list reserved to n up front, which lowers to an inline store, whereas an
# indexed slot write republishes the enclosing function's GC root chain
# (about 20 four-word records in matmul.selka) before the store and
# dispatches on the runtime element size. The price is one fresh 4 KB row per
# (i, k) pair, about 1 GB of short-lived allocation reclaimed by the collector.
#
# Alternatives measured (rough, E-core): inner j loop moved to a helper that
# writes in place 0.78 s; dot products over a transposed B (reads only in the
# inner loop) 0.51 s; hoisting `ci = c[i]` / `bk = b[k]` alone 2.44 s.
func lcg(seed: int) -> int:
    return (seed * 3877 + 29573) % 139968


public record RandomMatrix:
    rows: float[][]
    seed: int


func random_matrix(n: int, input_seed: int) -> RandomMatrix:
    mut seed = input_seed
    mut rows: float[][] = []
    for i in range(n):
        mut row: float[] = []
        for j in range(n):
            seed = lcg(seed)
            append(mut row, float(seed) / 139968.0)
        append(mut rows, own row)
    return RandomMatrix(rows=own rows, seed=seed)


func main(out: Stream) -> int:
    mut n = 500
    const a = random_matrix(n, 42)
    const b = random_matrix(n, a.seed)
    mut c: float[][] = []
    for i in range(n):
        mut gather_result: float[] = []
        for j in range(0, n):
            const gather_value: float = 0.0
            append(mut gather_result, gather_value)
        mut ci = own gather_result
        for k in range(n):
            mut aik = a.rows[i][k]
            mut gather_result_next: float[] = []
            for j in range(0, n):
                const gather_value_next: float = ci[j] + aik * b.rows[k][j]
                append(mut gather_result_next, gather_value_next)
            ci = own gather_result_next
        append(mut c, own ci)
    mut trace = 0.0
    for i in range(n):
        trace = trace + c[i][i]
    mut total = 0.0
    for i in range(n):
        for j in range(n):
            total = total + c[i][j]
    print(out, int(trace * 1000.0))
    print(out, int(total * 1000.0))
    return 0
